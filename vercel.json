{
  "crons": [
    {
      "path": "/api/notify/retry",
      "schedule": "0 3 * * *"
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/(links|tags|2026|sacrifice|existence|time-warp|2025|2024|remedy|zootopia|dreamcatcher|dear-dont-be-confused|ni-shan-road|haven|poem-for-the-sea|spring-24|about)/?$",
      "status": 308,
      "headers": {
        "Location": "https://blog.buxx.me/$1/"
      }
    },
    {
      "src": "/author/(murray)/?$",
      "status": 308,
      "headers": {
        "Location": "https://blog.buxx.me/author/$1/"
      }
    },
    {
      "src": "/tag/(talks|flaneur|prose|monologue|novelist|resonance)/?$",
      "status": 308,
      "headers": {
        "Location": "https://blog.buxx.me/tag/$1/"
      }
    }
  ]
}
