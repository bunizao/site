# Environment template
# Keep this file as a documented template. Put local secrets in .env.local.

# Local dev API routing
# `astro dev` has no `API` service binding, so /api, /v2 and /oauth proxy over
# HTTP to this origin. Defaults to https://buxx.me (the deployed site-api) for
# frontend-only work. Point it at a local `wrangler dev` site-api
# (http://localhost:8787) or a preview URL when debugging the API itself.
API_DEV_ORIGIN=

# Ghost CMS
# Ghost CMS URL.
PUBLIC_GHOST_URL=
# Ghost Content API key.
GHOST_CONTENT_API_KEY=
# Ghost Admin API key used only by server-side local draft tooling. Keep the
# value in .env.local and never expose it through a PUBLIC_ variable.
GHOST_ADMIN_API_KEY=
# Public OGIS endpoint used for generated /blog Open Graph images.
PUBLIC_BLOG_OG_IMAGE_ENDPOINT=
# Optional local/E2E fallback. Never set this in production unless mock content
# is the intended deploy artifact.
GHOST_MOCK_CONTENT=

# GitHub integrations
# GitHub GraphQL token for project data and star counts.
GITHUB_TOKEN=

# Mood channel metadata
# Telegram channel slug used by mood pages and feed links.
CHANNEL=
# Optional Telegram custom emoji id for the channel avatar in /api/moods.
CHANNEL_EMOJI_ID=
# Optional locale for date/text rendering.
LOCALE=
# Optional timezone for date/text rendering.
TIMEZONE=
# Optional public Telegram host for embed/link lookups. Defaults to t.me.
TELEGRAM_HOST=

# Telegram webhook and media sync
# Telegram Bot token used by webhook and scripts.
TELEGRAM_BOT_TOKEN=
# Secret token for /api/telegram-webhook header validation.
TELEGRAM_WEBHOOK_SECRET=
# Telegram channel id (format: -100xxxxxxxxxx).
TELEGRAM_CHANNEL_ID=
# Optional temp chat id for media forwarding fallback.
TELEGRAM_TEMP_CHAT_ID=

# Mood image delivery
# Cloudflare Worker base URL for high-quality mood images.
PUBLIC_HD_IMAGE_URL=
# Internal Worker base URL for webhook image ingest when the public image domain is protected.
HD_IMAGE_INGEST_BASE_URL=
# Bearer token shared with the image Worker ingest routes.
HD_IMAGE_INGEST_TOKEN=
# Debug flag for forcing loading state in UI ("true" or "false").
PUBLIC_DEBUG_ALWAYS_LOADING=false

# Static asset proxy signing
# Rollout mode: observe (default), accept-both, or enforce.
STATIC_PROXY_MODE=observe
# Current signing key id and secret. Rotate by moving both values to the previous pair.
STATIC_PROXY_KEY_ID=
STATIC_PROXY_SECRET=
STATIC_PROXY_PREVIOUS_KEY_ID=
STATIC_PROXY_PREVIOUS_SECRET=

# Cloudflare account and API access
# Cloudflare account id for D1 and KV operations.
CLOUDFLARE_ACCOUNT_ID=
# Cloudflare API token with D1 edit + KV write permission.
CLOUDFLARE_API_TOKEN=

# Cloudflare D1 (notify storage)
# D1 database id for notify subscribers/sent/retry/dead-letter records.
CLOUDFLARE_NOTIFY_D1_DATABASE_ID=

# Cloudflare KV (legacy scripts only)
# Legacy namespace id previously used for mood image mapping (MOOD_IMAGES).
# No longer needed for Worker runtime after the R2 migration.
CLOUDFLARE_KV_NAMESPACE_ID=
# Optional source namespace when running scripts/migrate-notify-kv-to-d1.ts.
CLOUDFLARE_NOTIFY_KV_NAMESPACE_ID=

# Email notify (Resend)
# Resend API key for transactional email sending.
RESEND_API_KEY=
# Optional sender display name, example: Mood.
NOTIFY_FROM_NAME=
# Sender email address verified in Resend.
NOTIFY_FROM_EMAIL=
# Optional reply-to mailbox.
NOTIFY_REPLY_TO_EMAIL=
# HMAC secret for confirm/unsubscribe signed tokens.
EMAIL_NOTIFY_SECRET=
# Secret for authenticated /api/notify/dispatch calls.
NOTIFY_DISPATCH_SECRET=
# Public site base URL for email links, example: https://buxx.me
PUBLIC_SITE_URL=
# Optional canonical site base URL used by health checks and preview links.
SITE_URL=
# Secret used by Vercel Cron for /api/notify/retry.
CRON_SECRET=
# Optional Telegram chat id for confirmed subscribe/unsubscribe admin alerts.
NOTIFY_ADMIN_TELEGRAM_CHAT_ID=

# Home integrations
# Last.fm API key for the listening widget.
LASTFM_API_KEY=
# Last.fm username for the listening widget. LASTFM_USERNAME is accepted as a fallback.
LASTFM_USER=
LASTFM_USERNAME=

# Signed SVG APIs
# Optional signing secret for /api/activity-panel.svg.
ACTIVITY_PANEL_SIGNING_SECRET=

# Turnstile
# Public Turnstile site key used by frontend forms.
PUBLIC_TURNSTILE_SITE_KEY=
# Turnstile secret key used by backend verification.
TURNSTILE_SECRET_KEY=
# Optional alias for TURNSTILE_SECRET_KEY.
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Admin portal (/dev/portal) — GitHub OAuth gate
# Cloudflare Access identity (CLOUDFLARE_ACCESS_TEAM_DOMAIN, CLOUDFLARE_ACCESS_AUDS,
# CLOUDFLARE_ACCESS_ALLOWED_EMAILS) is configured out-of-band in the Cloudflare
# dashboard, not in tracked config.
# GitHub OAuth app client id. Callback URL: ${PUBLIC_SITE_URL}/api/admin/auth/callback
GITHUB_OAUTH_CLIENT_ID=
# GitHub OAuth app client secret.
GITHUB_OAUTH_CLIENT_SECRET=
# Single GitHub login allowed into the admin portal (case-insensitive).
ADMIN_GITHUB_LOGIN=
# 32-byte random base64 string used to HMAC-sign the admin_session cookie.
ADMIN_SESSION_SECRET=
# Loopback-only OAuth bypass for `astro dev`. Set to 1 via `bun run dev:portal`.
ADMIN_DEV_BYPASS=
# Optional display login for the local-only bypass.
ADMIN_DEV_LOGIN=
# Optional avatar URL for the local-only bypass. Defaults to GitHub avatar for ADMIN_DEV_LOGIN/ADMIN_GITHUB_LOGIN.
ADMIN_DEV_AVATAR_URL=

# Legacy script-only variables (scripts/index-telegram-history.ts)
# Start message id for resumable indexing. Defaults to 1.
START_MESSAGE_ID=
# Optional end message id for bounded indexing.
END_MESSAGE_ID=
