{
  "name": "@bunizao/contracts",
  "version": "0.1.0",
  "description": "Shared TypeScript contracts for buxx.me services and clients.",
  "type": "module",
  "sideEffects": false,
  "license": "UNLICENSED",
  "author": "bunizao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bunizao/site.git",
    "directory": "packages/contracts"
  },
  "bugs": {
    "url": "https://github.com/bunizao/site/issues"
  },
  "homepage": "https://github.com/bunizao/site/tree/main/packages/contracts",
  "keywords": [
    "buxx.me",
    "typescript",
    "api-contracts",
    "cloudflare-workers"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./analytics": {
      "types": "./dist/analytics.d.ts",
      "import": "./dist/analytics.js",
      "default": "./dist/analytics.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.js",
      "default": "./dist/admin.js"
    },
    "./comments": {
      "types": "./src/comments.ts",
      "import": "./src/comments.ts",
      "default": "./src/comments.ts"
    },
    "./content": {
      "types": "./dist/content.d.ts",
      "import": "./dist/content.js",
      "default": "./dist/content.js"
    },
    "./listening": {
      "types": "./dist/listening.d.ts",
      "import": "./dist/listening.js",
      "default": "./dist/listening.js"
    },
    "./mood": {
      "types": "./dist/mood.d.ts",
      "import": "./dist/mood.js",
      "default": "./dist/mood.js"
    },
    "./notify": {
      "types": "./dist/notify.d.ts",
      "import": "./dist/notify.js",
      "default": "./dist/notify.js"
    },
    "./routes": {
      "types": "./dist/routes.d.ts",
      "import": "./dist/routes.js",
      "default": "./dist/routes.js"
    },
    "./telegram-ops": {
      "types": "./dist/telegram-ops.d.ts",
      "import": "./dist/telegram-ops.js",
      "default": "./dist/telegram-ops.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "check": "node scripts/verify-package.mjs",
    "test": "node --test tests/package.test.mjs",
    "pack:check": "npm pack --dry-run --json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "latest"
  }
}
