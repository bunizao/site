{
  "disableClaudeAiConnectors": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "BUN=$(command -v bun || echo \"$HOME/.bun/bin/bun\"); \"$BUN\" \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/dev-server-guard.ts\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Checking dev server budget"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/stop-dev-server.sh\" 2>/dev/null || true",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
