{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "site",
  "main": "src/worker.ts",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": true,
  "placement": {
    "mode": "smart"
  },
  "cache": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/api/*",
      "/blog*",
      "/llms.txt",
      "/mood*",
      "/privacy*",
      "/projects*",
      "/sitemap.xml",
      "/dev",
      "/dev/*",
      "/oauth*",
      "/v2/*"
    ]
  },
  "services": [
    { "binding": "API", "service": "site-api" }
  ],
  "kv_namespaces": [
    { "binding": "SESSION", "id": "e1a1eec45d974679898530298997b465" }
  ],
  "routes": [
    { "pattern": "buxx.me/*", "zone_name": "buxx.me" },
    { "pattern": "www.buxx.me/*", "zone_name": "buxx.me" }
  ],
  "keep_vars": true,
  "vars": {
    "SITE_URL": "https://buxx.me",
    "PUBLIC_SITE_URL": "https://buxx.me",
    "PUBLIC_GHOST_URL": "https://blog.buxx.me",
    "PUBLIC_BLOG_OG_IMAGE_ENDPOINT": "https://og.tuuhub.com/api/og",
    "LASTFM_USER": "bunizao",
    "PUBLIC_HD_IMAGE_URL": "https://buxx.me/api/v2/images",
    "MOOD_READ_SOURCE": "archive",
    "PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAACaDQzCbYalmO_xV",
    "CHANNEL": "tutumood",
    "TELEGRAM_HOST": "t.me"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
