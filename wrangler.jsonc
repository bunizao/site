{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "site",
  "main": "src/worker.ts",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": true,
  "placement": {
    "mode": "smart"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/mood*",
      "/dev",
      "/dev/*",
      "/oauth*",
      "/v2/*",
      "/docs*"
    ]
  },
  "services": [
    { "binding": "API", "service": "site-api" }
  ],
  "routes": [
    { "pattern": "buxx.me/*", "zone_name": "buxx.me" },
    { "pattern": "www.buxx.me/*", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/links", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/links/", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/tags", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/tags/", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/rss", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/rss/", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/feed", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/feed/", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/sitemap.xml", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/sitemap-posts.xml", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/sitemap-pages.xml", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/sitemap-tags.xml", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/sitemap-authors.xml", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/content/images/*", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/tag/*", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/author/*", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/2026", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/2026/", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/sacrifice", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/sacrifice/", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/existence", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/existence/", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/time-warp", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/time-warp/", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/2025", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/2025/", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/2024", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/2024/", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/remedy", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/remedy/", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/zootopia", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/zootopia/", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/dreamcatcher", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/dreamcatcher/", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/dear-dont-be-confused", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/dear-dont-be-confused/", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/ni-shan-road", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/ni-shan-road/", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/haven", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/haven/", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/poem-for-the-sea", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/poem-for-the-sea/", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/spring-24", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/spring-24/", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/about", "zone_name": "buxx.me" },
    { "pattern": "blog.buxx.me/about/", "zone_name": "buxx.me" }
  ],
  "vars": {
    "SITE_URL": "https://buxx.me",
    "PUBLIC_SITE_URL": "https://buxx.me",
    "PUBLIC_GHOST_URL": "https://blog.buxx.me",
    "PUBLIC_BLOG_OG_IMAGE_ENDPOINT": "https://og.tuuhub.com/api/og",
    "LASTFM_USER": "bunizao",
    "PUBLIC_HD_IMAGE_URL": "https://buxx.me/api/v2/images",
    "PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAACaDQzCbYalmO_xV",
    "CHANNEL": "tutumood",
    "TELEGRAM_HOST": "t.me",
    "CLOUDFLARE_ACCESS_TEAM_DOMAIN": "bunizao.cloudflareaccess.com",
    "CLOUDFLARE_ACCESS_AUDS": "8bd92a4e41eee3c88870f802a5fa28d1ef0f65fe75dcc6c78f5162244f2ea06f,56837be46147be20223380ecba8c9aa32ab17ac68aa1f6399b92c114fcc278d0,08e857ebe5f511e9aeaadb89e3dd8d7930e33134fac46bc5817a9c0845100cd2",
    "CLOUDFLARE_ACCESS_ALLOWED_EMAILS": "bunizaoccc@gmail.com"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
