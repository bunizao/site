{
  "name": "buxx.me",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "browserslist": [
    "defaults",
    "safari >= 15",
    "ios_saf >= 15"
  ],
  "scripts": {
    "dev": "ASTRO_DEV_BACKGROUND=0 NODE_OPTIONS=--max-old-space-size=1024 astro dev",
    "dev:site": "ASTRO_DEV_BACKGROUND=0 NODE_OPTIONS=--max-old-space-size=1024 astro dev",
    "dev:home": "DEV_SURFACE=home PUBLIC_DEV_SURFACE=home ASTRO_DEV_BACKGROUND=0 NODE_OPTIONS=--max-old-space-size=1024 astro dev",
    "dev:mood": "DEV_SURFACE=mood PUBLIC_DEV_SURFACE=mood ASTRO_DEV_BACKGROUND=0 NODE_OPTIONS=--max-old-space-size=1024 astro dev",
    "dev:richtext": "MOOD_RICHTEXT_FIXTURE=1 DEV_SURFACE=mood PUBLIC_DEV_SURFACE=mood ASTRO_DEV_BACKGROUND=0 NODE_OPTIONS=--max-old-space-size=1024 astro dev",
    "dev:preview": "DEV_SURFACE=preview PUBLIC_DEV_SURFACE=preview ASTRO_DEV_BACKGROUND=0 NODE_OPTIONS=--max-old-space-size=1024 astro dev",
    "dev:portal": "ADMIN_DEV_BYPASS=1 DEV_SURFACE=preview PUBLIC_DEV_SURFACE=preview ASTRO_DEV_BACKGROUND=0 NODE_OPTIONS=--max-old-space-size=1024 astro dev",
    "dev:api": "API_DEV_ORIGIN=http://127.0.0.1:8787 ASTRO_DEV_BACKGROUND=0 NODE_OPTIONS=--max-old-space-size=1024 astro dev",
    "build": "bun run contracts:build && astro build && bun scripts/generate-i18n-manifest.ts && bun scripts/generate-agent-markdown.ts && pagefind --site dist/client --force-language zh && node scripts/cloudflare-deploy-guard.mjs install",
    "sync:models": "node scripts/sync-model-registry.mjs",
    "contracts:build": "bun run --cwd packages/contracts build",
    "contracts:check": "bun run --cwd packages/contracts check",
    "contracts:test": "bun run --cwd packages/contracts test",
    "contracts:pack": "bun run --cwd packages/contracts pack:check",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "build:staging": "bun scripts/build-staging-cloudflare.ts",
    "guard:cloudflare-deploy": "node scripts/cloudflare-deploy-guard.mjs check",
    "check": "bun run contracts:build && astro sync && node scripts/astro-check-legacy-typescript.mjs",
    "check:route-contracts": "bun scripts/check-route-contracts.ts",
    "check:docs-coverage": "bun scripts/check-docs-coverage.ts",
    "preview": "bun run preview:cloudflare",
    "deploy:cloudflare": "bun run build:cloudflare && bun run guard:cloudflare-deploy && wrangler deploy --config dist/server/wrangler.json",
    "upload:cloudflare": "bun run guard:cloudflare-deploy && wrangler versions upload --config dist/server/wrangler.json",
    "preview:cloudflare": "bun run build:cloudflare && wrangler dev --config dist/server/wrangler.json",
    "tail:cloudflare": "wrangler tail",
    "types:cloudflare": "wrangler types",
    "test:unit": "bun run contracts:build && bun test tests/unit",
    "test:registry": "bun run contracts:build && bun scripts/verify-component-registry.ts",
    "test:ops": "bun run contracts:build && bun test tests/ops/*.test.ts",
    "test:e2e": "bun run test:e2e:site",
    "test:e2e:coverage": "rm -rf .nyc_output coverage/e2e && E2E_PORT=4331 COVERAGE=1 playwright test && nyc --nycrc-path config/nyc.json report",
    "test:e2e:site": "bun run contracts:build && playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:headed": "playwright test --headed",
    "bench:theme": "bun scripts/benchmark-theme-transition.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "mascot:show": "bun scripts/mascot.ts show",
    "mascot:diff": "bun scripts/mascot.ts diff",
    "doctor": "npx react-doctor@latest"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "14.2.5",
    "@astrojs/markdown-satteri": "0.3.8",
    "@astrojs/react": "^6.0.4",
    "@astrojs/sitemap": "^3.7.3",
    "@cloudflare/workers-types": "^5.20260831.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/pako": "3.0.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.5.4",
    "bun-types": "^1.4.0",
    "nyc": "^18.0.0",
    "pagefind": "^1.5.2",
    "postcss": "^8.5.26",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "typescript-astro-check": "npm:typescript@5.9.3",
    "vite-plugin-istanbul": "^9.0.1",
    "wrangler": "^4.127.1"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@bunizao/contracts": "workspace:*",
    "@bunizao/decode-text": "workspace:*",
    "@chenglou/pretext": "^0.0.8",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@tryghost/content-api": "^1.12.10",
    "astro": "^7.2.9",
    "cheerio": "1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "domhandler": "6.0.1",
    "flourite": "^1.3.0",
    "framer-motion": "^13.1.1",
    "gsap": "^3.15.0",
    "jose": "^6.2.10",
    "lottie-web": "5.13.0",
    "lru-cache": "^11.5.2",
    "lucide-react": "^1.38.0",
    "mermaid": "^11.17.1",
    "ofetch": "^1.5.1",
    "pako": "3.0.1",
    "prismjs": "^1.30.0",
    "prismjs-components-importer": "^0.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "shiki": "^4.4.3",
    "slot-text": "^0.3.4",
    "tailwind-merge": "^3.6.0"
  },
  "overrides": {
    "ajv": "8.18.0",
    "devalue": "5.8.1",
    "esbuild": "0.28.1",
    "js-yaml": "4.3.0",
    "minimatch": "9.0.9",
    "path-to-regexp": "6.3.0",
    "rollup": "4.59.0",
    "svgo": "4.0.1",
    "tar": "7.5.11",
    "ws": "8.21.0",
    "yaml": "2.8.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.0"
}
