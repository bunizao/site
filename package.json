{
  "name": "buxx.me",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "ASTRO_DEV_BACKGROUND=0 astro dev",
    "dev:site": "ASTRO_DEV_BACKGROUND=0 astro dev",
    "dev:home": "DEV_SURFACE=home PUBLIC_DEV_SURFACE=home ASTRO_DEV_BACKGROUND=0 astro dev",
    "dev:mood": "DEV_SURFACE=mood PUBLIC_DEV_SURFACE=mood ASTRO_DEV_BACKGROUND=0 astro dev",
    "dev:richtext": "MOOD_RICHTEXT_FIXTURE=1 DEV_SURFACE=mood PUBLIC_DEV_SURFACE=mood ASTRO_DEV_BACKGROUND=0 astro dev",
    "dev:preview": "DEV_SURFACE=preview PUBLIC_DEV_SURFACE=preview ASTRO_DEV_BACKGROUND=0 astro dev",
    "dev:portal": "ADMIN_DEV_BYPASS=1 DEV_SURFACE=preview PUBLIC_DEV_SURFACE=preview ASTRO_DEV_BACKGROUND=0 astro dev",
    "dev:api": "API_DEV_ORIGIN=http://127.0.0.1:8787 ASTRO_DEV_BACKGROUND=0 astro dev",
    "build": "astro build && bun scripts/generate-agent-markdown.ts && pagefind --site dist/client",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "check": "astro sync && node scripts/astro-check-legacy-typescript.mjs",
    "check:route-contracts": "bun scripts/check-route-contracts.ts",
    "preview": "bun run preview:cloudflare",
    "deploy:cloudflare": "bun run build:cloudflare && wrangler deploy --config dist/server/wrangler.json",
    "preview:cloudflare": "bun run build:cloudflare && wrangler dev --config dist/server/wrangler.json",
    "tail:cloudflare": "wrangler tail",
    "types:cloudflare": "wrangler types",
    "test:unit": "bun test tests/unit",
    "test:ops": "bun test tests/ops/*.test.ts",
    "test:e2e": "bun run test:e2e:site",
    "test:e2e:coverage": "rm -rf .nyc_output coverage/e2e && E2E_PORT=4331 COVERAGE=1 playwright test && nyc --nycrc-path config/nyc.json report",
    "test:e2e:site": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "mascot:show": "bun scripts/mascot.ts show",
    "mascot:diff": "bun scripts/mascot.ts diff",
    "doctor": "npx react-doctor@latest"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/cloudflare": "14.1.2",
    "@astrojs/react": "^6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "@cloudflare/workers-types": "^5.20260708.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.1.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.2",
    "bun-types": "^1.3.14",
    "nyc": "^18.0.0",
    "pagefind": "^1.5.2",
    "postcss": "^8.5.16",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "typescript-astro-check": "npm:typescript@5.9.3",
    "vite-plugin-istanbul": "^9.0.1",
    "wrangler": "^4.107.1"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.3",
    "@bunizao/contracts": "workspace:*",
    "@bunizao/decode-text": "workspace:*",
    "@chenglou/pretext": "^0.0.8",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@tryghost/content-api": "^1.12.10",
    "astro": "^7.0.7",
    "cheerio": "1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "domhandler": "6.0.1",
    "flourite": "^1.3.0",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "jose": "^6.2.3",
    "justified-layout": "4.1.0",
    "lru-cache": "^11.5.2",
    "lucide-react": "^1.23.0",
    "ofetch": "^1.5.1",
    "prismjs": "^1.30.0",
    "prismjs-components-importer": "^0.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "slot-text": "^0.3.2",
    "tailwind-merge": "^3.6.0"
  },
  "overrides": {
    "ajv": "8.18.0",
    "devalue": "5.8.1",
    "esbuild": "0.28.1",
    "js-yaml": "4.2.0",
    "minimatch": "9.0.9",
    "path-to-regexp": "6.3.0",
    "rollup": "4.59.0",
    "svgo": "4.0.1",
    "tar": "7.5.11",
    "ws": "8.21.0",
    "yaml": "2.8.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.6"
}
