{{!< default}}
{{!-- {{id}} in a post context is the 24-char Ghost Admin post id — exactly
      what /dev/blog/[id] on the site accepts. --}}
<iframe
    src="https://buxx.me/dev/blog/{{id}}"
    title="{{title}}"
    allow="autoplay; encrypted-media"
    style="position: fixed; inset: 0; width: 100vw; height: 100vh; border: 0;"
></iframe>
