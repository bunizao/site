---
interface Props {
  title: string;
  description?: string;
  active?: PortalNavKey;
  chrome?: 'full' | 'bare';
  user?: {
    login: string;
    email?: string;
    avatarUrl?: string;
  };
}

import '@/styles/globals.css';
import '@/styles/portal.css';
import { ClientRouter } from 'astro:transitions';
import { ExternalLink, LogOut, Moon, Sun } from 'lucide-react';
import { PORTAL_NAV_GROUPS, type PortalNavKey } from '@/features/admin/portal-nav';
// Brand mark served by the live /logo/<id>.svg route (the old sticker module was removed).
import { SITE_FAVICON } from '@/lib/favicon';
const BRAND_MARK = { src: '/logo/peek.svg?v=3', width: 88, height: 80 };

const { title, description, active = 'overview', chrome = 'full', user: userProp } = Astro.props;

const sessionFromLocals = (Astro.locals as any)?.adminSession as
  | { login?: string; email?: string; avatarUrl?: string }
  | undefined;

const user = userProp
  ? {
      login: userProp.login,
      email: userProp.email ?? sessionFromLocals?.email,
      avatarUrl: userProp.avatarUrl ?? sessionFromLocals?.avatarUrl,
    }
  : sessionFromLocals?.login
    ? { login: sessionFromLocals.login, email: sessionFromLocals.email, avatarUrl: sessionFromLocals.avatarUrl }
    : undefined;
---

<!doctype html>
<html lang="en" class="theme-portal">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (() => {
        if (navigator.vendor === 'Apple Computer, Inc.') {
          document.documentElement.classList.add('ua-webkit');
        }
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {}
        const setting = stored === 'light' || stored === 'dark' ? stored : 'system';
        const dark = setting === 'dark' || (setting === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.themeSetting = setting;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href={SITE_FAVICON} />
    <link rel="preload" href="/fonts/geist-sans-variable.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <ClientRouter />
  </head>
  <body>
    <div class="portal-shell" data-chrome={chrome}>
      {chrome === 'full' && (
        <aside class="portal-sidebar">
          <div class="portal-sidebar-brand">
            <img
              class="portal-brand-mark"
              src={BRAND_MARK.src}
              alt=""
              width={BRAND_MARK.width}
              height={BRAND_MARK.height}
              decoding="async"
            />
            <div class="portal-brand-word">
              <span class="portal-brand-name">Dev Portal</span>
              <span class="portal-brand-sub">buxx.me</span>
            </div>
          </div>
          <nav class="portal-nav">
            {PORTAL_NAV_GROUPS.map((group) => (
              <div class="portal-nav-group">
                <div class="portal-nav-label">{group.label}</div>
                {group.items.map((item) => (
                  <a
                    href={item.href}
                    class="portal-sidebar-link"
                    aria-current={active === item.key ? 'page' : undefined}
                    data-astro-prefetch="hover"
                  >
                    <item.Icon size={15} />
                    <span>{item.label}</span>
                  </a>
                ))}
              </div>
            ))}
          </nav>
          <div class="portal-sidebar-spacer"></div>
          <a class="portal-sidebar-link portal-sidebar-link--muted" href="/" target="_blank" rel="noreferrer">
            <ExternalLink size={15} />
            <span>View site</span>
          </a>
          {user && (
            <div class="portal-sidebar-user">
              {user.avatarUrl ? (
                <img src={user.avatarUrl} alt={`@${user.login}`} loading="lazy" referrerpolicy="no-referrer" />
              ) : (
                <div class="portal-sidebar-user-fallback">
                  {user.login.slice(0, 1).toUpperCase()}
                </div>
              )}
              <div class="portal-sidebar-user-meta">
                <div class="portal-sidebar-user-name">{user.login}</div>
                <div class="portal-sidebar-user-email">{user.email ?? 'Admin'}</div>
              </div>
              <a href="/cdn-cgi/access/logout?returnTo=https%3A%2F%2Fbuxx.me%2F" class="portal-logout" aria-label="Sign out">
                <LogOut size={13} />
              </a>
            </div>
          )}
        </aside>
      )}
      <div class="portal-content">
        <header class="portal-topbar">
          <div>
            <h1 class="portal-topbar-title">{title}</h1>
            {description && <div class="portal-topbar-description">{description}</div>}
          </div>
          <div class="portal-topbar-spacer"></div>
          <button class="portal-theme-toggle" type="button" data-portal-theme-toggle aria-label="Switch theme">
            <Sun className="portal-theme-icon portal-theme-icon--light" size={15} aria-hidden="true" />
            <Moon className="portal-theme-icon portal-theme-icon--dark" size={15} aria-hidden="true" />
          </button>
          <slot name="actions" />
        </header>
        <main class="portal-page">
          <slot />
        </main>
      </div>
    </div>
    <script>
      import { feedback } from '@/lib/feedback';

      const initPortalTheme = () => {
        const toggle = document.querySelector<HTMLElement>('[data-portal-theme-toggle]');
        if (!toggle || toggle.dataset.ready === 'true') return;
        toggle.dataset.ready = 'true';

        let active: { finished: Promise<void>; skipTransition?: () => void } | null = null;
        let webkitThemeTransition = 0;
        toggle.addEventListener('click', () => {
          const root = document.documentElement;
          const nextDark = !root.classList.contains('dark');
          const update = () => {
            root.classList.toggle('dark', nextDark);
            root.dataset.themeSetting = nextDark ? 'dark' : 'light';
            try {
              localStorage.setItem('theme', nextDark ? 'dark' : 'light');
            } catch {}
          };
          feedback.theme();

          const doc = document as Document & {
            startViewTransition?: (callback: () => void) => {
              finished: Promise<void>;
              skipTransition?: () => void;
            };
          };
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
            update();
            return;
          }

          if (root.classList.contains('ua-webkit')) {
            window.clearTimeout(webkitThemeTransition);
            root.classList.remove('theme-wipe-webkit', 'theme-wipe-from-dark', 'theme-wipe-from-light');
            root.classList.add(
              'theme-wipe-webkit',
              root.classList.contains('dark') ? 'theme-wipe-from-dark' : 'theme-wipe-from-light',
              'no-transition',
            );
            update();
            webkitThemeTransition = window.setTimeout(() => {
              root.classList.remove(
                'theme-wipe-webkit',
                'theme-wipe-from-dark',
                'theme-wipe-from-light',
                'no-transition',
              );
            }, 160);
            return;
          }

          if (!doc.startViewTransition) {
            update();
            return;
          }

          active?.skipTransition?.();
          root.classList.add('theme-wipe', 'no-transition');
          try {
            const transition = doc.startViewTransition(update);
            active = transition;
            transition.finished.finally(() => {
              if (active !== transition) return;
              active = null;
              root.classList.remove('theme-wipe', 'no-transition');
            });
          } catch {
            active = null;
            root.classList.remove('theme-wipe', 'no-transition');
            update();
          }
        });
      };

      initPortalTheme();
      document.addEventListener('astro:page-load', initPortalTheme);
    </script>
  </body>
</html>
