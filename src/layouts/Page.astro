---
import Layout from '@/layouts/Layout.astro';

interface Props {
  title: string;
  description: string;
  url?: string;
  robots?: string;
  updatedAt?: string;
  showSiteNav?: boolean;
  headerActionsVariant?: 'default' | 'home';
}

const {
  title,
  description,
  url,
  robots,
  updatedAt,
  showSiteNav = true,
  headerActionsVariant = 'default',
} = Astro.props;
---

<Layout
  title={title}
  description={description}
  url={url}
  robots={robots}
  showSiteNav={showSiteNav}
  navVariant="page"
  headerActionsVariant={headerActionsVariant}
>
  <script is:inline>
    (() => {
      document.body.classList.add('page-template-active');
    })();
  </script>

  <main class="page-template">
    <div class="page-shell">
      {updatedAt ? <p class="page-updated">Updated: {updatedAt}</p> : null}
      <article class="page-content">
        <slot />
      </article>
    </div>
  </main>
</Layout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body.page-template-active) {
    --page-chrome-bg: rgb(250 250 250 / 0.58);
    --page-chrome-border: rgb(17 17 17 / 0.08);
    --page-chrome-fg: #111;
  }

  :global(.dark body.page-template-active) {
    --page-chrome-bg: rgb(10 10 10 / 0.6);
    --page-chrome-border: rgb(255 255 255 / 0.1);
    --page-chrome-fg: #fff;
  }

  .page-template {
    --page-text: #111;
    --page-muted: rgb(17 17 17 / 0.7);
    --page-rule: rgb(17 17 17 / 0.14);
    min-height: 100vh;
    padding: 8.5rem 0 7rem;
    background: #fafafa;
    color: var(--page-text);
    font-family: var(--font-sans);
  }

  :global(.dark) .page-template {
    --page-text: #fff;
    --page-muted: rgb(255 255 255 / 0.78);
    --page-rule: rgb(255 255 255 / 0.14);
    background: #000;
  }

  :global(.site-nav--page) {
    align-items: center;
    justify-content: flex-start;
    height: auto;
    gap: 0;
  }

  /* The page template runs its own chrome color, so the lockup only needs the
     foreground token swapped — brand.css owns the rest. */
  :global(.site-nav--page .site-brand) {
    --brand-fg: var(--page-chrome-fg);

    width: auto;
    height: 34px;
    margin: 0;
    border-radius: 0;
    background: transparent;
  }

  :global(.site-nav--page .site-brand:hover),
  :global(.site-nav--page .site-brand:focus-visible) {
    background: transparent;
    opacity: 0.72;
  }

  .page-shell {
    width: min(100%, 760px);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .page-updated {
    margin: 0 0 1rem;
    color: var(--page-muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  :global(.page-content),
  :global(.page-content :where(h1, h2, h3, p, li, a, strong, em, ul, ol, blockquote, code, pre)) {
    font-family: inherit;
    color: inherit;
  }

  :global(.page-content h1) {
    margin: 0 0 2rem;
    font-size: clamp(2.8rem, 7vw, 4.9rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  :global(.page-content h2) {
    margin: 1.9rem 0 1rem;
    padding-top: 1.9rem;
    border-top: 1px solid var(--page-rule);
    font-size: 2rem;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.045em;
  }

  :global(.page-content h2:first-of-type) {
    margin-top: 0.5rem;
    padding-top: 0;
    border-top: none;
  }

  :global(.page-content h3) {
    margin: 1.5rem 0 0.8rem;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  :global(.page-content p),
  :global(.page-content li) {
    font-size: 1rem;
    line-height: 1.82;
    letter-spacing: -0.008em;
  }

  :global(.page-content p) {
    margin: 0;
  }

  :global(.page-content p + p) {
    margin-top: 1.25rem;
  }

  :global(.page-content ul),
  :global(.page-content ol) {
    margin: 1rem 0 0;
    padding-left: 1.25rem;
  }

  :global(.page-content ul) {
    list-style: disc;
    list-style-position: outside;
  }

  :global(.page-content ol) {
    list-style: decimal;
    list-style-position: outside;
  }

  :global(.page-content li::marker) {
    color: var(--page-text);
  }

  :global(.page-content li + li) {
    margin-top: 0.85rem;
  }

  :global(.page-content strong) {
    font-weight: 600;
  }

  :global(.page-content a) {
    color: var(--page-text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  :global(.page-content a:hover),
  :global(.page-content a:focus-visible) {
    text-decoration-thickness: 2px;
  }

  :global(.page-content blockquote) {
    margin: 1.4rem 0 0;
    padding-left: 1rem;
    border-left: 2px solid var(--page-rule);
    color: var(--page-muted);
  }

  :global(.page-content code) {
    font-size: 0.95em;
  }

  @media (max-width: 899px) {
    .page-template {
      padding: calc(env(safe-area-inset-top, 0px) + 4.85rem) 0 5.5rem;
    }

    .page-shell {
      padding: 0 1rem;
    }

    :global(body.page-template-active .site-nav--page) {
      top: var(--site-nav-mobile-top);
      left: 0;
      right: 0;
      z-index: 60;
      height: var(--site-nav-mobile-height);
      padding: var(--site-nav-mobile-padding);
      gap: var(--site-nav-mobile-gap);
      border-bottom: 1px solid var(--page-chrome-border);
      background: var(--page-chrome-bg);
      -webkit-backdrop-filter: blur(14px) saturate(140%);
      backdrop-filter: blur(14px) saturate(140%);
      backface-visibility: hidden;
      transform: translateZ(0);
    }

    :global(body.page-template-active .site-nav--page::before) {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: calc(env(safe-area-inset-top, 0px) * -1);
      height: env(safe-area-inset-top, 0px);
      background: var(--page-chrome-bg);
      -webkit-backdrop-filter: blur(14px) saturate(140%);
      backdrop-filter: blur(14px) saturate(140%);
      pointer-events: none;
      backface-visibility: hidden;
      transform: translateZ(0);
    }

    :global(body.page-template-active .site-nav--page .site-brand) {
      --brand-logo-height: var(--site-nav-mobile-logo-height);

      width: auto;
      min-width: var(--site-nav-mobile-brand-min-width);
      min-height: var(--site-nav-mobile-action-size);
      margin: 0;
      padding-right: 0;
      overflow: hidden;
    }

    /* The box shrink-wraps the art; the derived --brand-gap owns the spacing. */
    :global(body.page-template-active .site-nav--page .site-brand-logo) {
      position: relative;
      z-index: 2;
      transform: translateX(0);
    }

    :global(body.page-template-active .site-nav--page .site-brand-text) {
      width: var(--site-nav-mobile-wordmark-width);
      flex: 0 0 var(--site-nav-mobile-wordmark-width);
      max-width: var(--site-nav-mobile-wordmark-width);
    }

    :global(.page-content h1) {
      margin-bottom: 1.6rem;
    }

    :global(.page-updated),
    :global(.page-content p),
    :global(.page-content li) {
      font-size: 0.98rem;
      line-height: 1.78;
    }

    :global(.page-content h2) {
      font-size: 1.7rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }
</style>
