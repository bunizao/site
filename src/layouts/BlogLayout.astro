---
// Standalone layout for the /blog zone. Deliberately minimal chrome — the
// publication mark + theme toggle only, no site nav or spotlight — to keep
// chl.ee's calm. Reuses the global token system and theme storage contract so
// dark mode stays in sync with the rest of buxx.me.
import '../styles/globals.css';
import '../styles/blog.css';
import '../styles/embed-youtube.css';
import { meta, blog, blogPalette, type BlogLocale } from '@/data/site';
import {
  BLOG_OG_IMAGE_HEIGHT,
  BLOG_OG_IMAGE_WIDTH,
  buildBlogOgImageUrl,
  normalizeBlogMetaText,
} from '@/features/posts/server/og-image';
import BlogSearch from '@/features/posts/ui/BlogSearch.astro';
import CommandPalette from '@/components/CommandPalette.astro';
import PageScroller from '@/components/PageScroller.astro';
import { hasMarkdownRenderer } from '@/features/agent-markdown/server/registry';
import { BLOG_FAVICON } from '@/lib/favicon';
import { serializeScriptJson } from '@/lib/serialize-script-json';
import { profileAlternateNames, profileName } from '@/lib/seo';
import ViewTransitionReveal from './client/ViewTransitionReveal.astro';

interface Props {
  title: string;
  description?: string;
  /** Path under the site origin, e.g. "/blog/" or "/blog/my-post/". */
  path?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
  publishedTime?: string;
  modifiedTime?: string;
  authorName?: string;
  tags?: string[];
  robots?: string;
  /**
   * Language of the page's *content*. The publication's chrome — masthead,
   * colophon, nav — stays in `blog.locale.blog` regardless: this is the
   * article's voice, not the site's identity.
   */
  locale?: BlogLocale;
  /**
   * Keep the page out of Pagefind while leaving it indexable by search engines.
   * A translation wants exactly this: Google should find it, site search should
   * not surface it twice under content its sibling already covers.
   */
  excludeFromSearch?: boolean;
  /**
   * Every language this article exists in, itself included — Google ignores a
   * cluster that does not list all of its members.
   */
  languageAlternates?: { locale: string; href: string }[];
  /** Preload hint for the page's LCP image (e.g. the post feature image). */
  preloadImage?: { href: string; srcset?: string; sizes?: string };
}

const {
  title,
  description = blog.copy.zh.tagline,
  path = '/blog/',
  ogType = 'website',
  ogImage: customOgImage,
  ogImageAlt,
  publishedTime,
  modifiedTime,
  authorName,
  tags = [],
  robots,
  locale = blog.locale.blog,
  excludeFromSearch = false,
  languageAlternates = [],
  preloadImage,
} = Astro.props;
const canonical = new URL(path, meta.siteUrl).href;
// x-default is "the version for a reader we have no better answer for", which
// is the publication's default language — found by name, not by list position.
const xDefault =
  languageAlternates.find((alternate) => alternate.locale === blog.locale.default)
  ?? languageAlternates[0];
const xDefaultHref = xDefault ? new URL(xDefault.href, meta.siteUrl).href : null;
const excludesIndexing = robots
  ?.split(',')
  .some((directive) => directive.trim().toLowerCase() === 'noindex') ?? false;
const markdownAlternateUrl = !excludesIndexing && hasMarkdownRenderer(new URL(canonical).pathname)
  ? canonical
  : null;
const pageTitle = normalizeBlogMetaText(title) || blog.name;
const fullTitle = pageTitle === blog.name ? pageTitle : `${pageTitle} — ${blog.name}`;
const metaDescription = normalizeBlogMetaText(description) || meta.description;
const ogImage = customOgImage
  ? new URL(customOgImage, meta.siteUrl).href
  : buildBlogOgImageUrl({
      title: pageTitle,
      site: blog.name,
      excerpt: metaDescription,
    });
const resolvedOgImageAlt = ogImageAlt ?? fullTitle;
const blogMarkAsset = blog.mark;
const ogLogoUrl = new URL(blogMarkAsset, meta.siteUrl).href;
const articleTags = tags.map((tag) => tag.trim()).filter(Boolean);
const resolvedAuthorName = authorName ?? blog.author.name;
const isProfileAuthor = resolvedAuthorName === profileName
  || profileAlternateNames.includes(resolvedAuthorName);
const articleAuthor = isProfileAuthor
  ? {
      '@type': 'Person',
      '@id': `${meta.siteUrl}/#person`,
      name: profileName,
      ...(resolvedAuthorName === profileName ? {} : { alternateName: resolvedAuthorName }),
      url: blog.author.home,
    }
  : {
      '@type': 'Person',
      name: resolvedAuthorName,
    };
const articleStructuredData = ogType === 'article'
  ? serializeScriptJson({
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: pageTitle,
      description: metaDescription,
      url: canonical,
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonical,
      },
      image: {
        '@type': 'ImageObject',
        url: ogImage,
        width: BLOG_OG_IMAGE_WIDTH,
        height: BLOG_OG_IMAGE_HEIGHT,
      },
      author: articleAuthor,
      publisher: {
        '@type': 'Organization',
        name: blog.name,
        url: new URL('/blog/', meta.siteUrl).href,
        logo: {
          '@type': 'ImageObject',
          url: new URL(BLOG_FAVICON, meta.siteUrl).href,
          width: 128,
          height: 128,
        },
      },
      datePublished: publishedTime,
      dateModified: modifiedTime ?? publishedTime,
      ...(articleTags.length > 0 ? { keywords: articleTags } : {}),
    })
  : null;

// Emit the blog ink set (site.ts is the source of truth) as CSS custom
// properties scoped to .blog-zone. --blog-accent stays as the primary alias so
// every existing consumer keeps working; dai/dian/ji expose the semantic roles.
const { dai, dian, ji } = blogPalette;
const paletteCss = [
  `.blog-zone{--blog-accent:${dai.light};--blog-dai:${dai.light};--blog-dian:${dian.light};--blog-ji:${ji.light};}`,
  `.dark .blog-zone{--blog-accent:${dai.dark};--blog-dai:${dai.dark};--blog-dian:${dian.dark};--blog-ji:${ji.dark};}`,
].join('');
---

<!doctype html>
<!-- The publication is Chinese-primary, and every page says so unless it is
     carrying a translation. The lang also feeds Pagefind's language detection
     at index time (an `en` lang skips CJK segmentation), which is consistent:
     the pages that set `en` here are the ones excluded from the index. -->
<!-- The root does not scroll in this zone. Why that is load-bearing rather than
     a layout preference: page-scroller.css and @/lib/page-scroll. -->
<html lang={locale} class="page-scroll-root">
  <head>
    <meta charset="utf-8" />
    <!-- `cover` does not make the insets readable on iOS 26 — measured on an
         iPhone 16 Pro Max, env(safe-area-inset-top) is 0 either way. It stays
         because the layout is edge-to-edge regardless and other zones share the
         declaration. -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    {robots ? <meta name="robots" content={robots} /> : null}
    <link rel="canonical" href={canonical} />
    {markdownAlternateUrl ? (
      <link rel="alternate" type="text/markdown" href={markdownAlternateUrl} />
    ) : null}
    {languageAlternates.map((alternate) => (
      <link
        rel="alternate"
        hreflang={alternate.locale}
        href={new URL(alternate.href, meta.siteUrl).href}
      />
    ))}
    {xDefaultHref && (
      <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
    )}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${blog.name} RSS`}
      href={new URL(blog.feed, meta.siteUrl).href}
    />
    <!-- The SVG mark carries its own prefers-color-scheme swap; tab strips
         ignore site CSS, so the raster webp cannot follow dark mode. -->
    <link rel="icon" href={BLOG_FAVICON} type="image/svg+xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={blog.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={blog.copy[locale].ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(BLOG_OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(BLOG_OG_IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content={resolvedOgImageAlt} />
    <meta property="og:logo" content={ogLogoUrl} />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {ogType === 'article' && authorName && <meta property="article:author" content={authorName} />}
    {ogType === 'article' && articleTags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={resolvedOgImageAlt} />
    {articleStructuredData && (
      <script type="application/ld+json" is:inline set:html={articleStructuredData} />
    )}

    <!-- Blog ink set — values owned by blogPalette in src/data/site.ts. -->
    <style set:html={paletteCss}></style>

    {preloadImage && (
      <link
        rel="preload"
        as="image"
        href={preloadImage.href}
        imagesrcset={preloadImage.srcset}
        imagesizes={preloadImage.sizes}
        fetchpriority="high"
      />
    )}

    <link
      rel="preload"
      href="/fonts/inter-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/wenkai-wordmark.woff2"
      as="font"
      type="font/woff2"
      crossorigin
      fetchpriority="high"
    />

    <!-- No-FOUC theme init. Mirrors the global contract (storageKey 'theme',
         data-theme-setting, .dark class) so a choice made here or on the main
         site applies on both. -->
    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        // All WebKit browsers (Safari + every iOS browser) report the Apple
        // vendor string. The class gates the glass rules in
        // globals.css/blog.css; it must exist before first render so the
        // incoming page of a navigation already matches.
        if (navigator.vendor === 'Apple Computer, Inc.') {
          document.documentElement.classList.add('ua-webkit');
        }
        // The masthead lockup's 1.77s entrance is a first-arrival flourish, and
        // /blog/ is a hub a reader passes through several times in one session
        // (list → post → back → post). Replaying it every time turns delight
        // into a wait. Set before first paint so the incoming page of a
        // navigation already matches.
        try {
          if (sessionStorage.getItem('wordmark-seen')) {
            document.documentElement.classList.add('wordmark-seen');
          } else {
            sessionStorage.setItem('wordmark-seen', '1');
          }
        } catch (e) {}
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (e) {}
        const prefersDark =
          typeof window.matchMedia === 'function' &&
          window.matchMedia('(prefers-color-scheme: dark)').matches;
        const setting = stored === 'light' || stored === 'dark' ? stored : 'system';
        const isDark = setting === 'dark' || (setting === 'system' && prefersDark);
        document.documentElement.dataset.themeSetting = setting;
        document.documentElement.classList.toggle('dark', isDark);

        // Tag a language switch so the root view transition can be a swap
        // rather than an arrival (see globals.css). Same article, same layout,
        // same boxes — only the words change, and the arrival's lift, scale and
        // 460ms of expo is what made the switcher feel stuck.
        //
        // This lives in the no-FOUC script and not in a bundled module because
        // `pagereveal` fires ~25ms *before* deferred module scripts execute: by
        // the time an import has run, the transition it was meant to describe
        // has already started. Cross-document transitions are styled by the new
        // document, so the arriving side is the only side that can do this, and
        // view-transition types set on the outgoing `pageswap` do not carry
        // over.
        window.addEventListener('pagereveal', (event) => {
          const transition = event.viewTransition;
          if (!transition) return;
          // The Navigation API reports the entry actually left, so a back or
          // forward traversal reads as the move it is; `document.referrer` is
          // the fallback, and carries the full URL on a same-origin navigation.
          /** @type {any} Navigation API; not in this TypeScript's `lib.dom`. */
          const nav = window;
          const activation = nav.navigation && nav.navigation.activation;
          const from = (activation && activation.from && activation.from.url) || document.referrer;
          if (!from) return;

          let isSwitch = false;
          try {
            const left = new URL(from);
            const right = new URL(location.href);
            // Parsed, not string-compared: `/blog/x` and `/blog/x/` are one
            // article, and the *absence* of the parameter — the default locale,
            // which owns the bare URL — has to compare equal to itself rather
            // than to every other value.
            isSwitch =
              left.origin === right.origin &&
              left.pathname.replace(/\/$/, '') === right.pathname.replace(/\/$/, '') &&
              left.searchParams.get('lang') !== right.searchParams.get('lang');
          } catch (e) {}
          if (!isSwitch) return;

          const root = document.documentElement;
          root.dataset.vtKind = 'lang';
          // The attribute describes the navigation in flight and nothing else.
          // Left behind it would hand the next one a transition written for
          // this one.
          const clear = () => delete root.dataset.vtKind;
          transition.finished.then(clear, clear);
        });
      })();
    </script>

    <!-- Incoming half of the view-transition name broker. Inline and in <head>
         because `pagereveal` fires before any deferred module can run. -->
    <ViewTransitionReveal />
  </head>

  <body
    class="blog-zone reading"
    data-pagefind-ignore={excludesIndexing || excludeFromSearch ? 'all' : undefined}
  >
    <!-- Outside the scroller: it is a fixed lid, and a fixed layer inside a
         scroll container cannot read that container's anonymous timeline. It gets
         driven by the named one the scroller publishes instead. -->
    <slot name="readingbar" />
    <PageScroller class="blog-scroller" restorationKey="blog-scroll">
      <div class="blog-shell">
        <header class="blog-topbar">
          <a class="blog-mark" href="/blog/" aria-label={blog.name} style="view-transition-name:blog-mark">
            <img src={blogMarkAsset} alt={blog.name} width="40" height="40" />
          </a>

          <div class="blog-topbar__controls">
            <!-- Language toggle (zh/en) slots in here when the bilingual phase lands. -->
            <BlogSearch />
            <button
              class="blog-theme-toggle"
              type="button"
              data-blog-theme-toggle
              aria-label="Switch theme"
            >
              <span data-blog-icon="light" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" /></svg>
              </span>
              <span data-blog-icon="dark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" /></svg>
              </span>
              <span data-blog-icon="system" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" /><path d="M8 21h8M12 17v4" /></svg>
              </span>
            </button>
          </div>
        </header>

        <slot />
      </div>
    </PageScroller>

    <CommandPalette />

    <script>
      import { initSubscribePanels } from '@/features/notify/subscribe-panel';
      import { initYouTubeEmbeds } from '@/lib/embed/youtube-controller';
      import { initViewTransitionNames } from '@/lib/view-transition-names';
      initSubscribePanels();
      initYouTubeEmbeds();
      // Outgoing half: decides which single element (if any) may morph across
      // the next navigation. Deferred is fine — it only has to beat a click.
      // The incoming half is <ViewTransitionReveal /> in <head>, which must be
      // inline to beat `pagereveal`.
      initViewTransitionNames();
    </script>

    <script is:inline>
      (() => {
        const toggle = document.querySelector('[data-blog-theme-toggle]');
        if (!toggle) return;
        const order = ['system', 'light', 'dark'];
        const media =
          typeof window.matchMedia === 'function'
            ? window.matchMedia('(prefers-color-scheme: dark)')
            : null;

        const getSetting = () => {
          let stored = null;
          try {
            stored = localStorage.getItem('theme');
          } catch (e) {}
          return stored === 'light' || stored === 'dark' ? stored : 'system';
        };

        const apply = (setting) => {
          const isDark =
            setting === 'dark' || (setting === 'system' && media && media.matches);
          document.documentElement.dataset.themeSetting = setting;
          document.documentElement.classList.toggle('dark', isDark);
          try {
            if (setting === 'system') localStorage.removeItem('theme');
            else localStorage.setItem('theme', setting);
          } catch (e) {}
        };

        toggle.addEventListener('click', () => {
          const next = order[(order.indexOf(getSetting()) + 1) % order.length];
          apply(next);
        });

        if (media) {
          media.addEventListener('change', () => {
            if (getSetting() === 'system') apply('system');
          });
        }
      })();
    </script>

  </body>
</html>
