---
import { FONT_FILES, type Face } from '@/lib/fonts';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number | null;
  imageHeight?: number | null;
  url?: string;
  robots?: string;
  hideSiteNav?: boolean;
  showSiteNav?: boolean;
  navVariant?: 'home' | 'page';
  brandVariant?: 'home';
  headerActionsVariant?: 'default' | 'home';
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
  // The faces this route paints above the fold, in priority order. Every face
  // is font-display: swap, so one that is painted early but not preloaded is a
  // guaranteed reflow the moment it arrives.
  preloadFont?: Face | Face[];
  preloadImages?: Array<{
    href: string;
    imageSrcSet?: string;
    imageSizes?: string;
  }>;
  rss?: {
    href: string;
    title?: string;
  };
  oembed?: {
    href: string;
    title?: string;
  };
}

import '../styles/globals.css';
import '../features/mood/styles/feed-rich-text.css';
import { Moon, Sun, Monitor, Menu, X } from 'lucide-react';
import AnimatedLogo from '@/features/logos/ui/AnimatedLogo.astro';
import CommandPalette from '@/components/CommandPalette.astro';
import SearchButton from '@/components/SearchButton.astro';
import SiteBrand from '@/components/SiteBrand.astro';
import Topbar from '@/components/Topbar.astro';
import {
  PEEK_NAVBAR_LOGO,
  getPeekRuntimeSlot,
  getPeekRuntimeSlotKey,
} from '@/features/logos/data/peek-runtime';
import { meta, navLinks } from '@/data/site';
import { hasMarkdownRenderer } from '@/features/agent-markdown/server/registry';
import { serializeScriptJson } from '@/lib/serialize-script-json';
import { SITE_FAVICON } from '@/lib/favicon';

const {
  title,
  description,
  image = '/og.png',
  imageAlt = meta.siteName,
  imageWidth = 1200,
  imageHeight = 630,
  url,
  robots,
  hideSiteNav = false,
  showSiteNav = false,
  navVariant,
  brandVariant,
  headerActionsVariant = 'default',
  structuredData,
  // Geist Mono carries the site identity (nav brand, meta) and Inter is the
  // body face on every page, so both are worth the priority everywhere. Routes
  // whose headline uses a third face add it themselves.
  preloadFont = ['mono', 'sans'],
  preloadImages = [],
  rss,
  oembed,
} = Astro.props;

const isHomeNav = navVariant === 'home';
const isPageNav = navVariant === 'page';
// Render the home brand identity (big animated peek + wordmark) inside a plain
// horizontal bar on non-home pages that want it (e.g. /components). It reuses
// home's brand look without home's scroll-driven vertical sidebar.
const brandHome = brandVariant === 'home';
const brandRich = isHomeNav || brandHome;
// The mobile menu follows the site nav and stays off chrome-hiding pages and
// embedded specimen previews.
const showMenu = !hideSiteNav;
const showsBrandText = isHomeNav || isPageNav || brandHome;
const useHomeHeaderActions = isHomeNav || headerActionsVariant === 'home';
const site = Astro.site ?? new URL('https://buxx.me');
const siteName = meta.siteName;
const canonicalUrl = new URL(url ?? Astro.url?.pathname ?? '/', site).href;
const markdownAlternateUrl = hasMarkdownRenderer(new URL(canonicalUrl).pathname)
  ? canonicalUrl
  : null;
const ogImageUrl = new URL(image, site).href;
const ogLogoUrl = new URL('/logo/peek.svg?v=3', site).href;
const structuredDataItems = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
const structuredDataItemsJson = structuredDataItems.map((item) => serializeScriptJson(item));
const ogImagePath = new URL(ogImageUrl).pathname;
const ogImageType = ogImagePath.endsWith('.png')
  ? 'image/png'
  : ogImagePath.endsWith('.webp')
    ? 'image/webp'
    : 'image/jpeg';
const hasOgImageDimensions = Boolean(imageWidth && imageHeight);
const navbarDefaultAnimation = getPeekRuntimeSlotKey('navbar.brand.default');
const navbarHoverAnimation = getPeekRuntimeSlotKey('navbar.brand.hover');
const navbarLinkHoverAnimation = getPeekRuntimeSlotKey('navbar.nav-link.hover');
const navbarSectionActiveAnimation = getPeekRuntimeSlotKey('navbar.section.active');
const navbarSectionActiveHoldMs = getPeekRuntimeSlot('navbar.section.active').holdMs ?? 600;
const navbarFastScrollHoldMs = getPeekRuntimeSlot('navbar.brand.hover').holdMs ?? 1000;
const navbarIdleTimeoutAnimation = getPeekRuntimeSlotKey('navbar.idle-timeout');
const preloadFontHrefs = (Array.isArray(preloadFont) ? preloadFont : [preloadFont]).map(
  (face) => FONT_FILES[face],
);
const wordmarkFontHref = '/fonts/wenkai-wordmark.woff2';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {preloadFontHrefs.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    {isHomeNav && (
      <link rel="preload" href={wordmarkFontHref} as="font" type="font/woff2" crossorigin fetchpriority="high" />
    )}
    {robots ? <meta name="robots" content={robots} /> : null}
    {preloadImages.map((image) => (
      <link
        rel="preload"
        as="image"
        href={image.href}
        imagesrcset={image.imageSrcSet}
        imagesizes={image.imageSizes}
        fetchpriority="high"
      />
    ))}
    <link rel="canonical" href={canonicalUrl} />
    {markdownAlternateUrl ? (
      <link rel="alternate" type="text/markdown" href={markdownAlternateUrl} />
    ) : null}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:alt" content={imageAlt} />
    {hasOgImageDimensions ? (
      <>
        <meta property="og:image:width" content={String(imageWidth)} />
        <meta property="og:image:height" content={String(imageHeight)} />
      </>
    ) : null}
    <meta property="og:logo" content={ogLogoUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="icon" type="image/svg+xml" href={SITE_FAVICON} />
    <link rel="mask-icon" href="/logo/peek.svg" color="#0a0a0a" />
    {rss?.href ? (
      <link
        rel="alternate"
        type="application/rss+xml"
        title={rss.title ?? title}
        href={new URL(rss.href, site).href}
      />
    ) : null}
    {oembed?.href ? (
      <link
        rel="alternate"
        type="application/json+oembed"
        title={oembed.title ?? title}
        href={new URL(oembed.href, site).href}
      />
    ) : null}
    {structuredDataItemsJson.map((itemJson) => (
      <script type="application/ld+json" is:inline set:html={itemJson} />
    ))}

    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        // All WebKit browsers (Safari + every iOS browser) report the Apple
        // vendor string. The class gates the glass rules in
        // globals.css/blog.css; it must exist before first render so the
        // incoming page of a navigation already matches.
        if (navigator.vendor === 'Apple Computer, Inc.') {
          document.documentElement.classList.add('ua-webkit');
        }
        const storageKey = 'theme';
        const readStoredTheme = () => {
          try {
            return localStorage.getItem(storageKey);
          } catch (error) {
            return null;
          }
        };
        const storedTheme = readStoredTheme();
        const mediaQuery =
          typeof window.matchMedia === 'function'
            ? window.matchMedia('(prefers-color-scheme: dark)')
            : null;
        const prefersDark = mediaQuery ? mediaQuery.matches : false;

        // Determine the effective theme (what's actually displayed)
        const effectiveTheme =
          storedTheme === 'light' || storedTheme === 'dark'
            ? storedTheme
            : prefersDark
              ? 'dark'
              : 'light';

        // Set the theme setting attribute for icon display
        const themeSetting = storedTheme === 'light' || storedTheme === 'dark' ? storedTheme : 'system';
        document.documentElement.dataset.themeSetting = themeSetting;
        document.documentElement.classList.toggle('dark', effectiveTheme === 'dark');
      })();
    </script>

    <script>
      // Dynamic import keeps the overscroll handler in a bundled, HTTP-cached
      // chunk instead of Astro inlining it into every HTML response.
      import('@/layouts/client/visual-viewport');
    </script>

    <script>
      // Decides which single element (if any) may morph across the next
      // navigation. Must register before any click can navigate away.
      import { initViewTransitionNames } from '@/lib/view-transition-names';
      initViewTransitionNames();
    </script>

    <title>{title}</title>
  </head>
  <body>
    <div class="spotlight-overlay" data-spotlight-overlay aria-hidden="true">
      <div class="spotlight-overlay__grid spotlight-overlay__grid--soft"></div>
      <div class="spotlight-overlay__grid spotlight-overlay__grid--core"></div>
    </div>

    <!-- Site navigation -->
    {!hideSiteNav && (
      <Topbar
        as="nav"
        progressiveBlur={brandRich}
        class:list={[
          'site-nav',
          {
            'site-nav--mobile-visible': showSiteNav,
            'site-nav--home': isHomeNav,
            'site-nav--page': isPageNav,
            'site-nav--brand-home': brandHome,
          },
        ]}
        data-site-nav
        data-peek-link-hover={navbarLinkHoverAnimation}
        data-peek-section-active={navbarSectionActiveAnimation}
        data-peek-section-active-hold-ms={String(navbarSectionActiveHoldMs)}
        data-peek-fast-scroll={navbarHoverAnimation}
        data-peek-fast-scroll-hold-ms={String(navbarFastScrollHoldMs)}
        data-peek-idle-timeout={navbarIdleTimeoutAnimation}
        aria-label={isPageNav ? 'Home' : 'Page sections'}
      >
        {!isPageNav ? <div class="nav-active-indicator" data-nav-indicator aria-hidden="true"></div> : null}
        <SiteBrand
          label="buxx.me — home"
          animation={navbarDefaultAnimation}
          hoverAnimation={brandRich ? navbarHoverAnimation : undefined}
          size={brandRich ? 40 : 20}
          wordmark={showsBrandText}
          eventChannel={brandRich ? 'nav' : undefined}
          eventAnimations={brandRich
            ? [
                navbarLinkHoverAnimation,
                navbarSectionActiveAnimation,
                navbarHoverAnimation,
                navbarIdleTimeoutAnimation,
              ]
            : undefined}
        />
        {!isPageNav && (
          <div class="nav-links" data-nav-links>
            <span class="nav-separator nav-separator--brand" aria-hidden="true">/</span>
            {navLinks.map((link, i) => (
              <Fragment>
                {i > 0 && <span class="nav-separator" aria-hidden="true">/</span>}
                <a href={link.href} class="nav-link" data-nav-link={link.section ?? link.href}>{link.label}</a>
              </Fragment>
            ))}
          </div>
        )}
      </Topbar>
    )}

    <!-- Site menu: top-right dropdown (site-wide) -->
    {showMenu && (
      <div class:list={['site-menu', { 'site-menu--desktop': brandHome }]} data-site-menu hidden>
        <div class="site-menu-scrim" data-menu-close aria-hidden="true"></div>
        <div
          class="site-menu-sheet"
          id="site-menu-sheet"
          role="dialog"
          aria-modal="true"
          aria-label="Site menu"
          data-menu-sheet
        >
          <nav class="site-menu-links" aria-label="Pages">
            <a href="/" class="site-menu-link" data-menu-link>Home</a>
            {navLinks.map((link) => (
              <a href={link.href} class="site-menu-link" data-menu-link>{link.label}</a>
            ))}
          </nav>
          <div class="site-menu-mascot" aria-hidden="true">
            <AnimatedLogo
              definition={PEEK_NAVBAR_LOGO}
              animation="idle"
              size={40}
              title="peek"
              eventChannel="menu"
            />
          </div>
        </div>
      </div>
    )}

    <!-- Global header actions - theme dropdown will be added by pages -->
    <div
      class:list={[
        'global-header-actions',
        {
          'global-header-actions--home': useHomeHeaderActions,
          'has-menu-sheet': showMenu,
          'has-brand-home-bar': brandHome,
        },
      ]}
      data-header-actions
    >
      <SearchButton class={brandHome ? 'topbar-action topbar-action--search' : undefined} />
      <div class="theme-dropdown" data-theme-dropdown>
        <button class:list={['header-action-btn', { 'topbar-action': brandHome }]} type="button" data-theme-toggle aria-label="Switch theme" aria-haspopup="true" aria-expanded="false">
          <span class="theme-icon-container">
            <span class="theme-icon" data-theme-icon="light" aria-hidden="true">
              <Sun className="h-4 w-4" />
            </span>
            <span class="theme-icon" data-theme-icon="dark" aria-hidden="true">
              <Moon className="h-4 w-4" />
            </span>
            <span class="theme-icon" data-theme-icon="system" aria-hidden="true">
              <Monitor className="h-4 w-4" />
            </span>
          </span>
          <span class="header-action-btn-label" data-theme-label>System</span>
        </button>
        <div class="theme-dropdown-menu" data-theme-menu role="menu" aria-label="Theme options">
          <button class="theme-dropdown-item" data-theme-option="light" role="menuitem">
            <Sun className="h-4 w-4" />
            <span>Light</span>
          </button>
          <button class="theme-dropdown-item" data-theme-option="dark" role="menuitem">
            <Moon className="h-4 w-4" />
            <span>Dark</span>
          </button>
          <button class="theme-dropdown-item" data-theme-option="system" role="menuitem">
            <Monitor className="h-4 w-4" />
            <span>System</span>
          </button>
        </div>
      </div>
      {showMenu && (
        <button
          class:list={['header-action-btn', 'menu-trigger', { 'topbar-action': brandHome }]}
          type="button"
          data-menu-trigger
          aria-label="Open menu"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="site-menu-sheet"
        >
          <span class="menu-trigger-icons" aria-hidden="true">
            <Menu className="menu-swap-icon menu-swap-icon--open" />
            <X className="menu-swap-icon menu-swap-icon--close" />
          </span>
        </button>
      )}
    </div>
    <slot name="topbar" />
    <div class="site-shell">
      <slot />
    </div>

    <CommandPalette />

    <script>
      (() => {
        const overlay = document.querySelector('[data-spotlight-overlay]') as HTMLElement | null;
        if (!overlay) return;
        const overlayStyle = overlay.style;

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const prefersFinePointer = window.matchMedia('(pointer: fine)');

        const setInactive = () => {
          overlay.classList.remove('is-active');
          overlayStyle.setProperty('--spotlight-soft-opacity', '0');
          overlayStyle.setProperty('--spotlight-core-opacity', '0');
        };

        const setActive = () => {
          overlay.classList.add('is-active');
        };

        const canRun = () => !prefersReducedMotion.matches && prefersFinePointer.matches;
        if (!canRun()) {
          setInactive();
          return;
        }

        let targetX = window.innerWidth * 0.5;
        let targetY = window.innerHeight * 0.3;
        let currentX = targetX;
        let currentY = targetY;
        let currentOpacity = 0;
        let targetOpacity = 0;
        let velocityX = 0;
        let velocityY = 0;
        // Smoothed tail — separate spring for the soft-layer offset
        let tailX = 0;
        let tailY = 0;
        let lastX = targetX;
        let lastY = targetY;
        let hasPointer = false;
        let frameId = 0;
        let lastFrameTime = performance.now();
        let lastPointerMoveTime = performance.now();
        const positionSmoothingMs = 38;
        const opacitySmoothingMs = 90;
        const velocityDecayMs = 72;
        const tailSmoothingMs = 110;  // tail lags behind velocity for a gentle comet feel
        const idleFadeDurationMs = 800;

        overlayStyle.setProperty('--spotlight-x', `${currentX}px`);
        overlayStyle.setProperty('--spotlight-y', `${currentY}px`);

        const tick = (timestamp: number) => {
          frameId = 0;
          const deltaMs = Math.min(32, timestamp - lastFrameTime || 16.67);
          lastFrameTime = timestamp;

          // Idle fade: ease-out³ curve so the glow "sinks in" rather than vanishing linearly
          const idleElapsedMs = hasPointer ? Math.max(0, timestamp - lastPointerMoveTime) : idleFadeDurationMs;
          const idleT = Math.min(1, idleElapsedMs / idleFadeDurationMs);
          const idleVisibility = 1 - (idleT * idleT * (3 - 2 * idleT)); // smoothstep
          targetOpacity = idleVisibility;

          const positionBlend = 1 - Math.exp(-deltaMs / positionSmoothingMs);
          const opacityBlend  = 1 - Math.exp(-deltaMs / opacitySmoothingMs);
          const velocityDecay = Math.exp(-deltaMs / velocityDecayMs);
          const tailBlend     = 1 - Math.exp(-deltaMs / tailSmoothingMs);

          currentX += (targetX - currentX) * positionBlend;
          currentY += (targetY - currentY) * positionBlend;
          currentOpacity += (targetOpacity - currentOpacity) * opacityBlend;
          velocityX *= velocityDecay;
          velocityY *= velocityDecay;

          // Tail spring: lerp toward current velocity — smooths out micro-jitter
          tailX += (velocityX - tailX) * tailBlend;
          tailY += (velocityY - tailY) * tailBlend;

          // speed: normalise, then apply sqrt so slow movement still reads as motion
          const rawSpeed = Math.hypot(tailX, tailY);
          const speed = Math.min(1, Math.sqrt(rawSpeed / 20));

          overlayStyle.setProperty('--spotlight-x', `${currentX}px`);
          overlayStyle.setProperty('--spotlight-y', `${currentY}px`);
          overlayStyle.setProperty('--spotlight-tail-x', `${tailX * 1.4}px`);
          overlayStyle.setProperty('--spotlight-tail-y', `${tailY * 1.4}px`);
          overlayStyle.setProperty('--spotlight-soft-radius', `${170 + speed * 30}px`);
          overlayStyle.setProperty('--spotlight-core-radius', `${88 + speed * 14}px`);
          overlayStyle.setProperty('--spotlight-soft-opacity', `${(currentOpacity * 0.26).toFixed(3)}`);
          overlayStyle.setProperty('--spotlight-core-opacity', `${(currentOpacity * 0.98).toFixed(3)}`);

          if (
            Math.abs(targetX - currentX) > 0.15 ||
            Math.abs(targetY - currentY) > 0.15 ||
            Math.abs(targetOpacity - currentOpacity) > 0.008 ||
            targetOpacity > 0
          ) {
            frameId = window.requestAnimationFrame(tick);
          } else {
            setInactive();
          }
        };

        const queueTick = () => {
          setActive();
          if (!frameId) {
            lastFrameTime = performance.now();
            frameId = window.requestAnimationFrame(tick);
          }
        };

        const handlePointerMove = (event: PointerEvent) => {
          if (event.pointerType && event.pointerType !== 'mouse') return;
          targetX = event.clientX;
          targetY = event.clientY;
          lastPointerMoveTime = performance.now();
          if (hasPointer) {
            velocityX = event.clientX - lastX;
            velocityY = event.clientY - lastY;
          }
          lastX = event.clientX;
          lastY = event.clientY;
          hasPointer = true;
          queueTick();
        };

        const handlePointerLeaveWindow = (event: MouseEvent) => {
          if (event.relatedTarget) return;
          hasPointer = false;
          targetOpacity = 0;
          queueTick();
        };

        const handleBlur = () => {
          hasPointer = false;
          targetOpacity = 0;
          queueTick();
        };

        window.addEventListener('pointermove', handlePointerMove, { passive: true });
        window.addEventListener('mouseout', handlePointerLeaveWindow, { passive: true });
        window.addEventListener('blur', handleBlur);
      })();
    </script>

    <script>
      import { feedback } from '@/lib/feedback';

      (() => {
        const storageKey = 'theme';
        const toggle = document.querySelector('[data-theme-toggle]');
        const dropdown = document.querySelector('[data-theme-dropdown]');
        const menu = document.querySelector('[data-theme-menu]');
        const options = document.querySelectorAll('[data-theme-option]');
        const media =
          typeof window.matchMedia === 'function'
            ? window.matchMedia('(prefers-color-scheme: dark)')
            : null;
        const canHover =
          typeof window.matchMedia === 'function'
            ? window.matchMedia('(hover: hover) and (pointer: fine)')
            : null;
        const compactViewport =
          typeof window.matchMedia === 'function'
            ? window.matchMedia('(max-width: 899px)')
            : null;

        const getStoredTheme = () => {
          try {
            return localStorage.getItem(storageKey);
          } catch (error) {
            return null;
          }
        };
        const setStoredTheme = (theme: string) => {
          try {
            if (theme === 'system') {
              localStorage.removeItem(storageKey);
            } else {
              localStorage.setItem(storageKey, theme);
            }
          } catch (error) {
            // Ignore storage errors
          }
        };
        const getSystemTheme = () => (media && media.matches ? 'dark' : 'light');

        const getThemeSetting = () => {
          const stored = getStoredTheme();
          if (stored === 'light' || stored === 'dark') return stored;
          return 'system';
        };

        const updateIcons = (setting: string) => {
          document.documentElement.dataset.themeSetting = setting;
          options.forEach(opt => {
            const el = opt as HTMLElement;
            el.classList.toggle('is-active', el.dataset.themeOption === setting);
          });
          const label = document.querySelector('[data-theme-label]');
          if (label) {
            const labels: Record<string, string> = { light: 'Light', dark: 'Dark', system: 'System' };
            label.textContent = labels[setting] || 'System';
          }
        };

        const updateToggle = (setting: string) => {
          if (!toggle) return;
          const labels: Record<string, string> = { light: 'Light mode', dark: 'Dark mode', system: 'System mode' };
          toggle.setAttribute('aria-label', labels[setting] || 'Switch theme');
        };

        const applyTheme = (setting: string) => {
          const effectiveTheme = setting === 'system' ? getSystemTheme() : setting;
          const isDark = effectiveTheme === 'dark';
          document.documentElement.classList.toggle('dark', isDark);
          updateIcons(setting);
          updateToggle(setting);
        };

        let activeThemeTransition: { finished: Promise<void>; skipTransition?: () => void } | null = null;
        let fallbackThemeCleanup: (() => void) | null = null;

        const runFallbackThemeTransition = (update: () => void) => {
          const root = document.documentElement;
          fallbackThemeCleanup?.();

          const fromTheme = root.classList.contains('dark')
            ? 'theme-wipe-from-dark'
            : 'theme-wipe-from-light';
          root.classList.add('theme-wipe-webkit', fromTheme, 'no-transition');
          update();

          let timeout = 0;
          const cleanup = () => {
            if (fallbackThemeCleanup !== cleanup) return;
            fallbackThemeCleanup = null;
            window.clearTimeout(timeout);
            root.removeEventListener('animationend', onAnimationEnd);
            root.classList.remove(
              'theme-wipe-webkit',
              'theme-wipe-from-dark',
              'theme-wipe-from-light',
              'no-transition',
            );
          };
          const onAnimationEnd = (event: AnimationEvent) => {
            if (event.animationName === 'theme-polygon-overlay') cleanup();
          };

          fallbackThemeCleanup = cleanup;
          root.addEventListener('animationend', onAnimationEnd);
          timeout = window.setTimeout(cleanup, 1700);
        };

        // Theme changes use one root snapshot and freeze descendant transitions
        // so the polygon mask is the only animated surface during the reveal.
        const transitionTheme = (theme: string) => {
          const doc = document as Document & {
            startViewTransition?: (cb: () => void) => {
              finished: Promise<void>;
              skipTransition?: () => void;
            };
          };
          const root = document.documentElement;
          const nextDark = (theme === 'system' ? getSystemTheme() : theme) === 'dark';
          const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          const update = () => {
            applyTheme(theme);
            closeDropdown();
          };

          if (root.classList.contains('dark') === nextDark || reduced) {
            update();
            return;
          }

          if (typeof doc.startViewTransition !== 'function') {
            runFallbackThemeTransition(update);
            return;
          }

          activeThemeTransition?.skipTransition?.();
          root.classList.add('theme-wipe', 'no-transition');
          try {
            const transition = doc.startViewTransition(update);
            activeThemeTransition = transition;
            transition.finished.finally(() => {
              if (activeThemeTransition !== transition) return;
              activeThemeTransition = null;
              root.classList.remove('theme-wipe', 'no-transition');
            });
          } catch {
            activeThemeTransition = null;
            root.classList.remove('theme-wipe', 'no-transition');
            update();
          }
        };

        const openDropdown = () => {
          if (!dropdown || !menu || !toggle) return;
          dropdown.classList.add('is-open');
          toggle.setAttribute('aria-expanded', 'true');
        };

        const closeDropdown = () => {
          if (!dropdown || !menu || !toggle) return;
          dropdown.classList.remove('is-open');
          toggle.setAttribute('aria-expanded', 'false');
        };

        const currentSetting = getThemeSetting();
        updateIcons(currentSetting);
        updateToggle(currentSetting);

        if (dropdown && canHover?.matches && !compactViewport?.matches) {
          dropdown.addEventListener('mouseenter', openDropdown);
          dropdown.addEventListener('mouseleave', closeDropdown);
        }

        if (toggle) {
          toggle.addEventListener('click', (e) => {
            e.stopPropagation();
            if (dropdown?.classList.contains('is-open')) {
              closeDropdown();
            } else {
              openDropdown();
            }
          });
        }

        options.forEach(option => {
          option.addEventListener('click', () => {
            const el = option as HTMLElement;
            const theme = el.dataset.themeOption;
            if (theme) {
              feedback.theme();
              setStoredTheme(theme);
              transitionTheme(theme);
            }
          });
        });

        document.addEventListener('click', (e) => {
          if (dropdown && !dropdown.contains(e.target as Node)) {
            closeDropdown();
          }
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            closeDropdown();
          }
        });

        const onSystemThemeChange = () => {
          if (getThemeSetting() === 'system') {
            applyTheme('system');
          }
        };

        if (media) {
          if (typeof media.addEventListener === 'function') {
            media.addEventListener('change', onSystemThemeChange);
          }
        }
      })();
    </script>

    <!-- Site menu dropdown: open/close -->
    <script>
      import { feedback } from '@/lib/feedback';

      (() => {
        const trigger = document.querySelector('[data-menu-trigger]') as HTMLElement | null;
        const menu = document.querySelector('[data-site-menu]') as HTMLElement | null;
        if (!trigger || !menu) return;
        const closers = menu.querySelectorAll('[data-menu-close]');
        const menuLinks = Array.from(menu.querySelectorAll<HTMLAnchorElement>('[data-menu-link]'));
        const firstLink = menuLinks[0];
        const lastLink = menuLinks[menuLinks.length - 1];
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const backgroundElements = [
          ...document.querySelectorAll<HTMLElement>(
            'body > :not(script):not([data-site-menu]):not([data-header-actions])'
          ),
          ...document.querySelectorAll<HTMLElement>(
            '[data-header-actions] > :not([data-menu-trigger])'
          ),
        ];
        const initialInertState = new Map(
          backgroundElements.map((element) => [element, element.inert])
        );

        const setBackgroundInert = (inert: boolean) => {
          backgroundElements.forEach((element) => {
            element.inert = inert || initialInertState.get(element) === true;
          });
        };

        // Mark the link that points at the current page (Home matches only "/").
        const path = window.location.pathname.replace(/\/+$/, '') || '/';
        menu.querySelectorAll<HTMLAnchorElement>('[data-menu-link]').forEach((link) => {
          const href = (link.getAttribute('href') || '').replace(/\/+$/, '') || '/';
          const active = href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
          if (active) link.setAttribute('aria-current', 'page');
        });

        let isOpen = false;
        let scrollLockY = 0;
        let closeTimer = 0;

        const lockScroll = () => {
          scrollLockY = window.scrollY;
          document.body.style.top = `-${scrollLockY}px`;
          document.body.classList.add('menu-scroll-lock');
        };
        const unlockScroll = () => {
          document.body.classList.remove('menu-scroll-lock');
          document.body.style.top = '';
          window.scrollTo(0, scrollLockY);
        };

        const open = () => {
          if (isOpen) return;
          isOpen = true;
          feedback.open();
          window.clearTimeout(closeTimer);
          menu.hidden = false;
          void menu.offsetWidth; // reflow so the transition starts from the closed state
          menu.classList.add('is-open');
          trigger.setAttribute('aria-expanded', 'true');
          trigger.classList.add('is-active');
          lockScroll();
          setBackgroundInert(true);
          firstLink?.focus();
          // Wake the peek: a short curious beat, then back to its idle loop.
          window.dispatchEvent(
            new CustomEvent('peek:menu:set', { detail: { animation: 'curious', holdMs: 1600 } })
          );
        };

        const close = () => {
          if (!isOpen) return;
          isOpen = false;
          feedback.close();
          menu.classList.remove('is-open');
          trigger.setAttribute('aria-expanded', 'false');
          trigger.classList.remove('is-active');
          unlockScroll();
          setBackgroundInert(false);
          trigger.focus();
          if (reducedMotion) {
            menu.hidden = true;
          } else {
            closeTimer = window.setTimeout(() => { menu.hidden = true; }, 280);
          }
        };

        trigger.addEventListener('click', () => (isOpen ? close() : open()));
        closers.forEach((el) => el.addEventListener('click', close));
        menu.querySelectorAll('[data-menu-link]').forEach((link) => {
          link.addEventListener('click', close);
        });
        document.addEventListener('keydown', (e) => {
          if (!isOpen) return;
          if (e.key === 'Escape') {
            e.preventDefault();
            close();
            return;
          }
          if (e.key !== 'Tab' || !firstLink || !lastLink) return;
          if (e.shiftKey && document.activeElement === firstLink) {
            e.preventDefault();
            lastLink.focus();
          } else if (!e.shiftKey && document.activeElement === lastLink) {
            e.preventDefault();
            firstLink.focus();
          }
        });
      })();
    </script>

    <!-- GSAP Header Button Animations -->
    <script>
      (() => {
        let gsapPromise: Promise<typeof import('gsap')['default']> | null = null;
        const loadGsap = () => {
          gsapPromise ??= import('gsap').then(({ default: gsap }) => gsap);
          return gsapPromise;
        };

        const initHeaderAnimations = () => {
          const headerActions = document.querySelector('[data-header-actions]');
          if (!headerActions) return;

          // Get all header action buttons (excluding theme dropdown trigger)
          const buttons = headerActions.querySelectorAll<HTMLElement>('.header-action-btn:not([data-theme-toggle]):not(.menu-trigger)');

          // Store original widths
          const buttonData = new Map<
            HTMLElement,
            {
              label: HTMLElement;
              collapsedWidth: number;
              expandedWidth: number;
              labelWidth: number;
            }
          >();

          const measureButton = (btn: HTMLElement) => {
            const label = btn.querySelector<HTMLElement>('.header-action-btn-label');
            if (!label) return null;

            // Get collapsed width (icon only)
            const collapsedWidth = 32; // Fixed icon-only width

            // Temporarily show label to measure
            const origMaxWidth = label.style.maxWidth;
            const origOpacity = label.style.opacity;
            label.style.maxWidth = 'none';
            label.style.opacity = '1';

            // Measure the label's natural width
            const labelWidth = label.scrollWidth;

            // Restore
            label.style.maxWidth = origMaxWidth || '0';
            label.style.opacity = origOpacity || '0';

            // Calculate expanded width: icon + gap + label + padding
            const expandedWidth = collapsedWidth + labelWidth + 14; // 6px gap + 8px extra padding

            return {
              label,
              collapsedWidth,
              expandedWidth,
              labelWidth
            };
          };

          buttons.forEach((btn) => {
            const data = measureButton(btn);
            if (data) {
              buttonData.set(btn, data);
            }
          });

          // Animation function for hover in
          const animateIn = async (btn: HTMLElement) => {
            const data = buttonData.get(btn);
            if (!data) return;
            const gsap = await loadGsap();

            btn.classList.add('is-hovered');

            // Kill any existing animations
            gsap.killTweensOf([btn, data.label]);

            // Animate button width and label
            gsap.to(btn, {
              width: data.expandedWidth,
              paddingLeft: 10,
              paddingRight: 10,
              duration: 0.3,
              ease: 'power2.out'
            });

            gsap.to(data.label, {
              maxWidth: data.labelWidth + 10,
              opacity: 1,
              duration: 0.25,
              delay: 0.08,
              ease: 'power2.out'
            });
          };

          // Animation function for hover out
          const animateOut = async (btn: HTMLElement) => {
            const data = buttonData.get(btn);
            if (!data) return;
            const gsap = await loadGsap();

            btn.classList.remove('is-hovered');

            // Kill any existing animations
            gsap.killTweensOf([btn, data.label]);

            // Animate label first, then button width
            gsap.to(data.label, {
              maxWidth: 0,
              opacity: 0,
              duration: 0.15,
              ease: 'power2.in'
            });

            gsap.to(btn, {
              width: data.collapsedWidth,
              paddingLeft: 0,
              paddingRight: 0,
              duration: 0.25,
              delay: 0.05,
              ease: 'power2.inOut'
            });
          };

          // Attach event listeners
          buttons.forEach(btn => {
            btn.addEventListener('mouseenter', () => animateIn(btn));
            btn.addEventListener('mouseleave', () => animateOut(btn));

            // Focus states for accessibility
            btn.addEventListener('focus', () => animateIn(btn));
            btn.addEventListener('blur', () => animateOut(btn));
          });

          // Make animation functions globally available for dynamically added buttons
          window.headerBtnAnimations = {
            register: (btn) => {
              if (buttonData.has(btn)) return;

              // Small delay to ensure DOM is ready
              requestAnimationFrame(() => {
                const data = measureButton(btn);
                if (!data) return;

                buttonData.set(btn, data);

                btn.addEventListener('mouseenter', () => animateIn(btn));
                btn.addEventListener('mouseleave', () => animateOut(btn));
                btn.addEventListener('focus', () => animateIn(btn));
                btn.addEventListener('blur', () => animateOut(btn));
              });
            }
          };
        };

        // Start initialization after DOM is ready
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initHeaderAnimations);
        } else {
          initHeaderAnimations();
        }
      })();
    </script>

    <!-- Site Navigation: typewriter collapse + magnetic hover + active indicator -->
    <script>
      (() => {
        const nav = document.querySelector('[data-site-nav]') as HTMLElement | null;
        const links = document.querySelectorAll('[data-nav-link]');
        if (!links.length || !nav) return;

        const separators = nav.querySelectorAll('.nav-separator');
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const isHomeNav = nav.classList.contains('site-nav--home');
        const desktopNavQuery = window.matchMedia('(min-width: 900px)');

        // ─── 3a. Character wrapping with index injection ─────────────
        interface LinkData {
          el: HTMLElement;
          text: string;
          chars: HTMLSpanElement[];
          indexSpan: HTMLSpanElement | null;
        }
        const linkDataList: LinkData[] = [];

        links.forEach(link => {
          const el = link as HTMLElement;
          const text = el.textContent || '';
          const chars: HTMLSpanElement[] = [];
          const navIndex = el.dataset.navIndex;

          el.style.setProperty('--nav-link-char-count', String(text.length));

          el.textContent = '';

          // Inject section index span
          let indexSpan: HTMLSpanElement | null = null;
          if (navIndex) {
            indexSpan = document.createElement('span');
            indexSpan.className = 'nav-index';
            indexSpan.textContent = navIndex;
            indexSpan.style.opacity = '0';
            el.appendChild(indexSpan);
          }

          for (const ch of text) {
            const span = document.createElement('span');
            span.className = 'nav-char';
            span.textContent = ch;
            el.appendChild(span);
            chars.push(span);
          }

          linkDataList.push({ el, text, chars, indexSpan });
        });

        // ─── 3b. Smooth scroll + active section tracking ──────────────
        links.forEach(link => {
          link.addEventListener('click', (e) => {
            const href = (link as HTMLAnchorElement).getAttribute('href');
            if (!href || !href.startsWith('#')) return; // real page links navigate normally
            const target = document.querySelector(href);
            if (!target) return;
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
        });

        const sections = ['experience', 'projects', 'writing', 'moods'].map(id => ({
          id,
          el: document.getElementById(`${id}-section`)
        })).filter(s => s.el);

        let isVertical = isHomeNav && desktopNavQuery.matches;
        let activeId = '';
        let ticking = false;
        let scrollCueTimer = 0;
        let lastScrollY = window.scrollY;

        // Its own handle rather than the collapse block's statusEl: that one is
        // declared further down and onScroll() runs before that line.
        const heroStatusEl = document.querySelector('[data-hero-status]');

        // On desktop the nav is vertical from load; only its visibility is
        // scroll-driven. Reveal it as soon as the hero's status line clears the
        // top of the viewport — the moment the reader has committed to scrolling
        // past the hero. The previous rule waited for the first section to reach
        // 76vh, which on a tall hero was ~650px further down.
        const syncHomeNavPresence = () => {
          if (!isHomeNav || !desktopNavQuery.matches || !heroStatusEl) {
            nav.classList.remove('is-content-nav-visible');
            return;
          }
          nav.classList.toggle(
            'is-content-nav-visible',
            heroStatusEl.getBoundingClientRect().bottom <= 0
          );
        };

        const cuePeekLock = () => {
          if (!isHomeNav || !desktopNavQuery.matches) return;
          nav.classList.remove('is-peek-locking');
          void nav.offsetWidth;
          nav.classList.add('is-peek-locking');
        };

        const cuePeekScroll = () => {
          if (!isHomeNav || !desktopNavQuery.matches) return;
          const currentScrollY = window.scrollY;
          const direction = currentScrollY > lastScrollY ? 'down' : 'up';
          lastScrollY = currentScrollY;
          nav.dataset.scrollDir = direction;
          nav.classList.add('is-peek-scanning');
          window.clearTimeout(scrollCueTimer);
          scrollCueTimer = window.setTimeout(() => {
            nav.classList.remove('is-peek-scanning');
          }, 140);
        };

        const syncActiveSection = () => {
          const viewportH = window.innerHeight;
          let newActiveId = '';
          for (const section of sections) {
            if (!section.el) continue;
            const rect = section.el.getBoundingClientRect();
            if (rect.top <= viewportH * 0.4 && rect.bottom > viewportH * 0.2) {
              newActiveId = section.id;
            }
          }

          if (newActiveId === activeId) return;

          activeId = newActiveId;
          links.forEach(link => {
            const el = link as HTMLElement;
            el.classList.toggle('is-active', el.dataset.navLink === activeId);
          });
          if (isVertical) {
            cuePeekLock();
          }
        };

        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            syncHomeNavPresence();
            cuePeekScroll();
            syncActiveSection();
            ticking = false;
          });
        };

        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();

        // ─── Vertical collapse: observer + transition logic ───────────
        const statusEl = document.querySelector('[data-hero-status]');
        if (!statusEl) return;

        let animating = false;
        let pendingDirection: 'vertical' | 'horizontal' | null = null;

        const flushPending = () => {
          if (!pendingDirection) return;
          const dir = pendingDirection;
          pendingDirection = null;
          if (dir === 'vertical') toVertical();
          else toHorizontal();
        };

        // ─── 3c. toVertical — dissolve + layout + typewriter ──────────
        const toVertical = async () => {
          if (isVertical) return;
          if (animating) { pendingDirection = 'vertical'; return; }
          isVertical = true;
          animating = true;

          // Reduced motion — instant toggle
          if (reducedMotion) {
            nav.classList.add('is-vertical');
            separators.forEach(s => (s as HTMLElement).style.opacity = '0');
            linkDataList.forEach(ld => {
              ld.chars.forEach(c => { c.style.opacity = '1'; });
              if (ld.indexSpan) ld.indexSpan.style.opacity = '1';
            });
            animating = false;
            flushPending();
            return;
          }

          const { default: gsap } = await import('gsap');

          // Collect all chars in order for the dissolve
          const allChars = linkDataList.flatMap(ld => ld.chars);

          // Phase 1: Dissolve out (staggered left→right) with random scatter
          allChars.forEach(c => {
            c.dataset.scatterX = `${(Math.random() - 0.5) * 8}`;
          });
          await gsap.to(allChars, {
            opacity: 0,
            y: -3,
            x: (_i: number, el: HTMLElement) => parseFloat(el.dataset.scatterX || '0'),
            duration: 0.18,
            stagger: 0.012,
            ease: 'power2.in'
          });

          // Also fade separators
          gsap.set(Array.from(separators), { opacity: 0 });

          // Phase 2: Layout switch
          nav.classList.add('is-vertical');
          syncActiveSection();
          // Phase 3: Quick typewriter per link
          for (let i = 0; i < linkDataList.length; i++) {
            const { chars, indexSpan } = linkDataList[i];
            // Reset positions before reveal
            gsap.set(chars, { y: 0, x: 0 });

            // Fade in index span
            if (indexSpan) {
              gsap.to(indexSpan, { opacity: 1, duration: 0.15, ease: 'power2.out' });
            }

            for (let j = 0; j < chars.length; j++) {
              // Remove cursor from previous char
              if (j > 0) chars[j - 1].classList.remove('is-cursor');
              chars[j].classList.add('is-cursor');

              await gsap.to(chars[j], {
                opacity: 1,
                duration: 0.02,
                delay: 0.035
              });
            }
            // Remove cursor from last char
            chars[chars.length - 1].classList.remove('is-cursor');
          }

          animating = false;
          flushPending();
        };

        // ─── 3d. toHorizontal — scatter dissolve + layout + snappy cascade
        const toHorizontal = async () => {
          if (!isVertical) return;
          if (animating) { pendingDirection = 'horizontal'; return; }
          isVertical = false;
          animating = true;

          if (reducedMotion) {
            nav.classList.remove('is-vertical');
            separators.forEach(s => (s as HTMLElement).style.opacity = '1');
            linkDataList.forEach(ld => {
              ld.chars.forEach(c => { c.style.opacity = '1'; });
              if (ld.indexSpan) ld.indexSpan.style.opacity = '0';
            });
            animating = false;
            flushPending();
            return;
          }

          const { default: gsap } = await import('gsap');

          // Hide index spans
          linkDataList.forEach(ld => {
            if (ld.indexSpan) gsap.to(ld.indexSpan, { opacity: 0, duration: 0.1 });
          });

          // Phase 1: Scatter dissolve per-link, bottom to top
          for (let i = linkDataList.length - 1; i >= 0; i--) {
            const { chars } = linkDataList[i];
            // Each char gets a random x offset for scatter
            chars.forEach(c => {
              c.dataset.scatterX = `${(Math.random() - 0.5) * 8}`;
            });
            await gsap.to(chars, {
              opacity: 0,
              y: -3,
              x: (_i: number, el: HTMLElement) => parseFloat(el.dataset.scatterX || '0'),
              duration: 0.15,
              stagger: 0.025,
              ease: 'power2.in'
            });
          }

          // Phase 2: Layout switch
          nav.classList.remove('is-vertical');

          // Phase 3: Snappy cascade reveal all chars + separators
          const allChars = linkDataList.flatMap(ld => ld.chars);
          gsap.set(allChars, { y: 0, x: 0 });

          gsap.to(allChars, {
            opacity: 1,
            duration: 0.2,
            stagger: 0.015,
            ease: 'back.out(1.7)'
          });

          gsap.to(Array.from(separators), {
            opacity: 1,
            duration: 0.25,
            delay: 0.1,
            ease: 'power2.out',
            onComplete: () => {
              animating = false;
              flushPending();
            }
          });
        };

        // ─── 3e. Active indicator ─────────────────────────────────────
        // ─── 3f. Magnetic hover (desktop, vertical mode only) ─────────
        // Disabled — no hover box or physics effects
        const initMagneticHover = async () => {
          // Per-link char wave on hover (kept as subtle interaction)
          const { default: gsap } = await import('gsap');

          linkDataList.forEach(({ el, chars }) => {
            el.addEventListener('pointerenter', (e: PointerEvent) => {
              if (e.pointerType !== 'mouse' || !isVertical) return;
              chars.forEach((c, i) => {
                gsap.to(c, {
                  y: -1.5,
                  duration: 0.25,
                  delay: i * 0.015,
                  ease: 'power2.out'
                });
              });
            });

            el.addEventListener('pointerleave', (e: PointerEvent) => {
              if (e.pointerType !== 'mouse') return;
              chars.forEach(c => {
                gsap.to(c, {
                  y: 0,
                  duration: 0.6,
                  ease: 'elastic.out(1, 0.4)'
                });
              });
            });
          });
        };

        initMagneticHover();

        if (isHomeNav) {
          const brand = nav.querySelector('[data-site-brand]') as HTMLElement | null;
          const navPeekConfig = {
            linkHover: nav.dataset.peekLinkHover ?? 'curious',
            sectionActive: nav.dataset.peekSectionActive ?? 'happy',
            sectionActiveHoldMs: Number(nav.dataset.peekSectionActiveHoldMs ?? '600'),
            fastScroll: nav.dataset.peekFastScroll ?? 'dart',
            fastScrollHoldMs: Number(nav.dataset.peekFastScrollHoldMs ?? '1000'),
            idleTimeout: nav.dataset.peekIdleTimeout ?? 'sleepy',
          };

          const syncBrandEaten = () => {
            // Mobile nav links now live in the menu sheet, so the wordmark no
            // longer needs to be eaten to make room for an inline link row.
            nav.classList.remove('is-brand-eaten');
          };

          // Spring physics for peek — pointer-follow + idle bob.
          // Gives it weight and overshoot instead of instant linear tracking.
          const peekSpring = {
            x: 0, y: 0, vx: 0, vy: 0, tx: 0, ty: 0,
            bobY: 0, bobVY: 0, bobTargetY: 0, bobPhase: 0,
            isHovered: false, rafId: 0, lastTime: 0,
          };
          // PS/PD = pointer spring stiffness/damping. BS/BD = bob spring. BA = bob amplitude px.
          const PS = 220, PD = 14, BS = 28, BD = 5.2, BA = 2.2;

          const tickPeekSpring = (now: number) => {
            const dt = Math.min((now - peekSpring.lastTime) / 1000, 0.05);
            peekSpring.rafId = 0;
            peekSpring.vx += (PS * (peekSpring.tx - peekSpring.x) - PD * peekSpring.vx) * dt;
            peekSpring.vy += (PS * (peekSpring.ty - peekSpring.y) - PD * peekSpring.vy) * dt;
            peekSpring.x += peekSpring.vx * dt;
            peekSpring.y += peekSpring.vy * dt;

            // Idle bob: sinusoidal target (~one cycle per 8.7s), spring-smoothed
            if (!peekSpring.isHovered) {
              peekSpring.bobPhase += dt * 0.72;
              peekSpring.bobTargetY = Math.sin(peekSpring.bobPhase) * BA;
            } else {
              peekSpring.bobTargetY = 0;
            }
            peekSpring.bobVY += (BS * (peekSpring.bobTargetY - peekSpring.bobY) - BD * peekSpring.bobVY) * dt;
            peekSpring.bobY += peekSpring.bobVY * dt;

            nav.style.setProperty('--peek-shift-x', `${peekSpring.x.toFixed(3)}px`);
            nav.style.setProperty('--peek-shift-y', `${(peekSpring.y + peekSpring.bobY).toFixed(3)}px`);

            const stillMoving =
              Math.abs(peekSpring.tx - peekSpring.x) > 0.01 || Math.abs(peekSpring.vx) > 0.01 ||
              Math.abs(peekSpring.ty - peekSpring.y) > 0.01 || Math.abs(peekSpring.vy) > 0.01 ||
              Math.abs(peekSpring.bobTargetY - peekSpring.bobY) > 0.01 || Math.abs(peekSpring.bobVY) > 0.01 ||
              !peekSpring.isHovered;

            if (stillMoving) {
              peekSpring.lastTime = now;
              peekSpring.rafId = requestAnimationFrame(tickPeekSpring);
            }
          };

          const startPeekSpring = () => {
            if (peekSpring.rafId) return;
            peekSpring.lastTime = performance.now();
            peekSpring.rafId = requestAnimationFrame(tickPeekSpring);
          };

          const handlePointerMove = (event: PointerEvent) => {
            if (!desktopNavQuery.matches || event.pointerType !== 'mouse') return;
            if (!brand || !brand.matches(':hover')) return;
            const rect = brand.getBoundingClientRect();
            peekSpring.tx = ((event.clientX - rect.left) / rect.width - 0.5) * 10;
            peekSpring.ty = ((event.clientY - rect.top) / rect.height - 0.5) * 7;
            startPeekSpring();
          };

          const resetPeekShift = () => {
            peekSpring.tx = 0;
            peekSpring.ty = 0;
            peekSpring.isHovered = false;
            startPeekSpring();
          };

          const handleBrandClick = (event: MouseEvent) => {
            event.preventDefault();
            window.scrollTo({ top: 0, behavior: reducedMotion ? 'auto' : 'smooth' });
            nav.classList.remove('is-brand-eaten');
          };

          const syncHomeNavMode = () => {
            isVertical = desktopNavQuery.matches;
            nav.classList.toggle('is-vertical', isVertical);
            // Viewport changes do not fire a scroll event, so the reveal has to
            // be re-read here as well as in onScroll.
            syncHomeNavPresence();
            separators.forEach(s => ((s as HTMLElement).style.opacity = isVertical ? '0' : '1'));
            linkDataList.forEach(ld => {
              if (ld.indexSpan) ld.indexSpan.style.opacity = isVertical ? '1' : '0';
              ld.chars.forEach(c => {
                c.style.opacity = '1';
                c.style.transform = '';
              });
            });
            if (isVertical) {
              nav.classList.remove('is-brand-eaten');
              // Start idle bob when entering desktop vertical mode
              peekSpring.isHovered = false;
              startPeekSpring();
            } else {
              syncBrandEaten();
            }
          };

          brand?.addEventListener('pointermove', handlePointerMove);
          brand?.addEventListener('pointerenter', () => {
            if (!desktopNavQuery.matches) return;
            peekSpring.isHovered = true;
            startPeekSpring();
          });
          brand?.addEventListener('pointerleave', resetPeekShift);
          brand?.addEventListener('click', handleBrandClick);
          brand?.addEventListener('pointerdown', () => {
            if (desktopNavQuery.matches) return;
            nav.classList.remove('is-peek-tapping');
            void nav.offsetWidth;
            nav.classList.add('is-peek-tapping');
          });
          window.addEventListener('scroll', syncBrandEaten, { passive: true });
          syncHomeNavMode();
          desktopNavQuery.addEventListener?.('change', syncHomeNavMode);

          // ─── Peek expression triggers ─────────────────────────────────
          // Dispatches CustomEvents consumed by AnimatedLogo (channel "nav").
          const dispatchPeek = (
            kind: 'set' | 'revert',
            detail?: { animation: string; holdMs?: number },
          ): void => {
            window.dispatchEvent(
              new CustomEvent(`peek:nav:${kind}`, detail ? { detail } : undefined),
            );
          };

          // Hover any nav link → curious, revert on leave.
          nav.querySelectorAll<HTMLElement>('.nav-link').forEach((link) => {
            link.addEventListener('pointerenter', () => {
              if (!desktopNavQuery.matches) return;
              dispatchPeek('set', { animation: navPeekConfig.linkHover });
            });
            link.addEventListener('pointerleave', () => {
              if (!desktopNavQuery.matches) return;
              dispatchPeek('revert');
            });
          });

          // Active section change → happy burst (0.6s).
          let lastActiveSection: string | null = null;
          const watchActiveSection = (): void => {
            const active = nav.querySelector<HTMLElement>('.nav-link.is-active');
            const key = active?.getAttribute('data-section-id') ?? active?.getAttribute('href') ?? null;
            if (key && key !== lastActiveSection) {
              if (lastActiveSection !== null) {
                dispatchPeek('set', {
                  animation: navPeekConfig.sectionActive,
                  holdMs: navPeekConfig.sectionActiveHoldMs,
                });
              }
              lastActiveSection = key;
            }
          };
          const activeObserver = new MutationObserver(watchActiveSection);
          activeObserver.observe(nav, {
            attributes: true,
            subtree: true,
            attributeFilter: ['class'],
          });
          watchActiveSection();

          // Fast scroll → dart (1s).
          let lastScrollY = window.scrollY;
          let lastScrollT = performance.now();
          let dartUntil = 0;
          window.addEventListener(
            'scroll',
            () => {
              const now = performance.now();
              const dt = now - lastScrollT;
              if (dt < 16) return;
              const dy = Math.abs(window.scrollY - lastScrollY);
              const v = dy / dt; // px per ms
              lastScrollY = window.scrollY;
              lastScrollT = now;
              if (v > 0.5 && now > dartUntil) {
                dartUntil = now + navPeekConfig.fastScrollHoldMs;
                dispatchPeek('set', {
                  animation: navPeekConfig.fastScroll,
                  holdMs: navPeekConfig.fastScrollHoldMs,
                });
              }
            },
            { passive: true },
          );

          // Idle > 10s (no pointer / scroll / key) → sleepy until next activity.
          let idleTimer: ReturnType<typeof setTimeout> | null = null;
          let isSleepy = false;
          const wake = (): void => {
            if (isSleepy) {
              isSleepy = false;
              dispatchPeek('revert');
            }
            if (idleTimer !== null) clearTimeout(idleTimer);
            idleTimer = setTimeout(() => {
              isSleepy = true;
              dispatchPeek('set', { animation: navPeekConfig.idleTimeout });
            }, 10000);
          };
          ['pointermove', 'pointerdown', 'keydown', 'scroll', 'touchstart'].forEach((ev) => {
            window.addEventListener(ev, wake, { passive: true });
          });
          wake();

          return;
        }

        // ─── IntersectionObserver ─────────────────────────────────────
        const navObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                toHorizontal();
              } else {
                toVertical();
              }
            });
          },
          { threshold: 0 }
        );

        navObserver.observe(statusEl);
      })();
    </script>

  </body>
</html>
