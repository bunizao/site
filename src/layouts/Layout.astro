---
interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  url?: string;
  rss?: {
    href: string;
    title?: string;
  };
  oembed?: {
    href: string;
    title?: string;
  };
}

import '../styles/globals.css';
import { Moon, Sun, Monitor } from 'lucide-react';
import SpeedInsights from '@vercel/speed-insights/astro';

const {
  title,
  description,
  image = '/og.png',
  imageAlt = 'Bunizao',
  url,
  rss,
  oembed,
} = Astro.props;

const site = Astro.site ?? new URL('https://buxx.me');
const canonicalUrl = url ?? new URL(Astro.url?.pathname ?? '/', site).href;
const ogImageUrl = new URL(image, site).href;
const ogImageType = ogImageUrl.endsWith('.png')
  ? 'image/png'
  : ogImageUrl.endsWith('.webp')
    ? 'image/webp'
    : 'image/jpeg';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="icon" href="/favicon.ico" />
    {rss?.href ? (
      <link
        rel="alternate"
        type="application/rss+xml"
        title={rss.title ?? title}
        href={new URL(rss.href, site).href}
      />
    ) : null}
    {oembed?.href ? (
      <link
        rel="alternate"
        type="application/json+oembed"
        title={oembed.title ?? title}
        href={new URL(oembed.href, site).href}
      />
    ) : null}

    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        const storageKey = 'theme';
        const readStoredTheme = () => {
          try {
            return localStorage.getItem(storageKey);
          } catch (error) {
            return null;
          }
        };
        const storedTheme = readStoredTheme();
        const mediaQuery =
          typeof window.matchMedia === 'function'
            ? window.matchMedia('(prefers-color-scheme: dark)')
            : null;
        const prefersDark = mediaQuery ? mediaQuery.matches : false;

        // Determine the effective theme (what's actually displayed)
        const effectiveTheme =
          storedTheme === 'light' || storedTheme === 'dark'
            ? storedTheme
            : prefersDark
              ? 'dark'
              : 'light';

        // Set the theme setting attribute for icon display
        const themeSetting = storedTheme === 'light' || storedTheme === 'dark' ? storedTheme : 'system';
        document.documentElement.dataset.themeSetting = themeSetting;
        document.documentElement.classList.toggle('dark', effectiveTheme === 'dark');
      })();
    </script>

    <link
      rel="preload"
      as="font"
      href="/fonts/jetbrains-mono-variable.woff2"
      type="font/woff2"
      crossorigin
    />

    <title>{title}</title>
  </head>
  <body>
    <!-- Site navigation -->
    <nav class="site-nav" data-site-nav aria-label="Page sections">
      <div class="nav-active-indicator" data-nav-indicator aria-hidden="true"></div>
      <a href="#projects-section" class="nav-link" data-nav-link="projects" data-nav-index="01">Projects</a>
      <span class="nav-separator" aria-hidden="true">/</span>
      <a href="#writing-section" class="nav-link" data-nav-link="writing" data-nav-index="02">Writing</a>
      <span class="nav-separator" aria-hidden="true">/</span>
      <a href="#moods-section" class="nav-link" data-nav-link="moods" data-nav-index="03">Moods</a>
    </nav>

    <!-- Global header actions - theme dropdown will be added by pages -->
    <div class="global-header-actions" data-header-actions>
      <div class="theme-dropdown" data-theme-dropdown>
        <button class="header-action-btn" type="button" data-theme-toggle aria-label="Switch theme" aria-haspopup="true" aria-expanded="false">
          <span class="theme-icon-container">
            <span class="theme-icon" data-theme-icon="light" aria-hidden="true">
              <Sun className="h-4 w-4" />
            </span>
            <span class="theme-icon" data-theme-icon="dark" aria-hidden="true">
              <Moon className="h-4 w-4" />
            </span>
            <span class="theme-icon" data-theme-icon="system" aria-hidden="true">
              <Monitor className="h-4 w-4" />
            </span>
          </span>
          <span class="header-action-btn-label" data-theme-label>System</span>
        </button>
        <div class="theme-dropdown-menu" data-theme-menu role="menu" aria-label="Theme options">
          <button class="theme-dropdown-item" data-theme-option="light" role="menuitem">
            <Sun className="h-4 w-4" />
            <span>Light</span>
          </button>
          <button class="theme-dropdown-item" data-theme-option="dark" role="menuitem">
            <Moon className="h-4 w-4" />
            <span>Dark</span>
          </button>
          <button class="theme-dropdown-item" data-theme-option="system" role="menuitem">
            <Monitor className="h-4 w-4" />
            <span>System</span>
          </button>
        </div>
      </div>
    </div>
    <slot />

    <script>
      (() => {
        const storageKey = 'theme';
        const toggle = document.querySelector('[data-theme-toggle]');
        const dropdown = document.querySelector('[data-theme-dropdown]');
        const menu = document.querySelector('[data-theme-menu]');
        const options = document.querySelectorAll('[data-theme-option]');
        const media =
          typeof window.matchMedia === 'function'
            ? window.matchMedia('(prefers-color-scheme: dark)')
            : null;

        const getStoredTheme = () => {
          try {
            return localStorage.getItem(storageKey);
          } catch (error) {
            return null;
          }
        };
        const setStoredTheme = (theme: string) => {
          try {
            if (theme === 'system') {
              localStorage.removeItem(storageKey);
            } else {
              localStorage.setItem(storageKey, theme);
            }
          } catch (error) {
            // Ignore storage errors
          }
        };
        const getSystemTheme = () => (media && media.matches ? 'dark' : 'light');

        const getThemeSetting = () => {
          const stored = getStoredTheme();
          if (stored === 'light' || stored === 'dark') return stored;
          return 'system';
        };

        const updateIcons = (setting: string) => {
          document.documentElement.dataset.themeSetting = setting;
          options.forEach(opt => {
            const el = opt as HTMLElement;
            el.classList.toggle('is-active', el.dataset.themeOption === setting);
          });
          const label = document.querySelector('[data-theme-label]');
          if (label) {
            const labels: Record<string, string> = { light: 'Light', dark: 'Dark', system: 'System' };
            label.textContent = labels[setting] || 'System';
          }
        };

        const updateToggle = (setting: string) => {
          if (!toggle) return;
          const labels: Record<string, string> = { light: 'Light mode', dark: 'Dark mode', system: 'System mode' };
          toggle.setAttribute('aria-label', labels[setting] || 'Switch theme');
        };

        const applyTheme = (setting: string) => {
          const effectiveTheme = setting === 'system' ? getSystemTheme() : setting;
          const isDark = effectiveTheme === 'dark';
          document.documentElement.classList.toggle('dark', isDark);
          updateIcons(setting);
          updateToggle(setting);
        };

        const openDropdown = () => {
          if (!dropdown || !menu || !toggle) return;
          dropdown.classList.add('is-open');
          toggle.setAttribute('aria-expanded', 'true');
        };

        const closeDropdown = () => {
          if (!dropdown || !menu || !toggle) return;
          dropdown.classList.remove('is-open');
          toggle.setAttribute('aria-expanded', 'false');
        };

        const currentSetting = getThemeSetting();
        updateIcons(currentSetting);
        updateToggle(currentSetting);

        if (dropdown) {
          dropdown.addEventListener('mouseenter', openDropdown);
          dropdown.addEventListener('mouseleave', closeDropdown);
        }

        if (toggle) {
          toggle.addEventListener('click', (e) => {
            e.stopPropagation();
            if (dropdown?.classList.contains('is-open')) {
              closeDropdown();
            } else {
              openDropdown();
            }
          });
        }

        options.forEach(option => {
          option.addEventListener('click', () => {
            const el = option as HTMLElement;
            const theme = el.dataset.themeOption;
            if (theme) {
              setStoredTheme(theme);
              applyTheme(theme);
              closeDropdown();
            }
          });
        });

        document.addEventListener('click', (e) => {
          if (dropdown && !dropdown.contains(e.target as Node)) {
            closeDropdown();
          }
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            closeDropdown();
          }
        });

        const onSystemThemeChange = () => {
          if (getThemeSetting() === 'system') {
            applyTheme('system');
          }
        };

        if (media) {
          if (typeof media.addEventListener === 'function') {
            media.addEventListener('change', onSystemThemeChange);
          } else if (typeof media.addListener === 'function') {
            media.addListener(onSystemThemeChange);
          }
        }
      })();
    </script>

    <SpeedInsights />

    <!-- GSAP Header Button Animations -->
    <script>
      import gsap from 'gsap';

      (() => {
        const initHeaderAnimations = () => {
          const headerActions = document.querySelector('[data-header-actions]');
          if (!headerActions) return;

          // Get all header action buttons (excluding theme dropdown trigger)
          const buttons = headerActions.querySelectorAll('.header-action-btn:not([data-theme-toggle])');

          // Store original widths
          const buttonData = new Map();

          const measureButton = (btn) => {
            const label = btn.querySelector('.header-action-btn-label');
            if (!label) return null;

            // Get collapsed width (icon only)
            const collapsedWidth = 32; // Fixed icon-only width

            // Temporarily show label to measure
            const origMaxWidth = label.style.maxWidth;
            const origOpacity = label.style.opacity;
            label.style.maxWidth = 'none';
            label.style.opacity = '1';

            // Measure the label's natural width
            const labelWidth = label.scrollWidth;

            // Restore
            label.style.maxWidth = origMaxWidth || '0';
            label.style.opacity = origOpacity || '0';

            // Calculate expanded width: icon + gap + label + padding
            const expandedWidth = collapsedWidth + labelWidth + 14; // 6px gap + 8px extra padding

            return {
              label,
              collapsedWidth,
              expandedWidth,
              labelWidth
            };
          };

          buttons.forEach(btn => {
            const data = measureButton(btn);
            if (data) {
              buttonData.set(btn, data);
            }
          });

          // Animation function for hover in
          const animateIn = (btn) => {
            const data = buttonData.get(btn);
            if (!data) return;

            btn.classList.add('is-hovered');

            // Kill any existing animations
            gsap.killTweensOf([btn, data.label]);

            // Animate button width and label
            gsap.to(btn, {
              width: data.expandedWidth,
              paddingLeft: 10,
              paddingRight: 10,
              duration: 0.3,
              ease: 'power2.out'
            });

            gsap.to(data.label, {
              maxWidth: data.labelWidth + 10,
              opacity: 1,
              duration: 0.25,
              delay: 0.08,
              ease: 'power2.out'
            });
          };

          // Animation function for hover out
          const animateOut = (btn) => {
            const data = buttonData.get(btn);
            if (!data) return;

            btn.classList.remove('is-hovered');

            // Kill any existing animations
            gsap.killTweensOf([btn, data.label]);

            // Animate label first, then button width
            gsap.to(data.label, {
              maxWidth: 0,
              opacity: 0,
              duration: 0.15,
              ease: 'power2.in'
            });

            gsap.to(btn, {
              width: data.collapsedWidth,
              paddingLeft: 0,
              paddingRight: 0,
              duration: 0.25,
              delay: 0.05,
              ease: 'power2.inOut'
            });
          };

          // Attach event listeners
          buttons.forEach(btn => {
            btn.addEventListener('mouseenter', () => animateIn(btn));
            btn.addEventListener('mouseleave', () => animateOut(btn));

            // Focus states for accessibility
            btn.addEventListener('focus', () => animateIn(btn));
            btn.addEventListener('blur', () => animateOut(btn));
          });

          // Make animation functions globally available for dynamically added buttons
          window.headerBtnAnimations = {
            register: (btn) => {
              if (buttonData.has(btn)) return;

              // Small delay to ensure DOM is ready
              requestAnimationFrame(() => {
                const data = measureButton(btn);
                if (!data) return;

                buttonData.set(btn, data);

                btn.addEventListener('mouseenter', () => animateIn(btn));
                btn.addEventListener('mouseleave', () => animateOut(btn));
                btn.addEventListener('focus', () => animateIn(btn));
                btn.addEventListener('blur', () => animateOut(btn));
              });
            }
          };
        };

        // Start initialization after DOM is ready
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initHeaderAnimations);
        } else {
          initHeaderAnimations();
        }
      })();
    </script>

    <!-- Site Navigation: typewriter collapse + magnetic hover + active indicator -->
    <script>
      (() => {
        const nav = document.querySelector('[data-site-nav]') as HTMLElement | null;
        const links = document.querySelectorAll('[data-nav-link]');
        if (!links.length || !nav) return;

        const indicator = nav.querySelector('[data-nav-indicator]') as HTMLElement | null;
        const separators = nav.querySelectorAll('.nav-separator');
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const scrambleChars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*';
        const randChar = () => scrambleChars[Math.floor(Math.random() * scrambleChars.length)];

        // ─── 3a. Character wrapping with index injection ─────────────
        interface LinkData {
          el: HTMLElement;
          text: string;
          chars: HTMLSpanElement[];
          indexSpan: HTMLSpanElement | null;
        }
        const linkDataList: LinkData[] = [];

        links.forEach(link => {
          const el = link as HTMLElement;
          const text = el.textContent || '';
          const chars: HTMLSpanElement[] = [];
          const navIndex = el.dataset.navIndex;

          el.textContent = '';

          // Inject section index span
          let indexSpan: HTMLSpanElement | null = null;
          if (navIndex) {
            indexSpan = document.createElement('span');
            indexSpan.className = 'nav-index';
            indexSpan.textContent = navIndex;
            indexSpan.style.opacity = '0';
            el.appendChild(indexSpan);
          }

          for (const ch of text) {
            const span = document.createElement('span');
            span.className = 'nav-char';
            span.textContent = ch;
            el.appendChild(span);
            chars.push(span);
          }

          linkDataList.push({ el, text, chars, indexSpan });
        });

        // ─── 3b. Smooth scroll + active section tracking ──────────────
        links.forEach(link => {
          link.addEventListener('click', (e) => {
            const href = (link as HTMLAnchorElement).getAttribute('href');
            if (!href) return;
            const target = document.querySelector(href);
            if (!target) return;
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
        });

        const sections = ['projects', 'writing', 'moods'].map(id => ({
          id,
          el: document.getElementById(`${id}-section`)
        })).filter(s => s.el);

        let activeId = '';
        let ticking = false;

        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            const viewportH = window.innerHeight;
            let newActiveId = '';
            for (const section of sections) {
              if (!section.el) continue;
              const rect = section.el.getBoundingClientRect();
              if (rect.top <= viewportH * 0.4 && rect.bottom > viewportH * 0.2) {
                newActiveId = section.id;
              }
            }

            if (newActiveId !== activeId) {
              activeId = newActiveId;
              links.forEach(link => {
                const el = link as HTMLElement;
                el.classList.toggle('is-active', el.dataset.navLink === activeId);
              });
              if (isVertical) updateIndicator();
            }
            ticking = false;
          });
        };

        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();

        // ─── Helper: scramble decode a single character span ─────────
        // Cycles through 2-3 random glyphs at ~30ms, then settles
        const scrambleReveal = (span: HTMLSpanElement, correctChar: string): Promise<void> => {
          return new Promise(resolve => {
            const cycles = 2 + Math.floor(Math.random() * 2); // 2–3 cycles
            let count = 0;
            const iv = setInterval(() => {
              if (count < cycles) {
                span.textContent = randChar();
                span.style.opacity = '1';
                count++;
              } else {
                clearInterval(iv);
                span.textContent = correctChar;
                resolve();
              }
            }, 30);
          });
        };

        // ─── Vertical collapse: observer + transition logic ───────────
        const statusEl = document.querySelector('[data-hero-status]');
        if (!statusEl) return;

        let isVertical = false;
        let animating = false;
        let pendingDirection: 'vertical' | 'horizontal' | null = null;

        const flushPending = () => {
          if (!pendingDirection) return;
          const dir = pendingDirection;
          pendingDirection = null;
          if (dir === 'vertical') toVertical();
          else toHorizontal();
        };

        // ─── 3c. toVertical — dissolve + layout + scramble typewriter ─
        const toVertical = async () => {
          if (isVertical) return;
          if (animating) { pendingDirection = 'vertical'; return; }
          isVertical = true;
          animating = true;

          // Reduced motion — instant toggle
          if (reducedMotion) {
            nav.classList.add('is-vertical');
            separators.forEach(s => (s as HTMLElement).style.opacity = '0');
            linkDataList.forEach(ld => {
              ld.chars.forEach(c => { c.style.opacity = '1'; });
              if (ld.indexSpan) ld.indexSpan.style.opacity = '1';
            });
            showIndicator();
            animating = false;
            flushPending();
            return;
          }

          const { default: gsap } = await import('gsap');

          // Collect all chars in order for the dissolve
          const allChars = linkDataList.flatMap(ld => ld.chars);

          // Phase 1: Dissolve out (staggered left→right) with random scatter
          allChars.forEach(c => {
            c.dataset.scatterX = `${(Math.random() - 0.5) * 8}`;
          });
          await gsap.to(allChars, {
            opacity: 0,
            y: -3,
            x: (_i: number, el: HTMLElement) => parseFloat(el.dataset.scatterX || '0'),
            duration: 0.18,
            stagger: 0.012,
            ease: 'power2.in'
          });

          // Also fade separators
          gsap.set(Array.from(separators), { opacity: 0 });

          // Phase 2: Layout switch
          nav.classList.add('is-vertical');

          // Phase 3: Scramble decode typewriter per link
          for (let i = 0; i < linkDataList.length; i++) {
            const { chars, text, indexSpan } = linkDataList[i];
            // Reset positions before reveal
            gsap.set(chars, { y: 0, x: 0 });

            // Fade in index span
            if (indexSpan) {
              gsap.to(indexSpan, { opacity: 1, duration: 0.15, ease: 'power2.out' });
            }

            for (let j = 0; j < chars.length; j++) {
              // Remove cursor from previous char
              if (j > 0) chars[j - 1].classList.remove('is-cursor');
              chars[j].classList.add('is-cursor');

              // Scramble decode: cycle random chars then settle
              await scrambleReveal(chars[j], text[j]);
            }
            // Remove cursor from last char
            chars[chars.length - 1].classList.remove('is-cursor');
          }

          showIndicator();
          animating = false;
          flushPending();
        };

        // ─── 3d. toHorizontal — scatter dissolve + layout + snappy cascade
        const toHorizontal = async () => {
          if (!isVertical) return;
          if (animating) { pendingDirection = 'horizontal'; return; }
          isVertical = false;
          animating = true;

          if (reducedMotion) {
            hideIndicator();
            nav.classList.remove('is-vertical');
            separators.forEach(s => (s as HTMLElement).style.opacity = '1');
            linkDataList.forEach(ld => {
              ld.chars.forEach(c => { c.style.opacity = '1'; });
              if (ld.indexSpan) ld.indexSpan.style.opacity = '0';
            });
            animating = false;
            flushPending();
            return;
          }

          const { default: gsap } = await import('gsap');

          hideIndicator();

          // Hide index spans
          linkDataList.forEach(ld => {
            if (ld.indexSpan) gsap.to(ld.indexSpan, { opacity: 0, duration: 0.1 });
          });

          // Phase 1: Scatter dissolve per-link, bottom to top
          for (let i = linkDataList.length - 1; i >= 0; i--) {
            const { chars } = linkDataList[i];
            // Each char gets a random x offset for scatter
            chars.forEach(c => {
              c.dataset.scatterX = `${(Math.random() - 0.5) * 8}`;
            });
            await gsap.to(chars, {
              opacity: 0,
              y: -3,
              x: (_i: number, el: HTMLElement) => parseFloat(el.dataset.scatterX || '0'),
              duration: 0.15,
              stagger: 0.025,
              ease: 'power2.in'
            });
          }

          // Phase 2: Layout switch
          nav.classList.remove('is-vertical');

          // Phase 3: Snappy cascade reveal all chars + separators
          const allChars = linkDataList.flatMap(ld => ld.chars);
          gsap.set(allChars, { y: 0, x: 0 });

          gsap.to(allChars, {
            opacity: 1,
            duration: 0.2,
            stagger: 0.015,
            ease: 'back.out(1.7)'
          });

          gsap.to(Array.from(separators), {
            opacity: 1,
            duration: 0.25,
            delay: 0.1,
            ease: 'power2.out',
            onComplete: () => {
              animating = false;
              flushPending();
            }
          });
        };

        // ─── 3e. Active indicator ─────────────────────────────────────
        const showIndicator = async () => {
          if (!indicator) return;
          const { default: gsap } = await import('gsap');
          positionIndicator(gsap, false);
          gsap.to(indicator, {
            opacity: 1,
            scaleX: 1,
            duration: 0.3,
            ease: 'power2.out'
          });
        };

        const hideIndicator = async () => {
          if (!indicator) return;
          const { default: gsap } = await import('gsap');
          gsap.to(indicator, {
            opacity: 0,
            scaleX: 0,
            duration: 0.2,
            ease: 'power2.in'
          });
        };

        const updateIndicator = async () => {
          if (!indicator || !isVertical) return;
          const { default: gsap } = await import('gsap');
          positionIndicator(gsap, true);
        };

        const positionIndicator = (gsap: any, animate: boolean) => {
          if (!indicator) return;
          const activeLink = nav.querySelector('.nav-link.is-active') as HTMLElement | null;
          if (!activeLink) {
            gsap.to(indicator, { opacity: 0, duration: 0.15 });
            return;
          }

          const navRect = nav.getBoundingClientRect();
          const linkRect = activeLink.getBoundingClientRect();
          const targetY = linkRect.top - navRect.top + (linkRect.height - 20) / 2;

          if (animate) {
            gsap.to(indicator, {
              y: targetY,
              opacity: 1,
              duration: 0.5,
              ease: 'elastic.out(1, 0.5)'
            });
          } else {
            gsap.set(indicator, { y: targetY });
          }
        };

        // Keep indicator positioned on resize
        window.addEventListener('resize', () => {
          if (isVertical && indicator) updateIndicator();
        });

        // ─── 3f. Magnetic hover (desktop, vertical mode only) ─────────
        // Two-layer parallax + 3D perspective tilt
        const initMagneticHover = async () => {
          const { default: gsap } = await import('gsap');

          // Layer 1: Container 3D tilt + magnetic drift
          const containerStrength = 0.12;
          const tiltMax = 8; // max degrees
          const navQuickX = gsap.quickTo(nav, 'x', { duration: 0.4, ease: 'power2.out' });
          const navQuickY = gsap.quickTo(nav, 'y', { duration: 0.4, ease: 'power2.out' });
          const navQuickRotX = gsap.quickTo(nav, 'rotateX', { duration: 0.35, ease: 'power2.out' });
          const navQuickRotY = gsap.quickTo(nav, 'rotateY', { duration: 0.35, ease: 'power2.out' });
          let navBounds: DOMRect | null = null;

          nav.addEventListener('pointerenter', (e: PointerEvent) => {
            if (e.pointerType !== 'mouse' || !isVertical) return;
            navBounds = nav.getBoundingClientRect();
          });

          nav.addEventListener('pointermove', (e: PointerEvent) => {
            if (e.pointerType !== 'mouse' || !isVertical) return;
            if (!navBounds) navBounds = nav.getBoundingClientRect();
            const cx = navBounds.left + navBounds.width / 2;
            const cy = navBounds.top + navBounds.height / 2;
            const dx = e.clientX - cx;
            const dy = e.clientY - cy;

            // Magnetic drift
            navQuickX(dx * containerStrength);
            navQuickY(dy * containerStrength);

            // 3D tilt: mouse right → rotateY positive, mouse down → rotateX negative
            const ratioX = dx / (navBounds.width / 2);
            const ratioY = dy / (navBounds.height / 2);
            navQuickRotY(ratioX * tiltMax);
            navQuickRotX(-ratioY * tiltMax);

            // Cursor-tracking glow position
            const mx = ((e.clientX - navBounds.left) / navBounds.width * 100);
            const my = ((e.clientY - navBounds.top) / navBounds.height * 100);
            nav.style.setProperty('--mx', `${mx}%`);
            nav.style.setProperty('--my', `${my}%`);
          });

          nav.addEventListener('pointerleave', (e: PointerEvent) => {
            if (e.pointerType !== 'mouse') return;
            navBounds = null;
            gsap.to(nav, {
              x: 0, y: 0, rotateX: 0, rotateY: 0,
              duration: 0.6, ease: 'elastic.out(1, 0.3)'
            });
          });

          // Layer 2: Per-link magnetic pull + char wave
          linkDataList.forEach(({ el, chars }) => {
            const linkStrength = 0.25;
            const quickX = gsap.quickTo(el, 'x', { duration: 0.3, ease: 'power2.out' });
            const quickY = gsap.quickTo(el, 'y', { duration: 0.3, ease: 'power2.out' });
            let bounds: DOMRect | null = null;

            el.addEventListener('pointerenter', (e: PointerEvent) => {
              if (e.pointerType !== 'mouse' || !isVertical) return;
              bounds = el.getBoundingClientRect();

              // Per-char wave float
              chars.forEach((c, i) => {
                gsap.to(c, {
                  y: -1.5,
                  duration: 0.25,
                  delay: i * 0.015,
                  ease: 'power2.out'
                });
              });
            });

            el.addEventListener('pointermove', (e: PointerEvent) => {
              if (e.pointerType !== 'mouse' || !isVertical) return;
              if (!bounds) bounds = el.getBoundingClientRect();
              const centerX = bounds.left + bounds.width / 2;
              const centerY = bounds.top + bounds.height / 2;
              quickX((e.clientX - centerX) * linkStrength);
              quickY((e.clientY - centerY) * linkStrength);
            });

            el.addEventListener('pointerleave', (e: PointerEvent) => {
              if (e.pointerType !== 'mouse') return;
              bounds = null;
              gsap.to(el, { x: 0, y: 0, duration: 0.5, ease: 'elastic.out(1, 0.3)' });

              // Spring chars back
              chars.forEach(c => {
                gsap.to(c, {
                  y: 0,
                  duration: 0.6,
                  ease: 'elastic.out(1, 0.4)'
                });
              });
            });
          });
        };

        initMagneticHover();

        // ─── IntersectionObserver ─────────────────────────────────────
        const navObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                toHorizontal();
              } else {
                toVertical();
              }
            });
          },
          { threshold: 0 }
        );

        navObserver.observe(statusEl);
      })();
    </script>

    <script>
      const scheduleAnalytics = (callback) => {
        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(callback, { timeout: 2000 });
        } else {
          setTimeout(callback, 0);
        }
      };

      scheduleAnalytics(() => {
        import('@vercel/analytics')
          .then(({ inject }) => inject())
          .catch(() => {});
      });
    </script>
  </body>
</html>
