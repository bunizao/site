---
interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  url?: string;
  rss?: {
    href: string;
    title?: string;
  };
}

import '../styles/globals.css';
import { Moon, Sun, Monitor } from 'lucide-react';

const {
  title,
  description,
  image = '/og.png',
  imageAlt = 'Bunizao',
  url,
  rss,
} = Astro.props;

const site = Astro.site ?? new URL('https://buxx.me');
const canonicalUrl = url ?? new URL(Astro.url?.pathname ?? '/', site).href;
const ogImageUrl = new URL(image, site).href;
const ogImageType = ogImageUrl.endsWith('.png')
  ? 'image/png'
  : ogImageUrl.endsWith('.webp')
    ? 'image/webp'
    : 'image/jpeg';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="icon" href="/favicon.ico" />
    {rss?.href ? (
      <link
        rel="alternate"
        type="application/rss+xml"
        title={rss.title ?? title}
        href={new URL(rss.href, site).href}
      />
    ) : null}

    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        const storageKey = 'theme';
        const readStoredTheme = () => {
          try {
            return localStorage.getItem(storageKey);
          } catch (error) {
            return null;
          }
        };
        const storedTheme = readStoredTheme();
        const mediaQuery =
          typeof window.matchMedia === 'function'
            ? window.matchMedia('(prefers-color-scheme: dark)')
            : null;
        const prefersDark = mediaQuery ? mediaQuery.matches : false;

        // Determine the effective theme (what's actually displayed)
        const effectiveTheme =
          storedTheme === 'light' || storedTheme === 'dark'
            ? storedTheme
            : prefersDark
              ? 'dark'
              : 'light';

        // Set the theme setting attribute for icon display
        const themeSetting = storedTheme === 'light' || storedTheme === 'dark' ? storedTheme : 'system';
        document.documentElement.dataset.themeSetting = themeSetting;
        document.documentElement.classList.toggle('dark', effectiveTheme === 'dark');
      })();
    </script>

    <!-- Font loading - non-blocking with fallback -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <title>{title}</title>
  </head>
  <body>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch theme">
      <span class="theme-icon" data-theme-icon="light" aria-hidden="true">
        <Moon className="h-4 w-4" />
      </span>
      <span class="theme-icon" data-theme-icon="dark" aria-hidden="true">
        <Sun className="h-4 w-4" />
      </span>
      <span class="theme-icon" data-theme-icon="system" aria-hidden="true">
        <Monitor className="h-4 w-4" />
      </span>
    </button>
    <slot />

    <script is:inline>
      (() => {
        const storageKey = 'theme';
        const toggle = document.querySelector('[data-theme-toggle]');
        const media =
          typeof window.matchMedia === 'function'
            ? window.matchMedia('(prefers-color-scheme: dark)')
            : null;

        const getStoredTheme = () => {
          try {
            return localStorage.getItem(storageKey);
          } catch (error) {
            return null;
          }
        };
        const setStoredTheme = (theme) => {
          try {
            if (theme === 'system') {
              localStorage.removeItem(storageKey);
            } else {
              localStorage.setItem(storageKey, theme);
            }
          } catch (error) {
            // Ignore storage errors
          }
        };
        const getSystemTheme = () => (media && media.matches ? 'dark' : 'light');

        // Get the current setting (light/dark/system)
        const getThemeSetting = () => {
          const stored = getStoredTheme();
          if (stored === 'light' || stored === 'dark') return stored;
          return 'system';
        };

        // Get what theme is actually displayed
        const getEffectiveTheme = () => {
          const setting = getThemeSetting();
          if (setting === 'system') return getSystemTheme();
          return setting;
        };

        const updateIcons = (setting) => {
          document.documentElement.dataset.themeSetting = setting;
        };

        const updateToggle = (setting) => {
          if (!toggle) return;
          const labels = { light: 'Light mode, click for dark', dark: 'Dark mode, click for auto', system: 'Auto mode, click for light' };
          toggle.setAttribute('aria-label', labels[setting] || 'Switch theme');
        };

        const applyTheme = (setting) => {
          const effectiveTheme = setting === 'system' ? getSystemTheme() : setting;
          const isDark = effectiveTheme === 'dark';

          // Use View Transitions API for smooth theme change
          if (document.startViewTransition) {
            document.startViewTransition(() => {
              document.documentElement.classList.toggle('dark', isDark);
            });
          } else {
            document.documentElement.classList.toggle('dark', isDark);
          }

          updateIcons(setting);
          updateToggle(setting);
        };

        // Cycle: light -> dark -> system -> light
        const getNextSetting = (current) => {
          const cycle = { light: 'dark', dark: 'system', system: 'light' };
          return cycle[current] || 'light';
        };

        // Initialize
        const currentSetting = getThemeSetting();
        updateIcons(currentSetting);
        updateToggle(currentSetting);

        if (toggle) {
          toggle.addEventListener('click', () => {
            const current = getThemeSetting();
            const next = getNextSetting(current);
            setStoredTheme(next);
            applyTheme(next);
          });
        }

        // Listen for system theme changes
        const onSystemThemeChange = () => {
          if (getThemeSetting() === 'system') {
            applyTheme('system');
          }
        };

        if (media) {
          if (typeof media.addEventListener === 'function') {
            media.addEventListener('change', onSystemThemeChange);
          } else if (typeof media.addListener === 'function') {
            media.addListener(onSystemThemeChange);
          }
        }
      })();
    </script>

    <script>
      const scheduleAnalytics = (callback) => {
        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(callback, { timeout: 2000 });
        } else {
          setTimeout(callback, 0);
        }
      };

      scheduleAnalytics(() => {
        import('@vercel/analytics')
          .then(({ inject }) => inject())
          .catch(() => {});
      });
    </script>
  </body>
</html>
