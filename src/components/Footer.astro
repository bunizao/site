---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-content">
    <span class="footer-copyright">© {year} bunizao</span>
    <span class="footer-divider">·</span>
    <a href="/privacy" class="footer-link">
      Privacy
    </a>
    <span class="footer-divider">·</span>
    <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="footer-link">
      Astro
    </a>
    <span class="footer-divider">·</span>
    <a href="https://github.com/bunizao/site" target="_blank" rel="noopener noreferrer" class="footer-link">
      Source
    </a>
  </div>
</footer>

<style>
  .footer {
    padding: 3rem 0 2rem;
  }

  .footer-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 300;
    color: hsl(var(--muted-foreground) / 0.5);
  }

  .footer-copyright {
    color: hsl(var(--muted-foreground) / 0.6);
  }

  .footer-divider {
    color: hsl(var(--muted-foreground) / 0.3);
  }

  .footer-link {
    color: hsl(var(--muted-foreground) / 0.5);
    transition: color 0.15s ease;
  }

  .footer-link:hover {
    color: hsl(var(--muted-foreground));
  }
</style>
