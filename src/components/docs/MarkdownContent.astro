---
// Override Starlight's MarkdownContent for the internal-page experience.
//
// In production, internal page bodies are not shipped to the public HTML —
// instead we render a frosted skeleton + sign-in CTA. A small client script
// pings /api/docs/internal/<slug>: if the request carries a valid
// admin_session cookie, the API returns the real rendered HTML and we swap
// it in; otherwise the blur stays and the CTA points at OAuth.
//
// In dev (`bun dev`), redaction is off — internal pages render their full
// body so the author can edit them locally without authenticating.
import '@astrojs/starlight/style/markdown.css';

const route = Astro.locals.starlightRoute;
const data = route.entry.data as { internal?: boolean };
const isInternal = data.internal === true;
const redact = isInternal && import.meta.env.PROD;
// Slug Starlight gave us already includes the leading `docs/` prefix because
// content lives at src/content/docs/docs/. The API takes the suffix.
const slug = route.entry.id.replace(/^docs\//, '').replace(/\.(md|mdx)$/, '');
const fetchUrl = `/api/docs/internal/${slug}`;
---

{redact ? (
  <div class="sl-markdown-content docs-internal-shell" data-docs-internal-shell data-internal-fetch={fetchUrl}>
    <div class="docs-internal-content" aria-hidden="true">
      <p>This page is private. The body lives in the project's source folder for admins and contributors.</p>
      <p>Sign in with the project's admin GitHub account to read internal pages in place. Public pages stay open.</p>
      <h2>Sections covered</h2>
      <ul>
        <li>Overview, scope, and where each piece lives in the codebase.</li>
        <li>Implementation notes, environment variables, and failure modes.</li>
        <li>Operational safeguards and what's coupled to what.</li>
      </ul>
      <p>The fastest way to see whether you have access is to try signing in — your session is checked against the project's allowlisted GitHub login.</p>
      <p>For most readers, the public pages are enough — they cover the architecture, the public APIs, the privacy policy, and how the content pipeline works end to end.</p>
    </div>
    <div class="docs-internal-veil" data-docs-internal-veil>
      <div class="docs-internal-card">
        <span class="docs-internal-glyph" aria-hidden="true">🔒</span>
        <h2 class="docs-internal-heading">Sign in to read</h2>
        <p class="docs-internal-copy">
          This page is gated behind the project's admin OAuth session. The body
          is not shipped to public HTML — sign in to load it in place.
        </p>
        <a class="docs-internal-cta" href="/api/admin/auth/start" data-docs-internal-cta>
          Continue with GitHub
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
        <p class="docs-internal-fineprint">
          Public pages stay open without sign-in.
        </p>
      </div>
    </div>
  </div>
  <script is:inline>
    (() => {
      const shell = document.querySelector('[data-docs-internal-shell]');
      if (!shell) return;
      const fetchUrl = shell.getAttribute('data-internal-fetch');
      const cta = shell.querySelector('[data-docs-internal-cta]');
      const veil = shell.querySelector('[data-docs-internal-veil]');
      const inner = shell.querySelector('.docs-internal-content');
      if (!fetchUrl || !cta || !veil || !inner) return;

      // Wire OAuth redirect back to this exact URL.
      const here = window.location.pathname + window.location.search + window.location.hash;
      cta.setAttribute('href', `/api/admin/auth/start?next=${encodeURIComponent(here)}`);

      // Probe the auth-gated endpoint. If the visitor already has a valid
      // admin_session cookie, swap the real body in; otherwise leave the veil.
      fetch(fetchUrl, { credentials: 'same-origin', headers: { Accept: 'text/html' } })
        .then((res) => {
          if (!res.ok) return null;
          return res.text();
        })
        .then((html) => {
          if (!html) return;
          inner.innerHTML = html;
          inner.removeAttribute('aria-hidden');
          veil.remove();
          shell.classList.add('docs-internal-shell--unlocked');
          // Re-trigger Starlight's TOC builder by dispatching a load-like event;
          // since the right rail was redacted server-side we leave the TOC
          // hidden — the unlocked body still scrolls and reads cleanly.
        })
        .catch(() => {
          // Network/script issue: keep the veil up. No throw.
        });
    })();
  </script>
) : (
  <div class="sl-markdown-content"><slot /></div>
)}

<style>
  @layer starlight.core {
    .docs-internal-shell {
      position: relative;
      isolation: isolate;
      min-height: 24rem;
    }

    .docs-internal-content {
      filter: blur(8px) saturate(70%);
      pointer-events: none;
      user-select: none;
      opacity: 0.65;
      transition: filter 320ms ease, opacity 320ms ease;
    }

    .docs-internal-shell--unlocked .docs-internal-content {
      filter: none;
      opacity: 1;
      pointer-events: auto;
      user-select: auto;
    }

    .docs-internal-content h2 {
      margin-top: 1.5rem !important;
    }

    .docs-internal-veil {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding-top: 4rem;
      pointer-events: none;
      z-index: 1;
    }

    .docs-internal-card {
      width: min(100%, 24rem);
      padding: 1.75rem 1.75rem 1.5rem;
      background: var(--sl-color-bg);
      border: 1px solid var(--sl-color-hairline);
      border-radius: 0.75rem;
      box-shadow:
        0 1px 0 var(--sl-color-hairline-light),
        0 12px 32px -16px rgb(0 0 0 / 0.4);
      pointer-events: auto;
      text-align: left;
    }

    :root[data-theme='light'] .docs-internal-card {
      box-shadow:
        0 1px 0 var(--sl-color-hairline-light),
        0 12px 32px -16px rgb(0 0 0 / 0.12);
    }

    .docs-internal-glyph {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2rem;
      height: 2rem;
      margin-bottom: 0.75rem;
      background: var(--sl-color-hairline-shade);
      border: 1px solid var(--sl-color-hairline);
      border-radius: 0.5rem;
      font-size: 0.95rem;
      line-height: 1;
    }

    .docs-internal-heading {
      margin: 0 0 0.5rem !important;
      font-size: 1rem !important;
      font-weight: 600 !important;
      letter-spacing: -0.01em !important;
      color: var(--sl-color-white) !important;
    }

    .docs-internal-copy {
      margin: 0 0 1rem !important;
      font-size: 0.875rem !important;
      line-height: 1.55 !important;
      color: var(--sl-color-gray-2) !important;
    }

    .docs-internal-cta {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0.85rem;
      background: var(--sl-color-text-accent) !important;
      color: var(--sl-color-bg) !important;
      border-radius: 0.45rem;
      font-size: 0.8125rem;
      font-weight: 500;
      letter-spacing: -0.005em;
      text-decoration: none !important;
      transition: opacity 120ms ease;
    }

    .docs-internal-cta:hover {
      opacity: 0.85;
      color: var(--sl-color-bg) !important;
      text-decoration: none !important;
    }

    .docs-internal-cta svg {
      flex: 0 0 auto;
    }

    .docs-internal-fineprint {
      margin: 0.85rem 0 0 !important;
      font-size: 0.75rem !important;
      color: var(--sl-color-gray-3) !important;
    }
  }
</style>
