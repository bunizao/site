---
// Override Starlight's TableOfContents so internal pages don't leak section
// names to the right rail when their bodies are redacted in production. For
// non-internal pages, delegate to Starlight's stock component.
import StarlightTableOfContents from '@astrojs/starlight/components/TableOfContents.astro';

const route = Astro.locals.starlightRoute;
const data = route.entry.data as { internal?: boolean };
const isInternal = data.internal === true;
const redact = isInternal && import.meta.env.PROD;
---

{!redact && <StarlightTableOfContents />}
