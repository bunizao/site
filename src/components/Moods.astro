---
import dayjs from 'dayjs';
import { getChannelInfo, type ChannelInfo } from '../lib/telegram';

let latestMoods: any[] = [];
let error = false;

try {
  const result = await getChannelInfo(Astro, { type: 'list' }) as ChannelInfo;
  latestMoods = result.posts.slice(0, 3);
} catch (e) {
  console.error('Failed to fetch moods:', e);
  error = true;
}
---

<section id="moods-section" class="moods-section">
  <span class="section-label scroll-reveal">Moods</span>

  {error ? (
    <p class="text-sm text-muted-foreground">Unable to load moods.</p>
  ) : latestMoods.length > 0 ? (
    <div class="mood-list">
      {latestMoods.map((mood, index) => {
        const firstTag = mood.tags?.[0];
        return (
          <a href={`/mood/${mood.id}`} class="mood-item scroll-reveal-item" style={`--item-index: ${index}`}>
            <span class="mood-title">{mood.title}</span>
            <span class="mood-meta">
              {firstTag && (
                <span class="mood-tag">#{firstTag}</span>
              )}
              <span class="mood-date">{dayjs(mood.datetime).format('YYYY.MM.DD')}</span>
            </span>
          </a>
        );
      })}
    </div>
  ) : (
    <p class="text-sm text-muted-foreground">No moods yet.</p>
  )}

  <a
    href="/mood"
    class="link scroll-reveal-link mt-6 text-sm text-muted-foreground"
  >
    View all moods
  </a>
</section>

<style>
  .moods-section {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  .moods-section.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .scroll-reveal {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.4s ease-out, transform 0.4s ease-out;
  }

  .moods-section.is-visible .scroll-reveal {
    opacity: 1;
    transform: translateY(0);
  }

  .scroll-reveal-item {
    opacity: 0;
    transform: translateX(-20px);
    transition: opacity 0.4s ease-out, transform 0.4s ease-out, padding 0.15s ease;
  }

  .moods-section.is-visible .scroll-reveal-item {
    opacity: 1;
    transform: translateX(0);
    transition-delay: calc(var(--item-index) * 0.06s + 0.1s);
  }

  .scroll-reveal-link {
    opacity: 0;
    transition: opacity 0.4s ease-out;
  }

  .moods-section.is-visible .scroll-reveal-link {
    opacity: 1;
    transition-delay: 0.4s;
  }

  .mood-list {
    display: flex;
    flex-direction: column;
  }

  .mood-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 0;
    position: relative;
    transition: all 0.15s ease;
  }

  @media (min-width: 640px) {
    .mood-item {
      flex-direction: row;
      justify-content: space-between;
      align-items: baseline;
      gap: 16px;
      padding: 14px 0;
    }
  }

  .mood-item::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(to right, hsl(var(--foreground) / 0.1), transparent);
  }

  .mood-item:last-child::after {
    display: none;
  }

  .mood-item:hover {
    padding-left: 8px;
  }

  .mood-title {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .mood-meta {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .mood-meta {
      gap: 12px;
    }
  }

  .mood-tag {
    font-size: 11px;
    font-weight: 400;
    color: hsl(var(--muted-foreground) / 0.7);
  }

  @media (min-width: 640px) {
    .mood-tag {
      font-size: 12px;
    }
  }

  .mood-date {
    font-size: 11px;
    font-weight: 300;
    color: hsl(var(--muted-foreground) / 0.5);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 640px) {
    .mood-date {
      font-size: 12px;
    }
  }

  .mood-item:hover .mood-date,
  .mood-item:hover .mood-tag {
    color: hsl(var(--muted-foreground));
  }
</style>

<script>
  const moodsSection = document.getElementById('moods-section');

  if (moodsSection) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.1,
        rootMargin: '0px 0px -30px 0px'
      }
    );

    observer.observe(moodsSection);
  }
</script>
