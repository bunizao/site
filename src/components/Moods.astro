---
const SKELETON_COUNT = 5;
const skeletonPatterns = [
  { line1: '72%', line2: '0%', lineCount: 1 },
  { line1: '64%', line2: '42%', lineCount: 2 },
  { line1: '76%', line2: '54%', lineCount: 2 },
  { line1: '60%', line2: '0%', lineCount: 1 },
  { line1: '70%', line2: '38%', lineCount: 2 },
];
const placeholders = Array.from({ length: SKELETON_COUNT }, (_, index) => ({
  index,
  pattern: skeletonPatterns[index % skeletonPatterns.length],
}));
---

<section id="moods-section" class="moods-section" data-parallax="off">
  <span class="section-label scroll-reveal">Moods</span>

  <div class="mood-timeline" data-mood-list role="region" aria-busy="true" aria-label="Recent moods">
    {placeholders.map(({ index, pattern }) => (
      <div
        class="mood-item mood-item-skeleton"
        style={`--item-index: ${index}; --line-1: ${pattern.line1}; --line-2: ${pattern.line2};`}
      >
        <div class="mood-time-col">
          <span class="mood-skeleton-time"></span>
        </div>
        <div class="mood-line-col">
          <div class="mood-dot"></div>
          <div class="mood-line"></div>
        </div>
        <div class="mood-content-col">
          <div class="mood-card mood-card-skeleton">
            <div class="mood-skeleton-lines" data-skeleton-lines data-line-count={String(pattern.lineCount)}>
              <span class="mood-skeleton-block mood-skeleton-block--primary"></span>
              <span class="mood-skeleton-block mood-skeleton-block--secondary"></span>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>

  <p class="mood-empty-state" data-mood-empty hidden>No moods yet.</p>
  <p class="mood-error-state" data-mood-error hidden>Unable to load moods.</p>

  <a
    href="/mood"
    class="link scroll-reveal-link mt-6 text-sm text-muted-foreground"
    aria-label="View all moods"
  >
    View all moods
  </a>
</section>

<style is:global>
  #moods-section {
    /* Initial state handled by GSAP */
  }

  #moods-section .scroll-reveal {
    /* Initial state handled by GSAP */
  }

  #moods-section .scroll-reveal-item {
    /* Initial state handled by GSAP */
  }

  #moods-section .scroll-reveal-link {
    /* Initial state handled by GSAP */
  }

  /* Timeline Layout - 3 columns: time | line | content */
  #moods-section .mood-timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  #moods-section .mood-item {
    display: grid;
    grid-template-columns: 52px 24px 1fr;
    gap: 0;
    text-decoration: none;
    color: inherit;
    position: relative;
  }

  #moods-section .mood-item--clickable {
    cursor: pointer;
  }

  @media (min-width: 640px) {
    #moods-section .mood-item {
      grid-template-columns: 56px 28px 1fr;
    }
  }

  /* Time column */
  #moods-section .mood-time-col {
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    padding-top: 14px;
    padding-right: 8px;
  }

  #moods-section .mood-time {
    font-size: 11px;
    font-weight: 500;
    color: hsl(var(--muted-foreground) / 0.5);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
    transition: color 0.2s ease;
  }

  @media (min-width: 640px) {
    #moods-section .mood-time {
      font-size: 12px;
    }
  }

  #moods-section .mood-item:not(.mood-item-skeleton):hover .mood-time {
    color: hsl(var(--muted-foreground));
  }


  /* Line column */
  #moods-section .mood-line-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  #moods-section .mood-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: hsl(var(--background));
    border: 2px solid hsl(var(--foreground) / 0.15);
    margin-top: 12px;
    position: relative;
    z-index: 2;
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  #moods-section .mood-item:not(.mood-item-skeleton):hover .mood-dot {
    border-color: hsl(var(--foreground) / 0.4);
    background: hsl(var(--foreground) / 0.08);
    transform: scale(1.3);
  }

  /* Pulse effect on first item */
  #moods-section .mood-item:first-child:not(.mood-item-skeleton) .mood-dot::before {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1px solid hsl(var(--foreground) / 0.1);
    animation: mood-pulse 2.5s ease-out infinite;
  }

  @keyframes mood-pulse {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    100% {
      transform: scale(2);
      opacity: 0;
    }
  }

  #moods-section .mood-line {
    flex: 1;
    width: 1px;
    background: linear-gradient(
      to bottom,
      hsl(var(--foreground) / 0.12),
      hsl(var(--foreground) / 0.06)
    );
    margin-top: 4px;
    position: relative;
  }

  #moods-section .mood-item:last-child .mood-line {
    background: linear-gradient(
      to bottom,
      hsl(var(--foreground) / 0.12),
      transparent
    );
  }

  /* Content column */
  #moods-section .mood-content-col {
    padding: 8px 0 16px 0;
  }

  #moods-section .mood-card {
    padding: 10px 14px;
    background: hsl(var(--foreground) / 0.02);
    border: 1px solid hsl(var(--foreground) / 0.06);
    border-radius: 10px;
    min-height: var(--reserved-card-height, auto);
    transition: all 0.2s ease;
  }

  @media (min-width: 640px) {
    #moods-section .mood-card {
      padding: 10px 14px;
    }
  }

  #moods-section .mood-item:not(.mood-item-skeleton):hover .mood-card {
    background: hsl(var(--foreground) / 0.04);
    border-color: hsl(var(--foreground) / 0.12);
    transform: translateX(4px);
    box-shadow: -4px 0 0 hsl(var(--foreground) / 0.06);
  }

  #moods-section .mood-text {
    font-size: 13px;
    font-weight: 400;
    line-height: 1.55;
    color: hsl(var(--foreground) / 0.85);
    display: -webkit-box;
    min-height: var(--reserved-text-height, auto);
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  #moods-section .mood-text a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid hsl(var(--foreground) / 0.35);
    transition: border-color 0.15s ease, color 0.15s ease, opacity 0.15s ease;
  }

  #moods-section .mood-text a:hover,
  #moods-section .mood-text a:focus-visible {
    border-bottom-color: hsl(var(--foreground) / 0.6);
  }

  #moods-section :global(.mood-text .tg-emoji) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.15em;
    height: 1.15em;
    vertical-align: -0.15em;
  }

  #moods-section :global(.mood-text .tg-emoji img) {
    width: 100%;
    height: 100%;
    display: block;
  }

  @media (min-width: 640px) {
    #moods-section .mood-text {
      font-size: 14px;
      line-height: 1.6;
    }
  }

  #moods-section .mood-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
  }

  #moods-section .mood-tag {
    font-size: 10px;
    font-weight: 500;
    color: hsl(var(--muted-foreground) / 0.6);
    padding: 2px 6px;
    background: hsl(var(--foreground) / 0.04);
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  @media (min-width: 640px) {
    #moods-section .mood-tag {
      font-size: 11px;
    }
  }

  #moods-section .mood-item:hover .mood-tag {
    background: hsl(var(--foreground) / 0.08);
    color: hsl(var(--muted-foreground) / 0.8);
  }

  #moods-section .mood-thumbnail {
    width: 48px;
    height: 48px;
    border-radius: 6px;
    overflow: hidden;
    background: hsl(var(--foreground) / 0.04);
    flex-shrink: 0;
  }

  #moods-section .mood-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }



  /* Skeleton Styles - Timeline Pulse */
  #moods-section .mood-item-skeleton {
    pointer-events: none;
    position: relative;
    --skeleton-delay: calc(var(--item-index, 0) * 0.12s);
  }

  #moods-section .mood-item-skeleton .mood-dot {
    border-color: hsl(var(--foreground) / 0.1);
    background: hsl(var(--background));
    box-shadow: 0 0 0 1px hsl(var(--foreground) / 0.03);
  }

  #moods-section .mood-item-skeleton .mood-dot::after {
    content: '';
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    border: 1px solid hsl(var(--foreground) / 0.08);
    opacity: 0;
    animation: mood-skeleton-pulse 2.4s ease-out infinite;
    animation-delay: var(--skeleton-delay);
  }

  #moods-section .mood-item-skeleton .mood-line {
    background: linear-gradient(
      to bottom,
      hsl(var(--foreground) / 0.12),
      hsl(var(--foreground) / 0.03)
    );
    position: relative;
    overflow: hidden;
  }

  #moods-section .mood-item-skeleton .mood-line::after {
    content: '';
    position: absolute;
    inset: -40% 0;
    background: linear-gradient(
      to bottom,
      transparent,
      hsl(var(--foreground) / 0.14),
      transparent
    );
    transform: translateY(-60%);
    animation: mood-skeleton-flow 2.6s ease-in-out infinite;
    animation-delay: var(--skeleton-delay);
  }

  #moods-section .mood-card-skeleton {
    position: relative;
    overflow: hidden;
    background: hsl(var(--foreground) / 0.02);
    border-color: hsl(var(--foreground) / 0.06);
    box-shadow: inset 0 0 0 1px hsl(var(--background) / 0.7);
  }

  #moods-section .mood-card-skeleton::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 140%;
    left: -120%;
    background: linear-gradient(
      120deg,
      transparent 20%,
      hsl(var(--foreground) / 0.08) 50%,
      transparent 80%
    );
    animation: mood-skeleton-sheen 2.8s ease-in-out infinite;
    animation-delay: var(--skeleton-delay);
    opacity: 0.3;
  }

  #moods-section .mood-skeleton-lines {
    position: relative;
    z-index: 1;
  }

  #moods-section .mood-skeleton-lines {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  #moods-section .mood-skeleton-block,
  #moods-section .mood-skeleton-time {
    display: block;
    border-radius: 999px;
    background: linear-gradient(
      100deg,
      hsl(var(--foreground) / 0.04),
      hsl(var(--foreground) / 0.08),
      hsl(var(--foreground) / 0.04)
    );
    background-size: 160% 100%;
    animation: mood-skeleton-shimmer 1.9s ease-in-out infinite;
    animation-delay: var(--skeleton-delay);
  }

  #moods-section .mood-skeleton-block {
    height: 12px;
    border-radius: 6px;
    width: var(--line-1, 70%);
  }

  #moods-section .mood-skeleton-block--secondary {
    display: none;
    width: var(--line-2, 42%);
  }

  #moods-section .mood-skeleton-lines[data-line-count="2"] .mood-skeleton-block--secondary {
    display: block;
  }

  #moods-section .mood-skeleton-time {
    width: 32px;
    height: 10px;
    border-radius: 4px;
  }

  /* Empty and error states */
  #moods-section .mood-empty-state,
  #moods-section .mood-error-state {
    font-size: 14px;
    color: hsl(var(--muted-foreground));
    padding: 16px 0;
    margin-left: 76px;
  }

  @media (min-width: 640px) {
    #moods-section .mood-empty-state,
    #moods-section .mood-error-state {
      margin-left: 84px;
    }
  }

  @keyframes mood-skeleton-shimmer {
    0% {
      background-position: 200% 50%;
      opacity: 0.45;
    }
    100% {
      background-position: 0% 50%;
      opacity: 0.85;
    }
  }

  @keyframes mood-skeleton-sheen {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(140%);
    }
  }

  @keyframes mood-skeleton-flow {
    0% {
      transform: translateY(-60%);
      opacity: 0;
    }
    40% {
      opacity: 0.5;
    }
    100% {
      transform: translateY(120%);
      opacity: 0;
    }
  }

  @keyframes mood-skeleton-pulse {
    0% {
      transform: scale(0.85);
      opacity: 0.25;
    }
    70% {
      transform: scale(1.3);
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #moods-section .mood-item-skeleton .mood-skeleton-block,
    #moods-section .mood-item-skeleton .mood-skeleton-time {
      animation: none;
    }

    #moods-section .mood-item-skeleton .mood-line::after,
    #moods-section .mood-item-skeleton .mood-dot::after,
    #moods-section .mood-item-skeleton .mood-card-skeleton::before {
      display: none;
    }

    #moods-section .mood-item:first-child:not(.mood-item-skeleton) .mood-dot::before {
      animation: none;
    }
  }
</style>

<script>
  // GSAP is dynamically imported to avoid blocking initial render
  const initMoodsAnimation = async () => {
    const moodsSection = document.getElementById('moods-section');
    if (!moodsSection) return;

    const list = moodsSection.querySelector('[data-mood-list]') as HTMLElement | null;
    const emptyState = moodsSection.querySelector('[data-mood-empty]') as HTMLElement | null;
    const errorState = moodsSection.querySelector('[data-mood-error]') as HTMLElement | null;
    const label = moodsSection.querySelector('.scroll-reveal');
    const link = moodsSection.querySelector('.scroll-reveal-link');
    let gsap!: (typeof import('gsap'))['default'];
    let ScrollTrigger!: (typeof import('gsap/ScrollTrigger'))['ScrollTrigger'];
    let hasLoaded = false;

    const MAX_MOODS = 5;
    const ALWAYS_LOADING = import.meta.env.PUBLIC_DEBUG_ALWAYS_LOADING === 'true';

    const formatTime = (value: string): string => {
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return '';

      const now = new Date();
      const isToday =
        date.getFullYear() === now.getFullYear() &&
        date.getMonth() === now.getMonth() &&
        date.getDate() === now.getDate();

      if (isToday) {
        const hours = String(date.getHours()).padStart(2, '0');
        const minutes = String(date.getMinutes()).padStart(2, '0');
        return `${hours}:${minutes}`;
      }

      const months = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
      const monthName = months[date.getMonth()];
      const day = String(date.getDate()).padStart(2, '0');

      return `${monthName} ${day}`;
    };

    const isSafeEmojiImageSrc = (value: string): boolean => {
      if (!value) return false;
      if (/^https?:\/\//i.test(value)) return true;
      return /^[/?]/.test(value);
    };

    const linkifyText = (value: string): DocumentFragment => {
      const fragment = document.createDocumentFragment();
      if (!value) return fragment;

      const urlPattern = /https?:\/\/[^\s]+/g;
      let lastIndex = 0;
      let match: RegExpExecArray | null;

      while ((match = urlPattern.exec(value)) !== null) {
        const matchText = match[0];
        const start = match.index;

        if (start > lastIndex) {
          fragment.appendChild(document.createTextNode(value.slice(lastIndex, start)));
        }

        let url = matchText;
        let trailing = '';
        while (/[)\].,!?:;]+$/.test(url)) {
          trailing = url.slice(-1) + trailing;
          url = url.slice(0, -1);
        }

        const anchor = document.createElement('a');
        anchor.href = url;
        anchor.textContent = url;
        anchor.target = '_blank';
        anchor.rel = 'noopener noreferrer';
        fragment.appendChild(anchor);

        if (trailing) {
          fragment.appendChild(document.createTextNode(trailing));
        }

        lastIndex = start + matchText.length;
      }

      if (lastIndex < value.length) {
        fragment.appendChild(document.createTextNode(value.slice(lastIndex)));
      }

      return fragment;
    };

    const linkifyHtml = (value: string): DocumentFragment => {
      const fragment = document.createDocumentFragment();
      if (!value) return fragment;

      const template = document.createElement('template');
      template.innerHTML = value;

      const appendNode = (node: ChildNode, target: DocumentFragment | HTMLElement): void => {
        if (node.nodeType === Node.TEXT_NODE) {
          target.appendChild(linkifyText(node.textContent ?? ''));
          return;
        }
        if (node.nodeType !== Node.ELEMENT_NODE) return;

        const element = node as HTMLElement;
        const tag = element.tagName.toLowerCase();
        if (tag === 'script' || tag === 'style') {
          return;
        }

        if (tag === 'a') {
          const anchor = document.createElement('a');
          const href = element.getAttribute('href') ?? '';
          anchor.textContent = element.textContent ?? '';
          if (href) {
            anchor.href = href;
            if (/^https?:\/\//i.test(href)) {
              anchor.target = '_blank';
              anchor.rel = 'noopener noreferrer';
            }
          }
          target.appendChild(anchor);
          return;
        }

        if (tag === 'span') {
          const className = element.getAttribute('class') ?? '';
          if (/\b(tg-emoji|mood-reaction-emoji)\b/.test(className)) {
            const emoji = document.createElement('span');
            emoji.className = 'tg-emoji';
            emoji.style.display = 'inline-flex';
            emoji.style.alignItems = 'center';
            emoji.style.justifyContent = 'center';
            emoji.style.width = '1.15em';
            emoji.style.height = '1.15em';
            emoji.style.verticalAlign = '-0.15em';

            const emojiId = element.getAttribute('data-emoji-id');
            if (emojiId) {
              emoji.dataset.emojiId = emojiId;
            }

            const animated = element.getAttribute('data-emoji-animated');
            if (animated === 'true' || animated === 'false') {
              emoji.dataset.emojiAnimated = animated;
            }

            const ariaLabel = element.getAttribute('aria-label');
            if (ariaLabel) {
              emoji.setAttribute('aria-label', ariaLabel);
            }

            element.childNodes.forEach((child) => appendNode(child, emoji));
            target.appendChild(emoji);
            return;
          }
        }

        if (tag === 'img') {
          const src = (element.getAttribute('src') ?? '').trim();
          if (!src) return;

          const isEmojiImage = Boolean(element.closest('.tg-emoji, .mood-reaction-emoji'))
            || src.toLowerCase().includes('/i/emoji/');
          if (!isEmojiImage || !isSafeEmojiImageSrc(src)) {
            return;
          }

          const image = document.createElement('img');
          image.src = src;
          image.alt = element.getAttribute('alt') ?? '';
          image.loading = 'lazy';
          image.decoding = 'async';
          image.style.width = '100%';
          image.style.height = '100%';
          image.style.display = 'block';
          if (element.classList.contains('tg-emoji-fallback')) {
            image.className = 'tg-emoji-fallback';
          }
          target.appendChild(image);
          return;
        }

        if (tag === 'br') {
          target.appendChild(document.createElement('br'));
          return;
        }

        element.childNodes.forEach((child) => appendNode(child, target));
      };

      template.content.childNodes.forEach((child) => appendNode(child, fragment));
      return fragment;
    };

    const buildPreviewFragment = (previewText: string, previewHtml?: string): DocumentFragment => {
      const html = typeof previewHtml === 'string' ? previewHtml.trim() : '';
      if (html) {
        return linkifyHtml(html);
      }
      return linkifyText(previewText);
    };

    interface MoodData {
      id: string;
      datetime: string;
      tag?: string;
      previewText: string;
      previewHtml?: string;
      image?: string | null;
      imageFallback?: string | null;
      mediaHtml?: string;
      needsDetailPage?: boolean;
    }

    interface MoodReservation {
      lineCount: number;
      lineWidths: string[];
      textHeight: number;
      reservedHeight: number;
    }

    interface TextMeasurementConfig {
      font: string;
      lineHeight: number;
      textWidth: number;
      cardPaddingY: number;
      metaGap: number;
      tagHeight: number;
      thumbnailHeight: number;
    }

    type PretextModule = typeof import('@chenglou/pretext');

    const MAX_PREVIEW_LINES = 2;
    const MOOD_PREVIEW_CACHE_KEY = 'home-moods-preview-cache:v2';
    const MOOD_PREVIEW_CACHE_TTL_MS = 1000 * 60 * 30;
    const PRETEXT_FONT_TIMEOUT_MS = 900;
    const PRETEXT_THUMBNAIL_HEIGHT = 48;
    const PRETEXT_META_GAP = 6;
    const HOME_THUMBNAIL_WIDTH = 480;
    const reservedCards = new Set<HTMLElement>();
    let pretextModulePromise: Promise<PretextModule | null> | null = null;
    let renderedMoodSignature = '';

    interface MoodPreviewCacheEntry {
      id: string;
      datetime: string;
      tag?: string;
      previewText: string;
      previewHtml?: string;
      image?: string | null;
      imageFallback?: string | null;
    }

    interface MoodPreviewCache {
      updatedAt: number;
      posts: MoodPreviewCacheEntry[];
    }

    const clearCardReservations = (): void => {
      reservedCards.forEach((card) => {
        card.style.removeProperty('--reserved-card-height');
        card.removeAttribute('data-reserved-lines');
        card.removeAttribute('data-reserved');

        const text = card.querySelector('.mood-text') as HTMLElement | null;
        if (text) {
          text.style.removeProperty('--reserved-text-height');
          text.removeAttribute('data-reserved-lines');
        }
      });
      reservedCards.clear();
    };

    const debugPretextFallback = (reason: string, error?: unknown): void => {
      if (!import.meta.env.DEV) return;
      console.debug('[moods-pretext] Falling back to baseline skeletons:', reason, error);
    };

    const sanitizeCachedMood = (value: unknown): MoodPreviewCacheEntry | null => {
      if (!value || typeof value !== 'object') return null;

      const candidate = value as Partial<MoodPreviewCacheEntry>;
      if (typeof candidate.id !== 'string' || typeof candidate.datetime !== 'string') {
        return null;
      }

      return {
        id: candidate.id,
        datetime: candidate.datetime,
        tag: typeof candidate.tag === 'string' ? candidate.tag : undefined,
        previewText: typeof candidate.previewText === 'string' ? candidate.previewText : '',
        previewHtml: typeof candidate.previewHtml === 'string' ? candidate.previewHtml : '',
        image: typeof candidate.image === 'string' ? candidate.image : null,
        imageFallback: typeof candidate.imageFallback === 'string' ? candidate.imageFallback : null,
      };
    };

    const readCachedPreviewPosts = (): MoodPreviewCacheEntry[] => {
      try {
        const raw = window.localStorage.getItem(MOOD_PREVIEW_CACHE_KEY);
        if (!raw) return [];

        const parsed = JSON.parse(raw) as Partial<MoodPreviewCache>;
        if (!parsed || typeof parsed.updatedAt !== 'number' || !Array.isArray(parsed.posts)) {
          return [];
        }

        if (Date.now() - parsed.updatedAt > MOOD_PREVIEW_CACHE_TTL_MS) {
          window.localStorage.removeItem(MOOD_PREVIEW_CACHE_KEY);
          return [];
        }

        return parsed.posts
          .map((post) => sanitizeCachedMood(post))
          .filter((post): post is MoodPreviewCacheEntry => post !== null)
          .slice(0, MAX_MOODS);
      } catch (error) {
        debugPretextFallback('cache read failed', error);
        return [];
      }
    };

    const writeCachedPreviewPosts = (posts: MoodData[]): void => {
      try {
        const payload: MoodPreviewCache = {
          updatedAt: Date.now(),
          posts: posts.slice(0, MAX_MOODS).map((post) => ({
            id: post.id,
            datetime: post.datetime,
            tag: post.tag,
            previewText: typeof post.previewText === 'string' ? post.previewText : '',
            previewHtml: typeof post.previewHtml === 'string' ? post.previewHtml : '',
            image: typeof post.image === 'string' ? post.image : null,
            imageFallback: typeof post.imageFallback === 'string' ? post.imageFallback : null,
          })),
        };

        window.localStorage.setItem(MOOD_PREVIEW_CACHE_KEY, JSON.stringify(payload));
      } catch (error) {
        debugPretextFallback('cache write failed', error);
      }
    };

    const createMoodSignature = (
      posts: Array<MoodData | MoodPreviewCacheEntry>,
    ): string => JSON.stringify(
      posts.map((post) => ({
        id: post.id,
        datetime: post.datetime,
        tag: post.tag ?? '',
        previewText: post.previewText ?? '',
        previewHtml: post.previewHtml ?? '',
        image: post.image ?? '',
        imageFallback: post.imageFallback ?? '',
      })),
    );

    const removeFailedThumbnail = (thumbnail: HTMLElement): void => {
      const meta = thumbnail.parentElement;
      thumbnail.remove();
      if (meta && meta.childElementCount === 0) {
        meta.remove();
      }
    };

    const withWidthParam = (value: string, width: number): string => {
      if (!value || /^(data:|blob:)/i.test(value)) return value;
      const isAbsolute = /^(https?:)?\/\//i.test(value);
      const parsed = new URL(value, window.location.origin);
      parsed.searchParams.set('w', String(width));
      if (isAbsolute) return parsed.toString();
      return `${parsed.pathname}${parsed.search}${parsed.hash}`;
    };

    const loadPretextModule = async (): Promise<PretextModule | null> => {
      if (!pretextModulePromise) {
        pretextModulePromise = import('@chenglou/pretext').catch((error) => {
          debugPretextFallback('module import failed', error);
          return null;
        });
      }

      return pretextModulePromise;
    };

    const buildCanvasFontShorthand = (styles: CSSStyleDeclaration): string | null => {
      const fontSize = styles.fontSize?.trim();
      const fontFamily = styles.fontFamily?.trim();
      if (!fontSize || !fontFamily) return null;

      const fontStyle = styles.fontStyle && styles.fontStyle !== 'normal' ? `${styles.fontStyle} ` : '';
      const fontWeight = styles.fontWeight && styles.fontWeight !== 'normal' ? `${styles.fontWeight} ` : '';

      return `${fontStyle}${fontWeight}${fontSize} ${fontFamily}`.trim();
    };

    const readTextMeasurementConfig = (): TextMeasurementConfig | null => {
      if (!list) return null;

      const skeletonCard = list.querySelector('.mood-card-skeleton') as HTMLElement | null;
      if (!skeletonCard) return null;

      const host = document.createElement('div');
      host.setAttribute('aria-hidden', 'true');
      host.style.cssText = [
        'position:absolute',
        'left:-9999px',
        'top:0',
        'visibility:hidden',
        'pointer-events:none',
        'contain:layout style',
      ].join(';');

      const textProbe = document.createElement('span');
      textProbe.className = 'mood-text';
      textProbe.textContent = 'Measurement probe';

      const tagProbe = document.createElement('span');
      tagProbe.className = 'mood-tag';
      tagProbe.textContent = '#probe';

      host.appendChild(textProbe);
      host.appendChild(tagProbe);
      document.body.appendChild(host);

      const cardStyles = window.getComputedStyle(skeletonCard);
      const textStyles = window.getComputedStyle(textProbe);
      const textWidth =
        skeletonCard.clientWidth
        - Number.parseFloat(cardStyles.paddingLeft || '0')
        - Number.parseFloat(cardStyles.paddingRight || '0');
      const lineHeight = Number.parseFloat(textStyles.lineHeight || '0');
      const cardPaddingY =
        Number.parseFloat(cardStyles.paddingTop || '0')
        + Number.parseFloat(cardStyles.paddingBottom || '0');
      const tagHeight = Math.ceil(tagProbe.getBoundingClientRect().height);
      const font = buildCanvasFontShorthand(textStyles);

      host.remove();

      if (!font || !Number.isFinite(textWidth) || textWidth <= 0 || !Number.isFinite(lineHeight) || lineHeight <= 0) {
        return null;
      }

      return {
        font,
        lineHeight,
        textWidth,
        cardPaddingY,
        metaGap: PRETEXT_META_GAP,
        tagHeight,
        thumbnailHeight: PRETEXT_THUMBNAIL_HEIGHT,
      };
    };

    const waitForFontReady = async (font: string): Promise<boolean> => {
      if (!('fonts' in document) || typeof document.fonts.load !== 'function') {
        return true;
      }

      const timeout = new Promise<boolean>((resolve) => {
        window.setTimeout(() => resolve(false), PRETEXT_FONT_TIMEOUT_MS);
      });

      const loaded = Promise.all([
        document.fonts.load(font, 'Bunizao'),
        document.fonts.load(font, 'MMMM 88'),
        document.fonts.ready,
      ])
        .then(() => true)
        .catch((error) => {
          debugPretextFallback('font sync failed', error);
          return false;
        });

      return Promise.race([loaded, timeout]);
    };

    const formatReservationWidth = (width: number, maxWidth: number): string => {
      if (!Number.isFinite(width) || width <= 0 || !Number.isFinite(maxWidth) || maxWidth <= 0) {
        return '70%';
      }

      const percentage = Math.max(18, Math.min(100, (width / maxWidth) * 100));
      return `${percentage.toFixed(2)}%`;
    };

    const measureMoodReservation = (
      mood: MoodData,
      config: TextMeasurementConfig,
      pretext: PretextModule,
    ): MoodReservation | null => {
      const previewText = (mood.previewText ?? '').trim();
      if (!previewText) {
        return null;
      }

      const prepared = pretext.prepareWithSegments(previewText, config.font);
      const result = pretext.layoutWithLines(prepared, config.textWidth, config.lineHeight);
      const visibleLines = result.lines.slice(0, MAX_PREVIEW_LINES);
      const lineCount = Math.max(1, Math.min(MAX_PREVIEW_LINES, visibleLines.length || result.lineCount || 1));
      const lineWidths = Array.from({ length: lineCount }, (_, index) => {
        const line = visibleLines[index];
        return formatReservationWidth(line?.width ?? config.textWidth * 0.7, config.textWidth);
      });
      const textHeight = Math.ceil(config.lineHeight * lineCount);
      const metaHeight = mood.image
        ? config.thumbnailHeight
        : mood.tag
          ? config.tagHeight
          : 0;
      const reservedHeight = Math.ceil(
        config.cardPaddingY
        + textHeight
        + (metaHeight > 0 ? config.metaGap + metaHeight : 0)
      );

      return {
        lineCount,
        lineWidths,
        textHeight,
        reservedHeight,
      };
    };

    const measureMoodReservations = async (posts: MoodData[]): Promise<Array<MoodReservation | null>> => {
      if (!posts.length) {
        return [];
      }

      const [pretext, config] = await Promise.all([loadPretextModule(), Promise.resolve(readTextMeasurementConfig())]);
      if (!pretext || !config) {
        return posts.map(() => null);
      }

      const fontReady = await waitForFontReady(config.font);
      if (!fontReady) {
        debugPretextFallback('font load timeout');
        return posts.map(() => null);
      }

      try {
        return posts.map((post) => measureMoodReservation(post, config, pretext));
      } catch (error) {
        debugPretextFallback('layout measurement failed', error);
        return posts.map(() => null);
      }
    };

    const applyReservationToSkeleton = (
      item: Element,
      reservation: MoodReservation | null,
    ): void => {
      const card = item.querySelector('.mood-card-skeleton') as HTMLElement | null;
      const lines = item.querySelector('[data-skeleton-lines]') as HTMLElement | null;
      if (!card || !lines || !reservation) return;

      card.style.setProperty('--reserved-card-height', `${reservation.reservedHeight}px`);
      lines.dataset.lineCount = String(reservation.lineCount);
      lines.style.setProperty('--line-1', reservation.lineWidths[0] ?? '70%');
      lines.style.setProperty('--line-2', reservation.lineWidths[1] ?? '42%');
    };

    const setVisibleSkeletonCount = (count: number | null): void => {
      if (!list) return;

      const skeletons = Array.from(list.querySelectorAll('.mood-item-skeleton'));
      skeletons.forEach((skeleton, index) => {
        (skeleton as HTMLElement).hidden = count !== null && index >= count;
      });
    };

    const applyReservationsToSkeletons = (reservations: Array<MoodReservation | null>): void => {
      if (!list || !reservations.length) return;

      const skeletons = Array.from(list.querySelectorAll('.mood-item-skeleton'));
      reservations.forEach((reservation, index) => {
        const skeleton = skeletons[index];
        if (!skeleton) return;
        applyReservationToSkeleton(skeleton, reservation);
      });
    };

    const primeSkeletonsFromCache = async (): Promise<void> => {
      const cachedPosts = readCachedPreviewPosts();
      if (!cachedPosts.length) {
        setVisibleSkeletonCount(null);
        return;
      }

      renderedMoodSignature = createMoodSignature(cachedPosts);
      const reservations = await measureMoodReservations(cachedPosts);
      renderMoods(cachedPosts as MoodData[], reservations, {
        animate: false,
        preserveBusy: true,
      });
    };

    const applyReservationToCard = (
      card: HTMLElement,
      text: HTMLElement | null,
      reservation: MoodReservation | null,
    ): void => {
      if (!reservation) return;

      card.dataset.reserved = 'true';
      card.dataset.reservedLines = String(reservation.lineCount);
      card.style.setProperty('--reserved-card-height', `${reservation.reservedHeight}px`);
      reservedCards.add(card);

      if (text) {
        text.dataset.reservedLines = String(reservation.lineCount);
        text.style.setProperty('--reserved-text-height', `${reservation.textHeight}px`);
      }
    };

    const createMoodItem = (
      mood: MoodData,
      index: number,
      reservation: MoodReservation | null,
    ): HTMLElement => {
      const item = document.createElement('div');
      item.className = 'mood-item mood-item--clickable';
      item.dataset.href = `/mood/${mood.id}`;
      item.setAttribute('role', 'link');
      item.tabIndex = 0;
      item.style.cssText = `--item-index: ${index}`;

      const timeCol = document.createElement('div');
      timeCol.className = 'mood-time-col';
      const time = document.createElement('time');
      time.className = 'mood-time';
      time.dateTime = mood.datetime;
      time.textContent = formatTime(mood.datetime);
      timeCol.appendChild(time);

      const lineCol = document.createElement('div');
      lineCol.className = 'mood-line-col';
      const dot = document.createElement('div');
      dot.className = 'mood-dot';
      const line = document.createElement('div');
      line.className = 'mood-line';
      lineCol.appendChild(dot);
      lineCol.appendChild(line);

      const contentCol = document.createElement('div');
      contentCol.className = 'mood-content-col';
      const card = document.createElement('div');
      card.className = 'mood-card';

      const text = document.createElement('span');
      text.className = 'mood-text';
      const previewText = mood.previewText || '';
      const previewHtml = mood.previewHtml || '';
      const hasText = previewText.trim().length > 0 || previewHtml.trim().length > 0;
      if (hasText || !mood.image) {
        if (hasText) {
          text.appendChild(buildPreviewFragment(previewText, previewHtml));
        } else {
          text.textContent = '(No text)';
        }
        card.appendChild(text);
      }

      const hasMetaContent = mood.tag || mood.image;
      if (hasMetaContent) {
        const meta = document.createElement('div');
        meta.className = 'mood-meta';

        if (mood.tag) {
          const tag = document.createElement('span');
          tag.className = 'mood-tag';
          tag.textContent = `#${mood.tag}`;
          meta.appendChild(tag);
        }

        if (mood.image) {
          const thumbnail = document.createElement('div');
          thumbnail.className = 'mood-thumbnail';
          const img = document.createElement('img');
          img.src = withWidthParam(mood.image, HOME_THUMBNAIL_WIDTH);
          const fallback = typeof mood.imageFallback === 'string' ? mood.imageFallback.trim() : '';
          if (fallback) {
            img.dataset.fallbackSrc = withWidthParam(fallback, HOME_THUMBNAIL_WIDTH);
          }
          img.onerror = () => {
            if (img.dataset.fallbackApplied !== '1') {
              const fallbackSrc = img.dataset.fallbackSrc || '';
              if (fallbackSrc) {
                img.dataset.fallbackApplied = '1';
                img.src = fallbackSrc;
                return;
              }
            }

            removeFailedThumbnail(thumbnail);
          };
          img.alt = '';
          img.loading = 'lazy';
          thumbnail.appendChild(img);
          meta.appendChild(thumbnail);
        }

        card.appendChild(meta);
      }

      applyReservationToCard(card, card.querySelector('.mood-text') as HTMLElement | null, reservation);

      contentCol.appendChild(card);

      item.appendChild(timeCol);
      item.appendChild(lineCol);
      item.appendChild(contentCol);

      return item;
    };

    const renderMoods = (
      posts: MoodData[],
      reservations: Array<MoodReservation | null>,
      options: { animate?: boolean; preserveBusy?: boolean } = {},
    ): void => {
      if (!list) return;

      const { animate = true, preserveBusy = false } = options;
      if (!preserveBusy) {
        list.removeAttribute('aria-busy');
      }

      const showContent = () => {
        if (errorState) errorState.hidden = true;

        if (!posts.length) {
          if (emptyState) emptyState.hidden = false;
          return;
        }

        if (emptyState) emptyState.hidden = true;

        // Create items and animate in
        const items: HTMLElement[] = [];
        posts.forEach((post, index) => {
          const item = createMoodItem(post, index, reservations[index] ?? null);
          list.appendChild(item);
          items.push(item);
        });

        if (animate) {
          // Liquid splash-in animation
          gsap.fromTo(items,
            {
              opacity: 0,
              y: 24,
              scale: 0.88,
              filter: 'blur(8px)',
              rotationX: -15
            },
            {
              opacity: 1,
              y: 0,
              scale: 1,
              filter: 'blur(0px)',
              rotationX: 0,
              duration: 0.7,
              ease: 'expo.out',
              stagger: 0.09
            }
          );
        }
      };

      // Liquid dissolve effect on skeleton items
      const skeletons = list.querySelectorAll('.mood-item-skeleton');
      if (animate && skeletons.length > 0) {
        gsap.to(skeletons, {
          opacity: 0,
          scale: 0.92,
          y: -12,
          filter: 'blur(6px)',
          duration: 0.5,
          ease: 'power2.in',
          stagger: 0.06,
          onComplete: () => {
            list.replaceChildren();
            showContent();
          }
        });
      } else {
        list.replaceChildren();
        showContent();
      }
    };

    const loadMoods = async (): Promise<void> => {
      if (ALWAYS_LOADING || hasLoaded || !list) return;
      hasLoaded = true;

      try {
        const response = await fetch('/api/moods');
        if (!response.ok) {
          throw new Error('Failed to fetch moods.');
        }
        const data = await response.json() as { posts?: unknown[] };
        const posts = Array.isArray(data.posts) ? (data.posts.slice(0, MAX_MOODS) as MoodData[]) : [];
        writeCachedPreviewPosts(posts);
        const nextSignature = createMoodSignature(posts);
        const hasRenderedCards = Boolean(list.querySelector('.mood-card:not(.mood-card-skeleton)'));
        if (renderedMoodSignature && renderedMoodSignature === nextSignature && hasRenderedCards) {
          list.removeAttribute('aria-busy');
          if (emptyState) emptyState.hidden = true;
          if (errorState) errorState.hidden = true;
          return;
        }

        setVisibleSkeletonCount(posts.length);
        const reservations = await measureMoodReservations(posts);
        applyReservationsToSkeletons(reservations);
        renderMoods(posts, reservations, {
          animate: !hasRenderedCards,
        });
        renderedMoodSignature = nextSignature;
      } catch (error) {
        console.error('Failed to fetch moods:', error);
        if (list) {
          list.removeAttribute('aria-busy');
          list.replaceChildren();
        }
        if (emptyState) emptyState.hidden = true;
        if (errorState) errorState.hidden = false;
      }
    };

    const navigateToMood = (target: HTMLElement | null): void => {
      if (!target || target.closest('a')) return;
      const item = target.closest('.mood-item--clickable') as HTMLElement | null;
      if (!item) return;
      const href = item.dataset.href;
      if (href) {
        window.location.href = href;
      }
    };

    if (list) {
      window.addEventListener('resize', clearCardReservations, { passive: true });

      list.addEventListener('click', (event) => {
        navigateToMood(event.target as HTMLElement | null);
      });

      list.addEventListener('keydown', (event) => {
        const keyEvent = event as KeyboardEvent;
        if (keyEvent.key !== 'Enter' && keyEvent.key !== ' ') return;
        const target = event.target as HTMLElement | null;
        if (!target || target.closest('a')) return;
        event.preventDefault();
        navigateToMood(target);
      });
    }

    const initMoods = () => {
      if (ALWAYS_LOADING) {
        gsap.set(moodsSection, { opacity: 1, y: 0 });
        if (label) gsap.set(label, { opacity: 1, y: 0 });
        if (link) gsap.set(link, { opacity: 1 });
      } else {
        // Set initial states with GSAP
        gsap.set(moodsSection, { opacity: 0, y: 40 });
        if (label) gsap.set(label, { opacity: 0, y: 16 });
        if (link) gsap.set(link, { opacity: 0 });
      }

      // Create GSAP timeline with ScrollTrigger
      void primeSkeletonsFromCache();

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: moodsSection,
          start: 'top 85%',
          once: true,
          onEnter: () => {
            void loadMoods();
          }
        }
      });

      tl.to(moodsSection, {
        opacity: 1,
        y: 0,
        duration: 0.6,
        ease: 'power2.out'
      })
      .to(label, {
        opacity: 1,
        y: 0,
        duration: 0.4,
        ease: 'power2.out'
      }, '-=0.3')
      .to(link, {
        opacity: 1,
        duration: 0.4,
        ease: 'power2.out'
      }, '+=0.3');
    };

    await primeSkeletonsFromCache();

    // Dynamic import GSAP only when needed after the cache prepass has had a chance to render.
    [{ default: gsap }, { ScrollTrigger }] = await Promise.all([
      import('gsap'),
      import('gsap/ScrollTrigger')
    ]);

    gsap.registerPlugin(ScrollTrigger);
    void initMoods();
  };

  // Initialize when DOM is ready
  void initMoodsAnimation();
</script>
