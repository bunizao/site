---
const SKELETON_COUNT = 5;
const placeholders = Array.from({ length: SKELETON_COUNT });
---

<section id="moods-section" class="moods-section">
  <span class="section-label scroll-reveal">Moods</span>

  <div class="mood-timeline" data-mood-list aria-busy="true" aria-label="Recent moods">
    {placeholders.map((_, index) => (
      <div class="mood-item mood-item-skeleton scroll-reveal-item" style={`--item-index: ${index}`}>
        <div class="mood-dot"></div>
        <div class="mood-content">
          <span class="mood-skeleton-text"></span>
          <span class="mood-skeleton-text mood-skeleton-text--short"></span>
        </div>
        <div class="mood-time">
          <span class="mood-skeleton-time"></span>
        </div>
      </div>
    ))}
  </div>

  <p class="mood-empty-state" data-mood-empty hidden>No moods yet.</p>
  <p class="mood-error-state" data-mood-error hidden>Unable to load moods.</p>

  <a
    href="/mood"
    class="link scroll-reveal-link mt-6 text-sm text-muted-foreground"
    aria-label="View all moods"
  >
    View all moods
  </a>
</section>

<style is:global>
  #moods-section {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  #moods-section.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  #moods-section .scroll-reveal {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.4s ease-out, transform 0.4s ease-out;
  }

  #moods-section.is-visible .scroll-reveal {
    opacity: 1;
    transform: translateY(0);
  }

  #moods-section .scroll-reveal-item {
    opacity: 0;
    transform: translateX(-10px);
    transition: opacity 0.4s ease-out, transform 0.4s ease-out;
  }

  #moods-section.is-visible .scroll-reveal-item {
    opacity: 1;
    transform: translateX(0);
    transition-delay: calc(var(--item-index) * 0.06s + 0.1s);
  }

  #moods-section .scroll-reveal-link {
    opacity: 0;
    transition: opacity 0.4s ease-out;
  }

  #moods-section.is-visible .scroll-reveal-link {
    opacity: 1;
    transition-delay: 0.4s;
  }

  /* Timeline Layout */
  #moods-section .mood-timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0;
    padding-left: 16px;
  }

  /* Timeline vertical line */
  #moods-section .mood-timeline::before {
    content: '';
    position: absolute;
    left: 3px;
    top: 8px;
    bottom: 8px;
    width: 1px;
    background: linear-gradient(
      to bottom,
      hsl(var(--foreground) / 0.15),
      hsl(var(--foreground) / 0.08)
    );
  }

  #moods-section .mood-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 10px 0;
    position: relative;
    text-decoration: none;
    color: inherit;
    transition: all 0.15s ease;
  }

  #moods-section .mood-item:not(.mood-item-skeleton):hover {
    padding-left: 4px;
  }

  /* Timeline dot */
  #moods-section .mood-dot {
    position: absolute;
    left: -16px;
    top: 14px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: hsl(var(--foreground) / 0.2);
    border: 2px solid hsl(var(--background));
    box-shadow: 0 0 0 1px hsl(var(--foreground) / 0.1);
    transition: all 0.2s ease;
    z-index: 1;
  }

  #moods-section .mood-item:not(.mood-item-skeleton):hover .mood-dot {
    background: hsl(var(--foreground) / 0.5);
    transform: scale(1.2);
  }

  #moods-section .mood-content {
    flex: 1;
    min-width: 0;
  }

  #moods-section .mood-text {
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
    color: hsl(var(--foreground) / 0.9);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  #moods-section .mood-tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 400;
    color: hsl(var(--muted-foreground) / 0.6);
    margin-top: 4px;
  }

  #moods-section .mood-time {
    flex-shrink: 0;
    font-size: 11px;
    font-weight: 400;
    color: hsl(var(--muted-foreground) / 0.5);
    font-variant-numeric: tabular-nums;
    padding-top: 2px;
  }

  @media (min-width: 640px) {
    #moods-section .mood-time {
      font-size: 12px;
    }
  }

  #moods-section .mood-item:hover .mood-time {
    color: hsl(var(--muted-foreground) / 0.8);
  }

  /* Skeleton Styles */
  #moods-section .mood-item-skeleton {
    pointer-events: none;
  }

  #moods-section .mood-item-skeleton .mood-dot {
    background: hsl(var(--foreground) / 0.08);
    box-shadow: none;
  }

  #moods-section .mood-skeleton-text,
  #moods-section .mood-skeleton-time {
    display: block;
    border-radius: 4px;
    background: linear-gradient(90deg, hsl(var(--foreground) / 0.05), hsl(var(--foreground) / 0.12), hsl(var(--foreground) / 0.05));
    background-size: 200% 100%;
    animation: moods-shimmer 1.6s ease-in-out infinite;
  }

  #moods-section .mood-skeleton-text {
    height: 14px;
    width: 100%;
    margin-bottom: 6px;
  }

  #moods-section .mood-skeleton-text--short {
    width: 50%;
    margin-bottom: 0;
  }

  #moods-section .mood-skeleton-time {
    width: 40px;
    height: 14px;
  }

  /* Empty and error states */
  #moods-section .mood-empty-state,
  #moods-section .mood-error-state {
    font-size: 14px;
    color: hsl(var(--muted-foreground));
    padding: 12px 0 12px 16px;
  }

  @keyframes moods-shimmer {
    0% {
      background-position: 200% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }
</style>

<script>
  const moodsSection = document.getElementById('moods-section');

  if (moodsSection) {
    const list = moodsSection.querySelector('[data-mood-list]') as HTMLElement | null;
    const emptyState = moodsSection.querySelector('[data-mood-empty]') as HTMLElement | null;
    const errorState = moodsSection.querySelector('[data-mood-error]') as HTMLElement | null;
    let hasLoaded = false;

    const MAX_MOODS = 5;

    const formatTime = (value: string): string => {
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return '';

      const now = new Date();
      const isToday =
        date.getFullYear() === now.getFullYear() &&
        date.getMonth() === now.getMonth() &&
        date.getDate() === now.getDate();

      // If today, show time like 14:30
      if (isToday) {
        const hours = String(date.getHours()).padStart(2, '0');
        const minutes = String(date.getMinutes()).padStart(2, '0');
        return `${hours}:${minutes}`;
      }

      const yesterday = new Date(now);
      yesterday.setDate(yesterday.getDate() - 1);
      const isYesterday =
        date.getFullYear() === yesterday.getFullYear() &&
        date.getMonth() === yesterday.getMonth() &&
        date.getDate() === yesterday.getDate();

      if (isYesterday) return 'Yesterday';

      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, '0');
      const day = String(date.getDate()).padStart(2, '0');

      if (year === now.getFullYear()) {
        return `${month}-${day}`;
      }
      return `${year}-${month}`;
    };

    interface MoodData {
      id: string;
      datetime: string;
      tag?: string;
      previewText: string;
      image?: string | null;
      mediaHtml?: string;
      needsDetailPage?: boolean;
    }

    const createMoodItem = (mood: MoodData, index: number): HTMLElement => {
      const link = document.createElement('a');
      link.href = `/mood/${mood.id}`;
      link.className = 'mood-item';
      link.style.cssText = `--item-index: ${index}; opacity: 0; transform: translateX(-10px);`;

      // Dot
      const dot = document.createElement('div');
      dot.className = 'mood-dot';

      // Content
      const content = document.createElement('div');
      content.className = 'mood-content';

      const text = document.createElement('span');
      text.className = 'mood-text';
      text.textContent = mood.previewText || '(No text)';
      content.appendChild(text);

      if (mood.tag) {
        const tag = document.createElement('span');
        tag.className = 'mood-tag';
        tag.textContent = `#${mood.tag}`;
        content.appendChild(tag);
      }

      // Time
      const time = document.createElement('time');
      time.className = 'mood-time';
      time.dateTime = mood.datetime;
      time.textContent = formatTime(mood.datetime);

      link.appendChild(dot);
      link.appendChild(content);
      link.appendChild(time);

      // Animate in
      requestAnimationFrame(() => {
        setTimeout(() => {
          link.style.transition = 'opacity 0.4s ease-out, transform 0.4s ease-out, padding 0.15s ease';
          link.style.opacity = '1';
          link.style.transform = 'translateX(0)';
        }, index * 60 + 100);
      });

      return link;
    };

    const renderMoods = (posts: MoodData[]): void => {
      if (!list) return;

      list.removeAttribute('aria-busy');
      list.replaceChildren();

      if (errorState) errorState.hidden = true;

      if (!posts.length) {
        if (emptyState) emptyState.hidden = false;
        return;
      }

      if (emptyState) emptyState.hidden = true;
      posts.forEach((post, index) => list.appendChild(createMoodItem(post, index)));
    };

    const loadMoods = async (): Promise<void> => {
      if (hasLoaded || !list) return;
      hasLoaded = true;

      try {
        const response = await fetch('/api/moods');
        if (!response.ok) {
          throw new Error('Failed to fetch moods.');
        }
        const data = await response.json();
        const posts = Array.isArray(data.posts) ? data.posts.slice(0, MAX_MOODS) : [];
        renderMoods(posts);
      } catch (error) {
        console.error('Failed to fetch moods:', error);
        if (list) {
          list.removeAttribute('aria-busy');
          list.replaceChildren();
        }
        if (emptyState) emptyState.hidden = true;
        if (errorState) errorState.hidden = false;
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            loadMoods();
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.1,
        rootMargin: '0px 0px -30px 0px'
      }
    );

    observer.observe(moodsSection);
  }
</script>
