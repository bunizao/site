---
const placeholders = Array.from({ length: 3 });
---

<section id="moods-section" class="moods-section">
  <span class="section-label scroll-reveal">Moods</span>

  <div class="mood-timeline is-loading" data-mood-list aria-busy="true">
    {placeholders.map((_, index) => (
      <div class="mood-item mood-item-skeleton scroll-reveal-item" style={`--item-index: ${index}`}>
        <div class="mood-item-header">
          <span class="mood-item-date mood-skeleton-pill"></span>
          <span class="mood-item-tag mood-skeleton-pill"></span>
        </div>
        <div class="mood-item-body">
          <span class="mood-skeleton-line"></span>
          <span class="mood-skeleton-line"></span>
          <span class="mood-skeleton-block"></span>
        </div>
      </div>
    ))}
  </div>
  <p class="text-sm text-muted-foreground" data-mood-empty hidden>No moods yet.</p>
  <p class="text-sm text-muted-foreground" data-mood-error hidden>Unable to load moods.</p>

  <a
    href="/mood"
    class="link scroll-reveal-link mt-6 text-sm text-muted-foreground"
  >
    View all moods
  </a>
</section>

<style>
  .moods-section {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  .moods-section.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .scroll-reveal {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.4s ease-out, transform 0.4s ease-out;
  }

  .moods-section.is-visible .scroll-reveal {
    opacity: 1;
    transform: translateY(0);
  }

  .scroll-reveal-item {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.4s ease-out, transform 0.4s ease-out;
  }

  .moods-section.is-visible .scroll-reveal-item {
    opacity: 1;
    transform: translateY(0);
    transition-delay: calc(var(--item-index) * 0.08s + 0.1s);
  }

  .scroll-reveal-link {
    opacity: 0;
    transition: opacity 0.4s ease-out;
  }

  .moods-section.is-visible .scroll-reveal-link {
    opacity: 1;
    transition-delay: 0.4s;
  }

  /* Timeline Layout */
  .mood-timeline {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  @media (min-width: 640px) {
    .mood-timeline {
      gap: 20px;
    }
  }

  .mood-item {
    display: block;
    padding: 16px;
    background: hsl(var(--background));
    border: 1px solid hsl(var(--foreground) / 0.08);
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  @media (min-width: 640px) {
    .mood-item {
      padding: 18px 20px;
    }
  }

  .mood-item:hover {
    border-color: hsl(var(--foreground) / 0.15);
    background: hsl(var(--foreground) / 0.02);
  }

  .mood-item-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .mood-item-date {
    font-size: 12px;
    color: hsl(var(--muted-foreground) / 0.6);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 640px) {
    .mood-item-date {
      font-size: 13px;
    }
  }

  .mood-item-tag {
    font-size: 11px;
    color: hsl(var(--muted-foreground) / 0.7);
    padding: 2px 8px;
    background: hsl(var(--foreground) / 0.05);
    border-radius: 4px;
    font-weight: 500;
  }

  @media (min-width: 640px) {
    .mood-item-tag {
      font-size: 12px;
    }
  }

  .mood-item:hover .mood-item-tag {
    background: hsl(var(--foreground) / 0.08);
  }

  .mood-item-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .mood-item-text {
    font-size: 14px;
    line-height: 1.6;
    color: hsl(var(--foreground));
    white-space: pre-wrap;
    word-wrap: break-word;
  }

  @media (min-width: 640px) {
    .mood-item-text {
      font-size: 15px;
      line-height: 1.7;
    }
  }

  .mood-item-image {
    width: 100%;
    max-width: 500px;
    border-radius: 8px;
    overflow: hidden;
    background: hsl(var(--foreground) / 0.03);
  }

  .mood-item-image img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.3s ease;
  }

  .mood-item:hover .mood-item-image img {
    transform: scale(1.02);
  }

  .mood-item-skeleton {
    pointer-events: none;
  }

  .mood-skeleton-line,
  .mood-skeleton-pill,
  .mood-skeleton-block {
    display: block;
    border-radius: 999px;
    background: linear-gradient(90deg, hsl(var(--foreground) / 0.05), hsl(var(--foreground) / 0.12), hsl(var(--foreground) / 0.05));
    background-size: 200% 100%;
    animation: shimmer 1.6s ease-in-out infinite;
  }

  .mood-skeleton-line {
    height: 10px;
  }

  .mood-skeleton-line:nth-of-type(2) {
    width: 80%;
  }

  .mood-skeleton-pill {
    width: 56px;
    height: 12px;
  }

  .mood-skeleton-block {
    height: 120px;
    border-radius: 8px;
  }

  @keyframes shimmer {
    0% {
      background-position: 0% 50%;
    }
    100% {
      background-position: 200% 50%;
    }
  }
</style>

<script>
  const moodsSection = document.getElementById('moods-section');

  if (moodsSection) {
    const list = moodsSection.querySelector('[data-mood-list]');
    const emptyState = moodsSection.querySelector('[data-mood-empty]');
    const errorState = moodsSection.querySelector('[data-mood-error]');
    let hasLoaded = false;

    const formatDate = (value) => {
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) {
        return '';
      }

      const now = new Date();
      const isToday =
        date.getFullYear() === now.getFullYear() &&
        date.getMonth() === now.getMonth() &&
        date.getDate() === now.getDate();

      if (isToday) {
        return 'Today';
      }

      const month = String(date.getMonth() + 1).padStart(2, '0');
      const day = String(date.getDate()).padStart(2, '0');
      return `${date.getFullYear()}-${month}-${day}`;
    };

    const createMoodItem = (mood, index) => {
      const link = document.createElement('a');
      link.href = `/mood/${mood.id}`;
      link.className = 'mood-item scroll-reveal-item';
      link.style.setProperty('--item-index', `${index}`);

      const header = document.createElement('div');
      header.className = 'mood-item-header';

      const time = document.createElement('time');
      time.className = 'mood-item-date';
      time.dateTime = mood.datetime;
      time.textContent = formatDate(mood.datetime);
      header.appendChild(time);

      if (mood.tag) {
        const tag = document.createElement('span');
        tag.className = 'mood-item-tag';
        tag.textContent = `#${mood.tag}`;
        header.appendChild(tag);
      }

      const body = document.createElement('div');
      body.className = 'mood-item-body';

      const text = document.createElement('p');
      text.className = 'mood-item-text';
      text.textContent = mood.previewText || '';
      body.appendChild(text);

      if (mood.image) {
        const imageWrap = document.createElement('div');
        imageWrap.className = 'mood-item-image';
        const img = document.createElement('img');
        img.src = mood.image;
        img.alt = '';
        img.loading = 'lazy';
        imageWrap.appendChild(img);
        body.appendChild(imageWrap);
      }

      link.appendChild(header);
      link.appendChild(body);
      return link;
    };

    const renderMoods = (posts) => {
      if (!list) return;
      list.classList.remove('is-loading');
      list.removeAttribute('aria-busy');
      list.replaceChildren();

      if (errorState) errorState.hidden = true;

      if (!posts.length) {
        if (emptyState) emptyState.hidden = false;
        return;
      }

      if (emptyState) emptyState.hidden = true;
      posts.forEach((post, index) => list.appendChild(createMoodItem(post, index)));
    };

    const loadMoods = async () => {
      if (hasLoaded || !list) return;
      hasLoaded = true;

      try {
        const response = await fetch('/api/moods');
        if (!response.ok) {
          throw new Error('Failed to fetch moods.');
        }
        const data = await response.json();
        const posts = Array.isArray(data.posts) ? data.posts.slice(0, 3) : [];
        renderMoods(posts);
      } catch (error) {
        console.error('Failed to fetch moods:', error);
        if (list) {
          list.classList.remove('is-loading');
          list.removeAttribute('aria-busy');
          list.replaceChildren();
        }
        if (emptyState) emptyState.hidden = true;
        if (errorState) errorState.hidden = false;
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            loadMoods();
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.1,
        rootMargin: '0px 0px -30px 0px'
      }
    );

    observer.observe(moodsSection);
  }
</script>
