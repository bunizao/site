---
const SKELETON_COUNT = 5;
const placeholders = Array.from({ length: SKELETON_COUNT });
---

<section id="moods-section" class="moods-section">
  <span class="section-label scroll-reveal">Moods</span>

  <div class="mood-timeline" data-mood-list aria-busy="true" aria-label="Recent moods">
    {placeholders.map((_, index) => (
      <div class="mood-item mood-item-skeleton scroll-reveal-item" style={`--item-index: ${index}`}>
        <div class="mood-time-col">
          <span class="mood-skeleton-time"></span>
        </div>
        <div class="mood-line-col">
          <div class="mood-dot"></div>
          <div class="mood-line"></div>
        </div>
        <div class="mood-content-col">
          <div class="mood-card">
            <span class="mood-skeleton-text"></span>
            <span class="mood-skeleton-text mood-skeleton-text--short"></span>
          </div>
        </div>
      </div>
    ))}
  </div>

  <p class="mood-empty-state" data-mood-empty hidden>No moods yet.</p>
  <p class="mood-error-state" data-mood-error hidden>Unable to load moods.</p>

  <a
    href="/mood"
    class="link scroll-reveal-link mt-6 text-sm text-muted-foreground"
    aria-label="View all moods"
  >
    View all moods
  </a>
</section>

<style is:global>
  #moods-section {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  #moods-section.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  #moods-section .scroll-reveal {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.4s ease-out, transform 0.4s ease-out;
  }

  #moods-section.is-visible .scroll-reveal {
    opacity: 1;
    transform: translateY(0);
  }

  #moods-section .scroll-reveal-item {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }

  #moods-section.is-visible .scroll-reveal-item {
    opacity: 1;
    transform: translateY(0);
    transition-delay: calc(var(--item-index) * 0.08s + 0.1s);
  }

  #moods-section .scroll-reveal-link {
    opacity: 0;
    transition: opacity 0.4s ease-out;
  }

  #moods-section.is-visible .scroll-reveal-link {
    opacity: 1;
    transition-delay: 0.5s;
  }

  /* Timeline Layout - 3 columns: time | line | content */
  #moods-section .mood-timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  #moods-section .mood-item {
    display: grid;
    grid-template-columns: 52px 24px 1fr;
    gap: 0;
    text-decoration: none;
    color: inherit;
    position: relative;
  }

  @media (min-width: 640px) {
    #moods-section .mood-item {
      grid-template-columns: 64px 32px 1fr;
    }
  }

  /* Time column */
  #moods-section .mood-time-col {
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    padding-top: 14px;
    padding-right: 8px;
  }

  #moods-section .mood-time {
    font-size: 11px;
    font-weight: 500;
    color: hsl(var(--muted-foreground) / 0.5);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
    transition: color 0.2s ease;
  }

  @media (min-width: 640px) {
    #moods-section .mood-time {
      font-size: 12px;
    }
  }

  #moods-section .mood-item:not(.mood-item-skeleton):hover .mood-time {
    color: hsl(var(--muted-foreground));
  }

  /* Line column */
  #moods-section .mood-line-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  #moods-section .mood-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: hsl(var(--background));
    border: 2px solid hsl(var(--foreground) / 0.15);
    margin-top: 12px;
    position: relative;
    z-index: 2;
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  #moods-section .mood-item:not(.mood-item-skeleton):hover .mood-dot {
    border-color: hsl(var(--foreground) / 0.4);
    background: hsl(var(--foreground) / 0.08);
    transform: scale(1.3);
  }

  /* Pulse effect on first item */
  #moods-section .mood-item:first-child:not(.mood-item-skeleton) .mood-dot::before {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1px solid hsl(var(--foreground) / 0.1);
    animation: mood-pulse 2.5s ease-out infinite;
  }

  @keyframes mood-pulse {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    100% {
      transform: scale(2);
      opacity: 0;
    }
  }

  #moods-section .mood-line {
    flex: 1;
    width: 1px;
    background: linear-gradient(
      to bottom,
      hsl(var(--foreground) / 0.12),
      hsl(var(--foreground) / 0.06)
    );
    margin-top: 4px;
  }

  #moods-section .mood-item:last-child .mood-line {
    background: linear-gradient(
      to bottom,
      hsl(var(--foreground) / 0.12),
      transparent
    );
  }

  /* Content column */
  #moods-section .mood-content-col {
    padding: 8px 0 16px 0;
  }

  #moods-section .mood-card {
    padding: 10px 14px;
    background: hsl(var(--foreground) / 0.02);
    border: 1px solid hsl(var(--foreground) / 0.06);
    border-radius: 10px;
    transition: all 0.2s ease;
  }

  @media (min-width: 640px) {
    #moods-section .mood-card {
      padding: 12px 16px;
    }
  }

  #moods-section .mood-item:not(.mood-item-skeleton):hover .mood-card {
    background: hsl(var(--foreground) / 0.04);
    border-color: hsl(var(--foreground) / 0.12);
    transform: translateX(4px);
    box-shadow: -4px 0 0 hsl(var(--foreground) / 0.06);
  }

  #moods-section .mood-text {
    font-size: 13px;
    font-weight: 400;
    line-height: 1.55;
    color: hsl(var(--foreground) / 0.85);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    #moods-section .mood-text {
      font-size: 14px;
      line-height: 1.6;
    }
  }

  #moods-section .mood-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
  }

  #moods-section .mood-tag {
    font-size: 10px;
    font-weight: 500;
    color: hsl(var(--muted-foreground) / 0.6);
    padding: 2px 6px;
    background: hsl(var(--foreground) / 0.04);
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  @media (min-width: 640px) {
    #moods-section .mood-tag {
      font-size: 11px;
    }
  }

  #moods-section .mood-item:hover .mood-tag {
    background: hsl(var(--foreground) / 0.08);
    color: hsl(var(--muted-foreground) / 0.8);
  }

  #moods-section .mood-thumbnail {
    width: 48px;
    height: 48px;
    border-radius: 6px;
    overflow: hidden;
    background: hsl(var(--foreground) / 0.04);
    flex-shrink: 0;
  }

  #moods-section .mood-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  #moods-section .mood-item:hover .mood-thumbnail img {
    transform: scale(1.1);
  }

  /* Skeleton Styles */
  #moods-section .mood-item-skeleton {
    pointer-events: none;
  }

  #moods-section .mood-item-skeleton .mood-dot {
    border-color: hsl(var(--foreground) / 0.08);
  }

  #moods-section .mood-item-skeleton .mood-card {
    background: transparent;
    border-color: hsl(var(--foreground) / 0.04);
  }

  #moods-section .mood-skeleton-text,
  #moods-section .mood-skeleton-time {
    display: block;
    border-radius: 4px;
    background: linear-gradient(90deg, hsl(var(--foreground) / 0.04), hsl(var(--foreground) / 0.10), hsl(var(--foreground) / 0.04));
    background-size: 200% 100%;
    animation: moods-shimmer 1.8s ease-in-out infinite;
  }

  #moods-section .mood-skeleton-text {
    height: 13px;
    width: 100%;
    margin-bottom: 8px;
  }

  #moods-section .mood-skeleton-text--short {
    width: 45%;
    margin-bottom: 0;
  }

  #moods-section .mood-skeleton-time {
    width: 36px;
    height: 12px;
  }

  /* Empty and error states */
  #moods-section .mood-empty-state,
  #moods-section .mood-error-state {
    font-size: 14px;
    color: hsl(var(--muted-foreground));
    padding: 16px 0;
    margin-left: 76px;
  }

  @media (min-width: 640px) {
    #moods-section .mood-empty-state,
    #moods-section .mood-error-state {
      margin-left: 96px;
    }
  }

  @keyframes moods-shimmer {
    0% {
      background-position: 200% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }
</style>

<script>
  const moodsSection = document.getElementById('moods-section');

  if (moodsSection) {
    const list = moodsSection.querySelector('[data-mood-list]') as HTMLElement | null;
    const emptyState = moodsSection.querySelector('[data-mood-empty]') as HTMLElement | null;
    const errorState = moodsSection.querySelector('[data-mood-error]') as HTMLElement | null;
    let hasLoaded = false;

    const MAX_MOODS = 5;

    const formatTime = (value: string): string => {
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return '';

      const now = new Date();
      const isToday =
        date.getFullYear() === now.getFullYear() &&
        date.getMonth() === now.getMonth() &&
        date.getDate() === now.getDate();

      // If today, show time like 14:30
      if (isToday) {
        const hours = String(date.getHours()).padStart(2, '0');
        const minutes = String(date.getMinutes()).padStart(2, '0');
        return `${hours}:${minutes}`;
      }

      // Show month + date like "JAN 01"
      const months = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
      const monthName = months[date.getMonth()];
      const day = String(date.getDate()).padStart(2, '0');

      return `${monthName} ${day}`;
    };

    interface MoodData {
      id: string;
      datetime: string;
      tag?: string;
      previewText: string;
      image?: string | null;
      mediaHtml?: string;
      needsDetailPage?: boolean;
    }

    const createMoodItem = (mood: MoodData, index: number): HTMLElement => {
      const link = document.createElement('a');
      link.href = `/mood/${mood.id}`;
      link.className = 'mood-item';
      link.style.cssText = `--item-index: ${index}; opacity: 0; transform: translateY(8px);`;

      // Time column
      const timeCol = document.createElement('div');
      timeCol.className = 'mood-time-col';
      const time = document.createElement('time');
      time.className = 'mood-time';
      time.dateTime = mood.datetime;
      time.textContent = formatTime(mood.datetime);
      timeCol.appendChild(time);

      // Line column
      const lineCol = document.createElement('div');
      lineCol.className = 'mood-line-col';
      const dot = document.createElement('div');
      dot.className = 'mood-dot';
      const line = document.createElement('div');
      line.className = 'mood-line';
      lineCol.appendChild(dot);
      lineCol.appendChild(line);

      // Content column
      const contentCol = document.createElement('div');
      contentCol.className = 'mood-content-col';
      const card = document.createElement('div');
      card.className = 'mood-card';

      const text = document.createElement('span');
      text.className = 'mood-text';
      text.textContent = mood.previewText || '(No text)';
      card.appendChild(text);

      // Meta section with tag and/or thumbnail
      const hasMetaContent = mood.tag || mood.image;
      if (hasMetaContent) {
        const meta = document.createElement('div');
        meta.className = 'mood-meta';

        if (mood.tag) {
          const tag = document.createElement('span');
          tag.className = 'mood-tag';
          tag.textContent = `#${mood.tag}`;
          meta.appendChild(tag);
        }

        if (mood.image) {
          const thumbnail = document.createElement('div');
          thumbnail.className = 'mood-thumbnail';
          const img = document.createElement('img');
          img.src = mood.image;
          img.alt = '';
          img.loading = 'lazy';
          thumbnail.appendChild(img);
          meta.appendChild(thumbnail);
        }

        card.appendChild(meta);
      }

      contentCol.appendChild(card);

      link.appendChild(timeCol);
      link.appendChild(lineCol);
      link.appendChild(contentCol);

      // Animate in
      requestAnimationFrame(() => {
        setTimeout(() => {
          link.style.transition = 'opacity 0.5s ease-out, transform 0.5s ease-out';
          link.style.opacity = '1';
          link.style.transform = 'translateY(0)';
        }, index * 80 + 100);
      });

      return link;
    };

    const renderMoods = (posts: MoodData[]): void => {
      if (!list) return;

      list.removeAttribute('aria-busy');
      list.replaceChildren();

      if (errorState) errorState.hidden = true;

      if (!posts.length) {
        if (emptyState) emptyState.hidden = false;
        return;
      }

      if (emptyState) emptyState.hidden = true;
      posts.forEach((post, index) => list.appendChild(createMoodItem(post, index)));
    };

    const loadMoods = async (): Promise<void> => {
      if (hasLoaded || !list) return;
      hasLoaded = true;

      try {
        const response = await fetch('/api/moods');
        if (!response.ok) {
          throw new Error('Failed to fetch moods.');
        }
        const data = await response.json();
        const posts = Array.isArray(data.posts) ? data.posts.slice(0, MAX_MOODS) : [];
        renderMoods(posts);
      } catch (error) {
        console.error('Failed to fetch moods:', error);
        if (list) {
          list.removeAttribute('aria-busy');
          list.replaceChildren();
        }
        if (emptyState) emptyState.hidden = true;
        if (errorState) errorState.hidden = false;
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            loadMoods();
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.1,
        rootMargin: '0px 0px -30px 0px'
      }
    );

    observer.observe(moodsSection);
  }
</script>
