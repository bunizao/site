---
import dayjs from 'dayjs';
import { getChannelInfo, type ChannelInfo } from '../lib/telegram';

let latestMoods: any[] = [];
let error = false;

try {
  const result = await getChannelInfo(Astro, { type: 'list' }) as ChannelInfo;
  latestMoods = [...result.posts]
    .sort((a, b) => Number.parseInt(b.id, 10) - Number.parseInt(a.id, 10))
    .slice(0, 3);
} catch (e) {
  console.error('Failed to fetch moods:', e);
  error = true;
}

// Helper to extract first image from content
function getFirstImage(content: string): string | null {
  const match = content.match(/<img[^>]+src="([^">]+)"/);
  return match ? match[1] : null;
}

// Helper to strip HTML tags for preview
function stripHtml(html: string): string {
  return html.replace(/<[^>]*>/g, '').trim();
}

function formatMoodDate(value: string): string {
  const date = dayjs(value);
  if (date.isSame(dayjs(), 'day')) {
    return 'Today';
  }
  return date.format('YYYY-MM-DD');
}

function getTextPreview(mood: any): string {
  const preview = (mood.text ?? '').trim();
  return preview || stripHtml(mood.content);
}
---

<section id="moods-section" class="moods-section">
  <span class="section-label scroll-reveal">Moods</span>

  {error ? (
    <p class="text-sm text-muted-foreground">Unable to load moods.</p>
  ) : latestMoods.length > 0 ? (
    <div class="mood-timeline">
      {latestMoods.map((mood, index) => {
        const firstImage = getFirstImage(mood.content);
        const textPreview = getTextPreview(mood);
        const firstTag = mood.tags?.[0];
        return (
          <a href={`/mood/${mood.id}`} class="mood-item scroll-reveal-item" style={`--item-index: ${index}`}>
            <div class="mood-item-header">
              <time datetime={mood.datetime} class="mood-item-date">
                {formatMoodDate(mood.datetime)}
              </time>
              {firstTag && (
                <span class="mood-item-tag">#{firstTag}</span>
              )}
            </div>
            <div class="mood-item-body">
              <p class="mood-item-text">{textPreview}</p>
              {firstImage && (
                <div class="mood-item-image">
                  <img src={firstImage} alt="" loading="lazy" />
                </div>
              )}
            </div>
          </a>
        );
      })}
    </div>
  ) : (
    <p class="text-sm text-muted-foreground">No moods yet.</p>
  )}

  <a
    href="/mood"
    class="link scroll-reveal-link mt-6 text-sm text-muted-foreground"
  >
    View all moods
  </a>
</section>

<style>
  .moods-section {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  .moods-section.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .scroll-reveal {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.4s ease-out, transform 0.4s ease-out;
  }

  .moods-section.is-visible .scroll-reveal {
    opacity: 1;
    transform: translateY(0);
  }

  .scroll-reveal-item {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.4s ease-out, transform 0.4s ease-out;
  }

  .moods-section.is-visible .scroll-reveal-item {
    opacity: 1;
    transform: translateY(0);
    transition-delay: calc(var(--item-index) * 0.08s + 0.1s);
  }

  .scroll-reveal-link {
    opacity: 0;
    transition: opacity 0.4s ease-out;
  }

  .moods-section.is-visible .scroll-reveal-link {
    opacity: 1;
    transition-delay: 0.4s;
  }

  /* Timeline Layout */
  .mood-timeline {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  @media (min-width: 640px) {
    .mood-timeline {
      gap: 20px;
    }
  }

  .mood-item {
    display: block;
    padding: 16px;
    background: hsl(var(--background));
    border: 1px solid hsl(var(--foreground) / 0.08);
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  @media (min-width: 640px) {
    .mood-item {
      padding: 18px 20px;
    }
  }

  .mood-item:hover {
    border-color: hsl(var(--foreground) / 0.15);
    background: hsl(var(--foreground) / 0.02);
  }

  .mood-item-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .mood-item-date {
    font-size: 12px;
    color: hsl(var(--muted-foreground) / 0.6);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 640px) {
    .mood-item-date {
      font-size: 13px;
    }
  }

  .mood-item-tag {
    font-size: 11px;
    color: hsl(var(--muted-foreground) / 0.7);
    padding: 2px 8px;
    background: hsl(var(--foreground) / 0.05);
    border-radius: 4px;
    font-weight: 500;
  }

  @media (min-width: 640px) {
    .mood-item-tag {
      font-size: 12px;
    }
  }

  .mood-item:hover .mood-item-tag {
    background: hsl(var(--foreground) / 0.08);
  }

  .mood-item-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .mood-item-text {
    font-size: 14px;
    line-height: 1.6;
    color: hsl(var(--foreground));
    white-space: pre-wrap;
    word-wrap: break-word;
  }

  @media (min-width: 640px) {
    .mood-item-text {
      font-size: 15px;
      line-height: 1.7;
    }
  }

  .mood-item-image {
    width: 100%;
    max-width: 500px;
    border-radius: 8px;
    overflow: hidden;
    background: hsl(var(--foreground) / 0.03);
  }

  .mood-item-image img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.3s ease;
  }

  .mood-item:hover .mood-item-image img {
    transform: scale(1.02);
  }
</style>

<script>
  const moodsSection = document.getElementById('moods-section');

  if (moodsSection) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.1,
        rootMargin: '0px 0px -30px 0px'
      }
    );

    observer.observe(moodsSection);
  }
</script>
