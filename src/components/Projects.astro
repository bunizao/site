---
import { ArrowUpRight } from 'lucide-react';

const projects = [
  {
    name: 'TutuBetterRules',
    desc: 'Cross-platform proxy rules and configs for better network experience',
    url: 'https://github.com/bunizao/TutuBetterRules',
    tags: ['Proxy', 'Network']
  },
  {
    name: 'Attegi',
    desc: 'Modern Ghost theme with Vite and TailwindCSS',
    url: 'https://github.com/bunizao/Attegi',
    tags: ['Ghost', 'Theme']
  },
  {
    name: 'Mirrored',
    desc: 'CI/CD automation with Python for container deployment',
    url: 'https://github.com/bunizao/Mirrored',
    tags: ['CI/CD', 'Python']
  },
  {
    name: 'iRingo',
    desc: 'Unlock iOS/macOS features with MitM method',
    url: 'https://nsringo.github.io/',
    tags: ['iOS', 'Contributor']
  },
];
---

<section>
  <span class="section-label">Projects</span>

  <div class="project-list">
    {projects.map((project) => (
      <a
        href={project.url}
        target="_blank"
        rel="noopener noreferrer"
        class="project-item"
      >
        <div class="project-header">
          <span class="project-name">{project.name}</span>
          <span class="project-tags">{project.tags.join(' · ')}</span>
        </div>
        <p class="project-desc">{project.desc}</p>
        <ArrowUpRight className="project-arrow" aria-hidden="true" />
      </a>
    ))}
  </div>

  <a
    href="https://github.com/bunizao"
    target="_blank"
    class="link mt-6 inline-block text-sm text-muted-foreground"
  >
    View all on GitHub →
  </a>
</section>

<style>
  .project-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .project-item {
    display: block;
    position: relative;
    padding: 12px 0;
    padding-right: 24px;
    transition: all 0.15s ease;
  }

  .project-item::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(to right, hsl(var(--foreground) / 0.1), transparent);
  }

  .project-item:last-child::after {
    display: none;
  }

  .project-item:hover {
    padding-left: 8px;
  }

  .project-header {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 4px;
  }

  .project-name {
    font-weight: 600;
    font-size: 15px;
  }

  .project-tags {
    font-size: 11px;
    color: hsl(var(--muted-foreground) / 0.6);
    letter-spacing: 0.02em;
  }

  .project-desc {
    font-size: 13px;
    color: hsl(var(--muted-foreground));
    line-height: 1.5;
  }

  .project-arrow {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 14px;
    height: 14px;
    color: hsl(var(--muted-foreground) / 0.4);
    transition: all 0.15s ease;
  }

  .project-item:hover .project-arrow {
    color: hsl(var(--foreground));
    transform: translateY(-50%) translate(2px, -2px);
  }
</style>
