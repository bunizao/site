---
import { ArrowUpRight } from 'lucide-react';

interface ProjectConfig {
  name: string;
  repo?: string; // GitHub repo in format "owner/repo"
  url: string;
  desc?: string; // Override description
  role: 'Author' | 'Contributor';
  tags: string[];
}

interface ProjectData extends ProjectConfig {
  description: string;
  stars: number | null;
}

const projectConfigs: ProjectConfig[] = [
  {
    name: 'TutuBetterRules',
    repo: 'bunizao/TutuBetterRules',
    url: 'https://github.com/bunizao/TutuBetterRules',
    role: 'Author',
    tags: ['Proxy', 'Network']
  },
  {
    name: 'Attegi',
    repo: 'bunizao/Attegi',
    url: 'https://github.com/bunizao/Attegi',
    role: 'Author',
    tags: ['Ghost', 'Theme']
  },
  {
    name: 'Mirrored',
    repo: 'bunizao/Mirrored',
    url: 'https://github.com/bunizao/Mirrored',
    role: 'Author',
    tags: ['CI/CD', 'Python']
  },
  {
    name: 'iRingo',
    repo: 'NSRingo/iRingo',
    url: 'https://nsringo.github.io/',
    desc: 'Unlock iOS/macOS features with MitM method',
    role: 'Contributor',
    tags: ['iOS', 'MitM']
  },
];

async function fetchGitHubData(repo: string): Promise<{ description: string; stars: number } | null> {
  try {
    const response = await fetch(`https://api.github.com/repos/${repo}`, {
      headers: {
        'Accept': 'application/vnd.github.v3+json',
        'User-Agent': 'astro-site'
      }
    });

    if (!response.ok) return null;

    const data = await response.json();
    return {
      description: data.description || '',
      stars: data.stargazers_count || 0
    };
  } catch (error) {
    console.error(`Failed to fetch GitHub data for ${repo}:`, error);
    return null;
  }
}

const projects: ProjectData[] = await Promise.all(
  projectConfigs.map(async (config) => {
    if (config.repo) {
      const githubData = await fetchGitHubData(config.repo);
      return {
        ...config,
        description: config.desc || githubData?.description || '',
        stars: githubData?.stars ?? null
      };
    }
    return {
      ...config,
      description: config.desc || '',
      stars: null
    };
  })
);
---

<section>
  <span class="section-label">Projects</span>

  <div class="project-list">
    {projects.map((project) => (
      <a
        href={project.url}
        target="_blank"
        rel="noopener noreferrer"
        class="project-item"
      >
        <div class="project-header">
          <span class="project-name">{project.name}</span>
        </div>
        <p class="project-desc">{project.description}</p>
        <div class="project-meta">
          <span class="project-role">@{project.role}</span>
          <span class="project-tags">{project.tags.join(' · ')}</span>
          {project.stars !== null && (
            <span class="project-stars">{project.stars} stars</span>
          )}
        </div>
        <ArrowUpRight className="project-arrow" aria-hidden="true" />
      </a>
    ))}
  </div>

  <a
    href="https://github.com/bunizao"
    target="_blank"
    class="link mt-6 text-sm text-muted-foreground"
  >
    View all on GitHub
  </a>
</section>

<style>
  .project-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .project-item {
    display: block;
    position: relative;
    padding: 12px 0;
    padding-right: 24px;
    transition: all 0.15s ease;
  }

  .project-item::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(to right, hsl(var(--foreground) / 0.1), transparent);
  }

  .project-item:last-child::after {
    display: none;
  }

  .project-item:hover {
    padding-left: 8px;
  }

  .project-header {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 4px;
  }

  .project-name {
    font-weight: 600;
    font-size: 15px;
  }

  .project-desc {
    font-size: 13px;
    color: hsl(var(--muted-foreground));
    line-height: 1.5;
    margin-bottom: 6px;
  }

  .project-meta {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 12px;
  }

  .project-role {
    font-weight: 600;
    color: hsl(var(--foreground));
  }

  .project-tags {
    color: hsl(var(--muted-foreground));
  }

  .project-stars {
    color: hsl(var(--muted-foreground) / 0.6);
    font-variant-numeric: tabular-nums;
    margin-left: auto;
  }

  .project-arrow {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 14px;
    height: 14px;
    color: hsl(var(--muted-foreground) / 0.4);
    transition: all 0.15s ease;
  }

  .project-item:hover .project-arrow {
    color: hsl(var(--foreground));
    transform: translateY(-50%) translate(2px, -2px);
  }
</style>
