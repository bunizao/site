---
const projects = [
  {
    name: 'TutuBetterRules',
    desc: 'Cross-platform proxy rules and configs for better network experience',
    url: 'https://github.com/bunizao/TutuBetterRules',
    tags: ['Proxy', 'Network']
  },
  {
    name: 'Attegi',
    desc: 'Modern Ghost theme with Vite and TailwindCSS',
    url: 'https://github.com/bunizao/Attegi',
    tags: ['Ghost', 'Theme']
  },
  {
    name: 'Mirrored',
    desc: 'CI/CD automation with Python for container deployment',
    url: 'https://github.com/bunizao/Mirrored',
    tags: ['CI/CD', 'Python']
  },
  {
    name: 'iRingo',
    desc: 'Unlock iOS/macOS features with MitM method',
    url: 'https://nsringo.github.io/',
    tags: ['iOS', 'Contributor']
  },
];
---

<section>
  <span class="section-label">Projects</span>

  <div>
    {projects.map((project, i) => (
      <a
        href={project.url}
        target="_blank"
        rel="noopener noreferrer"
        class="item"
      >
        <div class="flex justify-between items-center">
          <span class="item-title">{project.name}</span>
          <span class="i-ri-arrow-right-up-line text-muted" style="flex-shrink: 0;"></span>
        </div>
        <p class="item-desc">{project.desc}</p>
        <div>
          {project.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </a>
    ))}
  </div>

  <a
    href="https://github.com/bunizao"
    target="_blank"
    class="link text-sm text-muted mt-4"
    style="display: inline-block;"
  >
    View all on GitHub →
  </a>
</section>
