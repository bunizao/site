---
import { ArrowUpRight } from 'lucide-react';

interface ProjectConfig {
  name: string;
  repo: string;
  url: string;
  description: string; // Fallback description
  role: 'Author' | 'Contributor';
  tags: string[];
}

interface Project extends ProjectConfig {
  stars: number | null;
}

const projectConfigs: ProjectConfig[] = [
  {
    name: 'TutuBetterRules',
    repo: 'bunizao/TutuBetterRules',
    url: 'https://github.com/bunizao/TutuBetterRules',
    description: 'Proxy rules for Surge, Clash, and other proxy tools',
    role: 'Author',
    tags: ['Proxy', 'Network']
  },
  {
    name: 'Attegi',
    repo: 'bunizao/Attegi',
    url: 'https://github.com/bunizao/Attegi',
    description: 'A minimal and elegant Ghost theme',
    role: 'Author',
    tags: ['Ghost', 'Theme', 'TailwindCSS']
  },
  {
    name: 'Mirrored',
    repo: 'bunizao/Mirrored',
    url: 'https://github.com/bunizao/Mirrored',
    description: 'Automated mirror sync for container registries',
    role: 'Author',
    tags: ['CI/CD', 'Python', 'Automation']
  },
  {
    name: 'ogis',
    repo: 'bunizao/ogis',
    url: 'https://github.com/bunizao/ogis',
    description: 'Open Graph image generation service',
    role: 'Author',
    tags: ['Next.js', 'React', 'TypeScript']
  },
  {
    name: 'always-attend',
    repo: 'bunizao/always-attend',
    url: 'https://github.com/bunizao/always-attend',
    description: 'Automated attendance check-in tool',
    role: 'Author',
    tags: ['Python', 'CLI', 'Automation']
  },
  {
    name: 'Mole',
    repo: 'tw93/Mole',
    url: 'https://github.com/tw93/Mole',
    description: 'A simple macOS app to manage SSH tunnels',
    role: 'Contributor',
    tags: ['Shell', 'macOS', 'CLI']
  }
];

async function fetchGitHubData(repo: string): Promise<{ description: string; stars: number } | null> {
  try {
    const response = await fetch(`https://api.github.com/repos/${repo}`, {
      headers: {
        'Accept': 'application/vnd.github.v3+json',
        'User-Agent': 'astro-site'
      }
    });

    if (!response.ok) return null;

    const data = await response.json();
    return {
      description: data.description || '',
      stars: data.stargazers_count || 0
    };
  } catch {
    return null;
  }
}

const projects: Project[] = await Promise.all(
  projectConfigs.map(async (config) => {
    const githubData = await fetchGitHubData(config.repo);
    return {
      ...config,
      description: githubData?.description || config.description,
      stars: githubData?.stars ?? null
    };
  })
);
---

<section id="projects-section" class="projects-section">
  <span class="section-label scroll-reveal">Projects</span>

  <div class="project-list">
    {projects.map((project, index) => (
      <div class="tilt-card scroll-reveal-card" data-tilt style={`--card-index: ${index}`}>
        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          class="project-item"
        >
          <div class="card-glare" data-glare></div>
          <div class="project-content">
            <div class="project-header">
              <span class="project-name">{project.name}</span>
              {project.stars !== null && (
                <span class="project-stars">
                  <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor">
                    <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25z"/>
                  </svg>
                  {project.stars}
                </span>
              )}
            </div>
            <p class="project-desc">{project.description}</p>
          </div>
          <div class="project-footer">
            <span class="project-role">{project.role}</span>
            <div class="project-tags">
              {project.tags.slice(0, 3).map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </div>
          <ArrowUpRight className="project-arrow" aria-hidden="true" />
        </a>
      </div>
    ))}
  </div>

  <a
    href="https://github.com/bunizao"
    target="_blank"
    class="link mt-6 text-sm text-muted-foreground"
  >
    View all on GitHub
  </a>
</section>

<style>
  .projects-section {
    opacity: 0;
    transform: translateY(60px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  .projects-section.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .scroll-reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }

  .projects-section.is-visible .scroll-reveal {
    opacity: 1;
    transform: translateY(0);
  }

  .scroll-reveal-card {
    opacity: 0;
    transform: translateY(40px) scale(0.95);
    transition: opacity 0.5s ease-out, transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .projects-section.is-visible .scroll-reveal-card {
    opacity: 1;
    transform: translateY(0) scale(1);
    transition-delay: calc(var(--card-index) * 0.08s + 0.15s);
  }

  .project-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }

  @media (min-width: 640px) {
    .project-list {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }
  }

  .tilt-card {
    perspective: 1000px;
    height: 100%;
  }

  .project-item {
    display: flex;
    flex-direction: column;
    position: relative;
    height: 100%;
    padding: 16px;
    background: hsl(var(--background));
    border: 1px solid hsl(var(--foreground) / 0.08);
    border-radius: 12px;
    transition: transform 0.1s ease-out, box-shadow 0.2s ease;
    transform-style: preserve-3d;
    will-change: transform;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .project-item {
      padding: 18px;
    }
  }

  .project-item:hover {
    box-shadow:
      0 10px 30px -10px hsl(var(--foreground) / 0.1),
      0 0 0 1px hsl(var(--foreground) / 0.05);
  }

  .card-glare {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    border-radius: inherit;
    opacity: 0;
    transition: opacity 0.2s ease;
    background: radial-gradient(
      600px circle at var(--glare-x, 50%) var(--glare-y, 50%),
      hsl(var(--foreground) / 0.06),
      transparent 40%
    );
  }

  .tilt-card:hover .card-glare {
    opacity: 1;
  }

  .project-content {
    flex: 1;
    min-height: 0;
  }

  .project-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 8px;
    padding-right: 24px;
  }

  .project-name {
    font-weight: 600;
    font-size: 14px;
    color: hsl(var(--foreground));
  }

  @media (min-width: 640px) {
    .project-name {
      font-size: 15px;
    }
  }

  .project-stars {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    font-weight: 500;
    color: hsl(var(--muted-foreground) / 0.7);
    font-variant-numeric: tabular-nums;
  }

  .project-stars svg {
    opacity: 0.6;
  }

  .project-desc {
    font-size: 12px;
    color: hsl(var(--muted-foreground));
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: calc(12px * 1.5 * 2);
  }

  @media (min-width: 640px) {
    .project-desc {
      font-size: 13px;
      min-height: calc(13px * 1.5 * 2);
    }
  }

  .project-footer {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid hsl(var(--foreground) / 0.06);
  }

  .project-role {
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: hsl(var(--foreground) / 0.5);
    padding: 2px 6px;
    background: hsl(var(--foreground) / 0.05);
    border-radius: 4px;
    flex-shrink: 0;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    flex: 1;
    min-width: 0;
  }

  .tag {
    font-size: 10px;
    font-weight: 400;
    color: hsl(var(--muted-foreground) / 0.8);
    white-space: nowrap;
  }

  .tag:not(:last-child)::after {
    content: '·';
    margin-left: 6px;
    opacity: 0.4;
  }

  .project-arrow {
    position: absolute;
    right: 14px;
    top: 14px;
    width: 14px;
    height: 14px;
    color: hsl(var(--muted-foreground) / 0.25);
    transition: all 0.2s ease;
  }

  @media (min-width: 640px) {
    .project-arrow {
      right: 16px;
      top: 16px;
    }
  }

  .tilt-card:hover .project-arrow {
    color: hsl(var(--foreground) / 0.6);
    transform: translate(2px, -2px);
  }
</style>

<script>
  // Scroll reveal animation using Intersection Observer
  const projectsSection = document.getElementById('projects-section');

  if (projectsSection) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      }
    );

    observer.observe(projectsSection);
  }

  const tiltCards = document.querySelectorAll('[data-tilt]');

  tiltCards.forEach((card) => {
    const item = card.querySelector('.project-item') as HTMLElement;
    const glare = card.querySelector('[data-glare]') as HTMLElement;
    if (!item) return;

    const maxTilt = 8;
    let rafId: number | null = null;
    let currentX = 0;
    let currentY = 0;
    let targetX = 0;
    let targetY = 0;

    const lerp = (start: number, end: number, factor: number) => {
      return start + (end - start) * factor;
    };

    const animate = () => {
      currentX = lerp(currentX, targetX, 0.15);
      currentY = lerp(currentY, targetY, 0.15);

      item.style.transform = `rotateX(${currentY}deg) rotateY(${currentX}deg)`;

      if (Math.abs(currentX - targetX) > 0.01 || Math.abs(currentY - targetY) > 0.01) {
        rafId = requestAnimationFrame(animate);
      } else {
        rafId = null;
      }
    };

    card.addEventListener('mousemove', (e: Event) => {
      const event = e as MouseEvent;
      const rect = card.getBoundingClientRect();
      const x = event.clientX - rect.left;
      const y = event.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;

      targetX = ((x - centerX) / centerX) * maxTilt;
      targetY = ((centerY - y) / centerY) * maxTilt;

      if (glare) {
        const glareX = (x / rect.width) * 100;
        const glareY = (y / rect.height) * 100;
        glare.style.setProperty('--glare-x', `${glareX}%`);
        glare.style.setProperty('--glare-y', `${glareY}%`);
      }

      if (!rafId) {
        rafId = requestAnimationFrame(animate);
      }
    });

    card.addEventListener('mouseleave', () => {
      targetX = 0;
      targetY = 0;

      if (!rafId) {
        rafId = requestAnimationFrame(animate);
      }
    });
  });
</script>
