---

<div id="parallax-container">
  <slot />
</div>

<style>
  /* Native scroll with WebKit optimizations */
  :global(html) {
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
  }

  :global(body) {
    overscroll-behavior: none;
  }

  #parallax-container {
    will-change: auto;
  }

  /* Floating sections - GPU accelerated */
  :global(section) {
    will-change: transform;
    transform: translateZ(0);
    -webkit-transform: translateZ(0);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  const initSkatingEffects = async () => {
    const prefersReducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    const [{ default: gsap }, { ScrollTrigger }] = await Promise.all([
      import('gsap'),
      import('gsap/ScrollTrigger')
    ]);

    gsap.registerPlugin(ScrollTrigger);

    // ===== SMOOTH SCROLL DRIFT (SIMPLE & FLUID) =====
    const floatingSections = document.querySelectorAll('section:not(#projects-section)');

    // Use GSAP's optimized animation for buttery smooth movement
    floatingSections.forEach((section, index) => {
      const el = section as HTMLElement;
      const speed = 0.5 + (index % 3) * 0.2; // Vary parallax speed

      gsap.to(el, {
        y: () => {
          // Different sections move at different rates relative to scroll
          const scrollProgress = window.scrollY;
          return scrollProgress * speed * 0.02;
        },
        ease: 'none',
        scrollTrigger: {
          trigger: document.body,
          start: 'top top',
          end: 'bottom bottom',
          scrub: 1.5, // Higher = more lag/glide (ice skating feel)
          invalidateOnRefresh: true
        }
      });
    });

    // ===== SECTION FADE IN =====
    const sections = document.querySelectorAll('section:not([data-parallax="off"])');
    sections.forEach((section) => {
      gsap.fromTo(
        section,
        { opacity: 0, y: 24 },
        {
          opacity: 1,
          y: 0,
          duration: 0.5,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: section,
            start: 'top 85%',
            toggleActions: 'play none none reverse'
          }
        }
      );
    });

    // ===== ITEMS FADE IN =====
    const items = document.querySelectorAll('.item, .project-card, .post-card');
    items.forEach((item, index) => {
      gsap.fromTo(
        item,
        { opacity: 0, y: 16 },
        {
          opacity: 1,
          y: 0,
          duration: 0.4,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: item,
            start: 'top 88%',
            toggleActions: 'play none none reverse'
          },
          delay: (index % 4) * 0.04
        }
      );
    });

    // ===== HERO ENTRANCE =====
    const heroElements = document.querySelectorAll('.hero-animate');
    heroElements.forEach((element, index) => {
      gsap.fromTo(
        element,
        { opacity: 0, y: 16 },
        {
          opacity: 1,
          y: 0,
          duration: 0.5,
          ease: 'power2.out',
          delay: 0.15 + index * 0.06
        }
      );
    });
  };

  void initSkatingEffects();
</script>
