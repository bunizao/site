---
// Reusable hover gloss: a glassy note that opens when the cursor enters the
// trigger(s) in the default slot, styled after the blog's "Not by AI" card.
//
// One card: an optional preview image is the card's header (full-bleed, rounded
// top), with the byline (avatar + name + date) and body paragraphs below it. The
// card floats free of the document flow — to the RIGHT of the trigger on wide
// screens, dropping BELOW it on narrow ones — so it never reserves blank space
// when closed.
//
// Triggers: tag any element inside the slot with `data-gloss-trigger`. If none
// are tagged, the whole root acts as the trigger. Behaviour is pointer-driven
// for fine pointers and tap-to-toggle on touch.
interface Props {
  /** Body paragraphs; `**...**` marks an emphasized phrase. */
  body: string[];
  authorName: string;
  authorAvatar: string;
  /** Static byline stamp (e.g. a date). When omitted, a live local clock ticks. */
  time?: string;
  /** Optional preview image. When absent the image frame is not rendered. */
  image?: string;
  imageAlt?: string;
  /** Accessible label for the note region. */
  label?: string;
  class?: string;
}

const { body, authorName, authorAvatar, time, image, imageAlt = '', label, class: className } = Astro.props;

// Split a `**...**`-marked string into bold/plain segments for rendering.
const segments = (text: string) =>
  text.split('**').map((seg, i) => ({ seg, bold: i % 2 === 1 }));
---

<span class:list={['gloss', className]} data-gloss>
  <slot />

  <span class="gloss__pop" data-gloss-pop role="note" aria-label={label}>
    <span class="gloss__card">
      {image && (
        <span class="gloss__image" aria-hidden="true">
          <img class="gloss__image-img" src={image} alt={imageAlt} loading="lazy" decoding="async" />
        </span>
      )}

      <span class="gloss__body">
        <span class="gloss__byline">
          <img
            class="gloss__avatar"
            src={authorAvatar}
            alt={authorName}
            width="32"
            height="32"
            loading="lazy"
            decoding="async"
          />
          <span class="gloss__meta">
            <span class="gloss__name">{authorName}</span>
            <span class="gloss__dot" aria-hidden="true">·</span>
            <time class="gloss__time" data-gloss-time>{time}</time>
          </span>
        </span>
        <span class="gloss__prose">
          {body.map((para) => (
            <span class="gloss__p">
              {segments(para).map(({ seg, bold }) =>
                bold ? <strong class="gloss__em">{seg}</strong> : seg,
              )}
            </span>
          ))}
        </span>
      </span>
    </span>
  </span>
</span>

<style>
  .gloss {
    position: relative;
    display: inline-block;
  }

  /* The card floats free of the flow so it never reserves blank space when
     closed. Default (also the touch fallback): open to the RIGHT of the trigger,
     top-aligned, with padding-left as the visual gap. On fine pointers the
     script promotes it to `is-floating` and pins it via JS (see below). */
  .gloss__pop {
    position: absolute;
    top: 0;
    left: 100%;
    z-index: 60;
    padding-left: 28px;
    width: max-content;
    pointer-events: none;
  }

  /* Fine pointers: the script portals the card to <body> (escaping the parallax
     wrapper's transform, which would otherwise break `fixed`) and pins it via JS
     so it is always fully on-screen next to the masthead, regardless of page
     scroll. State lives on the popover itself since it leaves the .gloss root. */
  :global(.gloss__pop.is-floating) {
    position: fixed;
    top: 0;
    left: 0;
    padding-left: 0;
  }

  /* The card itself stays interactive while open so the cursor can move onto it
     and scroll — that's what keeps a too-tall card from closing on scroll. */
  :global(.gloss__pop.is-open) .gloss__card {
    pointer-events: auto;
    opacity: 1;
    transform: translateY(0);
  }

  /* One card holding everything: image header + text body share a single frame.
     Clamp the height as a last line of defense when real copy runs taller than
     the viewport; overflow still clips the full-bleed image to the rounded top
     corners. */
  .gloss__card {
    display: block;
    overflow: auto;
    width: min(380px, calc(100vw - 32px));
    max-height: calc(100vh - 32px);
    border-radius: 14px;
    border: 1px solid hsl(var(--foreground) / 0.08);
    background: hsl(var(--card) / 0.74);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    backdrop-filter: blur(18px) saturate(160%);
    box-shadow:
      0 12px 32px -18px hsl(var(--foreground) / 0.22),
      inset 0 1px 0 hsl(0 0% 100% / 0.04);
    text-align: left;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.22s ease,
      transform 0.32s cubic-bezier(0.25, 1, 0.3, 1);
  }

  /* Full-bleed image header, flush to the card edges. */
  .gloss__image {
    display: block;
  }

  .gloss__image-img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    height: auto;
    object-fit: cover;
    /* A hairline under the image separating it from the body. */
    border-bottom: 1px solid hsl(var(--foreground) / 0.08);
  }

  .gloss__body {
    display: block;
    padding: 16px 18px;
  }

  .gloss__byline {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .gloss__avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    flex: none;
  }

  .gloss__meta {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 13.5px;
    font-family: var(--font-sans);
  }

  .gloss__name {
    font-weight: 600;
    color: hsl(var(--foreground));
  }

  .gloss__dot {
    color: hsl(var(--muted-foreground) / 0.5);
  }

  .gloss__time {
    color: hsl(var(--muted-foreground) / 0.7);
    font-variant-numeric: tabular-nums;
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .gloss__prose {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-family: var(--font-sans);
  }

  .gloss__p {
    margin: 0;
    font-size: 14px;
    font-weight: 350;
    line-height: 1.6;
    letter-spacing: -0.008em;
    color: hsl(var(--foreground) / 0.82);
    text-wrap: pretty;
  }

  .gloss__em {
    font-weight: 500;
    color: hsl(var(--foreground));
  }

  /* Narrow screens / touch: there's no room to the right, so the panel drops
     directly below the trigger. Still absolute (never reserves flow space, so
     no blank gap on mobile when closed) and full-width-capped. */
  @media (max-width: 767px) {
    .gloss__pop {
      top: 100%;
      left: 0;
      padding-left: 0;
      padding-top: 14px;
      width: min(360px, calc(100vw - 32px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gloss__card {
      transition: opacity 0.2s ease;
      transform: none;
    }
    :global(.gloss__pop.is-open) .gloss__card {
      transform: none;
    }
  }
</style>

<script>
  const fine = window.matchMedia?.('(hover: hover) and (pointer: fine)').matches ?? false;
  const GAP = 28; // visual gap between the trigger and the floating card
  const MARGIN = 16; // viewport edge breathing room

  document.querySelectorAll<HTMLElement>('[data-gloss]').forEach((root) => {
    const pop = root.querySelector<HTMLElement>('[data-gloss-pop]');
    const card = root.querySelector<HTMLElement>('.gloss__card');
    const timeEl = root.querySelector<HTMLTimeElement>('[data-gloss-time]');
    const tagged = Array.from(root.querySelectorAll<HTMLElement>('[data-gloss-trigger]'));
    const triggers = tagged.length ? tagged : [root];
    if (!pop || !card) return;

    // Fine pointers float the card with JS-pinned `fixed` coordinates. The home
    // page's parallax wrapper transforms an ancestor, which would re-root `fixed`
    // to that ancestor — so portal the card to <body> to escape it (same trick as
    // the blog's PostHover). Touch keeps the card in-flow under the masthead.
    if (fine) document.body.appendChild(pop);

    // Byline clock: the reader's own time, ticking while the card is open. Skips
    // entirely when the byline already carries a static stamp (e.g. a date).
    if (timeEl && !timeEl.textContent?.trim()) {
      const tick = () => {
        const now = new Date();
        timeEl.textContent = now.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
        timeEl.dateTime = now.toISOString();
      };
      tick();
      setInterval(tick, 30_000);
    }

    // Pin the fixed card next to the trigger, clamped so the whole card stays on
    // screen. Falls back to dropping below the trigger when the right gutter is
    // too narrow. Called on open and on every scroll/resize while open, so the
    // card follows the masthead instead of getting clipped or scrolled away.
    const place = () => {
      const t = root.getBoundingClientRect();
      const w = card.offsetWidth;
      const h = card.offsetHeight;
      let left = t.right + GAP;
      let top: number;
      if (left + w <= window.innerWidth - MARGIN) {
        // Right of the masthead, top-aligned but clamped fully into view.
        top = Math.min(Math.max(t.top, MARGIN), window.innerHeight - h - MARGIN);
      } else {
        // No room on the right: drop below the masthead, clamped horizontally.
        left = Math.min(Math.max(t.left, MARGIN), window.innerWidth - w - MARGIN);
        top = Math.min(t.bottom + 14, window.innerHeight - h - MARGIN);
      }
      pop.style.left = `${Math.round(left)}px`;
      pop.style.top = `${Math.round(Math.max(top, MARGIN))}px`;
    };

    let placeRaf = 0;
    const queuePlace = () => {
      if (!placeRaf) placeRaf = requestAnimationFrame(() => {
        placeRaf = 0;
        place();
      });
    };

    let isOpen = false;
    const setOpen = (open: boolean) => {
      if (open === isOpen) return;
      isOpen = open;
      // Drives card visibility (on the popover, which may be portaled) and the
      // section's z-index lift for the in-flow touch case (on the root).
      pop.classList.toggle('is-open', open);
      root.classList.toggle('is-open', open);
      if (!fine) return;
      pop.classList.toggle('is-floating', open);
      if (open) {
        place();
        window.addEventListener('scroll', queuePlace, { passive: true });
        window.addEventListener('resize', queuePlace);
      } else {
        window.removeEventListener('scroll', queuePlace);
        window.removeEventListener('resize', queuePlace);
      }
    };

    // Grace timer bridges the empty gap between the trigger and the card: leaving
    // either one schedules a close, but landing on the other cancels it — so the
    // cursor can travel onto the card and scroll without it snapping shut.
    let closeTimer = 0;
    const cancelClose = () => {
      if (closeTimer) { clearTimeout(closeTimer); closeTimer = 0; }
    };
    const scheduleClose = () => {
      cancelClose();
      closeTimer = window.setTimeout(() => setOpen(false), 160);
    };

    triggers.forEach((trigger) => {
      const triggerLink = trigger.closest<HTMLAnchorElement>('a[href]');
      trigger.addEventListener('pointerenter', () => {
        if (!fine) return;
        cancelClose();
        setOpen(true);
      });
      trigger.addEventListener('pointerleave', () => {
        if (fine) scheduleClose();
      });
      // Touch has no hover state, so tap toggles instead.
      trigger.addEventListener('click', (event) => {
        if (fine) return;
        if (isOpen && triggerLink) {
          setOpen(false);
          return;
        }
        event.preventDefault();
        setOpen(!isOpen);
      });
    });

    // The card is the interactive surface (the wrapper is pointer-events:none),
    // so the keep-open listeners live here: reaching it cancels the close.
    card.addEventListener('pointerenter', () => {
      if (fine) cancelClose();
    });
    card.addEventListener('pointerleave', () => {
      if (fine) scheduleClose();
    });
  });
</script>
