---
// Site-wide ⌘K command palette. Same architecture as the blog's Pagefind shell:
// a native <dialog> (top layer, focus trap, Esc for free) plus a small vanilla
// script — no cmdk, no island, no hydration. Groups render statically at build
// time from the site's existing sources (navLinks, profile.links); the Writing
// rows hydrate from the prerendered /palette.json on first open so SSR pages
// (the mood surface) never pay a Ghost fetch for the palette.
//
// "Ask AI" rows are plain anchors deep-linking into ChatGPT/Claude/Perplexity
// with a prompt that points the model at /llms.txt for site context. The href
// is rebuilt on each keystroke so the typed query rides along — real anchors,
// so ⌘-click and middle-click still work. They are exempt from filtering: when
// nothing local matches, the palette collapses to just the Ask AI group, which
// doubles as the empty state ("no result? ask an assistant instead").
import {
  Home,
  Layers,
  FileText,
  Smile,
  LayoutGrid,
  Search,
  Mail,
  Check,
  Send,
  Sun,
  Moon,
  Monitor,
  Palette,
  Bell,
  X,
  LoaderCircle,
} from 'lucide-react';
import {
  GitHubIcon,
  InstagramIcon,
  OpenAIIcon,
  ClaudeIcon,
  PerplexityIcon,
} from '@/components/icons';
import Kbd from '@/components/Kbd.astro';
import { blogPalette, meta, navLinks, profile } from '@/data/site';
import type { ComponentType } from 'react';

type IconComponent = ComponentType<{ className?: string }>;

// Context line handed to the assistant. Points it at /llms.txt (an index of the
// site's projects, writing, and pages) so answers are grounded in real content
// rather than guesses. The typed query becomes the actual question below; with
// no query this line stands alone as an open invitation to explore.
const AI_CONTEXT = `I'm on buxx.me, the personal site of Lucian (aka Bunizao). Fetch ${meta.siteUrl}/llms.txt — it indexes his projects, writing, and pages as markdown — and use it as context.`;

const aiTargets = [
  { name: 'ChatGPT', base: 'https://chatgpt.com/?q=', icon: OpenAIIcon },
  { name: 'Claude', base: 'https://claude.ai/new?q=', icon: ClaudeIcon },
  { name: 'Perplexity', base: 'https://www.perplexity.ai/search?q=', icon: PerplexityIcon },
];

// Blog and Email are covered by their own rows (Writing group, Copy email).
const socials = profile.links.filter((l) => l.name !== 'Blog' && l.name !== 'Email');
const socialIcons: Record<string, IconComponent> = {
  GitHub: GitHubIcon,
  Telegram: Send,
  Instagram: InstagramIcon,
};

const navIcons: Record<string, IconComponent> = {
  '/projects': Layers,
  '/blog': FileText,
  '/mood': Smile,
  '/components': LayoutGrid,
};
const navKeywords: Record<string, string> = {
  '/': 'home start 主页',
  '/projects': 'projects work 项目',
  '/blog': 'blog writing posts 博客 無人之境',
  '/mood': 'moods timeline feed 心情',
  '/components': 'components ui specimens 组件',
};

// Vim-style "go to" shortcuts (GitHub's g-then-key): press g, then the letter,
// to jump to that page from anywhere. This map is the single source of truth —
// the nav rows render its keycaps and the script binds the handler from the DOM.
const navShortcuts: Record<string, string> = {
  '/': 'H',
  '/projects': 'P',
  '/blog': 'B',
  '/mood': 'M',
  '/components': 'C',
};

// Subscribe opens the real notify form (email + RSS in one). This href is the
// progressive fallback; when the current page already carries a subscribe panel
// the script opens it inline instead of navigating.
const subscribeHref = '/mood/subscribe';
const searchHighlight = blogPalette.ji;

// The palette's styles are not render-blocking; the script below loads them.
// Only a dynamic `?url` import in frontmatter stays out of <head>: Astro hoists
// every other form of CSS import into every page that renders this component.
const stylesheetHref = (await import('@/styles/command-palette.css?url')).default;
---

<dialog
  id="site-command-palette"
  class="cmdk"
  style={`--cmdk-highlight:${searchHighlight.light};--cmdk-highlight-dark:${searchHighlight.dark}`}
  data-command-palette
  data-stylesheet={stylesheetHref}
  data-ai-context={AI_CONTEXT}
  aria-label="Site search and commands"
>
  <div class="cmdk-panel">
    <div class="cmdk-input-row">
      <Search className="cmdk-input-icon" aria-hidden="true" />
      <input
        type="text"
        data-command-input
        placeholder="Search…"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        aria-label="Search commands"
        role="combobox"
        aria-expanded="true"
        aria-controls="cmdk-list"
        aria-autocomplete="list"
      />
      <button class="cmdk-close" type="button" data-command-close aria-label="Close">
        <X aria-hidden="true" />
      </button>
    </div>

    <div class="cmdk-body">
      <!-- Progressive blur: rows dissolve as they scroll under the input and
           over the footer instead of hitting a hard clip line. Two stacked
           backdrop-blur layers (strong + soft) with offset masks give the
           falloff; the ::after gradient carries the color fade. -->
      <div class="cmdk-scrim cmdk-scrim--top" aria-hidden="true"><span></span><span></span></div>
      <div class="cmdk-list" id="cmdk-list" data-command-list role="listbox" aria-label="Commands">
      <div class="cmdk-group" role="group" data-command-group data-group="navigation">
        <div class="cmdk-heading">Navigation</div>
        <a class="cmdk-item" role="option" data-command-item data-shortcut="H" data-haystack={`home ${navKeywords['/']}`} href="/">
          <Home className="cmdk-icon" aria-hidden="true" />
          <span class="cmdk-label">Home</span>
          <span class="cmdk-shortcut" aria-hidden="true"><kbd>G</kbd><kbd>H</kbd></span>
        </a>
        {navLinks.map((link) => {
          const Icon = navIcons[link.href] ?? Home;
          const haystack = `${link.label.toLowerCase()} ${navKeywords[link.href] ?? ''}`;
          const shortcut = navShortcuts[link.href];
          return (
            <a class="cmdk-item" role="option" data-command-item data-shortcut={shortcut} data-haystack={haystack} href={link.href}>
              <Icon className="cmdk-icon" aria-hidden="true" />
              <span class="cmdk-label">{link.label}</span>
              {shortcut && (
                <span class="cmdk-shortcut" aria-hidden="true"><kbd>G</kbd><kbd>{shortcut}</kbd></span>
              )}
            </a>
          );
        })}      </div>

      <!-- Writing: recent posts when idle, live Pagefind results while typing.
           The two mounts never show at once — the script swaps them by query. -->
      <div class="cmdk-group" role="group" data-command-group data-group="writing">
        <div class="cmdk-heading">Writing</div>
        <p class="cmdk-status" data-writing-status role="status" aria-live="polite" hidden>
          <LoaderCircle className="cmdk-status-icon" aria-hidden="true" />
          <span class="cmdk-status-text">Searching…</span>
        </p>
        <div data-command-posts style="display: contents"></div>
        <div data-command-writing style="display: contents"></div>
      </div>

      <!-- Moods: pure search — no browse list, so it stays collapsed until a
           query returns FTS hits (or a status while it fetches). -->
      <div class="cmdk-group" role="group" data-command-group data-group="moods">
        <div class="cmdk-heading">Moods</div>
        <p class="cmdk-status" data-moods-status role="status" aria-live="polite" hidden>
          <LoaderCircle className="cmdk-status-icon" aria-hidden="true" />
          <span class="cmdk-status-text">Searching…</span>
        </p>
        <div data-command-moods style="display: contents"></div>
      </div>

      <div class="cmdk-group" role="group" data-command-group data-group="actions">
        <div class="cmdk-heading">Actions</div>
        <button
          class="cmdk-item"
          type="button"
          role="option"
          data-command-item
          data-command-copy={profile.email}
          data-haystack="copy email contact mail 邮箱 联系"
        >
          <span class="cmdk-icon cmdk-icon-swap" aria-hidden="true">
            <Mail className="cmdk-icon-default" />
            <Check className="cmdk-icon-copied" />
          </span>
          <span class="cmdk-label">Copy email</span>
        </button>
        <!-- Theme lives as an inline segmented control, not three rows: it is one
             setting with three states, so it reads as a switch. Row is a single
             option for ↑/↓; ←/→ move the segment when the row is active; mouse
             clicks a segment directly. Active segment mirrors themeSetting. -->
        <div
          class="cmdk-item cmdk-item--segmented"
          role="option"
          data-command-item
          data-command-segmented
          data-haystack="theme appearance mode light dark system 主题 亮色 暗色 跟随系统"
        >
          <Palette className="cmdk-icon" aria-hidden="true" />
          <span class="cmdk-label">Appearance</span>
          <span class="cmdk-segments" role="group" aria-label="Theme">
            <button class="cmdk-seg" type="button" data-theme-seg="light" role="radio" aria-checked="false" aria-label="Light" title="Light">
              <Sun aria-hidden="true" />
            </button>
            <button class="cmdk-seg" type="button" data-theme-seg="dark" role="radio" aria-checked="false" aria-label="Dark" title="Dark">
              <Moon aria-hidden="true" />
            </button>
            <button class="cmdk-seg" type="button" data-theme-seg="system" role="radio" aria-checked="false" aria-label="System" title="System">
              <Monitor aria-hidden="true" />
            </button>
          </span>
        </div>
        <!-- One Subscribe entry, not scattered RSS links: it opens the notify
             form (email + channels + RSS in one). The href is the no-JS/new-tab
             fallback; the script opens the in-page panel inline when present. -->
        <a
          class="cmdk-item"
          role="option"
          data-command-item
          data-command-subscribe
          data-haystack="subscribe notify email newsletter rss feed 订阅 邮件 通知 博客 心情"
          href={subscribeHref}
        >
          <Bell className="cmdk-icon" aria-hidden="true" />
          <span class="cmdk-label">Subscribe</span>
        </a>
      </div>

      <div class="cmdk-group" role="group" data-command-group data-group="connect">
        <div class="cmdk-heading">Connect</div>
        {socials.map((link) => {
          const Icon = socialIcons[link.name] ?? Send;
          // Filled brand glyphs (GitHub/Instagram) get the optical shrink;
          // Telegram uses a lucide stroke icon that already matches.
          const iconClass = link.name === 'Telegram' ? 'cmdk-icon' : 'cmdk-icon cmdk-icon-brand';
          return (
            <a
              class="cmdk-item"
              role="option"
              data-command-item
              data-external
              data-haystack={`${link.name.toLowerCase()} ${link.handle.toLowerCase()} social 社交`}
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon className={iconClass} aria-hidden="true" />
              <span class="cmdk-label">{link.name}</span>
            </a>
          );
        })}
      </div>

      <!-- Ask AI is the escape hatch, so it sits last: when nothing local
           matches, every other group collapses and this is what remains. -->
      <div class="cmdk-group" role="group" data-command-group data-group="ai">
        <div class="cmdk-heading">
          <span>Ask AI</span>
          <span class="cmdk-heading-query" data-ai-query aria-hidden="true"></span>
        </div>
        {aiTargets.map((t) => (
          <a
            class="cmdk-item"
            role="option"
            data-command-item
            data-command-ai
            data-external
            data-ai-base={t.base}
            href={t.base + encodeURIComponent(AI_CONTEXT)}
            target="_blank"
            rel="noopener noreferrer"
          >
            <t.icon className="cmdk-icon cmdk-icon-brand" aria-hidden="true" />
            <span class="cmdk-label">Ask {t.name}</span>
          </a>
        ))}
      </div>
      </div>
      <div class="cmdk-scrim cmdk-scrim--bottom" aria-hidden="true"><span></span><span></span></div>
    </div>

    <div class="cmdk-footer" aria-hidden="true">
      <span><span data-footer-verb>Go to page</span> <Kbd>↵</Kbd></span>
      <span class="cmdk-footer-sep"></span>
      <span>Exit <Kbd>esc</Kbd></span>
    </div>
  </div>
</dialog>

<script>
  import { getMoodFeedAnchorHref } from '@/features/mood/shared/feed-anchor';
  import { formatMoodResultTime, isSafeSnippetHtml, searchMoods } from '@/features/mood/shared/search';
  import { feedback } from '@/lib/feedback';

  interface WritingHit {
    title: string;
    url: string;
    excerpt: string;
  }

  (() => {
    const dialog = document.querySelector<HTMLDialogElement>('[data-command-palette]');
    if (!dialog) return;
    const input = dialog.querySelector<HTMLInputElement>('[data-command-input]');
    const listEl = dialog.querySelector<HTMLElement>('[data-command-list]');
    const groups = Array.from(dialog.querySelectorAll<HTMLElement>('[data-command-group]'));
    const aiLinks = Array.from(dialog.querySelectorAll<HTMLAnchorElement>('[data-command-ai]'));
    const postsMount = dialog.querySelector<HTMLElement>('[data-command-posts]');
    const writingMount = dialog.querySelector<HTMLElement>('[data-command-writing]');
    const moodsMount = dialog.querySelector<HTMLElement>('[data-command-moods]');
    const writingStatus = dialog.querySelector<HTMLElement>('[data-writing-status]');
    const moodsStatus = dialog.querySelector<HTMLElement>('[data-moods-status]');
    const aiContext = dialog.dataset.aiContext ?? '';
    const aiQueryEcho = dialog.querySelector<HTMLElement>('[data-ai-query]');
    const footerVerb = dialog.querySelector<HTMLElement>('[data-footer-verb]');
    if (!input) return;

    // A closed <dialog> has no layout, so its styles had no business holding
    // up every page's first paint. Fetch them now: deferred scripts run after
    // the page's own stylesheets have arrived, so this never competes with
    // them. An open that beats the download waits for it instead of showing
    // an unstyled sheet.
    let stylesheetLoaded = false;
    const stylesheet = new Promise<void>((resolve) => {
      const href = dialog.dataset.stylesheet;
      if (!href) return resolve();
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = href;
      link.addEventListener('load', () => resolve());
      link.addEventListener('error', () => resolve());
      document.head.appendChild(link);
    }).then(() => {
      stylesheetLoaded = true;
    });

    let items: HTMLElement[] = [];
    let visible: HTMLElement[] = [];
    let activeIndex = 0;

    // Search scope follows the surface you opened from: on /blog you're looking
    // for posts, on /mood for moods — so the live search runs only that backend
    // and the placeholder names it. Everywhere else it's a global search.
    type SearchScope = 'writing' | 'moods' | 'all';
    let searchScope: SearchScope = 'all';
    const resolveScope = (): SearchScope => {
      const path = window.location.pathname;
      if (path.startsWith('/mood')) return 'moods';
      if (path.startsWith('/blog')) return 'writing';
      return 'all';
    };
    const SCOPE_PLACEHOLDER: Record<SearchScope, string> = {
      writing: 'Search posts…',
      moods: 'Search moods…',
      all: 'Search posts, moods, commands…',
    };

    // Inline theme switch. The Appearance row is a single option in ↑/↓ nav;
    // its three segments are a radio group driven by the Layout theme
    // controller — clicking a segment (or ←/→ while the row is active) just
    // clicks the matching [data-theme-option], reusing its storage + class
    // toggling. The shared controller writes localStorage synchronously while
    // the html dataset can lag behind a deferred view-transition callback.
    const themeOrder = ['light', 'dark', 'system'];
    const segButtons = Array.from(dialog.querySelectorAll<HTMLElement>('[data-theme-seg]'));
    const currentTheme = () => {
      try {
        const stored = localStorage.getItem('theme');
        if (stored === 'light' || stored === 'dark') return stored;
      } catch {
        // Storage can be blocked in private browsing contexts.
      }
      return 'system';
    };
    const syncSegments = () => {
      const cur = currentTheme();
      segButtons.forEach((b) => b.setAttribute('aria-checked', String(b.dataset.themeSeg === cur)));
    };
    const setTheme = (theme: string) => {
      const option = document.querySelector<HTMLElement>(`[data-theme-option="${theme}"]`);
      if (option) {
        option.click();
      } else {
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = theme === 'dark' || (theme === 'system' && prefersDark);
        document.documentElement.dataset.themeSetting = theme;
        document.documentElement.classList.toggle('dark', isDark);
        try {
          if (theme === 'system') localStorage.removeItem('theme');
          else localStorage.setItem('theme', theme);
        } catch {
          // Keep the in-memory theme when storage is unavailable.
        }
      }
      syncSegments();
    };
    const moveSegment = (dir: number) => {
      const idx = themeOrder.indexOf(currentTheme());
      const base = idx < 0 ? themeOrder.length - 1 : idx;
      setTheme(themeOrder[(base + dir + themeOrder.length) % themeOrder.length]);
    };
    segButtons.forEach((b) => {
      b.addEventListener('click', (event) => {
        event.stopPropagation(); // don't bubble to the row (would be a no-op) or backdrop
        if (b.dataset.themeSeg) setTheme(b.dataset.themeSeg);
      });
    });

    // Progressive-blur scrims are tied to real scroll affordance: the top band
    // appears only once rows have scrolled up out of view, the bottom band only
    // while more rows sit below the fold. At rest with nothing clipped, neither
    // blurs — so content is never softened without reason. (listEl is grabbed
    // once at the top of the closure.)
    const bodyEl = dialog.querySelector<HTMLElement>('.cmdk-body');
    const updateScrims = () => {
      if (!listEl || !bodyEl) return;
      bodyEl.classList.toggle('is-scrolled-top', listEl.scrollTop > 2);
      bodyEl.classList.toggle(
        'is-scrolled-bottom',
        listEl.scrollTop + listEl.clientHeight < listEl.scrollHeight - 2,
      );
    };
    listEl?.addEventListener('scroll', updateScrims, { passive: true });

    // Match/ranking seam: return 0 to hide a row, anything higher to show it.
    // Plain substring today; word-prefix or fuzzy scoring slots in here
    // without touching the rest of the palette.
    const matchScore = (query: string, haystack: string): number => {
      if (!query) return 1;
      return haystack.includes(query) ? 1 : 0;
    };

    // The footer carries the enter affordance for the whole list (replacing a
    // per-row ↵), so its verb tracks what Enter will actually do on the active
    // row: navigate, copy, subscribe, open externally, or flip the theme.
    const updateFooterAction = (el: HTMLElement | undefined) => {
      if (!footerVerb || !el) return;
      let verb = 'Go to page';
      if (el.hasAttribute('data-command-copy')) verb = 'Copy';
      else if (el.hasAttribute('data-command-subscribe')) verb = 'Subscribe';
      else if (el.hasAttribute('data-command-segmented')) verb = 'Switch theme';
      else if (el.hasAttribute('data-command-ai') || el.hasAttribute('data-external')) verb = 'Open';
      footerVerb.textContent = verb;
    };

    const setActive = (index: number, scroll = true) => {
      if (visible.length === 0) return;
      activeIndex = Math.max(0, Math.min(index, visible.length - 1));
      const activeEl = visible[activeIndex];
      items.forEach((el) => {
        el.classList.toggle('is-active', el === activeEl);
        el.setAttribute('aria-selected', el === activeEl ? 'true' : 'false');
      });
      input.setAttribute('aria-activedescendant', activeEl.id);
      updateFooterAction(activeEl);
      if (scroll) activeEl.scrollIntoView({ block: 'nearest' });
    };

    // Question first, context second — the model reads the ask, then grounds it
    // in the site. With no query, give it a real default task instead of a bare
    // context blurb (which would open the assistant with nothing to answer).
    const updateQueryTargets = (query: string) => {
      const text = query
        ? `${query}\n\n${aiContext}`
        : `Give me a quick tour of this site — who Lucian is, what he's building, and what he writes about.\n\n${aiContext}`;
      aiLinks.forEach((a) => {
        const base = a.dataset.aiBase;
        if (base) a.href = base + encodeURIComponent(text);
      });
      // Echo the typed question next to the "Ask AI" heading so the rows read as
      // "ask THIS", not a generic export. Empty query → the label stays bare.
      if (aiQueryEcho) aiQueryEcho.textContent = query ? `“${query}”` : '';
    };

    const filter = () => {
      const query = input.value.trim().toLowerCase();
      const searching = query.length > 0;
      const prevActive = visible[activeIndex];
      items.forEach((el) => {
        // Always-visible rows: the Ask AI escape hatch and live server results
        // (already ranked by their backend — never substring-hidden here).
        if (el.hasAttribute('data-command-ai') || el.hasAttribute('data-command-live')) {
          el.hidden = false;
          return;
        }
        // Recent-writing rows fill the idle state only; once a query is typed,
        // live results take their place. They're writing content, so they stay
        // out of the moods-scoped surface entirely.
        if (el.hasAttribute('data-command-recent')) {
          el.hidden = searching || searchScope === 'moods';
          return;
        }
        el.hidden = matchScore(query, el.dataset.haystack ?? '') === 0;
      });
      groups.forEach((group) => {
        const hasItem = Boolean(group.querySelector('[data-command-item]:not([hidden])'));
        const status = group.querySelector<HTMLElement>('.cmdk-status');
        const hasStatus = Boolean(status && !status.hidden);
        group.hidden = !(hasItem || hasStatus);
      });
      visible = items.filter((el) => !el.hidden);
      // Selection preference:
      //  - if the user has moved to a real (non-AI) row that survives the
      //    re-render, keep them there — don't yank focus as results stream in;
      //  - otherwise prefer the first real result, so when live results replace
      //    the Ask-AI fallback the top hit takes the highlight, not the fallback;
      //  - only fall back to row 0 (an Ask AI row) when nothing real is visible.
      const firstReal = visible.findIndex((el) => !el.hasAttribute('data-command-ai'));
      const onRealRow = prevActive && !prevActive.hasAttribute('data-command-ai');
      const kept = onRealRow ? visible.indexOf(prevActive) : -1;
      const target = kept >= 0 ? kept : firstReal >= 0 ? firstReal : 0;
      setActive(target, searching);
      updateScrims();
    };

    // --- Live full-text search --------------------------------------------
    // Writing = Pagefind (a build-time static index at /pagefind/); Moods = the
    // archive FTS endpoint. Both render as live rows inside the palette — no
    // second dialog, no page navigation. Pagefind is absent in dev, so it falls
    // back to substring-matching the recent-post list and the group still
    // responds while typing.
    const SEARCH_DEBOUNCE_MS = 200;
    const REMOTE_MIN_LENGTH = 2;
    const RESULT_LIMIT = 6;
    let recentPosts: Array<{ title: string; path: string }> = [];
    let searchTimer: number | undefined;
    let searchGeneration = 0;
    let moodController: AbortController | null = null;

    const PAGEFIND_URL = '/pagefind/pagefind.js';
    type PagefindModule = {
      search: (q: string) => Promise<{ results: Array<{ data: () => Promise<Record<string, any>> }> }>;
    };
    // Load the static Pagefind module once and cache the promise. On failure it
    // resolves to null (and stays cached), so an index-less dev build takes the
    // recent-post fallback without hammering /pagefind on every keystroke.
    let pagefindLoad: Promise<PagefindModule | null> | null = null;
    const ensurePagefind = (): Promise<PagefindModule | null> => {
      if (!pagefindLoad) {
        pagefindLoad = import(/* @vite-ignore */ PAGEFIND_URL)
          .then((mod) => mod as PagefindModule)
          .catch(() => null);
      }
      return pagefindLoad;
    };

    const FILE_ICON =
      '<svg class="cmdk-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>';
    const MOOD_ICON =
      '<svg class="cmdk-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" x2="9.01" y1="9" y2="9"/><line x1="15" x2="15.01" y1="9" y2="9"/></svg>';

    const buildResultRow = (opts: { href: string; title: string; snippet?: string; icon: string }) => {
      const a = document.createElement('a');
      a.className = 'cmdk-item cmdk-item--rich';
      a.setAttribute('role', 'option');
      a.dataset.commandItem = '';
      a.dataset.commandLive = '';
      a.href = opts.href;
      a.innerHTML = opts.icon;
      const col = document.createElement('span');
      col.className = 'cmdk-rich';
      const title = document.createElement('span');
      title.className = 'cmdk-rich-title';
      title.textContent = opts.title;
      col.appendChild(title);
      if (opts.snippet) {
        const sub = document.createElement('span');
        sub.className = 'cmdk-rich-sub';
        // Snippets are server-escaped except <mark>; re-verify before innerHTML.
        if (isSafeSnippetHtml(opts.snippet)) sub.innerHTML = opts.snippet;
        else sub.textContent = opts.snippet;
        col.appendChild(sub);
      }
      a.appendChild(col);
      wireItem(a);
      return a;
    };

    const clearMount = (mount: HTMLElement | null) => {
      mount?.replaceChildren();
    };

    const setSearching = (status: HTMLElement | null, searching: boolean) => {
      if (status) status.hidden = !searching;
    };

    const writingResults = async (query: string): Promise<WritingHit[]> => {
      const pf = await ensurePagefind();
      if (!pf) {
        const q = query.toLowerCase();
        return recentPosts
          .filter((post) => post.title.toLowerCase().includes(q))
          .slice(0, RESULT_LIMIT)
          .map((post) => ({ title: post.title, url: post.path, excerpt: '' }));
      }
      const search = await pf.search(query);
      const top = search.results.slice(0, RESULT_LIMIT);
      const data = await Promise.all(top.map((result) => result.data()));
      return data.map((entry) => ({
        title: (entry.meta && entry.meta.title) || entry.url,
        url: entry.url,
        excerpt: typeof entry.excerpt === 'string' ? entry.excerpt : '',
      }));
    };

    const renderWriting = (hits: WritingHit[]) => {
      clearMount(writingMount);
      hits.forEach((hit) =>
        writingMount?.appendChild(
          buildResultRow({ href: hit.url, title: hit.title, snippet: hit.excerpt, icon: FILE_ICON }),
        ),
      );
    };

    const renderMoods = (results: Awaited<ReturnType<typeof searchMoods>>) => {
      clearMount(moodsMount);
      results.forEach((item) =>
        moodsMount?.appendChild(
          buildResultRow({
            // Land in the L1 feed anchored at the post (/mood?id), not the L2
            // detail page — you drop into the timeline with surrounding context.
            href: getMoodFeedAnchorHref(item.id),
            title: formatMoodResultTime(item.datetime) || 'Mood',
            snippet: item.snippet,
            icon: MOOD_ICON,
          }),
        ),
      );
    };

    const clearRemote = () => {
      searchGeneration += 1; // invalidate any in-flight responses
      window.clearTimeout(searchTimer);
      moodController?.abort();
      moodController = null;
      clearMount(writingMount);
      clearMount(moodsMount);
      setSearching(writingStatus, false);
      setSearching(moodsStatus, false);
    };

    const runRemoteSearch = (raw: string) => {
      const query = raw.trim();
      window.clearTimeout(searchTimer);
      if (query.length < REMOTE_MIN_LENGTH) {
        clearRemote();
        collectItems();
        filter();
        return;
      }
      // Scope decides which backends fire: only Writing on /blog, only Moods on
      // /mood, both elsewhere. The out-of-scope group never even shows a status.
      const runWriting = searchScope !== 'moods';
      const runMoods = searchScope !== 'writing';
      searchTimer = window.setTimeout(() => {
        const generation = (searchGeneration += 1);
        setSearching(writingStatus, runWriting);
        setSearching(moodsStatus, runMoods);
        filter();

        const settle = () => {
          if (generation !== searchGeneration) return;
          collectItems();
          filter();
        };

        if (runWriting) {
          writingResults(query)
            .then((hits) => {
              if (generation !== searchGeneration) return;
              renderWriting(hits);
              setSearching(writingStatus, false);
              settle();
            })
            .catch(() => {
              if (generation !== searchGeneration) return;
              setSearching(writingStatus, false);
              settle();
            });
        }

        if (runMoods) {
          moodController?.abort();
          moodController = new AbortController();
          searchMoods(query, { signal: moodController.signal, limit: RESULT_LIMIT })
            .then((results) => {
              if (generation !== searchGeneration) return;
              renderMoods(results);
              setSearching(moodsStatus, false);
              settle();
            })
            .catch((error) => {
              if (generation !== searchGeneration) return;
              if (error instanceof DOMException && error.name === 'AbortError') return;
              setSearching(moodsStatus, false);
              settle();
            });
        }
      }, SEARCH_DEBOUNCE_MS);
    };

    // Promote the context's result group to the top: on /blog you reach for
    // posts, on /mood for moods — meet the reflex where the hand already is.
    const orderGroupsForContext = () => {
      if (!listEl) return;
      const path = window.location.pathname;
      let sequence = ['navigation', 'writing', 'moods', 'actions', 'connect', 'ai'];
      if (path.startsWith('/mood')) sequence = ['moods', 'navigation', 'writing', 'actions', 'connect', 'ai'];
      else if (path.startsWith('/blog')) sequence = ['writing', 'navigation', 'moods', 'actions', 'connect', 'ai'];
      sequence.forEach((name) => {
        const group = listEl.querySelector<HTMLElement>(`[data-command-group][data-group="${name}"]`);
        if (group) listEl.appendChild(group);
      });
    };

    const close = () => {
      if (!dialog.open) return;
      feedback.close();
      dialog.close();
    };

    const activate = (el: HTMLElement, event?: Event) => {
      // The Appearance row is a container for the segment radios; a click on its
      // body (not a segment) does nothing and never closes the palette.
      if (el.hasAttribute('data-command-segmented')) return;
      // Subscribe: prefer the current page's own notify panel so it opens inline
      // (mood, blog); close the palette first so the panel isn't hidden under the
      // top-layer dialog. With no panel here, let the anchor navigate to its
      // canonical subscribe surface instead.
      if (el.hasAttribute('data-command-subscribe')) {
        const toggle = document.querySelector<HTMLElement>('[data-subscribe-toggle]');
        if (toggle) {
          event?.preventDefault();
          close();
          void import('@/features/notify/subscribe-panel').then(({ initSubscribePanels }) => {
            initSubscribePanels();
            requestAnimationFrame(() => toggle.click());
          });
          return;
        }
      }
      const copy = el.dataset.commandCopy;
      if (copy) {
        const label = el.querySelector<HTMLElement>('.cmdk-label');
        navigator.clipboard
          ?.writeText(copy)
          .then(() => {
            feedback.success();
            if (!label || el.classList.contains('is-copied')) return;
            const original = label.textContent;
            el.classList.add('is-copied');
            label.textContent = 'Copied';
            window.setTimeout(() => {
              label.textContent = original;
              el.classList.remove('is-copied');
            }, 1400);
          })
          .catch(() => {});
        return; // stay open so the feedback is visible
      }
      close(); // links: let the default navigation proceed
    };

    const wireItem = (el: HTMLElement) => {
      // pointermove (not mouseenter) so keyboard scrolling under a resting
      // cursor doesn't steal the highlight.
      el.addEventListener('pointermove', () => {
        // The Appearance row isn't a mouse target; only its segments are.
        if (el.hasAttribute('data-command-segmented')) return;
        const index = visible.indexOf(el);
        if (index >= 0 && visible[activeIndex] !== el) setActive(index, false);
      });
      el.addEventListener('click', (event) => activate(el, event));
    };

    const collectItems = () => {
      items = Array.from(dialog.querySelectorAll<HTMLElement>('[data-command-item]'));
      items.forEach((el, i) => {
        el.id = `cmdk-item-${i}`;
        // Append the trailing affordance once. CSS draws ↗ on external rows from
        // the row's own attributes, so this is just an empty hook. The segmented
        // row owns its right edge (the switch) and nav rows own theirs (the go-to
        // keycaps), so neither gets a trail.
        if (
          !el.hasAttribute('data-command-segmented') &&
          !el.hasAttribute('data-shortcut') &&
          !el.querySelector('.cmdk-trail')
        ) {
          const trail = document.createElement('span');
          trail.className = 'cmdk-trail';
          trail.setAttribute('aria-hidden', 'true');
          el.appendChild(trail);
        }
      });
    };

    collectItems();
    items.forEach(wireItem);

    // Latest posts hydrate lazily from the prerendered /palette.json so SSR
    // pages never fetch Ghost content just to render the palette shell.
    let postsLoaded = false;
    const loadPosts = async () => {
      if (postsLoaded || !postsMount) return;
      postsLoaded = true;
      try {
        const res = await fetch('/palette.json');
        if (!res.ok) throw new Error(`palette.json ${res.status}`);
        const data = (await res.json()) as {
          posts?: Array<{ title: string; path: string }>;
        };
        // Keep the list in JS too: it doubles as the dev fallback source when
        // Pagefind's static index is absent (writingResults substring-matches).
        recentPosts = data.posts ?? [];
        recentPosts.forEach((post) => {
          const a = document.createElement('a');
          a.className = 'cmdk-item';
          a.setAttribute('role', 'option');
          a.dataset.commandItem = '';
          a.dataset.commandRecent = '';
          a.dataset.haystack = `${post.title.toLowerCase()} blog post 文章`;
          a.href = post.path;
          a.innerHTML =
            '<svg class="cmdk-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
            '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>' +
            '<span class="cmdk-label"></span>';
          a.querySelector('.cmdk-label')!.textContent = post.title;
          postsMount.appendChild(a);
          wireItem(a);
        });
        collectItems();
        filter();
      } catch {
        postsLoaded = false; // retry on next open
      }
    };

    const open = () => {
      if (dialog.open) return;
      if (!stylesheetLoaded) {
        void stylesheet.then(open);
        return;
      }
      searchScope = resolveScope();
      input.placeholder = SCOPE_PLACEHOLDER[searchScope];
      feedback.open();
      input.value = '';
      updateQueryTargets('');
      syncSegments();
      clearRemote();
      orderGroupsForContext();
      collectItems();
      filter();
      listEl?.scrollTo(0, 0);
      dialog.showModal();
      input.focus();
      // Dialog has no layout until it is shown, so measure scrims next frame.
      requestAnimationFrame(updateScrims);
      // Recent posts are writing content and the dev fallback source — skip the
      // fetch on the moods surface, where writing never shows.
      if (searchScope !== 'moods') void loadPosts();
    };

    input.addEventListener('input', () => {
      updateQueryTargets(input.value.trim());
      filter();
      runRemoteSearch(input.value);
    });

    dialog.addEventListener('keydown', (event) => {
      // When the Appearance row is the active option, ←/→ (and Enter) drive the
      // theme switch instead of the caret / row activation.
      const onSegmentRow = visible[activeIndex]?.hasAttribute('data-command-segmented');
      if (onSegmentRow && (event.key === 'ArrowLeft' || event.key === 'ArrowRight')) {
        event.preventDefault();
        moveSegment(event.key === 'ArrowRight' ? 1 : -1);
        return;
      }
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        feedback.tap();
        setActive(activeIndex + 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        feedback.tap();
        setActive(activeIndex - 1);
      } else if (event.key === 'Enter') {
        event.preventDefault();
        if (onSegmentRow) {
          moveSegment(1);
          return;
        }
        visible[activeIndex]?.click();
      }
    });

    // First Esc clears a typed query; only an empty palette closes. Browsers
    // may force the second consecutive Esc through regardless (close watcher
    // semantics), which is an acceptable fallback.
    dialog.addEventListener('cancel', (event) => {
      if (input.value) {
        event.preventDefault();
        input.value = '';
        updateQueryTargets('');
        clearRemote();
        collectItems();
        filter();
      }
    });

    dialog.querySelector('[data-command-close]')?.addEventListener('click', close);

    document.querySelectorAll<HTMLElement>('[data-command-open]').forEach((trigger) => {
      trigger.addEventListener('click', open);
    });

    // Backdrop click: the panel fills the dialog box, so a click whose target
    // is the dialog itself can only be on the backdrop.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) close();
    });

    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        dialog.open ? close() : open();
      }
    });

    // Vim-style "go to" navigation: press g, then a page key, from anywhere on
    // the site. The map is read from the nav rows' data-shortcut so the keycaps
    // shown in the palette and the live binding can never drift apart.
    const gMap = new Map<string, string>();
    dialog.querySelectorAll<HTMLAnchorElement>('[data-command-item][data-shortcut]').forEach((el) => {
      const key = el.dataset.shortcut?.toLowerCase();
      if (key) gMap.set(key, el.getAttribute('href') || '/');
    });
    const isTypingTarget = (target: EventTarget | null) => {
      const node = target as HTMLElement | null;
      if (!node) return false;
      const tag = node.tagName;
      return tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || node.isContentEditable;
    };
    let gPending = false;
    let gPendingInPalette = false;
    let gTimer: number | undefined;
    const insertPendingG = () => {
      input.setRangeText('g', input.selectionStart ?? 0, input.selectionEnd ?? 0, 'end');
      input.dispatchEvent(new InputEvent('input', { bubbles: true, data: 'g', inputType: 'insertText' }));
    };
    const resetGoTo = () => {
      gPending = false;
      gPendingInPalette = false;
      window.clearTimeout(gTimer);
    };
    document.addEventListener('keydown', (event) => {
      // Ignore modifier chords and editable controls. The palette input is the
      // one exception: when it is empty, the visible go-to hints should work.
      if (event.metaKey || event.ctrlKey || event.altKey || event.isComposing) return;
      const inEmptyPaletteInput = dialog.open && event.target === input && input.value === '';
      if (isTypingTarget(event.target) && !inEmptyPaletteInput) {
        resetGoTo();
        return;
      }
      const key = event.key.toLowerCase();
      if (gPending) {
        resetGoTo();
        const href = gMap.get(key);
        if (href) {
          event.preventDefault();
          window.location.href = href;
          return;
        }
        // We held the initial "g" back from an empty palette query. If the next
        // key is not a shortcut, restore it and let normal typing continue.
        if (inEmptyPaletteInput) {
          event.preventDefault();
          insertPendingG();
        }
        return;
      }
      if (key === 'g') {
        gPending = true;
        gPendingInPalette = inEmptyPaletteInput;
        if (inEmptyPaletteInput) event.preventDefault();
        gTimer = window.setTimeout(() => {
          if (gPendingInPalette) insertPendingG();
          resetGoTo();
        }, 1200);
      }
    });
  })();
</script>
