---
import dayjs from 'dayjs';

interface Tag {
  id: string;
  name: string;
  slug: string;
  visibility: 'public' | 'internal';
}

interface PostMeta {
  id: string;
  title: string;
  url: string;
  published_at: string;
  tags: Tag[];
}

const ghostUrl = import.meta.env.GHOST_URL || 'https://blog.buxx.me';

async function getLatestPosts(): Promise<PostMeta[]> {
  const apiKey = import.meta.env.GHOST_CONTENT_APIKEY;
  const apiUrl = `${ghostUrl}/ghost/api/v3/content/posts/?key=${apiKey}&limit=5&fields=id,title,url,published_at&include=tags&filter=visibility:public`;

  try {
    const res = await fetch(apiUrl);
    const result = await res.json();
    return result.posts || [];
  } catch (error) {
    console.error('Failed to fetch posts:', error);
    return [];
  }
}

const posts = await getLatestPosts();
---

<section id="writing-section" class="writing-section">
  <span class="section-label scroll-reveal">Writing</span>

  {posts.length > 0 ? (
    <div class="post-list">
      {posts.map((post, index) => {
        const primaryTag = post.tags?.find(t => t.visibility === 'public');
        return (
          <a href={post.url} target="_blank" rel="noopener noreferrer" class="post-item scroll-reveal-item" style={`--item-index: ${index}`}>
            <span class="post-title">{post.title}</span>
            <span class="post-meta">
              {primaryTag && (
                <span class="post-tag">{primaryTag.name}</span>
              )}
              <span class="post-date">{dayjs(post.published_at).format('YYYY.MM')}</span>
            </span>
          </a>
        );
      })}
    </div>
  ) : (
    <p class="text-sm text-muted-foreground">No posts yet.</p>
  )}

  <a
    href={ghostUrl}
    target="_blank"
    class="link scroll-reveal-link mt-6 text-sm text-muted-foreground"
  >
    Read all posts
  </a>
</section>

<style>
  .writing-section {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  .writing-section.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .scroll-reveal {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.4s ease-out, transform 0.4s ease-out;
  }

  .writing-section.is-visible .scroll-reveal {
    opacity: 1;
    transform: translateY(0);
  }

  .scroll-reveal-item {
    opacity: 0;
    transform: translateX(-20px);
    transition: opacity 0.4s ease-out, transform 0.4s ease-out, padding 0.15s ease;
  }

  .writing-section.is-visible .scroll-reveal-item {
    opacity: 1;
    transform: translateX(0);
    transition-delay: calc(var(--item-index) * 0.06s + 0.1s);
  }

  .scroll-reveal-link {
    opacity: 0;
    transition: opacity 0.4s ease-out;
  }

  .writing-section.is-visible .scroll-reveal-link {
    opacity: 1;
    transition-delay: 0.4s;
  }

  .post-list {
    display: flex;
    flex-direction: column;
  }

  .post-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 0;
    position: relative;
    transition: all 0.15s ease;
  }

  @media (min-width: 640px) {
    .post-item {
      flex-direction: row;
      justify-content: space-between;
      align-items: baseline;
      gap: 16px;
      padding: 14px 0;
    }
  }

  .post-item::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(to right, hsl(var(--foreground) / 0.1), transparent);
  }

  .post-item:last-child::after {
    display: none;
  }

  .post-item:hover {
    padding-left: 8px;
  }

  .post-title {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
  }

  .post-meta {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .post-meta {
      gap: 12px;
    }
  }

  .post-tag {
    font-size: 11px;
    font-weight: 400;
    color: hsl(var(--muted-foreground) / 0.7);
  }

  @media (min-width: 640px) {
    .post-tag {
      font-size: 12px;
    }
  }

  .post-date {
    font-size: 11px;
    font-weight: 300;
    color: hsl(var(--muted-foreground) / 0.5);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 640px) {
    .post-date {
      font-size: 12px;
    }
  }

  .post-item:hover .post-date,
  .post-item:hover .post-tag {
    color: hsl(var(--muted-foreground));
  }
</style>

<script>
  const writingSection = document.getElementById('writing-section');

  if (writingSection) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.1,
        rootMargin: '0px 0px -30px 0px'
      }
    );

    observer.observe(writingSection);
  }
</script>
