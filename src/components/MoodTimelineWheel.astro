---
// Timeline wheel - only the right arc visible at screen edge
// The wheel body is hidden off-screen, just the edge peeks in
---

<nav class="timeline-wheel" aria-label="Timeline navigation" data-timeline-wheel>
  <!-- Large wheel mostly hidden off-screen left -->
  <div class="timeline-wheel-dial" data-timeline-dial></div>
  <!-- Active date label -->
  <div class="timeline-wheel-label" data-timeline-label></div>
</nav>

<style>
  .timeline-wheel {
    position: fixed;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    /* Wheel is large but mostly off-screen */
    --wheel-size: 600px;
    --visible-width: 40px;
    width: var(--visible-width);
    height: 360px;
    z-index: 50;
    display: none;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
    overflow: visible;
  }

  .timeline-wheel.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  @media (min-width: 1024px) {
    .timeline-wheel {
      display: block;
    }
  }

  @media (min-width: 1280px) {
    .timeline-wheel {
      --wheel-size: 700px;
      --visible-width: 48px;
      height: 400px;
    }
  }

  @media (min-width: 1440px) {
    .timeline-wheel {
      --wheel-size: 800px;
      --visible-width: 56px;
      height: 440px;
    }
  }

  /* The rotating dial - positioned so only right edge shows */
  .timeline-wheel-dial {
    position: absolute;
    width: var(--wheel-size);
    height: var(--wheel-size);
    /* Center vertically, push left so only right arc visible */
    top: 50%;
    right: 0;
    transform: translateY(-50%);
    border-radius: 50%;
    /* Subtle arc appearance */
    border: 1px solid hsl(var(--foreground) / 0.06);
    will-change: transform;
  }

  /* Notch marks radiating from center */
  :global(.timeline-notch) {
    position: absolute;
    /* Position at right edge of wheel (3 o'clock position) */
    left: 50%;
    top: 50%;
    /* Notch dimensions */
    width: 20px;
    height: 2px;
    margin-top: -1px;
    background: hsl(var(--muted-foreground) / 0.2);
    border-radius: 1px;
    /* Rotate from wheel center */
    transform-origin: left center;
    transition: background 0.15s ease, width 0.15s ease;
  }

  :global(.timeline-notch.is-major) {
    width: 28px;
    height: 3px;
    margin-top: -1.5px;
    background: hsl(var(--muted-foreground) / 0.35);
  }

  :global(.timeline-notch.is-active) {
    background: hsl(var(--foreground));
  }

  :global(.timeline-notch.is-major.is-active) {
    width: 36px;
    background: hsl(var(--foreground));
  }

  /* Date label - floats next to visible arc */
  .timeline-wheel-label {
    position: absolute;
    left: calc(var(--visible-width) + 12px);
    top: 50%;
    transform: translateY(-50%);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: hsl(var(--foreground));
    white-space: nowrap;
    padding: 6px 10px;
    background: hsl(var(--background) / 0.9);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid hsl(var(--foreground) / 0.08);
    border-radius: 6px;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .timeline-wheel.is-visible .timeline-wheel-label {
    opacity: 1;
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .timeline-wheel-dial,
    :global(.timeline-notch),
    .timeline-wheel-label {
      transition: none;
    }
  }
</style>
