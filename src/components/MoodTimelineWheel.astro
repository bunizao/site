---
// Timeline wheel navigation for mood feed
// Displays dates as rotating markers, synced with scroll position
---

<nav class="timeline-wheel" aria-label="Timeline navigation" data-timeline-wheel>
  <div class="timeline-wheel-track" data-timeline-track>
    <div class="timeline-wheel-indicator" data-timeline-indicator></div>
    <!-- Date markers rendered dynamically via JS -->
  </div>
</nav>

<style>
  .timeline-wheel {
    position: fixed;
    left: calc(50% - 420px);
    top: 50%;
    transform: translateY(-50%);
    width: 72px;
    z-index: 50;
    display: none;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .timeline-wheel.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  @media (min-width: 1024px) {
    .timeline-wheel {
      display: block;
    }
  }

  @media (min-width: 1280px) {
    .timeline-wheel {
      left: calc(50% - 480px);
      width: 80px;
    }
  }

  @media (min-width: 1440px) {
    .timeline-wheel {
      left: calc(50% - 520px);
    }
  }

  .timeline-wheel-track {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0;
    position: relative;
    padding: 12px 0;
  }

  .timeline-wheel-indicator {
    position: absolute;
    right: 0;
    top: 12px;
    width: 3px;
    height: 24px;
    background: hsl(var(--foreground));
    border-radius: 2px;
    opacity: 0.9;
    transition: top 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 2;
  }

  :global(.timeline-wheel-item) {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    width: 100%;
    height: 28px;
    padding-right: 12px;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: hsl(var(--muted-foreground) / 0.4);
    cursor: pointer;
    transition: color 0.25s ease, transform 0.25s ease;
    text-align: right;
    white-space: nowrap;
    user-select: none;
  }

  :global(.timeline-wheel-item::after) {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 3px;
    background: hsl(var(--muted-foreground) / 0.2);
    border-radius: 50%;
    transition: all 0.25s ease;
  }

  :global(.timeline-wheel-item:hover) {
    color: hsl(var(--muted-foreground) / 0.7);
  }

  :global(.timeline-wheel-item:hover::after) {
    background: hsl(var(--muted-foreground) / 0.4);
    transform: translateY(-50%) scale(1.3);
  }

  :global(.timeline-wheel-item.is-active) {
    color: hsl(var(--foreground));
    transform: translateX(-2px);
  }

  :global(.timeline-wheel-item.is-active::after) {
    opacity: 0;
  }

  :global(.timeline-wheel-item:focus-visible) {
    outline: none;
    color: hsl(var(--foreground));
  }

  :global(.timeline-wheel-item:focus-visible::before) {
    content: '';
    position: absolute;
    inset: 2px;
    border: 1px solid hsl(var(--foreground) / 0.3);
    border-radius: 4px;
    pointer-events: none;
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .timeline-wheel,
    .timeline-wheel-indicator,
    :global(.timeline-wheel-item),
    :global(.timeline-wheel-item::after) {
      transition: none;
    }
  }
</style>
