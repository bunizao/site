---
import Typewriter from './Typewriter.astro';
import GitHubContributions from './GitHubContributions.astro';
import TechMarquee from './TechMarquee.astro';
import {Instagram, type LucideIcon} from 'lucide-react';
import { FileText, Github, Mail, Send } from 'lucide-react';

const socials: Array<{ name: string; url: string; icon: LucideIcon }> = [
  { name: 'Blog', url: 'https://blog.buxx.me', icon: FileText },
  { name: 'GitHub', url: 'https://tuu.cat/gh', icon: Github },
  { name: 'Email', url: 'mailto:me@buxx.me', icon: Mail },
  { name: 'Telegram', url: 'https://tuu.cat/tg', icon: Send },
  { name: 'Instagram', url: 'https://tuu.cat/ig', icon: Instagram}
];

const techRow1 = ['TypeScript', "JavaScript", 'Python', 'C#', 'C++', 'React', 'TailwindCSS', 'Astro'];
const techRow2 = ['Frontend', 'BGP', 'Proxy', 'Docker', 'Linux', 'Web3', 'Optimization'];
---

<header class="hero-section pt-14 pb-8 sm:pt-20 sm:pb-12">
  <!-- Status indicator -->
  <div class="animate-in">
    <div class="status mb-4">
      <span class="status-dot"></span>
      <span class="status-text-wrapper">
        <span class="status-text" id="status-text">Wondering</span>
      </span>
    </div>
  </div>

  <!-- Name -->
  <h1 class="animate-in delay-1 mb-2 text-[28px] font-semibold sm:text-[36px]">
    <Typewriter texts={["Lucian", "Bunizao", "Tutu", "Collapsar"]} speed={80} />
  </h1>

  <!-- Role -->
  <p class="animate-in delay-2 mb-6 text-sm text-muted-foreground">
    Student / Developer / Blogger
  </p>


  <!-- Bio -->
  <div class="animate-in delay-3 max-w-full sm:max-w-[520px]">
    <p class="text-[14px] leading-[1.7] text-muted-foreground sm:text-[15px]">
      I make interesting things.<br>
      Curious about <span class="text-foreground">frontend design</span>,
      <span class="text-foreground">proxy systems</span>, and
      contributing to <span class="text-foreground"> open source</span>.<br>
      Obsessed with <span class="text-foreground">speed</span> and always asking how things can be <span class="text-foreground">better</span>.<br>
      Outside of coding, I read for curiosity and write to make sense of things.<br>
      Currently studying Computer Science at <span class="text-foreground">Monash University</span>.
    </p>
  </div>



  <!-- Social Links -->
  <div class="mt-6 flex items-center gap-4 animate-in delay-4 sm:mt-8">
    <span class="text-[14px] text-muted-foreground sm:text-[15px]">Find me at</span>
    {socials.map((social) => (
      <a
        href={social.url}
        target="_blank"
        rel="noopener noreferrer"
        class="contact-link"
        title={social.name}
      >
        <social.icon className="h-4 w-4" aria-hidden="true" />
        <span class="hidden sm:inline">{social.name}</span>
      </a>
    ))}
  </div>

  <!-- GitHub Activity -->
  <div class="max-w-full sm:max-w-[520px]">
    <GitHubContributions />
  </div>

  <!-- Tech Stack Marquee -->
  <div class="mt-6 animate-in delay-5 max-w-full sm:max-w-[520px]">
    <TechMarquee row1={techRow1} row2={techRow2} />
  </div>
</header>

<style>
  .hero-section {
    min-height: calc(100vh - 120px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media (min-width: 640px) {
    .hero-section {
      min-height: calc(100vh - 140px);
    }
  }

  .status-text-wrapper {
    display: inline-block;
    height: 1.2em;
    line-height: 1.2em;
    overflow: hidden;
    vertical-align: middle;
    position: relative;
  }

  .status-text {
    display: inline-block;
    line-height: 1.2em;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease;
  }

  .status-text.slide-out {
    transform: translateY(-120%);
    opacity: 0;
  }

  .status-text.slide-in {
    transform: translateY(120%);
    opacity: 0;
  }
</style>

<script>
  const statusWords = [
    'Wondering',
    'Building',
    'Learning',
    'Exploring',
    'Creating',
    'Thinking',
    'Coding',
    'Designing',
    'Reading',
    'Writing',
    'Debugging',
    'Shipping',
    'Dreaming',
    'Hacking',
    'Optimizing',
    'Iterating',
    'Refactoring',
    'Brewing',
    'Crafting',
    'Tinkering',
    'Pondering',
    'Researching',
    'Prototyping',
    'Deploying',
    'Solving'
  ];

  const statusText = document.getElementById('status-text');
  if (statusText) {
    let currentIndex = 0;

    const rotateStatus = () => {
      statusText.classList.add('slide-out');

      setTimeout(() => {
        currentIndex = (currentIndex + 1) % statusWords.length;
        statusText.textContent = statusWords[currentIndex];
        statusText.classList.remove('slide-out');
        statusText.classList.add('slide-in');

        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            statusText.classList.remove('slide-in');
          });
        });
      }, 400);
    };

    // Start after initial page load animation
    setTimeout(() => {
      setInterval(rotateStatus, 3000);
    }, 1000);
  }
</script>
