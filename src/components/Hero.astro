---
import Typewriter from './Typewriter.astro';
import GitHubContributions from './GitHubContributions.astro';
import TechMarquee from './TechMarquee.astro';
import type { LucideIcon } from 'lucide-react';
import { FileText, Github, Mail, Send } from 'lucide-react';

const socials: Array<{ name: string; url: string; icon: LucideIcon }> = [
  { name: 'GitHub', url: 'https://github.com/bunizao', icon: Github },
  { name: 'Blog', url: 'https://blog.buxx.me', icon: FileText },
  { name: 'Email', url: 'mailto:me@buxx.me', icon: Mail },
  { name: 'Telegram', url: 'https://t.me/hututu0', icon: Send },
];

const techRow1 = ['TypeScript', 'Python', 'Go', 'Rust', 'React', 'Astro'];
const techRow2 = ['Networking', 'BGP', 'Proxy', 'Docker', 'Linux', 'Web3'];
---

<header class="pt-20 pb-12">
  <!-- Status indicator -->
  <div class="animate-in">
    <div class="status mb-4">
      <span class="status-dot"></span>
      <span>Available</span>
    </div>
  </div>

  <!-- Name -->
  <h1 class="animate-in delay-1 mb-2 text-[36px] font-semibold">
    <Typewriter texts={["Lucian", "Bunizao", "Tutu"]} speed={80} />
  </h1>

  <!-- Role -->
  <p class="animate-in delay-2 mb-6 text-sm text-muted-foreground">
    Data Science @ Monash University '28
  </p>

  <!-- Bio -->
  <div class="animate-in delay-3 max-w-[520px]">
    <p class="text-[15px] leading-[1.7] text-muted-foreground">
      Building tools for <span class="text-foreground">networking</span>,
      <span class="text-foreground">proxy systems</span>, and
      <span class="text-foreground">open source</span>.
      Interested in BGP, Web3, and making the internet more accessible.
    </p>
  </div>

  <!-- Social Links -->
  <div class="mt-8 flex flex-wrap items-center gap-4 animate-in delay-4">
    {socials.map((social) => (
      <a
        href={social.url}
        target="_blank"
        rel="noopener noreferrer"
        class="contact-link"
      >
        <social.icon className="h-4 w-4" aria-hidden="true" />
        <span>{social.name}</span>
      </a>
    ))}
  </div>

  <!-- GitHub Activity -->
  <GitHubContributions />

  <!-- Tech Stack Marquee -->
  <div class="mt-6 animate-in delay-5">
    <TechMarquee row1={techRow1} row2={techRow2} />
  </div>
</header>

<!-- ASCII Divider -->
<div class="divider">· · · · · · · · · ·</div>
