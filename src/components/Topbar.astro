---
import type { HTMLAttributes } from 'astro/types';
import ProgressiveBlur from '@/components/ProgressiveBlur.astro';
import '@/styles/topbar.css';

type Props = HTMLAttributes<'header'> & HTMLAttributes<'nav'> & {
  as?: 'header' | 'nav';
  progressiveBlur?: boolean;
};

const {
  as = 'header',
  class: className,
  progressiveBlur = false,
  ...attributes
} = Astro.props;
---

{as === 'nav' ? (
  <nav class:list={['topbar', className]} data-topbar {...attributes}>
    {progressiveBlur && <ProgressiveBlur class="topbar__blur" preset="topbar" />}
    <slot />
  </nav>
) : (
  <header class:list={['topbar', className]} data-topbar {...attributes}>
    {progressiveBlur && <ProgressiveBlur class="topbar__blur" preset="topbar" />}
    <slot />
  </header>
)}
