---
const username = 'bunizao';

interface ContributionDay {
  date: string;
  count: number;
  level: number;
}

interface ContributionData {
  total: { lastYear: number };
  contributions: ContributionDay[];
}

let contributions: ContributionDay[] = [];
let totalContributions = 0;

try {
  const response = await fetch(`https://github-contributions-api.jogruber.de/v4/${username}?y=last`);
  const data: ContributionData = await response.json();
  contributions = data.contributions || [];
  totalContributions = data.total?.lastYear || 0;
} catch (error) {
  console.error('Failed to fetch GitHub contributions:', error);
}

// Get recent activity - last 52 weeks
const recentContributions = contributions.slice(-364);

// Calculate streak and recent stats
let currentStreak = 0;
let maxStreak = 0;
let tempStreak = 0;

for (let i = recentContributions.length - 1; i >= 0; i--) {
  if (recentContributions[i].count > 0) {
    if (i === recentContributions.length - 1 || currentStreak > 0) {
      currentStreak++;
    }
    tempStreak++;
    maxStreak = Math.max(maxStreak, tempStreak);
  } else {
    if (currentStreak === 0) currentStreak = 0;
    tempStreak = 0;
  }
}

// Get last 30 days for the activity wave
const last30Days = contributions.slice(-30);
const maxCount = Math.max(...last30Days.map(d => d.count), 1);
---

{contributions.length > 0 && (
  <div class="activity-section">
    <div class="activity-wave">
      {last30Days.map((day, i) => {
        const height = Math.max(4, (day.count / maxCount) * 24);
        return (
          <div
            class="wave-bar"
            style={`--height: ${height}px; --delay: ${i * 0.03}s`}
            title={`${day.date}: ${day.count}`}
          />
        );
      })}
    </div>
    <div class="activity-stats">
      <a href={`https://github.com/${username}`} target="_blank" rel="noopener noreferrer" class="github-link">
        @{username}
      </a>
      <span class="stat-label"><strong>{totalContributions}</strong> contributions</span>
    </div>
  </div>
)}

<style>
  .activity-section {
    margin-top: 2.5rem;
    display: flex;
    align-items: flex-end;
    gap: 1.25rem;
  }

  .activity-wave {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 32px;
  }

  .wave-bar {
    width: 5px;
    height: var(--height);
    background: hsl(var(--foreground) / 0.35);
    animation: wave 2s ease-in-out infinite;
    animation-delay: var(--delay);
  }

  @keyframes wave {
    0%, 100% {
      transform: scaleY(1);
      opacity: 0.35;
    }
    50% {
      transform: scaleY(1.3);
      opacity: 0.7;
    }
  }

  .wave-bar:hover {
    background: hsl(var(--foreground));
    animation-play-state: paused;
  }

  .activity-stats {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .github-link {
    font-size: 14px;
    font-weight: 500;
    color: hsl(var(--foreground));
    text-decoration: none;
    transition: opacity 0.15s ease;
  }

  .github-link:hover {
    opacity: 0.7;
  }

  .stat-label {
    font-size: 12px;
    color: hsl(var(--muted-foreground));
  }

  .stat-label strong {
    font-weight: 600;
    color: hsl(var(--foreground));
  }
</style>
