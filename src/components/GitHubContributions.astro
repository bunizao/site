---
const username = 'bunizao';

interface ContributionDay {
  date: string;
  count: number;
  level: number;
}

interface ContributionData {
  total: { lastYear: number };
  contributions: ContributionDay[];
}

let contributions: ContributionDay[] = [];
let totalContributions = 0;

try {
  const response = await fetch(`https://github-contributions-api.jogruber.de/v4/${username}?y=last`);
  const data: ContributionData = await response.json();
  contributions = data.contributions || [];
  totalContributions = data.total?.lastYear || 0;
} catch (error) {
  console.error('Failed to fetch GitHub contributions:', error);
}

// Get last 20 weeks of contributions
const weeks = 20;
const today = new Date();
const startDate = new Date(today);
startDate.setDate(startDate.getDate() - (weeks * 7) + 1);

// Create contribution map for quick lookup
const contribMap = new Map<string, number>();
contributions.forEach(day => {
  contribMap.set(day.date, day.count);
});

// Build weeks array
const weeksData: { date: string; count: number; level: number }[][] = [];

for (let week = 0; week < weeks; week++) {
  const weekDays: { date: string; count: number; level: number }[] = [];

  for (let day = 0; day < 7; day++) {
    const date = new Date(startDate);
    date.setDate(date.getDate() + (week * 7) + day);
    const dateStr = date.toISOString().split('T')[0];
    const count = contribMap.get(dateStr) || 0;

    let level = 0;
    if (count > 0) level = 1;
    if (count > 3) level = 2;
    if (count > 6) level = 3;
    if (count > 9) level = 4;

    weekDays.push({ date: dateStr, count, level });
  }

  weeksData.push(weekDays);
}
---

{contributions.length > 0 ? (
  <div class="contributions-wrapper animate-in delay-5">
    <div class="contributions-grid">
      {weeksData.map((week) => (
        <div class="contributions-week">
          {week.map((day) => (
            <div
              class={`contribution-day level-${day.level}`}
              title={`${day.date}: ${day.count} contributions`}
            />
          ))}
        </div>
      ))}
    </div>
    <p class="contributions-total">{totalContributions} contributions in the last year</p>
  </div>
) : (
  <div class="contributions-wrapper animate-in delay-5">
    <p class="contributions-error">Could not load contributions</p>
  </div>
)}

<style>
  .contributions-wrapper {
    margin-top: 2rem;
  }

  .contributions-grid {
    display: flex;
    gap: 3px;
    overflow-x: auto;
    padding: 4px 0;
  }

  .contributions-week {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .contribution-day {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: hsl(var(--muted) / 0.15);
  }

  /* Dark mode greens */
  :global(.dark) .contribution-day.level-1 {
    background: #0e4429;
  }

  :global(.dark) .contribution-day.level-2 {
    background: #006d32;
  }

  :global(.dark) .contribution-day.level-3 {
    background: #26a641;
  }

  :global(.dark) .contribution-day.level-4 {
    background: #39d353;
  }

  /* Light mode greens */
  :global(:not(.dark)) .contribution-day.level-1 {
    background: #9be9a8;
  }

  :global(:not(.dark)) .contribution-day.level-2 {
    background: #40c463;
  }

  :global(:not(.dark)) .contribution-day.level-3 {
    background: #30a14e;
  }

  :global(:not(.dark)) .contribution-day.level-4 {
    background: #216e39;
  }

  .contributions-total {
    margin-top: 8px;
    font-size: 11px;
    color: hsl(var(--muted-foreground) / 0.6);
  }

  .contributions-error {
    font-size: 12px;
    color: hsl(var(--muted-foreground));
  }
</style>
