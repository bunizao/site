---
import '@/styles/progressive-blur.css';
import {
  progressiveBlurLayers,
  progressiveBlurLayerStyle,
  type ProgressiveBlurDirection,
  type ProgressiveBlurPreset,
} from '@/lib/progressive-blur';

interface SharedProps {
  class?: string;
  framed?: boolean;
}

// The ladder itself lives in @/lib/progressive-blur so string-based renderers
// (which cannot import .astro) share these exact values instead of re-deriving
// a coarser blur of their own.
type Props = SharedProps & (
  | {
      preset?: Extract<ProgressiveBlurPreset, 'continuous'>;
      direction?: ProgressiveBlurDirection;
      strength?: number;
    }
  | {
      preset: Extract<ProgressiveBlurPreset, 'topbar'>;
      direction?: never;
      strength?: never;
    }
);

const {
  class: className,
  direction = 'bottom',
  preset = 'continuous',
  strength = 1,
  framed = false,
} = Astro.props;

const layers = progressiveBlurLayers(preset, strength);
---

<div
  class:list={['pblur', { 'pblur--framed': framed }, className]}
  data-direction={direction}
  data-preset={preset}
  data-progressive-blur
  aria-hidden="true"
>
  {layers.map((layer, index) => (
    <span
      class="pblur__layer"
      data-layer={index + 1}
      data-compact={layer.compactMask ? 'true' : 'false'}
      data-webkit={layer.webkitMask ? 'true' : 'false'}
      style={progressiveBlurLayerStyle(layer)}
    />
  ))}
</div>
