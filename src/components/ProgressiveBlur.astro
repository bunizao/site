---
import '@/styles/progressive-blur.css';

type Direction = 'top' | 'right' | 'bottom' | 'left';
type Preset = 'continuous' | 'topbar';

interface SharedProps {
  class?: string;
  framed?: boolean;
}

type Props = SharedProps & (
  | {
      preset?: Extract<Preset, 'continuous'>;
      direction?: Direction;
      strength?: number;
    }
  | {
      preset: Extract<Preset, 'topbar'>;
      direction?: never;
      strength?: never;
    }
);

const {
  class: className,
  direction = 'bottom',
  preset = 'continuous',
  strength = 1,
  framed = false,
} = Astro.props;

const normalizedStrength = Number.isFinite(strength) && strength >= 0 ? strength : 1;

// Exact CSS equivalents of the 20 Figma background-blur layers. Figma's
// exported CSS uses half of the radius shown in the layer name.
const continuousLayers = [
  [0, 0, 0.160256],
  [0.001, 0.160256, 0.320513],
  [0.003, 0.320513, 0.641026],
  [0.013, 0.641026, 1.28205],
  [0.051, 1.28205, 2.5641],
  [0.205, 2.5641, 5.12821],
  [1.175, 5.12821, 12.2711],
  [2.94, 12.2711, 19.4139],
  [5.501, 19.4139, 26.5568],
  [8.858, 26.5568, 33.6996],
  [13.011, 33.6996, 40.8425],
  [17.96, 40.8425, 47.9853],
  [23.705, 47.9853, 55.1282],
  [30.246, 55.1282, 62.2711],
  [37.583, 62.2711, 69.4139],
  [45.715, 69.4139, 76.5568],
  [54.644, 76.5568, 83.6996],
  [64.368, 83.6996, 90.8425],
  [74.889, 90.8425, 97.9853],
  [78, 97.9853, 100],
] as const;

const topbarLayers = [
  {
    filter: 'blur(4px)',
    webkitFilter: 'blur(3px)',
    mask: 'linear-gradient(to bottom, #000 0%, #000 60%, transparent 100%)',
  },
  {
    filter: 'blur(8px)',
    webkitFilter: 'blur(6px)',
    mask: 'linear-gradient(to bottom, #000 0%, #000 45%, transparent 80%)',
  },
  {
    filter: 'blur(14px) saturate(1.4)',
    webkitFilter: 'blur(9px) saturate(1.3)',
    mask: 'linear-gradient(to bottom, #000 0%, #000 30%, transparent 62%)',
  },
  {
    filter: 'blur(22px) saturate(1.6)',
    webkitFilter: 'blur(13px) saturate(1.4)',
    mask: 'linear-gradient(to bottom, #000 0%, #000 12%, transparent 45%)',
  },
] as const;

const layers = preset === 'topbar'
  ? topbarLayers
  : continuousLayers.map(([blur, start, end]) => ({
      filter: `blur(${blur * normalizedStrength}px)`,
      webkitFilter: `blur(${blur * normalizedStrength}px)`,
      mask: `linear-gradient(var(--pblur-direction), transparent ${start}%, #000 ${end}%)`,
    }));
---

<div
  class:list={['pblur', { 'pblur--framed': framed }, className]}
  data-direction={direction}
  data-preset={preset}
  data-progressive-blur
  aria-hidden="true"
>
  {layers.map((layer, index) => (
    <span
      class="pblur__layer"
      data-layer={index + 1}
      style={{
        '--pblur-filter': layer.filter,
        '--pblur-webkit-filter': layer.webkitFilter,
        '--pblur-mask': layer.mask,
      }}
    />
  ))}
</div>
