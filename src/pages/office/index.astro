---
const title = 'Office';
const description = 'Original Star Office frontend mounted under /office and adapted to the worker-backed room runtime.';
const defaultWorkerBase = import.meta.env.PUBLIC_AGENTS_OFFICE_URL || '';
const defaultRoomId = import.meta.env.PUBLIC_AGENTS_OFFICE_ROOM_ID || 'demo';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style>
      :root {
        color-scheme: dark;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        width: 100%;
        min-height: 100%;
        background: #090b10;
      }

      body {
        overflow: hidden;
        font-family: 'JetBrains Mono', ui-monospace, monospace;
      }

      .office-frame {
        width: 100vw;
        height: 100vh;
        border: 0;
        display: block;
        background: #090b10;
      }
    </style>
  </head>
  <body
    data-default-worker-base={defaultWorkerBase}
    data-default-room-id={defaultRoomId}
  >
    <iframe
      id="office-frame"
      class="office-frame"
      title="Office"
      loading="eager"
      referrerpolicy="same-origin"
    ></iframe>

    <script is:inline>
      (() => {
        const frame = document.getElementById('office-frame');
        if (!frame) return;
        const root = document.body;
        const defaultWorkerBase = root?.dataset.defaultWorkerBase || '';
        const defaultRoomId = root?.dataset.defaultRoomId || 'demo';

        const query = new URLSearchParams(window.location.search);
        const runtimeConfig = {
          workerBase: query.get('worker') || defaultWorkerBase,
          roomId: query.get('room') || defaultRoomId,
        };

        try {
          sessionStorage.setItem('officeRuntimeConfig', JSON.stringify(runtimeConfig));
        } catch (error) {
          console.warn('Failed to persist office runtime config.', error);
        }

        const runtimeQuery = new URLSearchParams();
        if (query.get('worker')) runtimeQuery.set('worker', query.get('worker'));
        if (query.get('room')) runtimeQuery.set('room', query.get('room'));
        const suffix = runtimeQuery.toString();
        frame.src = `/office-runtime/index.html${suffix ? `?${suffix}` : ''}`;
      })();
    </script>
  </body>
</html>
