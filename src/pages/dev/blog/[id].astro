---
export const prerender = false;

import '../../../styles/blog-prose.css';
import '../../../styles/conversation.css';
import '../../../styles/embed-youtube.css';

const previewPolicyHeaders = {
  'Cache-Control': 'private, no-store',
  'X-Robots-Tag': 'noindex, nofollow',
} as const;

const [
  { default: BlogLayout },
  { default: AiCredit },
  { default: NotByAI },
  { formatPostDate },
  { resolveGhostDraftPreview, resolveGhostDraftRevision },
] = await Promise.all([
  import('@/layouts/BlogLayout.astro'),
  import('@/features/posts/ui/AiCredit.astro'),
  import('@/features/posts/ui/NotByAI.astro'),
  import('@/features/posts/format'),
  import('@/features/posts/server/ghost-preview'),
]);

const postId = Astro.params.id ?? '';
if (Astro.request.method === 'HEAD') {
  const result = await resolveGhostDraftRevision({
    id: postId,
    locals: Astro.locals,
  });
  if (!result.ok) {
    return new Response(null, {
      status: result.status,
      headers: previewPolicyHeaders,
    });
  }

  return new Response(null, {
    status: Astro.request.headers.get('If-None-Match') === JSON.stringify(result.revision)
      ? 304
      : 200,
    headers: { ...previewPolicyHeaders, ETag: JSON.stringify(result.revision) },
  });
}

const result = await resolveGhostDraftPreview({
  id: postId,
  locals: Astro.locals,
});
if (!result.ok) {
  return new Response(result.message, {
    status: result.status,
    headers: {
      ...previewPolicyHeaders,
      'Content-Type': 'text/plain; charset=utf-8',
    },
  });
}

for (const [name, value] of Object.entries(previewPolicyHeaders)) {
  Astro.response.headers.set(name, value);
}
Astro.response.headers.set('ETag', JSON.stringify(result.revision));

const { post, html, authorshipCredits, revision, warnings } = result;
const title = post.title.trim() || 'Untitled draft';
---

<BlogLayout
  title={title}
  description={`Draft preview of ${title}`}
  path={Astro.url.pathname}
>
  <a class="blog-back" href="/blog">← All posts</a>

  <div
    class="blog-article-wrap"
    data-ghost-draft-preview
    data-preview-revision={revision}
    data-preview-poll-ms="1500"
  >
    <aside class="blog-aside">
      <div class="blog-aside__sticky">
        <a class="blog-back-rail" href="/blog">← Blog</a>
      </div>
    </aside>

    <article>
      <header class="blog-article__header">
        <h1 class="blog-article__title">{title}</h1>
        <p class="blog-article__meta">
          <span>Draft preview</span>
          <span>{post.status}</span>
          {post.updatedAt ? <span>Updated {formatPostDate(post.updatedAt)}</span> : null}
          <span data-ghost-draft-live-status aria-live="polite">Live preview</span>
        </p>
      </header>

      {warnings.length > 0 ? (
        <aside class="blog-preview-warnings" role="alert">
          <strong>Preview warnings</strong>
          <ul>{warnings.map((warning) => <li>{warning.message}</li>)}</ul>
        </aside>
      ) : null}

      <div class="blog-prose" set:html={html} />
    </article>
  </div>

  <footer class="blog-end">
    <div class="blog-end__bar">
      {authorshipCredits.length > 0 ? <AiCredit credits={authorshipCredits} /> : <NotByAI />}
    </div>
  </footer>
</BlogLayout>

<script>
  import '@/features/posts/client/prose';
  import { startGhostDraftLiveReload } from '@/features/posts/client/draft-live-reload';

  const preview = document.querySelector<HTMLElement>('[data-ghost-draft-preview]');
  if (preview) startGhostDraftLiveReload(preview);
</script>

<style>
  .blog-preview-warnings {
    margin: 0 0 28px;
    padding: 14px 16px;
    border: 1px solid hsl(var(--foreground) / 0.14);
    border-radius: 10px;
    color: var(--blog-muted);
    font-size: 13px;
    line-height: 1.55;
  }

  .blog-preview-warnings strong {
    color: var(--blog-ink);
  }

  .blog-preview-warnings ul {
    margin: 6px 0 0;
    padding-inline-start: 18px;
  }
</style>
