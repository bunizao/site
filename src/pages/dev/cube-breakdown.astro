---
import '@/styles/globals.css';
import VoidZeroRiveHero from '@/components/effects/VoidZeroRiveHero';

export const prerender = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>VoidZero cube motion variant</title>
  </head>
  <body>
    <main class="stage">
      <section class="hero" aria-labelledby="cube-breakdown-title">
        <div class="copy">
          <p class="eyebrow">Rive motion study / local variant</p>
          <h1 id="cube-breakdown-title">Protocol geometry</h1>
          <p class="summary">A quiet fork of VoidZero's cube language, tuned colder and wired into React.</p>
        </div>

        <div class="motion-frame">
          <VoidZeroRiveHero client:load />
        </div>
      </section>

      <p class="credit">Motion asset from VoidZero. Wrapper, copy, color treatment, and route are local.</p>
    </main>

    <style is:global>
      :root {
        --background: 190 28% 96%;
        --foreground: 210 18% 8%;
        --grid: rgba(8, 47, 73, 0.08);
        --grid-soft: rgba(8, 47, 73, 0.045);
        --accent: #0891b2;
        --accent-warm: #9a6a00;
      }

      * {
        box-sizing: border-box;
      }

      body {
        min-height: 100vh;
        margin: 0;
        color: hsl(var(--foreground));
        background:
          radial-gradient(circle at 72% 46%, rgba(8, 145, 178, 0.12), transparent 34%),
          radial-gradient(circle at 18% 58%, rgba(154, 106, 0, 0.07), transparent 30%),
          linear-gradient(var(--grid) 1px, transparent 1px),
          linear-gradient(90deg, var(--grid-soft) 1px, transparent 1px),
          hsl(var(--background));
        background-size: auto, auto, 32px 32px, 32px 32px, auto;
        font-family: var(--font-sans);
      }

      .stage {
        display: grid;
        min-height: 100vh;
        place-items: center;
        padding: clamp(24px, 5vw, 72px);
      }

      .hero {
        display: grid;
        width: min(100%, 1160px);
        grid-template-columns: minmax(0, 0.7fr) minmax(420px, 1.1fr);
        align-items: center;
        gap: clamp(32px, 6vw, 88px);
      }

      .copy {
        max-width: 520px;
      }

      .eyebrow {
        margin: 0 0 16px;
        color: var(--accent);
        font-family: var(--font-code);
        font-size: 12px;
        letter-spacing: 0;
        text-transform: uppercase;
      }

      h1 {
        margin: 0;
        font-family: var(--font-code);
        font-size: clamp(44px, 7vw, 92px);
        font-weight: 700;
        letter-spacing: 0;
        line-height: 0.96;
      }

      .summary {
        margin: 24px 0 0;
        max-width: 46ch;
        color: rgba(15, 23, 42, 0.62);
        font-size: 16px;
        line-height: 1.7;
      }

      .motion-frame {
        display: grid;
        min-height: clamp(300px, 42vw, 560px);
        place-items: center;
      }

      .rive-shell {
        width: min(100%, 760px);
      }

      .rive-stage {
        width: 100%;
        height: clamp(220px, 34vw, 430px);
        opacity: 0;
        filter: saturate(1.12) hue-rotate(8deg) contrast(1.04);
        mix-blend-mode: multiply;
        transition: opacity 420ms ease, filter 420ms ease;
      }

      .rive-stage[data-ready='true'] {
        opacity: 0.94;
      }

      .rive-stage > div {
        width: 100%;
        height: 100%;
      }

      .rive-stage canvas {
        display: block;
        width: 100% !important;
        height: 100% !important;
      }

      .credit {
        position: fixed;
        right: clamp(18px, 4vw, 44px);
        bottom: clamp(18px, 4vw, 36px);
        margin: 0;
        color: rgba(15, 23, 42, 0.42);
        font-family: var(--font-code);
        font-size: 11px;
      }

      @media (max-width: 820px) {
        .hero {
          grid-template-columns: 1fr;
          gap: 20px;
        }

        .motion-frame {
          min-height: 250px;
          place-items: start center;
        }

        .rive-stage {
          height: 230px;
        }

        .credit {
          position: static;
          width: min(100%, 520px);
          margin-top: 32px;
        }
      }
    </style>
  </body>
</html>
