---
/* Everyone currently held, and what each key has caught.

   The ban list is the one piece of comment state with no other surface: a
   ban leaves no trace on the public page by design, and the writer is never
   told. This page is therefore the only way to find out that something is
   still switched on. */
import PortalLayout from '@/layouts/PortalLayout.astro';
import PortalSection from '@/components/portal/PortalSection.astro';
import CommentsSubNav from '@/components/portal/CommentsSubNav.astro';
import BansTable from '@/features/admin/ui/BansTable';
import { Activity } from 'lucide-react';
import { loadBans } from '@/features/admin/server/portal-client';
import type { AdminBan } from '@bunizao/contracts';

import { DEMO_BANS } from '@/features/admin/server/portal-demo';

export const prerender = false;

const session = (Astro.locals as any).adminSession;

let bans: AdminBan[] = [];
let loadError: string | null = null;
let demoMode = false;
try {
  bans = (await loadBans(Astro.request, Astro.locals)).bans;
} catch (error) {
  loadError = error instanceof Error ? error.message : 'unknown';

/* Local dev has no site-api binding, so the load above throws before any of
   these tables has data. Same fixture swap the queue page does, and for the
   same reason: four red banners are not a page anyone can design against. */
  if (import.meta.env.DEV && loadError === 'api_binding_unavailable') {
    bans = DEMO_BANS.bans;
    demoMode = true;
    loadError = null;
  }
}
---

<PortalLayout
  title="Bans"
  description="Held quietly. Nobody on this list was told."
  active="comments"
  user={{ login: session?.login || 'admin' }}
>
  <CommentsSubNav active="bans" />

  {loadError && (
    <div class="portal-notice" data-variant="error">
      <Activity size={14} />
      <span>Failed to load bans: <code>{loadError}</code></span>
    </div>
  )}
  {demoMode && (
    <div class="portal-notice">
      <Activity size={14} />
      <span>Showing demo data — the site-api binding is unavailable in local dev.</span>
    </div>
  )}

  <PortalSection
    title="Ban list"
    eyebrow="Shadow"
    meta={`${bans.length} key${bans.length === 1 ? '' : 's'}`}
    class="portal-mt-lg"
  >
    <BansTable initialBans={bans} client:load />
  </PortalSection>
</PortalLayout>
