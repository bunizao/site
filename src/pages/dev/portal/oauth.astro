---
import PortalLayout from '@/layouts/PortalLayout.astro';
import { Badge } from '@/components/ui/badge';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import {
  Blocks,
  Database,
  GitBranch,
  KeyRound,
  Network,
  ShieldCheck,
  SquareTerminal,
} from 'lucide-react';

export const prerender = false;

const session = (Astro.locals as any).adminSession;

const surfaces = [
  {
    title: 'Owner identity',
    status: 'Live',
    description: 'Cloudflare Access allow-list, verified JWT, no app-owned login callback.',
    Icon: ShieldCheck,
  },
  {
    title: 'Agent sandbox',
    status: 'Next',
    description: 'Short-lived handoff tokens should be minted here before sandbox jobs can touch private data.',
    Icon: SquareTerminal,
  },
  {
    title: 'Knowledge connectors',
    status: 'Next',
    description: 'Source adapters belong behind this gate; non-OAuth sources should be imported as scoped credentials.',
    Icon: Database,
  },
  {
    title: 'MCP clients',
    status: 'Next',
    description: 'External model clients should receive only MCP-scoped capabilities, never site admin cookies.',
    Icon: Network,
  },
] as const;

const rules = [
  'One owner session authority: the allowed Cloudflare Access email remains the human gate.',
  'No browser-exposed platform tokens; connector secrets stay server-side.',
  'Machine access uses explicit scopes, short TTLs, and audit records.',
  'Each knowledge source gets its own adapter boundary instead of a shared scraping blob.',
] as const;

const phases = [
  'Define an internal app registry for sandbox, connector, and MCP clients.',
  'Add a token exchange endpoint that turns the owner session into short-lived machine credentials.',
  'Store connector credentials in a server-side vault table with per-source scopes.',
  'Publish MCP auth metadata after the resource model is real.',
] as const;
---

<PortalLayout
  title="Access Hub"
  description="Cloudflare Access entry for the admin portal, future sandbox jobs, knowledge connectors, and MCP clients."
  active="oauth"
  user={{ login: session?.login || 'admin', email: session?.email }}
>
  <section class="portal-grid" data-columns="cards">
    <Card>
      <CardHeader className="portal-stat-header">
        <div>
          <CardTitle className="portal-card-title">
            <KeyRound size={16} />
            Unified entry
          </CardTitle>
          <CardDescription>The Access hub is the control plane, not a connector dump.</CardDescription>
        </div>
        <Badge variant="outline">Owner gated</Badge>
      </CardHeader>
      <CardContent className="portal-card-content">
        <p class="portal-prose">
          Cloudflare Access now owns the human login path. The app only verifies the signed Access JWT,
          then future slices can mint narrower credentials for agent sandboxes, knowledge ingestion, and
          MCP clients without leaking raw platform tokens.
        </p>
      </CardContent>
    </Card>

    <Card>
      <CardHeader className="portal-stat-header">
        <div>
          <CardTitle className="portal-card-title">
            <GitBranch size={14} />
            Current session
          </CardTitle>
          <CardDescription>Authenticated actor for future audit trails.</CardDescription>
        </div>
      </CardHeader>
      <CardContent className="portal-card-content">
        <div class="portal-stat-value">@{session?.login || 'admin'}</div>
        <div class="portal-stat-hint">
          Access email: <span class="portal-mono">{session?.email || 'local-dev'}</span>
        </div>
      </CardContent>
    </Card>
  </section>

  <section class="portal-grid" data-columns="cards">
    {surfaces.map(({ title, status, description, Icon }) => (
      <Card>
        <CardHeader className="portal-stat-header">
          <CardTitle className="portal-card-title">
            <Icon size={14} />
            {title}
          </CardTitle>
          <Badge variant={status === 'Live' ? 'default' : 'secondary'}>{status}</Badge>
        </CardHeader>
        <CardContent className="portal-card-content">
          <p class="portal-prose" data-size="sm">{description}</p>
        </CardContent>
      </Card>
    ))}
  </section>

  <section class="portal-grid" data-columns="wide">
    <Card>
      <CardHeader>
        <CardTitle className="portal-card-title">
          <ShieldCheck size={14} />
          Rules
        </CardTitle>
        <CardDescription>These constraints keep the auth surface boring in the best way.</CardDescription>
      </CardHeader>
      <CardContent className="portal-card-content">
        <ul class="portal-bullets">
          {rules.map((rule) => (
            <li><span>{rule}</span></li>
          ))}
        </ul>
      </CardContent>
    </Card>

    <Card>
      <CardHeader>
        <CardTitle className="portal-card-title">
          <Blocks size={14} />
          Build order
        </CardTitle>
        <CardDescription>Do this in slices; auth spaghetti is how good tools die young.</CardDescription>
      </CardHeader>
      <CardContent className="portal-card-content">
        <ol class="portal-steps">
          {phases.map((phase) => (
            <li>{phase}</li>
          ))}
        </ol>
      </CardContent>
    </Card>
  </section>
</PortalLayout>
