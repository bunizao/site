---
import PortalLayout from '@/layouts/PortalLayout.astro';
import SubscriberList from '@/features/admin/ui/SubscriberList';

export const prerender = false;

const session = (Astro.locals as any).adminSession;
---

<PortalLayout
  title="Newsletter subscribers"
  description="Manage blog and mood subscribers, source filters, and delivery cadence."
  active="subscribers"
  user={{ login: session?.login || 'admin' }}
>
  <SubscriberList client:load />
</PortalLayout>
