---
import PortalLayout from '@/layouts/PortalLayout.astro';
import SubscriberDetail from '@/features/admin/ui/SubscriberDetail';

export const prerender = false;

const session = (Astro.locals as any).adminSession;
const { hash } = Astro.params;
---

<PortalLayout
  title="Newsletter subscriber"
  description="Subscriber sources, delivery preferences, and audit history."
  active="subscribers"
  user={{ login: session?.login || 'admin' }}
>
  <SubscriberDetail emailHash={hash || ''} client:load />
</PortalLayout>
