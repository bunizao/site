---
import PortalLayout from '@/layouts/PortalLayout.astro';
import { Button, Card } from '@/components/coss';
import { readRuntimeEnv, signedRequestPath } from '@/lib/security/signed-url';

export const prerender = false;

const session = (Astro.locals as any).adminSession;
const activityPanelSigningSecret = readRuntimeEnv(Astro.locals, 'ACTIVITY_PANEL_SIGNING_SECRET')
  || import.meta.env.ACTIVITY_PANEL_SIGNING_SECRET
  || '';
const svgPreviewExpiry = Math.floor(Date.now() / 1000) + 60 * 60;

interface SvgEntry {
  id: string;
  name: string;
  intent: string;
  src: string;
  themeParam?: 'theme';
  notes?: string;
  height?: number;
}

function withQuery(pathname: string, values: Record<string, string>): string {
  const params = new URLSearchParams(values);
  return `${pathname}?${params.toString()}`;
}

function signedActivityPanelSrc(theme: 'dark' | 'light'): string {
  const pathname = '/api/activity-panel.svg';
  const searchParams = new URLSearchParams({ theme });
  return activityPanelSigningSecret
    ? signedRequestPath(pathname, searchParams, activityPanelSigningSecret, svgPreviewExpiry)
    : withQuery(pathname, { theme });
}

const entries: SvgEntry[] = [
  {
    id: 'status',
    name: 'Status badge',
    intent: 'Live status pill embedded in READMEs',
    src: '/api/status.svg',
    themeParam: 'theme',
    height: 88,
  },
  {
    id: 'site-badge',
    name: 'Site badge',
    intent: 'Marketing badge for the site itself',
    src: '/api/site-badge.svg',
    themeParam: 'theme',
    notes: 'Also accepts ?style=default|outline',
    height: 110,
  },
  {
    id: 'tech-stack',
    name: 'Tech stack panel',
    intent: 'Long-form tech stack panel',
    src: '/api/tech-stack.svg',
    themeParam: 'theme',
    height: 280,
  },
  {
    id: 'activity-panel',
    name: 'Activity panel',
    intent: 'Recent commit activity summary',
    src: signedActivityPanelSrc('dark'),
    themeParam: 'theme',
    notes: 'Accepts days, projects, commits, added, removed, net, lph',
    height: 240,
  },
  {
    id: 'project',
    name: 'Project card',
    intent: 'Repo card by project id (default tutubetterrules)',
    src: '/api/project.svg',
    themeParam: 'theme',
    notes: 'Accepts ?project=<id>',
    height: 220,
  },
  {
    id: 'telegram-logo',
    name: 'Telegram logo',
    intent: 'Static brand asset under /public',
    src: '/telegram-logo.svg',
    height: 96,
  },
];
---

<PortalLayout
  title="SVG gallery"
  description="Live preview of every SVG endpoint and static asset shipped by the site."
  active="svg"
  user={{ login: session?.login || 'admin' }}
>
  <section class="svg-gallery" data-theme="dark">
    <Card className="svg-toolbar">
      <div class="svg-toolbar__group" role="group" aria-label="Theme">
        <span class="svg-toolbar__label">Theme</span>
        <div class="svg-segment">
          <Button type="button" variant="ghost" size="sm" className="svg-segment__btn svg-segment__btn--active" data-theme="dark" aria-pressed="true">Dark</Button>
          <Button type="button" variant="ghost" size="sm" className="svg-segment__btn" data-theme="light" aria-pressed="false">Light</Button>
        </div>
      </div>
      <div class="svg-toolbar__group" role="group" aria-label="Background">
        <span class="svg-toolbar__label">Frame</span>
        <div class="svg-segment">
          <Button type="button" variant="ghost" size="sm" className="svg-segment__btn svg-segment__btn--active" data-frame="auto" aria-pressed="true">Auto</Button>
          <Button type="button" variant="ghost" size="sm" className="svg-segment__btn" data-frame="dark" aria-pressed="false">Dark</Button>
          <Button type="button" variant="ghost" size="sm" className="svg-segment__btn" data-frame="light" aria-pressed="false">Light</Button>
          <Button type="button" variant="ghost" size="sm" className="svg-segment__btn" data-frame="checker" aria-pressed="false">Checker</Button>
        </div>
      </div>
      <div class="svg-toolbar__spacer"></div>
      <span class="svg-toolbar__count">{entries.length} assets</span>
    </Card>

    <div class="svg-grid">
      {entries.map((entry) => {
        const themed = Boolean(entry.themeParam);
        const darkSrc = entry.id === 'activity-panel' ? signedActivityPanelSrc('dark') : undefined;
        const lightSrc = entry.id === 'activity-panel' ? signedActivityPanelSrc('light') : undefined;
        return (
          <Card className="svg-card" data-themed={themed ? 'true' : 'false'} data-id={entry.id}>
            <header class="svg-card__head">
              <div class="svg-card__heading">
                <h3 class="svg-card__title">{entry.name}</h3>
                <p class="svg-card__intent">{entry.intent}</p>
              </div>
              <Button type="button" variant="outline" size="sm" className="svg-card__copy" data-copy-url={entry.src} aria-label={`Copy URL for ${entry.name}`}>Copy URL</Button>
            </header>
            <div class="svg-card__frame" data-frame="auto" style={entry.height ? `--frame-min:${entry.height}px;` : ''}>
              <img
                class="svg-card__image"
                src={entry.src}
                data-base-src={entry.src}
                data-src-dark={darkSrc}
                data-src-light={lightSrc}
                data-themed={themed ? 'true' : 'false'}
                alt={entry.name}
                loading="lazy"
              />
            </div>
            <footer class="svg-card__foot">
              <code class="svg-card__url" data-url-display>{entry.src}</code>
              {entry.notes && <p class="svg-card__notes">{entry.notes}</p>}
            </footer>
          </Card>
        );
      })}
    </div>
  </section>
</PortalLayout>

<script is:inline>
  (() => {
    const root = document.querySelector('.svg-gallery');
    if (!(root instanceof HTMLElement)) return;

    const themeButtons = root.querySelectorAll('[data-theme]');
    const frameButtons = root.querySelectorAll('[data-frame]');
    const images = Array.from(root.querySelectorAll('img.svg-card__image'));
    const frames = Array.from(root.querySelectorAll('.svg-card__frame'));
    const urlDisplays = Array.from(root.querySelectorAll('[data-url-display]'));

    let currentTheme = 'dark';
    let currentFrame = 'auto';

    const applyTheme = () => {
      root.dataset.theme = currentTheme;
      images.forEach((img) => {
        if (!(img instanceof HTMLImageElement)) return;
        const themed = img.dataset.themed === 'true';
        const base = img.dataset.baseSrc || img.src;
        if (!themed) {
          img.src = base;
          return;
        }
        const signedThemeSrc = currentTheme === 'light' ? img.dataset.srcLight : img.dataset.srcDark;
        if (signedThemeSrc) {
          img.src = signedThemeSrc;
          const card = img.closest('.svg-card');
          const display = card?.querySelector('[data-url-display]');
          if (display) display.textContent = signedThemeSrc;
          return;
        }
        const url = new URL(base, window.location.origin);
        url.searchParams.set('theme', currentTheme);
        const next = `${url.pathname}${url.search}`;
        img.src = next;
        const card = img.closest('.svg-card');
        const display = card?.querySelector('[data-url-display]');
        if (display) display.textContent = next;
      });
      // Reset URL display for non-themed assets to their base.
      urlDisplays.forEach((node) => {
        const card = node.closest('.svg-card');
        const img = card?.querySelector('img.svg-card__image');
        if (img instanceof HTMLImageElement && img.dataset.themed !== 'true') {
          node.textContent = img.dataset.baseSrc || img.src;
        }
      });
    };

    const applyFrame = () => {
      frames.forEach((frame) => {
        if (frame instanceof HTMLElement) frame.dataset.frame = currentFrame;
      });
    };

    themeButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const theme = btn.getAttribute('data-theme');
        if (!theme) return;
        currentTheme = theme;
        themeButtons.forEach((b) => {
          const active = b === btn;
          b.classList.toggle('svg-segment__btn--active', active);
          b.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
        applyTheme();
      });
    });

    frameButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const frame = btn.getAttribute('data-frame');
        if (!frame) return;
        currentFrame = frame;
        frameButtons.forEach((b) => {
          const active = b === btn;
          b.classList.toggle('svg-segment__btn--active', active);
          b.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
        applyFrame();
      });
    });

    root.querySelectorAll('[data-copy-url]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const url = btn.getAttribute('data-copy-url');
        if (!url) return;
        const card = btn.closest('.svg-card');
        const img = card?.querySelector('img.svg-card__image');
        const final = img instanceof HTMLImageElement ? img.getAttribute('src') || url : url;
        try {
          await navigator.clipboard.writeText(new URL(final, window.location.origin).toString());
          const original = btn.textContent;
          btn.textContent = 'Copied';
          btn.setAttribute('data-copied', 'true');
          setTimeout(() => {
            btn.textContent = original;
            btn.removeAttribute('data-copied');
          }, 1400);
        } catch {
          btn.textContent = 'Copy failed';
          setTimeout(() => {
            btn.textContent = 'Copy URL';
          }, 1400);
        }
      });
    });

    applyTheme();
    applyFrame();
  })();
</script>

<style is:global>
  .svg-gallery {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .svg-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    padding: 14px 16px;
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: 12px;
  }

  .svg-toolbar__group {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .svg-toolbar__label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: hsl(var(--muted-foreground));
  }

  .svg-toolbar__spacer {
    flex: 1;
  }

  .svg-toolbar__count {
    font-size: 11px;
    color: hsl(var(--muted-foreground));
    font-family: var(--font-code);
  }

  .svg-segment {
    display: inline-flex;
    padding: 3px;
    border-radius: 8px;
    background: hsl(var(--background));
    border: 1px solid hsl(var(--border));
  }

  .svg-segment__btn {
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 500;
    color: hsl(var(--muted-foreground));
    background: transparent;
    border: 0;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .svg-segment__btn:hover {
    color: hsl(var(--foreground));
  }

  .svg-segment__btn--active,
  .svg-segment__btn--active:hover {
    background: hsl(var(--accent));
    color: hsl(var(--accent-foreground));
  }

  .svg-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 16px;
  }

  .svg-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px;
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: 12px;
  }

  .svg-card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .svg-card__heading {
    min-width: 0;
  }

  .svg-card__title {
    margin: 0 0 2px;
    font-size: 14px;
    font-weight: 600;
    color: hsl(var(--foreground));
  }

  .svg-card__intent {
    margin: 0;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: hsl(var(--muted-foreground));
  }

  .svg-card__copy {
    flex: 0 0 auto;
    padding: 5px 10px;
    font-size: 11px;
    font-weight: 500;
    color: hsl(var(--muted-foreground));
    background: transparent;
    border: 1px solid hsl(var(--border));
    border-radius: 7px;
    cursor: pointer;
    transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
  }

  .svg-card__copy:hover {
    color: hsl(var(--foreground));
    background: hsl(var(--accent) / 0.4);
  }

  .svg-card__copy[data-copied='true'] {
    color: hsl(var(--portal-success, 142 71% 45%));
    border-color: hsl(var(--portal-success, 142 71% 45%) / 0.5);
  }

  .svg-card__frame {
    --frame-min: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--frame-min);
    max-height: calc(var(--frame-min) + 80px);
    padding: 16px;
    border-radius: 10px;
    border: 1px solid hsl(var(--border));
    overflow: hidden;
  }

  .svg-card__frame[data-frame='auto'] {
    background:
      linear-gradient(180deg, hsl(0 0% 100% / 0.02), hsl(0 0% 100% / 0.06)),
      hsl(240 6% 4%);
  }

  .svg-card__frame[data-frame='dark'] {
    background: hsl(240 6% 4%);
  }

  .svg-card__frame[data-frame='light'] {
    background: hsl(0 0% 98%);
  }

  .svg-card__frame[data-frame='checker'] {
    background-color: hsl(0 0% 96%);
    background-image:
      linear-gradient(45deg, hsl(0 0% 88%) 25%, transparent 25%),
      linear-gradient(-45deg, hsl(0 0% 88%) 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, hsl(0 0% 88%) 75%),
      linear-gradient(-45deg, transparent 75%, hsl(0 0% 88%) 75%);
    background-size: 16px 16px;
    background-position: 0 0, 0 8px, 8px -8px, -8px 0;
  }

  .svg-card__image {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    display: block;
    object-fit: contain;
  }

  .svg-card__foot {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .svg-card__url {
    display: block;
    padding: 6px 8px;
    font-family: var(--font-code);
    font-size: 11px;
    color: hsl(var(--muted-foreground));
    background: hsl(var(--background));
    border: 1px solid hsl(var(--border));
    border-radius: 6px;
    overflow-x: auto;
    white-space: nowrap;
  }

  .svg-card__notes {
    margin: 0;
    font-size: 11px;
    color: hsl(var(--muted-foreground));
  }

  @media (max-width: 720px) {
    .svg-toolbar {
      align-items: flex-start;
      flex-direction: column;
    }
    .svg-toolbar__spacer {
      display: none;
    }
    .svg-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
