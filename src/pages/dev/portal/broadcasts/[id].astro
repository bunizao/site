---
import PortalLayout from '@/layouts/PortalLayout.astro';
import { Badge, Button, Card, CardContent, CardHeader, CardTitle } from '@/components/coss';
import { ArrowLeft } from 'lucide-react';
import { loadBroadcast } from '@/features/admin/server/portal-client';

export const prerender = false;

const session = (Astro.locals as any).adminSession;
const id = Astro.params.id as string;

const record = id ? await loadBroadcast(id, Astro.request, Astro.locals) : null;

function formatDate(value: string | null | undefined): string {
  if (!value) return '—';
  try {
    return new Date(value).toLocaleString(undefined, {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    });
  } catch {
    return value;
  }
}
---

<PortalLayout
  title={record?.subject || 'Broadcast'}
  description={record ? `Sent ${formatDate(record.sentAt)}` : 'Broadcast detail'}
  active="broadcasts"
  user={{ login: session?.login || 'admin' }}
>
  <div class="portal-stack">
    <Button
      variant="ghost"
      size="sm"
      render={<a href="/dev/portal/broadcasts"><ArrowLeft className="size-3.5" /> Back to broadcasts</a>}
    />

    {!record ? (
      <Card>
        <CardContent className="portal-empty-card">
          Broadcast not found.
        </CardContent>
      </Card>
    ) : (
      <Fragment>
        <Card>
          <CardHeader>
            <div class="portal-detail-head">
              <div>
                <CardTitle className="portal-detail-title">{record.subject}</CardTitle>
                <div class="portal-detail-id">{record.id}</div>
              </div>
              <Badge variant={record.status === 'sent' ? 'success' : record.status === 'failed' ? 'destructive' : 'secondary'}>
                {record.status}
              </Badge>
            </div>
          </CardHeader>
          <CardContent className="portal-facts">
            <div>
              <div class="portal-fact-label">Sent by</div>
              <div class="portal-fact-value">@{record.sentBy}</div>
            </div>
            <div>
              <div class="portal-fact-label">Created</div>
              <div class="portal-fact-value">{formatDate(record.createdAt)}</div>
            </div>
            <div>
              <div class="portal-fact-label">Sent</div>
              <div class="portal-fact-value">{formatDate(record.sentAt)}</div>
            </div>
            <div>
              <div class="portal-fact-label">Recipients</div>
              <div class="portal-fact-value">{record.recipientCount}</div>
            </div>
            <div>
              <div class="portal-fact-label">Sent</div>
              <div class="portal-fact-value">{record.sentCount}</div>
            </div>
            <div>
              <div class="portal-fact-label">Failed</div>
              <div class="portal-fact-value">{record.failedCount}</div>
            </div>
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle className="portal-card-title">Audience</CardTitle>
          </CardHeader>
          <CardContent className="portal-badge-row">
            <Badge variant="outline">status: {record.audience.status}</Badge>
            {record.audience.channels.map((channel) => (
              <Badge variant="outline">channel: {channel}</Badge>
            ))}
            {record.audience.deliveryModes?.map((mode) => (
              <Badge variant="outline">delivery: {mode}</Badge>
            ))}
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle className="portal-card-title">Rendered email</CardTitle>
          </CardHeader>
          <CardContent>
            <iframe
              title="Broadcast"
              sandbox=""
              class="portal-email-frame"
              srcdoc={`<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><style>body{font-family:Geist,system-ui,sans-serif;padding:24px;}</style></head><body>${record.bodyHtml}</body></html>`}
            ></iframe>
          </CardContent>
        </Card>
      </Fragment>
    )}
  </div>
</PortalLayout>
