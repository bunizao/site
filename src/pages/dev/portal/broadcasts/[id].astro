---
import PortalLayout from '@/layouts/PortalLayout.astro';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { Button } from '@/components/ui/button';
import { ArrowLeft } from 'lucide-react';
import { getBroadcast } from '@/features/admin/server/broadcasts';

export const prerender = false;

const session = (Astro.locals as any).adminSession;
const id = Astro.params.id as string;
const ctx = { request: Astro.request, locals: Astro.locals, actor: session?.login || 'unknown' };

const record = id ? await getBroadcast(ctx, id) : null;

function formatDate(value: string | null | undefined): string {
  if (!value) return '—';
  try {
    return new Date(value).toLocaleString(undefined, {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    });
  } catch {
    return value;
  }
}

const emptyContentStyle = { padding: 32, fontSize: 14, color: 'hsl(var(--muted-foreground))' } as const;
const titleLg = { fontSize: 18, letterSpacing: '-0.01em' } as const;
const titleSm = { fontSize: 14 } as const;
const summaryGridStyle = { display: 'grid', gridTemplateColumns: 'repeat(auto-fit,minmax(180px,1fr))', gap: 14, fontSize: 13 } as const;
const audienceContentStyle = { display: 'flex', flexWrap: 'wrap', gap: 8 } as const;
---

<PortalLayout
  title={record?.subject || 'Broadcast'}
  description={record ? `Sent ${formatDate(record.sentAt)}` : 'Broadcast detail'}
  active="broadcasts"
  user={{ login: session?.login || 'admin' }}
>
  <div style="display:flex;flex-direction:column;gap:24px;">
    <Button asChild variant="ghost" size="sm">
      <a href="/dev/portal/broadcasts"><ArrowLeft className="size-3.5" /> Back to broadcasts</a>
    </Button>

    {!record ? (
      <Card>
        <CardContent style={emptyContentStyle}>
          Broadcast not found.
        </CardContent>
      </Card>
    ) : (
      <Fragment>
        <Card>
          <CardHeader>
            <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;">
              <div>
                <CardTitle style={titleLg}>{record.subject}</CardTitle>
                <div style="font-family:'JetBrains Mono',monospace;font-size:11px;color:hsl(var(--muted-foreground));margin-top:4px;">{record.id}</div>
              </div>
              <Badge variant={record.status === 'sent' ? 'success' : record.status === 'failed' ? 'destructive' : 'secondary'}>
                {record.status}
              </Badge>
            </div>
          </CardHeader>
          <CardContent style={summaryGridStyle}>
            <div>
              <div style="font-size:11px;color:hsl(var(--muted-foreground));text-transform:uppercase;letter-spacing:0.08em;">Sent by</div>
              <div style="margin-top:2px;">@{record.sentBy}</div>
            </div>
            <div>
              <div style="font-size:11px;color:hsl(var(--muted-foreground));text-transform:uppercase;letter-spacing:0.08em;">Created</div>
              <div style="margin-top:2px;">{formatDate(record.createdAt)}</div>
            </div>
            <div>
              <div style="font-size:11px;color:hsl(var(--muted-foreground));text-transform:uppercase;letter-spacing:0.08em;">Sent</div>
              <div style="margin-top:2px;">{formatDate(record.sentAt)}</div>
            </div>
            <div>
              <div style="font-size:11px;color:hsl(var(--muted-foreground));text-transform:uppercase;letter-spacing:0.08em;">Recipients</div>
              <div style="margin-top:2px;">{record.recipientCount}</div>
            </div>
            <div>
              <div style="font-size:11px;color:hsl(var(--muted-foreground));text-transform:uppercase;letter-spacing:0.08em;">Sent</div>
              <div style="margin-top:2px;">{record.sentCount}</div>
            </div>
            <div>
              <div style="font-size:11px;color:hsl(var(--muted-foreground));text-transform:uppercase;letter-spacing:0.08em;">Failed</div>
              <div style="margin-top:2px;">{record.failedCount}</div>
            </div>
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle style={titleSm}>Audience</CardTitle>
          </CardHeader>
          <CardContent style={audienceContentStyle}>
            <Badge variant="outline">status: {record.audience.status}</Badge>
            {record.audience.channels.map((channel) => (
              <Badge variant="outline">channel: {channel}</Badge>
            ))}
            {record.audience.deliveryModes?.map((mode) => (
              <Badge variant="outline">delivery: {mode}</Badge>
            ))}
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle style={titleSm}>Rendered email</CardTitle>
          </CardHeader>
          <CardContent>
            <iframe
              title="Broadcast"
              style="width:100%;height:520px;border:1px solid hsl(var(--border));border-radius:8px;background:#fff;"
              srcdoc={`<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><style>body{font-family:Geist,system-ui,sans-serif;padding:24px;}</style></head><body>${record.bodyHtml}</body></html>`}
            ></iframe>
          </CardContent>
        </Card>
      </Fragment>
    )}
  </div>
</PortalLayout>
