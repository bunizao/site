---
import PortalLayout from '@/layouts/PortalLayout.astro';
import {
  Badge,
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from '@/components/coss';
import StatCard from '@/components/portal/StatCard.astro';
import EmptyState from '@/components/portal/EmptyState.astro';
import PortalSection from '@/components/portal/PortalSection.astro';
import SegmentedNav from '@/components/portal/SegmentedNav.astro';
import { Activity, Clock3, Eye, FileText, Gauge, Globe2, MailOpen, Monitor, MousePointer2, Send, Smartphone, Tablet, Terminal, Users, type LucideIcon } from 'lucide-react';
import {
  BLOG_ANALYTICS_COMPLETION_SCROLL_DEPTH,
  BLOG_ANALYTICS_RANGE_OPTIONS,
  BLOG_ANALYTICS_READ_THRESHOLD_MS,
  type BlogAnalyticsBreakdown,
  type BlogAnalyticsSummaryResult,
  type NewsletterAnalyticsSummary,
} from '@bunizao/contracts/analytics';
import { loadPortalAnalytics, type PortalAnalytics } from '@/features/admin/server/portal-client';
import { DEMO_ANALYTICS } from '@/features/admin/server/portal-analytics-demo';
import { NewsletterDailyChart, NewsletterFunnel, TrafficChart } from '@/features/admin/ui/AnalyticsCharts';

export const prerender = false;

const session = (Astro.locals as any).adminSession;

const requestedDays = Number(Astro.url.searchParams.get('days') || '30');
const rangeDays = (BLOG_ANALYTICS_RANGE_OPTIONS as readonly number[]).includes(requestedDays)
  ? requestedDays
  : 30;

const emptySummary: BlogAnalyticsSummaryResult = {
  range: { from: null, to: null, days: 7 },
  totals: { views: 0, reads: 0, uniqueVisitors: 0, avgReadMs: 0, avgVisitorReadMs: 0, completionRate: 0 },
  articles: [],
  platforms: [],
  countries: [],
  referrers: [],
  daily: [],
  newsletter: {
    totals: { sent: 0, opened: 0, clicked: 0, uniqueSubscribers: 0, openRate: 0, clickRate: 0 },
    byEmailType: [],
    campaigns: [],
    daily: [],
  },
};

let analytics: PortalAnalytics = { summary: emptySummary, events: { events: [] } };
let loadError: string | null = null;
let demoMode = false;

try {
  analytics = await loadPortalAnalytics(Astro.request, Astro.locals, { days: rangeDays });
} catch (error) {
  loadError = error instanceof Error ? error.message : 'unknown';
  if (import.meta.env.DEV) {
    analytics = DEMO_ANALYTICS;
    demoMode = true;
    loadError = null;
  }
}

const { summary, events } = analytics;
const { totals } = summary;
const newsletter: NewsletterAnalyticsSummary = summary.newsletter ?? emptySummary.newsletter!;
const countFormatter = new Intl.NumberFormat('en-US');

function formatCount(value: number | undefined): string {
  return countFormatter.format(value ?? 0);
}
function formatPercent(value: number | undefined): string {
  return `${Math.round((value ?? 0) * 100)}%`;
}
function formatMs(value: number | undefined): string {
  const seconds = Math.round((value ?? 0) / 1000);
  if (seconds < 60) return `${seconds}s`;
  const minutes = Math.floor(seconds / 60);
  const rest = seconds % 60;
  return rest ? `${minutes}m ${rest}s` : `${minutes}m`;
}
function formatDate(value: string | null | undefined): string {
  if (!value) return 'n/a';
  try {
    return new Date(value).toLocaleString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
  } catch {
    return value;
  }
}
function formatDay(value: string): string {
  try {
    return new Date(`${value}T00:00:00Z`).toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
  } catch {
    return value;
  }
}
function labelFor(value: string | null | undefined): string {
  if (!value) return 'unknown';
  return value.replace(/_/g, ' ');
}
function newsletterTypeLabel(value: string | null | undefined): string {
  if (value === 'blog_welcome') return 'Blog welcome';
  if (value === 'blog_newsletter') return 'Blog newsletter';
  return labelFor(value);
}
function maxViews(rows: BlogAnalyticsBreakdown[]): number {
  return Math.max(1, ...rows.map((row) => row.views));
}
function barWidth(value: number, max: number): string {
  return `${Math.max(2, Math.round((value / max) * 100))}%`;
}
function deviceIcon(type: string | null): LucideIcon {
  if (type === 'mobile') return Smartphone;
  if (type === 'tablet') return Tablet;
  return Monitor;
}

type Tone = 'neutral' | 'accent' | 'success' | 'warning' | 'danger';
const metricCards: { label: string; value: string; foot: string; Icon: typeof Eye; tone: Tone }[] = [
  { label: 'Views', value: formatCount(totals.views), foot: `${formatCount(totals.reads)} reads`, Icon: Eye, tone: 'accent' },
  { label: 'Unique visitors', value: formatCount(totals.uniqueVisitors), foot: `${formatMs(totals.avgVisitorReadMs)} per visitor`, Icon: Users, tone: 'success' },
  { label: 'Avg reading time', value: formatMs(totals.avgReadMs), foot: `${formatMs(BLOG_ANALYTICS_READ_THRESHOLD_MS)} read threshold`, Icon: Clock3, tone: 'warning' },
  { label: 'Completion', value: formatPercent(totals.completionRate), foot: `${formatPercent(BLOG_ANALYTICS_COMPLETION_SCROLL_DEPTH)} scroll target`, Icon: Gauge, tone: 'neutral' },
];
const newsletterCards: { label: string; value: string; foot: string; Icon: typeof Eye; tone: Tone }[] = [
  { label: 'Newsletter sent', value: formatCount(newsletter.totals.sent), foot: `${formatCount(newsletter.totals.uniqueSubscribers)} subscribers`, Icon: Send, tone: 'accent' },
  { label: 'Opens', value: formatCount(newsletter.totals.opened), foot: `${formatPercent(newsletter.totals.openRate)} unique open rate`, Icon: MailOpen, tone: 'success' },
  { label: 'Clicks', value: formatCount(newsletter.totals.clicked), foot: `${formatPercent(newsletter.totals.clickRate)} unique click rate`, Icon: MousePointer2, tone: 'warning' },
];

const breakdowns: { title: string; Icon: typeof Globe2; description: string; rows: BlogAnalyticsBreakdown[] }[] = [
  { title: 'Referrers', Icon: MousePointer2, description: 'Traffic source grouping.', rows: summary.referrers },
  { title: 'Platform', Icon: Globe2, description: 'Browser and in-app channels.', rows: summary.platforms },
  { title: 'Geo', Icon: Globe2, description: 'Country from Cloudflare metadata.', rows: summary.countries },
];

const rangeItems = (BLOG_ANALYTICS_RANGE_OPTIONS as readonly number[]).map((days) => ({
  label: `${days}d`,
  href: `/dev/portal/analytics?days=${days}`,
  active: days === rangeDays,
}));
---

<PortalLayout
  title="Blog analytics"
  description="First-party reading analytics for blog articles."
  active="analytics"
  user={{ login: session?.login || 'admin' }}
>
  <SegmentedNav slot="actions" items={rangeItems} ariaLabel="Date range" />

  {loadError && (
    <div class="portal-notice" data-variant="error">
      <Activity size={14} />
      <span>Analytics API not ready: <code>{loadError}</code></span>
    </div>
  )}
  {demoMode && (
    <div class="portal-notice">
      <Activity size={14} />
      <span>Showing demo data — the site-api binding is unavailable in local dev.</span>
    </div>
  )}

  <section class="portal-grid portal-stagger" data-columns="stats">
    {metricCards.map((metric) => (
      <StatCard label={metric.label} value={metric.value} Icon={metric.Icon} tone={metric.tone} foot={metric.foot} />
    ))}
  </section>

  <section class="portal-grid portal-stagger" data-columns="wide" style="margin-top: 24px">
    <Card className="portal-span-full">
      <CardHeader>
        <CardTitle className="portal-card-title"><Activity size={14} /> Daily traffic</CardTitle>
        <CardDescription>
          {summary.range.from && summary.range.to
            ? `${formatDay(summary.range.from)} – ${formatDay(summary.range.to)}`
            : `${summary.range.days} day window`}
        </CardDescription>
      </CardHeader>
      <CardContent className="pt-0">
        <TrafficChart daily={summary.daily} client:load />
      </CardContent>
    </Card>

    {breakdowns.map((group) => {
      const max = maxViews(group.rows);
      return (
        <Card>
          <CardHeader>
            <CardTitle className="portal-card-title"><group.Icon size={14} /> {group.title}</CardTitle>
            <CardDescription>{group.description}</CardDescription>
          </CardHeader>
          <CardContent className="pt-0">
            {group.rows.length === 0 ? (
              <EmptyState Icon={group.Icon} title={`No ${group.title.toLowerCase()} yet`} />
            ) : (
              <ol class="portal-bars">
                {group.rows.map((row) => (
                  <li>
                    <span class="portal-bars-label">{labelFor(row.label ?? row.key)}</span>
                    <span class="portal-bars-track">
                      <span class="portal-bars-fill" style={`--bar:${barWidth(row.views, max)}`}></span>
                    </span>
                    <strong class="portal-bars-value">{formatCount(row.views)}</strong>
                  </li>
                ))}
              </ol>
            )}
          </CardContent>
        </Card>
      );
    })}
  </section>

  <PortalSection
    title="Newsletter"
    eyebrow="Delivery"
    meta={`${formatCount(newsletter.campaigns.length)} campaigns`}
    class="portal-mt-lg"
  >
    <div class="portal-grid" data-columns="cards">
      {newsletterCards.map((metric) => (
        <StatCard label={metric.label} value={metric.value} Icon={metric.Icon} tone={metric.tone} foot={metric.foot} />
      ))}
    </div>

    <div class="portal-grid" data-columns="wide">
      <Card>
        <CardHeader>
          <CardTitle className="portal-card-title"><Send size={14} /> Funnel</CardTitle>
          <CardDescription>Sent → open → click over the selected range.</CardDescription>
        </CardHeader>
        <CardContent className="pt-0">
          <NewsletterFunnel totals={newsletter.totals} client:load />
        </CardContent>
      </Card>
      <Card>
        <CardHeader>
          <CardTitle className="portal-card-title"><MailOpen size={14} /> Daily activity</CardTitle>
          <CardDescription>Send, open, and click events per day.</CardDescription>
        </CardHeader>
        <CardContent className="pt-0">
          <NewsletterDailyChart daily={newsletter.daily} client:load />
        </CardContent>
      </Card>
    </div>

    {newsletter.campaigns.length === 0 ? (
      <Card><EmptyState Icon={Send} title="No campaigns yet" hint="Campaign metrics appear here once a newsletter is sent." /></Card>
    ) : (
      <Table variant="card" className="portal-table-static">
        <TableHeader>
          <TableRow>
            <TableHead>Campaign</TableHead>
            <TableHead>Type</TableHead>
            <TableHead className="text-right">Sent</TableHead>
            <TableHead className="text-right">Opens</TableHead>
            <TableHead className="text-right">Clicks</TableHead>
            <TableHead className="text-right">Open rate</TableHead>
            <TableHead className="text-right">Click rate</TableHead>
            <TableHead className="text-right">Last event</TableHead>
          </TableRow>
        </TableHeader>
        <TableBody>
          {newsletter.campaigns.map((row) => (
            <TableRow>
              <TableCell className="portal-mono">{row.campaignId}</TableCell>
              <TableCell>{newsletterTypeLabel(row.emailType)}</TableCell>
              <TableCell className="text-right">{formatCount(row.sent)}</TableCell>
              <TableCell className="text-right">{formatCount(row.opened)}</TableCell>
              <TableCell className="text-right">{formatCount(row.clicked)}</TableCell>
              <TableCell className="text-right">{formatPercent(row.openRate)}</TableCell>
              <TableCell className="text-right">{formatPercent(row.clickRate)}</TableCell>
              <TableCell className="text-right">{formatDate(row.lastEventAt)}</TableCell>
            </TableRow>
          ))}
        </TableBody>
      </Table>
    )}
  </PortalSection>

  <PortalSection title="Articles" eyebrow="Content" meta={`${formatCount(summary.articles.length)} rows`} class="portal-mt-lg">
    {summary.articles.length === 0 ? (
      <Card><EmptyState Icon={FileText} title="No article rows yet" hint="Per-article reading metrics appear here once traffic arrives." /></Card>
    ) : (
      <Table variant="card" className="portal-table-static">
        <TableHeader>
          <TableRow>
            <TableHead>Article</TableHead>
            <TableHead className="text-right">Views</TableHead>
            <TableHead className="text-right">Reads</TableHead>
            <TableHead className="text-right">Uniques</TableHead>
            <TableHead className="text-right">Avg</TableHead>
            <TableHead className="text-right">Complete</TableHead>
            <TableHead>Top platform</TableHead>
          </TableRow>
        </TableHeader>
        <TableBody>
          {summary.articles.map((row) => (
            <TableRow>
              <TableCell>
                <a class="portal-mono" href={`/dev/portal/analytics/${encodeURIComponent(row.slug)}?days=${rangeDays}`} data-astro-prefetch="false">{row.slug}</a>
              </TableCell>
              <TableCell className="text-right">{formatCount(row.views)}</TableCell>
              <TableCell className="text-right">{formatCount(row.reads)}</TableCell>
              <TableCell className="text-right">{formatCount(row.uniqueVisitors)}</TableCell>
              <TableCell className="text-right">{formatMs(row.avgReadMs)}</TableCell>
              <TableCell className="text-right">{formatPercent(row.completionRate)}</TableCell>
              <TableCell>{labelFor(row.topPlatform)}</TableCell>
            </TableRow>
          ))}
        </TableBody>
      </Table>
    )}
  </PortalSection>

  <PortalSection title="Raw event log" eyebrow="Debug" meta={`${formatCount(events.events.length)} latest`} class="portal-mt-lg">
    {events.events.length === 0 ? (
      <Card><EmptyState Icon={Terminal} title="No raw events yet" hint="The latest first-party read events stream in here." /></Card>
    ) : (
      <ol class="portal-log">
        {events.events.map((event) => {
          const DeviceIcon = deviceIcon(event.deviceType);
          return (
            <li class="portal-log-row">
              <span class="portal-log-lead">
                <span class="portal-dot" data-tone={event.completed ? 'success' : 'warning'}></span>
                <DeviceIcon />
              </span>
              <div class="portal-log-body">
                <span class="portal-log-slug">{event.slug}</span>
                <span class="portal-log-meta">{event.platform} · {event.os ?? 'unknown OS'} · {event.country ?? '—'} · {formatDate(event.openedAt)}</span>
              </div>
              <div class="portal-log-aside">
                <Badge variant="outline" size="sm">{event.refSource}</Badge>
                <span class="portal-log-metric">{formatMs(event.dwellMs)}</span>
              </div>
            </li>
          );
        })}
      </ol>
    )}
  </PortalSection>
</PortalLayout>
