---
import PortalLayout from '@/layouts/PortalLayout.astro';
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from '@/components/coss';
import StatCard from '@/components/portal/StatCard.astro';
import EmptyState from '@/components/portal/EmptyState.astro';
import PortalSection from '@/components/portal/PortalSection.astro';
import SegmentedNav from '@/components/portal/SegmentedNav.astro';
import RankedBreakdown from '@/components/portal/RankedBreakdown.astro';
import { Activity, Clock3, Compass, Cpu, Eye, FileText, Gauge, Globe2, Headphones, Layers, MailOpen, Map as MapIcon, MousePointer2, Music2, PlayCircle, Send, TrendingUp, Users, type LucideIcon } from 'lucide-react';

// Local row shape for RankedBreakdown (Astro components can't export types).
interface RankedRow {
  key: string;
  label: string;
  value: number;
  rate?: number | null;
}
import {
  BLOG_ANALYTICS_COMPLETION_SCROLL_DEPTH,
  BLOG_ANALYTICS_EVENTS_DEFAULT_LIMIT,
  BLOG_ANALYTICS_RANGE_OPTIONS,
  BLOG_ANALYTICS_READ_THRESHOLD_MS,
  type NewsletterAnalyticsSummary,
} from '@bunizao/contracts/analytics';
import { loadPortalAnalytics, type PortalAnalytics } from '@/features/admin/server/portal-client';
import { DEMO_ANALYTICS } from '@/features/admin/server/portal-analytics-demo';
import { ListeningDailyChart, NewsletterDailyChart, NewsletterFunnel, TrafficChart } from '@/features/admin/ui/AnalyticsCharts';
import { WorldChoropleth } from '@/features/admin/ui/WorldChoropleth';
import { EngagementScatter, SourceQualityChart } from '@/features/admin/ui/EngagementCharts';
import EventLog from '@/features/admin/ui/EventLog';

export const prerender = false;

const session = (Astro.locals as any).adminSession;

const requestedDays = Number(Astro.url.searchParams.get('days') || '30');
const rangeDays = (BLOG_ANALYTICS_RANGE_OPTIONS as readonly number[]).includes(requestedDays)
  ? requestedDays
  : 30;

const emptySummary: PortalAnalytics['summary'] = {
  range: { from: null, to: null, days: 7 },
  totals: { views: 0, reads: 0, uniqueVisitors: 0, avgReadMs: 0, avgVisitorReadMs: 0, completionRate: 0 },
  articles: [],
  platforms: [],
  countries: [],
  referrers: [],
  daily: [],
  newsletter: {
    totals: { sent: 0, opened: 0, clicked: 0, uniqueSubscribers: 0, openRate: 0, clickRate: 0 },
    byEmailType: [],
    campaigns: [],
    daily: [],
  },
};

let analytics: PortalAnalytics = { summary: emptySummary, events: { events: [] } };
let loadError: string | null = null;
let demoMode = false;

try {
  analytics = await loadPortalAnalytics(Astro.request, Astro.locals, { days: rangeDays });
} catch (error) {
  loadError = error instanceof Error ? error.message : 'unknown';
  if (import.meta.env.DEV && loadError === 'api_binding_unavailable') {
    analytics = DEMO_ANALYTICS;
    demoMode = true;
    loadError = null;
  }
}

const { summary, events } = analytics;
const { totals } = summary;
const newsletter: NewsletterAnalyticsSummary = summary.newsletter ?? emptySummary.newsletter!;
const countFormatter = new Intl.NumberFormat('en-US');

function formatCount(value: number | undefined): string {
  return countFormatter.format(value ?? 0);
}
function formatPercent(value: number | undefined): string {
  return `${Math.round((value ?? 0) * 100)}%`;
}
function formatMs(value: number | undefined): string {
  const seconds = Math.round((value ?? 0) / 1000);
  if (seconds < 60) return `${seconds}s`;
  const minutes = Math.floor(seconds / 60);
  const rest = seconds % 60;
  return rest ? `${minutes}m ${rest}s` : `${minutes}m`;
}
function formatDate(value: string | null | undefined): string {
  if (!value) return 'n/a';
  try {
    return new Date(value).toLocaleString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
  } catch {
    return value;
  }
}
function formatDay(value: string): string {
  try {
    return new Date(`${value}T00:00:00Z`).toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
  } catch {
    return value;
  }
}
function labelFor(value: string | null | undefined): string {
  if (!value) return 'unknown';
  return value.replace(/_/g, ' ');
}
function newsletterTypeLabel(value: string | null | undefined): string {
  if (value === 'blog_welcome') return 'Blog welcome';
  if (value === 'blog_newsletter') return 'Blog newsletter';
  return labelFor(value);
}
function rateOf(reads: number, views: number): number | null {
  return views > 0 ? reads / views : null;
}

const readThrough = rateOf(totals.reads, totals.views) ?? 0;

type Tone = 'neutral' | 'accent' | 'success' | 'warning' | 'danger';
const metricCards: { label: string; value: string; foot: string; Icon: LucideIcon; tone: Tone }[] = [
  { label: 'Views', value: formatCount(totals.views), foot: `${formatCount(totals.uniqueVisitors)} unique visitors`, Icon: Eye, tone: 'accent' },
  { label: 'Read-through', value: formatPercent(readThrough), foot: `${formatCount(totals.reads)} of ${formatCount(totals.views)} views`, Icon: TrendingUp, tone: 'success' },
  { label: 'Avg reading time', value: formatMs(totals.avgReadMs), foot: `${formatMs(BLOG_ANALYTICS_READ_THRESHOLD_MS)} read threshold`, Icon: Clock3, tone: 'warning' },
  { label: 'Completion', value: formatPercent(totals.completionRate), foot: `${formatPercent(BLOG_ANALYTICS_COMPLETION_SCROLL_DEPTH)} scroll target`, Icon: Gauge, tone: 'neutral' },
];
const newsletterCards: { label: string; value: string; foot: string; Icon: LucideIcon; tone: Tone }[] = [
  { label: 'Newsletter sent', value: formatCount(newsletter.totals.sent), foot: `${formatCount(newsletter.totals.uniqueSubscribers)} subscribers`, Icon: Send, tone: 'accent' },
  { label: 'Opens', value: formatCount(newsletter.totals.opened), foot: `${formatPercent(newsletter.totals.openRate)} unique open rate`, Icon: MailOpen, tone: 'success' },
  { label: 'Clicks', value: formatCount(newsletter.totals.clicked), foot: `${formatPercent(newsletter.totals.clickRate)} unique click rate`, Icon: MousePointer2, tone: 'warning' },
];

// Platform mix carries a read-rate chip so quality shows beside volume.
const platformRows: RankedRow[] = summary.platforms.map((p) => ({
  key: p.key,
  label: labelFor(p.label ?? p.key),
  value: p.views,
  rate: rateOf(p.reads, p.views),
}));

// Device / OS composition is only available on the raw event sample (latest
// events), so it is labelled as a sample and shown as share, not read-rate.
const eventSample = events.events;
function tally(getKey: (e: (typeof eventSample)[number]) => string | null): RankedRow[] {
  const map = new Map<string, number>();
  for (const e of eventSample) {
    const key = (getKey(e) || 'unknown').toString();
    map.set(key, (map.get(key) ?? 0) + 1);
  }
  return [...map.entries()]
    .map(([key, value]) => ({ key, label: labelFor(key), value, rate: eventSample.length ? value / eventSample.length : null }))
    .sort((a, b) => b.value - a.value);
}
const deviceRows = tally((e) => e.deviceType);
const osRows = tally((e) => e.os);

// Listening analytics is an optional slice of the summary — site-api ships it
// once the endpoint backs it, so the section renders only when there is
// actually something to show.
const listening = summary.listening ?? null;
const hasListening = Boolean(
  listening
    && (listening.totals.plays > 0
      || listening.totals.requests > 0
      || listening.tracks.length > 0
      || listening.surfaces.length > 0
      || listening.daily.length > 0),
);
const listeningCards: { label: string; value: string; foot: string; Icon: LucideIcon; tone: Tone }[] = listening
  ? [
      { label: 'Plays', value: formatCount(listening.totals.plays), foot: `${formatCount(listening.totals.requests)} requests`, Icon: PlayCircle, tone: 'accent' },
      { label: 'Unique listeners', value: formatCount(listening.totals.uniqueListeners), foot: `${formatMs(listening.totals.avgListenedMs)} avg per play`, Icon: Users, tone: 'success' },
      { label: 'Total listened', value: formatMs(listening.totals.totalListenedMs), foot: `${formatCount(listening.tracks.length)} tracks`, Icon: Clock3, tone: 'warning' },
      { label: 'Completion', value: formatPercent(listening.totals.completionRate), foot: 'plays reaching the end', Icon: Gauge, tone: 'neutral' },
    ]
  : [];
const surfaceRows: RankedRow[] = listening
  ? listening.surfaces.map((s) => ({ key: s.surface, label: labelFor(s.surface), value: s.plays, rate: s.completionRate }))
  : [];

const rangeItems = (BLOG_ANALYTICS_RANGE_OPTIONS as readonly number[]).map((days) => ({
  label: `${days}d`,
  href: `/dev/portal/analytics?days=${days}`,
  active: days === rangeDays,
}));
---

<PortalLayout
  title="Blog analytics"
  description="First-party reading analytics for blog articles."
  active="analytics"
  user={{ login: session?.login || 'admin' }}
>
  <SegmentedNav slot="actions" items={rangeItems} ariaLabel="Date range" />

  {loadError && (
    <div class="portal-notice" data-variant="error">
      <Activity size={14} />
      <span>Analytics API not ready: <code>{loadError}</code></span>
    </div>
  )}
  {demoMode && (
    <div class="portal-notice">
      <Activity size={14} />
      <span>Showing demo data — the site-api binding is unavailable in local dev.</span>
    </div>
  )}

  <section class="portal-grid portal-stagger" data-columns="stats">
    {metricCards.map((metric) => (
      <StatCard label={metric.label} value={metric.value} Icon={metric.Icon} tone={metric.tone} foot={metric.foot} />
    ))}
  </section>

  <section class="portal-grid portal-stagger" data-columns="wide" style="margin-top: 24px">
    <Card className="portal-span-full">
      <CardHeader>
        <CardTitle className="portal-card-title"><Activity size={14} /> Daily traffic</CardTitle>
        <CardDescription>
          {summary.range.from && summary.range.to
            ? `${formatDay(summary.range.from)} – ${formatDay(summary.range.to)}`
            : `${summary.range.days} day window`}
        </CardDescription>
      </CardHeader>
      <CardContent className="pt-0">
        <TrafficChart daily={summary.daily} client:load />
      </CardContent>
    </Card>
  </section>

  <PortalSection
    title="Geography"
    eyebrow="Where"
    meta={`${formatCount(summary.countries.length)} countries`}
    class="portal-mt-lg"
  >
    <Card>
      <CardHeader>
        <CardTitle className="portal-card-title"><MapIcon size={14} /> Reader map</CardTitle>
        <CardDescription>Views by country, shaded on a square-root scale. Hover to sync the map and list.</CardDescription>
      </CardHeader>
      <CardContent className="pt-0">
        {summary.countries.length === 0 ? (
          <EmptyState Icon={Globe2} title="No geographic data yet" hint="Country breakdowns appear once reads carry Cloudflare geo metadata." />
        ) : (
          <WorldChoropleth countries={summary.countries} client:load />
        )}
      </CardContent>
    </Card>
  </PortalSection>

  <PortalSection title="Acquisition & quality" eyebrow="How they arrive" class="portal-mt-lg">
    <div class="portal-grid" data-columns="wide">
      <Card className="portal-span-full">
        <CardHeader>
          <CardTitle className="portal-card-title"><Compass size={14} /> Source → read conversion</CardTitle>
          <CardDescription>Bar length is views; the green head is the share that became reads.</CardDescription>
        </CardHeader>
        <CardContent className="pt-0">
          {summary.referrers.length === 0 ? (
            <EmptyState Icon={MousePointer2} title="No referrers yet" />
          ) : (
            <SourceQualityChart referrers={summary.referrers} client:load />
          )}
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle className="portal-card-title"><Globe2 size={14} /> Platforms</CardTitle>
          <CardDescription>Browser / in-app channel · chip is read-rate.</CardDescription>
        </CardHeader>
        <CardContent className="pt-0">
          {platformRows.length === 0 ? (
            <EmptyState Icon={Globe2} title="No platform data yet" />
          ) : (
            <RankedBreakdown rows={platformRows} />
          )}
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle className="portal-card-title"><Cpu size={14} /> Devices</CardTitle>
          <CardDescription>Share of the latest {formatCount(eventSample.length)} events.</CardDescription>
        </CardHeader>
        <CardContent className="pt-0">
          {deviceRows.length === 0 ? (
            <EmptyState Icon={Cpu} title="No device data yet" />
          ) : (
            <RankedBreakdown rows={deviceRows} max={eventSample.length} rateKind="plain" />
          )}
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle className="portal-card-title"><Layers size={14} /> Operating systems</CardTitle>
          <CardDescription>Share of the latest {formatCount(eventSample.length)} events.</CardDescription>
        </CardHeader>
        <CardContent className="pt-0">
          {osRows.length === 0 ? (
            <EmptyState Icon={Layers} title="No OS data yet" />
          ) : (
            <RankedBreakdown rows={osRows} max={eventSample.length} rateKind="plain" />
          )}
        </CardContent>
      </Card>
    </div>
  </PortalSection>

  <PortalSection
    title="Content performance"
    eyebrow="What performs"
    meta={`${formatCount(summary.articles.length)} articles`}
    class="portal-mt-lg"
  >
    <Card>
      <CardHeader>
        <CardTitle className="portal-card-title"><TrendingUp size={14} /> Reach vs. read-through</CardTitle>
        <CardDescription>Each bubble is an article — size is unique visitors. Top-right wins; amber trails the median.</CardDescription>
      </CardHeader>
      <CardContent className="pt-0">
        {summary.articles.length === 0 ? (
          <EmptyState Icon={FileText} title="No article rows yet" />
        ) : (
          <EngagementScatter articles={summary.articles} client:load />
        )}
      </CardContent>
    </Card>

    {summary.articles.length > 0 && (
      <Table variant="card" className="portal-table-static">
        <TableHeader>
          <TableRow>
            <TableHead>Article</TableHead>
            <TableHead className="text-right">Views</TableHead>
            <TableHead className="text-right">Reads</TableHead>
            <TableHead className="text-right">Read-rate</TableHead>
            <TableHead className="text-right">Uniques</TableHead>
            <TableHead className="text-right">Avg</TableHead>
            <TableHead className="text-right">Complete</TableHead>
            <TableHead>Top platform</TableHead>
          </TableRow>
        </TableHeader>
        <TableBody>
          {summary.articles.map((row) => (
            <TableRow>
              <TableCell>
                <a class="portal-mono" href={`/dev/portal/analytics/${encodeURIComponent(row.slug)}?days=${rangeDays}`} data-astro-prefetch="false">{row.slug}</a>
              </TableCell>
              <TableCell className="text-right">{formatCount(row.views)}</TableCell>
              <TableCell className="text-right">{formatCount(row.reads)}</TableCell>
              <TableCell className="text-right">{formatPercent(rateOf(row.reads, row.views) ?? 0)}</TableCell>
              <TableCell className="text-right">{formatCount(row.uniqueVisitors)}</TableCell>
              <TableCell className="text-right">{formatMs(row.avgReadMs)}</TableCell>
              <TableCell className="text-right">{formatPercent(row.completionRate)}</TableCell>
              <TableCell>{labelFor(row.topPlatform)}</TableCell>
            </TableRow>
          ))}
        </TableBody>
      </Table>
    )}
  </PortalSection>

  <PortalSection
    title="Newsletter"
    eyebrow="Delivery"
    meta={`${formatCount(newsletter.campaigns.length)} campaigns`}
    class="portal-mt-lg"
  >
    <div class="portal-grid" data-columns="cards">
      {newsletterCards.map((metric) => (
        <StatCard label={metric.label} value={metric.value} Icon={metric.Icon} tone={metric.tone} foot={metric.foot} />
      ))}
    </div>

    <div class="portal-grid" data-columns="wide">
      <Card>
        <CardHeader>
          <CardTitle className="portal-card-title"><Send size={14} /> Funnel</CardTitle>
          <CardDescription>Sent → open → click over the selected range.</CardDescription>
        </CardHeader>
        <CardContent className="pt-0">
          <NewsletterFunnel totals={newsletter.totals} client:load />
        </CardContent>
      </Card>
      <Card>
        <CardHeader>
          <CardTitle className="portal-card-title"><MailOpen size={14} /> Daily activity</CardTitle>
          <CardDescription>Send, open, and click events per day.</CardDescription>
        </CardHeader>
        <CardContent className="pt-0">
          <NewsletterDailyChart daily={newsletter.daily} client:load />
        </CardContent>
      </Card>
    </div>

    {newsletter.campaigns.length === 0 ? (
      <Card><EmptyState Icon={Send} title="No campaigns yet" hint="Campaign metrics appear here once a newsletter is sent." /></Card>
    ) : (
      <Table variant="card" className="portal-table-static">
        <TableHeader>
          <TableRow>
            <TableHead>Campaign</TableHead>
            <TableHead>Type</TableHead>
            <TableHead className="text-right">Sent</TableHead>
            <TableHead className="text-right">Opens</TableHead>
            <TableHead className="text-right">Clicks</TableHead>
            <TableHead className="text-right">Open rate</TableHead>
            <TableHead className="text-right">Click rate</TableHead>
            <TableHead className="text-right">Last event</TableHead>
          </TableRow>
        </TableHeader>
        <TableBody>
          {newsletter.campaigns.map((row) => (
            <TableRow>
              <TableCell className="portal-mono">{row.campaignId}</TableCell>
              <TableCell>{newsletterTypeLabel(row.emailType)}</TableCell>
              <TableCell className="text-right">{formatCount(row.sent)}</TableCell>
              <TableCell className="text-right">{formatCount(row.opened)}</TableCell>
              <TableCell className="text-right">{formatCount(row.clicked)}</TableCell>
              <TableCell className="text-right">{formatPercent(row.openRate)}</TableCell>
              <TableCell className="text-right">{formatPercent(row.clickRate)}</TableCell>
              <TableCell className="text-right">{formatDate(row.lastEventAt)}</TableCell>
            </TableRow>
          ))}
        </TableBody>
      </Table>
    )}
  </PortalSection>

  {listening && hasListening && (
    <PortalSection
      title="Listening"
      eyebrow="Audio"
      meta={`${formatCount(listening.tracks.length)} tracks`}
      class="portal-mt-lg"
    >
      <div class="portal-grid" data-columns="cards">
        {listeningCards.map((metric) => (
          <StatCard label={metric.label} value={metric.value} Icon={metric.Icon} tone={metric.tone} foot={metric.foot} />
        ))}
      </div>

      <div class="portal-grid" data-columns="wide">
        <Card className="portal-span-full">
          <CardHeader>
            <CardTitle className="portal-card-title"><Headphones size={14} /> Daily activity</CardTitle>
            <CardDescription>Plays and unique listeners per day.</CardDescription>
          </CardHeader>
          <CardContent className="pt-0">
            <ListeningDailyChart daily={listening.daily} client:load />
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle className="portal-card-title"><Compass size={14} /> Surfaces</CardTitle>
            <CardDescription>Where playback started · chip is completion rate.</CardDescription>
          </CardHeader>
          <CardContent className="pt-0">
            {surfaceRows.length === 0 ? (
              <EmptyState Icon={Compass} title="No surface data yet" />
            ) : (
              <RankedBreakdown rows={surfaceRows} />
            )}
          </CardContent>
        </Card>
      </div>

      {listening.tracks.length === 0 ? (
        <Card><EmptyState Icon={Music2} title="No tracks played yet" /></Card>
      ) : (
        <Table variant="card" className="portal-table-static">
          <TableHeader>
            <TableRow>
              <TableHead>Track</TableHead>
              <TableHead className="text-right">Plays</TableHead>
              <TableHead className="text-right">Listeners</TableHead>
              <TableHead className="text-right">Avg listened</TableHead>
              <TableHead className="text-right">Completion</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {listening.tracks.map((track) => (
              <TableRow>
                <TableCell>
                  <span>{track.trackTitle}</span>
                  {track.trackArtist && <span class="block text-xs text-muted-foreground">{track.trackArtist}</span>}
                </TableCell>
                <TableCell className="text-right">{formatCount(track.plays)}</TableCell>
                <TableCell className="text-right">{formatCount(track.uniqueListeners)}</TableCell>
                <TableCell className="text-right">{formatMs(track.avgListenedMs)}</TableCell>
                <TableCell className="text-right">{formatPercent(track.completionRate)}</TableCell>
              </TableRow>
            ))}
          </TableBody>
        </Table>
      )}
    </PortalSection>
  )}

  <PortalSection title="Raw event log" eyebrow="Debug" meta={`${formatCount(events.events.length)} initial · live via auto-refresh`} class="portal-mt-lg">
    <EventLog events={events.events} limit={BLOG_ANALYTICS_EVENTS_DEFAULT_LIMIT} client:load />
  </PortalSection>
</PortalLayout>
