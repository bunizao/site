---
import PortalLayout from '@/layouts/PortalLayout.astro';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/coss';
import { buttonVariants } from '@/components/coss/button';
import StatCard from '@/components/portal/StatCard.astro';
import EmptyState from '@/components/portal/EmptyState.astro';
import PortalSection from '@/components/portal/PortalSection.astro';
import SegmentedNav from '@/components/portal/SegmentedNav.astro';
import { Activity, ArrowLeft, Clock3, Eye, Gauge, Globe2, MousePointer2, Users, type LucideIcon } from 'lucide-react';
import { BLOG_ANALYTICS_RANGE_OPTIONS } from '@bunizao/contracts/analytics';
import { loadArticleAnalytics } from '@/features/admin/server/portal-client';
import { TrafficChart } from '@/features/admin/ui/AnalyticsCharts';

export const prerender = false;

const session = (Astro.locals as any).adminSession;
const slug = Astro.params.slug as string;

const requestedDays = Number(Astro.url.searchParams.get('days') || '30');
const rangeDays = (BLOG_ANALYTICS_RANGE_OPTIONS as readonly number[]).includes(requestedDays)
  ? requestedDays
  : 30;

let detail: Awaited<ReturnType<typeof loadArticleAnalytics>> | null = null;
try {
  detail = slug
    ? await loadArticleAnalytics(slug, Astro.request, Astro.locals, { days: rangeDays })
    : null;
} catch {
  detail = null;
}

const countFormatter = new Intl.NumberFormat('en-US');

function formatCount(value: number | undefined): string {
  return countFormatter.format(value ?? 0);
}
function formatPercent(value: number | undefined): string {
  return `${Math.round((value ?? 0) * 100)}%`;
}
function formatMs(value: number | undefined): string {
  const seconds = Math.round((value ?? 0) / 1000);
  if (seconds < 60) return `${seconds}s`;
  const minutes = Math.floor(seconds / 60);
  const rest = seconds % 60;
  return rest ? `${minutes}m ${rest}s` : `${minutes}m`;
}
function labelFor(value: string | null | undefined): string {
  if (!value) return 'unknown';
  return value.replace(/_/g, ' ');
}
function barWidth(value: number, max: number): string {
  return `${Math.max(2, Math.round((value / max) * 100))}%`;
}

type Tone = 'neutral' | 'accent' | 'success' | 'warning' | 'danger';
const metricCards: { label: string; value: string; foot?: string; Icon: LucideIcon; tone: Tone }[] = detail
  ? [
      { label: 'Views', value: formatCount(detail.totals.views), foot: `${formatCount(detail.totals.reads)} reads`, Icon: Eye, tone: 'accent' },
      { label: 'Unique visitors', value: formatCount(detail.totals.uniqueVisitors), foot: `${formatMs(detail.totals.avgVisitorReadMs)} per visitor`, Icon: Users, tone: 'success' },
      { label: 'Avg reading time', value: formatMs(detail.totals.avgReadMs), Icon: Clock3, tone: 'warning' },
      { label: 'Completion', value: formatPercent(detail.totals.completionRate), Icon: Gauge, tone: 'neutral' },
    ]
  : [];

const breakdowns = detail
  ? [
      { title: 'Referrers', Icon: MousePointer2, description: 'Traffic source grouping.', rows: detail.referrers },
      { title: 'Platforms', Icon: Globe2, description: 'Browser and in-app channels.', rows: detail.platforms },
      { title: 'Countries', Icon: Globe2, description: 'Country from Cloudflare metadata.', rows: detail.countries },
    ]
  : [];
const scrollMax = Math.max(1, ...(detail?.scrollBuckets.map((bucket) => bucket.count) ?? [1]));

const rangeItems = (BLOG_ANALYTICS_RANGE_OPTIONS as readonly number[]).map((days) => ({
  label: `${days}d`,
  href: `/dev/portal/analytics/${encodeURIComponent(slug)}?days=${days}`,
  active: days === rangeDays,
}));
---

<PortalLayout
  title={slug || 'Article'}
  description="Per-article traffic, referrers, and completion."
  active="analytics"
  user={{ login: session?.login || 'admin' }}
>
  <SegmentedNav slot="actions" items={rangeItems} ariaLabel="Date range" />

  <a
    href={`/dev/portal/analytics?days=${rangeDays}`}
    class={`${buttonVariants({ variant: 'ghost', size: 'sm' })} self-start`}
    data-astro-prefetch="false"
    style="margin-bottom: 20px"
  >
    <ArrowLeft className="size-3.5" /> Back to analytics
  </a>

  {!detail ? (
    <Card><EmptyState Icon={Activity} title="No analytics for this article" hint="The per-article endpoint may not be deployed yet, or no reads have landed in this window." /></Card>
  ) : (
    <Fragment>
      <section class="portal-grid portal-stagger" data-columns="stats">
        {metricCards.map((metric) => (
          <StatCard label={metric.label} value={metric.value} Icon={metric.Icon} tone={metric.tone} foot={metric.foot} />
        ))}
      </section>

      <section class="portal-grid portal-stagger" data-columns="wide" style="margin-top: 24px">
        <Card className="portal-span-full">
          <CardHeader>
            <CardTitle className="portal-card-title"><Activity size={14} /> Daily traffic</CardTitle>
            <CardDescription>{rangeDays} day window</CardDescription>
          </CardHeader>
          <CardContent className="pt-0">
            <TrafficChart daily={detail.daily} client:load />
          </CardContent>
        </Card>

        {breakdowns.map((group) => {
          const max = Math.max(1, ...group.rows.map((row) => row.views));
          return (
            <Card>
              <CardHeader>
                <CardTitle className="portal-card-title"><group.Icon size={14} /> {group.title}</CardTitle>
                <CardDescription>{group.description}</CardDescription>
              </CardHeader>
              <CardContent className="pt-0">
                {group.rows.length === 0 ? (
                  <EmptyState Icon={group.Icon} title={`No ${group.title.toLowerCase()} yet`} />
                ) : (
                  <ol class="portal-bars">
                    {group.rows.slice(0, 8).map((row) => (
                      <li>
                        <span class="portal-bars-label">{labelFor(row.label ?? row.key)}</span>
                        <span class="portal-bars-track">
                          <span class="portal-bars-fill" style={`--bar:${barWidth(row.views, max)}`}></span>
                        </span>
                        <strong class="portal-bars-value">{formatCount(row.views)}</strong>
                      </li>
                    ))}
                  </ol>
                )}
              </CardContent>
            </Card>
          );
        })}

        <Card>
          <CardHeader>
            <CardTitle className="portal-card-title"><Gauge size={14} /> Scroll depth</CardTitle>
            <CardDescription>How far readers get before leaving.</CardDescription>
          </CardHeader>
          <CardContent className="pt-0">
            <ol class="portal-bars">
              {detail.scrollBuckets.map((bucket) => (
                <li>
                  <span class="portal-bars-label">{bucket.bucket}</span>
                  <span class="portal-bars-track">
                    <span class="portal-bars-fill" style={`--bar:${barWidth(bucket.count, scrollMax)}`}></span>
                  </span>
                  <strong class="portal-bars-value">{formatCount(bucket.count)}</strong>
                </li>
              ))}
            </ol>
          </CardContent>
        </Card>
      </section>
    </Fragment>
  )}
</PortalLayout>
