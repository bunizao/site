---
import PortalLayout from '@/layouts/PortalLayout.astro';
import {
  Badge,
  Card,
  CardAction,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from '@/components/coss';
import { buttonVariants } from '@/components/coss/button';
import StatCard from '@/components/portal/StatCard.astro';
import EmptyState from '@/components/portal/EmptyState.astro';
import { Activity, ArrowRight, Clock, PenLine, Send, UserMinus, Users } from 'lucide-react';
import { loadPortalOverview, type PortalOverview } from '@/features/admin/server/portal-client';
import { DEMO_OVERVIEW } from '@/features/admin/server/portal-demo';

export const prerender = false;

const session = (Astro.locals as any).adminSession;

let overview: PortalOverview = {
  subscriberStats: { total: 0, pendingCount: 0, activeCount: 0, unsubscribedCount: 0 },
  auditEvents: [],
  broadcasts: [],
};
let loadError: string | null = null;
let demoMode = false;

try {
  overview = await loadPortalOverview(Astro.request, Astro.locals);
} catch (error) {
  loadError = error instanceof Error ? error.message : 'unknown';
  // In local dev the site-api service binding is often absent. Rather than a
  // wall of zeros, render a realistic fixture so the portal is designable.
  if (import.meta.env.DEV) {
    overview = DEMO_OVERVIEW;
    demoMode = true;
    loadError = null;
  }
}

const { subscriberStats, auditEvents, broadcasts } = overview;
const { total, activeCount, pendingCount, unsubscribedCount } = subscriberStats;
const lastBroadcast = broadcasts[0];

const activeRate = total > 0 ? Math.round((activeCount / total) * 100) : 0;
const churnRate = total > 0 ? Math.round((unsubscribedCount / total) * 100) : 0;

const BROADCAST_STATUS_VARIANT: Record<string, 'success' | 'warning' | 'secondary' | 'destructive'> = {
  sent: 'success',
  sending: 'warning',
  draft: 'secondary',
  failed: 'destructive',
};

type Tone = 'neutral' | 'accent' | 'success' | 'warning' | 'danger';
const EVENT_META: Record<string, { tone: Tone; label: string }> = {
  subscribe_requested: { tone: 'accent', label: 'Subscribe' },
  subscription_confirmed: { tone: 'success', label: 'Confirmed' },
  unsubscribed: { tone: 'danger', label: 'Unsubscribed' },
  admin_create: { tone: 'neutral', label: 'Created' },
  admin_update: { tone: 'neutral', label: 'Updated' },
  admin_delete: { tone: 'danger', label: 'Deleted' },
  admin_resend_confirm: { tone: 'warning', label: 'Resent' },
  broadcast_sent: { tone: 'accent', label: 'Broadcast' },
};
function eventMeta(type: string): { tone: Tone; label: string } {
  return EVENT_META[type] ?? { tone: 'neutral', label: type };
}

const lastBroadcastTone: Tone = lastBroadcast
  ? lastBroadcast.failedCount > 0
    ? 'warning'
    : 'success'
  : 'neutral';

function formatDate(iso: string): string {
  try {
    return new Date(iso).toLocaleString(undefined, {
      month: 'short',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    });
  } catch {
    return iso;
  }
}
---

<PortalLayout
  title="Overview"
  description="Subscriber health and recent delivery activity."
  active="overview"
  user={{ login: session?.login || 'admin' }}
>
  <a
    slot="actions"
    href="/dev/portal/broadcasts"
    class={`${buttonVariants({ size: 'sm' })} portal-press`}
    data-astro-prefetch="false"
  >
    <PenLine /> Compose broadcast
  </a>

  {loadError && (
    <div class="portal-notice" data-variant="error">
      <Activity size={14} />
      <span>Failed to load some data: <code>{loadError}</code></span>
    </div>
  )}
  {demoMode && (
    <div class="portal-notice">
      <Activity size={14} />
      <span>Showing demo data — the site-api binding is unavailable in local dev.</span>
    </div>
  )}

  <section class="portal-grid portal-stagger" data-columns="stats">
    <StatCard
      label="Active subscribers"
      value={activeCount.toLocaleString()}
      Icon={Users}
      tone="accent"
      foot={total > 0 ? `${activeRate}% of ${total.toLocaleString()} total` : 'of 0 total'}
    />
    <StatCard
      label="Pending"
      value={pendingCount.toLocaleString()}
      Icon={Clock}
      tone="warning"
      foot="awaiting confirmation"
    />
    <StatCard
      label="Unsubscribed"
      value={unsubscribedCount.toLocaleString()}
      Icon={UserMinus}
      tone="neutral"
      foot={total > 0 ? `${churnRate}% churn` : 'opted out'}
    />

    <StatCard
      label="Last broadcast"
      Icon={Send}
      tone={lastBroadcastTone}
      href={lastBroadcast ? `/dev/portal/broadcasts/${lastBroadcast.id}` : undefined}
    >
      {lastBroadcast ? (
        <Fragment>
          <div class="portal-stat-value" data-size="sm">{lastBroadcast.subject}</div>
          <div class="portal-stat-foot">
            <Badge variant={BROADCAST_STATUS_VARIANT[lastBroadcast.status] ?? 'secondary'} size="sm">
              {lastBroadcast.status}
            </Badge>
            <span class="tabular-nums">{lastBroadcast.sentCount.toLocaleString()} sent · {lastBroadcast.failedCount} failed</span>
          </div>
        </Fragment>
      ) : (
        <div class="portal-stat-value" data-size="sm" style="color: hsl(var(--muted-foreground))">
          No broadcasts yet
        </div>
      )}
    </StatCard>
  </section>

  <section class="portal-grid portal-stagger" data-columns="wide">
    <Card>
      <CardHeader>
        <CardTitle className="portal-card-title"><Activity size={14} /> Recent activity</CardTitle>
        <CardDescription>Subscribe, confirm, unsubscribe, admin, and broadcast events.</CardDescription>
        <CardAction>
          <a href="/dev/portal/subscribers" class="portal-sec-link" data-astro-prefetch="false">
            View all <ArrowRight size={12} />
          </a>
        </CardAction>
      </CardHeader>
      <CardContent className="pt-0">
        {auditEvents.length === 0 ? (
          <EmptyState
            Icon={Activity}
            title="No activity yet"
            hint="Subscribe, confirm, unsubscribe, and broadcast events will land here as they happen."
          />
        ) : (
          <ul class="portal-feed">
            {auditEvents.map((event) => {
              const meta = eventMeta(event.eventType);
              return (
                <li class="portal-feed-row" data-layout="event">
                  <span class="portal-feed-label">
                    <span class="portal-dot" data-tone={meta.tone}></span>
                    {meta.label}
                  </span>
                  <span class="portal-feed-primary">{event.email}</span>
                  <span class="portal-feed-time">{formatDate(event.createdAt)}</span>
                </li>
              );
            })}
          </ul>
        )}
      </CardContent>
    </Card>

    <Card>
      <CardHeader>
        <CardTitle className="portal-card-title"><Send size={14} /> Recent broadcasts</CardTitle>
        <CardDescription>The five most recent manual broadcasts.</CardDescription>
        <CardAction>
          <a href="/dev/portal/broadcasts" class="portal-sec-link" data-astro-prefetch="false">
            View all <ArrowRight size={12} />
          </a>
        </CardAction>
      </CardHeader>
      <CardContent className="pt-0">
        {broadcasts.length === 0 ? (
          <EmptyState Icon={Send} title="No broadcasts yet" hint="Compose your first broadcast to reach your subscribers.">
            <a
              slot="action"
              href="/dev/portal/broadcasts"
              class={`${buttonVariants({ size: 'sm', variant: 'outline' })} portal-press`}
              data-astro-prefetch="false"
            >
              <PenLine /> Compose broadcast
            </a>
          </EmptyState>
        ) : (
          <ul class="portal-feed">
            {broadcasts.map((bc) => (
              <li>
                <a class="portal-feed-row" data-layout="split" href={`/dev/portal/broadcasts/${bc.id}`} data-astro-prefetch="false">
                  <span class="min-w-0">
                    <span class="portal-feed-primary">{bc.subject}</span>
                    <span class="portal-feed-sub">
                      {bc.sentCount.toLocaleString()}/{bc.recipientCount.toLocaleString()} sent · {bc.failedCount} failed
                    </span>
                  </span>
                  <span class="portal-feed-time">{bc.sentAt ? formatDate(bc.sentAt) : 'pending'}</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </CardContent>
    </Card>
  </section>
</PortalLayout>
