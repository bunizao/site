---
import PortalLayout from '@/layouts/PortalLayout.astro';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { Users, Send, Sparkles, Mail, Activity } from 'lucide-react';
import { getPeekAssets } from '@/features/mascot/peek/catalog';
import { PEEK_SLOTS } from '@/features/mascot/peek/slots';
import { loadPortalOverview, type PortalOverview } from '@/features/admin/server/portal-client';

export const prerender = false;

const session = (Astro.locals as any).adminSession;

let overview: PortalOverview = {
  subscriberStats: { total: 0, pendingCount: 0, activeCount: 0, unsubscribedCount: 0 },
  auditEvents: [],
  broadcasts: [],
};
let loadError: string | null = null;

try {
  overview = await loadPortalOverview(Astro.request, Astro.locals);
} catch (error) {
  loadError = error instanceof Error ? error.message : 'unknown';
}

const { subscriberStats, auditEvents, broadcasts } = overview;
const allAssets = getPeekAssets();
const lastBroadcast = broadcasts[0];

function formatDate(iso: string): string {
  try {
    const date = new Date(iso);
    return date.toLocaleString(undefined, {
      month: 'short',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    });
  } catch {
    return iso;
  }
}
---

<PortalLayout
  title="Overview"
  description="At-a-glance view of subscribers, broadcasts, and mascot inventory."
  active="overview"
  user={{ login: session?.login || 'admin' }}
>
  {loadError && (
    <div class="portal-alert">
      Failed to load some data: <span class="portal-mono">{loadError}</span>
    </div>
  )}

  <section class="portal-grid" data-columns="stats">
    <Card>
      <CardHeader className="portal-stat-header">
        <CardDescription>Active subscribers</CardDescription>
        <Users size={16} />
      </CardHeader>
      <CardContent className="portal-stat-content">
        <div class="portal-stat-value">{subscriberStats.activeCount}</div>
        <div class="portal-stat-hint">
          of {subscriberStats.total} total · {subscriberStats.pendingCount} pending
        </div>
      </CardContent>
    </Card>

    <Card>
      <CardHeader className="portal-stat-header">
        <CardDescription>Last broadcast</CardDescription>
        <Send size={16} />
      </CardHeader>
      <CardContent className="portal-stat-content">
        {lastBroadcast ? (
          <Fragment>
            <div class="portal-stat-value" data-size="sm">{lastBroadcast.subject}</div>
            <div class="portal-stat-hint">
              {lastBroadcast.sentCount} sent · {lastBroadcast.failedCount} failed
            </div>
            <div class="portal-stat-hint">{lastBroadcast.sentAt ? formatDate(lastBroadcast.sentAt) : 'never'}</div>
          </Fragment>
        ) : (
          <div class="portal-empty">No broadcasts yet</div>
        )}
      </CardContent>
    </Card>

    <Card>
      <CardHeader className="portal-stat-header">
        <CardDescription>Mascot library</CardDescription>
        <Sparkles size={16} />
      </CardHeader>
      <CardContent className="portal-stat-content">
        <div class="portal-stat-value">{allAssets.length}</div>
        <div class="portal-stat-hint">
          {PEEK_SLOTS.length} runtime slots
        </div>
      </CardContent>
    </Card>

    <Card>
      <CardHeader className="portal-stat-header">
        <CardDescription>Templates</CardDescription>
        <Mail size={16} />
      </CardHeader>
      <CardContent className="portal-stat-content">
        <div class="portal-stat-value">6</div>
        <div class="portal-stat-hint">
          subscribe, welcome, blog, mood, digest, unsub
        </div>
      </CardContent>
    </Card>
  </section>

  <section class="portal-grid" data-columns="wide">
    <Card>
      <CardHeader>
        <CardTitle className="portal-card-title"><Activity size={14} />Recent activity</CardTitle>
        <CardDescription>Latest audit events across subscribe, confirm, unsubscribe, admin, and broadcast.</CardDescription>
      </CardHeader>
      <CardContent className="portal-card-content">
        {auditEvents.length === 0 ? (
          <div class="portal-empty">No events yet.</div>
        ) : (
          <ul class="portal-list">
            {auditEvents.map((event) => (
              <li class="portal-list-row" data-layout="event">
                <span class="portal-list-key">{event.eventType}</span>
                <span class="portal-list-primary">{event.email}</span>
                <span class="portal-list-meta">{formatDate(event.createdAt)}</span>
              </li>
            ))}
          </ul>
        )}
      </CardContent>
    </Card>

    <Card>
      <CardHeader>
        <CardTitle className="portal-card-title">Recent broadcasts</CardTitle>
        <CardDescription>The five most recent manual broadcasts.</CardDescription>
      </CardHeader>
      <CardContent className="portal-card-content">
        {broadcasts.length === 0 ? (
          <div class="portal-empty">No broadcasts yet. Try composing one.</div>
        ) : (
          <ul class="portal-list">
            {broadcasts.map((bc) => (
              <li class="portal-list-row" data-layout="split">
                <div>
                  <a href={`/dev/portal/broadcasts/${bc.id}`} class="portal-list-link">{bc.subject}</a>
                  <div class="portal-list-meta" data-spacing="top">
                    {bc.sentCount}/{bc.recipientCount} sent · {bc.failedCount} failed
                  </div>
                </div>
                <span class="portal-list-meta">{bc.sentAt ? formatDate(bc.sentAt) : 'pending'}</span>
              </li>
            ))}
          </ul>
        )}
      </CardContent>
    </Card>
  </section>
</PortalLayout>
