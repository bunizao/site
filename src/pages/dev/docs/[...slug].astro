---
// The owner's view of the docs tree: every public page plus the
// *.internal.md ones, in one rail. The middleware gates every /dev path with
// Cloudflare Access and marks it no-store, so this page must render per
// request: a prerendered copy would be served as a static asset and skip that
// gate.
import Layout from '@/layouts/Layout.astro';
import DocsArticle from '@/features/docs/ui/DocsArticle.astro';
import DocsSidebar from '@/features/docs/ui/DocsSidebar.astro';
import DocsSearch from '@/features/docs/ui/DocsSearch.astro';
import { OWNER_DOCS_BASE, docPath, getDocsNav, isInternalDoc } from '@/features/docs/server/nav';
import '@/styles/docs.css';

export const prerender = false;

const groups = await getDocsNav({ includeInternal: true });
const slug = Astro.params.slug ?? '';
const entry = slug
  ? groups.flatMap((group) => group.entries).find((candidate) => candidate.id === slug)
  : undefined;
if (slug && !entry) {
  return new Response('Not found', { status: 404, headers: { 'Content-Type': 'text/plain; charset=utf-8' } });
}

const internalGroups = groups
  .map((group) => ({ label: group.label, entries: group.entries.filter(isInternalDoc) }))
  .filter((group) => group.entries.length > 0);
---

<Layout
  title={entry ? entry.data.title : 'Owner docs'}
  description={entry ? entry.data.description : 'The docs tree with its owner-only pages.'}
  url={entry ? docPath(entry.id, OWNER_DOCS_BASE) : OWNER_DOCS_BASE}
  robots="noindex, nofollow"
  navVariant="docs"
  containedScroll
>
  {entry ? (
    <DocsArticle entry={entry} groups={groups} base={OWNER_DOCS_BASE} />
  ) : (
    <main class="docs docs--article">
      <div class="docs-shell docs-shell--article">
        <DocsSidebar groups={groups} base={OWNER_DOCS_BASE} />
        <article class="docs-article">
          <h1 class="docs-title">Owner docs</h1>
          <p class="docs-lede">
            The full tree: every public page, plus the ones marked Internal that
            /docs leaves out.
          </p>
          {internalGroups.length > 0 ? (
            <div class="owner-docs-index">
              {internalGroups.map((group) => (
                <section>
                  <h2>{group.label}</h2>
                  <ul>
                    {group.entries.map((item) => (
                      <li>
                        <a href={docPath(item.id, OWNER_DOCS_BASE)}>{item.data.title}</a>
                        <span>{item.data.description}</span>
                      </li>
                    ))}
                  </ul>
                </section>
              ))}
            </div>
          ) : (
            <p class="docs-lede">
              This build has no decrypted internal pages. They are transcrypt
              ciphertext in any checkout without the key, so only the public
              ones are listed.
            </p>
          )}
        </article>
      </div>
    </main>
    <DocsSearch base={OWNER_DOCS_BASE} />
  )}
</Layout>

<style>
  .owner-docs-index {
    display: grid;
    gap: 2rem;
    font-family: var(--font-sans);
  }

  .owner-docs-index h2 {
    margin: 0 0 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink-faint);
  }

  .owner-docs-index ul {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .owner-docs-index li {
    display: grid;
    gap: 0.2rem;
  }

  .owner-docs-index a {
    font-weight: 600;
    color: hsl(var(--foreground));
    text-decoration: none;
  }

  .owner-docs-index a:hover {
    text-decoration: underline;
  }

  .owner-docs-index span {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink-body);
  }
</style>
