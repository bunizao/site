---
import Layout from '@/layouts/Layout.astro';
import PixelLogo from '@/features/logos/ui/PixelLogo.astro';
import { getLogo } from '@/features/logos/lib/svg';
import { AnimatedLogo } from '@/features/logos/ui/AnimatedLogo';
import TemplatePreview from '@/features/notify/ui/TemplatePreview';

export const prerender = false;

const mascot = getLogo('peek');
const animationEntries = Object.entries(mascot.animations);
const animationMap = new Map(animationEntries);
const gallerySections = mascot.gallery ?? [
  {
    id: 'all',
    label: 'All States',
    description: 'Full mascot state list.',
    items: animationEntries.map(([name]) => name),
  },
];
const runtimeBehaviors = mascot.runtimeBehaviors ?? [];
const requestedView = Astro.url.searchParams.get('view')?.trim().toLowerCase();
const activeView = requestedView === 'newsletter' ? 'newsletter' : 'mascot';

const title = activeView === 'newsletter' ? 'Newsletter Live Preview' : 'Peek Mascot Preview';
const description = activeView === 'newsletter'
  ? 'Real-time preview for email notification templates.'
  : 'Development preview for the peek mascot states and navbar motion.';
---

<Layout title={title} description={description} navVariant="page">
  <main class="mx-auto flex w-full max-w-[1500px] flex-col gap-8 px-4 py-8 md:px-6 md:py-12">
    <header class="space-y-2">
      <p class="text-xs uppercase tracking-[0.18em] text-muted-foreground">Dev Preview</p>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="space-y-2">
          <h1 class="text-xl font-semibold uppercase tracking-[0.18em]">{title}</h1>
          <p class="max-w-3xl text-sm text-muted-foreground">
            {
              activeView === 'newsletter'
                ? 'Live preview generated from current channel data and real notify templates.'
                : 'Review the shipped navbar behavior and every mascot animation from the logo source of truth.'
            }
          </p>
        </div>
        <nav class="flex flex-wrap gap-2" aria-label="Preview routes">
          <a
            class:list={[
              'preview-link',
              { 'preview-link--active': activeView === 'mascot' },
            ]}
            href="/dev/preview?view=mascot"
            aria-current={activeView === 'mascot' ? 'page' : undefined}
          >
            Mascot
          </a>
          <a
            class:list={[
              'preview-link',
              { 'preview-link--active': activeView === 'newsletter' },
            ]}
            href="/dev/preview?view=newsletter"
            aria-current={activeView === 'newsletter' ? 'page' : undefined}
          >
            Newsletter
          </a>
        </nav>
      </div>
    </header>

    {activeView === 'newsletter' ? (
      <TemplatePreview client:load />
    ) : (
      <>
        <section class="preview-hero-grid">
          <article class="preview-panel preview-panel--hero">
            <div class="preview-stage preview-stage--hero">
              <AnimatedLogo
                client:load
                id="peek"
                animation="idle"
                hoverAnimation="dart"
                size={144}
                title="peek navbar behavior"
              />
            </div>
            <div class="space-y-3">
              <div>
                <p class="preview-eyebrow">Navbar behavior</p>
                <h2 class="preview-title">idle at rest, dart on hover</h2>
              </div>
              <p class="preview-copy">
                This is the real brand setup used in the site chrome: `idle` stays still until hover, then `dart`
                kicks in.
              </p>
            </div>
          </article>

          <article class="preview-panel preview-panel--hero">
            <div class="preview-stage preview-stage--hero preview-stage--static">
              <PixelLogo id="peek" size={144} title="peek base grid" />
            </div>
            <div class="space-y-3">
              <div>
                <p class="preview-eyebrow">Mascot source</p>
                <h2 class="preview-title">{mascot.name} / {mascot.tagline}</h2>
              </div>
              <p class="preview-copy">{mascot.blurb}</p>
              <dl class="preview-meta-grid">
                <div>
                  <dt>Grid</dt>
                  <dd>{mascot.width} × {mascot.height}</dd>
                </div>
                <div>
                  <dt>Accent</dt>
                  <dd>{mascot.accent}</dd>
                </div>
                <div>
                  <dt>Actions</dt>
                  <dd>{animationEntries.length}</dd>
                </div>
              </dl>
            </div>
          </article>
        </section>

        {runtimeBehaviors.length > 0 && (
          <section class="space-y-3">
            <div class="space-y-1">
              <p class="preview-eyebrow">Runtime map</p>
              <h2 class="text-lg font-semibold tracking-[0.08em]">Live behavior wiring</h2>
            </div>
            <div class="runtime-grid">
              {runtimeBehaviors.map((behavior) => (
                <article class="runtime-card">
                  <p class="runtime-card__label">{behavior.label}</p>
                  <p class="runtime-card__animation">{behavior.animation}</p>
                  <p class="preview-copy">{behavior.description}</p>
                </article>
              ))}
            </div>
          </section>
        )}

        {gallerySections.map((section) => (
          <section class="space-y-3" id={`gallery-${section.id}`}>
            <div class="space-y-1">
              <p class="preview-eyebrow">Mascot lab</p>
              <h2 class="text-lg font-semibold tracking-[0.08em]">{section.label}</h2>
              <p class="preview-copy">{section.description}</p>
            </div>
            <div class="preview-card-grid">
              {section.items.map((key) => {
                const animation = animationMap.get(key);
                if (!animation) return null;
                return (
                  <article class="preview-panel">
                    <div class="preview-stage">
                      <AnimatedLogo
                        client:load
                        id="peek"
                        animation={key}
                        loop={animation.previewLoop ?? animation.loop}
                        size={112}
                        title={`peek ${key}`}
                      />
                    </div>
                    <div class="space-y-3">
                      <div class="space-y-2">
                        <div class="preview-card-head">
                          <h3 class="preview-title">{animation.label ?? key}</h3>
                          <span class={`preview-kind preview-kind--${animation.kind ?? 'loop'}`}>
                            {animation.kind ?? 'loop'}
                          </span>
                        </div>
                        <p class="preview-copy">{animation.summary ?? 'No summary yet.'}</p>
                        {animation.usage && <p class="preview-usage">{animation.usage}</p>}
                      </div>
                      <dl class="preview-meta-grid">
                        <div>
                          <dt>Key</dt>
                          <dd>{key}</dd>
                        </div>
                        <div>
                          <dt>Frames</dt>
                          <dd>{animation.frames.length}</dd>
                        </div>
                        <div>
                          <dt>FPS</dt>
                          <dd>{animation.fps}</dd>
                        </div>
                      </dl>
                      <dl class="preview-meta-grid">
                        <div>
                          <dt>Loop</dt>
                          <dd>{animation.loop === false ? 'No' : 'Yes'}</dd>
                        </div>
                        <div>
                          <dt>Alias</dt>
                          <dd>{animation.aliasOf ?? '—'}</dd>
                        </div>
                        <div>
                          <dt>Tags</dt>
                          <dd>{animation.tags?.join(', ') ?? '—'}</dd>
                        </div>
                      </dl>
                    </div>
                  </article>
                );
              })}
            </div>
          </section>
        ))}
      </>
    )}
  </main>
</Layout>

<style>
  .preview-link {
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    padding: 0.55rem 0.9rem;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
    transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease;
  }

  .preview-link:hover {
    border-color: hsl(var(--foreground) / 0.22);
    background: hsl(var(--accent));
    color: hsl(var(--foreground));
  }

  .preview-link--active {
    border-color: hsl(var(--foreground) / 0.16);
    background: hsl(var(--foreground));
    color: hsl(var(--background));
  }

  .preview-hero-grid {
    display: grid;
    gap: 1rem;
  }

  .preview-card-grid {
    display: grid;
    gap: 1rem;
  }

  .runtime-grid {
    display: grid;
    gap: 1rem;
  }

  .preview-panel {
    display: grid;
    gap: 1.25rem;
    border: 1px solid hsl(var(--border));
    border-radius: 1.5rem;
    background:
      radial-gradient(circle at top, hsl(var(--foreground) / 0.05), transparent 48%),
      hsl(var(--card));
    padding: 1.25rem;
  }

  .preview-panel--hero {
    grid-template-columns: minmax(0, 180px) minmax(0, 1fr);
    align-items: center;
  }

  .preview-stage {
    display: grid;
    place-items: center;
    min-height: 180px;
    border: 1px solid hsl(var(--border));
    border-radius: 1.2rem;
    background:
      linear-gradient(180deg, hsl(var(--background)) 0%, hsl(var(--background) / 0.72) 100%),
      linear-gradient(135deg, hsl(var(--accent) / 0.5), transparent 65%);
    box-shadow: inset 0 1px 0 hsl(var(--foreground) / 0.04);
  }

  .preview-stage--hero {
    min-height: 220px;
  }

  .preview-stage--static :global(svg) {
    width: 144px;
    height: auto;
  }

  .preview-eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }

  .preview-title {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .preview-copy {
    font-size: 0.92rem;
    line-height: 1.65;
    color: hsl(var(--muted-foreground));
  }

  .preview-usage {
    font-size: 0.84rem;
    line-height: 1.55;
    color: hsl(var(--foreground) / 0.74);
  }

  .preview-card-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .preview-kind {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    border: 1px solid hsl(var(--border));
    padding: 0.28rem 0.6rem;
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
    background: hsl(var(--background) / 0.75);
  }

  .preview-kind--alias {
    color: hsl(var(--foreground));
  }

  .preview-kind--one-shot {
    color: hsl(var(--foreground));
  }

  .runtime-card {
    display: grid;
    gap: 0.45rem;
    border: 1px solid hsl(var(--border));
    border-radius: 1rem;
    background: hsl(var(--card));
    padding: 1rem 1.1rem;
  }

  .runtime-card__label {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }

  .runtime-card__animation {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .preview-meta-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .preview-meta-grid dt {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }

  .preview-meta-grid dd {
    margin-top: 0.3rem;
    font-size: 0.88rem;
    word-break: break-word;
  }

  @media (min-width: 900px) {
    .preview-hero-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .runtime-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .preview-card-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1320px) {
    .runtime-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .preview-card-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .preview-panel--hero {
      grid-template-columns: minmax(0, 1fr);
    }

    .preview-meta-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
