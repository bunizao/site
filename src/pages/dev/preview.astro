---
import Layout from '@/layouts/Layout.astro';
import PixelLogo from '@/features/logos/ui/PixelLogo.astro';
import PeekLook from '@/features/logos/ui/PeekLook.astro';
import AnimatedLogo from '@/features/logos/ui/AnimatedLogo.astro';
import {
  PEEK_NAVBAR_LOGO,
  PEEK_PREVIEW_TRACKER_LOGO,
  createPeekLogoFromAssets,
} from '@/features/logos/data/peek-runtime';
import TemplatePreview from '@/features/notify/ui/TemplatePreview';
import {
  getPeekAssets,
  getPeekBase,
  getPeekPreviewSections,
  getPeekRuntimeBehaviors,
  getPeekSlotKey,
  getPeekTrackingPoseKeys,
} from '@/features/mascot/peek/catalog';
import { PEEK_SLOTS } from '@/features/mascot/peek/slots';

export const prerender = false;

const mascot = getPeekBase();
const allAssets = getPeekAssets();
const motionAssets = allAssets.filter((asset) => asset.kind === 'motion');
const poseAssets = allAssets.filter((asset) => asset.kind === 'pose');
const expressionAssets = allAssets.filter((asset) => asset.kind === 'expression');
const costumeAssets = allAssets.filter((asset) => asset.kind === 'costume');
const previewSections = getPeekPreviewSections();
const runtimeBehaviors = getPeekRuntimeBehaviors();
const navbarDefaultAnimation = getPeekSlotKey('navbar.brand.default');
const navbarHoverAnimation = getPeekSlotKey('navbar.brand.hover');
const previewTrackerDefault = getPeekSlotKey('preview.tracker.default');
const previewTrackPoses = getPeekTrackingPoseKeys('preview');

const requestedView = Astro.url.searchParams.get('view')?.trim().toLowerCase();
const activeView = requestedView === 'newsletter' ? 'newsletter' : 'mascot';
const title = activeView === 'newsletter' ? 'Newsletter Preview' : 'Peek Preview';
const description = activeView === 'newsletter'
  ? 'Live preview for every notification email template.'
  : 'Every peek state — motions, poses, expressions, costumes, and live behavior wiring.';

const statRail = activeView === 'newsletter'
  ? [
      { label: 'Templates', value: '5' },
      { label: 'Modes', value: '2' },
      { label: 'Samples', value: '2' },
      { label: 'Runtime', value: 'notify' },
    ]
  : [
      { label: 'Motions', value: motionAssets.length },
      { label: 'Poses', value: poseAssets.length },
      { label: 'Expressions', value: expressionAssets.length },
      { label: 'Costumes', value: costumeAssets.length },
      { label: 'Slots', value: PEEK_SLOTS.length },
      { label: 'Grid', value: `${mascot.width}×${mascot.height}` },
    ];

const sectionIndex = (() => {
  let n = 0;
  return () => String(n++).padStart(2, '0');
})();

const runtimeSectionNo = sectionIndex();
const brandSectionNo = sectionIndex();
const trackingSectionNo = sectionIndex();
const librarySections = previewSections.map((section) => ({
  ...section,
  number: sectionIndex(),
}));
---

<Layout title={title} description={description} hideSiteNav>
  <main class="dev-console">
    <header class="dev-console__head">
      <div class="dev-console__eyebrow">
        <span class="dev-console__tag">DEV</span>
        <span class="dev-console__sep">/</span>
        <span>Preview Console</span>
        <span class="dev-console__sep">/</span>
        <span class="dev-console__view">{activeView}</span>
      </div>

      <div class="dev-console__headline">
        <h1 class="dev-console__title">{title}</h1>
        <p class="dev-console__description">{description}</p>
      </div>

      <nav class="dev-tabs" aria-label="Preview routes">
        <a
          class:list={['dev-tab', { 'dev-tab--active': activeView === 'mascot' }]}
          href="/dev/preview?view=mascot"
          aria-current={activeView === 'mascot' ? 'page' : undefined}
        >
          <span class="dev-tab__index">01</span>
          <span class="dev-tab__label">Mascot</span>
        </a>
        <a
          class:list={['dev-tab', { 'dev-tab--active': activeView === 'newsletter' }]}
          href="/dev/preview?view=newsletter"
          aria-current={activeView === 'newsletter' ? 'page' : undefined}
        >
          <span class="dev-tab__index">02</span>
          <span class="dev-tab__label">Newsletter</span>
        </a>
      </nav>

      <dl class="dev-stats">
        {statRail.map((stat) => (
          <div class="dev-stat">
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))}
      </dl>
    </header>

    {activeView === 'newsletter' ? (
      <TemplatePreview client:load />
    ) : (
      <div class="dev-sections">
        <section class="dev-section" id="runtime-map">
          <header class="dev-section__head">
            <span class="dev-section__index">{runtimeSectionNo}</span>
            <div>
              <h2 class="dev-section__title">Runtime Map</h2>
              <p class="dev-section__description">
                Where each peek state is wired into the live site. Hover the navbar or idle for ten seconds
                to see these trigger for real.
              </p>
            </div>
          </header>
          <div class="runtime-grid">
            {runtimeBehaviors.map((behavior) => (
              <article class="runtime-card">
                <span class="runtime-card__slot">{behavior.slotId}</span>
                <h3 class="runtime-card__label">{behavior.label}</h3>
                <p class="runtime-card__copy">{behavior.description}</p>
                <div class="runtime-card__wire">
                  <span class="runtime-card__arrow" aria-hidden="true">→</span>
                  <code>{behavior.animation}</code>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="dev-section" id="brand-behavior">
          <header class="dev-section__head">
            <span class="dev-section__index">{brandSectionNo}</span>
            <div>
              <h2 class="dev-section__title">Brand Behavior</h2>
              <p class="dev-section__description">
                The real navbar wiring — idle at rest, dart on hover — next to the base pixel source.
              </p>
            </div>
          </header>
          <div class="brand-grid">
            <article class="brand-card">
              <div class="brand-card__stage">
                <AnimatedLogo
                  definition={PEEK_NAVBAR_LOGO}
                  animation={navbarDefaultAnimation}
                  hoverAnimation={navbarHoverAnimation}
                  size={144}
                  title="peek navbar behavior"
                  eventAnimations={[navbarHoverAnimation]}
                />
                <span class="brand-card__hint">Hover me</span>
              </div>
              <div class="brand-card__body">
                <span class="brand-card__eyebrow">live behavior</span>
                <h3 class="brand-card__title">idle at rest, dart on hover</h3>
                <p class="brand-card__copy">
                  Same component mounted in the site chrome. The idle loop holds until pointer enter,
                  then the dart motion triggers and the slot reverts after its hold window.
                </p>
                <dl class="brand-card__meta">
                  <div><dt>Rest</dt><dd><code>{navbarDefaultAnimation}</code></dd></div>
                  <div><dt>Hover</dt><dd><code>{navbarHoverAnimation}</code></dd></div>
                </dl>
              </div>
            </article>

            <article class="brand-card">
              <div class="brand-card__stage brand-card__stage--static">
                <PixelLogo id="peek" size={144} title="peek base grid" />
              </div>
              <div class="brand-card__body">
                <span class="brand-card__eyebrow">mascot source</span>
                <h3 class="brand-card__title">{mascot.name} · {mascot.tagline}</h3>
                <p class="brand-card__copy">{mascot.blurb}</p>
                <dl class="brand-card__meta">
                  <div><dt>Grid</dt><dd>{mascot.width} × {mascot.height}</dd></div>
                  <div><dt>Accent</dt><dd>{mascot.accent}</dd></div>
                  <div><dt>Assets</dt><dd>{allAssets.length}</dd></div>
                </dl>
              </div>
            </article>
          </div>
        </section>

        <section class="dev-section" id="tracking">
          <header class="dev-section__head">
            <span class="dev-section__index">{trackingSectionNo}</span>
            <div>
              <h2 class="dev-section__title">Tracking Stage</h2>
              <p class="dev-section__description">
                Pointer-driven pose switcher. Five track buckets snap to horizontal regions;
                leaving the stage reverts to <code>scan</code>.
              </p>
            </div>
          </header>
          <article class="tracker-card">
            <div
              class="tracker-card__stage"
              data-peek-tracker
              data-peek-track-poses={JSON.stringify(previewTrackPoses)}
              tabindex="0"
              role="img"
              aria-label="Interactive tracking pose demo"
            >
              <AnimatedLogo
                definition={PEEK_PREVIEW_TRACKER_LOGO}
                animation={previewTrackerDefault}
                eventChannel="preview-track"
                eventAnimations={previewTrackPoses}
                size={156}
                title="interactive tracking pose demo"
              />
              <div class="tracker-card__bands" aria-hidden="true">
                {previewTrackPoses.map((key) => (
                  <span class="tracker-card__band"><code>{key}</code></span>
                ))}
              </div>
              <span class="tracker-card__hint">Move across the stage</span>
            </div>
            <div class="tracker-card__body">
              <span class="brand-card__eyebrow">tracking demo</span>
              <h3 class="brand-card__title">Pointer-driven pose switching</h3>
              <p class="brand-card__copy">
                Move across the stage and peek will snap between directional poses. This is the
                same rig used on the 404 page.
              </p>
              <dl class="brand-card__meta">
                <div><dt>Base</dt><dd><code>{previewTrackerDefault}</code></dd></div>
                <div><dt>Buckets</dt><dd>{previewTrackPoses.length} poses</dd></div>
                <div><dt>Channel</dt><dd><code>preview-track</code></dd></div>
              </dl>
            </div>
          </article>
        </section>

        {librarySections.map((section) => (
          <section class="dev-section" id={`lib-${section.id}`}>
            <header class="dev-section__head">
              <span class="dev-section__index">{section.number}</span>
              <div>
                <h2 class="dev-section__title">{section.label}</h2>
                <p class="dev-section__description">{section.description}</p>
              </div>
              <span class="dev-section__count">{section.items.length}</span>
            </header>
            <div class="library-grid">
              {section.items.map((item) => {
                const isLook = item.kind === 'expression' || item.kind === 'costume';
                const lookItem = isLook && item.grid
                  ? { grid: item.grid, label: item.label, palette: item.palette }
                  : null;
                const kindTag = item.motionKind ?? item.kind;
                return (
                  <article class="library-card" data-kind={kindTag}>
                    <div class:list={['library-card__stage', { 'library-card__stage--look': isLook }]}>
                      {lookItem ? (
                        <PeekLook look={lookItem} size={108} title={`peek ${item.label}`} />
                      ) : (
                        <AnimatedLogo
                          definition={createPeekLogoFromAssets([item])}
                          animation={item.key}
                          loop={item.previewLoop ?? item.loop}
                          size={108}
                          title={`peek ${item.key}`}
                        />
                      )}
                    </div>
                    <div class="library-card__body">
                      <div class="library-card__head">
                        <h3 class="library-card__title">{item.label}</h3>
                        <span class="library-card__kind">{kindTag}</span>
                      </div>
                      <p class="library-card__copy">{item.summary}</p>
                      {item.usage && <p class="library-card__usage">{item.usage}</p>}
                      <dl class="library-card__meta">
                        <div><dt>Key</dt><dd><code>{item.key}</code></dd></div>
                        {item.frames && (
                          <div><dt>Frames</dt><dd>{item.frames.length}</dd></div>
                        )}
                        {item.fps !== undefined && (
                          <div><dt>FPS</dt><dd>{item.fps}</dd></div>
                        )}
                        {item.loop !== undefined && !item.frames?.length ? null : (
                          item.loop !== undefined && (
                            <div><dt>Loop</dt><dd>{item.loop ? 'yes' : 'once'}</dd></div>
                          )
                        )}
                        <div>
                          <dt>Tags</dt>
                          <dd>
                            {item.tags.length ? item.tags.map((tag) => (
                              <span class="library-card__tag">{tag}</span>
                            )) : <span class="library-card__tag library-card__tag--empty">none</span>}
                          </dd>
                        </div>
                      </dl>
                    </div>
                  </article>
                );
              })}
            </div>
          </section>
        ))}
      </div>
    )}
  </main>
</Layout>

<script>
  (() => {
    const tracker = document.querySelector('[data-peek-tracker]');
    if (!(tracker instanceof HTMLElement)) return;

    const setPose = (animation: string) => {
      window.dispatchEvent(new CustomEvent('peek:preview-track:set', { detail: { animation } }));
    };

    const revertPose = () => {
      window.dispatchEvent(new CustomEvent('peek:preview-track:revert'));
    };

    const TRACK_POSES = JSON.parse(tracker.dataset.peekTrackPoses ?? '[]');

    const pickPose = (clientX: number) => {
      const rect = tracker.getBoundingClientRect();
      if (rect.width <= 0) return TRACK_POSES[2];
      const ratio = Math.min(0.9999, Math.max(0, (clientX - rect.left) / rect.width));
      if (ratio < 0.2) return TRACK_POSES[0];
      if (ratio < 0.4) return TRACK_POSES[1];
      if (ratio < 0.6) return TRACK_POSES[2];
      if (ratio < 0.8) return TRACK_POSES[3];
      return TRACK_POSES[4];
    };

    tracker.addEventListener('pointerenter', (event) => {
      setPose(pickPose(event.clientX));
    });

    tracker.addEventListener('pointermove', (event) => {
      setPose(pickPose(event.clientX));
    });

    tracker.addEventListener('pointerleave', revertPose);
    tracker.addEventListener('blur', revertPose);
  })();
</script>

<style>
  .dev-console {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  @media (min-width: 768px) {
    .dev-console {
      padding: 3rem 2rem 5rem;
      gap: 3rem;
    }
  }

  /* ── Header ─────────────────────────────────────── */
  .dev-console__head {
    display: grid;
    gap: 1.25rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid hsl(var(--foreground) / 0.08);
  }

  .dev-console__eyebrow {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.55rem;
    font-size: 0.68rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }

  .dev-console__tag {
    padding: 0.22rem 0.55rem;
    border: 1px solid hsl(var(--foreground) / 0.18);
    border-radius: 4px;
    font-weight: 600;
    letter-spacing: 0.28em;
    color: hsl(var(--foreground));
  }

  .dev-console__sep {
    opacity: 0.4;
  }

  .dev-console__view {
    color: hsl(var(--foreground));
  }

  .dev-console__headline {
    display: grid;
    gap: 0.5rem;
  }

  .dev-console__title {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .dev-console__description {
    max-width: 52ch;
    font-size: 0.9rem;
    color: hsl(var(--muted-foreground));
    line-height: 1.55;
  }

  /* ── Tabs ──────────────────────────────────────── */
  .dev-tabs {
    display: inline-flex;
    gap: 0;
    border: 1px solid hsl(var(--foreground) / 0.1);
    border-radius: 10px;
    padding: 4px;
    background: hsl(var(--background));
    width: fit-content;
  }

  .dev-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 0.95rem;
    border-radius: 6px;
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
    transition: background-color 150ms ease, color 150ms ease;
    cursor: pointer;
  }

  .dev-tab:hover {
    color: hsl(var(--foreground));
  }

  .dev-tab__index {
    font-variant-numeric: tabular-nums;
    opacity: 0.55;
    font-size: 0.64rem;
  }

  .dev-tab--active {
    background: hsl(var(--foreground));
    color: hsl(var(--background));
  }

  .dev-tab--active .dev-tab__index {
    opacity: 0.65;
    color: hsl(var(--background));
  }

  /* ── Stats rail ────────────────────────────────── */
  .dev-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    border: 1px solid hsl(var(--foreground) / 0.08);
    border-radius: 12px;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .dev-stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .dev-stats {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  .dev-stat {
    display: grid;
    gap: 0.3rem;
    padding: 0.85rem 1rem;
    border-right: 1px solid hsl(var(--foreground) / 0.06);
    border-bottom: 1px solid hsl(var(--foreground) / 0.06);
  }

  .dev-stat:last-child {
    border-right: none;
  }

  .dev-stat dt {
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }

  .dev-stat dd {
    font-size: 1rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.005em;
    color: hsl(var(--foreground));
  }

  /* ── Sections ──────────────────────────────────── */
  .dev-sections {
    display: grid;
    gap: 2.5rem;
  }

  .dev-section {
    display: grid;
    gap: 1.25rem;
    padding: 0;
    border: 0;
  }

  .dev-section__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px dashed hsl(var(--foreground) / 0.1);
  }

  .dev-section__index {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    font-variant-numeric: tabular-nums;
    color: hsl(var(--muted-foreground));
    padding-top: 0.2rem;
  }

  .dev-section__title {
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.005em;
  }

  .dev-section__description {
    margin-top: 0.25rem;
    max-width: 64ch;
    font-size: 0.82rem;
    color: hsl(var(--muted-foreground));
    line-height: 1.55;
  }

  .dev-section__description code {
    font-size: 0.8em;
    padding: 0.05rem 0.3rem;
    border-radius: 4px;
    background: hsl(var(--foreground) / 0.06);
  }

  .dev-section__count {
    font-size: 0.64rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
    padding: 0.3rem 0.55rem;
    border: 1px solid hsl(var(--foreground) / 0.1);
    border-radius: 999px;
    font-variant-numeric: tabular-nums;
  }

  /* ── Runtime grid ──────────────────────────────── */
  .runtime-grid {
    display: grid;
    gap: 10px;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .runtime-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .runtime-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .runtime-card {
    display: grid;
    gap: 0.55rem;
    padding: 0.95rem 1rem 1rem;
    border: 1px solid hsl(var(--foreground) / 0.08);
    border-radius: 12px;
    background: hsl(var(--background));
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .runtime-card:hover {
    border-color: hsl(var(--foreground) / 0.14);
    box-shadow: 0 10px 30px -18px hsl(var(--foreground) / 0.25);
  }

  .runtime-card__slot {
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
    font-variant-numeric: tabular-nums;
  }

  .runtime-card__label {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.005em;
  }

  .runtime-card__copy {
    font-size: 0.8rem;
    line-height: 1.55;
    color: hsl(var(--muted-foreground));
  }

  .runtime-card__wire {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.2rem;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
  }

  .runtime-card__arrow {
    color: hsl(var(--muted-foreground));
  }

  .runtime-card__wire code {
    padding: 0.18rem 0.5rem;
    border: 1px solid hsl(var(--foreground) / 0.1);
    border-radius: 4px;
    background: hsl(var(--foreground) / 0.04);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  /* ── Brand grid ────────────────────────────────── */
  .brand-grid {
    display: grid;
    gap: 12px;
    grid-template-columns: 1fr;
  }

  @media (min-width: 900px) {
    .brand-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .brand-card {
    display: grid;
    grid-template-columns: minmax(0, 210px) minmax(0, 1fr);
    gap: 1.25rem;
    align-items: center;
    padding: 1.1rem;
    border: 1px solid hsl(var(--foreground) / 0.08);
    border-radius: 14px;
    background: hsl(var(--background));
  }

  @media (max-width: 720px) {
    .brand-card {
      grid-template-columns: 1fr;
    }
  }

  .brand-card__stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 200px;
    border: 1px solid hsl(var(--foreground) / 0.06);
    border-radius: 12px;
    background:
      radial-gradient(circle, hsl(var(--grid)) 1px, transparent 1px) 0 0 / 16px 16px,
      hsl(var(--background));
  }

  .brand-card__stage--static {
    background: hsl(var(--background));
  }

  .brand-card__hint {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
    padding: 0.22rem 0.55rem;
    border: 1px solid hsl(var(--foreground) / 0.08);
    border-radius: 999px;
    background: hsl(var(--background));
  }

  .brand-card__body {
    display: grid;
    gap: 0.6rem;
  }

  .brand-card__eyebrow {
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }

  .brand-card__title {
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    line-height: 1.3;
  }

  .brand-card__copy {
    font-size: 0.82rem;
