---
import Layout from '@/layouts/Layout.astro';
import TemplatePreview from '@/features/notify/ui/TemplatePreview';

const title = 'Newsletter Live Preview';
const description = 'Real-time preview for email notification templates.';
---

<Layout title={title} description={description}>
  <main class="mx-auto w-full max-w-[1500px] px-4 py-8 md:px-6 md:py-12">
    <header class="mb-6 space-y-2">
      <h1 class="text-xl font-semibold uppercase tracking-[0.18em]">Newsletter Live Preview</h1>
      <p class="text-sm text-muted-foreground">
        Live preview generated from current channel data and real notify templates.
      </p>
    </header>
    <TemplatePreview client:load />
  </main>
</Layout>
