---
import Layout from '../layouts/Layout.astro';
import TimelineWheel from '@/features/mood/ui/TimelineWheel.astro';
import FeedShell from '@/features/mood/ui/FeedShell.astro';
import NotifyPanel from '@/features/mood/ui/NotifyPanel.astro';
import { loadMoodChannelSnapshot } from '@/features/mood/server/channel-service';
import { buildMoodFeedResponse } from '@/features/mood/server/feed-service';
import {
  getMoodFeedAnchorBeforeCursor,
  getMoodFeedAnchorWindowBeforeCursor,
  mergeMoodFeedWindowPosts,
  readMoodFeedAnchorId,
} from '@/features/mood/shared/feed-anchor';
import { isE2ESiteFixtureEnabled } from '@/lib/e2e';
import { buildSrcSet, withWidthParam } from '@/lib/media/responsive-image';
import '@/styles/mood-gallery.css';

export const prerender = false;

const title = "Moods | Bunizao's Website";
const description = "Thoughts and moments from my Telegram channel";
const rss = { href: '/mood/rss.xml', title: 'Moods RSS' };
const canonicalUrl = new URL(Astro.url.pathname, Astro.url.origin).href;
const oembed = { href: `/api/oembed.json?url=${encodeURIComponent(canonicalUrl)}`, title: 'Mood Embed' };
const channel = import.meta.env.CHANNEL || Astro.locals?.runtime?.env?.CHANNEL || '';
const telegramUrl = channel ? `https://t.me/${channel}` : '';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
const moodFeedAnchorId = readMoodFeedAnchorId(Astro.url);
const moodFeedAnchorBeforeCursor = getMoodFeedAnchorBeforeCursor(moodFeedAnchorId);
const moodFeedAnchorWindowBeforeCursor = getMoodFeedAnchorWindowBeforeCursor(moodFeedAnchorId);

async function loadInitialMoodFeed() {
  if (isE2ESiteFixtureEnabled(Astro.locals)) return null;

  const context = { request: Astro.request, locals: Astro.locals };

  try {
    if (moodFeedAnchorId) {
      const focused = moodFeedAnchorWindowBeforeCursor
        ? await loadMoodChannelSnapshot(context, { before: moodFeedAnchorWindowBeforeCursor })
        : null;
      const focusedPosts = focused?.posts ?? [];
      if (focused && focusedPosts.some((post) => post.id === moodFeedAnchorId)) {
        return buildMoodFeedResponse(context, focused.channelInfo, focusedPosts);
      }

      const fallback = (
        moodFeedAnchorBeforeCursor
        && moodFeedAnchorBeforeCursor !== moodFeedAnchorWindowBeforeCursor
      )
        ? await loadMoodChannelSnapshot(context, { before: moodFeedAnchorBeforeCursor })
        : null;
      const fallbackPosts = fallback?.posts ?? [];
      if (fallback && fallbackPosts.length > 0) {
        return buildMoodFeedResponse(context, fallback.channelInfo, fallbackPosts);
      }

      if (focused && focusedPosts.length > 0) {
        return buildMoodFeedResponse(
          context,
          focused.channelInfo,
          mergeMoodFeedWindowPosts(focusedPosts)
        );
      }
    }

    const latest = await loadMoodChannelSnapshot(context);
    return buildMoodFeedResponse(context, latest.channelInfo, latest.posts);
  } catch (error) {
    console.warn('Failed to load initial mood feed:', error);
    return null;
  }
}

const initialFeed = await loadInitialMoodFeed();
const preloadImageWidths = [480, 800, 1200];
const preloadImageSizes = '(min-width: 1024px) 560px, (min-width: 640px) 480px, 100vw';
const firstFeedImage = initialFeed?.posts.find((post) => post.image)?.image ?? '';
const preloadImages = firstFeedImage
  ? [{
      href: withWidthParam(firstFeedImage, 800),
      imageSrcSet: buildSrcSet(firstFeedImage, preloadImageWidths),
      imageSizes: preloadImageSizes,
    }]
  : [];
// Skeleton structure: 2 date group cards to match actual content layout
const skeletonGroups = [
  {
    index: 0,
    dateWidth: '52px', // "Today" length
    items: [
      { index: 0, lineWidth: '72%' },
      { index: 1, lineWidth: '58%' },
      { index: 2, lineWidth: '66%' },
    ],
  },
  {
    index: 1,
    dateWidth: '76px', // "Yesterday" length
    items: [
      { index: 0, lineWidth: '64%' },
      { index: 1, lineWidth: '70%' },
    ],
  },
];
---

<Layout title={title} description={description} rss={rss} oembed={oembed} preloadImages={preloadImages}>
  <!-- Inject page-specific header actions -->
  <script is:inline define:vars={{ telegramUrl, turnstileSiteKey }}>
    (() => {
      const siteNav = document.querySelector('[data-site-nav]');
      if (siteNav) siteNav.style.display = 'none';

      const headerActions = document.querySelector('[data-header-actions]');
      if (!headerActions) return;

      if (headerActions.querySelector('[data-mood-header-action]')) {
        return;
      }

      const rssBtn = document.createElement('a');
      rssBtn.className = 'header-action-btn';
      rssBtn.href = '/mood/rss.xml';
      rssBtn.title = 'Subscribe to RSS feed';
      rssBtn.dataset.moodHeaderAction = 'rss';
      rssBtn.innerHTML = `
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 11a9 9 0 0 1 9 9"></path>
          <path d="M4 4a16 16 0 0 1 16 16"></path>
          <circle cx="5" cy="19" r="1"></circle>
        </svg>
        <span class="header-action-btn-label">RSS</span>
      `;

      let telegramBtn = null;
      if (telegramUrl) {
        telegramBtn = document.createElement('a');
        telegramBtn.className = 'header-action-btn';
        telegramBtn.href = telegramUrl;
        telegramBtn.target = '_blank';
        telegramBtn.rel = 'noopener noreferrer';
        telegramBtn.title = 'View on Telegram';
        telegramBtn.dataset.moodHeaderAction = 'telegram';
        telegramBtn.innerHTML = `
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m22 2-7 20-4-9-9-4Z"></path>
            <path d="M22 2 11 13"></path>
          </svg>
          <span class="header-action-btn-label">Telegram</span>
        `;
      }

      const notifyBtn = document.createElement('button');
      notifyBtn.className = 'header-action-btn';
      notifyBtn.type = 'button';
      notifyBtn.title = 'Subscribe to notifications';
      notifyBtn.dataset.moodHeaderAction = 'notify';
      notifyBtn.setAttribute('data-notify-toggle', '');
      notifyBtn.setAttribute('aria-haspopup', 'dialog');
      notifyBtn.setAttribute('aria-expanded', 'false');
      notifyBtn.innerHTML = `
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
          <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
        </svg>
        <span class="header-action-btn-label">Notify</span>
      `;

      const themeDropdown = headerActions.querySelector('[data-theme-dropdown]');
      if (themeDropdown) {
        headerActions.insertBefore(notifyBtn, themeDropdown);
        headerActions.insertBefore(rssBtn, themeDropdown);
        if (telegramBtn) {
          headerActions.insertBefore(telegramBtn, themeDropdown);
        }
      } else {
        headerActions.appendChild(notifyBtn);
        headerActions.appendChild(rssBtn);
        if (telegramBtn) {
          headerActions.appendChild(telegramBtn);
        }
      }

      const notifyPanel = document.querySelector('.notify-panel');
      if (notifyPanel instanceof HTMLElement) {
        notifyPanel.dataset.turnstileSiteKey = turnstileSiteKey;
      }

      const registerWithGSAP = () => {
        if (window.headerBtnAnimations) {
          window.headerBtnAnimations.register(rssBtn);
          if (telegramBtn) {
            window.headerBtnAnimations.register(telegramBtn);
          }
          window.headerBtnAnimations.register(notifyBtn);
        } else {
          setTimeout(registerWithGSAP, 100);
        }
      };
      registerWithGSAP();
    })();
  </script>

  <!-- Compact header buttons auto-collapse on scroll past hero -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const heroEl = document.querySelector('[data-mood-hero]');
      const headerActions = document.querySelector('[data-header-actions]');
      if (!heroEl || !headerActions) return;

      const isCompactViewport = () => window.innerWidth < 900;
      let gsapPromise: Promise<typeof import('gsap')['default']> | null = null;
      const loadGsap = () => {
        gsapPromise ??= import('gsap').then(({ default: gsap }) => gsap);
        return gsapPromise;
      };

      let isCollapsed = false;

      const collapseButtons = async () => {
        if (isCollapsed) return;
        isCollapsed = true;
        headerActions.classList.add('is-collapsed');

        const gsap = await loadGsap();
        gsap.to(headerActions, {
          x: '100%',
          opacity: 0,
          duration: 0.35,
          ease: 'power2.inOut',
        });
      };

      const expandButtons = async () => {
        if (!isCollapsed) return;
        isCollapsed = false;
        headerActions.classList.remove('is-collapsed');

        const gsap = await loadGsap();
        gsap.to(headerActions, {
          x: 0,
          opacity: 1,
          duration: 0.3,
          ease: 'power2.out',
        });
      };

      // Use Intersection Observer to detect when hero leaves viewport
      const observer = new IntersectionObserver(
        (entries) => {
          if (!isCompactViewport()) {
            if (isCollapsed) {
              isCollapsed = false;
              headerActions.classList.remove('is-collapsed');
              headerActions.removeAttribute('style');
            }
            return;
          }

          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              void expandButtons();
            } else {
              void collapseButtons();
            }
          });
        },
        {
          // Trigger when hero bottom edge crosses viewport top
          rootMargin: '0px 0px 0px 0px',
          threshold: 0,
        }
      );

      observer.observe(heroEl);

      // Handle resize: reset state when switching between mobile/desktop
      let resizeTimer: ReturnType<typeof setTimeout> | undefined;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          if (!isCompactViewport() && isCollapsed) {
            isCollapsed = false;
            headerActions.classList.remove('is-collapsed');
            headerActions.removeAttribute('style');
          }
        }, 100);
      });
    });
  </script>
  <main class="page-container">
    <TimelineWheel />
    <FeedShell
      skeletonGroups={skeletonGroups}
      initialPosts={initialFeed?.posts ?? []}
      initialChannel={initialFeed?.channel}
      anchorId={moodFeedAnchorId}
    />
  </main>
  <NotifyPanel turnstileSiteKey={turnstileSiteKey} />
</Layout>

<style>
  /* Loading State - Card-based Skeleton */
  :global(.mood-loading) {
    display: block;
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
  }

  :global(.mood-loading.is-hidden) {
    display: none;
  }

  :global(.mood-skeleton-stream) {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  @media (min-width: 640px) {
    :global(.mood-skeleton-stream) {
      gap: 48px;
    }
  }

  :global(.mood-skeleton-group) {
    background: hsl(var(--background));
    border-radius: 12px;
    padding: 20px;
    border: 1px solid hsl(var(--foreground) / 0.06);
    box-shadow: 0 1px 0 hsl(var(--foreground) / 0.03);
    --group-delay: calc(var(--group-index, 0) * 0.15s);
  }

  @media (min-width: 640px) {
    :global(.mood-skeleton-group) {
      padding: 24px;
      border-radius: 16px;
    }
  }

  /* Skeleton Header */
  :global(.mood-skeleton-header) {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
  }

  @media (min-width: 640px) {
    :global(.mood-skeleton-header) {
      margin-bottom: 24px;
    }
  }

  :global(.mood-skeleton-date) {
    display: block;
    width: var(--date-width, 60px);
    height: 12px;
    background: hsl(var(--foreground) / 0.06);
    border-radius: 4px;
    position: relative;
    overflow: hidden;
  }

  :global(.mood-skeleton-date::after) {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      hsl(var(--foreground) / 0.08) 50%,
      transparent 100%
    );
    animation: skeleton-shimmer 2s ease-in-out infinite;
    animation-delay: var(--group-delay);
  }

  :global(.mood-skeleton-header-line) {
    flex: 1;
    height: 1px;
    background: hsl(var(--foreground) / 0.08);
  }

  /* Skeleton Items */
  :global(.mood-skeleton-items) {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  :global(.mood-skeleton-item) {
    display: flex;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid hsl(var(--foreground) / 0.04);
    --item-delay: calc(var(--group-delay) + var(--item-index, 0) * 0.08s);
  }

  :global(.mood-skeleton-item:last-child) {
    border-bottom: none;
    padding-bottom: 4px;
  }

  @media (min-width: 640px) {
    :global(.mood-skeleton-item) {
      padding: 18px 0;
      gap: 18px;
    }
  }

  @media (max-width: 640px) {
    :global(.mood-skeleton-item) {
      flex-direction: column;
      gap: 8px;
    }
  }

  :global(.mood-skeleton-time) {
    display: block;
    width: 36px;
    height: 12px;
    background: hsl(var(--foreground) / 0.05);
    border-radius: 4px;
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
  }

  :global(.mood-skeleton-time::after) {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      hsl(var(--foreground) / 0.06) 50%,
      transparent 100%
    );
    animation: skeleton-shimmer 2s ease-in-out infinite;
    animation-delay: var(--item-delay);
  }

  @media (min-width: 640px) {
    :global(.mood-skeleton-time) {
      width: 40px;
    }
  }

  :global(.mood-skeleton-content) {
    flex: 1;
    min-width: 0;
  }

  :global(.mood-skeleton-line) {
    display: block;
    width: var(--line-width, 70%);
    height: 14px;
    background: hsl(var(--foreground) / 0.05);
    border-radius: 6px;
    position: relative;
    overflow: hidden;
  }

  :global(.mood-skeleton-line::after) {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      hsl(var(--foreground) / 0.08) 50%,
      transparent 100%
    );
    animation: skeleton-shimmer 2s ease-in-out infinite;
    animation-delay: var(--item-delay);
  }

  @keyframes skeleton-shimmer {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.mood-skeleton-date::after),
    :global(.mood-skeleton-time::after),
    :global(.mood-skeleton-line::after) {
      animation: none;
    }
  }

  /* Inline Loading for Load More */
  :global(.mood-loading-inline) {
    display: flex;
    flex-direction: column;
    padding: 16px 0;
  }

  :global(.mood-loading-inline .mood-skeleton-group) {
    opacity: 0.7;
  }

  /* Error State */
  .mood-error {
    padding: 60px 0;
    text-align: center;
  }

  .mood-error.is-hidden {
    display: none;
  }

  /* Feed Hidden State */
  .mood-feed.is-hidden {
    display: none;
  }

  /* Stream Layout */
  :global(.mood-stream) {
    display: flex;
    flex-direction: column;
    gap: 40px;
    width: 100%;
    max-width: 680px;
    min-width: 0;
    margin: 0 auto;
  }

  @media (min-width: 640px) {
    :global(.mood-stream) {
      gap: 48px;
    }
  }

  @media (min-width: 1024px) {
    :global(.mood-stream) {
      gap: 56px;
      max-width: 720px;
    }
  }

  /* Date Group */
  :global(.mood-date-group) {
    display: flex;
    flex-direction: column;
    gap: 0;
    background: hsl(var(--background));
    border-radius: 12px;
    padding: 20px;
    border: 1px solid hsl(var(--foreground) / 0.06);
    box-shadow: 0 1px 0 hsl(var(--foreground) / 0.03);
    width: 100%;
    max-width: 100%;
    min-width: 0;
    contain: content;
  }

  @media (min-width: 640px) {
    :global(.mood-date-group) {
      padding: 24px;
      border-radius: 16px;
    }
  }

  @media (min-width: 1024px) {
    :global(.mood-date-group) {
      padding: 28px;
    }
  }

  :global(.mood-date-header) {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
    padding-top: 0;
  }

  @media (min-width: 640px) {
    :global(.mood-date-header) {
      margin-bottom: 24px;
    }
  }

  :global(.mood-date-text) {
    font-size: 12px;
    font-weight: 500;
    color: hsl(var(--muted-foreground));
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
    padding-right: 4px;
  }

  :global(.mood-date-line) {
    flex: 1;
    height: 1px;
    background: hsl(var(--foreground) / 0.1);
  }

  :global(.mood-date-items) {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding-left: 0;
    min-width: 0;
  }

  /* Mood Item - Stream Style */
  :global(.mood-item) {
    display: flex;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid hsl(var(--foreground) / 0.04);
    position: relative;
  }

  :global(.mood-item:hover),
  :global(.mood-item:focus-within) {
    z-index: 2;
  }

  :global(.mood-item--comments-open) {
    z-index: 30;
  }

  :global(.mood-item--anchored) {
    isolation: isolate;
  }

  :global(.mood-item--anchored)::before {
    content: '';
    position: absolute;
    inset: 4px -12px;
    border-radius: 12px;
    background-color: transparent;
    animation: mood-anchor-flash 1800ms cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
    z-index: -1;
  }

  @keyframes mood-anchor-flash {
    0% {
      background-color: transparent;
    }

    20%,
    60% {
      background-color: hsl(var(--foreground) / 0.05);
    }

    100% {
      background-color: transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.mood-item--anchored)::before {
      animation: none;
      background-color: hsl(var(--foreground) / 0.05);
    }
  }

  @media (min-width: 640px) {
    :global(.mood-item) {
      padding: 18px 0;
      gap: 18px;
    }
  }

  @media (max-width: 640px) {
    :global(.mood-item) {
      flex-direction: column;
      gap: 10px;
    }

    :global(.mood-item-time) {
      min-width: 0;
      padding-top: 0;
      font-size: 12px;
      line-height: 1.35;
    }

    :global(.mood-item-content) {
      gap: 10px;
    }

    :global(.mood-item-content--media-only) {
      width: 100%;
      max-width: 100%;
      padding-right: 0;
    }

    :global(.mood-item--clickable) {
      margin: 0;
      padding: 14px 0;
    }
  }

  :global(.mood-item:last-child) {
    border-bottom: none;
    padding-bottom: 4px;
  }

  :global(.mood-item--clickable) {
    text-decoration: none;
    color: inherit;
    border-radius: 10px;
    margin: 0 -12px;
    padding: 16px 12px;
    border-bottom: none;
    transition: color 0.15s ease;
    cursor: pointer;
  }

  @media (min-width: 640px) {
    :global(.mood-item--clickable) {
      margin: 0 -16px;
      padding: 18px 16px;
      border-radius: 12px;
    }
  }

  :global(.mood-item--clickable + .mood-item) {
    border-top: none;
  }

  :global(.mood-item-time) {
    font-size: 12px;
    color: hsl(var(--muted-foreground) / 0.6);
    font-variant-numeric: tabular-nums;
    min-width: 44px;
    padding-top: 1px;
    line-height: 1.5;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    :global(.mood-item-time) {
      min-width: 46px;
    }
  }

  :global(.mood-item-content) {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-right: 0;
  }

  :global(.mood-item-content--media-only) {
    flex: 0 1 auto;
    width: min(100%, 340px);
    max-width: min(100%, 340px);
    padding-right: 24px;
    align-self: flex-start;
  }

  @media (min-width: 640px) {
    :global(.mood-item-content) {
      gap: 12px;
      padding-right: 32px;
    }

    :global(.mood-item-content--media-only) {
      width: min(100%, 380px);
      max-width: min(100%, 380px);
    }
  }

  :global(.mood-item-forwarded) {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: hsl(var(--muted-foreground));
  }

  :global(.mood-forwarded-label) {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 10px;
    color: hsl(var(--muted-foreground) / 0.7);
  }

  :global(.mood-forwarded-source) {
    font-weight: 500;
    color: hsl(var(--foreground) / 0.85);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  :global(.mood-forwarded-source:hover),
  :global(.mood-forwarded-source:focus-visible) {
    border-bottom-color: hsl(var(--foreground) / 0.35);
  }

  :global(.mood-forwarded-author) {
    color: hsl(var(--muted-foreground) / 0.7);
  }

  :global(.mood-item-media) {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  :global(.mood-item-media video) {
    width: 100%;
    max-width: 100%;
    max-height: min(52vh, 400px);
    height: auto;
    display: block;
    border-radius: 12px;
    background: transparent;
    overflow: clip;
    clip-path: inset(0 round 12px);
  }

  /* Portrait videos (aspect ratio < 0.8) */
  :global(.mood-item-media video.video--portrait) {
    width: min(100%, clamp(220px, 52vw, 320px));
    max-width: 100%;
    max-height: min(58vh, 460px);
    margin: 0;
  }

  /* Ultra-tall videos (aspect ratio < 0.6) */
  :global(.mood-item-media video.video--ultra-tall) {
    width: min(100%, clamp(200px, 44vw, 280px));
    max-width: 100%;
    max-height: min(62vh, 500px);
    margin: 0;
  }

  :global(.mood-item-media audio) {
    width: 100%;
  }

