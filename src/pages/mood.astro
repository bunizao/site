---
import Layout from '../layouts/Layout.astro';

export const prerender = false;

const title = "Moods | Bunizao's Website";
const description = "Thoughts and moments from my Telegram channel";
---

<Layout title={title} description={description}>
  <main class="page-container">
    <div class="mood-page">
      <div class="mood-header">
        <a href="/" class="back-link">← Back</a>
        <h1 class="mood-page-title">Moods</h1>
        <p class="mood-page-desc">Thoughts and moments from my Telegram channel</p>
      </div>

      <div class="mood-loading" data-mood-loading>
        <div class="mood-loading-spinner">
          <div class="mood-loading-dot"></div>
          <div class="mood-loading-dot"></div>
          <div class="mood-loading-dot"></div>
        </div>
        <p class="mood-loading-text">Loading moods...</p>
      </div>

      <div class="mood-error is-hidden" data-mood-error>
        <p class="text-sm text-muted-foreground">Unable to load moods. Please try again later.</p>
      </div>

      <div class="mood-feed is-hidden" data-mood-feed>
        <div class="mood-stream" data-mood-list></div>
        <div class="mood-load-controls">
          <button type="button" class="mood-load-button" data-load-more>Load more</button>
          <p class="mood-load-status" data-load-status aria-live="polite"></p>
        </div>
        <div class="mood-sentinel" data-mood-sentinel aria-hidden="true"></div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .mood-page {
    padding: 80px 0 60px;
  }

  @media (min-width: 640px) {
    .mood-page {
      padding: 100px 0 80px;
    }
  }

  .mood-header {
    margin-bottom: 40px;
  }

  @media (min-width: 640px) {
    .mood-header {
      margin-bottom: 48px;
    }
  }

  .back-link {
    display: inline-block;
    font-size: 13px;
    color: hsl(var(--muted-foreground));
    margin-bottom: 16px;
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: hsl(var(--foreground));
  }

  .mood-page-title {
    font-size: 28px;
    font-weight: 600;
    margin-bottom: 8px;
  }

  @media (min-width: 640px) {
    .mood-page-title {
      font-size: 32px;
    }
  }

  .mood-page-desc {
    font-size: 14px;
    color: hsl(var(--muted-foreground));
  }

  @media (min-width: 640px) {
    .mood-page-desc {
      font-size: 15px;
    }
  }

  /* Loading State */
  .mood-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding: 80px 0;
  }

  .mood-loading.is-hidden {
    display: none;
  }

  .mood-loading-spinner {
    display: flex;
    gap: 6px;
  }

  .mood-loading-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: hsl(var(--foreground) / 0.3);
    animation: loading-bounce 1.4s ease-in-out infinite both;
  }

  .mood-loading-dot:nth-child(1) {
    animation-delay: -0.32s;
  }

  .mood-loading-dot:nth-child(2) {
    animation-delay: -0.16s;
  }

  .mood-loading-dot:nth-child(3) {
    animation-delay: 0s;
  }

  @keyframes loading-bounce {
    0%, 80%, 100% {
      transform: scale(0.6);
      opacity: 0.4;
    }
    40% {
      transform: scale(1);
      opacity: 1;
    }
  }

  .mood-loading-text {
    font-size: 13px;
    color: hsl(var(--muted-foreground) / 0.6);
    letter-spacing: 0.02em;
  }

  /* Error State */
  .mood-error {
    padding: 60px 0;
    text-align: center;
  }

  .mood-error.is-hidden {
    display: none;
  }

  /* Feed Hidden State */
  .mood-feed.is-hidden {
    display: none;
  }

  /* Stream Layout */
  :global(.mood-stream) {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  /* Date Group */
  :global(.mood-date-group) {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  :global(.mood-date-header) {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  :global(.mood-date-text) {
    font-size: 12px;
    font-weight: 500;
    color: hsl(var(--muted-foreground));
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  :global(.mood-date-line) {
    flex: 1;
    height: 1px;
    background: hsl(var(--foreground) / 0.08);
  }

  :global(.mood-date-items) {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding-left: 0;
  }

  /* Mood Item - Stream Style */
  :global(.mood-item) {
    display: flex;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid hsl(var(--foreground) / 0.04);
    opacity: 0;
    animation: fade-in 0.3s ease-out forwards;
    animation-delay: calc(var(--item-index) * 0.02s);
  }

  :global(.mood-item:last-child) {
    border-bottom: none;
  }

  :global(.mood-item--clickable) {
    text-decoration: none;
    color: inherit;
    border-radius: 8px;
    margin: 0 -8px;
    padding: 12px 8px;
    border-bottom: none;
    transition: background 0.15s ease;
  }

  :global(.mood-item--clickable:hover) {
    background: hsl(var(--foreground) / 0.03);
  }

  :global(.mood-item--clickable + .mood-item) {
    border-top: none;
  }

  :global(.mood-item-time) {
    font-size: 12px;
    color: hsl(var(--muted-foreground) / 0.5);
    font-variant-numeric: tabular-nums;
    min-width: 40px;
    padding-top: 2px;
  }

  :global(.mood-item-content) {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  :global(.mood-item-media) {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  :global(.mood-item-media video) {
    width: 100%;
    border-radius: 10px;
    background: hsl(var(--foreground) / 0.05);
  }

  :global(.mood-item-media audio) {
    width: 100%;
  }

  :global(.mood-item-media .tgme_widget_message_document_wrap) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border: 1px solid hsl(var(--foreground) / 0.1);
    border-radius: 10px;
    background: hsl(var(--background));
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease;
  }

  :global(.mood-item-media .tgme_widget_message_document_wrap:hover) {
    border-color: hsl(var(--foreground) / 0.18);
  }

  :global(.mood-item-media .tgme_widget_message_document_icon) {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: hsl(var(--foreground) / 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    position: relative;
  }

  :global(.mood-item-media .tgme_widget_message_document_icon.audio::before) {
    content: '';
    border-left: 8px solid hsl(var(--foreground) / 0.7);
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
    margin-left: 2px;
  }

  :global(.mood-item-media .tgme_widget_message_document) {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  :global(.mood-item-media .tgme_widget_message_document_title) {
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
  }

  :global(.mood-item-media .tgme_widget_message_document_extra) {
    font-size: 12px;
    color: hsl(var(--muted-foreground));
    line-height: 1.4;
  }

  :global(.mood-item-media .bookmark-card) {
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 100%;
    max-width: 320px;
    border: 1px solid hsl(var(--foreground) / 0.1);
    border-radius: 8px;
    background: hsl(var(--background));
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: border-color 0.15s ease;
  }

  @media (min-width: 640px) {
    :global(.mood-item-media .bookmark-card) {
      max-width: 360px;
    }
  }

  :global(.mood-item-media .bookmark-card:hover) {
    border-color: hsl(var(--foreground) / 0.2);
  }

  :global(.mood-item-media .bookmark-card__media) {
    width: 100%;
    background: hsl(var(--foreground) / 0.03);
  }

  :global(.mood-item-media .bookmark-card__media img) {
    width: 100%;
    display: block;
    object-fit: cover;
    aspect-ratio: 1.91 / 1;
  }

  :global(.mood-item-media .bookmark-card__content) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 8px 10px;
  }

  :global(.mood-item-media .bookmark-card__title) {
    font-size: 13px;
    font-weight: 500;
    line-height: 1.35;
    color: hsl(var(--foreground));
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.mood-item-media .bookmark-card__description) {
    font-size: 12px;
    color: hsl(var(--muted-foreground));
    line-height: 1.4;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    overflow: hidden;
  }

  :global(.mood-item-media .bookmark-card__meta) {
    font-size: 11px;
    color: hsl(var(--muted-foreground) / 0.5);
  }

  :global(.mood-item-text) {
    font-size: 14px;
    line-height: 1.6;
    color: hsl(var(--foreground));
    white-space: pre-wrap;
    word-wrap: break-word;
  }

  @media (min-width: 640px) {
    :global(.mood-item-text) {
      font-size: 15px;
      line-height: 1.65;
    }
  }

  :global(.mood-item-thumb) {
    width: 100%;
    max-width: 400px;
    border-radius: 8px;
    overflow: hidden;
    background: hsl(var(--foreground) / 0.03);
  }

  /* Portrait images in feed - limit height */
  :global(.mood-item-thumb.mood-item-thumb--portrait) {
    max-width: 200px;
  }

  :global(.mood-item-thumb.mood-item-thumb--portrait img) {
    max-height: 320px;
    width: auto;
    object-fit: contain;
  }

  @media (min-width: 640px) {
    :global(.mood-item-thumb) {
      max-width: 480px;
    }

    :global(.mood-item-thumb.mood-item-thumb--portrait) {
      max-width: 240px;
    }

    :global(.mood-item-thumb.mood-item-thumb--portrait img) {
      max-height: 400px;
    }
  }

  @media (min-width: 1024px) {
    :global(.mood-item-thumb) {
      max-width: 560px;
    }

    :global(.mood-item-thumb.mood-item-thumb--portrait) {
      max-width: 280px;
    }

    :global(.mood-item-thumb.mood-item-thumb--portrait img) {
      max-height: 450px;
    }
  }

  :global(.mood-item-thumb img) {
    width: 100%;
    height: auto;
    display: block;
  }

  :global(.mood-item-tag) {
    display: inline-block;
    font-size: 11px;
    color: hsl(var(--muted-foreground) / 0.6);
    align-self: flex-start;
  }

  /* Reactions */
  :global(.mood-item-reactions) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }

  :global(.mood-reaction) {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 3px 8px 3px 6px;
    font-size: 12px;
    background: hsl(var(--foreground) / 0.05);
    border-radius: 999px;
    color: hsl(var(--muted-foreground));
    transition: all 0.15s ease;
    border: 1px solid transparent;
  }

  :global(.mood-reaction:hover) {
    background: hsl(var(--foreground) / 0.08);
    border-color: hsl(var(--foreground) / 0.08);
  }

  :global(.mood-reaction--paid) {
    background: hsl(45 100% 50% / 0.08);
    color: hsl(45 70% 40%);
  }

  :global(.mood-reaction--paid:hover) {
    background: hsl(45 100% 50% / 0.12);
    border-color: hsl(45 100% 50% / 0.2);
  }

  :global(.mood-reaction-emoji) {
    font-size: 14px;
    line-height: 1;
  }

  :global(.mood-reaction-count) {
    font-size: 12px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    opacity: 0.8;
  }

  :global(.mood-feed) {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  :global(.mood-load-controls) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding-top: 16px;
  }

  :global(.mood-load-button) {
    border: 1px solid hsl(var(--foreground) / 0.1);
    background: transparent;
    color: hsl(var(--muted-foreground));
    padding: 8px 20px;
    font-size: 12px;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  :global(.mood-load-button:hover) {
    border-color: hsl(var(--foreground) / 0.2);
    color: hsl(var(--foreground));
  }

  :global(.mood-load-button:focus-visible) {
    outline: 2px solid hsl(var(--foreground) / 0.35);
    outline-offset: 2px;
  }

  :global(.mood-load-button:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }

  :global(.mood-load-button.is-hidden) {
    display: none;
  }

  :global(.mood-load-status) {
    font-size: 12px;
    color: hsl(var(--muted-foreground) / 0.6);
    min-height: 16px;
  }

  :global(.mood-sentinel) {
    height: 1px;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  const loadingEl = document.querySelector('[data-mood-loading]');
  const errorEl = document.querySelector('[data-mood-error]');
  const feedEl = document.querySelector('[data-mood-feed]');
  const list = document.querySelector('[data-mood-list]');
  const loadButton = document.querySelector('[data-load-more]') as HTMLButtonElement | null;
  const status = document.querySelector('[data-load-status]');
  const sentinel = document.querySelector('[data-mood-sentinel]');

  if (loadingEl && errorEl && feedEl && list && loadButton && status && sentinel) {
    let isLoading = false;
    let hasMore = true;
    let observer: IntersectionObserver;

    const buttonLabel = loadButton.textContent || 'Load more';

    const formatTime = (value: string): string => {
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return '';
      const hours = String(date.getHours()).padStart(2, '0');
      const minutes = String(date.getMinutes()).padStart(2, '0');
      return `${hours}:${minutes}`;
    };

    const formatDateKey = (value: string): string => {
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return '';
      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, '0');
      const day = String(date.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    };

    const formatDateHeader = (dateKey: string): string => {
      const [year, month, day] = dateKey.split('-').map(Number);
      const date = new Date(year, month - 1, day);
      const now = new Date();

      const isToday =
        date.getFullYear() === now.getFullYear() &&
        date.getMonth() === now.getMonth() &&
        date.getDate() === now.getDate();

      if (isToday) return 'Today';

      const yesterday = new Date(now);
      yesterday.setDate(yesterday.getDate() - 1);
      const isYesterday =
        date.getFullYear() === yesterday.getFullYear() &&
        date.getMonth() === yesterday.getMonth() &&
        date.getDate() === yesterday.getDate();

      if (isYesterday) return 'Yesterday';

      const months = ['January', 'February', 'March', 'April', 'May', 'June',
        'July', 'August', 'September', 'October', 'November', 'December'];

      if (date.getFullYear() === now.getFullYear()) {
        return `${months[date.getMonth()]} ${date.getDate()}`;
      }
      return `${months[date.getMonth()]} ${date.getDate()}, ${date.getFullYear()}`;
    };

    const getBeforeId = (): string => {
      const items = Array.from(list.querySelectorAll('[data-mood-id]'));
      let oldestId = '';
      let oldestValue = Number.POSITIVE_INFINITY;

      items.forEach((item) => {
        const id = item.getAttribute('data-mood-id') || '';
        const numericId = Number.parseInt(id, 10);
        if (!Number.isNaN(numericId) && numericId < oldestValue) {
          oldestValue = numericId;
          oldestId = id;
        }
      });

      return oldestId || items[items.length - 1]?.getAttribute('data-mood-id') || '';
    };

    const setStatus = (message: string): void => {
      status.textContent = message;
    };

    const setLoadingState = (loading: boolean): void => {
      loadButton.disabled = loading || !hasMore;
      loadButton.textContent = loading ? 'Loading...' : buttonLabel;

      if (loading) {
        list.setAttribute('aria-busy', 'true');
      } else {
        list.removeAttribute('aria-busy');
      }
    };

    const isLongContent = (text: string): boolean => (text || '').length > 280;

    interface ReactionData {
      emoji: string;
      count: string;
      isPaid: boolean;
    }

    interface MoodData {
      id: string;
      datetime: string;
      tag?: string;
      previewText: string;
      image?: string | null;
      mediaHtml?: string;
      needsDetailPage?: boolean;
      reactions?: ReactionData[];
    }

    const createMoodItem = (mood: MoodData, index: number): HTMLElement => {
      const mediaHtml = typeof mood.mediaHtml === 'string' ? mood.mediaHtml.trim() : '';
      const hasMediaHtml = mediaHtml.length > 0;
      const needsDetailPage = typeof mood.needsDetailPage === 'boolean'
        ? mood.needsDetailPage
        : isLongContent(mood.previewText);
      const shouldLink = needsDetailPage && !hasMediaHtml;
      const element = shouldLink
        ? document.createElement('a')
        : document.createElement('div');

      if (shouldLink && element instanceof HTMLAnchorElement) {
        element.href = `/mood/${mood.id}`;
        element.className = 'mood-item mood-item--clickable';
      } else {
        element.className = 'mood-item';
      }

      element.dataset.moodId = mood.id;
      element.style.setProperty('--item-index', String(index));

      const time = document.createElement('time');
      time.className = 'mood-item-time';
      time.dateTime = mood.datetime;
      time.textContent = formatTime(mood.datetime);

      const content = document.createElement('div');
      content.className = 'mood-item-content';

      const text = document.createElement('p');
      text.className = 'mood-item-text';
      text.textContent = mood.previewText || '';
      content.appendChild(text);

      if (hasMediaHtml) {
        const media = document.createElement('div');
        media.className = 'mood-item-media';
        media.innerHTML = mediaHtml;
        content.appendChild(media);
      } else if (mood.image) {
        const thumbWrap = document.createElement('div');
        thumbWrap.className = 'mood-item-thumb';
        const img = document.createElement('img');
        img.src = mood.image;
        img.alt = '';
        img.loading = 'lazy';
        // Detect portrait images after load
        img.onload = () => {
          if (img.naturalHeight > img.naturalWidth * 1.2) {
            thumbWrap.classList.add('mood-item-thumb--portrait');
          }
        };
        thumbWrap.appendChild(img);
        content.appendChild(thumbWrap);
      }

      // Add reactions
      if (mood.reactions && mood.reactions.length > 0) {
        const reactionsWrap = document.createElement('div');
        reactionsWrap.className = 'mood-item-reactions';
        mood.reactions.forEach((reaction) => {
          const pill = document.createElement('span');
          pill.className = reaction.isPaid ? 'mood-reaction mood-reaction--paid' : 'mood-reaction';
          pill.innerHTML = `<span class="mood-reaction-emoji">${reaction.isPaid ? '⭐' : reaction.emoji}</span><span class="mood-reaction-count">${reaction.count}</span>`;
          reactionsWrap.appendChild(pill);
        });
        content.appendChild(reactionsWrap);
      }

      if (mood.tag) {
        const tag = document.createElement('span');
        tag.className = 'mood-item-tag';
        tag.textContent = `#${mood.tag}`;
        content.appendChild(tag);
      }

      element.appendChild(time);
      element.appendChild(content);
      return element;
    };

    const createDateGroup = (dateKey: string): HTMLElement => {
      const group = document.createElement('div');
      group.className = 'mood-date-group';
      group.dataset.date = dateKey;

      const header = document.createElement('div');
      header.className = 'mood-date-header';

      const dateText = document.createElement('span');
      dateText.className = 'mood-date-text';
      dateText.textContent = formatDateHeader(dateKey);

      const dateLine = document.createElement('div');
      dateLine.className = 'mood-date-line';

      header.appendChild(dateText);
      header.appendChild(dateLine);

      const items = document.createElement('div');
      items.className = 'mood-date-items';

      group.appendChild(header);
      group.appendChild(items);

      return group;
    };

    const appendMoods = (posts: MoodData[], startIndex = 0): void => {
      const grouped = new Map<string, MoodData[]>();

      posts.forEach((post) => {
        const dateKey = formatDateKey(post.datetime);
        if (!grouped.has(dateKey)) {
          grouped.set(dateKey, []);
        }
        grouped.get(dateKey)!.push(post);
      });

      let globalIndex = startIndex;
      grouped.forEach((datePosts, dateKey) => {
        let group = list.querySelector(`[data-date="${dateKey}"]`);

        if (!group) {
          group = createDateGroup(dateKey);
          list.appendChild(group);
        }

        const itemsContainer = group.querySelector('.mood-date-items');
        if (itemsContainer) {
          datePosts.forEach((post) => {
            itemsContainer.appendChild(createMoodItem(post, globalIndex));
            globalIndex++;
          });
        }
      });
    };

    const handleNoMore = (): void => {
      hasMore = false;
      loadButton.classList.add('is-hidden');
      setStatus('No more moods.');
      if (observer) {
        observer.disconnect();
      }
    };

    const showError = (): void => {
      loadingEl.classList.add('is-hidden');
      feedEl.classList.add('is-hidden');
      errorEl.classList.remove('is-hidden');
    };

    const showFeed = (): void => {
      loadingEl.classList.add('is-hidden');
      errorEl.classList.add('is-hidden');
      feedEl.classList.remove('is-hidden');
    };

    const loadInitial = async (): Promise<void> => {
      try {
        const response = await fetch('/api/moods');
        if (!response.ok) {
          throw new Error('Failed to load moods.');
        }

        const data = await response.json() as { posts: MoodData[] };
        const posts = Array.isArray(data.posts) ? data.posts : [];

        if (!posts.length) {
          showFeed();
          handleNoMore();
          setStatus('No moods yet.');
          return;
        }

        appendMoods(posts, 0);
        showFeed();

        observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                loadMore();
              }
            });
          },
          {
            rootMargin: '300px 0px',
          }
        );

        observer.observe(sentinel);
      } catch (error) {
        console.error(error);
        showError();
      }
    };

    const loadMore = async (): Promise<void> => {
      if (isLoading || !hasMore) {
        return;
      }

      const before = getBeforeId();
      if (!before) {
        handleNoMore();
        return;
      }

      isLoading = true;
      setLoadingState(true);
      setStatus('Loading more moods...');

      try {
        const response = await fetch(`/api/moods?before=${encodeURIComponent(before)}`);
        if (!response.ok) {
          throw new Error('Failed to load moods.');
        }

        const data = await response.json() as { posts: MoodData[] };
        const posts = Array.isArray(data.posts) ? data.posts : [];
        const existingIds = new Set(
          Array.from(list.querySelectorAll('[data-mood-id]'))
            .map((item) => item.getAttribute('data-mood-id'))
            .filter(Boolean) as string[]
        );
        const uniquePosts = posts.filter((post) => post?.id && !existingIds.has(post.id));
        const currentCount = list.querySelectorAll('[data-mood-id]').length;

        if (!posts.length || !uniquePosts.length) {
          handleNoMore();
        } else {
          appendMoods(uniquePosts, currentCount);
          setStatus('');
        }
      } catch (error) {
        console.error(error);
        setStatus('Unable to load more moods.');
      } finally {
        isLoading = false;
        setLoadingState(false);
      }
    };

    loadButton.addEventListener('click', loadMore);

    loadInitial();
  }
</script>
