---
import Layout from '../layouts/Layout.astro';
import MoodTimelineWheel from '../components/MoodTimelineWheel.astro';

export const prerender = false;

const title = "Moods | Bunizao's Website";
const description = "Thoughts and moments from my Telegram channel";
const rss = { href: '/mood/rss.xml', title: 'Moods RSS' };
const canonicalUrl = new URL(Astro.url.pathname, Astro.url.origin).href;
const oembed = { href: `/api/oembed.json?url=${encodeURIComponent(canonicalUrl)}`, title: 'Mood Embed' };
const channel = import.meta.env.CHANNEL || Astro.locals?.runtime?.env?.CHANNEL || '';
const telegramUrl = channel ? `https://t.me/${channel}` : '';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
// Skeleton structure: 2 date group cards to match actual content layout
const skeletonGroups = [
  {
    index: 0,
    dateWidth: '52px', // "Today" length
    items: [
      { index: 0, lineWidth: '72%' },
      { index: 1, lineWidth: '58%' },
      { index: 2, lineWidth: '66%' },
    ],
  },
  {
    index: 1,
    dateWidth: '76px', // "Yesterday" length
    items: [
      { index: 0, lineWidth: '64%' },
      { index: 1, lineWidth: '70%' },
    ],
  },
];
---

<Layout title={title} description={description} rss={rss} oembed={oembed}>
  <!-- Inject page-specific header actions -->
  <script is:inline define:vars={{ telegramUrl, turnstileSiteKey }}>
    (() => {
      // Hide site nav on mood L1 page
      const siteNav = document.querySelector('[data-site-nav]');
      if (siteNav) siteNav.style.display = 'none';

      const headerActions = document.querySelector('[data-header-actions]');
      if (!headerActions) return;

      // Create RSS button with new GSAP-compatible structure
      const rssBtn = document.createElement('a');
      rssBtn.className = 'header-action-btn';
      rssBtn.href = '/mood/rss.xml';
      rssBtn.title = 'Subscribe to RSS feed';
      rssBtn.innerHTML = `
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 11a9 9 0 0 1 9 9"></path>
          <path d="M4 4a16 16 0 0 1 16 16"></path>
          <circle cx="5" cy="19" r="1"></circle>
        </svg>
        <span class="header-action-btn-label">RSS</span>
      `;

      // Create Telegram button if URL exists
      let telegramBtn = null;
      if (telegramUrl) {
        telegramBtn = document.createElement('a');
        telegramBtn.className = 'header-action-btn';
        telegramBtn.href = telegramUrl;
        telegramBtn.target = '_blank';
        telegramBtn.rel = 'noopener noreferrer';
        telegramBtn.title = 'View on Telegram';
        telegramBtn.innerHTML = `
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m22 2-7 20-4-9-9-4Z"></path>
            <path d="M22 2 11 13"></path>
          </svg>
          <span class="header-action-btn-label">Telegram</span>
        `;
      }

      // Create Notify button
      const notifyBtn = document.createElement('button');
      notifyBtn.className = 'header-action-btn';
      notifyBtn.type = 'button';
      notifyBtn.title = 'Subscribe to notifications';
      notifyBtn.setAttribute('data-notify-toggle', '');
      notifyBtn.setAttribute('aria-haspopup', 'dialog');
      notifyBtn.setAttribute('aria-expanded', 'false');
      notifyBtn.innerHTML = `
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
          <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
        </svg>
        <span class="header-action-btn-label">Notify</span>
      `;

      // Insert before theme dropdown
      const themeDropdown = headerActions.querySelector('[data-theme-dropdown]');
      if (themeDropdown) {
        headerActions.insertBefore(notifyBtn, themeDropdown);
        headerActions.insertBefore(rssBtn, themeDropdown);
        if (telegramBtn) {
          headerActions.insertBefore(telegramBtn, themeDropdown);
        }
      } else {
        headerActions.appendChild(notifyBtn);
        headerActions.appendChild(rssBtn);
        if (telegramBtn) {
          headerActions.appendChild(telegramBtn);
        }
      }

      // Inject notify panel into DOM
      const notifyPanel = document.createElement('div');
      notifyPanel.className = 'notify-panel';
      notifyPanel.setAttribute('role', 'dialog');
      notifyPanel.setAttribute('aria-label', 'Subscribe to notifications');
      notifyPanel.setAttribute('aria-hidden', 'true');
      notifyPanel.dataset.turnstileSiteKey = turnstileSiteKey;
      notifyPanel.innerHTML = `
        <div class="notify-panel-inner">
          <div data-notify-form-view>
            <div class="notify-panel-header">
              <span class="notify-panel-title">Get notified</span>
              <button type="button" class="notify-panel-close" data-notify-close aria-label="Close">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M18 6 6 18"></path>
                  <path d="m6 6 12 12"></path>
                </svg>
              </button>
            </div>
            <form data-notify-form autocomplete="off">
              <label class="notify-label" for="notify-email">Email</label>
              <input id="notify-email" type="email" class="notify-input" placeholder="you@example.com"
                     required autocomplete="email" data-notify-email />
              <fieldset class="notify-fieldset">
                <legend class="notify-label">Frequency</legend>
                <div class="notify-radio-group" role="radiogroup" aria-label="Delivery mode">
                  <span class="notify-radio-indicator" aria-hidden="true"></span>
                  <input type="radio" id="notify-mode-instant" name="deliveryMode" value="instant" class="notify-radio-input" checked />
                  <label for="notify-mode-instant" class="notify-radio-label">Instant</label>
                  <input type="radio" id="notify-mode-digest5h" name="deliveryMode" value="every_5h" class="notify-radio-input" />
                  <label for="notify-mode-digest5h" class="notify-radio-label">Every 5h</label>
                  <input type="radio" id="notify-mode-daily" name="deliveryMode" value="daily" class="notify-radio-input" />
                  <label for="notify-mode-daily" class="notify-radio-label">Daily</label>
                </div>
              </fieldset>
              <div data-notify-turnstile class="notify-turnstile"></div>
              <button type="submit" class="notify-submit" data-notify-submit>
                <span class="notify-submit-lock-icon" data-notify-submit-lock aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                       stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="4" y="11" width="16" height="10" rx="2"></rect>
                    <path d="M8 11V8a4 4 0 1 1 8 0v3"></path>
                  </svg>
                </span>
                <span data-notify-submit-text>Subscribe</span>
                <span data-notify-submit-spinner class="notify-spinner is-hidden"></span>
              </button>
              <p class="notify-submit-hint" data-notify-submit-hint>Complete security check before subscribing.</p>
              <p class="notify-privacy-note">
                Subscription details are covered by the
                <a href="/privacy" class="notify-privacy-link" target="_blank" rel="noopener noreferrer">Privacy Policy</a>.
              </p>
              <div data-notify-error-msg class="notify-error-msg" aria-live="polite"></div>
            </form>
          </div>
          <div data-notify-success-view class="is-hidden">
            <div class="notify-success">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <path d="m9 11 3 3L22 4"></path>
              </svg>
              <p class="notify-success-text" data-notify-success-text>Check your inbox to confirm.</p>
              <button type="button" class="notify-submit" data-notify-done>Done</button>
            </div>
          </div>
          <div data-notify-error-view class="is-hidden">
            <div class="notify-error-state">
              <p class="notify-error-state-text" data-notify-error-state-text>Something went wrong.</p>
              <button type="button" class="notify-submit" data-notify-retry>Try again</button>
            </div>
          </div>
        </div>
      `;
      document.body.appendChild(notifyPanel);

      // Register buttons with GSAP animation system
      const registerWithGSAP = () => {
        if (window.headerBtnAnimations) {
          window.headerBtnAnimations.register(rssBtn);
          if (telegramBtn) {
            window.headerBtnAnimations.register(telegramBtn);
          }
          window.headerBtnAnimations.register(notifyBtn);
        } else {
          // Retry if GSAP system not ready yet
          setTimeout(registerWithGSAP, 100);
        }
      };
      registerWithGSAP();
    })();
  </script>

  <!-- Mobile header buttons auto-collapse on scroll past hero -->
  <script>
    import gsap from 'gsap';

    document.addEventListener('DOMContentLoaded', () => {
      const heroEl = document.querySelector('[data-mood-hero]');
      const headerActions = document.querySelector('[data-header-actions]');
      if (!heroEl || !headerActions) return;

      // Only apply on mobile (< 640px)
      const isMobile = () => window.innerWidth < 640;

      let isCollapsed = false;

      const collapseButtons = () => {
        if (isCollapsed) return;
        isCollapsed = true;
        headerActions.classList.add('is-collapsed');

        gsap.to(headerActions, {
          x: '100%',
          opacity: 0,
          duration: 0.35,
          ease: 'power2.inOut',
        });
      };

      const expandButtons = () => {
        if (!isCollapsed) return;
        isCollapsed = false;
        headerActions.classList.remove('is-collapsed');

        gsap.to(headerActions, {
          x: 0,
          opacity: 1,
          duration: 0.3,
          ease: 'power2.out',
        });
      };

      // Use Intersection Observer to detect when hero leaves viewport
      const observer = new IntersectionObserver(
        (entries) => {
          if (!isMobile()) {
            // On desktop, always expanded
            if (isCollapsed) {
              isCollapsed = false;
              headerActions.classList.remove('is-collapsed');
              gsap.set(headerActions, { x: 0, opacity: 1 });
            }
            return;
          }

          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              // Hero is visible - expand buttons
              expandButtons();
            } else {
              // Hero is not visible - collapse buttons
              collapseButtons();
            }
          });
        },
        {
          // Trigger when hero bottom edge crosses viewport top
          rootMargin: '0px 0px 0px 0px',
          threshold: 0,
        }
      );

      observer.observe(heroEl);

      // Handle resize: reset state when switching between mobile/desktop
      let resizeTimer: ReturnType<typeof setTimeout> | undefined;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          if (!isMobile() && isCollapsed) {
            isCollapsed = false;
            headerActions.classList.remove('is-collapsed');
            gsap.set(headerActions, { x: 0, opacity: 1 });
          }
        }, 100);
      });
    });
  </script>
  <main class="page-container">
    <MoodTimelineWheel />
    <div class="mood-page">
      <div class="mood-hero" data-mood-hero>
        <a href="/" class="back-link">← Back</a>

        <div class="mood-hero-content">
          <!-- Avatar with loading skeleton -->
          <div class="mood-hero-avatar" data-hero-avatar>
            <div class="mood-hero-avatar-skeleton"></div>
          </div>

          <!-- Channel Info -->
          <div class="mood-hero-info">
            <h1 class="mood-hero-title" data-hero-title>
              <span class="mood-hero-title-skeleton"></span>
            </h1>
            <div class="mood-hero-description" data-hero-description>
              <span class="mood-hero-desc-skeleton"></span>
            </div>
          </div>
        </div>
      </div>

      <div class="mood-loading" data-mood-loading>
        <div class="mood-skeleton-stream" aria-hidden="true">
          {skeletonGroups.map((group) => (
            <div
              class="mood-skeleton-group"
              style={`--group-index: ${group.index}; --date-width: ${group.dateWidth};`}
            >
              <div class="mood-skeleton-header">
                <span class="mood-skeleton-date"></span>
                <div class="mood-skeleton-header-line"></div>
              </div>
              <div class="mood-skeleton-items">
                {group.items.map((item) => (
                  <div
                    class="mood-skeleton-item"
                    style={`--item-index: ${item.index}; --line-width: ${item.lineWidth};`}
                  >
                    <span class="mood-skeleton-time"></span>
                    <div class="mood-skeleton-content">
                      <span class="mood-skeleton-line"></span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="mood-error is-hidden" data-mood-error>
        <p class="text-sm text-muted-foreground">Unable to load moods. Please try again later.</p>
      </div>

      <div class="mood-feed is-hidden" data-mood-feed>
        <div class="mood-stream" data-mood-list role="feed" aria-label="Mood feed"></div>
        <div class="mood-load-controls">
          <p class="mood-load-status" data-load-status aria-live="polite"></p>
        </div>
        <div class="mood-sentinel" data-mood-sentinel aria-hidden="true"></div>
      </div>

      <div class="mood-update-notice" data-mood-update-notice role="status" aria-live="polite" aria-atomic="true" style="display: none;">
        <p class="mood-update-text" data-mood-update-text>New moods are in!</p>
        <div class="mood-update-actions" data-mood-update-actions>
          <button class="mood-update-action" type="button" data-mood-update-refresh aria-label="Refresh">
            <svg class="mood-update-action-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="23 4 23 10 17 10"></polyline>
              <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
            </svg>
            <span class="mood-update-action-label">Refresh</span>
          </button>
        </div>
        <div class="mood-update-progress" aria-hidden="true"></div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .mood-page {
    padding: 80px 0 60px;
  }

  @media (min-width: 640px) {
    .mood-page {
      padding: 100px 0 80px;
    }
  }

  @media (min-width: 1024px) {
    .mood-page {
      padding: 120px 0 100px;
    }
  }

  /* Hero Section */
  .mood-hero {
    margin-bottom: 48px;
    padding-bottom: 24px;
  }

  /* Navigation row - Back link and action buttons */
  .mood-hero-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
  }

  @media (min-width: 640px) {
    .mood-hero-nav {
      margin-bottom: 28px;
    }
  }

  @media (min-width: 640px) {
    .mood-hero {
      margin-bottom: 56px;
      padding-bottom: 28px;
    }
  }

  @media (min-width: 1024px) {
    .mood-hero {
      margin-bottom: 64px;
      padding-bottom: 32px;
    }
  }

  .mood-hero-content {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  @media (min-width: 640px) {
    .mood-hero-content {
      gap: 20px;
    }
  }

  /* Title row with inline buttons */
  .mood-hero-title-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 6px;
  }

  @media (min-width: 640px) {
    .mood-hero-title-row {
      gap: 16px;
      margin-bottom: 8px;
    }
  }

  /* Avatar */
  .mood-hero-avatar {
    position: relative;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: hsl(var(--foreground) / 0.05);
  }

  @media (min-width: 640px) {
    .mood-hero-avatar {
      width: 80px;
      height: 80px;
    }
  }

  .mood-hero-avatar-skeleton {
    position: absolute;
    inset: 0;
    background: hsl(var(--foreground) / 0.05);
    border-radius: 50%;
  }

  .mood-hero-avatar-skeleton::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      120deg,
      transparent 35%,
      hsl(var(--foreground) / 0.12) 50%,
      transparent 65%
    );
    animation: mood-hero-shimmer 2.8s ease-in-out infinite;
    opacity: 0.35;
  }

  .mood-hero-avatar.is-loaded .mood-hero-avatar-skeleton {
    display: none;
  }

  .mood-hero-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .mood-hero-avatar.is-loaded .mood-hero-avatar-img {
    opacity: 1;
  }

  /* Hero Info */
  .mood-hero-info {
    flex: 1;
    min-width: 0;
    padding-top: 4px;
  }

  @media (min-width: 640px) {
    .mood-hero-info {
      padding-top: 8px;
    }
  }

  /* Title */
  .mood-hero-title {
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 8px;
    line-height: 1.2;
  }

  @media (min-width: 640px) {
    .mood-hero-title {
      font-size: 28px;
      margin-bottom: 10px;
    }
  }

  /* Hero Emoji */
  .mood-hero-emoji {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.1em;
    height: 1.1em;
    margin-left: 0.35em;
    vertical-align: -0.1em;
  }

  .mood-hero-emoji img {
    width: 100%;
    height: 100%;
    display: block;
  }

  .mood-hero-emoji[data-emoji-animated="true"] img {
    display: none;
  }

  .mood-hero-emoji .tg-emoji-anim,
  .mood-hero-emoji .tg-emoji-anim svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .mood-hero-title-skeleton {
    display: inline-block;
    width: 140px;
    height: 24px;
    background: hsl(var(--foreground) / 0.05);
    border-radius: 6px;
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .mood-hero-title-skeleton {
      width: 180px;
      height: 28px;
    }
  }

  .mood-hero-title-skeleton::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      120deg,
      transparent 35%,
      hsl(var(--foreground) / 0.12) 50%,
      transparent 65%
    );
    animation: mood-hero-shimmer 2.8s ease-in-out infinite;
    animation-delay: 0.1s;
    opacity: 0.35;
  }

  .mood-hero-title.is-loaded .mood-hero-title-skeleton {
    display: none;
  }

  /* Description */
  .mood-hero-description {
    font-size: 14px;
    color: hsl(var(--muted-foreground));
    line-height: 1.5;
  }

  @media (min-width: 640px) {
    .mood-hero-description {
      font-size: 15px;
    }
  }

  .mood-hero-desc-skeleton {
    display: inline-block;
    width: 220px;
    height: 14px;
    background: hsl(var(--foreground) / 0.05);
    border-radius: 4px;
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .mood-hero-desc-skeleton {
      width: 280px;
      height: 15px;
    }
  }

  .mood-hero-desc-skeleton::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      120deg,
      transparent 35%,
      hsl(var(--foreground) / 0.12) 50%,
      transparent 65%
    );
    animation: mood-hero-shimmer 2.8s ease-in-out infinite;
    animation-delay: 0.2s;
    opacity: 0.35;
  }

  .mood-hero-description.is-loaded .mood-hero-desc-skeleton {
    display: none;
  }

  /* Description links and emoji */
  .mood-hero-description :global(a) {
    color: hsl(var(--foreground));
    text-decoration: none;
    border-bottom: 1px solid hsl(var(--foreground) / 0.35);
    transition: border-color 0.15s ease;
  }

  .mood-hero-description :global(a:hover) {
    border-bottom-color: hsl(var(--foreground) / 0.6);
  }

  .mood-hero-description :global(.tg-emoji) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.15em;
    height: 1.15em;
    vertical-align: -0.15em;
  }

  .mood-hero-description :global(.tg-emoji img) {
    width: 100%;
    height: 100%;
    display: block;
  }

  @keyframes mood-hero-shimmer {
    0% {
      transform: translateX(-100%);
      opacity: 0.2;
    }
    100% {
      transform: translateX(200%);
      opacity: 0.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mood-hero-avatar-skeleton::after,
    .mood-hero-title-skeleton::after,
    .mood-hero-desc-skeleton::after {
      animation: none;
    }
  }

  .back-link {
    display: inline-block;
    font-size: 13px;
    color: hsl(var(--muted-foreground));
    margin-bottom: 24px;
    transition: color 0.15s ease;
  }

  @media (min-width: 640px) {
    .back-link {
      margin-bottom: 28px;
    }
  }

  .back-link:hover {
    color: hsl(var(--foreground));
  }

  .mood-page-title {
    font-size: 28px;
    font-weight: 600;
    margin-bottom: 12px;
    line-height: 1.2;
  }

  @media (min-width: 640px) {
    .mood-page-title {
      font-size: 32px;
      margin-bottom: 16px;
    }
  }

  .mood-page-desc {
    font-size: 14px;
    color: hsl(var(--muted-foreground));
    line-height: 1.5;
    margin-bottom: 20px;
  }

  @media (min-width: 640px) {
    .mood-page-desc {
      font-size: 15px;
      margin-bottom: 24px;
    }
  }

  .mood-header-actions {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .back-link {
    font-size: 13px;
    color: hsl(var(--muted-foreground));
    transition: color 0.15s ease;
  }

  .mood-action-button {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    font-weight: 450;
    letter-spacing: 0.01em;
    border-radius: 5px;
    padding: 6px 10px;
    transition: all 0.15s ease;
    text-decoration: none;
    border: 1px solid hsl(var(--foreground) / 0.1);
    background: hsl(var(--background));
    min-height: 28px;
  }

  @media (min-width: 640px) {
    .mood-action-button {
