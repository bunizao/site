---
import Layout from '../layouts/Layout.astro';

export const prerender = false;

const title = "Moods | Bunizao's Website";
const description = "Thoughts and moments from my Telegram channel";
const rss = { href: '/mood/rss.xml', title: 'Moods RSS' };
const channel = import.meta.env.CHANNEL || Astro.locals?.runtime?.env?.CHANNEL || '';
const telegramUrl = channel ? `https://t.me/${channel}` : '';
const LOADING_COUNT = 6;
const loadingPatterns = [
  { line1: '72%', line2: '48%' },
  { line1: '64%' },
  { line1: '76%', line2: '54%' },
  { line1: '60%' },
  { line1: '70%', line2: '46%' },
  { line1: '68%' },
];
const loadingPlaceholders = Array.from({ length: LOADING_COUNT }, (_, index) => ({
  index,
  line1: loadingPatterns[index % loadingPatterns.length].line1,
  line2: loadingPatterns[index % loadingPatterns.length].line2 ?? null,
}));
---

<Layout title={title} description={description} rss={rss}>
  <main class="page-container">
    <div class="mood-page">
      <div class="mood-hero" data-mood-hero>
        <a href="/" class="back-link">← Back</a>

        <div class="mood-hero-content">
          <!-- Avatar with loading skeleton -->
          <div class="mood-hero-avatar" data-hero-avatar>
            <div class="mood-hero-avatar-skeleton"></div>
          </div>

          <!-- Channel Info -->
          <div class="mood-hero-info">
            <h1 class="mood-hero-title" data-hero-title>
              <span class="mood-hero-title-skeleton"></span>
            </h1>
            <div class="mood-hero-description" data-hero-description>
              <span class="mood-hero-desc-skeleton"></span>
            </div>
          </div>
        </div>

        <!-- Action buttons -->
        <div class="mood-header-actions">
          <a class="mood-action-button mood-action-button--secondary" href="/mood/rss.xml" title="Subscribe to RSS feed">
            <svg class="mood-action-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 11a9 9 0 0 1 9 9"></path>
              <path d="M4 4a16 16 0 0 1 16 16"></path>
              <circle cx="5" cy="19" r="1"></circle>
            </svg>
            <span>RSS</span>
          </a>
          {telegramUrl && (
            <a class="mood-action-button mood-action-button--primary" href={telegramUrl} target="_blank" rel="noopener noreferrer" title="View on Telegram">
              <svg class="mood-action-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m22 2-7 20-4-9-9-4Z"></path>
                <path d="M22 2 11 13"></path>
              </svg>
              <span>Telegram</span>
            </a>
          )}
        </div>
      </div>

      <div class="mood-loading" data-mood-loading>
        <div class="mood-loading-list" aria-hidden="true">
          {loadingPlaceholders.map(({ index, line1, line2 }) => (
            <div
              class="mood-loading-item"
              style={`--item-index: ${index}; --line-width-1: ${line1}; --line-width-2: ${line2 ?? ''};`}
            >
              <span class="mood-loading-time"></span>
              <div class="mood-loading-content">
                <div class="mood-loading-lines">
                  <span class="mood-loading-line mood-loading-line--primary"></span>
                  {line2 ? (
                    <span class="mood-loading-line mood-loading-line--secondary"></span>
                  ) : null}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="mood-error is-hidden" data-mood-error>
        <p class="text-sm text-muted-foreground">Unable to load moods. Please try again later.</p>
      </div>

      <div class="mood-feed is-hidden" data-mood-feed>
        <div class="mood-stream" data-mood-list></div>
        <div class="mood-load-controls">
          <p class="mood-load-status" data-load-status aria-live="polite"></p>
        </div>
        <div class="mood-sentinel" data-mood-sentinel aria-hidden="true"></div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .mood-page {
    padding: 80px 0 60px;
  }

  @media (min-width: 640px) {
    .mood-page {
      padding: 100px 0 80px;
    }
  }

  @media (min-width: 1024px) {
    .mood-page {
      padding: 120px 0 100px;
    }
  }

  /* Hero Section */
  .mood-hero {
    margin-bottom: 48px;
    padding-bottom: 24px;
  }

  @media (min-width: 640px) {
    .mood-hero {
      margin-bottom: 56px;
      padding-bottom: 28px;
    }
  }

  @media (min-width: 1024px) {
    .mood-hero {
      margin-bottom: 64px;
      padding-bottom: 32px;
    }
  }

  .mood-hero-content {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 20px;
  }

  @media (min-width: 640px) {
    .mood-hero-content {
      gap: 20px;
      margin-bottom: 24px;
    }
  }

  /* Avatar */
  .mood-hero-avatar {
    position: relative;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: hsl(var(--foreground) / 0.05);
  }

  @media (min-width: 640px) {
    .mood-hero-avatar {
      width: 80px;
      height: 80px;
    }
  }

  .mood-hero-avatar-skeleton {
    position: absolute;
    inset: 0;
    background: hsl(var(--foreground) / 0.05);
    border-radius: 50%;
  }

  .mood-hero-avatar-skeleton::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      120deg,
      transparent 35%,
      hsl(var(--foreground) / 0.12) 50%,
      transparent 65%
    );
    animation: mood-hero-shimmer 2.8s ease-in-out infinite;
    opacity: 0.35;
  }

  .mood-hero-avatar.is-loaded .mood-hero-avatar-skeleton {
    display: none;
  }

  .mood-hero-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .mood-hero-avatar.is-loaded .mood-hero-avatar-img {
    opacity: 1;
  }

  /* Hero Info */
  .mood-hero-info {
    flex: 1;
    min-width: 0;
    padding-top: 4px;
  }

  @media (min-width: 640px) {
    .mood-hero-info {
      padding-top: 8px;
    }
  }

  /* Title */
  .mood-hero-title {
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 8px;
    line-height: 1.2;
  }

  @media (min-width: 640px) {
    .mood-hero-title {
      font-size: 28px;
      margin-bottom: 10px;
    }
  }

  /* Hero Emoji */
  .mood-hero-emoji {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.1em;
    height: 1.1em;
    margin-left: 0.35em;
    vertical-align: -0.1em;
  }

  .mood-hero-emoji img {
    width: 100%;
    height: 100%;
    display: block;
  }

  .mood-hero-emoji[data-emoji-animated="true"] img {
    display: none;
  }

  .mood-hero-emoji .tg-emoji-anim,
  .mood-hero-emoji .tg-emoji-anim svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .mood-hero-title-skeleton {
    display: inline-block;
    width: 140px;
    height: 24px;
    background: hsl(var(--foreground) / 0.05);
    border-radius: 6px;
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .mood-hero-title-skeleton {
      width: 180px;
      height: 28px;
    }
  }

  .mood-hero-title-skeleton::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      120deg,
      transparent 35%,
      hsl(var(--foreground) / 0.12) 50%,
      transparent 65%
    );
    animation: mood-hero-shimmer 2.8s ease-in-out infinite;
    animation-delay: 0.1s;
    opacity: 0.35;
  }

  .mood-hero-title.is-loaded .mood-hero-title-skeleton {
    display: none;
  }

  /* Description */
  .mood-hero-description {
    font-size: 14px;
    color: hsl(var(--muted-foreground));
    line-height: 1.5;
  }

  @media (min-width: 640px) {
    .mood-hero-description {
      font-size: 15px;
    }
  }

  .mood-hero-desc-skeleton {
    display: inline-block;
    width: 220px;
    height: 14px;
    background: hsl(var(--foreground) / 0.05);
    border-radius: 4px;
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .mood-hero-desc-skeleton {
      width: 280px;
      height: 15px;
    }
  }

  .mood-hero-desc-skeleton::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      120deg,
      transparent 35%,
      hsl(var(--foreground) / 0.12) 50%,
      transparent 65%
    );
    animation: mood-hero-shimmer 2.8s ease-in-out infinite;
    animation-delay: 0.2s;
    opacity: 0.35;
  }

  .mood-hero-description.is-loaded .mood-hero-desc-skeleton {
    display: none;
  }

  /* Description links and emoji */
  .mood-hero-description :global(a) {
    color: hsl(var(--foreground));
    text-decoration: none;
    border-bottom: 1px solid hsl(var(--foreground) / 0.35);
    transition: border-color 0.15s ease;
  }

  .mood-hero-description :global(a:hover) {
    border-bottom-color: hsl(var(--foreground) / 0.6);
  }

  .mood-hero-description :global(.tg-emoji) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.15em;
    height: 1.15em;
    vertical-align: -0.15em;
  }

  .mood-hero-description :global(.tg-emoji img) {
    width: 100%;
    height: 100%;
    display: block;
  }

  @keyframes mood-hero-shimmer {
    0% {
      transform: translateX(-100%);
      opacity: 0.2;
    }
    100% {
      transform: translateX(200%);
      opacity: 0.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mood-hero-avatar-skeleton::after,
    .mood-hero-title-skeleton::after,
    .mood-hero-desc-skeleton::after {
      animation: none;
    }
  }

  .back-link {
    display: inline-block;
    font-size: 13px;
    color: hsl(var(--muted-foreground));
    margin-bottom: 24px;
    transition: color 0.15s ease;
  }

  @media (min-width: 640px) {
    .back-link {
      margin-bottom: 28px;
    }
  }

  .back-link:hover {
    color: hsl(var(--foreground));
  }

  .mood-page-title {
    font-size: 28px;
    font-weight: 600;
    margin-bottom: 12px;
    line-height: 1.2;
  }

  @media (min-width: 640px) {
    .mood-page-title {
      font-size: 32px;
      margin-bottom: 16px;
    }
  }

  .mood-page-desc {
    font-size: 14px;
    color: hsl(var(--muted-foreground));
    line-height: 1.5;
    margin-bottom: 20px;
  }

  @media (min-width: 640px) {
    .mood-page-desc {
      font-size: 15px;
      margin-bottom: 24px;
    }
  }

  .mood-header-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
  }

  .mood-action-button {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    font-weight: 450;
    letter-spacing: 0.01em;
    border-radius: 5px;
    padding: 6px 10px;
    transition: all 0.15s ease;
    text-decoration: none;
    border: 1px solid hsl(var(--foreground) / 0.1);
    background: hsl(var(--background));
    min-height: 28px;
  }

  @media (min-width: 640px) {
    .mood-action-button {
      padding: 7px 12px;
      min-height: 32px;
    }
  }

  .mood-action-icon {
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    opacity: 0.75;
  }

  @media (min-width: 640px) {
    .mood-action-icon {
      width: 13px;
      height: 13px;
    }
  }

  .mood-action-button--secondary,
  .mood-action-button--primary {
    color: hsl(var(--muted-foreground) / 0.9);
  }

  .mood-action-button--secondary:hover,
  .mood-action-button--primary:hover {
    color: hsl(var(--foreground));
    background: hsl(var(--foreground) / 0.05);
    border-color: hsl(var(--foreground) / 0.18);
    transform: translateY(-1px);
  }

  .mood-action-button:hover .mood-action-icon {
    opacity: 1;
  }

  /* Loading State */
  :global(.mood-loading),
  :global(.mood-loading-inline) {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 8px 0 16px;
  }

  :global(.mood-loading.is-hidden) {
    display: none;
  }

  :global(.mood-loading-inline) {
    padding: 4px 0 8px;
  }

  :global(.mood-loading-list) {
    display: flex;
    flex-direction: column;
  }

  :global(.mood-loading-item) {
    display: flex;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid hsl(var(--foreground) / 0.04);
    --skeleton-delay: calc(var(--item-index, 0) * 0.1s);
  }

  :global(.mood-loading-item:last-child) {
    border-bottom: none;
  }

  :global(.mood-loading-content) {
    flex: 1;
    min-width: 0;
  }

  :global(.mood-loading-lines) {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  :global(.mood-loading-time),
  :global(.mood-loading-line) {
    display: block;
    position: relative;
    overflow: hidden;
    background: hsl(var(--foreground) / 0.05);
  }

  :global(.mood-loading-time::after),
  :global(.mood-loading-line::after) {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 140%;
    left: -130%;
    background: linear-gradient(
      120deg,
      transparent 35%,
      hsl(var(--foreground) / 0.12) 50%,
      transparent 65%
    );
    animation: mood-loading-sheen 2.8s ease-in-out infinite;
    animation-delay: var(--skeleton-delay);
    opacity: 0.35;
  }

  :global(.mood-loading-time) {
    width: 32px;
    height: 10px;
    border-radius: 4px;
    margin-top: 2px;
    flex-shrink: 0;
  }

  :global(.mood-loading-line) {
    height: 12px;
    border-radius: 6px;
  }

  :global(.mood-loading-line--primary) {
    width: var(--line-width-1, 70%);
  }

  :global(.mood-loading-line--secondary) {
    width: var(--line-width-2, 48%);
    height: 10px;
    border-radius: 5px;
    opacity: 0.75;
  }

  @keyframes mood-loading-sheen {
    0% {
      transform: translateX(0);
      opacity: 0.2;
    }
    100% {
      transform: translateX(160%);
      opacity: 0.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.mood-loading-time),
    :global(.mood-loading-line) {
      animation: none;
    }

    :global(.mood-loading-time::after),
    :global(.mood-loading-line::after) {
      display: none;
    }

    :global(.mood-item) {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  /* Error State */
  .mood-error {
    padding: 60px 0;
    text-align: center;
  }

  .mood-error.is-hidden {
    display: none;
  }

  /* Feed Hidden State */
  .mood-feed.is-hidden {
    display: none;
  }

  /* Stream Layout */
  :global(.mood-stream) {
    display: flex;
    flex-direction: column;
    gap: 40px;
    width: 100%;
    max-width: 680px;
    min-width: 0;
    margin: 0 auto;
  }

  @media (min-width: 640px) {
    :global(.mood-stream) {
      gap: 48px;
    }
  }

  @media (min-width: 1024px) {
    :global(.mood-stream) {
      gap: 56px;
      max-width: 720px;
    }
  }

  /* Date Group */
  :global(.mood-date-group) {
    display: flex;
    flex-direction: column;
    gap: 0;
    background: hsl(var(--background));
    border-radius: 12px;
    padding: 20px;
    border: 1px solid hsl(var(--foreground) / 0.06);
    box-shadow: 0 1px 0 hsl(var(--foreground) / 0.03);
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  @media (min-width: 640px) {
    :global(.mood-date-group) {
      padding: 24px;
      border-radius: 16px;
    }
  }

  @media (min-width: 1024px) {
    :global(.mood-date-group) {
      padding: 28px;
    }
  }

  :global(.mood-date-header) {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
    padding-top: 0;
  }

  @media (min-width: 640px) {
    :global(.mood-date-header) {
      margin-bottom: 24px;
    }
  }

  :global(.mood-date-text) {
    font-size: 12px;
    font-weight: 500;
    color: hsl(var(--muted-foreground));
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
    padding-right: 4px;
  }

  :global(.mood-date-line) {
    flex: 1;
    height: 1px;
    background: hsl(var(--foreground) / 0.1);
  }

  :global(.mood-date-items) {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding-left: 0;
    min-width: 0;
  }

  /* Mood Item - Stream Style */
  :global(.mood-item) {
    display: flex;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid hsl(var(--foreground) / 0.04);
    opacity: 0;
    animation: fade-in 0.3s ease-out forwards;
    animation-delay: calc(var(--item-index) * 0.02s);
    position: relative;
  }

  @media (min-width: 640px) {
    :global(.mood-item) {
      padding: 18px 0;
      gap: 18px;
    }
  }

  @media (max-width: 640px) {
    :global(.mood-item) {
      flex-direction: column;
      gap: 6px;
    }

    :global(.mood-item-time) {
      min-width: 0;
      padding-top: 0;
      font-size: 11px;
    }

    :global(.mood-item-content) {
      gap: 8px;
    }

    :global(.mood-item--clickable) {
      margin: 0;
      padding: 14px 0;
    }
  }

  :global(.mood-item:last-child) {
    border-bottom: none;
    padding-bottom: 4px;
  }

  :global(.mood-item--clickable) {
    text-decoration: none;
    color: inherit;
    border-radius: 10px;
    margin: 0 -12px;
    padding: 16px 12px;
    border-bottom: none;
    transition: color 0.15s ease;
    cursor: pointer;
  }

  @media (min-width: 640px) {
    :global(.mood-item--clickable) {
      margin: 0 -16px;
      padding: 18px 16px;
      border-radius: 12px;
    }
  }

  :global(.mood-item--clickable + .mood-item) {
    border-top: none;
  }

  :global(.mood-item-time) {
    font-size: 12px;
    color: hsl(var(--muted-foreground) / 0.6);
    font-variant-numeric: tabular-nums;
    min-width: 44px;
    padding-top: 1px;
    line-height: 1.5;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    :global(.mood-item-time) {
      min-width: 46px;
    }
  }

  :global(.mood-item-content) {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  @media (min-width: 640px) {
    :global(.mood-item-content) {
      gap: 12px;
    }
  }

  :global(.mood-item-forwarded) {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: hsl(var(--muted-foreground));
  }

  :global(.mood-forwarded-label) {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 10px;
    color: hsl(var(--muted-foreground) / 0.7);
  }

  :global(.mood-forwarded-source) {
    font-weight: 500;
    color: hsl(var(--foreground) / 0.85);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  :global(.mood-forwarded-source:hover),
  :global(.mood-forwarded-source:focus-visible) {
    border-bottom-color: hsl(var(--foreground) / 0.35);
  }

  :global(.mood-forwarded-author) {
    color: hsl(var(--muted-foreground) / 0.7);
  }

  :global(.mood-item-quote) {
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
    padding: 8px 10px;
    border-radius: 10px;
    border: none;
    background: hsl(var(--foreground) / 0.03);
    color: hsl(var(--muted-foreground));
    text-decoration: none;
    align-self: flex-start;
    max-width: 88%;
    width: fit-content;
  }

  :global(.mood-item-quote[href]) {
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
  }

  :global(.mood-item-quote[href]:hover),
  :global(.mood-item-quote[href]:focus-visible) {
    background: hsl(var(--foreground) / 0.06);
    color: hsl(var(--foreground) / 0.7);
    box-shadow: 0 0 0 1px hsl(var(--foreground) / 0.08);
  }

  :global(.mood-item-quote[href]:hover .mood-item-quote-text),
  :global(.mood-item-quote[href]:focus-visible .mood-item-quote-text) {
    color: hsl(var(--foreground) / 0.75);
  }

  :global(.mood-item-quote-meta) {
    display: flex;
    align-items: center;
