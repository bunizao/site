  :global(.mood-item-media .bookmark-card--side-media .bookmark-card__media img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 1 / 1;
  }

  :global(.mood-item-media .bookmark-card--side-media .bookmark-card__content) {
    display: block;
    padding: 0;
  }

  :global(.mood-item-media .bookmark-card__content) {
    display: flex;
    flex-direction: column;
    gap: 4px;
