---
import Layout from '../layouts/Layout.astro';
import dayjs from 'dayjs';
import * as cheerio from 'cheerio';
import { getChannelInfo, type ChannelInfo } from '../lib/telegram';

export const prerender = false;

const title = "Moods | Bunizao's Website";
const description = "Thoughts and moments from my Telegram channel";

let moods: any[] = [];
let error = false;
const before = Astro.url.searchParams.get('before') ?? '';
const after = Astro.url.searchParams.get('after') ?? '';
const pageBefore = before && !after ? before : '';
const pageAfter = after && !before ? after : '';

try {
  const result = await getChannelInfo(Astro, { type: 'list', before: pageBefore, after: pageAfter }) as ChannelInfo;
  moods = [...result.posts].sort((a, b) => Number.parseInt(b.id, 10) - Number.parseInt(a.id, 10));
} catch (e) {
  console.error('Failed to fetch moods:', e);
  error = true;
}

// Helper to extract first image from content
function getFirstImage(content: string): string | null {
  const match = content.match(/<img[^>]+src="([^">]+)"/);
  return match ? match[1] : null;
}

// Helper to strip HTML tags for preview
function stripHtml(html: string): string {
  return html
    .replace(/<br\s*\/?>/gi, '\n')
    .replace(/<\/(p|div|li|blockquote)>/gi, '\n')
    .replace(/<[^>]*>/g, '')
    .replace(/\n{3,}/g, '\n\n')
    .trim();
}

function hasMedia(content: string): boolean {
  return /<(img|video|audio|iframe)/i.test(content);
}

// Check if text is long enough to warrant a detail page
function isLongContent(text: string): boolean {
  return text.length > 280;
}

function getInlineMediaPreview(content: string): { type: 'video' | 'audio' | 'bookmark'; html: string } | null {
  const $ = cheerio.load(content);

  const video = $('video').first();
  if (video.length) {
    return { type: 'video', html: $.html(video) };
  }

  const audio = $('audio').first();
  if (audio.length) {
    return { type: 'audio', html: $.html(audio) };
  }

  const bookmark = $('.bookmark-card').first();
  if (bookmark.length) {
    return { type: 'bookmark', html: $.html(bookmark) };
  }

  return null;
}

// Format time for display
function formatTime(value: string): string {
  return dayjs(value).format('HH:mm');
}

// Group moods by date
function groupByDate(items: any[]): Map<string, any[]> {
  const groups = new Map<string, any[]>();
  for (const item of items) {
    const dateKey = dayjs(item.datetime).format('YYYY-MM-DD');
    if (!groups.has(dateKey)) {
      groups.set(dateKey, []);
    }
    groups.get(dateKey)!.push(item);
  }
  return groups;
}

// Format date header
function formatDateHeader(dateKey: string): string {
  const date = dayjs(dateKey);
  const now = dayjs();

  if (date.isSame(now, 'day')) {
    return 'Today';
  }
  if (date.isSame(now.subtract(1, 'day'), 'day')) {
    return 'Yesterday';
  }
  if (date.isSame(now, 'year')) {
    return date.format('MMMM D');
  }
  return date.format('MMMM D, YYYY');
}

function getTextPreview(mood: any): string {
  const fallback = (mood.text ?? '').trim();
  const $ = cheerio.load(mood.content);
  $('blockquote').remove();
  $('.bookmark-card').remove();
  $('video, audio, iframe').remove();
  $('.image-list-container, .image-preview-wrap, .image-preview-button, .sticker').remove();
  $('.tgme_widget_message_poll, .tgme_widget_message_document_wrap, .tgme_widget_message_video_player, .tgme_widget_message_location_wrap').remove();
  const cleanedHtml = $.root().html() ?? '';
  const preview = stripHtml(cleanedHtml);
  return preview || fallback;
}

const groupedMoods = groupByDate(moods);
const newestId = moods[0]?.id ?? '';
const oldestId = moods[moods.length - 1]?.id ?? '';
const hasOlder = Number.parseInt(oldestId, 10) > 1;
const hasNewer = Boolean(pageBefore || pageAfter);
const newerHref = hasNewer && newestId ? `?after=${encodeURIComponent(newestId)}` : '';
const olderHref = hasOlder && oldestId ? `?before=${encodeURIComponent(oldestId)}` : '';
---

<Layout title={title} description={description}>
  <main class="page-container">
    <div class="mood-page">
      <div class="mood-header">
        <a href="/" class="back-link">← Back</a>
        <h1 class="mood-page-title">Moods</h1>
        <p class="mood-page-desc">Thoughts and moments from my Telegram channel</p>
      </div>

      {error ? (
        <p class="text-sm text-muted-foreground">Unable to load moods. Please try again later.</p>
      ) : moods.length > 0 ? (
        <div class="mood-feed">
          <div class="mood-stream" data-mood-list>
            {Array.from(groupedMoods.entries()).map(([dateKey, dateMoods], groupIndex) => (
              <div class="mood-date-group" data-date={dateKey}>
                <div class="mood-date-header">
                  <span class="mood-date-text">{formatDateHeader(dateKey)}</span>
                  <div class="mood-date-line"></div>
                </div>
                <div class="mood-date-items">
                  {dateMoods.map((mood, index) => {
                    const mediaPreview = getInlineMediaPreview(mood.content);
                    const firstImage = mediaPreview ? null : getFirstImage(mood.content);
                    const textPreview = getTextPreview(mood);
                    const firstTag = mood.tags?.[0];
                    const needsDetailPage = !mediaPreview && (hasMedia(mood.content) || isLongContent(textPreview));
                    const globalIndex = groupIndex * 10 + index;

                    return needsDetailPage ? (
                      <a
                        href={`/mood/${mood.id}`}
                        class="mood-item mood-item--clickable"
                        data-mood-id={mood.id}
                        style={`--item-index: ${globalIndex}`}
                      >
                        <time datetime={mood.datetime} class="mood-item-time">
                          {formatTime(mood.datetime)}
                        </time>
                        <div class="mood-item-content">
                          <p class="mood-item-text">{textPreview}</p>
                          {mediaPreview ? (
                            <div class="mood-item-media" set:html={mediaPreview.html} />
                          ) : (
                            firstImage && (
                              <div class="mood-item-thumb">
                                <img src={firstImage} alt="" loading="lazy" />
                              </div>
                            )
                          )}
                          {firstTag && (
                            <span class="mood-item-tag">#{firstTag}</span>
                          )}
                        </div>
                      </a>
                    ) : (
                      <div
                        class="mood-item"
                        data-mood-id={mood.id}
                        style={`--item-index: ${globalIndex}`}
                      >
                        <time datetime={mood.datetime} class="mood-item-time">
                          {formatTime(mood.datetime)}
                        </time>
                        <div class="mood-item-content">
                          <p class="mood-item-text">{textPreview}</p>
                          {mediaPreview ? (
                            <div class="mood-item-media" set:html={mediaPreview.html} />
                          ) : (
                            firstImage && (
                              <div class="mood-item-thumb">
                                <img src={firstImage} alt="" loading="lazy" />
                              </div>
                            )
                          )}
                          {firstTag && (
                            <span class="mood-item-tag">#{firstTag}</span>
                          )}
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            ))}
          </div>
          <div class="mood-load-controls">
            <button type="button" class="mood-load-button" data-load-more>Load more</button>
            <p class="mood-load-status" data-load-status aria-live="polite"></p>
          </div>
          <nav class="mood-pagination" aria-label="Mood pagination">
            {newerHref ? (
              <a class="mood-page-link" href={newerHref} rel="prev">Newer</a>
            ) : (
              <span class="mood-page-placeholder" aria-hidden="true"></span>
            )}
            <span class="mood-page-label">Page</span>
            {olderHref ? (
              <a class="mood-page-link" href={olderHref} rel="next">Older</a>
            ) : (
              <span class="mood-page-placeholder" aria-hidden="true"></span>
            )}
          </nav>
          <div class="mood-sentinel" data-mood-sentinel aria-hidden="true"></div>
        </div>
      ) : (
        <p class="text-sm text-muted-foreground">No moods yet.</p>
      )}
    </div>
  </main>
</Layout>

<style>
  .mood-page {
    padding: 80px 0 60px;
  }

  @media (min-width: 640px) {
    .mood-page {
      padding: 100px 0 80px;
    }
  }

  .mood-header {
    margin-bottom: 40px;
  }

  @media (min-width: 640px) {
    .mood-header {
      margin-bottom: 48px;
    }
  }

  .back-link {
    display: inline-block;
    font-size: 13px;
    color: hsl(var(--muted-foreground));
    margin-bottom: 16px;
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: hsl(var(--foreground));
  }

  .mood-page-title {
    font-size: 28px;
    font-weight: 600;
    margin-bottom: 8px;
  }

  @media (min-width: 640px) {
    .mood-page-title {
      font-size: 32px;
    }
  }

  .mood-page-desc {
    font-size: 14px;
    color: hsl(var(--muted-foreground));
  }

  @media (min-width: 640px) {
    .mood-page-desc {
      font-size: 15px;
    }
  }

  /* Stream Layout */
  :global(.mood-stream) {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  /* Date Group */
  :global(.mood-date-group) {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  :global(.mood-date-header) {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  :global(.mood-date-text) {
    font-size: 12px;
    font-weight: 500;
    color: hsl(var(--muted-foreground));
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  :global(.mood-date-line) {
    flex: 1;
    height: 1px;
    background: hsl(var(--foreground) / 0.08);
  }

  :global(.mood-date-items) {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding-left: 0;
  }

  /* Mood Item - Stream Style */
  :global(.mood-item) {
    display: flex;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid hsl(var(--foreground) / 0.04);
    opacity: 0;
    animation: fade-in 0.3s ease-out forwards;
    animation-delay: calc(var(--item-index) * 0.02s);
  }

  :global(.mood-item:last-child) {
    border-bottom: none;
  }

  :global(.mood-item--clickable) {
    text-decoration: none;
    color: inherit;
    border-radius: 8px;
    margin: 0 -8px;
    padding: 12px 8px;
    border-bottom: none;
    transition: background 0.15s ease;
  }

  :global(.mood-item--clickable:hover) {
    background: hsl(var(--foreground) / 0.03);
  }

  :global(.mood-item--clickable + .mood-item) {
    border-top: none;
  }

  :global(.mood-item-time) {
    font-size: 12px;
    color: hsl(var(--muted-foreground) / 0.5);
    font-variant-numeric: tabular-nums;
    min-width: 40px;
    padding-top: 2px;
  }

  :global(.mood-item-content) {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  :global(.mood-item-media) {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  :global(.mood-item-media video) {
    width: 100%;
    border-radius: 10px;
    background: hsl(var(--foreground) / 0.05);
  }

  :global(.mood-item-media audio) {
    width: 100%;
  }

  :global(.mood-item-media .bookmark-card) {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 10px;
    border: 1px solid hsl(var(--foreground) / 0.1);
    border-radius: 10px;
    background: hsl(var(--background));
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  :global(.mood-item-media .bookmark-card:hover) {
    border-color: hsl(var(--foreground) / 0.2);
    transform: translateY(-1px);
  }

  :global(.mood-item-media .bookmark-card__media) {
    width: 100%;
    border-radius: 8px;
    overflow: hidden;
    background: hsl(var(--foreground) / 0.04);
  }

  :global(.mood-item-media .bookmark-card__media img) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }

  :global(.mood-item-media .bookmark-card__content) {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  :global(.mood-item-media .bookmark-card__title) {
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
  }

  :global(.mood-item-media .bookmark-card__description) {
    font-size: 12px;
    color: hsl(var(--muted-foreground));
    line-height: 1.5;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  :global(.mood-item-media .bookmark-card__meta) {
    font-size: 11px;
    color: hsl(var(--muted-foreground) / 0.8);
  }

  @media (min-width: 560px) {
    :global(.mood-item-media .bookmark-card) {
      flex-direction: row;
      align-items: center;
    }

    :global(.mood-item-media .bookmark-card__media) {
      width: 140px;
      flex-shrink: 0;
    }
  }

  :global(.mood-item-text) {
    font-size: 14px;
    line-height: 1.6;
    color: hsl(var(--foreground));
    white-space: pre-wrap;
    word-wrap: break-word;
  }

  @media (min-width: 640px) {
    :global(.mood-item-text) {
      font-size: 15px;
      line-height: 1.65;
    }
  }

  :global(.mood-item-thumb) {
    width: 100%;
    max-width: 280px;
    border-radius: 8px;
    overflow: hidden;
    background: hsl(var(--foreground) / 0.03);
  }

  :global(.mood-item-thumb img) {
    width: 100%;
    height: auto;
    display: block;
  }

  :global(.mood-item-tag) {
    display: inline-block;
    font-size: 11px;
    color: hsl(var(--muted-foreground) / 0.6);
    align-self: flex-start;
  }

  :global(.mood-feed) {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  :global(.mood-load-controls) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding-top: 16px;
  }

  :global(.mood-load-button) {
    border: 1px solid hsl(var(--foreground) / 0.1);
    background: transparent;
    color: hsl(var(--muted-foreground));
    padding: 8px 20px;
    font-size: 12px;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  :global(.mood-load-button:hover) {
    border-color: hsl(var(--foreground) / 0.2);
    color: hsl(var(--foreground));
  }

  :global(.mood-load-button:focus-visible) {
    outline: 2px solid hsl(var(--foreground) / 0.35);
    outline-offset: 2px;
  }

  :global(.mood-load-button:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }

  :global(.mood-load-button.is-hidden) {
    display: none;
  }

  :global(.mood-load-status) {
    font-size: 12px;
    color: hsl(var(--muted-foreground) / 0.6);
    min-height: 16px;
  }

  :global(.mood-sentinel) {
    height: 1px;
  }

  :global(.mood-pagination) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 8px;
  }

  :global(.mood-page-link) {
    border: 1px solid hsl(var(--foreground) / 0.1);
    background: transparent;
    color: hsl(var(--muted-foreground));
    padding: 6px 14px;
    font-size: 12px;
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  :global(.mood-page-link:hover) {
    border-color: hsl(var(--foreground) / 0.2);
    color: hsl(var(--foreground));
  }

  :global(.mood-page-link:focus-visible) {
    outline: 2px solid hsl(var(--foreground) / 0.35);
    outline-offset: 2px;
  }

  :global(.mood-page-placeholder) {
    width: 72px;
    height: 30px;
  }

  :global(.mood-page-label) {
    font-size: 12px;
    color: hsl(var(--muted-foreground) / 0.5);
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  const list = document.querySelector('[data-mood-list]');
  const loadButton = document.querySelector('[data-load-more]') as HTMLButtonElement | null;
  const status = document.querySelector('[data-load-status]');
  const sentinel = document.querySelector('[data-mood-sentinel]');

  if (list && loadButton && status && sentinel) {
    let isLoading = false;
    let hasMore = true;
    let observer: IntersectionObserver;

    const buttonLabel = loadButton.textContent || 'Load more';

    const formatTime = (value: string): string => {
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return '';
      const hours = String(date.getHours()).padStart(2, '0');
      const minutes = String(date.getMinutes()).padStart(2, '0');
      return `${hours}:${minutes}`;
    };

    const formatDateKey = (value: string): string => {
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return '';
      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, '0');
      const day = String(date.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    };

    const formatDateHeader = (dateKey: string): string => {
      const [year, month, day] = dateKey.split('-').map(Number);
      const date = new Date(year, month - 1, day);
      const now = new Date();

      const isToday =
        date.getFullYear() === now.getFullYear() &&
        date.getMonth() === now.getMonth() &&
        date.getDate() === now.getDate();

      if (isToday) return 'Today';

      const yesterday = new Date(now);
      yesterday.setDate(yesterday.getDate() - 1);
      const isYesterday =
        date.getFullYear() === yesterday.getFullYear() &&
        date.getMonth() === yesterday.getMonth() &&
        date.getDate() === yesterday.getDate();

      if (isYesterday) return 'Yesterday';

      const months = ['January', 'February', 'March', 'April', 'May', 'June',
        'July', 'August', 'September', 'October', 'November', 'December'];

      if (date.getFullYear() === now.getFullYear()) {
        return `${months[date.getMonth()]} ${date.getDate()}`;
      }
      return `${months[date.getMonth()]} ${date.getDate()}, ${date.getFullYear()}`;
    };

    const getBeforeId = (): string => {
      const items = Array.from(list.querySelectorAll('[data-mood-id]'));
      let oldestId = '';
      let oldestValue = Number.POSITIVE_INFINITY;

      items.forEach((item) => {
        const id = item.getAttribute('data-mood-id') || '';
        const numericId = Number.parseInt(id, 10);
        if (!Number.isNaN(numericId) && numericId < oldestValue) {
          oldestValue = numericId;
          oldestId = id;
        }
      });

      return oldestId || items[items.length - 1]?.getAttribute('data-mood-id') || '';
    };

    const setStatus = (message: string): void => {
      status.textContent = message;
    };

    const setLoadingState = (loading: boolean): void => {
      loadButton.disabled = loading || !hasMore;
      loadButton.textContent = loading ? 'Loading...' : buttonLabel;

      if (loading) {
        list.setAttribute('aria-busy', 'true');
      } else {
        list.removeAttribute('aria-busy');
      }
    };

    const isLongContent = (text: string): boolean => (text || '').length > 280;

    interface MoodData {
      id: string;
      datetime: string;
      tag?: string;
      previewText: string;
      image?: string | null;
      mediaHtml?: string;
      needsDetailPage?: boolean;
    }

    const createMoodItem = (mood: MoodData): HTMLElement => {
      const mediaHtml = typeof mood.mediaHtml === 'string' ? mood.mediaHtml.trim() : '';
      const hasMediaHtml = mediaHtml.length > 0;
      const needsDetailPage = typeof mood.needsDetailPage === 'boolean'
        ? mood.needsDetailPage
        : isLongContent(mood.previewText);
      const shouldLink = needsDetailPage && !hasMediaHtml;
      const element = shouldLink
        ? document.createElement('a')
        : document.createElement('div');

      if (shouldLink && element instanceof HTMLAnchorElement) {
        element.href = `/mood/${mood.id}`;
        element.className = 'mood-item mood-item--clickable';
      } else {
        element.className = 'mood-item';
      }

      element.dataset.moodId = mood.id;
      element.style.setProperty('--item-index', '0');

      const time = document.createElement('time');
      time.className = 'mood-item-time';
      time.dateTime = mood.datetime;
      time.textContent = formatTime(mood.datetime);

      const content = document.createElement('div');
      content.className = 'mood-item-content';

      const text = document.createElement('p');
      text.className = 'mood-item-text';
      text.textContent = mood.previewText || '';
      content.appendChild(text);

      if (hasMediaHtml) {
        const media = document.createElement('div');
        media.className = 'mood-item-media';
        media.innerHTML = mediaHtml;
        content.appendChild(media);
      } else if (mood.image) {
        const thumbWrap = document.createElement('div');
        thumbWrap.className = 'mood-item-thumb';
        const img = document.createElement('img');
        img.src = mood.image;
        img.alt = '';
        img.loading = 'lazy';
        thumbWrap.appendChild(img);
        content.appendChild(thumbWrap);
      }

      if (mood.tag) {
        const tag = document.createElement('span');
        tag.className = 'mood-item-tag';
        tag.textContent = `#${mood.tag}`;
        content.appendChild(tag);
      }

      element.appendChild(time);
      element.appendChild(content);
      return element;
    };

    const createDateGroup = (dateKey: string): HTMLElement => {
      const group = document.createElement('div');
      group.className = 'mood-date-group';
      group.dataset.date = dateKey;

      const header = document.createElement('div');
      header.className = 'mood-date-header';

      const dateText = document.createElement('span');
      dateText.className = 'mood-date-text';
      dateText.textContent = formatDateHeader(dateKey);

      const dateLine = document.createElement('div');
      dateLine.className = 'mood-date-line';

      header.appendChild(dateText);
      header.appendChild(dateLine);

      const items = document.createElement('div');
      items.className = 'mood-date-items';

      group.appendChild(header);
      group.appendChild(items);

      return group;
    };

    const appendMoods = (posts: MoodData[]): void => {
      const grouped = new Map<string, MoodData[]>();

      posts.forEach((post) => {
        const dateKey = formatDateKey(post.datetime);
        if (!grouped.has(dateKey)) {
          grouped.set(dateKey, []);
        }
        grouped.get(dateKey)!.push(post);
      });

      grouped.forEach((datePosts, dateKey) => {
        let group = list.querySelector(`[data-date="${dateKey}"]`);

        if (!group) {
          group = createDateGroup(dateKey);
          list.appendChild(group);
        }

        const itemsContainer = group.querySelector('.mood-date-items');
        if (itemsContainer) {
          datePosts.forEach((post) => {
            itemsContainer.appendChild(createMoodItem(post));
          });
        }
      });
    };

    const handleNoMore = (): void => {
      hasMore = false;
      loadButton.classList.add('is-hidden');
      setStatus('No more moods.');
      if (observer) {
        observer.disconnect();
      }
    };

    const loadMore = async (): Promise<void> => {
      if (isLoading || !hasMore) {
        return;
      }

      const before = getBeforeId();
      if (!before) {
        handleNoMore();
        return;
      }

      isLoading = true;
      setLoadingState(true);
      setStatus('Loading more moods...');

      try {
        const response = await fetch(`/api/moods?before=${encodeURIComponent(before)}`);
        if (!response.ok) {
          throw new Error('Failed to load moods.');
        }

        const data = await response.json() as { posts: MoodData[] };
        const posts = Array.isArray(data.posts) ? data.posts : [];
        const existingIds = new Set(
          Array.from(list.querySelectorAll('[data-mood-id]'))
            .map((item) => item.getAttribute('data-mood-id'))
            .filter(Boolean) as string[]
        );
        const uniquePosts = posts.filter((post) => post?.id && !existingIds.has(post.id));

        if (!posts.length || !uniquePosts.length) {
          handleNoMore();
        } else {
          appendMoods(uniquePosts);
          setStatus('');
        }
      } catch (error) {
        console.error(error);
        setStatus('Unable to load more moods.');
      } finally {
        isLoading = false;
        setLoadingState(false);
      }
    };

    loadButton.addEventListener('click', loadMore);

    observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            loadMore();
          }
        });
      },
      {
        rootMargin: '300px 0px',
      }
    );

    observer.observe(sentinel);
  }
</script>
