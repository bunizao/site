---
import Layout from '../layouts/Layout.astro';
import dayjs from 'dayjs';
import relativeTime from 'dayjs/plugin/relativeTime';
import { getChannelInfo, type ChannelInfo } from '../lib/telegram';

dayjs.extend(relativeTime);

const title = "Moods | Bunizao's Website";
const description = "Thoughts and moments from my Telegram channel";

let moods: any[] = [];
let error = false;

try {
  const result = await getChannelInfo(Astro, { type: 'list' }) as ChannelInfo;
  moods = result.posts;
} catch (e) {
  console.error('Failed to fetch moods:', e);
  error = true;
}

// Helper to extract first image from content
function getFirstImage(content: string): string | null {
  const match = content.match(/<img[^>]+src="([^">]+)"/);
  return match ? match[1] : null;
}

// Helper to strip HTML tags for preview
function stripHtml(html: string): string {
  return html.replace(/<[^>]*>/g, '').trim();
}
---

<Layout title={title} description={description}>
  <main class="page-container">
    <div class="mood-page">
      <div class="mood-header">
        <a href="/" class="back-link">← Back</a>
        <h1 class="mood-page-title">Moods</h1>
        <p class="mood-page-desc">Thoughts and moments from my Telegram channel</p>
      </div>

      {error ? (
        <p class="text-sm text-muted-foreground">Unable to load moods. Please try again later.</p>
      ) : moods.length > 0 ? (
        <div class="mood-timeline">
          {moods.map((mood, index) => {
            const firstImage = getFirstImage(mood.content);
            const textPreview = stripHtml(mood.content);
            const firstTag = mood.tags?.[0];
            return (
              <a href={`/mood/${mood.id}`} class="mood-item" style={`--item-index: ${index}`}>
                <div class="mood-item-header">
                  <span class="mood-item-date">{dayjs(mood.datetime).fromNow()}</span>
                  {firstTag && (
                    <span class="mood-item-tag">#{firstTag}</span>
                  )}
                </div>
                <div class="mood-item-body">
                  <p class="mood-item-text">{textPreview}</p>
                  {firstImage && (
                    <div class="mood-item-image">
                      <img src={firstImage} alt="" loading="lazy" />
                    </div>
                  )}
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <p class="text-sm text-muted-foreground">No moods yet.</p>
      )}
    </div>
  </main>
</Layout>

<style>
  .mood-page {
    padding: 80px 0 60px;
  }

  @media (min-width: 640px) {
    .mood-page {
      padding: 100px 0 80px;
    }
  }

  .mood-header {
    margin-bottom: 40px;
  }

  @media (min-width: 640px) {
    .mood-header {
      margin-bottom: 48px;
    }
  }

  .back-link {
    display: inline-block;
    font-size: 13px;
    color: hsl(var(--muted-foreground));
    margin-bottom: 16px;
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: hsl(var(--foreground));
  }

  .mood-page-title {
    font-size: 28px;
    font-weight: 600;
    margin-bottom: 8px;
  }

  @media (min-width: 640px) {
    .mood-page-title {
      font-size: 32px;
    }
  }

  .mood-page-desc {
    font-size: 14px;
    color: hsl(var(--muted-foreground));
  }

  @media (min-width: 640px) {
    .mood-page-desc {
      font-size: 15px;
    }
  }

  /* Timeline Layout */
  .mood-timeline {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  @media (min-width: 640px) {
    .mood-timeline {
      gap: 20px;
    }
  }

  .mood-item {
    display: block;
    padding: 16px;
    background: hsl(var(--background));
    border: 1px solid hsl(var(--foreground) / 0.08);
    border-radius: 8px;
    transition: all 0.2s ease;
    opacity: 0;
    animation: fade-in-up 0.4s ease-out forwards;
    animation-delay: calc(var(--item-index) * 0.015s);
  }

  @media (min-width: 640px) {
    .mood-item {
      padding: 18px 20px;
    }
  }

  .mood-item:hover {
    border-color: hsl(var(--foreground) / 0.15);
    background: hsl(var(--foreground) / 0.02);
  }

  .mood-item-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .mood-item-date {
    font-size: 12px;
    color: hsl(var(--muted-foreground) / 0.6);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 640px) {
    .mood-item-date {
      font-size: 13px;
    }
  }

  .mood-item-tag {
    font-size: 11px;
    color: hsl(var(--muted-foreground) / 0.7);
    padding: 2px 8px;
    background: hsl(var(--foreground) / 0.05);
    border-radius: 4px;
    font-weight: 500;
  }

  @media (min-width: 640px) {
    .mood-item-tag {
      font-size: 12px;
    }
  }

  .mood-item:hover .mood-item-tag {
    background: hsl(var(--foreground) / 0.08);
  }

  .mood-item-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .mood-item-text {
    font-size: 14px;
    line-height: 1.6;
    color: hsl(var(--foreground));
    white-space: pre-wrap;
    word-wrap: break-word;
  }

  @media (min-width: 640px) {
    .mood-item-text {
      font-size: 15px;
      line-height: 1.7;
    }
  }

  .mood-item-image {
    width: 100%;
    max-width: 600px;
    border-radius: 8px;
    overflow: hidden;
    background: hsl(var(--foreground) / 0.03);
  }

  .mood-item-image img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.3s ease;
  }

  .mood-item:hover .mood-item-image img {
    transform: scale(1.02);
  }

  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
