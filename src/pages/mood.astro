---
import Layout from '../layouts/Layout.astro';
import MoodTimelineWheel from '../components/MoodTimelineWheel.astro';

export const prerender = false;

const title = "Moods | Bunizao's Website";
const description = "Thoughts and moments from my Telegram channel";
const rss = { href: '/mood/rss.xml', title: 'Moods RSS' };
const canonicalUrl = new URL(Astro.url.pathname, Astro.url.origin).href;
const oembed = { href: `/api/oembed.json?url=${encodeURIComponent(canonicalUrl)}`, title: 'Mood Embed' };
const channel = import.meta.env.CHANNEL || Astro.locals?.runtime?.env?.CHANNEL || '';
const telegramUrl = channel ? `https://t.me/${channel}` : '';
// Skeleton structure: 2 date group cards to match actual content layout
const skeletonGroups = [
  {
    index: 0,
    dateWidth: '52px', // "Today" length
    items: [
      { index: 0, lineWidth: '72%' },
      { index: 1, lineWidth: '58%' },
      { index: 2, lineWidth: '66%' },
    ],
  },
  {
    index: 1,
    dateWidth: '76px', // "Yesterday" length
    items: [
      { index: 0, lineWidth: '64%' },
      { index: 1, lineWidth: '70%' },
    ],
  },
];
---

<Layout title={title} description={description} rss={rss} oembed={oembed}>
  <!-- Inject page-specific header actions -->
  <script is:inline define:vars={{ telegramUrl }}>
    (() => {
      const headerActions = document.querySelector('[data-header-actions]');
      if (!headerActions) return;

      // Create RSS button with new GSAP-compatible structure
      const rssBtn = document.createElement('a');
      rssBtn.className = 'header-action-btn';
      rssBtn.href = '/mood/rss.xml';
      rssBtn.title = 'Subscribe to RSS feed';
      rssBtn.innerHTML = `
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 11a9 9 0 0 1 9 9"></path>
          <path d="M4 4a16 16 0 0 1 16 16"></path>
          <circle cx="5" cy="19" r="1"></circle>
        </svg>
        <span class="header-action-btn-label">RSS</span>
      `;

      // Create Telegram button if URL exists
      let telegramBtn = null;
      if (telegramUrl) {
        telegramBtn = document.createElement('a');
        telegramBtn.className = 'header-action-btn';
        telegramBtn.href = telegramUrl;
        telegramBtn.target = '_blank';
        telegramBtn.rel = 'noopener noreferrer';
        telegramBtn.title = 'View on Telegram';
        telegramBtn.innerHTML = `
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m22 2-7 20-4-9-9-4Z"></path>
            <path d="M22 2 11 13"></path>
          </svg>
          <span class="header-action-btn-label">Telegram</span>
        `;
      }

      // Insert before theme dropdown
      const themeDropdown = headerActions.querySelector('[data-theme-dropdown]');
      if (themeDropdown) {
        headerActions.insertBefore(rssBtn, themeDropdown);
        if (telegramBtn) {
          headerActions.insertBefore(telegramBtn, themeDropdown);
        }
      } else {
        headerActions.appendChild(rssBtn);
        if (telegramBtn) {
          headerActions.appendChild(telegramBtn);
        }
      }

      // Register buttons with GSAP animation system
      const registerWithGSAP = () => {
        if (window.headerBtnAnimations) {
          window.headerBtnAnimations.register(rssBtn);
          if (telegramBtn) {
            window.headerBtnAnimations.register(telegramBtn);
          }
        } else {
          // Retry if GSAP system not ready yet
          setTimeout(registerWithGSAP, 100);
        }
      };
      registerWithGSAP();
    })();
  </script>

  <!-- Mobile header buttons auto-collapse on scroll past hero -->
  <script>
    import gsap from 'gsap';

    document.addEventListener('DOMContentLoaded', () => {
      const heroEl = document.querySelector('[data-mood-hero]');
      const headerActions = document.querySelector('[data-header-actions]');
      if (!heroEl || !headerActions) return;

      // Only apply on mobile (< 640px)
      const isMobile = () => window.innerWidth < 640;

      let isCollapsed = false;

      const collapseButtons = () => {
        if (isCollapsed) return;
        isCollapsed = true;
        headerActions.classList.add('is-collapsed');

        gsap.to(headerActions, {
          x: '100%',
          opacity: 0,
          duration: 0.35,
          ease: 'power2.inOut',
        });
      };

      const expandButtons = () => {
        if (!isCollapsed) return;
        isCollapsed = false;
        headerActions.classList.remove('is-collapsed');

        gsap.to(headerActions, {
          x: 0,
          opacity: 1,
          duration: 0.3,
          ease: 'power2.out',
        });
      };

      // Use Intersection Observer to detect when hero leaves viewport
      const observer = new IntersectionObserver(
        (entries) => {
          if (!isMobile()) {
            // On desktop, always expanded
            if (isCollapsed) {
              isCollapsed = false;
              headerActions.classList.remove('is-collapsed');
              gsap.set(headerActions, { x: 0, opacity: 1 });
            }
            return;
          }

          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              // Hero is visible - expand buttons
              expandButtons();
            } else {
              // Hero is not visible - collapse buttons
              collapseButtons();
            }
          });
        },
        {
          // Trigger when hero bottom edge crosses viewport top
          rootMargin: '0px 0px 0px 0px',
          threshold: 0,
        }
      );

      observer.observe(heroEl);

      // Handle resize: reset state when switching between mobile/desktop
      let resizeTimer;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          if (!isMobile() && isCollapsed) {
            isCollapsed = false;
            headerActions.classList.remove('is-collapsed');
            gsap.set(headerActions, { x: 0, opacity: 1 });
          }
        }, 100);
      });
    });
  </script>
  <main class="page-container">
    <MoodTimelineWheel />
    <div class="mood-page">
      <div class="mood-hero" data-mood-hero>
        <a href="/" class="back-link">← Back</a>

        <div class="mood-hero-content">
          <!-- Avatar with loading skeleton -->
          <div class="mood-hero-avatar" data-hero-avatar>
            <div class="mood-hero-avatar-skeleton"></div>
          </div>

          <!-- Channel Info -->
          <div class="mood-hero-info">
            <h1 class="mood-hero-title" data-hero-title>
              <span class="mood-hero-title-skeleton"></span>
            </h1>
            <div class="mood-hero-description" data-hero-description>
              <span class="mood-hero-desc-skeleton"></span>
            </div>
          </div>
        </div>
      </div>

      <div class="mood-loading" data-mood-loading>
        <div class="mood-skeleton-stream" aria-hidden="true">
          {skeletonGroups.map((group) => (
            <div
              class="mood-skeleton-group"
              style={`--group-index: ${group.index}; --date-width: ${group.dateWidth};`}
            >
              <div class="mood-skeleton-header">
                <span class="mood-skeleton-date"></span>
                <div class="mood-skeleton-header-line"></div>
              </div>
              <div class="mood-skeleton-items">
                {group.items.map((item) => (
                  <div
                    class="mood-skeleton-item"
                    style={`--item-index: ${item.index}; --line-width: ${item.lineWidth};`}
                  >
                    <span class="mood-skeleton-time"></span>
                    <div class="mood-skeleton-content">
                      <span class="mood-skeleton-line"></span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="mood-error is-hidden" data-mood-error>
        <p class="text-sm text-muted-foreground">Unable to load moods. Please try again later.</p>
      </div>

      <div class="mood-feed is-hidden" data-mood-feed>
        <div class="mood-stream" data-mood-list role="feed" aria-label="Mood feed"></div>
        <div class="mood-load-controls">
          <p class="mood-load-status" data-load-status aria-live="polite"></p>
        </div>
        <div class="mood-sentinel" data-mood-sentinel aria-hidden="true"></div>
      </div>

      <div class="mood-update-notice" data-mood-update-notice role="status" aria-live="polite" aria-atomic="true" style="visibility: hidden;">
        <button class="mood-update-dismiss-dot" type="button" data-mood-update-dismiss aria-label="Dismiss update notice">
          <span class="mood-update-dot" aria-hidden="true"></span>
          <svg class="mood-update-dismiss-cross" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
        <p class="mood-update-text" data-mood-update-text>New moods available</p>
        <div class="mood-update-actions" data-mood-update-actions>
          <button class="mood-update-action" type="button" data-mood-update-refresh aria-label="Refresh">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="23 4 23 10 17 10"></polyline>
              <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
            </svg>
            <span class="mood-update-action-label">Refresh</span>
          </button>
        </div>
        <div class="mood-update-progress" aria-hidden="true"></div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .mood-page {
    padding: 80px 0 60px;
  }

  @media (min-width: 640px) {
    .mood-page {
      padding: 100px 0 80px;
    }
  }

  @media (min-width: 1024px) {
    .mood-page {
      padding: 120px 0 100px;
    }
  }

  /* Hero Section */
  .mood-hero {
    margin-bottom: 48px;
    padding-bottom: 24px;
  }

  /* Navigation row - Back link and action buttons */
  .mood-hero-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
  }

  @media (min-width: 640px) {
    .mood-hero-nav {
      margin-bottom: 28px;
    }
  }

  @media (min-width: 640px) {
    .mood-hero {
      margin-bottom: 56px;
      padding-bottom: 28px;
    }
  }

  @media (min-width: 1024px) {
    .mood-hero {
      margin-bottom: 64px;
      padding-bottom: 32px;
    }
  }

  .mood-hero-content {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  @media (min-width: 640px) {
    .mood-hero-content {
      gap: 20px;
    }
  }

  /* Title row with inline buttons */
  .mood-hero-title-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 6px;
  }

  @media (min-width: 640px) {
    .mood-hero-title-row {
      gap: 16px;
      margin-bottom: 8px;
    }
  }

  /* Avatar */
  .mood-hero-avatar {
    position: relative;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: hsl(var(--foreground) / 0.05);
  }

  @media (min-width: 640px) {
    .mood-hero-avatar {
      width: 80px;
      height: 80px;
    }
  }

  .mood-hero-avatar-skeleton {
    position: absolute;
    inset: 0;
    background: hsl(var(--foreground) / 0.05);
    border-radius: 50%;
  }

  .mood-hero-avatar-skeleton::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      120deg,
      transparent 35%,
      hsl(var(--foreground) / 0.12) 50%,
      transparent 65%
    );
    animation: mood-hero-shimmer 2.8s ease-in-out infinite;
    opacity: 0.35;
  }

  .mood-hero-avatar.is-loaded .mood-hero-avatar-skeleton {
    display: none;
  }

  .mood-hero-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .mood-hero-avatar.is-loaded .mood-hero-avatar-img {
    opacity: 1;
  }

  /* Hero Info */
  .mood-hero-info {
    flex: 1;
    min-width: 0;
    padding-top: 4px;
  }

  @media (min-width: 640px) {
    .mood-hero-info {
      padding-top: 8px;
    }
  }

  /* Title */
  .mood-hero-title {
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 8px;
    line-height: 1.2;
  }

  @media (min-width: 640px) {
    .mood-hero-title {
      font-size: 28px;
      margin-bottom: 10px;
    }
  }

  /* Hero Emoji */
  .mood-hero-emoji {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.1em;
    height: 1.1em;
    margin-left: 0.35em;
    vertical-align: -0.1em;
  }

  .mood-hero-emoji img {
    width: 100%;
    height: 100%;
    display: block;
  }

  .mood-hero-emoji[data-emoji-animated="true"] img {
    display: none;
  }

  .mood-hero-emoji .tg-emoji-anim,
  .mood-hero-emoji .tg-emoji-anim svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .mood-hero-title-skeleton {
    display: inline-block;
    width: 140px;
    height: 24px;
    background: hsl(var(--foreground) / 0.05);
    border-radius: 6px;
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .mood-hero-title-skeleton {
      width: 180px;
      height: 28px;
    }
  }

  .mood-hero-title-skeleton::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      120deg,
      transparent 35%,
      hsl(var(--foreground) / 0.12) 50%,
      transparent 65%
    );
    animation: mood-hero-shimmer 2.8s ease-in-out infinite;
    animation-delay: 0.1s;
    opacity: 0.35;
  }

  .mood-hero-title.is-loaded .mood-hero-title-skeleton {
    display: none;
  }

  /* Description */
  .mood-hero-description {
    font-size: 14px;
    color: hsl(var(--muted-foreground));
    line-height: 1.5;
  }

  @media (min-width: 640px) {
    .mood-hero-description {
      font-size: 15px;
    }
  }

  .mood-hero-desc-skeleton {
    display: inline-block;
    width: 220px;
    height: 14px;
    background: hsl(var(--foreground) / 0.05);
    border-radius: 4px;
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .mood-hero-desc-skeleton {
      width: 280px;
      height: 15px;
    }
  }

  .mood-hero-desc-skeleton::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      120deg,
      transparent 35%,
      hsl(var(--foreground) / 0.12) 50%,
      transparent 65%
    );
    animation: mood-hero-shimmer 2.8s ease-in-out infinite;
    animation-delay: 0.2s;
    opacity: 0.35;
  }

  .mood-hero-description.is-loaded .mood-hero-desc-skeleton {
    display: none;
  }

  /* Description links and emoji */
  .mood-hero-description :global(a) {
    color: hsl(var(--foreground));
    text-decoration: none;
    border-bottom: 1px solid hsl(var(--foreground) / 0.35);
    transition: border-color 0.15s ease;
  }

  .mood-hero-description :global(a:hover) {
    border-bottom-color: hsl(var(--foreground) / 0.6);
  }

  .mood-hero-description :global(.tg-emoji) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.15em;
    height: 1.15em;
    vertical-align: -0.15em;
  }

  .mood-hero-description :global(.tg-emoji img) {
    width: 100%;
    height: 100%;
    display: block;
  }

  @keyframes mood-hero-shimmer {
    0% {
      transform: translateX(-100%);
      opacity: 0.2;
    }
    100% {
      transform: translateX(200%);
      opacity: 0.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mood-hero-avatar-skeleton::after,
    .mood-hero-title-skeleton::after,
    .mood-hero-desc-skeleton::after {
      animation: none;
    }
  }

  .back-link {
    display: inline-block;
    font-size: 13px;
    color: hsl(var(--muted-foreground));
    margin-bottom: 24px;
    transition: color 0.15s ease;
  }

  @media (min-width: 640px) {
    .back-link {
      margin-bottom: 28px;
    }
  }

  .back-link:hover {
    color: hsl(var(--foreground));
  }

  .mood-page-title {
    font-size: 28px;
    font-weight: 600;
    margin-bottom: 12px;
    line-height: 1.2;
  }

  @media (min-width: 640px) {
    .mood-page-title {
      font-size: 32px;
      margin-bottom: 16px;
    }
  }

  .mood-page-desc {
    font-size: 14px;
    color: hsl(var(--muted-foreground));
    line-height: 1.5;
    margin-bottom: 20px;
  }

  @media (min-width: 640px) {
    .mood-page-desc {
      font-size: 15px;
      margin-bottom: 24px;
    }
  }

  .mood-header-actions {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .back-link {
    font-size: 13px;
    color: hsl(var(--muted-foreground));
    transition: color 0.15s ease;
  }

  .mood-action-button {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    font-weight: 450;
    letter-spacing: 0.01em;
    border-radius: 5px;
    padding: 6px 10px;
    transition: all 0.15s ease;
    text-decoration: none;
    border: 1px solid hsl(var(--foreground) / 0.1);
    background: hsl(var(--background));
    min-height: 28px;
  }

  @media (min-width: 640px) {
    .mood-action-button {
      padding: 7px 12px;
      min-height: 32px;
    }
  }

  .mood-action-icon {
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    opacity: 0.75;
  }

  @media (min-width: 640px) {
    .mood-action-icon {
      width: 13px;
      height: 13px;
    }
  }

  .mood-action-button--secondary,
  .mood-action-button--primary {
    color: hsl(var(--muted-foreground) / 0.9);
  }

  .mood-action-button--secondary:hover,
  .mood-action-button--primary:hover {
    color: hsl(var(--foreground));
    background: hsl(var(--foreground) / 0.05);
    border-color: hsl(var(--foreground) / 0.18);
    transform: translateY(-1px);
  }

  .mood-action-button:hover .mood-action-icon {
    opacity: 1;
  }

  /* Loading State - Card-based Skeleton */
  :global(.mood-loading) {
    display: block;
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
  }

  :global(.mood-loading.is-hidden) {
    display: none;
  }

  :global(.mood-skeleton-stream) {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  @media (min-width: 640px) {
    :global(.mood-skeleton-stream) {
      gap: 48px;
    }
  }

  :global(.mood-skeleton-group) {
    background: hsl(var(--background));
    border-radius: 12px;
    padding: 20px;
    border: 1px solid hsl(var(--foreground) / 0.06);
    box-shadow: 0 1px 0 hsl(var(--foreground) / 0.03);
    --group-delay: calc(var(--group-index, 0) * 0.15s);
  }

  @media (min-width: 640px) {
    :global(.mood-skeleton-group) {
      padding: 24px;
      border-radius: 16px;
    }
  }

  /* Skeleton Header */
  :global(.mood-skeleton-header) {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
  }

  @media (min-width: 640px) {
    :global(.mood-skeleton-header) {
      margin-bottom: 24px;
    }
  }

  :global(.mood-skeleton-date) {
    display: block;
    width: var(--date-width, 60px);
    height: 12px;
    background: hsl(var(--foreground) / 0.06);
    border-radius: 4px;
    position: relative;
    overflow: hidden;
  }

  :global(.mood-skeleton-date::after) {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      hsl(var(--foreground) / 0.08) 50%,
      transparent 100%
    );
    animation: skeleton-shimmer 2s ease-in-out infinite;
    animation-delay: var(--group-delay);
  }

  :global(.mood-skeleton-header-line) {
    flex: 1;
    height: 1px;
    background: hsl(var(--foreground) / 0.08);
  }

  /* Skeleton Items */
  :global(.mood-skeleton-items) {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  :global(.mood-skeleton-item) {
    display: flex;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid hsl(var(--foreground) / 0.04);
    --item-delay: calc(var(--group-delay) + var(--item-index, 0) * 0.08s);
  }

  :global(.mood-skeleton-item:last-child) {
    border-bottom: none;
    padding-bottom: 4px;
  }

  @media (min-width: 640px) {
    :global(.mood-skeleton-item) {
      padding: 18px 0;
      gap: 18px;
    }
  }

  @media (max-width: 640px) {
    :global(.mood-skeleton-item) {
      flex-direction: column;
      gap: 8px;
    }
  }

  :global(.mood-skeleton-time) {
    display: block;
    width: 36px;
    height: 12px;
    background: hsl(var(--foreground) / 0.05);
    border-radius: 4px;
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
  }

  :global(.mood-skeleton-time::after) {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      hsl(var(--foreground) / 0.06) 50%,
      transparent 100%
    );
    animation: skeleton-shimmer 2s ease-in-out infinite;
    animation-delay: var(--item-delay);
  }

  @media (min-width: 640px) {
    :global(.mood-skeleton-time) {
      width: 40px;
    }
  }

  :global(.mood-skeleton-content) {
    flex: 1;
    min-width: 0;
  }

  :global(.mood-skeleton-line) {
    display: block;
    width: var(--line-width, 70%);
    height: 14px;
    background: hsl(var(--foreground) / 0.05);
    border-radius: 6px;
    position: relative;
    overflow: hidden;
  }

  :global(.mood-skeleton-line::after) {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      hsl(var(--foreground) / 0.08) 50%,
      transparent 100%
    );
    animation: skeleton-shimmer 2s ease-in-out infinite;
    animation-delay: var(--item-delay);
  }

  @keyframes skeleton-shimmer {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.mood-skeleton-date::after),
    :global(.mood-skeleton-time::after),
    :global(.mood-skeleton-line::after) {
      animation: none;
    }
  }

  /* Inline Loading for Load More */
  :global(.mood-loading-inline) {
    display: flex;
    flex-direction: column;
    padding: 16px 0;
  }

  :global(.mood-loading-inline .mood-skeleton-group) {
    opacity: 0.7;
  }

  /* Error State */
  .mood-error {
    padding: 60px 0;
    text-align: center;
  }

  .mood-error.is-hidden {
    display: none;
  }

  /* Feed Hidden State */
  .mood-feed.is-hidden {
    display: none;
  }

  /* Stream Layout */
  :global(.mood-stream) {
    display: flex;
    flex-direction: column;
    gap: 40px;
    width: 100%;
    max-width: 680px;
    min-width: 0;
    margin: 0 auto;
  }

  @media (min-width: 640px) {
    :global(.mood-stream) {
      gap: 48px;
    }
  }

  @media (min-width: 1024px) {
    :global(.mood-stream) {
      gap: 56px;
      max-width: 720px;
    }
  }

  /* Date Group */
  :global(.mood-date-group) {
    display: flex;
    flex-direction: column;
    gap: 0;
    background: hsl(var(--background));
    border-radius: 12px;
    padding: 20px;
    border: 1px solid hsl(var(--foreground) / 0.06);
    box-shadow: 0 1px 0 hsl(var(--foreground) / 0.03);
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  @media (min-width: 640px) {
    :global(.mood-date-group) {
      padding: 24px;
      border-radius: 16px;
    }
  }

  @media (min-width: 1024px) {
    :global(.mood-date-group) {
      padding: 28px;
    }
  }

  :global(.mood-date-header) {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
    padding-top: 0;
  }

  @media (min-width: 640px) {
    :global(.mood-date-header) {
      margin-bottom: 24px;
    }
  }

  :global(.mood-date-text) {
    font-size: 12px;
    font-weight: 500;
    color: hsl(var(--muted-foreground));
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
    padding-right: 4px;
  }

  :global(.mood-date-line) {
    flex: 1;
    height: 1px;
    background: hsl(var(--foreground) / 0.1);
  }

  :global(.mood-date-items) {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding-left: 0;
    min-width: 0;
  }

  /* Mood Item - Stream Style */
  :global(.mood-item) {
    display: flex;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid hsl(var(--foreground) / 0.04);
    position: relative;
  }

  :global(.mood-item:hover),
  :global(.mood-item:focus-within) {
    z-index: 2;
  }

  @media (min-width: 640px) {
    :global(.mood-item) {
      padding: 18px 0;
      gap: 18px;
    }
  }

  @media (max-width: 640px) {
    :global(.mood-item) {
      flex-direction: column;
      gap: 6px;
    }

    :global(.mood-item-time) {
      min-width: 0;
      padding-top: 0;
      font-size: 11px;
    }

    :global(.mood-item-content) {
      gap: 8px;
      padding-right: 32px;
    }

    :global(.mood-item--clickable) {
      margin: 0;
      padding: 14px 0;
    }
  }

  :global(.mood-item:last-child) {
    border-bottom: none;
    padding-bottom: 4px;
  }

  :global(.mood-item--clickable) {
    text-decoration: none;
    color: inherit;
    border-radius: 10px;
    margin: 0 -12px;
    padding: 16px 12px;
    border-bottom: none;
    transition: color 0.15s ease;
    cursor: pointer;
  }

  @media (min-width: 640px) {
    :global(.mood-item--clickable) {
      margin: 0 -16px;
      padding: 18px 16px;
      border-radius: 12px;
    }
  }

  :global(.mood-item--clickable + .mood-item) {
    border-top: none;
  }

  :global(.mood-item-time) {
    font-size: 12px;
    color: hsl(var(--muted-foreground) / 0.6);
    font-variant-numeric: tabular-nums;
    min-width: 44px;
    padding-top: 1px;
    line-height: 1.5;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    :global(.mood-item-time) {
      min-width: 46px;
    }
  }

  :global(.mood-item-content) {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-right: 32px;
  }

  @media (min-width: 640px) {
    :global(.mood-item-content) {
      gap: 12px;
    }
  }

  :global(.mood-item-forwarded) {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: hsl(var(--muted-foreground));
  }

  :global(.mood-forwarded-label) {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 10px;
    color: hsl(var(--muted-foreground) / 0.7);
  }

  :global(.mood-forwarded-source) {
    font-weight: 500;
    color: hsl(var(--foreground) / 0.85);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  :global(.mood-forwarded-source:hover),
  :global(.mood-forwarded-source:focus-visible) {
    border-bottom-color: hsl(var(--foreground) / 0.35);
  }

  :global(.mood-forwarded-author) {
    color: hsl(var(--muted-foreground) / 0.7);
  }

  :global(.mood-item-quote) {
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
    padding: 8px 10px;
    border-radius: 10px;
    border: none;
    background: hsl(var(--foreground) / 0.03);
    color: hsl(var(--muted-foreground));
    text-decoration: none;
    align-self: flex-start;
    max-width: 88%;
    width: fit-content;
  }

  :global(.mood-item-quote[href]) {
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
  }

  :global(.mood-item-quote[href]:hover),
  :global(.mood-item-quote[href]:focus-visible) {
    background: hsl(var(--foreground) / 0.06);
    color: hsl(var(--foreground) / 0.7);
    box-shadow: 0 0 0 1px hsl(var(--foreground) / 0.08);
  }

  :global(.mood-item-quote[href]:hover .mood-item-quote-text),
  :global(.mood-item-quote[href]:focus-visible .mood-item-quote-text) {
    color: hsl(var(--foreground) / 0.75);
  }

  :global(.mood-item-quote-meta) {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    text-transform: none;
    letter-spacing: 0.02em;
    color: hsl(var(--muted-foreground));
  }

  :global(.mood-item-quote-author) {
    font-size: 11px;
    letter-spacing: 0.02em;
    text-transform: none;
    color: hsl(var(--foreground) / 0.6);
  }

  :global(.mood-item-quote-text) {
    margin: 0;
    font-size: 12px;
    line-height: 1.55;
    color: hsl(var(--foreground) / 0.6);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }

  :global(.mood-item-media) {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  :global(.mood-item-media video) {
    width: 100%;
    max-width: 100%;
    height: auto;
    display: block;
    border-radius: 10px;
    background: hsl(var(--foreground) / 0.05);
    overflow: hidden;
    -webkit-mask-image: -webkit-radial-gradient(white, black);
    mask-image: radial-gradient(white, black);
  }

  :global(.mood-item-media audio) {
    width: 100%;
  }

  :global(.mood-item-media .tgme_widget_message_document_wrap) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border: 1px solid hsl(var(--foreground) / 0.1);
    border-radius: 10px;
    background: hsl(var(--background));
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease;
  }

  :global(.mood-item-media .tgme_widget_message_document_wrap:hover) {
    border-color: hsl(var(--foreground) / 0.18);
  }

  :global(.mood-item-media .tgme_widget_message_document_icon) {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: hsl(var(--foreground) / 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    position: relative;
  }

  :global(.mood-item-media .tgme_widget_message_document_icon.audio::before) {
    content: '';
    border-left: 8px solid hsl(var(--foreground) / 0.7);
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
    margin-left: 2px;
  }

  :global(.mood-item-media .tgme_widget_message_document) {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  :global(.mood-item-media .tgme_widget_message_document_title) {
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
  }

  :global(.mood-item-media .tgme_widget_message_document_extra) {
    font-size: 12px;
    color: hsl(var(--muted-foreground));
    line-height: 1.4;
  }

  :global(.mood-item-media .bookmark-card) {
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 100%;
    max-width: 320px;
    border: 1px solid hsl(var(--foreground) / 0.1);
    border-radius: 8px;
    background: hsl(var(--background));
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: border-color 0.15s ease;
  }

  @media (min-width: 640px) {
    :global(.mood-item-media .bookmark-card) {
      max-width: 360px;
    }
  }

  :global(.mood-item-media .bookmark-card:hover) {
    border-color: hsl(var(--foreground) / 0.2);
  }

  :global(.mood-item-media .bookmark-card__media) {
    width: 100%;
    background: hsl(var(--foreground) / 0.03);
  }

  :global(.mood-item-media .bookmark-card__media img) {
    width: 100%;
    display: block;
    object-fit: cover;
    aspect-ratio: 1.91 / 1;
  }

  :global(.mood-item-media .bookmark-card__content) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 8px 10px;
  }

  :global(.mood-item-media .bookmark-card__title) {
    font-size: 13px;
    font-weight: 500;
    line-height: 1.35;
    color: hsl(var(--foreground));
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.mood-item-media .bookmark-card__description) {
    font-size: 12px;
    color: hsl(var(--muted-foreground));
    line-height: 1.4;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    overflow: hidden;
  }

  :global(.mood-item-media .bookmark-card__meta) {
    font-size: 11px;
    color: hsl(var(--muted-foreground) / 0.5);
  }

  :global(.mood-item-text) {
    font-size: 14px;
    line-height: 1.6;
    color: hsl(var(--foreground));
    white-space: pre-wrap;
    word-wrap: break-word;
    overflow-wrap: anywhere;
  }

  :global(.mood-item-text--clamped) {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 6;
    overflow: hidden;
  }

  :global(.mood-item-details) {
    align-self: flex-start;
    font-size: 13px;
    font-weight: 500;
    color: hsl(var(--muted-foreground));
    text-decoration: none;
  }

  @media (min-width: 640px) {
    :global(.mood-item-details) {
      font-size: 14px;
    }
  }

  :global(.mood-item-text a) {
    color: hsl(var(--foreground));
    text-decoration: none;
    border-bottom: 1px solid hsl(var(--foreground) / 0.35);
    transition: border-color 0.15s ease, color 0.15s ease, opacity 0.15s ease;
  }

  :global(.mood-item-text a:hover),
  :global(.mood-item-text a:focus-visible) {
    border-bottom-color: hsl(var(--foreground) / 0.6);
  }

  @media (min-width: 640px) {
    :global(.mood-item-text) {
      font-size: 15px;
      line-height: 1.65;
    }
  }

  :global(.mood-item-thumb) {
    width: 100%;
    max-width: 400px;
    border-radius: 12px;
    overflow: hidden;
    background: hsl(var(--foreground) / 0.02);
    position: relative;
  }

  /* Landscape and square images - normal flow */
  :global(.mood-item-thumb img) {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.2s ease;
  }

  /* Portrait images - fit within max height without cropping */
  :global(.mood-item-thumb--portrait) {
    display: flex;
    align-items: center;
    justify-content: center;
    background: hsl(var(--foreground) / 0.04);
  }

  :global(.mood-item-thumb--portrait img) {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 280px;
    object-fit: contain;
    object-position: center;
    margin: 0;
  }

  /* Ultra-tall images - contain without cropping */
  :global(.mood-item-thumb--ultra-tall) {
    display: flex;
    align-items: center;
    justify-content: center;
    background: hsl(var(--foreground) / 0.03);
  }

  :global(.mood-item-thumb--ultra-tall img) {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 320px;
    object-fit: contain;
    object-position: center;
  }

  @media (min-width: 640px) {
    :global(.mood-item-thumb) {
      max-width: 480px;
      border-radius: 14px;
    }

    :global(.mood-item-thumb--portrait img) {
      max-height: 320px;
    }

    :global(.mood-item-thumb--ultra-tall img) {
      max-height: 360px;
    }
  }

  @media (min-width: 1024px) {
    :global(.mood-item-thumb) {
      max-width: 560px;
      border-radius: 16px;
    }

    :global(.mood-item-thumb--portrait img) {
      max-height: 360px;
    }

    :global(.mood-item-thumb--ultra-tall img) {
      max-height: 400px;
    }
  }

  :global(.mood-item-tag) {
    display: inline-block;
    font-size: 11px;
    color: hsl(var(--muted-foreground) / 0.6);
    align-self: flex-start;
  }

  /* Reactions */
  :global(.mood-item-reactions) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }

  :global(.mood-reaction) {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 3px 8px 3px 6px;
    font-size: 12px;
    background: hsl(var(--foreground) / 0.05);
    border-radius: 999px;
    color: hsl(var(--muted-foreground));
    border: 1px solid transparent;
  }

  :global(.mood-reaction--paid) {
    background: hsl(45 100% 50% / 0.08);
    color: hsl(45 70% 40%);
  }

  :global(.mood-reaction-emoji) {
    display: inline-flex;
    align-items: center;
    font-size: 14px;
    line-height: 1;
  }

  :global(.mood-reaction-emoji img) {
    width: 1em;
    height: 1em;
    display: block;
  }

  :global(.tg-emoji) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.15em;
    height: 1.15em;
    vertical-align: -0.15em;
  }

  :global(.tg-emoji img) {
    width: 100%;
    height: 100%;
    display: block;
  }

  :global(.tg-emoji[data-emoji-animated="true"] img) {
    display: none;
  }

  :global(.tg-emoji-anim),
  :global(.tg-emoji-anim svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  :global(.mood-reaction-count) {
    font-size: 12px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    opacity: 0.8;
  }

  /* Comments indicator */
  :global(.mood-item-comments) {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 8px 3px 6px;
    font-size: 12px;
    background: hsl(var(--foreground) / 0.03);
    border-radius: 999px;
    color: hsl(var(--muted-foreground) / 0.7);
    transition: background-color 0.15s ease, color 0.15s ease;
    border: 1px solid transparent;
    text-decoration: none;
    cursor: pointer;
  }

  :global(.mood-item-comments:hover),
  :global(.mood-item-comments:focus-visible) {
    background: hsl(var(--foreground) / 0.06);
    color: hsl(var(--muted-foreground));
    border-color: hsl(var(--foreground) / 0.06);
  }

  :global(.mood-comments-icon) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
    opacity: 0.7;
    transition: opacity 0.15s ease;
  }

  :global(.mood-item-comments:hover .mood-comments-icon) {
    opacity: 1;
  }

  :global(.mood-comments-count) {
    font-size: 12px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  /* Floating expand button - appears on hover */
  :global(.mood-item-expand-float) {
    position: absolute;
    top: 12px;
    right: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: transparent;
    border-radius: 6px;
    color: hsl(var(--muted-foreground) / 0.4);
    text-decoration: none;
    cursor: pointer;
    opacity: 0;
    transition: all 0.2s ease;
    z-index: 10;
  }

  :global(.mood-item:hover .mood-item-expand-float),
  :global(.mood-item-expand-float:focus-visible) {
    opacity: 1;
  }

  :global(.mood-item-expand-float:hover) {
    color: hsl(var(--foreground) / 0.7);
    background: hsl(var(--foreground) / 0.05);
  }

  :global(.mood-item-expand-float:active) {
    transform: scale(0.92);
  }

  :global(.mood-item-expand-float svg) {
    flex-shrink: 0;
  }

  /* Ensure mood-item has relative positioning for the float button */
  :global(.mood-item) {
    position: relative;
  }

  @media (min-width: 640px) {
    :global(.mood-item-expand-float) {
      right: 16px;
    }
  }

  @media (max-width: 640px) {
    :global(.mood-item-expand-float) {
      width: 24px;
      height: 24px;
      top: 8px;
      right: 6px;
      opacity: 0.6;
    }

    :global(.mood-item-expand-float svg) {
      width: 12px;
      height: 12px;
    }
  }

  /* Comments popover wrapper */
  :global(.mood-comments-wrapper) {
    position: relative;
    display: inline-flex;
  }

  :global(.mood-comments-popover) {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    width: 320px;
    max-width: calc(100vw - 32px);
    max-height: 280px;
    overflow-y: auto;
    overflow-x: hidden;
    background: hsl(var(--background) / 0.72);
    backdrop-filter: blur(20px) saturate(1.4);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    border: 1px solid hsl(var(--foreground) / 0.06);
    border-radius: 16px;
    box-shadow:
      0 8px 32px hsl(var(--foreground) / 0.1),
      0 2px 8px hsl(var(--foreground) / 0.04),
      inset 0 1px 0 hsl(var(--foreground) / 0.04);
    padding: 12px;
    opacity: 0;
    visibility: hidden;
    transform: translateX(-50%) translateY(4px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    z-index: 100;
    pointer-events: none;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  :global(.mood-comments-popover::-webkit-scrollbar) {
    display: none;
  }

  :global(.mood-comments-wrapper:hover .mood-comments-popover),
  :global(.mood-comments-popover:hover) {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }

  :global(.mood-comments-popover::before) {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%);
    width: 16px;
    height: 8px;
    background: transparent;
  }

  :global(.mood-comments-popover-list) {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  :global(.mood-comments-popover-empty) {
    text-align: center;
    padding: 16px 8px;
    color: hsl(var(--muted-foreground) / 0.6);
    font-size: 13px;
