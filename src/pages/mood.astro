    -webkit-line-clamp: 2;
    overflow: hidden;
    overflow-wrap: break-word;
  }

  :global(.mood-item-media .bookmark-card__description) {
    font-size: 12px;
    color: hsl(var(--muted-foreground));
    line-height: 1.48;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    overflow-wrap: break-word;
  }

  :global(.mood-item-media .bookmark-card--side-media .bookmark-card__description) {
    display: -webkit-box;
    -webkit-line-clamp: 5;
  }

  :global(.mood-item-media .bookmark-card--side-media .bookmark-card__meta) {
    order: initial;
    display: block;
    margin-bottom: 4px;
    font-size: 11px;
    letter-spacing: 0;
    text-transform: none;
  }

  :global(.mood-item-media .bookmark-card__meta) {
    order: -1;
    font-size: 10px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0;
    text-transform: none;
    color: hsl(var(--muted-foreground));
  }

  :global(.mood-item-details) {
    align-self: flex-start;
    font-size: 13px;
    font-weight: 500;
    color: hsl(var(--muted-foreground));
    text-decoration: none;
  }

  @media (min-width: 640px) {
    :global(.mood-item-details) {
      font-size: 14px;
    }
  }

  :global(.mood-item-thumb) {
    width: 100%;
    max-width: 400px;
    border-radius: 12px;
    overflow: hidden;
    background: hsl(var(--foreground) / 0.02);
    position: relative;
  }

  :global(.mood-item-thumb--video) {
    width: 100%;
    align-self: flex-start;
    background: hsl(var(--foreground) / 0.04);
    box-shadow: inset 0 0 0 1px hsl(var(--foreground) / 0.04);
    aspect-ratio: var(--mood-thumb-ratio, 16 / 9);
  }

  :global(.mood-item-thumb--video-portrait) {
    width: min(100%, 220px);
    max-width: min(100%, 220px);
  }

  :global(.mood-item-thumb--video-ultra-tall) {
    width: min(100%, 180px);
    max-width: min(100%, 180px);
  }

  :global(.mood-item-thumb--video img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(14px);
    transform: scale(1.08);
  }

  :global(.mood-item-thumb-video-overlay) {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 20px;
    text-align: center;
    background: linear-gradient(180deg, hsl(0 0% 0% / 0.1) 0%, hsl(0 0% 0% / 0.42) 100%);
    pointer-events: none;
  }

  :global(.mood-item-thumb-video-label) {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.85);
    letter-spacing: 0.01em;
    line-height: 1.2;
    white-space: nowrap;
  }

  :global(.mood-item-thumb-video-cta) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
    padding: 7px 18px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: #fff;
    border: 1.5px solid rgba(255, 255, 255, 0.75);
    background: transparent;
    transition: background 0.15s ease, border-color 0.15s ease;
    white-space: nowrap;
  }

  :global(.mood-item-thumb-video-time) {
    position: absolute;
    right: 10px;
    bottom: 10px;
    padding: 4px 7px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.48);
    color: rgba(255, 255, 255, 0.92);
    font-family: var(--font-code);
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0;
    font-variant-numeric: tabular-nums;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  :global(.mood-item--clickable:hover .mood-item-thumb-video-cta),
  :global(.mood-item--clickable:focus-visible .mood-item-thumb-video-cta) {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.95);
  }

  /* Landscape and square images - normal flow */
  :global(.mood-item-thumb img) {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.2s ease;
  }

  :global(.mood-item-thumb:not(.mood-item-thumb--sticker) img) {
    box-shadow: inset 0 0 0 1px hsl(var(--foreground) / 0.1);
  }

  :global(.mood-item-thumb.mood-item-thumb--sticker) {
    display: inline-flex;
    align-items: flex-start;
    justify-content: flex-start;
    align-self: flex-start;
    width: min(100%, 256px);
    max-width: min(100%, 256px);
    background: transparent;
  }

  :global(.mood-item-thumb--sticker img) {
    width: 100%;
    max-width: 256px;
    height: auto;
    object-fit: contain;
  }

  /* Portrait images - fit within max height without cropping.

     The wrapper takes the contained box outright rather than shrinking to the
     image, so it holds its height before the image decodes. `fit-content` here
     measured 0px until then, and every one of these items collapsed and then
     popped open as it scrolled into view. --mood-thumb-reserved-width carries
     the server-computed contained width; the fallback is the box's max. */
  :global(.mood-item-thumb--portrait) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    width: min(100%, var(--mood-thumb-reserved-width, 220px));
    max-width: min(100%, var(--mood-thumb-reserved-width, 220px));
    aspect-ratio: var(--mood-thumb-ratio, 3 / 4);
    background: hsl(var(--foreground) / 0.04);
  }

  :global(.mood-item-thumb--portrait img),
  :global(.mood-item-thumb--ultra-tall img) {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    object-fit: contain;
    object-position: center;
    margin: 0;
  }

  /* Ultra-tall images - contain without cropping */
  :global(.mood-item-thumb--ultra-tall) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    width: min(100%, var(--mood-thumb-reserved-width, 180px));
    max-width: min(100%, var(--mood-thumb-reserved-width, 180px));
    aspect-ratio: var(--mood-thumb-ratio, 9 / 16);
    background: hsl(var(--foreground) / 0.03);
  }

  @media (min-width: 640px) {
    :global(.mood-item-media video) {
      max-height: min(56vh, 440px);
    }

    :global(.mood-item-media video.video--portrait) {
      width: min(100%, 360px);
    }

    :global(.mood-item-media video.video--ultra-tall) {
      width: min(100%, 320px);
    }

    :global(.mood-item-thumb) {
      max-width: 480px;
      border-radius: 14px;
    }

    :global(.mood-item-thumb--video-portrait) {
      width: min(100%, 240px);
      max-width: min(100%, 240px);
    }

    :global(.mood-item-thumb--video-ultra-tall) {
      width: min(100%, 200px);
      max-width: min(100%, 200px);
    }

    :global(.mood-item-thumb--portrait) {
      width: min(100%, var(--mood-thumb-reserved-width-sm, 240px));
      max-width: min(100%, var(--mood-thumb-reserved-width-sm, 240px));
    }

    :global(.mood-item-thumb--ultra-tall) {
      width: min(100%, var(--mood-thumb-reserved-width-sm, 200px));
      max-width: min(100%, var(--mood-thumb-reserved-width-sm, 200px));
    }
  }

  @media (min-width: 1024px) {
    :global(.mood-item-media video) {
      max-height: min(60vh, 480px);
    }

    :global(.mood-item-media video.video--portrait) {
      width: min(100%, 400px);
    }

    :global(.mood-item-media video.video--ultra-tall) {
      width: min(100%, 340px);
    }

    :global(.mood-item-thumb) {
      max-width: 560px;
      border-radius: 16px;
    }

    :global(.mood-item-thumb--video-portrait) {
      width: min(100%, 260px);
      max-width: min(100%, 260px);
    }

    :global(.mood-item-thumb--video-ultra-tall) {
      width: min(100%, 220px);
      max-width: min(100%, 220px);
    }

    :global(.mood-item-thumb--portrait) {
      width: min(100%, var(--mood-thumb-reserved-width-lg, 260px));
      max-width: min(100%, var(--mood-thumb-reserved-width-lg, 260px));
    }

    :global(.mood-item-thumb--ultra-tall) {
      width: min(100%, var(--mood-thumb-reserved-width-lg, 220px));
      max-width: min(100%, var(--mood-thumb-reserved-width-lg, 220px));
    }
  }

  :global(.mood-item-tag) {
    display: inline-block;
    font-size: 11px;
    color: hsl(var(--muted-foreground) / 0.6);
    align-self: flex-start;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  :global(a.mood-item-tag:hover),
  :global(a.mood-item-tag:focus-visible) {
    color: hsl(var(--foreground));
  }

  /* Reactions */
  :global(.mood-item-reactions) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }

  :global(.tg-emoji) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.15em;
    height: 1.15em;
    vertical-align: -0.15em;
  }

  :global(.tg-emoji img) {
    width: 100%;
    height: 100%;
    display: block;
  }

  :global(.tg-emoji[data-emoji-animated="true"] img) {
    display: none;
  }

  :global(.tg-emoji-anim),
  :global(.tg-emoji-anim svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  :global(.mood-reaction-count) {
    font-size: 12px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    opacity: 0.8;
  }

  /* Comments indicator */
  :global(.mood-item-comments) {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 8px 3px 6px;
    font-size: 12px;
    background: hsl(var(--foreground) / 0.03);
    border-radius: 999px;
    color: hsl(var(--muted-foreground) / 0.7);
    transition: background-color 0.15s ease, color 0.15s ease;
    border: 1px solid transparent;
    text-decoration: none;
    cursor: pointer;
  }

  :global(.mood-item-comments:hover),
  :global(.mood-item-comments:focus-visible) {
    background: hsl(var(--foreground) / 0.06);
    color: hsl(var(--muted-foreground));
    border-color: hsl(var(--foreground) / 0.06);
  }

  :global(.mood-comments-icon) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
    opacity: 0.7;
    transition: opacity 0.15s ease;
  }

  :global(.mood-item-comments:hover .mood-comments-icon) {
    opacity: 1;
  }

  :global(.mood-comments-count) {
    font-size: 12px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  /* Floating expand button - appears on hover */
  :global(.mood-item-expand-float) {
    position: absolute;
    top: 12px;
    right: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: transparent;
    border-radius: 6px;
    color: hsl(var(--muted-foreground) / 0.4);
    text-decoration: none;
    cursor: pointer;
    opacity: 0;
    /* opacity for the card-hover reveal and :focus-visible, colour/background
       for its own hover, transform for the press. */
    transition:
      opacity 0.2s ease,
      color 0.2s ease,
      background 0.2s ease,
      transform 0.2s ease;
    z-index: 10;
  }

  :global(.mood-item:hover .mood-item-expand-float),
  :global(.mood-item-expand-float:focus-visible) {
    opacity: 1;
  }

  :global(.mood-item-expand-float:hover) {
    color: hsl(var(--foreground) / 0.7);
    background: hsl(var(--foreground) / 0.05);
  }

  :global(.mood-item-expand-float:active) {
    transform: scale(0.92);
  }

  :global(.mood-item-expand-float svg) {
    flex-shrink: 0;
  }

  /* Ensure mood-item has relative positioning for the float button */
  :global(.mood-item) {
    position: relative;
  }

  @media (min-width: 640px) {
    :global(.mood-item-expand-float) {
      right: 16px;
    }
  }

  @media (max-width: 640px) {
    :global(.mood-item-expand-float) {
      width: 24px;
      height: 24px;
      top: 8px;
      right: 6px;
      opacity: 0.6;
    }

    :global(.mood-item-expand-float svg) {
      width: 12px;
      height: 12px;
    }
  }

  /* Comments popover wrapper */
  :global(.mood-comments-wrapper) {
    position: relative;
    display: inline-flex;
  }

  :global(.mood-comments-wrapper.is-hidden) {
    display: none;
  }

  :global(.mood-comments-wrapper.is-popover-open) {
    z-index: 120;
  }

  :global(.mood-comments-popover) {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    width: min(var(--mood-comments-popover-width, 340px), calc(100vw - 24px));
    max-width: calc(100vw - 32px);
    max-height: min(var(--mood-comments-popover-max-height, 360px), calc(100vh - 24px));
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    background: hsl(var(--background) / 0.94);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    backdrop-filter: blur(20px) saturate(1.4);
    border: 1px solid hsl(var(--foreground) / 0.08);
    border-radius: 16px;
    box-shadow:
      0 14px 42px hsl(var(--foreground) / 0.14),
      0 2px 8px hsl(var(--foreground) / 0.04),
      inset 0 1px 0 hsl(var(--foreground) / 0.04);
    padding: 12px;
    opacity: 0;
    visibility: hidden;
    transform: translateX(-50%) translateY(4px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    z-index: 100;
    pointer-events: none;
    scrollbar-width: thin;
    scrollbar-color: hsl(var(--foreground) / 0.22) transparent;
  }

  :global(.mood-comments-popover[data-positioned="true"]) {
    position: fixed;
    top: var(--mood-comments-popover-top, 0);
    bottom: auto;
    left: var(--mood-comments-popover-left, 50vw);
  }

  :global(.mood-comments-popover[data-side="bottom"]) {
    transform: translateX(-50%) translateY(-4px);
  }

  :global(.mood-comments-popover::-webkit-scrollbar) {
    width: 8px;
  }

  :global(.mood-comments-popover::-webkit-scrollbar-track) {
    background: transparent;
  }

  :global(.mood-comments-popover::-webkit-scrollbar-thumb) {
    background: hsl(var(--foreground) / 0.18);
    border: 2px solid transparent;
    border-radius: 999px;
    background-clip: content-box;
  }

  /* The hover branch is split from the .is-popover-open branch and gated: on
     touch a tap fires a synthetic hover that would strand the popover open.
     The class branch stays ungated — it is the tap-to-open path itself. */
  @media (hover: hover) and (pointer: fine) {
    :global(.mood-comments-wrapper:hover .mood-comments-popover),
    :global(.mood-comments-popover:hover) {
      opacity: 1;
      visibility: visible;
      transform: translateX(-50%) translateY(0);
      pointer-events: auto;
    }
  }

  :global(.mood-comments-wrapper.is-popover-open .mood-comments-popover),
  :global(.mood-comments-popover.is-popover-open) {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }

  @media (hover: hover) and (pointer: fine) {
    :global(.mood-comments-popover[data-side="bottom"]:hover) {
      transform: translateX(-50%) translateY(0);
    }
  }

  :global(.mood-comments-wrapper.is-popover-open .mood-comments-popover[data-side="bottom"]),
  :global(.mood-comments-popover.is-popover-open[data-side="bottom"]) {
    transform: translateX(-50%) translateY(0);
  }

  :global(.mood-comments-popover::before) {
    content: '';
    position: absolute;
    bottom: -8px;
    left: var(--mood-comments-popover-arrow-left, 50%);
    transform: translateX(-50%);
    width: 16px;
    height: 8px;
    background: transparent;
  }

  :global(.mood-comments-popover[data-side="bottom"]::before) {
    top: -8px;
    bottom: auto;
  }

  :global(.mood-comments-popover-list) {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  :global(.mood-comments-popover-empty) {
    text-align: center;
    padding: 16px 8px;
    color: hsl(var(--muted-foreground) / 0.6);
    font-size: 13px;
    font-style: italic;
  }

  :global(.mood-comments-popover-loading) {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  :global(.mood-popover-comment) {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  :global(.mood-popover-comment-avatar) {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: linear-gradient(
      135deg,
      hsl(var(--foreground) / 0.1) 0%,
      hsl(var(--foreground) / 0.05) 100%
    );
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 600;
    color: hsl(var(--foreground) / 0.5);
    overflow: hidden;
  }

  :global(.mood-popover-comment-avatar img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(.mood-popover-comment-body) {
    flex: 1;
    min-width: 0;
    /* Read comments in sans, not the inherited site mono. */
    font-family: var(--font-sans);
    background: hsl(var(--foreground) / 0.04);
    border: 1px solid hsl(var(--foreground) / 0.05);
    border-radius: 14px;
    padding: 10px 12px;
  }

  :global(.mood-popover-comment-header) {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 4px;
    flex-wrap: wrap;
  }

  :global(.mood-popover-comment-author) {
    font-size: 12px;
    font-weight: 600;
    color: hsl(var(--foreground));
    letter-spacing: -0.01em;
  }

  :global(.mood-popover-comment-date) {
    font-size: 10px;
    color: hsl(var(--muted-foreground) / 0.5);
    font-variant-numeric: tabular-nums;
  }

  :global(.mood-popover-comment-date::before) {
    content: '•';
    margin-right: 6px;
    color: hsl(var(--muted-foreground) / 0.3);
  }

  :global(.mood-popover-comment-content) {
    font-size: 12px;
    line-height: 1.5;
    color: hsl(var(--foreground) / 0.9);
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  :global(.mood-popover-comment-content p) {
    margin: 0;
  }

  :global(.mood-popover-comment-content p + p) {
    margin-top: 0.5em;
