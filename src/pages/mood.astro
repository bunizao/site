---
import Layout from '../layouts/Layout.astro';
import TimelineWheel from '@/features/mood/ui/TimelineWheel.astro';
import FeedShell from '@/features/mood/ui/FeedShell.astro';
import SubscribePanel from '@/features/notify/SubscribePanel.astro';
// BackToTop is retired on the feed — the MoodNavbar avatar handles back-to-top
// now. Import left commented as a marker; the component is still used by
// /mood/[id]. See the commented render below.
// import BackToTop from '@/features/mood/ui/BackToTop.astro';
import MoodNavbar from '@/features/mood/ui/MoodNavbar.astro';
import {
  loadMoodFeed,
  normalizeMoodApiSource,
  resolveMoodReadSource,
} from '@/features/mood/server/api-client';
import {
  getMoodFeedAnchorBeforeCursor,
  getMoodFeedAnchorWindowBeforeCursor,
  readMoodFeedAnchorId,
} from '@/features/mood/shared/feed-anchor';
import { loadInitialMoodFeed as loadInitialMoodFeedWindow } from '@/features/mood/server/initial-feed-loader';
import { getMoodFeedPreloadImage } from '@/features/mood/shared/lcp-preload';
import { normalizeMoodTagSlug } from '@/features/mood/shared/tag-filter';
import { isE2ESiteFixtureEnabled } from '@/lib/e2e';
import { readEnv, readPublicEnv } from '@/lib/runtime/env';
import { profile } from '@/data/site';
import { formatSiteTitle } from '@/lib/seo';
import '@/styles/mood-gallery.css';
import '@/styles/listening.css';
import '@/styles/embed-youtube.css';

export const prerender = false;

const title = formatSiteTitle('Moods');
const description = `Short posts, photos, links, and moments from ${profile.name}'s Telegram channel.`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.url.origin).href;
const moodAlternateUrl = new URL(canonicalUrl);
const rssHref = '/mood/rss.xml';
const rss = { href: rssHref, title: 'Moods RSS' };
const oembed = { href: `/api/oembed.json?url=${encodeURIComponent(moodAlternateUrl.href)}`, title: 'Mood Embed' };
const turnstileSiteKey = isE2ESiteFixtureEnabled(Astro.locals)
  ? ''
  : readPublicEnv(Astro.locals, 'TURNSTILE_SITE_KEY');
const moodTagFilter = normalizeMoodTagSlug(Astro.url.searchParams.get('tag'));
// Tag mode is a plain filtered feed: no anchor deep links, archive reads only.
const moodFeedAnchorId = moodTagFilter ? '' : readMoodFeedAnchorId(Astro.url);
const moodFeedAnchorBeforeCursor = getMoodFeedAnchorBeforeCursor(moodFeedAnchorId);
const moodFeedAnchorWindowBeforeCursor = getMoodFeedAnchorWindowBeforeCursor(moodFeedAnchorId);
const requestedMoodReadSource = normalizeMoodApiSource(Astro.url.searchParams.get('source')) ?? undefined;
const moodReadSource = moodTagFilter ? 'archive' : resolveMoodReadSource(Astro.locals, requestedMoodReadSource);
const moodReadFresh = Astro.url.searchParams.has('fresh') || Astro.url.searchParams.has('refresh');

async function loadInitialMoodFeed() {
  if (isE2ESiteFixtureEnabled(Astro.locals)) return null;

  const context = { request: Astro.request, locals: Astro.locals };

  try {
    const result = await loadInitialMoodFeedWindow({
      anchorId: moodFeedAnchorId,
      focusedBefore: moodFeedAnchorWindowBeforeCursor,
      fallbackBefore: moodFeedAnchorBeforeCursor,
      loadFeed: (query) => loadMoodFeed(context, {
        ...query,
        fresh: moodReadFresh,
        source: moodReadSource,
        ...(moodTagFilter ? { tag: moodTagFilter, fallback: false } : {}),
      }),
    });
    if (!result.cacheable) {
      Astro.response.headers.set('Cache-Control', 'no-store');
    }
    return result.value;
  } catch (error) {
    console.warn('Failed to load initial mood feed:', error);
    return null;
  }
}

const initialFeed = await loadInitialMoodFeed();
// The feed mirrors a Telegram channel, so subscribing there is a real
// alternative to email. The slug is the channel username; without it the
// subscribe panel just drops the tile.
const channelSlug = initialFeed?.channel?.slug?.trim() || readEnv(Astro.locals, 'CHANNEL');
const telegramHref = channelSlug ? `https://t.me/${channelSlug}` : undefined;
// Preload the exact media the priority feed element will render (see
// getMoodFeedPreloadImage): aligns the high-priority fetch with the real LCP.
const preloadImage = initialFeed
  ? getMoodFeedPreloadImage(initialFeed.posts, moodFeedAnchorId)
  : null;
const preloadImages = preloadImage
  ? [{
      href: preloadImage.href,
      imageSrcSet: preloadImage.imageSrcSet,
      imageSizes: preloadImage.imageSizes,
    }]
  : [];
// Skeleton structure: 2 date group cards to match actual content layout
const skeletonGroups = [
  {
    index: 0,
    dateWidth: '52px', // "Today" length
    items: [
      { index: 0, lineWidth: '72%' },
      { index: 1, lineWidth: '58%' },
      { index: 2, lineWidth: '66%' },
    ],
  },
  {
    index: 1,
    dateWidth: '76px', // "Yesterday" length
    items: [
      { index: 0, lineWidth: '64%' },
      { index: 1, lineWidth: '70%' },
    ],
  },
];
---

<Layout
  preloadFont={['code', 'mono', 'sans']}
  title={title}
  description={description}
  image="/mood-og.png"
  imageAlt="Levitating — think, write, whisper"
  rss={rss}
  oembed={oembed}
  preloadImages={preloadImages}
  hideSiteNav
  containedScroll
  scrollRestorationKey="mood-scroll"
>
  <!-- Mood owns its own top chrome: the default site nav + global header
       actions are hidden (via the scoped rule below) and replaced by
       MoodNavbar, a borderless progressive-blur bar with the docked channel
       identity plus search + notify. -->
  <MoodNavbar slot="topbar" initialChannel={initialFeed?.channel} />
  <main class="page-container mood-route">
    <TimelineWheel />
    <FeedShell
      skeletonGroups={skeletonGroups}
      initialPosts={initialFeed?.posts ?? []}
      initialChannel={initialFeed?.channel}
      anchorId={moodFeedAnchorId}
      readSource={moodReadSource}
      tagFilter={moodTagFilter}
    />
  </main>
  <SubscribePanel variant="mood" id="mood" anchor="right" withTrigger={false} feed={rssHref} telegram={telegramHref} turnstileSiteKey={turnstileSiteKey} />
  {/* Back-to-top is now the MoodNavbar avatar (click it to return to the top),
      so the floating button is retired on the feed. The component itself is kept
      — /mood/[id] still renders it — just no longer referenced here. */}
  {/* <BackToTop hideOnDesktop /> */}
</Layout>

<style>
  /* Mood renders its own MoodNavbar, so the layout's default site nav and
     global header actions are hidden on this route. Scoped via :has so it only
     applies to the feed page and never leaks to the rest of the site. */
  :global(body:has(main.mood-route) [data-header-actions]) {
    display: none !important;
  }

  :global(.mood-route) {
    font-family: var(--font-sans);
  }

  /* Loading State - Card-based Skeleton */
  :global(.mood-loading) {
    display: block;
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
  }

  :global(.mood-loading.is-hidden) {
    display: none;
  }

  :global(.mood-skeleton-stream) {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  @media (min-width: 640px) {
    :global(.mood-skeleton-stream) {
      gap: 48px;
    }
  }

  :global(.mood-skeleton-group) {
    background: hsl(var(--background));
    border-radius: 12px;
    padding: 20px;
    border: 1px solid hsl(var(--foreground) / 0.06);
    box-shadow: 0 1px 0 hsl(var(--foreground) / 0.03);
    --group-delay: calc(var(--group-index, 0) * 0.15s);
  }

  @media (min-width: 640px) {
    :global(.mood-skeleton-group) {
      padding: 24px;
      border-radius: 16px;
    }
  }

  /* Skeleton Header */
  :global(.mood-skeleton-header) {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
  }

  @media (min-width: 640px) {
    :global(.mood-skeleton-header) {
      margin-bottom: 24px;
    }
  }

  :global(.mood-skeleton-date) {
    display: block;
    width: var(--date-width, 60px);
    height: 12px;
    background: hsl(var(--foreground) / 0.06);
    border-radius: 4px;
    position: relative;
    overflow: hidden;
  }

  :global(.mood-skeleton-date::after) {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      hsl(var(--foreground) / 0.08) 50%,
      transparent 100%
    );
    animation: skeleton-shimmer 2s ease-in-out infinite;
    animation-delay: var(--group-delay);
  }

  :global(.mood-skeleton-header-line) {
    flex: 1;
    height: 1px;
    background: hsl(var(--foreground) / 0.08);
  }

  /* Skeleton Items */
  :global(.mood-skeleton-items) {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  :global(.mood-skeleton-item) {
    display: flex;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid hsl(var(--foreground) / 0.04);
    --item-delay: calc(var(--group-delay) + var(--item-index, 0) * 0.08s);
  }

  :global(.mood-skeleton-item:last-child) {
    border-bottom: none;
    padding-bottom: 4px;
  }

  @media (min-width: 640px) {
    :global(.mood-skeleton-item) {
      padding: 18px 0;
      gap: 18px;
    }
  }

  @media (max-width: 640px) {
    :global(.mood-skeleton-item) {
      flex-direction: column;
      gap: 8px;
    }
  }

  :global(.mood-skeleton-time) {
    display: block;
    width: 36px;
    height: 12px;
    background: hsl(var(--foreground) / 0.05);
    border-radius: 4px;
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
  }

  :global(.mood-skeleton-time::after) {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      hsl(var(--foreground) / 0.06) 50%,
      transparent 100%
    );
    animation: skeleton-shimmer 2s ease-in-out infinite;
    animation-delay: var(--item-delay);
  }

  @media (min-width: 640px) {
    :global(.mood-skeleton-time) {
      width: 40px;
    }
  }

  :global(.mood-skeleton-content) {
    flex: 1;
    min-width: 0;
  }

  :global(.mood-skeleton-line) {
    display: block;
    width: var(--line-width, 70%);
    height: 14px;
    background: hsl(var(--foreground) / 0.05);
    border-radius: 6px;
    position: relative;
    overflow: hidden;
  }

  :global(.mood-skeleton-line::after) {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      hsl(var(--foreground) / 0.08) 50%,
      transparent 100%
    );
    animation: skeleton-shimmer 2s ease-in-out infinite;
    animation-delay: var(--item-delay);
  }

  @keyframes skeleton-shimmer {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.mood-skeleton-date::after),
    :global(.mood-skeleton-time::after),
    :global(.mood-skeleton-line::after) {
      animation: none;
    }
  }

  /* Inline Loading for Load More */
  :global(.mood-loading-inline) {
    display: flex;
    flex-direction: column;
    padding: 16px 0;
  }

  :global(.mood-loading-inline .mood-skeleton-group) {
    opacity: 0.7;
  }

  /* Error State */
  .mood-error {
    padding: 60px 0;
    text-align: center;
  }

  .mood-error.is-hidden {
    display: none;
  }

  /* Feed Hidden State */
  .mood-feed.is-hidden {
    display: none;
  }

  /* Stream Layout */
  :global(.mood-stream) {
    display: flex;
    flex-direction: column;
    gap: 40px;
    width: 100%;
    max-width: 680px;
    min-width: 0;
    margin: 0 auto;
  }

  @media (min-width: 640px) {
    :global(.mood-stream) {
      gap: 48px;
    }
  }

  @media (min-width: 1024px) {
    :global(.mood-stream) {
      gap: 56px;
      max-width: 720px;
    }
  }

  /* Date Group */
  :global(.mood-date-group) {
    display: flex;
    flex-direction: column;
    gap: 0;
    background: hsl(var(--background));
    border-radius: 12px;
    padding: 20px;
    border: 1px solid hsl(var(--foreground) / 0.06);
    box-shadow: 0 1px 0 hsl(var(--foreground) / 0.03);
    width: 100%;
    max-width: 100%;
    min-width: 0;
    contain: content;
  }

  @media (min-width: 640px) {
    :global(.mood-date-group) {
      padding: 24px;
      border-radius: 16px;
    }
  }

  @media (min-width: 1024px) {
    :global(.mood-date-group) {
      padding: 28px;
    }
  }

  :global(.mood-date-header) {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
    padding-top: 0;
  }

  @media (min-width: 640px) {
    :global(.mood-date-header) {
      margin-bottom: 24px;
    }
  }

  :global(.mood-date-text) {
    font-size: 12px;
    font-weight: 500;
    color: hsl(var(--muted-foreground));
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
    padding-right: 4px;
  }

  :global(.mood-date-line) {
    flex: 1;
    height: 1px;
    background: hsl(var(--foreground) / 0.1);
  }

  :global(.mood-date-items) {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding-left: 0;
    min-width: 0;
  }

  /* Mood Item - Stream Style */
  :global(.mood-item) {
    display: flex;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid hsl(var(--foreground) / 0.04);
    position: relative;
  }

  :global(.mood-item:hover),
  :global(.mood-item:focus-within) {
    z-index: 2;
  }

  :global(.mood-item--comments-open) {
    z-index: 30;
  }

  :global(.mood-item--anchored) {
    isolation: isolate;
  }

  :global(.mood-item--anchored)::before {
    content: '';
    position: absolute;
    inset: 4px -12px;
    border-radius: 12px;
    background-color: transparent;
    animation: mood-anchor-flash 1800ms cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
    z-index: -1;
  }

  @keyframes mood-anchor-flash {
    0% {
      background-color: transparent;
    }

    20%,
    60% {
      background-color: hsl(var(--foreground) / 0.05);
    }

    100% {
      background-color: transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.mood-item--anchored)::before {
      animation: none;
      background-color: hsl(var(--foreground) / 0.05);
    }
  }

  @media (min-width: 640px) {
    :global(.mood-item) {
      padding: 18px 0;
      gap: 18px;
    }
  }

  @media (max-width: 640px) {
    :global(.mood-item) {
      flex-direction: column;
      gap: 10px;
    }

    :global(.mood-item-time) {
      min-width: 0;
      padding-top: 0;
      font-size: 12px;
      line-height: 1.35;
    }

    :global(.mood-item-content) {
      gap: 10px;
    }

    :global(.mood-item-content--media-only) {
      width: 100%;
      max-width: 100%;
      padding-right: 0;
    }

    :global(.mood-item--clickable) {
      margin: 0;
      padding: 14px 0;
    }
  }

  :global(.mood-item:last-child) {
    border-bottom: none;
    padding-bottom: 4px;
  }

  :global(.mood-item--clickable) {
    text-decoration: none;
    color: inherit;
    border-radius: 10px;
    margin: 0 -12px;
    padding: 16px 12px;
    border-bottom: none;
    transition: color 0.15s ease;
    cursor: pointer;
  }

  @media (min-width: 640px) {
    :global(.mood-item--clickable) {
      margin: 0 -16px;
      padding: 18px 16px;
      border-radius: 12px;
    }
  }

  :global(.mood-item--clickable + .mood-item) {
    border-top: none;
  }

  :global(.mood-item-time) {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1, 'zero' 1;
    min-width: 46px;
    padding-top: 2px;
    line-height: 1.5;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    :global(.mood-item-time) {
      min-width: 46px;
    }
  }

  :global(.mood-item-content) {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-right: 0;
  }

  :global(.mood-item-content--media-only) {
    flex: 0 1 auto;
    width: min(100%, 340px);
    max-width: min(100%, 340px);
    padding-right: 24px;
    align-self: flex-start;
  }

  @media (min-width: 640px) {
    :global(.mood-item-content) {
      gap: 12px;
      padding-right: 32px;
    }

    :global(.mood-item-content--media-only) {
      width: min(100%, 380px);
      max-width: min(100%, 380px);
    }
  }

  :global(.mood-item-forwarded) {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px;
    font-size: 11px;
    color: hsl(var(--muted-foreground));
  }

  :global(.mood-forwarded-label) {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 10px;
    line-height: 1.2;
    color: hsl(var(--muted-foreground) / 0.7);
  }

  :global(.mood-forwarded-source) {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    font-weight: 500;
    line-height: 1.2;
    color: hsl(var(--foreground) / 0.85);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  :global(.mood-forwarded-source:hover),
  :global(.mood-forwarded-source:focus-visible) {
    border-bottom-color: hsl(var(--foreground) / 0.35);
  }

  :global(.mood-forwarded-author) {
    line-height: 1.2;
    color: hsl(var(--muted-foreground) / 0.7);
  }

  :global(.mood-item-media) {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  :global(.mood-item-media video) {
    width: 100%;
    max-width: 100%;
    max-height: min(52vh, 400px);
    height: auto;
    display: block;
    border-radius: 12px;
    background: transparent;
    overflow: clip;
    clip-path: inset(0 round 12px);
  }

  /* Portrait videos (aspect ratio < 0.8) */
  :global(.mood-item-media video.video--portrait) {
    width: min(100%, clamp(220px, 52vw, 320px));
    max-width: 100%;
    max-height: min(58vh, 460px);
    margin: 0;
  }

  /* Ultra-tall videos (aspect ratio < 0.6) */
  :global(.mood-item-media video.video--ultra-tall) {
    width: min(100%, clamp(200px, 44vw, 280px));
    max-width: 100%;
    max-height: min(62vh, 500px);
    margin: 0;
  }

  :global(.mood-item-media audio) {
    width: 100%;
  }

  :global(.mood-item-media .tgme_widget_message_document_wrap) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border: 1px solid hsl(var(--foreground) / 0.1);
    border-radius: 10px;
    background: hsl(var(--background));
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease;
  }

  :global(.mood-item-media .tgme_widget_message_document_wrap:hover) {
    border-color: hsl(var(--foreground) / 0.18);
  }

  :global(.mood-item-media .tgme_widget_message_document_icon) {
    --mood-document-file-icon: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='24'%20height='24'%20viewBox='0%200%2024%2024'%20fill='none'%20stroke='black'%20stroke-width='2'%20stroke-linecap='round'%20stroke-linejoin='round'%3E%3Cpath%20d='M15%202H6a2%202%200%200%200-2%202v16a2%202%200%200%200%202%202h12a2%202%200%200%200%202-2V7Z'/%3E%3Cpath%20d='M14%202v4a2%202%200%200%200%202%202h4'/%3E%3Cpath%20d='M10%209H8'/%3E%3Cpath%20d='M16%2013H8'/%3E%3Cpath%20d='M16%2017H8'/%3E%3C/svg%3E");
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: hsl(var(--foreground) / 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    position: relative;
  }

  :global(.mood-item-media .tgme_widget_message_document_icon:not(.audio)::before) {
    content: '';
    width: 54%;
    height: 54%;
    background: hsl(var(--foreground) / 0.72);
    -webkit-mask: var(--mood-document-file-icon) center / contain no-repeat;
    mask: var(--mood-document-file-icon) center / contain no-repeat;
  }

  :global(.mood-item-media .tgme_widget_message_document_icon.audio::before) {
    content: '';
    border-left: 8px solid hsl(var(--foreground) / 0.7);
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
    margin-left: 2px;
  }

  :global(.mood-item-media .tgme_widget_message_document) {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  :global(.mood-item-media .tgme_widget_message_document_title) {
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
  }

  :global(.mood-item-media .tgme_widget_message_document_extra) {
    font-size: 12px;
    color: hsl(var(--muted-foreground));
    line-height: 1.4;
  }

  :global(.mood-item-media .tgme_widget_message_location_wrap) {
    display: block;
    width: min(100%, 360px);
    border: 1px solid hsl(var(--foreground) / 0.1);
    border-radius: 12px;
    background: hsl(var(--background));
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  :global(.mood-item-media .tgme_widget_message_location_wrap:hover) {
    border-color: hsl(var(--foreground) / 0.18);
  }

  :global(.mood-item-media .tgme_widget_message_location) {
