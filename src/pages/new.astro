---
// /new — the desk. A prototype of the next home page: one screen, prose on
// the left and an easel on the right holding a palette knife painting of the
// desk itself. Every coloured word in the prose is a thing in the painting;
// pointing at one lifts it off the table, and opening one paints its section
// onto the canvas. Where a real page exists the opener is a link to it, so a
// modified click, a crawler or a script failure still lands somewhere.
//
// Unlisted while it is a prototype: noindex, and nothing links here.
import { Activity, BookOpen, Disc3, LayoutGrid, Volume2, VolumeX } from 'lucide-react';
import Layout from '@/layouts/Layout.astro';
import Listening from '@/features/home/ui/Listening.astro';
import Badge from '@/features/desk/ui/Badge.astro';
import Contents from '@/features/desk/ui/Contents.astro';
import Door from '@/features/desk/ui/Door.astro';
import Easel, { type EaselSection } from '@/features/desk/ui/Easel.astro';
import Letter from '@/features/desk/ui/Letter.astro';
import MoodChannel from '@/features/desk/ui/MoodChannel.astro';
import Panel from '@/features/desk/ui/Panel.astro';
import Subscribe from '@/features/desk/ui/Subscribe.astro';
import Turntable from '@/features/desk/ui/Turntable.astro';
import GitHub from '@/features/desk/ui/GitHub.astro';
import Works from '@/features/desk/ui/Works.astro';
import { loadDeskContent } from '@/features/desk/server/content';
import { GitHubIcon, InstagramIcon, MonashCrestIcon, TelegramIcon } from '@/components/icons';
import { copyrightMark, experience, footer, profile, projects } from '@/data/site';
import { DESK_FAVICON } from '@/lib/favicon';
import { isE2ESiteFixtureEnabled } from '@/lib/e2e';
import { readTurnstileSiteKey } from '@/lib/turnstile-site-key';
import '@/features/desk/styles/desk.css';

// Request-time, for the latest moods and posts.
export const prerender = false;

const content = await loadDeskContent({ request: Astro.request, locals: Astro.locals });
const turnstileSiteKey = isE2ESiteFixtureEnabled(Astro.locals) ? '' : readTurnstileSiteKey(Astro.locals);

const firstName = profile.name.split(' ')[0];
const external = { target: '_blank', rel: 'noopener noreferrer' };
const linkOf = (name: string) => profile.links.find((link) => link.name === name)?.url ?? '#';

// One hue per section: its word in the prose, its thing in the painting, its
// tab, and the coat the canvas takes when it opens.
const sections: EaselSection[] = [
  {
    id: 'projects',
    tab: 'projects',
    title: 'Projects',
    date: '2023–ongoing',
    medium: `TypeScript on GitHub, ${projects.length} works`,
    hue: 92,
    chroma: 0.1,
    href: '/projects',
    thing: 'Projects: the small works on the wall',
    panel: true,
  },
  {
    id: 'about',
    tab: 'about',
    title: 'Self-portrait as a student card',
    date: '2024',
    medium: 'PVC and pearl foil, Monash University',
    hue: 285,
    chroma: 0.07,
    thing: 'About me: the student card on the wall',
    panel: true,
  },
  {
    id: 'writing',
    tab: 'writing',
    title: 'Writing',
    date: 'ongoing',
    medium: `Ink on Ghost, ${content.postCount} entries`,
    hue: 250,
    chroma: 0.07,
    href: '/blog',
    thing: 'Writing: the stack of books',
    panel: true,
  },
  {
    id: 'moods',
    tab: 'moods',
    title: 'Moods',
    date: 'daily',
    medium: 'Telegram on glass, short thoughts',
    hue: 45,
    chroma: 0.09,
    href: '/mood',
    thing: 'Moods: the cup of coffee',
    panel: true,
  },
  {
    id: 'listening',
    tab: 'listening',
    title: 'A song on repeat',
    date: 'right now',
    medium: 'Sound, duration variable',
    hue: 350,
    chroma: 0.07,
    thing: 'Listening: the record',
    panel: true,
  },
  {
    id: 'github',
    tab: 'github',
    title: 'Contributions',
    date: 'the last year',
    medium: 'Green on grey, daily',
    hue: 150,
    chroma: 0.08,
    href: 'https://github.com/bunizao',
    thing: 'GitHub: the plant',
    panel: true,
  },
  {
    id: 'clock',
    tab: 'clock',
    title: 'Desk clock',
    date: 'Melbourne, always now',
    medium: 'Seven segments of oil, kept wet',
    hue: 84,
    chroma: 0.12,
    thing: 'A desk clock showing the time in Melbourne',
  },
  {
    id: 'lamp',
    tab: 'lamp',
    title: 'Pendant lamp',
    date: 'after dark',
    medium: 'Enamel and brass, on a pull chain',
    hue: 165,
    chroma: 0.06,
    thing: 'The lamp over the desk, which turns the page to night',
  },
  {
    id: 'note',
    tab: 'note',
    title: 'Letter, unanswered',
    date: 'any day',
    medium: 'Paper, waiting for yours',
    hue: 20,
    chroma: 0.1,
    href: '/message',
    thing: 'Leave me a note: the letter',
    panel: true,
  },
  // Not in the painting: the gallery label opens it, and it has no tab.
  {
    id: 'colophon',
    title: 'Colophon',
    date: '2023–ongoing',
    medium: 'Astro and React on Cloudflare Workers',
    hue: 75,
    chroma: 0.03,
    href: footer.links[0].url,
    thing: 'How this site is made',
    panel: true,
  },
];

// How the site is made, and where the rest of it is.
const colophon = [
  { title: 'Source', sub: 'This site, on GitHub', href: footer.links[0].url, icon: GitHubIcon, external: true },
  { title: 'Docs', sub: 'How it is built, and every route', href: '/docs', icon: BookOpen },
  { title: 'Components', sub: 'The parts it is made of', href: '/components', icon: LayoutGrid },
  { title: 'Status', sub: 'Whether it is up', href: footer.statusUrl, icon: Activity, external: true },
];

const byId = new Map(sections.map((section) => [section.id, section]));
// The chips in reading order, which their paint is laid behind on arrival.
const READING = ['projects', 'about', 'writing', 'moods', 'listening', 'github', 'note'];
const tone = (id: string) => `--h: ${byId.get(id)?.hue}; --c: ${byId.get(id)?.chroma}; --i: ${READING.indexOf(id)}`;
const opens = (id: string) => ({ 'data-open': id, 'aria-controls': `easel-${id}`, style: tone(id) });
---

<Layout
  title={`${profile.name} — desk`}
  description={`${profile.name}'s desk: projects, writing, moods and the rest, on one page.`}
  url="/new"
  robots="noindex"
  image="/desk/og.jpg"
  favicon={DESK_FAVICON}
  touchIcon="/desk/touch-icon.png"
  hideSiteNav
>
  <script slot="head" is:inline>
    // A reload or a step back finds the desk already set: no arrival (desk.css).
    if (/^(reload|back_forward)$/.test(performance.getEntriesByType('navigation')[0]?.type ?? '')) {
      document.documentElement.classList.add('desk-set');
    }
  </script>
  <button slot="header-actions" class="header-action-btn desk-sound" type="button" data-sound aria-pressed="true" aria-label="Sound">
    <Volume2 className="desk-sound-on" aria-hidden="true" />
    <VolumeX className="desk-sound-off" aria-hidden="true" />
  </button>

  <main class="desk" data-desk>
    <div class="desk-left">
      <h1 class="sr-only">{profile.name}</h1>
      <div class="desk-prose">
        <p>
          Hi, I'm {firstName}. I make interesting things<span class="desk-note">, orchestrating AI agents from an idea all
          the way to a product.</span> The ones I'm proud of are in
          <a class="desk-chip" href="/projects" {...opens('projects')}>projects</a>.
        </p>
        <p>
          I study computer science at
          <button class="desk-chip" type="button" {...opens('about')}><MonashCrestIcon className="desk-icon desk-icon-crest" />Monash</button><span class="desk-note"> in Melbourne.</span>
          I <a class="desk-chip" href="/blog" {...opens('writing')}>write</a> about being alive, and shorter thoughts go to
          <a class="desk-chip" href="/mood" {...opens('moods')}>moods</a>.
          <span class="desk-note">There's usually</span>
          <button class="desk-chip" type="button" {...opens('listening')}><Disc3 className="desk-icon" data-turn aria-hidden="true" />a song</button>
          <span class="desk-note">on repeat, and too many tabs open on</span>
          <a class="desk-chip" href="https://github.com/bunizao" {...opens('github')}><GitHubIcon className="desk-icon" />GitHub</a><span class="desk-note">. Elsewhere, I'm on</span>
          <a class="desk-link" href={linkOf('Telegram')} {...external}><TelegramIcon className="desk-icon" />Telegram</a>
          <span class="desk-note">and</span>
          <a class="desk-link" href={linkOf('Instagram')} {...external}><InstagramIcon className="desk-icon" />Instagram</a><span class="desk-note">.</span>
        </p>
        <p class="desk-cta">
          <span class="desk-note">Everything in the painting opens. Or just</span>
          <a class="desk-chip" href="/message" {...opens('note')}>leave me a note</a><span class="desk-note">.</span>
        </p>
      </div>
    </div>

    <Easel sections={sections} painting={{ title: 'Still life with a desk', date: '2026', medium: 'Palette knife on canvas element' }}>
      <Panel id="projects">
        <Works />
        <Door href="/projects" label="All projects" style={tone('projects')} />
      </Panel>

      <Panel id="about">
        <div class="ab">
          <div class="ab-badge"><Badge /></div>
          <div class="easel-paper">
            <ul class="paper-rows">
              {experience.map((item) => (
                <li>
                  <a class="paper-row" href={item.url} {...external}>
                    <span class="paper-row-icon" aria-hidden="true"><item.icon className="paper-row-glyph" strokeWidth={item.strokeWidth} /></span>
                    <span class="paper-row-main">
                      <span class="paper-row-title">{item.org}</span>
                      <span class="paper-row-sub">{item.description ?? item.role}</span>
                    </span>
                    <span class="paper-row-end">{item.period.replace(' — Present', ' –')}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </Panel>

      <Panel id="writing">
        <Contents posts={content.posts} total={content.postCount} writing={content.writing} />
        <Door href="/blog" label="Read the blog" style={tone('writing')}>
          <Subscribe channel="blog" turnstileSiteKey={turnstileSiteKey} subscriberCount={content.subscribers?.channels.blog} />
        </Door>
      </Panel>

      <Panel id="moods">
        <MoodChannel moods={content.moods} channel={content.channel} links />
        <Door href="/mood" label="All moods" style={tone('moods')}>
          <Subscribe channel="mood" turnstileSiteKey={turnstileSiteKey} subscriberCount={content.subscribers?.channels.mood} />
        </Door>
      </Panel>

      <Panel id="listening">
        <div class="lp">
          <Turntable />
          <div class="easel-paper"><Listening /></div>
        </div>
        {content.listening && (
          <p class="tally">
            Played here <strong>{content.listening.totals.plays.toLocaleString('en-US')}</strong> {content.listening.totals.plays === 1 ? 'time' : 'times'} in the past seven days{content.listening.topArtist ? (
              <>; most often <strong>{content.listening.topArtist.name}</strong>.</>
            ) : '.'}
          </p>
        )}
      </Panel>

      <Panel id="github">
        <div class="easel-paper gh"><GitHub week={content.github} /></div>
        <Door href="https://github.com/bunizao" label="bunizao on GitHub" style={tone('github')} external />
      </Panel>

      <Panel id="note">
        <Letter to={firstName} turnstileSiteKey={turnstileSiteKey} style={tone('note')} />
      </Panel>

      <Panel id="colophon" label="Colophon">
        <div class="easel-paper colophon">
          <p class="colophon-note">
            The still life is laid on with a palette knife in a canvas element, fresh in your browser on every visit,
            by day and by night. The rest is Astro and React, served from Cloudflare's edge.
          </p>
          <ul class="paper-rows">
            {colophon.map((row) => (
              <li>
                <a class="paper-row" href={row.href} {...(row.external ? external : {})}>
                  <span class="paper-row-icon" aria-hidden="true"><row.icon className="paper-row-glyph" /></span>
                  <span class="paper-row-main">
                    <span class="paper-row-title">{row.title}</span>
                    <span class="paper-row-sub">{row.sub}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </Panel>
    </Easel>

    <footer class="desk-foot">
      {copyrightMark(new Date().getFullYear())}<span class="desk-foot-dot" aria-hidden="true">·</span><a href="/privacy">privacy</a>
    </footer>
  </main>
</Layout>

<script>
  import '@/features/desk/client/desk';
</script>
