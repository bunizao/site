---
import type { CvLang } from '@bunizao/contracts';
import { getCv } from '@/features/cv/server/api-client';
import { CV_STRINGS, pick } from '@/features/cv/copy';
import CvDocument from '@/features/cv/ui/CvDocument.astro';
import '@/styles/globals.css';
import '@/features/cv/styles/cv.css';

export const prerender = false;

// The print route is what Browser Rendering loads to make the PDF. It is gated
// exactly like the full `/cv` read (token or Access) and NEVER renders the
// redacted view — if the read comes back public, we 404 rather than leak a
// half-résumé into a PDF.
const rawLang = Astro.url.searchParams.get('lang');
const lang: CvLang = rawLang === 'zh' ? 'zh' : 'en';
const key = Astro.url.searchParams.get('key')
  ?? Astro.cookies.get('cv_full')?.value
  ?? undefined;

const cv = await getCv(
  { request: Astro.request, locals: Astro.locals },
  { lang, full: true, key },
);

if (!cv.full) {
  return new Response('Not found', { status: 404 });
}

Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
Astro.response.headers.set('Cache-Control', 'private, no-store');

const t = CV_STRINGS[lang];
const title = `${pick(cv.identity.displayName, lang)} — ${t.eyebrow}`;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <style is:global>
      /* Print/PDF is always black-on-white regardless of the viewer's theme —
         pin the light-mode tokens so every hsl(var(--…)) resolves to ink. */
      :root {
        --background: 0 0% 100%;
        --foreground: 0 0% 0%;
        --card: 0 0% 100%;
        --card-foreground: 0 0% 0%;
        --secondary: 0 0% 96%;
        --muted: 0 0% 38%;
        --primary: 0 0% 0%;
        --primary-foreground: 0 0% 100%;
        --border: 0 0% 0%;
        --ring: 0 0% 0%;
        color-scheme: light;
      }

      /* Self-hosted CJK face for the zh PDF — Browser Rendering's Chromium has
         no bundled CJK coverage, so system fonts would render tofu. Drop the
         full-weight woff2 at this path before shipping the PDF pipeline (B6);
         until then the zh screen preview falls back to the OS CJK font. */
      @font-face {
        font-family: 'CV CJK';
        src: url('/fonts/cv-cjk.woff2') format('woff2');
        font-weight: 100 900;
        font-display: swap;
        unicode-range: U+2E80-9FFF, U+3000-303F, U+FF00-FFEF;
      }

      html,
      body {
        margin: 0;
        background: #fff;
        color: #000;
      }

      .cv-print {
        --cv-spine: 7rem;
        --cv-gap: 2rem;
        max-width: 210mm;
        padding: 0 14mm;
        margin: 0 auto;
      }

      /* No entrance motion in a one-shot render. */
      .cv-print .cv-reveal {
        opacity: 1 !important;
        animation: none !important;
        transform: none !important;
      }

      /* The sticky spine label is a screen affordance; pin it in flow for print. */
      .cv-print .cv-section__label {
        position: static;
      }

      /* Font stack: reading = Inter + CJK; spine keeps mono + CJK fallback. */
      .cv-print :where(.cv-name, .cv-headline, .cv-summary, .cv-entry__role,
        .cv-entry__summary, .cv-highlights li, .cv-project__name, .cv-project__desc,
        .cv-skill-group__items) {
        font-family: 'Inter', 'CV CJK', ui-sans-serif, system-ui, sans-serif;
      }

      @page {
        size: A4;
        margin: 14mm 0;
      }

      @media print {
        .cv-print .cv-entry,
        .cv-print .cv-section {
          break-inside: avoid;
        }
      }
    </style>
  </head>
  <body>
    <main class="cv-page cv-print" data-lang={lang} lang={lang}>
      <CvDocument cv={cv} lang={lang} showRequest={false} />
    </main>
  </body>
</html>
