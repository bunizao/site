---
import type { CvLang } from '@bunizao/contracts';
import { getCv } from '@/features/cv/server/api-client';
import { CV_STRINGS, pick } from '@/features/cv/copy';
import CvDocument from '@/features/cv/ui/CvDocument.astro';
import '@/styles/globals.css';
import '@/features/cv/styles/cv.css';

export const prerender = false;

// The print route is what Browser Rendering loads to make the PDF. It is gated
// exactly like the full `/cv` read (token or Access) and NEVER renders the
// redacted view — if the read comes back public, we 404 rather than leak a
// half-résumé into a PDF.
const rawLang = Astro.url.searchParams.get('lang');
const lang: CvLang = rawLang === 'zh' ? 'zh' : 'en';
const key = Astro.url.searchParams.get('key')
  ?? Astro.cookies.get('cv_full')?.value
  ?? undefined;

const cv = await getCv(
  { request: Astro.request, locals: Astro.locals },
  { lang, full: true, key },
);

if (!cv.full) {
  return new Response('Not found', { status: 404 });
}

Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
Astro.response.headers.set('Cache-Control', 'private, no-store');

const t = CV_STRINGS[lang];
const title = `${pick(cv.identity.displayName, lang)} — ${t.eyebrow}`;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <style is:global>
      /* Print/PDF is always black-on-white regardless of the viewer's theme —
         pin the light-mode tokens so every hsl(var(--…)) resolves to ink. */
      :root {
        --background: 0 0% 100%;
        --foreground: 0 0% 0%;
        --card: 0 0% 100%;
        --card-foreground: 0 0% 0%;
        --secondary: 0 0% 96%;
        --muted: 0 0% 38%;
        --primary: 0 0% 0%;
        --primary-foreground: 0 0% 100%;
        --border: 0 0% 0%;
        --ring: 0 0% 0%;
        color-scheme: light;
      }

      /* Self-hosted CJK face for the zh PDF — Browser Rendering's Chromium has
         no bundled CJK coverage, so system fonts would render tofu. Drop the
         full-weight woff2 at this path before shipping the PDF pipeline (B6);
         until then the zh screen preview falls back to the OS CJK font. */
      @font-face {
        font-family: 'CV CJK';
        src: url('/fonts/cv-cjk.woff2') format('woff2');
        font-weight: 100 900;
        font-display: swap;
        unicode-range: U+2E80-9FFF, U+3000-303F, U+FF00-FFEF;
      }

      /* Blue ink accent, light value (print is always light). */
      .cv-zone { --cv-accent: #3C5D80; }

      html,
      body {
        margin: 0;
        /* On screen the print route reads as a real sheet of paper sitting on a
           grey desk; @media print flattens it back to plain white. */
        background: #e9e8e4;
        color: #000;
      }

      .cv-print {
        width: 210mm;
        min-height: 297mm;
        margin: 12mm auto;
        padding: 16mm 16mm 20mm;
        background: #fff;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08), 0 14px 40px rgba(0, 0, 0, 0.16);
        /* Faint boundary every A4 page height — a size-accurate preview aid.
           The exact per-page breaks come from the browser's print engine. */
        background-image: repeating-linear-gradient(
          to bottom,
          transparent 0 calc(297mm - 1px),
          rgba(0, 0, 0, 0.14) calc(297mm - 1px) 297mm
        );
      }

      /* No entrance motion in a one-shot render. */
      .cv-print .cv-reveal {
        opacity: 1 !important;
        animation: none !important;
        transform: none !important;
      }

      /* Whole document reads in Inter + a CJK fallback for the zh PDF. */
      .cv-print :where(.cv-name, .cv-headline, .cv-location,
        .cv-contact, .cv-contact__item, .cv-summary, .cv-section__title, .cv-entry__org,
        .cv-entry__role, .cv-entry__summary, .cv-highlights li, .cv-project__name,
        .cv-project__desc, .cv-skill-group__label, .cv-tag) {
        font-family: 'Inter', 'CV CJK', ui-sans-serif, system-ui, sans-serif;
      }

      @page {
        size: A4;
        margin: 14mm 0;
      }

      @media print {
        /* Strip the on-screen paper illusion — the real page comes from @page. */
        html,
        body {
          background: #fff;
        }

        .cv-print {
          width: auto;
          min-height: 0;
          margin: 0;
          padding: 0 14mm;
          background: #fff;
          background-image: none;
          box-shadow: none;
        }

        .cv-print .cv-entry,
        .cv-print .cv-project,
        .cv-print .cv-section {
          break-inside: avoid;
        }
      }
    </style>
  </head>
  <body>
    <main class="cv-zone cv-page cv-print" data-lang={lang} lang={lang}>
      <CvDocument cv={cv} lang={lang} avatar="/avatar.webp" variant="print" showRequest={false} />
    </main>
  </body>
</html>
