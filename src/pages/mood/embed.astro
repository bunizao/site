---
import {
  toMoodAvatarUrl,
} from '@/features/mood/server/channel-service';
import {
  loadMoodDocument,
  loadMoodFeed,
  moodDocumentToFeedItem,
} from '@/features/mood/server/api-client';
import { renderMoodGalleryMarkup } from '@/features/mood/shared/gallery';
import { renderStructuredMoodFeedMediaMarkup } from '@/features/mood/shared/feed-media';
import { getMoodDetailHref, getMoodFeedAnchorHref } from '@/features/mood/shared/feed-anchor';
import { readMoodEmbedQuery } from '@/features/mood/server/embed-query';
import { buildSrcSet } from '@/lib/media/responsive-image';
import type { MoodFeedItem } from '@/features/mood/server/contracts';
import { getEmbedHeaders } from '../../lib/embed-response';
import '@/features/mood/styles/feed-rich-text.css';
import '@/styles/mood-gallery.css';

export const prerender = false;

// Parse query parameters
const url = Astro.url;
const {
  theme,
  idParam,
  count,
  frame,
  density,
  font,
  originParam,
  hasRefreshParam,
  refresh,
  showLink,
} = readMoodEmbedQuery(url);
const context = { request: Astro.request, locals: Astro.locals };
let feedPosts: MoodFeedItem[] = [];
let channelTitle = '';
let channelAvatar = '';

if (idParam) {
  const post = await loadMoodDocument(context, idParam);
  feedPosts = post ? [moodDocumentToFeedItem(post)] : [];
  channelTitle = post?.channel?.title || 'Levitating';
  channelAvatar = toMoodAvatarUrl(post?.channel?.avatar || '', Astro.locals);
} else {
  const feed = await loadMoodFeed(context, { limit: count });
  feedPosts = feed.posts.slice(0, count);
  channelTitle = feed.channel.title || 'Levitating';
  channelAvatar = toMoodAvatarUrl(feed.channel.avatar || '', Astro.locals);
}

const responsiveImageWidths = [480, 800, 1200];
const embedImageSizes = '(min-width: 640px) 520px, 100vw';
const quoteImageErrorHandler =
  "this.closest('.mood-item-quote-media')?.remove();const q=this.closest('.mood-item-quote');q?.classList.remove('mood-item-quote--with-media','mood-item-quote--media-only');if(q&&!q.textContent.trim())q.remove();";

// Set embed-friendly headers
const embedHeaders = getEmbedHeaders(hasRefreshParam ? { maxAge: 0, staleWhileRevalidate: 0 } : { maxAge: 300 });
embedHeaders.forEach((value, key) => {
  Astro.response.headers.set(key, value);
});
if (hasRefreshParam) {
  Astro.response.headers.set('Cache-Control', 'no-store');
}

// Determine theme class
const themeClass = theme === 'light' ? '' : theme === 'dark' ? 'dark' : '';

// Format datetime for display
function formatDateTime(datetime: string): string {
  const date = new Date(datetime);
  if (isNaN(date.getTime())) return '';
  const now = new Date();
  const isToday = date.toDateString() === now.toDateString();
  const yesterday = new Date(now);
  yesterday.setDate(yesterday.getDate() - 1);
  const isYesterday = date.toDateString() === yesterday.toDateString();

  const time = date.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: false });

  if (isToday) return `Today at ${time}`;
  if (isYesterday) return `Yesterday at ${time}`;

  const month = date.toLocaleString('en-US', { month: 'short' });
  const day = date.getDate();
  return `${month} ${day} at ${time}`;
}

function normalizeOrigin(value: string | null): string | null {
  if (!value) return null;
  try {
    const parsed = new URL(value);
    if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') return null;
    return parsed.origin;
  } catch {
    return null;
  }
}

const allowedOrigin = normalizeOrigin(originParam);

function getQuoteClassName(post: MoodFeedItem): string {
  const quote = post.quote;
  const quoteHasMedia = Boolean(quote?.thumbnailSrc);
  const mediaOnly = isMediaOnlyQuote(post);
  return [
    'mood-item-quote',
    mediaOnly ? 'mood-item-quote--media-only' : '',
    quoteHasMedia && !mediaOnly ? 'mood-item-quote--with-media' : '',
  ].filter(Boolean).join(' ');
}

function isMediaOnlyQuote(post: MoodFeedItem): boolean {
  const quote = post.quote;
  return Boolean(quote?.thumbnailSrc && /^(Media|Video)$/i.test(quote.text));
}

function isExternalHref(value: string | undefined): boolean {
  return Boolean(value && /^https?:\/\//i.test(value));
}

function getImageClassName(post: MoodFeedItem): string {
  return [
    'mood-item-thumb',
    post.imageKind === 'sticker' ? 'mood-item-thumb--sticker' : '',
    post.imageLayout === 'portrait' ? 'mood-item-thumb--portrait' : '',
    post.imageLayout === 'ultra-tall' ? 'mood-item-thumb--ultra-tall' : '',
  ].filter(Boolean).join(' ');
}
---

<!DOCTYPE html>
<html
  lang="en"
  class={themeClass}
  data-embed-theme={theme}
  data-embed-frame={frame ? 'true' : 'false'}
  data-embed-density={density}
  data-embed-font={font}
>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Mood Embed</title>
  {font !== 'system' && (
    <link
      rel="preload"
      as="font"
      href="/fonts/jetbrains-mono-variable.woff2"
      type="font/woff2"
      crossorigin
    />
  )}
  <style is:inline>
    @font-face {
      font-family: 'JetBrains Mono';
      src:
        url('/fonts/jetbrains-mono-variable.woff2') format('woff2-variations'),
        url('/fonts/jetbrains-mono-variable.woff2') format('woff2');
      font-weight: 100 800;
      font-style: normal;
      font-display: swap;
    }

    :root {
      --font-family: 'JetBrains Mono', monospace;
      /* Standalone iframe: no globals.css cascade, so feed-rich-text.css's
         var(--font-code) is sourced here. */
      --font-code: 'JetBrains Mono', ui-monospace, monospace;
      --background: 0 0% 100%;
      --foreground: 0 0% 0%;
      --muted: 0 0% 40%;
      --muted-foreground: 0 0% 40%;
      --border: 0 0% 90%;
      --card-bg: 0 0% 100%;
      --card-border: 0 0% 88%;
      --card-shadow: 0 0% 0% / 0.06;
      --body-padding: 8px;
      --card-gap: 12px;
      --card-radius: 12px;
      --header-padding: 12px 14px;
      --content-padding: 14px;
      --footer-padding: 10px 14px;
      --text-size: 14px;
      --meta-size: 11px;
      --view-more-size: 12px;
      --reaction-size: 11px;
      --image-max: 400px;
      --mood-item-text-size: var(--text-size);
      --mood-item-text-wide-size: var(--text-size);
      --mood-item-text-mobile-size: var(--text-size);
      --mood-item-text-line-height: 1.6;
      --mood-item-text-wide-line-height: 1.6;
      --mood-item-text-mobile-line-height: 1.6;
    }

    .dark {
      --background: 0 0% 4%;
      --foreground: 0 0% 100%;
      --muted: 0 0% 53%;
      --muted-foreground: 0 0% 53%;
      --border: 0 0% 20%;
      --card-bg: 0 0% 8%;
      --card-border: 0 0% 18%;
      --card-shadow: 0 0% 0% / 0.3;
    }

    .light {
      --background: 0 0% 100%;
      --foreground: 0 0% 0%;
      --muted: 0 0% 40%;
      --muted-foreground: 0 0% 40%;
      --border: 0 0% 90%;
      --card-bg: 0 0% 100%;
      --card-border: 0 0% 88%;
      --card-shadow: 0 0% 0% / 0.06;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html, body {
      font-family: var(--font-family);
      font-size: 14px;
      line-height: 1.6;
      background: hsl(var(--background));
      color: hsl(var(--foreground));
    }

    body {
      padding: var(--body-padding);
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    html[data-embed-font="system"] {
      --font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    html[data-embed-density="compact"] {
      --body-padding: 6px;
      --card-gap: 10px;
      --card-radius: 10px;
      --header-padding: 10px 12px;
      --content-padding: 12px;
      --footer-padding: 8px 12px;
      --text-size: 13px;
      --meta-size: 10px;
      --view-more-size: 11px;
      --reaction-size: 10px;
      --image-max: 320px;
    }

    html[data-embed-frame="false"] {
      --body-padding: 0;
      --card-gap: 16px;
      --card-radius: 0;
    }

    /* Card container */
    .embed-card {
      background: hsl(var(--card-bg));
      border: 1px solid hsl(var(--card-border));
      border-radius: var(--card-radius);
      overflow: hidden;
      box-shadow: 0 2px 8px hsl(var(--card-shadow)), 0 1px 3px hsl(var(--card-shadow));
    }

    .embed-card + .embed-card {
      margin-top: var(--card-gap);
    }

    html[data-embed-frame="false"] .embed-card {
      background: transparent;
      border: 0;
      border-radius: 0;
      box-shadow: none;
    }

    /* Header */
    .card-header {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: var(--header-padding);
      border-bottom: 1px solid hsl(var(--card-border));
    }

    .channel-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: hsl(var(--muted-foreground) / 0.15);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      font-weight: 600;
      color: hsl(var(--foreground));
      overflow: hidden;
      flex-shrink: 0;
    }

    .channel-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .channel-info {
      flex: 1;
      min-width: 0;
    }

    .channel-name {
      font-family: var(--font-family);
      font-size: 13px;
      font-weight: 600;
      color: hsl(var(--foreground));
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .channel-name:hover {
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    /* Content */
    .card-content {
      padding: var(--content-padding);
    }

    .mood-item-quote {
      margin-bottom: 10px;
      max-width: 100%;
    }

    .mood-item-text {
      font-size: var(--text-size);
    }

    .mood-item-media {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-top: 12px;
    }

    .mood-item-media :global(video) {
      display: block;
      width: 100%;
      max-width: 100%;
      max-height: min(52vh, 400px);
      height: auto;
      border-radius: 12px;
      background: transparent;
      overflow: clip;
      clip-path: inset(0 round 12px);
    }

    .mood-item-media :global(video.video--portrait) {
      width: min(100%, 320px);
      max-height: min(58vh, 460px);
    }

    .mood-item-media :global(video.video--ultra-tall) {
      width: min(100%, 280px);
      max-height: min(62vh, 500px);
    }

    .mood-item-media :global(audio) {
      width: 100%;
    }

    .mood-item-thumb,
    .mood-gallery {
      margin-top: 12px;
    }

    .mood-item-thumb {
      width: 100%;
      max-width: 400px;
      border-radius: 12px;
      overflow: hidden;
      background: hsl(var(--foreground) / 0.02);
      position: relative;
    }

    .mood-item-thumb img {
      display: block;
      width: 100%;
      height: auto;
    }

    .mood-item-thumb--sticker {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      max-width: min(100%, 256px);
      background: transparent;
    }

    .mood-item-thumb--sticker img {
      width: min(100%, 256px);
      object-fit: contain;
    }

    .mood-item-thumb--portrait {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      max-width: min(100%, 220px);
      background: hsl(var(--foreground) / 0.04);
    }

    .mood-item-thumb--portrait img {
      max-width: 220px;
      max-height: 280px;
      object-fit: contain;
    }

    .mood-item-thumb--ultra-tall {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      max-width: min(100%, 180px);
      background: hsl(var(--foreground) / 0.03);
    }

    .mood-item-thumb--ultra-tall img {
      max-width: 180px;
      max-height: 320px;
      object-fit: contain;
    }

    /* Footer */
    .card-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: var(--footer-padding);
      border-top: 1px solid hsl(var(--card-border));
      font-size: var(--meta-size);
      color: hsl(var(--muted-foreground));
    }

    html[data-embed-frame="false"] .card-header,
    html[data-embed-frame="false"] .card-content,
    html[data-embed-frame="false"] .card-footer {
      padding-left: 0;
      padding-right: 0;
    }

    .footer-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .mood-reactions {
      display: flex;
      gap: 8px;
    }

    .mood-reaction {
      display: inline-flex;
      align-items: center;
      gap: 3px;
      padding: 2px 6px;
      background: hsl(var(--muted-foreground) / 0.08);
      border-radius: 10px;
      font-size: var(--reaction-size);
    }

    .reaction-emoji {
      font-size: 12px;
    }

    .reaction-emoji-img {
      width: 14px;
      height: 14px;
      vertical-align: middle;
    }

    .mood-datetime {
      white-space: nowrap;
    }

    .mood-datetime:hover {
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    /* View more link */
    .view-more {
      display: block;
      text-align: center;
      padding: 10px;
      margin-top: 8px;
      font-size: var(--view-more-size);
      color: hsl(var(--muted-foreground));
      transition: color 0.15s ease;
    }

    .view-more:hover {
      color: hsl(var(--foreground));
    }

    .view-more::after {
      content: ' →';
    }

    .empty-state {
      text-align: center;
      padding: 32px 16px;
      color: hsl(var(--muted-foreground));
      font-size: 13px;
    }

    /* Auto theme detection */
    @media (prefers-color-scheme: dark) {
      html[data-embed-theme="auto"][data-embed-frame="true"]:not(.light) {
        --background: 0 0% 4%;
        --foreground: 0 0% 100%;
        --muted: 0 0% 53%;
        --muted-foreground: 0 0% 53%;
        --border: 0 0% 20%;
        --card-bg: 0 0% 8%;
        --card-border: 0 0% 18%;
        --card-shadow: 0 0% 0% / 0.3;
      }
    }
  </style>
</head>
<body>
  {feedPosts.length === 0 ? (
    <div class="empty-state">No moods to display</div>
  ) : (
    <>
      {feedPosts.map((post) => {
        const previewHtml = post.previewHtml;
        const image = post.image;
        const gallery = (post.gallery?.items.length ?? 0) > 1 ? post.gallery : null;
        const structuredMediaHtml = renderStructuredMoodFeedMediaMarkup(post.media);
        const mediaHtml = structuredMediaHtml || post.mediaHtml;
        const datetime = formatDateTime(post.datetime);
        const postUrl = getMoodDetailHref(post.id);
        const channelUrl = getMoodFeedAnchorHref('');
        const initial = channelTitle.charAt(0).toUpperCase();
        const quoteHref = post.quote?.href;
        const QuoteElement = quoteHref ? 'a' : 'div';
        const quoteIsExternal = isExternalHref(quoteHref);

        return (
          <article class="embed-card">
            <header class="card-header">
              <a href={channelUrl} target="_blank" rel="noopener" class="channel-avatar">
                {channelAvatar ? (
                  <img src={channelAvatar} alt={channelTitle} />
                ) : (
                  initial
                )}
              </a>
              <div class="channel-info">
                <a href={channelUrl} target="_blank" rel="noopener" class="channel-name">
                  {channelTitle}
                </a>
              </div>
            </header>

            <div class="card-content">
              {post.quote && (
                <QuoteElement
                  href={quoteHref}
                  target={quoteIsExternal ? '_blank' : undefined}
                  rel={quoteIsExternal ? 'noopener noreferrer' : undefined}
                  class={getQuoteClassName(post)}
                >
                  {post.quote.thumbnailSrc && (
                    <span class="mood-item-quote-media">
                      <img
                        class="mood-item-quote-image"
                        src={post.quote.thumbnailSrc}
                        alt=""
                        loading="lazy"
                        onerror={quoteImageErrorHandler}
                      />
                    </span>
                  )}
                  <span class="mood-item-quote-body">
                    {post.quote.author && (
                      <div class="mood-item-quote-meta">
                        <span class="mood-item-quote-author">{post.quote.author}</span>
                      </div>
                    )}
                    {!isMediaOnlyQuote(post) && (
                      <p class="mood-item-quote-text">{post.quote.text}</p>
                    )}
                  </span>
                </QuoteElement>
              )}
              {previewHtml && (
                <div class="mood-item-text" set:html={previewHtml} />
              )}
              {mediaHtml && (
                <div class="mood-item-media" set:html={mediaHtml} />
              )}
              {!structuredMediaHtml && gallery ? (
                <Fragment set:html={renderMoodGalleryMarkup(gallery, { variant: 'feed' })} />
              ) : !structuredMediaHtml && image && (
                <div class={getImageClassName(post)}>
                  <img
                    src={image}
                    srcset={image ? buildSrcSet(image, responsiveImageWidths) : undefined}
                    sizes={embedImageSizes}
                    data-fallback-src={post.imageFallback || undefined}
                    alt=""
                    loading="lazy"
                  />
                </div>
              )}
            </div>

            <footer class="card-footer">
              <div class="footer-left">
                {post.reactions && post.reactions.length > 0 && (
                  <div class="mood-reactions">
                    {post.reactions.slice(0, 4).map((reaction: any) => (
                      <span class="mood-reaction">
                        {reaction.emojiImage ? (
                          <img class="reaction-emoji-img" src={reaction.emojiImage} alt="" />
                        ) : (
                          <span class="reaction-emoji">{reaction.emoji}</span>
                        )}
                        <span>{reaction.count}</span>
                      </span>
                    ))}
                  </div>
                )}
              </div>
              <a href={postUrl} target="_blank" rel="noopener" class="mood-datetime" data-datetime={post.datetime}>
                {datetime}
              </a>
            </footer>
          </article>
        );
      })}
      {showLink && feedPosts.length > 0 && (
        <a class="view-more" href="/mood" target="_blank" rel="noopener">
          View all moods
        </a>
      )}
    </>
  )}

  <script is:inline define:vars={{ refresh, allowedOrigin }}>
    const targetOrigin = allowedOrigin || '*';
    let lastHeight = 0;
    let rafId = 0;

    function measureHeight() {
      const doc = document.documentElement;
      const body = document.body;
      if (body) {
        const rect = body.getBoundingClientRect();
        const contentHeight = Math.ceil(rect.height);
        if (contentHeight > 0) return contentHeight;
      }
      return Math.max(doc.scrollHeight, body ? body.scrollHeight : 0);
    }

    function postHeight() {
      const height = measureHeight();
      if (height === lastHeight) return;
      lastHeight = height;
      window.parent.postMessage({ type: 'mood-embed-resize', height }, targetOrigin);
    }

    function scheduleSend() {
      if (rafId) return;
      rafId = window.requestAnimationFrame(() => {
        rafId = 0;
        postHeight();
      });
    }

    // Send initial height
    scheduleSend();

    // Send height on resize
    window.addEventListener('resize', scheduleSend);

    // Track layout changes for dynamic content
    if ('ResizeObserver' in window) {
      const resizeObserver = new ResizeObserver(scheduleSend);
      resizeObserver.observe(document.documentElement);
    } else if ('MutationObserver' in window) {
      const mutationObserver = new MutationObserver(scheduleSend);
      mutationObserver.observe(document.body, {
        childList: true,
        subtree: true,
        characterData: true,
        attributes: true,
      });
    }

    document.querySelectorAll('img[data-fallback-src]').forEach(img => {
      img.addEventListener('error', () => {
        if (img.dataset.fallbackApplied === '1') return;
        const fallbackSrc = img.dataset.fallbackSrc || '';
        if (!fallbackSrc) return;
        img.dataset.fallbackApplied = '1';
        img.src = fallbackSrc;
        img.removeAttribute('srcset');
      });
    });

    document.querySelectorAll('img[data-mood-gallery-image]').forEach(img => {
      if (img.dataset.deferredSrc) {
        img.src = img.dataset.deferredSrc;
      }
      if (img.dataset.deferredSrcset) {
        img.srcset = img.dataset.deferredSrcset;
      }
      if (img.dataset.sizes) {
        img.sizes = img.dataset.sizes;
      }
    });

    // Send height after images load (or immediately if cached)
    document.querySelectorAll('img').forEach(img => {
      if (img.complete) {
        scheduleSend();
        return;
      }
      img.addEventListener('load', scheduleSend);
    });

    document.querySelectorAll('video').forEach(video => {
      video.addEventListener('loadedmetadata', scheduleSend);
      video.addEventListener('loadeddata', scheduleSend);
    });

    // Re-measure after fonts load
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(scheduleSend);
    }

    // Auto-refresh if configured
    if (refresh && refresh > 0) {
      setInterval(() => {
        window.location.reload();
      }, refresh * 1000);
    }

    // Theme sync with parent
    window.addEventListener('message', (event) => {
      if (allowedOrigin && event.origin !== allowedOrigin) {
        return;
      }
      if (event.source !== window.parent) {
        return;
      }
      if (event.data && event.data.type === 'mood-embed-theme') {
        const html = document.documentElement;
        const theme = event.data.theme;
        if (theme === 'dark') {
          html.dataset.embedTheme = 'dark';
          html.classList.add('dark');
          html.classList.remove('light');
        } else if (theme === 'light') {
          html.dataset.embedTheme = 'light';
          html.classList.remove('dark');
          html.classList.add('light');
        }
      }
    });

    function formatClientDateTime(datetime) {
      const date = new Date(datetime);
      if (Number.isNaN(date.getTime())) return '';
      const now = new Date();
      const isToday = date.toDateString() === now.toDateString();
      const yesterday = new Date(now);
      yesterday.setDate(yesterday.getDate() - 1);
      const isYesterday = date.toDateString() === yesterday.toDateString();
      const time = date.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: false });

      if (isToday) return `Today at ${time}`;
      if (isYesterday) return `Yesterday at ${time}`;

      const month = date.toLocaleString('en-US', { month: 'short' });
      const day = date.getDate();
      return `${month} ${day} at ${time}`;
    }

    // Update datetimes to client locale
    document.querySelectorAll('.mood-datetime[data-datetime]').forEach((el) => {
      const value = el.getAttribute('data-datetime');
      if (!value) return;
      const text = formatClientDateTime(value);
      if (text) {
        el.textContent = text;
      }
    });
  </script>
</body>
</html>
