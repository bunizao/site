---
import SiteAnalytics from '@/components/SiteAnalytics.astro';
import {
  toMoodAvatarUrl,
} from '@/features/mood/server/channel-service';
import {
  loadMoodDocument,
  loadMoodFeed,
  moodDocumentToFeedItem,
} from '@/features/mood/server/api-client';
import { renderMoodGalleryMarkup } from '@/features/mood/shared/gallery-render';
import { renderStructuredMoodFeedMediaMarkup } from '@/features/mood/shared/feed-media';
import { getMoodFeedThumbnailStyle } from '@/features/mood/shared/feed-thumbnail';
import {
  buildArchiveSrcSet,
  getMoodImagePlaceholderSrc,
  getMoodImageRatio,
  resolveMoodImageLayout,
} from '@/features/mood/shared/image-srcset';
import { getMoodDetailHref, getMoodFeedAnchorHref } from '@/features/mood/shared/feed-anchor';
import { splitMoodDetailParagraphs } from '@/features/mood/shared/detail-content';
import { readMoodEmbedQuery } from '@/features/mood/server/embed-query';
import type { MoodFeedItem } from '@/features/mood/server/contracts';
import { getEmbedHeaders } from '../../lib/embed-response';
import '@/features/mood/styles/feed-rich-text.css';
import '@/features/mood/styles/bookmark-card.css';
import '@/styles/mood-gallery.css';
import '@/styles/mood-image.css';
import '@/styles/embed-youtube.css';

export const prerender = false;

// Parse query parameters
const url = Astro.url;
const {
  theme,
  idParam,
  count,
  frame,
  density,
  font,
  originParam,
  hasRefreshParam,
  refresh,
  showLink,
} = readMoodEmbedQuery(url);
const context = { request: Astro.request, locals: Astro.locals };
let feedPosts: MoodFeedItem[] = [];
let channelTitle = '';
let channelSlug = '';
let channelAvatar = '';

if (idParam) {
  const post = await loadMoodDocument(context, idParam, { source: 'archive' });
  feedPosts = post ? [moodDocumentToFeedItem(post)] : [];
  channelTitle = post?.channel?.title || 'Levitating';
  channelSlug = post?.channel?.slug || '';
  channelAvatar = toMoodAvatarUrl(post?.channel?.avatar || '', Astro.locals);
} else {
  const feed = await loadMoodFeed(context, { limit: count, source: 'archive' });
  feedPosts = feed.posts.slice(0, count);
  channelTitle = feed.channel.title || 'Levitating';
  channelSlug = feed.channel.slug || '';
  channelAvatar = toMoodAvatarUrl(feed.channel.avatar || '', Astro.locals);
}

const embedImageSizes = '(min-width: 640px) 520px, 100vw';
const quoteImageErrorHandler =
  "this.closest('.mood-item-quote-media')?.classList.add('is-media-error');this.remove();";

// Set embed-friendly headers
const embedHeaders = getEmbedHeaders(hasRefreshParam ? { maxAge: 0, staleWhileRevalidate: 0 } : { maxAge: 300 });
embedHeaders.forEach((value, key) => {
  Astro.response.headers.set(key, value);
});
if (hasRefreshParam) {
  Astro.response.headers.set('Cache-Control', 'no-store');
}

// Determine theme class
const themeClass = theme === 'light' ? '' : theme === 'dark' ? 'dark' : '';

// The byline date reads like the detail page's ("February 25, 2023 · 04:09").
// The inline script below repeats this in the reader's timezone; keep the two
// in step.
function formatDateTime(datetime: string): string {
  const date = new Date(datetime);
  if (isNaN(date.getTime())) return '';
  const day = date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
  const time = date.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
  return `${day} · ${time}`;
}

function normalizeOrigin(value: string | null): string | null {
  if (!value) return null;
  try {
    const parsed = new URL(value);
    if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') return null;
    return parsed.origin;
  } catch {
    return null;
  }
}

const allowedOrigin = normalizeOrigin(originParam);

function getQuoteClassName(post: MoodFeedItem): string {
  const quote = post.quote;
  const quoteHasMedia = Boolean(quote?.thumbnailSrc);
  const mediaOnly = isMediaOnlyQuote(post);
  return [
    'mood-item-quote',
    mediaOnly ? 'mood-item-quote--media-only' : '',
    quoteHasMedia && !mediaOnly ? 'mood-item-quote--with-media' : '',
  ].filter(Boolean).join(' ');
}

function isMediaOnlyQuote(post: MoodFeedItem): boolean {
  const quote = post.quote;
  return Boolean(quote?.thumbnailSrc && /^(Media|Video)$/i.test(quote.text));
}

// A post quoting the channel itself already carries its name in the byline.
// Same test as FeedShell's.
function normalizeAuthorName(value: string): string {
  return value.replace(/\s+/g, ' ').trim().replace(/^@/, '').toLowerCase().replace(/[^\w-]+$/g, '');
}

function shouldHideQuoteAuthor(value?: string): boolean {
  if (!value) return false;
  const normalized = normalizeAuthorName(value);
  return [channelSlug, channelTitle].some((name) => name && normalizeAuthorName(name) === normalized);
}

// Three clamped lines leave no room for an empty one.
function collapseQuoteText(value: string): string {
  return value.replace(/\n\s*\n+/g, '\n');
}

function isExternalHref(value: string | undefined): boolean {
  return Boolean(value && /^https?:\/\//i.test(value));
}

function getImageClassName(post: MoodFeedItem): string {
  const layout = resolveMoodImageLayout(post.imageLayout, post.imageWidth, post.imageHeight);
  const ratio = getMoodImageRatio(post.imageWidth, post.imageHeight, layout);
  const isSticker = post.imageKind === 'sticker';
  return [
    'mood-item-thumb',
    isSticker ? 'mood-item-thumb--sticker' : 'mood-image-frame',
    !isSticker && !ratio.exact ? 'mood-image-frame--estimated' : '',
    layout === 'portrait' ? 'mood-item-thumb--portrait' : '',
    layout === 'ultra-tall' ? 'mood-item-thumb--ultra-tall' : '',
  ].filter(Boolean).join(' ');
}
---

<!DOCTYPE html>
<html
  lang="en"
  class={themeClass}
  data-embed-theme={theme}
  data-embed-frame={frame ? 'true' : 'false'}
  data-embed-density={density}
  data-embed-font={font}
>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Mood Embed</title>
  {font !== 'system' && (
    <link
      rel="preload"
      as="font"
      href="/fonts/inter-variable.woff2"
      type="font/woff2"
      crossorigin
    />
  )}
  <style is:inline>
    /* Standalone document: globals.css never loads here, so the faces and
       tokens the shared mood stylesheets expect are declared locally. They
       mirror the site's: Inter reads, JetBrains Mono carries the channel name
       the way /mood/[id] sets it. */
    @font-face {
      font-family: 'Inter';
      src:
        url('/fonts/inter-variable.woff2') format('woff2-variations'),
        url('/fonts/inter-variable.woff2') format('woff2');
      font-weight: 100 900;
      font-style: normal;
      font-display: swap;
    }

    @font-face {
      font-family: 'JetBrains Mono';
      src: url('/fonts/jetbrains-mono-latin.woff2') format('woff2');
      font-weight: 100 800;
      font-style: normal;
      font-display: swap;
      unicode-range: U+0000-024F, U+2000-206F;
    }

    @font-face {
      font-family: 'JetBrains Mono';
      src: url('/fonts/jetbrains-mono-rest.woff2') format('woff2');
      font-weight: 100 800;
      font-style: normal;
      font-display: swap;
      unicode-range: U+0250-1FFF, U+2070-2FFF, U+A700-A7FF, U+F8FF, U+FB00-FB4F,
        U+FEFF, U+FFFD;
    }

    /* globals.css's metric-matched fallbacks. The frame sizes itself to its
       text, so a swap that reflows is not a flash here but the host's layout
       jumping by a line. */
    @font-face {
      font-family: 'Inter Fallback';
      src: local('Arial');
      size-adjust: 105.33%;
      ascent-override: 91.99%;
      descent-override: 22.88%;
      line-gap-override: 0%;
    }

    @font-face {
      font-family: 'JetBrains Mono Fallback';
      src: local('Menlo-Regular');
      size-adjust: 99.66%;
      ascent-override: 102.35%;
      descent-override: 30.1%;
      line-gap-override: 0%;
    }

    :root {
      color-scheme: light;
      --font-sans: 'Inter', 'Inter Fallback', ui-sans-serif, system-ui,
        -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial,
        sans-serif;
      --font-code: 'JetBrains Mono', 'JetBrains Mono Fallback', ui-monospace,
        SFMono-Regular, Menlo, Consolas, monospace;
      --font-mono: var(--font-code);
      --background: 0 0% 100%;
      --foreground: 0 0% 0%;
      --muted-foreground: 0 0% 40%;
      --radius-sm: 0.5rem;
      --ease: cubic-bezier(0.2, 0, 0, 1);
      --dur-fast: 130ms;

      /* Hairlines and fills are the foreground at low alpha, as in the blog's
         prose cards, so both themes fall out of the three colours above. */
      --line: hsl(var(--foreground) / 0.1);
      --line-strong: hsl(var(--foreground) / 0.2);
      --fill: hsl(var(--foreground) / 0.04);

      /* Mirrored by --mood-embed-bleed in blog-prose.css: room for focus rings
         at the frame edge, pulled back out by the host. */
      --body-padding: 8px;
      /* One spacing ladder, measured to the text: line (~10px of leading) <
         paragraph (0.6em + leading) ~ block (--body-gap + half-leading) <
         section (--stack-gap, byline / body / reactions) = card padding. */
      --card-padding: 20px;
      --card-gap: 16px;
      --card-radius: 16px;
      --media-radius: 12px;
      --stack-gap: 20px;
      --body-gap: 14px;
      --byline-gap: 12px;
      /* The byline's two lines stack to exactly the avatar's height
         (name-line + 2px + meta-line), so the circle and the text share a top
         and a bottom. Name to body is /mood/[id]'s ratio (15:17). */
      --avatar-size: 36px;
      --name-size: 13px;
      --name-line: 18px;
      --meta-size: 12px;
      --meta-line: 16px;
      --text-size: 15px;
      --text-leading: 1.65;
      --image-max: 400px;
      --mood-item-text-size: var(--text-size);
      --mood-item-text-wide-size: var(--text-size);
      --mood-item-text-mobile-size: var(--text-size);
      --mood-item-text-line-height: var(--text-leading);
      --mood-item-text-wide-line-height: var(--text-leading);
      --mood-item-text-mobile-line-height: var(--text-leading);
    }

    .dark {
      color-scheme: dark;
      --background: 0 0% 4%;
      --foreground: 0 0% 100%;
      --muted-foreground: 0 0% 53%;
    }

    @media (prefers-color-scheme: dark) {
      html[data-embed-theme="auto"][data-embed-frame="true"]:not(.light) {
        color-scheme: dark;
        --background: 0 0% 4%;
        --foreground: 0 0% 100%;
        --muted-foreground: 0 0% 53%;
      }
    }

    html[data-embed-font="system"] {
      --font-sans: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --font-code: var(--font-sans);
    }

    html[data-embed-density="compact"] {
      --body-padding: 6px;
      --card-padding: 14px;
      --card-gap: 12px;
      --card-radius: 14px;
      --media-radius: 10px;
      --stack-gap: 14px;
      --body-gap: 10px;
      --byline-gap: 10px;
      --avatar-size: 32px;
      --name-size: 12.5px;
      --name-line: 16px;
      --meta-size: 11.5px;
      --meta-line: 14px;
      --text-size: 14px;
      --image-max: 320px;
    }

    html[data-embed-frame="false"] {
      --body-padding: 0;
      --card-padding: 0;
      --card-gap: 20px;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    /* A framed card brings its own surface, so the page around it stays
       transparent and the bleed never shows as a strip on a host whose colour
       differs. Frameless text sits on the theme background so it stays
       legible wherever it lands. */
    html {
      background: transparent;
      -webkit-text-size-adjust: 100%;
      text-size-adjust: 100%;
    }

    html[data-embed-frame="false"] {
      background: hsl(var(--background));
    }

    body {
      padding: var(--body-padding);
      font-family: var(--font-sans);
      font-size: 14px;
      line-height: 1.6;
      color: hsl(var(--foreground));
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    a:focus-visible {
      outline: 2px solid hsl(var(--foreground) / 0.5);
      outline-offset: 2px;
      border-radius: 4px;
    }

    /* Card: a hairline and the page colour, no shadow -- the blog's bookmark
       card, not a floating widget. */
    .embed-card {
      display: flex;
      flex-direction: column;
      gap: var(--stack-gap);
      padding: var(--card-padding);
      background: hsl(var(--background));
      border: 1px solid var(--line);
      border-radius: var(--card-radius);
    }

    .embed-card + .embed-card {
      margin-top: var(--card-gap);
    }

    html[data-embed-frame="false"] .embed-card {
      background: transparent;
      border: 0;
      border-radius: 0;
    }

    html[data-embed-frame="false"] .embed-card + .embed-card {
      padding-top: var(--card-gap);
      border-top: 1px solid var(--line);
    }

    /* Byline: /mood/[id]'s author block at embed scale. Name in the code face,
       date as the sans meta line under it, and the date is the permalink. */
    .embed-byline {
      display: flex;
      align-items: center;
      gap: var(--byline-gap);
      min-width: 0;
    }

    .embed-avatar {
      flex: none;
      display: flex;
      align-items: center;
      justify-content: center;
      width: var(--avatar-size);
      height: var(--avatar-size);
      border-radius: 50%;
      overflow: hidden;
      background: var(--fill);
      font-family: var(--font-code);
      font-size: 13px;
      font-weight: 600;
    }

    /* An inset shadow paints under an <img>'s pixels; an inset outline paints
       over them, so the edge survives a light avatar on a light page. */
    .embed-avatar img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 50%;
      outline: 1px solid hsl(var(--foreground) / 0.1);
      outline-offset: -1px;
    }

    .embed-who {
      display: flex;
      flex-direction: column;
      gap: 2px;
      min-width: 0;
    }

    .embed-name {
      font-family: var(--font-code);
      font-size: var(--name-size);
      font-weight: 600;
      line-height: var(--name-line);
      letter-spacing: -0.01em;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* Proportional figures: tabular ones only earn their width when a column
       of dates lines up, and one date on its own reads gappy with them. Full
       muted colour, not a fraction of it -- at 12px anything lighter drops
       under 4.5:1 on white. */
    .embed-date {
      font-size: var(--meta-size);
      line-height: var(--meta-line);
      color: hsl(var(--muted-foreground));
      white-space: nowrap;
      transition: color var(--dur-fast) var(--ease);
    }

    .embed-name:hover {
      text-decoration: underline;
      text-decoration-color: var(--line-strong);
      text-underline-offset: 3px;
    }

    .embed-date:hover {
      color: hsl(var(--foreground));
    }

    /* Body: the feed's content column -- one flex stack, one gap, so quote,
       text and media space themselves the way .mood-item-content does. */
    .embed-body {
      display: flex;
      flex-direction: column;
      gap: var(--body-gap);
      min-width: 0;
    }

    .embed-body:empty {
      display: none;
    }

    .mood-item-quote {
      max-width: 100%;
    }

    /* A text-only quote gets a little more room than the feed's 8px 10px:
       here it is a card inside a card and needs to read as one. The thumb
       and media-only variants keep their own padding. */
    .embed-body .mood-item-quote:not(.mood-item-quote--with-media, .mood-item-quote--media-only) {
      padding: 10px 12px;
    }

    /* /mood/[id]'s reading settings at embed size: Telegram's blank lines
       become real paragraphs (split server-side) two thirds of a line apart
       instead of a whole line-height, and wrapping avoids a lone last word.

       The half-leading is trimmed only where the text meets the byline or the
       card's bottom edge, so those gaps measure to the text itself and the
       card's bottom stops looking heavier than its top. Against a quote or
       media box it stays: a hard edge needs that air, and without it the
       text crowds the box. */
    .mood-item-text {
      text-wrap: pretty;
    }

    .mood-item-text:first-child {
      margin-top: calc((1em - 1lh) / 2);
    }

    .embed-body:last-child > .mood-item-text:last-child {
      margin-bottom: calc((1em - 1lh) / 2);
    }

    .mood-item-text p + p {
      margin-top: 0.6em;
    }

    .mood-item-media {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    /* The feed's video sizes, minus its vh caps: this frame is as tall as its
       content, so vh here would measure the video against itself. */
    .mood-item-media video {
      display: block;
      width: 100%;
      max-width: 100%;
      max-height: 400px;
      height: auto;
      border-radius: var(--media-radius);
      background: transparent;
      overflow: clip;
      clip-path: inset(0 round var(--media-radius));
    }

    .mood-item-media video.video--portrait {
      width: min(100%, 320px);
      max-height: 460px;
    }

    .mood-item-media video.video--ultra-tall {
      width: min(100%, 280px);
      max-height: 500px;
    }

    .mood-item-media audio {
      width: 100%;
    }

    .mood-item-thumb {
      width: 100%;
      max-width: var(--image-max);
      border-radius: var(--media-radius);
      overflow: hidden;
      background: hsl(var(--foreground) / 0.02);
      position: relative;
      aspect-ratio: var(--mood-thumb-ratio, 4 / 3);
    }

    .mood-item-thumb > img:not(.mood-image-blur) {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    /* Same edge the feed draws (mood.astro), so a photo reads identically in
       both places. */
    .mood-item-thumb:not(.mood-item-thumb--sticker) > img:not(.mood-image-blur) {
      box-shadow: inset 0 0 0 1px hsl(var(--foreground) / 0.1);
    }

    .mood-item-thumb--sticker {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: min(100%, 256px);
      max-width: min(100%, 256px);
      aspect-ratio: 1 / 1;
      background: transparent;
    }

    .mood-item-thumb--sticker img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .mood-item-thumb--portrait {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: min(100%, var(--mood-thumb-reserved-width, 220px));
      max-width: min(100%, var(--mood-thumb-reserved-width, 220px));
      aspect-ratio: var(--mood-thumb-ratio, 3 / 4);
      background: hsl(var(--foreground) / 0.04);
    }

    .mood-item-thumb--portrait > img:not(.mood-image-blur) {
      width: 100%;
      height: 100%;
      max-width: none;
      max-height: none;
      object-fit: contain;
    }

    .mood-item-thumb--ultra-tall {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: min(100%, var(--mood-thumb-reserved-width, 180px));
      max-width: min(100%, var(--mood-thumb-reserved-width, 180px));
      aspect-ratio: var(--mood-thumb-ratio, 9 / 16);
      background: hsl(var(--foreground) / 0.03);
    }

    .mood-item-thumb--ultra-tall > img:not(.mood-image-blur) {
      width: 100%;
      height: 100%;
      max-width: none;
      max-height: none;
      object-fit: contain;
    }

    /* Reactions: the feed's pills (globals.css .mood-reaction), restated for
       the standalone document. */
    .embed-reactions {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .mood-reaction {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 3px 9px 3px 7px;
      border: 1px solid hsl(var(--foreground) / 0.08);
      border-radius: 999px;
      background: var(--fill);
      color: hsl(var(--muted-foreground));
      line-height: 1.2;
    }

    .mood-reaction--paid {
      background: hsl(45 100% 50% / 0.08);
      color: hsl(45 70% 40%);
    }

    .mood-reaction-emoji {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.15em;
      height: 1.15em;
      font-size: 14px;
      line-height: 1;
    }

    .mood-reaction-emoji img {
      display: block;
      width: 100%;
      height: 100%;
    }

    .mood-reaction-count {
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 600;
      font-variant-numeric: tabular-nums;
      font-feature-settings: 'tnum' 1, 'zero' 1;
      letter-spacing: 0.02em;
      opacity: 0.85;
    }

    .embed-more {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      width: fit-content;
      margin: 4px auto 0;
      padding: 10px 12px;
      font-size: 13px;
      color: hsl(var(--muted-foreground));
      transition: color var(--dur-fast) var(--ease);
    }

    .embed-more__arrow {
      transition: translate var(--dur-fast) var(--ease);
    }

    .embed-more:hover {
      color: hsl(var(--foreground));
    }

    .embed-more:hover .embed-more__arrow {
      translate: 2px 0;
    }

    .empty-state {
      padding: 32px 16px;
      text-align: center;
      font-size: 13px;
      color: hsl(var(--muted-foreground));
    }

    @media (prefers-reduced-motion: reduce) {
      .embed-date,
      .embed-more,
      .embed-more__arrow {
        transition: none;
      }
    }
  </style>
</head>
<body data-analytics-surface="mood_embed" data-analytics-entity={idParam ?? ''} data-analytics-locale="en">
<SiteAnalytics />
  {feedPosts.length === 0 ? (
    <div class="empty-state">No moods to display</div>
  ) : (
    <>
      {feedPosts.map((post) => {
        const previewHtml = post.previewHtml ? splitMoodDetailParagraphs(post.previewHtml) : '';
        const image = post.image;
        const gallery = (post.gallery?.items.length ?? 0) > 1 ? post.gallery : null;
        const structuredMediaHtml = renderStructuredMoodFeedMediaMarkup(post.media);
        const mediaHtml = structuredMediaHtml || post.mediaHtml;
        const datetime = formatDateTime(post.datetime);
        const postUrl = getMoodDetailHref(post.id);
        const channelUrl = getMoodFeedAnchorHref('');
        const initial = channelTitle.charAt(0).toUpperCase();
        const quoteHref = post.quote?.href;
        const QuoteElement = quoteHref ? 'a' : 'div';
        const quoteIsExternal = isExternalHref(quoteHref);
        const imageLayout = resolveMoodImageLayout(post.imageLayout, post.imageWidth, post.imageHeight);
        const imageStyle = getMoodFeedThumbnailStyle({
          imageWidth: post.imageWidth,
          imageHeight: post.imageHeight,
          imageLayout,
          mediaKind: post.imageKind === 'sticker' ? 'sticker' : 'image',
        });
        const imagePlaceholder = image && post.imageKind !== 'sticker'
          ? getMoodImagePlaceholderSrc(image)
          : null;
        const hasImageFrame = Boolean(image && post.imageKind !== 'sticker');
        const imageResponsive = image
          ? buildArchiveSrcSet(image, { sizes: embedImageSizes })
          : null;
        const reactions = post.reactions ?? [];

        return (
          <article class="embed-card">
            <header class="embed-byline">
              {/* The name next to it is the same link; one tab stop is enough. */}
              <a data-track="embed.open" href={channelUrl} target="_blank" rel="noopener" class="embed-avatar" tabindex="-1" aria-hidden="true">
                {channelAvatar ? (
                  <img src={channelAvatar} alt="" width="36" height="36" decoding="async" />
                ) : (
                  initial
                )}
              </a>
              <div class="embed-who">
                <a data-track="embed.open" href={channelUrl} target="_blank" rel="noopener" class="embed-name">
                  {channelTitle}
                </a>
                <a data-track="embed.open" href={postUrl} target="_blank" rel="noopener" class="embed-date">
                  <time datetime={post.datetime}>{datetime}</time>
                </a>
              </div>
            </header>

            <div class="embed-body">
              {post.quote && (
                <QuoteElement
                  href={quoteHref}
                  target={quoteIsExternal ? '_blank' : undefined}
                  rel={quoteIsExternal ? 'noopener noreferrer' : undefined}
                  class={getQuoteClassName(post)}
                  aria-label={isMediaOnlyQuote(post) ? 'View quoted media' : undefined}
                >
                  {post.quote.thumbnailSrc && (
                    <span class="mood-item-quote-media">
                      <img
                        class="mood-item-quote-image"
                        src={post.quote.thumbnailSrc}
                        alt=""
                        loading="lazy"
                        onerror={quoteImageErrorHandler}
                      />
                    </span>
                  )}
                  <span class="mood-item-quote-body">
                    {post.quote.author && !shouldHideQuoteAuthor(post.quote.author) && (
                      <div class="mood-item-quote-meta">
                        <span class="mood-item-quote-author">{post.quote.author}</span>
                      </div>
                    )}
                    {!isMediaOnlyQuote(post) && (
                      <p class="mood-item-quote-text">{collapseQuoteText(post.quote.text)}</p>
                    )}
                  </span>
                </QuoteElement>
              )}
              {previewHtml && (
                <div class="mood-item-text" set:html={previewHtml} />
              )}
              {mediaHtml && (
                <div class="mood-item-media" set:html={mediaHtml} />
              )}
              {!structuredMediaHtml && gallery ? (
                <Fragment set:html={renderMoodGalleryMarkup(gallery, { variant: 'feed' })} />
              ) : !structuredMediaHtml && image && (
                <div
                  class={getImageClassName(post)}
                  style={imageStyle}
                  data-mood-image-frame={hasImageFrame ? '' : undefined}
                >
                  {imagePlaceholder ? (
                    <img
                      class="mood-image-blur"
                      src={imagePlaceholder}
                      alt=""
                      aria-hidden="true"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : null}
                  <img
                    src={image}
                    srcset={imageResponsive?.srcset}
                    sizes={imageResponsive?.sizes}
                    width={post.imageWidth ?? undefined}
                    height={post.imageHeight ?? undefined}
                    data-mood-image-main={hasImageFrame ? '' : undefined}
                    data-fallback-src={post.imageFallback || undefined}
                    alt=""
                    loading="lazy"
                  />
                </div>
              )}
            </div>

            {reactions.length > 0 && (
              <div class="embed-reactions">
                {reactions.map((reaction) => (
                  <span class={reaction.isPaid ? 'mood-reaction mood-reaction--paid' : 'mood-reaction'}>
                    <span class="mood-reaction-emoji">
                      {reaction.isPaid ? '⭐' : reaction.emojiImage ? (
                        <img src={reaction.emojiImage} alt={reaction.emoji || 'emoji'} width="16" height="16" loading="lazy" decoding="async" />
                      ) : reaction.emoji}
                    </span>
                    <span class="mood-reaction-count">{reaction.count}</span>
                  </span>
                ))}
              </div>
            )}
          </article>
        );
      })}
      {showLink && feedPosts.length > 0 && (
        <a data-track="embed.open" class="embed-more" href="/mood" target="_blank" rel="noopener">
          View all moods<span class="embed-more__arrow" aria-hidden="true">→</span>
        </a>
      )}
    </>
  )}

  <script>
    import { initMoodImageFrames } from '@/features/mood/client/image-frame';
    import { initYouTubeEmbeds } from '@/lib/embed/youtube-controller';

    initMoodImageFrames();
    initYouTubeEmbeds();
  </script>

  <script is:inline define:vars={{ refresh, allowedOrigin }}>
    const targetOrigin = allowedOrigin || '*';
    let lastHeight = 0;
    let sendTimer = 0;

    function measureHeight() {
      const doc = document.documentElement;
      const body = document.body;
      if (body) {
        const rect = body.getBoundingClientRect();
        const contentHeight = Math.ceil(rect.height);
        if (contentHeight > 0) return contentHeight;
      }
      return Math.max(doc.scrollHeight, body ? body.scrollHeight : 0);
    }

    function postHeight() {
      const height = measureHeight();
      if (height === lastHeight) return;
      lastHeight = height;
      window.parent.postMessage({ type: 'mood-embed-resize', height }, targetOrigin);
    }

    // Coalesce on a timer, not requestAnimationFrame. The browser throttles
    // animation frames in an off-screen or hidden frame — an embed below the
    // fold, or one inside a collapsed <details> — to nothing at all, so the
    // very first height never leaves and the host keeps the fallback size for
    // good. Timers keep running there, and a resize is not a paint-synchronised
    // job in the first place.
    function scheduleSend() {
      if (sendTimer) return;
      sendTimer = window.setTimeout(() => {
        sendTimer = 0;
        postHeight();
      }, 0);
    }

    // Send initial height
    scheduleSend();

    // Send height on resize
    window.addEventListener('resize', scheduleSend);

    // Track layout changes for dynamic content
    if ('ResizeObserver' in window) {
      const resizeObserver = new ResizeObserver(scheduleSend);
      resizeObserver.observe(document.documentElement);
    } else if ('MutationObserver' in window) {
      const mutationObserver = new MutationObserver(scheduleSend);
      mutationObserver.observe(document.body, {
        childList: true,
        subtree: true,
        characterData: true,
        attributes: true,
      });
    }

    document.querySelectorAll('img[data-fallback-src]').forEach(img => {
      img.addEventListener('error', () => {
        if (img.dataset.fallbackApplied === '1') return;
        const fallbackSrc = img.dataset.fallbackSrc || '';
        if (!fallbackSrc) return;
        img.dataset.fallbackApplied = '1';
        img.src = fallbackSrc;
        img.removeAttribute('srcset');
      });
    });

    document.querySelectorAll('img[data-mood-gallery-image]').forEach(img => {
      if (img.dataset.deferredSrc) {
        img.src = img.dataset.deferredSrc;
      }
      if (img.dataset.deferredSrcset) {
        img.srcset = img.dataset.deferredSrcset;
      }
      if (img.dataset.sizes) {
        img.sizes = img.dataset.sizes;
      }
    });

    // Send height after images load (or immediately if cached)
    document.querySelectorAll('img').forEach(img => {
      if (img.complete) {
        scheduleSend();
        return;
      }
      img.addEventListener('load', scheduleSend);
    });

    document.querySelectorAll('video').forEach(video => {
      video.addEventListener('loadedmetadata', scheduleSend);
      video.addEventListener('loadeddata', scheduleSend);
    });

    // Re-measure after fonts load
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(scheduleSend);
    }

    // Auto-refresh if configured
    if (refresh && refresh > 0) {
      setInterval(() => {
        window.location.reload();
      }, refresh * 1000);
    }

    // Theme sync with parent
    window.addEventListener('message', (event) => {
      if (allowedOrigin && event.origin !== allowedOrigin) {
        return;
      }
      if (event.source !== window.parent) {
        return;
      }
      // The host asks for a fresh height when the frame scrolls into view. An
      // off-screen frame is render-throttled — no animation frames, no resize
      // observations, and a layout read that comes back 0 — so its own initial
      // send can leave with nothing. Being asked once it is visible is the only
      // reliable moment to answer.
      if (event.data && event.data.type === 'mood-embed-measure') {
        lastHeight = 0;
        scheduleSend();
        return;
      }
      if (event.data && event.data.type === 'mood-embed-theme') {
        const html = document.documentElement;
        const theme = event.data.theme;
        if (theme === 'dark') {
          html.dataset.embedTheme = 'dark';
          html.classList.add('dark');
          html.classList.remove('light');
        } else if (theme === 'light') {
          html.dataset.embedTheme = 'light';
          html.classList.remove('dark');
          html.classList.add('light');
        }
      }
    });

    // Same shape as the server's formatDateTime, in the reader's timezone.
    function formatClientDateTime(datetime) {
      const date = new Date(datetime);
      if (Number.isNaN(date.getTime())) return '';
      const day = date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
      const time = date.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
      return `${day} · ${time}`;
    }

    document.querySelectorAll('.embed-date time[datetime]').forEach((el) => {
      const text = formatClientDateTime(el.getAttribute('datetime'));
      if (text) {
        el.textContent = text;
      }
    });
  </script>
</body>
</html>
