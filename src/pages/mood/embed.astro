---
import {
  loadMoodChannelSnapshot,
  loadMoodPostSnapshot,
  toMoodAvatarUrl,
} from '@/features/mood/server/channel-service';
import {
  readBooleanFlag,
  readEnumQuery,
  readIntQuery,
} from '@/lib/http/query';
import { buildSrcSet } from '@/lib/media/responsive-image';
import {
  getTextPreviewHtml,
  getFirstImage,
} from '@/features/mood/shared/utils';
import { getEmbedHeaders } from '../../lib/embed-response';

export const prerender = false;

// Parse query parameters
const url = Astro.url;
const theme = url.searchParams.get('theme') || 'auto';
const idParam = url.searchParams.get('id');
const count = idParam ? 1 : Math.min(10, Math.max(1, readIntQuery(url, 'count') ?? 1));
const frame = readBooleanFlag(url, 'frame', true);
const density = readEnumQuery(url, 'density', ['regular', 'compact'] as const, 'regular');
const font = readEnumQuery(url, 'font', ['mono', 'system'] as const, 'mono');
const originParam = url.searchParams.get('origin');
const refreshRaw = readIntQuery(url, 'refresh');
const refresh = refreshRaw !== null
  ? Math.max(30, Math.min(3600, refreshRaw))
  : null;
const showLink = readBooleanFlag(url, 'link', true);
const context = { request: Astro.request, locals: Astro.locals };
let posts: any[] = [];
let channelTitle = '';
let channelAvatar = '';

if (idParam) {
  const { post, channelInfo } = await loadMoodPostSnapshot(context, idParam);
  posts = post ? [post] : [];
  channelTitle = channelInfo?.title || 'Levitating';
  channelAvatar = toMoodAvatarUrl(channelInfo?.avatar || '', Astro.locals);
} else {
  const { channelInfo, posts: channelPosts } = await loadMoodChannelSnapshot(context);
  posts = channelPosts.slice(0, count);
  channelTitle = channelInfo.title || 'Levitating';
  channelAvatar = toMoodAvatarUrl(channelInfo.avatar || '', Astro.locals);
}

const responsiveImageWidths = [480, 800, 1200];
const embedImageSizes = '(min-width: 640px) 520px, 100vw';

// Set embed-friendly headers
const embedHeaders = getEmbedHeaders(refresh && refresh > 0 ? { maxAge: 0, staleWhileRevalidate: 0 } : { maxAge: 300 });
embedHeaders.forEach((value, key) => {
  Astro.response.headers.set(key, value);
});
if (refresh && refresh > 0) {
  Astro.response.headers.set('Cache-Control', 'no-store');
}

// Determine theme class
const themeClass = theme === 'light' ? '' : theme === 'dark' ? 'dark' : '';

// Format datetime for display
function formatDateTime(datetime: string): string {
  const date = new Date(datetime);
  if (isNaN(date.getTime())) return '';
  const now = new Date();
  const isToday = date.toDateString() === now.toDateString();
  const yesterday = new Date(now);
  yesterday.setDate(yesterday.getDate() - 1);
  const isYesterday = date.toDateString() === yesterday.toDateString();

  const time = date.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: false });

  if (isToday) return `Today at ${time}`;
  if (isYesterday) return `Yesterday at ${time}`;

  const month = date.toLocaleString('en-US', { month: 'short' });
  const day = date.getDate();
  return `${month} ${day} at ${time}`;
}

function normalizeOrigin(value: string | null): string | null {
  if (!value) return null;
  try {
    const parsed = new URL(value);
    if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') return null;
    return parsed.origin;
  } catch {
    return null;
  }
}

const allowedOrigin = normalizeOrigin(originParam);
---

<!DOCTYPE html>
<html
  lang="en"
  class={themeClass}
  data-embed-theme={theme}
  data-embed-frame={frame ? 'true' : 'false'}
  data-embed-density={density}
  data-embed-font={font}
>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Mood Embed</title>
  {font !== 'system' && (
    <link
      rel="preload"
      as="font"
      href="/fonts/jetbrains-mono-variable.woff2"
      type="font/woff2"
      crossorigin
    />
  )}
  <style is:inline>
    @font-face {
      font-family: 'JetBrains Mono';
      src:
        url('/fonts/jetbrains-mono-variable.woff2') format('woff2-variations'),
        url('/fonts/jetbrains-mono-variable.woff2') format('woff2');
      font-weight: 100 800;
      font-style: normal;
      font-display: swap;
    }

    :root {
      --font-family: 'JetBrains Mono', monospace;
      --background: 0 0% 100%;
      --foreground: 0 0% 0%;
      --muted: 0 0% 40%;
      --muted-foreground: 0 0% 40%;
      --border: 0 0% 90%;
      --card-bg: 0 0% 100%;
      --card-border: 0 0% 88%;
      --card-shadow: 0 0% 0% / 0.06;
      --body-padding: 8px;
      --card-gap: 12px;
      --card-radius: 12px;
      --header-padding: 12px 14px;
      --content-padding: 14px;
      --footer-padding: 10px 14px;
      --text-size: 14px;
      --meta-size: 11px;
      --view-more-size: 12px;
      --reaction-size: 11px;
      --image-max: 400px;
    }

    .dark {
      --background: 0 0% 4%;
      --foreground: 0 0% 100%;
      --muted: 0 0% 53%;
      --muted-foreground: 0 0% 53%;
      --border: 0 0% 20%;
      --card-bg: 0 0% 8%;
      --card-border: 0 0% 18%;
      --card-shadow: 0 0% 0% / 0.3;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html, body {
      font-family: var(--font-family);
      font-size: 14px;
      line-height: 1.6;
      background: transparent;
      color: hsl(var(--foreground));
    }

    body {
      padding: var(--body-padding);
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    html[data-embed-font="system"] {
      --font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    html[data-embed-density="compact"] {
      --body-padding: 6px;
      --card-gap: 10px;
      --card-radius: 10px;
      --header-padding: 10px 12px;
      --content-padding: 12px;
      --footer-padding: 8px 12px;
      --text-size: 13px;
      --meta-size: 10px;
      --view-more-size: 11px;
      --reaction-size: 10px;
      --image-max: 320px;
    }

    html[data-embed-frame="false"] {
      --body-padding: 0;
      --card-gap: 16px;
      --card-radius: 0;
    }

    /* Card container */
    .embed-card {
      background: hsl(var(--card-bg));
      border: 1px solid hsl(var(--card-border));
      border-radius: var(--card-radius);
      overflow: hidden;
      box-shadow: 0 2px 8px hsl(var(--card-shadow)), 0 1px 3px hsl(var(--card-shadow));
    }

    .embed-card + .embed-card {
      margin-top: var(--card-gap);
    }

    html[data-embed-frame="false"] .embed-card {
      background: transparent;
      border: 0;
      border-radius: 0;
      box-shadow: none;
    }

    /* Header */
    .card-header {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: var(--header-padding);
      border-bottom: 1px solid hsl(var(--card-border));
    }

    .channel-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: hsl(var(--muted-foreground) / 0.15);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      font-weight: 600;
      color: hsl(var(--foreground));
      overflow: hidden;
      flex-shrink: 0;
    }

    .channel-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .channel-info {
      flex: 1;
      min-width: 0;
    }

    .channel-name {
      font-size: 13px;
      font-weight: 600;
      color: hsl(var(--foreground));
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .channel-name:hover {
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    /* Content */
    .card-content {
      padding: var(--content-padding);
    }

    .mood-text {
      font-size: var(--text-size);
      line-height: 1.6;
      word-wrap: break-word;
      overflow-wrap: break-word;
    }

    .mood-text a {
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    .mood-text a:hover {
      opacity: 0.7;
    }

    .mood-image {
      margin-top: 12px;
      width: 100%;
      max-height: var(--image-max);
      object-fit: contain;
      border-radius: 8px;
      background: hsl(var(--muted-foreground) / 0.05);
    }

    /* Footer */
    .card-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: var(--footer-padding);
      border-top: 1px solid hsl(var(--card-border));
      font-size: var(--meta-size);
      color: hsl(var(--muted-foreground));
    }

    html[data-embed-frame="false"] .card-header,
    html[data-embed-frame="false"] .card-content,
    html[data-embed-frame="false"] .card-footer {
      padding-left: 0;
      padding-right: 0;
    }

    .footer-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .mood-reactions {
      display: flex;
      gap: 8px;
    }

    .mood-reaction {
      display: inline-flex;
      align-items: center;
      gap: 3px;
      padding: 2px 6px;
      background: hsl(var(--muted-foreground) / 0.08);
      border-radius: 10px;
      font-size: var(--reaction-size);
    }

    .reaction-emoji {
      font-size: 12px;
    }

    .reaction-emoji-img {
      width: 14px;
      height: 14px;
      vertical-align: middle;
    }

    .mood-datetime {
      white-space: nowrap;
    }

    .mood-datetime:hover {
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    /* View more link */
    .view-more {
      display: block;
      text-align: center;
      padding: 10px;
      margin-top: 8px;
      font-size: var(--view-more-size);
      color: hsl(var(--muted-foreground));
      transition: color 0.15s ease;
    }

    .view-more:hover {
      color: hsl(var(--foreground));
    }

    .view-more::after {
      content: ' →';
    }

    .empty-state {
      text-align: center;
      padding: 32px 16px;
      color: hsl(var(--muted-foreground));
      font-size: 13px;
    }

    /* Auto theme detection */
    @media (prefers-color-scheme: dark) {
      html[data-embed-theme="auto"] {
        --background: 0 0% 4%;
        --foreground: 0 0% 100%;
        --muted: 0 0% 53%;
        --muted-foreground: 0 0% 53%;
        --border: 0 0% 20%;
        --card-bg: 0 0% 8%;
        --card-border: 0 0% 18%;
        --card-shadow: 0 0% 0% / 0.3;
      }
    }
  </style>
</head>
<body>
  {posts.length === 0 ? (
    <div class="empty-state">No moods to display</div>
  ) : (
    <>
      {posts.map((post) => {
        const previewHtml = getTextPreviewHtml(post);
        const image = getFirstImage(post.content);
        const datetime = formatDateTime(post.datetime);
        const postUrl = `/mood/${post.id}`;
        const channelUrl = '/mood';
        const initial = channelTitle.charAt(0).toUpperCase();

        return (
          <article class="embed-card">
            <header class="card-header">
              <a href={channelUrl} target="_blank" rel="noopener" class="channel-avatar">
                {channelAvatar ? (
                  <img src={channelAvatar} alt={channelTitle} />
                ) : (
                  initial
                )}
              </a>
              <div class="channel-info">
                <a href={channelUrl} target="_blank" rel="noopener" class="channel-name">
                  {channelTitle}
                </a>
              </div>
            </header>

            <div class="card-content">
              {previewHtml && (
                <div class="mood-text" set:html={previewHtml} />
              )}
              {image && (
                <img
                  class="mood-image"
                  src={image}
                  srcset={image ? buildSrcSet(image, responsiveImageWidths) : undefined}
                  sizes={embedImageSizes}
                  alt=""
                  loading="lazy"
                />
              )}
            </div>

            <footer class="card-footer">
              <div class="footer-left">
                {post.reactions && post.reactions.length > 0 && (
                  <div class="mood-reactions">
                    {post.reactions.slice(0, 4).map((reaction: any) => (
                      <span class="mood-reaction">
                        {reaction.emojiImage ? (
                          <img class="reaction-emoji-img" src={reaction.emojiImage} alt="" />
                        ) : (
                          <span class="reaction-emoji">{reaction.emoji}</span>
                        )}
                        <span>{reaction.count}</span>
                      </span>
                    ))}
                  </div>
                )}
              </div>
              <a href={postUrl} target="_blank" rel="noopener" class="mood-datetime" data-datetime={post.datetime}>
                {datetime}
              </a>
            </footer>
          </article>
        );
      })}
      {showLink && posts.length > 0 && (
        <a class="view-more" href="/mood" target="_blank" rel="noopener">
          View all moods
        </a>
      )}
    </>
  )}

  <script is:inline define:vars={{ refresh, allowedOrigin }}>
    const targetOrigin = allowedOrigin || '*';
    let lastHeight = 0;
    let rafId = 0;

    function measureHeight() {
      const doc = document.documentElement;
      const body = document.body;
      return Math.max(doc.scrollHeight, body ? body.scrollHeight : 0);
    }

    function postHeight() {
      const height = measureHeight();
      if (height === lastHeight) return;
      lastHeight = height;
      window.parent.postMessage({ type: 'mood-embed-resize', height }, targetOrigin);
    }

    function scheduleSend() {
      if (rafId) return;
      rafId = window.requestAnimationFrame(() => {
        rafId = 0;
        postHeight();
      });
    }

    // Send initial height
    scheduleSend();

    // Send height on resize
    window.addEventListener('resize', scheduleSend);

    // Track layout changes for dynamic content
    if ('ResizeObserver' in window) {
      const resizeObserver = new ResizeObserver(scheduleSend);
      resizeObserver.observe(document.documentElement);
    } else if ('MutationObserver' in window) {
      const mutationObserver = new MutationObserver(scheduleSend);
      mutationObserver.observe(document.body, {
        childList: true,
        subtree: true,
        characterData: true,
        attributes: true,
      });
    }

    // Send height after images load (or immediately if cached)
    document.querySelectorAll('img').forEach(img => {
      if (img.complete) {
        scheduleSend();
        return;
      }
      img.addEventListener('load', scheduleSend);
    });

    // Re-measure after fonts load
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(scheduleSend);
    }

    // Auto-refresh if configured
    if (refresh && refresh > 0) {
      setInterval(() => {
        window.location.reload();
      }, refresh * 1000);
    }

    // Theme sync with parent
    window.addEventListener('message', (event) => {
      if (allowedOrigin && event.origin !== allowedOrigin) {
        return;
      }
      if (event.source !== window.parent) {
        return;
      }
      if (event.data && event.data.type === 'mood-embed-theme') {
        const html = document.documentElement;
        const theme = event.data.theme;
        if (theme === 'dark') {
          html.classList.add('dark');
          html.classList.remove('light');
        } else if (theme === 'light') {
          html.classList.remove('dark');
          html.classList.add('light');
        }
      }
    });

    function formatClientDateTime(datetime) {
      const date = new Date(datetime);
      if (Number.isNaN(date.getTime())) return '';
      const now = new Date();
      const isToday = date.toDateString() === now.toDateString();
      const yesterday = new Date(now);
      yesterday.setDate(yesterday.getDate() - 1);
      const isYesterday = date.toDateString() === yesterday.toDateString();
      const time = date.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: false });

      if (isToday) return `Today at ${time}`;
      if (isYesterday) return `Yesterday at ${time}`;

      const month = date.toLocaleString('en-US', { month: 'short' });
      const day = date.getDate();
      return `${month} ${day} at ${time}`;
    }

    // Update datetimes to client locale
    document.querySelectorAll('.mood-datetime[data-datetime]').forEach((el) => {
      const value = el.getAttribute('data-datetime');
      if (!value) return;
      const text = formatClientDateTime(value);
      if (text) {
        el.textContent = text;
      }
    });
  </script>
</body>
</html>
