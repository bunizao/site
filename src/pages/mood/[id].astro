<script>
  const backButton = document.querySelector('[data-back-button]');

  if (backButton) {
    backButton.addEventListener('click', () => {
      // Check if there's a previous page in history
      if (document.referrer && document.referrer.includes('/mood')) {
        // Go back to previous page (preserves scroll position)
        window.history.back();
      } else {
        // Fallback to mood list if no referrer
        window.location.href = '/mood';
      }
    });
  }

  const createAnimatedEmojiManager = () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return {
        hydrate: (_root?: ParentNode) => {},
      };
    }

    const scriptCache = new Map<string, Promise<void>>();
    const emojiCache = new Map<string, Promise<any | null>>();
    const lottieSrc = 'https://cdn.jsdelivr.net/npm/lottie-web@5.12.2/build/player/lottie.min.js';
    const pakoSrc = 'https://cdn.jsdelivr.net/npm/pako@2.1.0/dist/pako.min.js';

    const loadScript = (src: string): Promise<void> => {
      if (scriptCache.has(src)) {
        return scriptCache.get(src) as Promise<void>;
      }

      const promise = new Promise<void>((resolve, reject) => {
        const existing = document.querySelector(`script[src="${src}"]`) as HTMLScriptElement | null;
        if (existing) {
          if (existing.dataset.loaded === 'true') {
            resolve();
            return;
          }
          existing.addEventListener('load', () => resolve(), { once: true });
          existing.addEventListener('error', () => reject(new Error(`Failed to load ${src}`)), { once: true });
          return;
        }

        const script = document.createElement('script');
        script.src = src;
        script.async = true;
        script.dataset.loaded = 'false';
        script.onload = () => {
          script.dataset.loaded = 'true';
          resolve();
        };
        script.onerror = () => reject(new Error(`Failed to load ${src}`));
        document.head.appendChild(script);
      });

      scriptCache.set(src, promise);
      return promise;
    };

    const ensureLibs = (): Promise<void> =>
      Promise.all([loadScript(lottieSrc), loadScript(pakoSrc)]).then(() => undefined);

    const getAnimationData = (emojiId: string): Promise<any | null> => {
      if (emojiCache.has(emojiId)) {
        return emojiCache.get(emojiId) as Promise<any | null>;
      }

      const promise = (async () => {
        const metaResponse = await fetch(`/static/https://t.me/i/emoji/${emojiId}.json`, { cache: 'no-store' });
        if (!metaResponse.ok) return null;
        const meta = await metaResponse.json();
        const emojiUrl = meta?.emoji;
        if (!emojiUrl) return null;
        const proxied = emojiUrl.startsWith('http') ? `/static/${emojiUrl}` : emojiUrl;
        const tgsResponse = await fetch(proxied);
        if (!tgsResponse.ok) return null;
        const buffer = await tgsResponse.arrayBuffer();
        const pako = (window as any).pako;
        if (!pako) return null;
        const bytes = new Uint8Array(buffer);
        const jsonText = new TextDecoder('utf-8').decode(pako.ungzip(bytes));
        return JSON.parse(jsonText);
      })().catch(() => null);

      emojiCache.set(emojiId, promise);
      return promise;
    };

    const hydrate = async (root: ParentNode = document): Promise<void> => {
      const nodes = Array.from(root.querySelectorAll('[data-emoji-id]')).filter((node) => {
        return node instanceof HTMLElement && !node.dataset.emojiAnimated;
      }) as HTMLElement[];

      if (!nodes.length) return;

      try {
        await ensureLibs();
      } catch {
        return;
      }
      const lottie = (window as any).lottie;
      if (!lottie) return;

      await Promise.all(
        nodes.map(async (node) => {
          const emojiId = node.dataset.emojiId;
          if (!emojiId) return;
          node.dataset.emojiAnimated = 'pending';
          const animationData = await getAnimationData(emojiId);
          if (!animationData) {
            node.dataset.emojiAnimated = 'false';
            return;
          }
          node.dataset.emojiAnimated = 'true';
          const container = document.createElement('span');
          container.className = 'tg-emoji-anim';
          node.appendChild(container);
          lottie.loadAnimation({
            container,
            renderer: 'svg',
            loop: true,
            autoplay: true,
            animationData,
            rendererSettings: {
              preserveAspectRatio: 'xMidYMid meet',
            },
          });
        })
      );
    };

    return { hydrate };
  };

  const animatedEmoji = createAnimatedEmojiManager();
  animatedEmoji.hydrate(document);

  // Comments loading functionality
  const ALWAYS_LOADING = import.meta.env.PUBLIC_DEBUG_ALWAYS_LOADING === 'true';

  const initComments = async () => {
    if (ALWAYS_LOADING) return; // Skip loading, keep skeleton visible

    const commentsSection = document.querySelector('[data-post-id]') as HTMLElement;
    if (!commentsSection) return;

    const postId = commentsSection.dataset.postId;
    if (!postId) return;

    const commentsList = document.querySelector('[data-comments-list]') as HTMLElement;
    const loadingEl = document.querySelector('[data-comments-loading]') as HTMLElement;
    const emptyEl = document.querySelector('[data-comments-empty]') as HTMLElement;
    const loadMoreBtn = document.querySelector('[data-load-more]') as HTMLButtonElement;
    const countEl = document.querySelector('[data-comments-count]') as HTMLElement;

    let nextBefore = '';
    const loadedCommentIds = new Set<string>();

    const getOldestCommentId = (comments: any[]): string => {
      let oldest: any | null = null;
      for (const comment of comments) {
        if (!comment?.datetime) continue;
        const currentTime = Date.parse(comment.datetime);
        if (Number.isNaN(currentTime)) continue;
        if (!oldest) {
          oldest = comment;
          continue;
        }
        const oldestTime = Date.parse(oldest.datetime);
        if (Number.isNaN(oldestTime) || currentTime < oldestTime) {
          oldest = comment;
        }
      }
      return oldest?.id || comments[0]?.id || '';
    };

    const formatDate = (datetime: string): string => {
      const date = new Date(datetime);
      const now = new Date();
      const diffMs = now.getTime() - date.getTime();
      const diffMins = Math.floor(diffMs / 60000);
      const diffHours = Math.floor(diffMs / 3600000);
      const diffDays = Math.floor(diffMs / 86400000);

      if (diffMins < 1) return 'just now';
      if (diffMins < 60) return `${diffMins}m ago`;
      if (diffHours < 24) return `${diffHours}h ago`;
      if (diffDays < 7) return `${diffDays}d ago`;
      return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    };

    const getInitials = (name: string): string => {
      return name.split(' ').map(n => n[0]).slice(0, 2).join('').toUpperCase() || '?';
    };

    const renderComment = (comment: any): string => {
      const avatarContent = comment.authorAvatar
        ? `<img src="${comment.authorAvatar}" alt="${comment.author}" loading="lazy" />`
        : getInitials(comment.author);

      const reactionsHtml = comment.reactions?.length
        ? `<div class="mood-comment-reactions">
            ${comment.reactions.map((r: any) => `
              <span class="mood-reaction${r.isPaid ? ' mood-reaction--paid' : ''}">
                <span class="mood-reaction-emoji">${r.isPaid ? '⭐' : r.emoji || '👍'}</span>
                <span class="mood-reaction-count">${r.count}</span>
              </span>
            `).join('')}
          </div>`
        : '';

      return `
        <div class="mood-comment" data-comment-id="${comment.id}">
          <div class="mood-comment-avatar">${avatarContent}</div>
          <div class="mood-comment-body">
            <div class="mood-comment-header">
              <span class="mood-comment-author">${comment.author}</span>
              <time class="mood-comment-date" datetime="${comment.datetime}">${formatDate(comment.datetime)}</time>
            </div>
            <div class="mood-comment-content">${comment.content}</div>
            ${reactionsHtml}
          </div>
        </div>
      `;
    };

    const addComments = (comments: any[], append: boolean): number => {
      if (!append) {
        loadedCommentIds.clear();
      }

      const uniqueComments = comments.filter((comment) => {
        if (!comment?.id) return false;
        if (loadedCommentIds.has(comment.id)) return false;
        loadedCommentIds.add(comment.id);
        return true;
      });

      const html = uniqueComments.map(renderComment).join('');

      if (append) {
        if (html) {
          commentsList.insertAdjacentHTML('beforeend', html);
        }
      } else {
        commentsList.innerHTML = html;
      }

      return uniqueComments.length;
    };

    const loadComments = async (before = ''): Promise<void> => {
      try {
        const url = `/api/comments?postId=${postId}${before ? `&before=${before}` : ''}`;
        const response = await fetch(url);
        const data = await response.json();

        if (data.comments?.length > 0) {
          if (emptyEl) emptyEl.hidden = true;

          // Add comments first, then remove skeleton to prevent layout shift
          const addedCount = addComments(data.comments, Boolean(before));

          // Remove skeleton after comments are rendered
          if (loadingEl) loadingEl.remove();

          // Update count
          if (countEl) countEl.textContent = String(loadedCommentIds.size);

          const previousCursor = nextBefore;
          const fallbackCursor = getOldestCommentId(data.comments);
          nextBefore = data.nextBefore || fallbackCursor || '';

          // Show/hide load more button
          const canLoadMore = Boolean(data.hasMore && nextBefore && nextBefore !== previousCursor);
          if (loadMoreBtn) loadMoreBtn.hidden = !canLoadMore;

          if (before && addedCount === 0) {
            nextBefore = '';
            if (loadMoreBtn) loadMoreBtn.hidden = true;
          }

          // Hydrate animated emojis in new comments
          animatedEmoji.hydrate(commentsList);
        } else if (!before) {
          // No comments on initial load - clear list and show empty state
          commentsList.innerHTML = '';
          if (emptyEl) emptyEl.hidden = false;
          if (loadMoreBtn) loadMoreBtn.hidden = true;
        } else if (before) {
          nextBefore = '';
          if (loadMoreBtn) loadMoreBtn.hidden = true;
        }
      } catch (error) {
        console.error('Failed to load comments:', error);
        if (loadingEl) loadingEl.remove();
        if (!before && emptyEl) {
          commentsList.innerHTML = '';
          emptyEl.querySelector('p')!.textContent = 'Failed to load comments';
          emptyEl.hidden = false;
        }
      }
    };

    // Load more button handler
    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', async () => {
        if (!nextBefore) {
          loadMoreBtn.hidden = true;
          return;
        }
        loadMoreBtn.disabled = true;
        loadMoreBtn.textContent = 'Loading...';
        await loadComments(nextBefore);
        loadMoreBtn.disabled = false;
        loadMoreBtn.textContent = 'Load more comments';
      });
    }

    // Initial load
    await loadComments();
  };

  initComments();
</script>
