---
import Layout from '../../layouts/Layout.astro';
import dayjs from 'dayjs';
import { getChannelInfo, type Post } from '../../lib/telegram';

export const prerender = false;

const { id } = Astro.params;
let post: Post | null = null;
let error = false;

try {
  if (id) {
    post = await getChannelInfo(Astro, { id }) as Post;
  }
} catch (e) {
  console.error('Failed to fetch mood:', e);
  error = true;
}

if (!post) {
  Astro.response.status = 404;
}

const title = post ? `${post.title} | Moods` : 'Mood not found | Moods';
const description = post ? post.text.slice(0, 160) : 'Mood not found.';
---

<Layout title={title} description={description}>
  <main class="page-container">
    {post ? (
      <article class="mood-post">
        <div class="mood-post-header">
          <button type="button" class="back-link" data-back-button>← Back to Moods</button>
          <div class="mood-post-meta">
            <time datetime={post.datetime} class="mood-post-date">
              {dayjs(post.datetime).format('MMMM D, YYYY · HH:mm')}
            </time>
            {post.tags.length > 0 && (
              <div class="mood-post-tags">
                {post.tags.map((tag) => (
                  <span class="mood-post-tag">#{tag}</span>
                ))}
              </div>
            )}
          </div>
        </div>

        <div class="mood-post-content" set:html={post.content} />
      </article>
    ) : (
      <article class="mood-post">
        <div class="mood-post-header">
          <a href="/mood" class="back-link">← Back to Moods</a>
          <div class="mood-post-meta">
            <time class="mood-post-date">Unavailable</time>
          </div>
        </div>
        <p class="text-sm text-muted-foreground">
          {error ? 'Unable to load this mood right now.' : 'This mood could not be found.'}
        </p>
      </article>
    )}
  </main>
</Layout>

<style>
  .mood-post {
    padding: 80px 0 60px;
    max-width: 680px;
    margin: 0 auto;
  }

  @media (min-width: 640px) {
    .mood-post {
      padding: 100px 0 80px;
    }
  }

  .mood-post-header {
    margin-bottom: 32px;
  }

  @media (min-width: 640px) {
    .mood-post-header {
      margin-bottom: 40px;
    }
  }

  .back-link {
    display: inline-block;
    font-size: 13px;
    color: hsl(var(--muted-foreground));
    margin-bottom: 20px;
    transition: color 0.15s ease;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: inherit;
  }

  .back-link:hover {
    color: hsl(var(--foreground));
  }

  .mood-post-meta {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .mood-post-date {
    font-size: 13px;
    color: hsl(var(--muted-foreground));
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 640px) {
    .mood-post-date {
      font-size: 14px;
    }
  }

  .mood-post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .mood-post-tag {
    font-size: 12px;
    color: hsl(var(--muted-foreground) / 0.7);
    padding: 4px 10px;
    background: hsl(var(--foreground) / 0.05);
    border-radius: 4px;
    transition: all 0.15s ease;
  }

  .mood-post-tag:hover {
    background: hsl(var(--foreground) / 0.1);
    color: hsl(var(--muted-foreground));
  }

  /* Content Styles */
  .mood-post-content {
    font-size: 15px;
    line-height: 1.7;
    color: hsl(var(--foreground));
  }

  @media (min-width: 640px) {
    .mood-post-content {
      font-size: 16px;
      line-height: 1.8;
    }
  }

  /* Typography */
  .mood-post-content :global(p) {
    margin-bottom: 1.2em;
  }

  .mood-post-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .mood-post-content :global(a) {
    color: hsl(var(--foreground));
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.15s ease;
  }

  .mood-post-content :global(a:hover) {
    opacity: 0.7;
  }

  .mood-post-content :global(strong) {
    font-weight: 600;
  }

  .mood-post-content :global(em) {
    font-style: italic;
  }

  /* Blockquotes (replies) */
  .mood-post-content :global(blockquote) {
    margin: 1.5em 0;
    padding: 14px 16px;
    border-left: 3px solid hsl(var(--foreground) / 0.15);
    background: hsl(var(--foreground) / 0.04);
    border-radius: 0 6px 6px 0;
    font-size: 14px;
    color: hsl(var(--muted-foreground));
    position: relative;
  }

  .mood-post-content :global(blockquote::before) {
    content: '';
    position: absolute;
    left: -3px;
    top: 0;
    width: 3px;
    height: 100%;
    background: linear-gradient(
      to bottom,
      hsl(var(--foreground) / 0.3),
      hsl(var(--foreground) / 0.1)
    );
    border-radius: 3px 0 0 3px;
  }

  .mood-post-content :global(blockquote small) {
    display: block;
    line-height: 1.5;
  }

  .mood-post-content :global(blockquote p) {
    margin: 0;
  }

  /* Images */
  .mood-post-content :global(.image-list-container) {
    margin: 1.5em 0;
    display: grid;
    gap: 8px;
  }

  .mood-post-content :global(.image-list-even) {
    grid-template-columns: repeat(2, 1fr);
  }

  .mood-post-content :global(.image-list-odd) {
    grid-template-columns: 1fr;
  }

  .mood-post-content :global(.image-preview-wrap) {
    width: 100%;
    border: none;
    background: none;
    padding: 0;
    cursor: default;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    justify-content: center;
    pointer-events: none;
    transition: none;
  }

  .mood-post-content :global(.image-preview-wrap:hover) {
    transform: none;
  }

  .mood-post-content :global(.image-preview-wrap img) {
    width: 100%;
    max-width: var(--image-width, 100%);
    height: auto;
    display: block;
    margin: 0 auto;
  }

  .mood-post-content :global(.modal) {
    display: none;
    border: none;
    background: hsl(var(--background) / 0.95);
    backdrop-filter: blur(10px);
    padding: 20px;
    max-width: 90vw;
    max-height: 90vh;
    border-radius: 12px;
  }

  .mood-post-content :global(.modal-img) {
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
  }

  @media (min-width: 900px) {
    .mood-post-content :global(.image-preview-wrap img) {
      width: auto;
      max-width: var(--image-width, 100%);
      max-height: 70vh;
    }
  }

  /* Videos */
  .mood-post-content :global(video) {
    width: 100%;
    max-width: 100%;
    height: auto;
    margin: 1.5em 0;
    border-radius: 8px;
    background: hsl(var(--foreground) / 0.05);
  }

  /* Audio */
  .mood-post-content :global(audio) {
    width: 100%;
    margin: 1.5em 0;
  }

  /* Stickers */
  .mood-post-content :global(.sticker) {
    max-width: 256px;
    height: auto;
    margin: 1em 0;
  }

  /* Code blocks */
  .mood-post-content :global(pre) {
    margin: 1.5em 0;
    padding: 16px;
    background: hsl(var(--foreground) / 0.05);
    border-radius: 8px;
    overflow-x: auto;
    font-size: 13px;
    line-height: 1.6;
  }

  @media (min-width: 640px) {
    .mood-post-content :global(pre) {
      padding: 20px;
      font-size: 14px;
    }
  }

  .mood-post-content :global(pre code) {
    background: none;
    padding: 0;
    font-family: 'JetBrains Mono', monospace;
  }

  .mood-post-content :global(code) {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9em;
    background: hsl(var(--foreground) / 0.08);
    padding: 2px 6px;
    border-radius: 4px;
  }

  /* Bookmark cards */
  .mood-post-content :global(.bookmark-card) {
    display: flex;
    flex-direction: column;
    gap: 0;
    max-width: 480px;
    margin: 1.5em 0;
    border: 1px solid hsl(var(--foreground) / 0.12);
    border-radius: 10px;
    background: hsl(var(--background));
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .mood-post-content :global(.bookmark-card:hover) {
    border-color: hsl(var(--foreground) / 0.2);
  }

  .mood-post-content :global(.bookmark-card:focus-visible) {
    outline: 2px solid hsl(var(--foreground) / 0.35);
    outline-offset: 2px;
  }

  .mood-post-content :global(.bookmark-card__media) {
    width: 100%;
    background: hsl(var(--foreground) / 0.04);
  }

  .mood-post-content :global(.bookmark-card__media img) {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: 1.91 / 1;
  }

  .mood-post-content :global(.bookmark-card__content) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 14px;
    min-width: 0;
  }

  .mood-post-content :global(.bookmark-card__title) {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    overflow: hidden;
  }

  .mood-post-content :global(.bookmark-card__description) {
    font-size: 13px;
    color: hsl(var(--muted-foreground));
    line-height: 1.4;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .mood-post-content :global(.bookmark-card__meta) {
    font-size: 12px;
    color: hsl(var(--muted-foreground) / 0.6);
    margin-top: 2px;
  }

  /* Spoilers */
  .mood-post-content :global(.spoiler-button) {
    cursor: pointer;
    user-select: none;
  }

  .mood-post-content :global(.spoiler-button input[type="checkbox"]) {
    display: none;
  }

  .mood-post-content :global(.spoiler-button tg-spoiler) {
    background: hsl(var(--foreground) / 0.8);
    color: transparent;
    border-radius: 4px;
    padding: 0 4px;
    transition: all 0.2s ease;
  }

  .mood-post-content :global(.spoiler-button input[type="checkbox"]:checked + tg-spoiler) {
    background: transparent;
    color: inherit;
  }

  /* Polls */
  .mood-post-content :global(.tgme_widget_message_poll) {
    margin: 1.5em 0;
    padding: 16px;
    border: 1px solid hsl(var(--foreground) / 0.1);
    border-radius: 8px;
  }

  /* Documents */
  .mood-post-content :global(.tgme_widget_message_document_wrap) {
    margin: 1.5em 0;
    padding: 14px 16px;
    border: 1px solid hsl(var(--foreground) / 0.12);
    border-radius: 12px;
    display: flex;
    align-items: center;
    gap: 14px;
    background: hsl(var(--background));
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .mood-post-content :global(.tgme_widget_message_document_wrap:hover) {
    border-color: hsl(var(--foreground) / 0.2);
    box-shadow: 0 12px 30px hsl(var(--foreground) / 0.05);
  }

  .mood-post-content :global(.tgme_widget_message_document_icon) {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: hsl(var(--foreground) / 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    position: relative;
  }

  .mood-post-content :global(.tgme_widget_message_document_icon.audio::before) {
    content: '';
    border-left: 10px solid hsl(var(--foreground) / 0.7);
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
    margin-left: 2px;
  }

  .mood-post-content :global(.tgme_widget_message_document) {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .mood-post-content :global(.tgme_widget_message_document_title) {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
  }

  .mood-post-content :global(.tgme_widget_message_document_extra) {
    font-size: 13px;
    color: hsl(var(--muted-foreground));
    line-height: 1.5;
  }

  /* Animations */
  .mood-post {
    animation: fade-in 0.5s ease-out;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<style is:global>
  /* Prism.js syntax highlighting theme (matching site colors) */
  .token.comment,
  .token.prolog,
  .token.doctype,
  .token.cdata {
    color: hsl(var(--muted-foreground) / 0.6);
  }

  .token.punctuation {
    color: hsl(var(--foreground) / 0.7);
  }

  .token.property,
  .token.tag,
  .token.boolean,
  .token.number,
  .token.constant,
  .token.symbol,
  .token.deleted {
    color: hsl(var(--foreground));
  }

  .token.selector,
  .token.attr-name,
  .token.string,
  .token.char,
  .token.builtin,
  .token.inserted {
    color: hsl(var(--foreground) / 0.9);
  }

  .token.operator,
  .token.entity,
  .token.url,
  .language-css .token.string,
  .style .token.string {
    color: hsl(var(--foreground) / 0.8);
  }

  .token.atrule,
  .token.attr-value,
  .token.keyword {
    color: hsl(var(--foreground));
    font-weight: 500;
  }

  .token.function,
  .token.class-name {
    color: hsl(var(--foreground));
    font-weight: 600;
  }

  .token.regex,
  .token.important,
  .token.variable {
    color: hsl(var(--foreground) / 0.9);
  }
</style>

<script>
  const backButton = document.querySelector('[data-back-button]');

  if (backButton) {
    backButton.addEventListener('click', () => {
      // Check if there's a previous page in history
      if (document.referrer && document.referrer.includes('/mood')) {
        // Go back to previous page (preserves scroll position)
        window.history.back();
      } else {
        // Fallback to mood list if no referrer
        window.location.href = '/mood';
      }
    });
  }
</script>
