---
import Layout from '../../layouts/Layout.astro';
import dayjs from 'dayjs';
import { getChannelInfo, type Post } from '../../lib/telegram';

export const prerender = false;

const { id } = Astro.params;

// Handle embed mode by redirecting to embed page
const isEmbed = Astro.url.searchParams.has('embed');
if (isEmbed && id) {
  const rawTheme = Astro.url.searchParams.get('theme') || 'auto';
  const theme = ['light', 'dark', 'auto'].includes(rawTheme) ? rawTheme : 'auto';
  const embedUrl = new URL('/mood/embed', Astro.url);
  embedUrl.searchParams.set('id', id);
  embedUrl.searchParams.set('theme', theme);
  embedUrl.searchParams.set('link', 'false');
  return Astro.redirect(`${embedUrl.pathname}${embedUrl.search}`);
}

let post: Post | null = null;
let error = false;

try {
  if (id) {
    post = await getChannelInfo(Astro, { id }) as Post;
  }
} catch (e) {
  console.error('Failed to fetch mood:', e);
  error = true;
}

if (!post) {
  Astro.response.status = 404;
}

const canonicalUrl = new URL(Astro.url.pathname, Astro.url.origin).href;
const oembed = id
  ? { href: `/api/oembed.json?url=${encodeURIComponent(canonicalUrl)}`, title: 'Mood Embed' }
  : undefined;
const title = post ? `${post.title} | Moods` : 'Mood not found | Moods';
const description = post ? post.text.slice(0, 160) : 'Mood not found.';
const channel = import.meta.env.CHANNEL || Astro.locals?.runtime?.env?.CHANNEL || '';
const telegramCommentUrl = channel && id ? `https://t.me/${channel}/${id}?comment=1` : '';
---

<Layout title={title} description={description} oembed={oembed}>
  <main class="page-container">
    {post ? (
      <article class="mood-post">
        <div class="mood-post-header">
          <button type="button" class="back-link" data-back-button>← Back to Moods</button>
          <div class="mood-post-meta">
            <time datetime={post.datetime} class="mood-post-date">
              {dayjs(post.datetime).format('MMMM D, YYYY · HH:mm')}
            </time>
            {post.tags.length > 0 && (
              <div class="mood-post-tags">
                {post.tags.map((tag) => (
                  <span class="mood-post-tag">#{tag}</span>
                ))}
              </div>
            )}
            {post.forwardedFrom && (
              <div class="mood-post-forwarded">
                <span class="mood-forwarded-label">Forwarded from</span>
                {post.forwardedFrom.href ? (
                  <a
                    class="mood-forwarded-source"
                    href={post.forwardedFrom.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {post.forwardedFrom.name}
                  </a>
                ) : (
                  <span class="mood-forwarded-source">{post.forwardedFrom.name}</span>
                )}
                {post.forwardedFrom.author && post.forwardedFrom.author !== post.forwardedFrom.name && (
                  <span class="mood-forwarded-author">({post.forwardedFrom.author})</span>
                )}
              </div>
            )}
          </div>
        </div>

        <div class="mood-post-content" set:html={post.content} />
        {post.reactions.length > 0 && (
          <div class="mood-post-reactions" aria-label="Reactions">
            {post.reactions.map((reaction) => (
              <span class={reaction.isPaid ? 'mood-reaction mood-reaction--paid' : 'mood-reaction'}>
                <span class="mood-reaction-emoji">
                  {reaction.isPaid ? (
                    '⭐'
                  ) : reaction.emojiImage || reaction.emojiId ? (
                    <span class="tg-emoji" data-emoji-id={reaction.emojiId}>
                      {reaction.emojiImage ? (
                        <img
                          src={reaction.emojiImage}
                          alt={reaction.emoji || 'emoji'}
                          loading="lazy"
                          decoding="async"
                          width={16}
                          height={16}
                        />
                      ) : (
                        reaction.emoji
                      )}
                    </span>
                  ) : (
                    reaction.emoji
                  )}
                </span>
                <span class="mood-reaction-count">{reaction.count}</span>
              </span>
            ))}
          </div>
        )}

        <!-- Comments Section -->
        <section class="mood-comments" data-post-id={id}>
          <div class="mood-comments-header">
            <span class="mood-comments-title">Comments</span>
            <span class="mood-comments-count" data-comments-count></span>
          </div>
          <div class="mood-comments-list" data-comments-list>
            <div class="mood-comments-skeleton" data-comments-loading>
              <div class="mood-comment mood-comment--skeleton" style="--skeleton-delay: 0s;">
                <div class="mood-comment-avatar mood-comment-avatar--skeleton" aria-hidden="true"></div>
                <div class="mood-comment-body">
                  <div class="mood-comment-header">
                    <span
                      class="mood-comment-skeleton-line mood-comment-skeleton-line--author"
                      style="--line-width: 100px;"
                    ></span>
                    <span
                      class="mood-comment-skeleton-line mood-comment-skeleton-line--date"
                      style="--line-width: 49px;"
                    ></span>
                  </div>
                  <div class="mood-comment-content mood-comment-content--skeleton">
                    <span
                      class="mood-comment-skeleton-line mood-comment-skeleton-line--content"
                      style="--line-width: 34px;"
                    ></span>
                  </div>
                </div>
              </div>
              <div class="mood-comment mood-comment--skeleton" style="--skeleton-delay: 0.15s;">
                <div class="mood-comment-avatar mood-comment-avatar--skeleton" aria-hidden="true"></div>
                <div class="mood-comment-body">
                  <div class="mood-comment-header">
                    <span
                      class="mood-comment-skeleton-line mood-comment-skeleton-line--author"
                      style="--line-width: 85px;"
                    ></span>
                    <span
                      class="mood-comment-skeleton-line mood-comment-skeleton-line--date"
                      style="--line-width: 55px;"
                    ></span>
                  </div>
                  <div class="mood-comment-content mood-comment-content--skeleton">
                    <span
                      class="mood-comment-skeleton-line mood-comment-skeleton-line--content"
                      style="--line-width: 120px;"
                    ></span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="mood-comments-empty" data-comments-empty hidden>
            <p>No comments here yet...</p>
          </div>
          {telegramCommentUrl && (
            <a
              href={telegramCommentUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mood-comment mood-comment-cta-wrap"
            >
              <div class="mood-comment-avatar mood-comment-avatar--telegram"></div>
              <div class="mood-comment-body">
                <div class="mood-comment-header">
                  <span class="mood-comment-author">Telegram</span>
                  <span class="mood-comment-date">now</span>
                </div>
                <div class="mood-comment-content mood-comment-cta-content">
                  <span>Leave a comment</span>
                  <svg class="mood-comment-cta-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="7" y1="17" x2="17" y2="7"></line>
                    <polyline points="7 7 17 7 17 17"></polyline>
                  </svg>
                </div>
              </div>
            </a>
          )}
        </section>
      </article>
    ) : (
      <article class="mood-post">
        <div class="mood-post-header">
          <a href="/mood" class="back-link">← Back to Moods</a>
          <div class="mood-post-meta">
            <time class="mood-post-date">Unavailable</time>
          </div>
        </div>
        <p class="text-sm text-muted-foreground">
          {error ? 'Unable to load this mood right now.' : 'This mood could not be found.'}
        </p>
      </article>
    )}
  </main>
</Layout>

<style>
  .mood-post {
    padding: 80px 0 60px;
    max-width: 680px;
    margin: 0 auto;
  }

  @media (min-width: 640px) {
    .mood-post {
      padding: 100px 0 80px;
    }
  }

  @media (min-width: 1024px) {
    .mood-post {
      padding: 120px 0 100px;
      max-width: 720px;
    }
  }

  /* Mobile-first refinements for mood detail */
  @media (max-width: 540px) {
    .mood-post {
      padding: 48px 0 32px;
    }

    .mood-post-header {
      margin-bottom: 32px;
      padding-bottom: 16px;
    }

    .back-link {
      margin-bottom: 14px;
      font-size: 12px;
      letter-spacing: 0.01em;
      opacity: 0.7;
    }

    .back-link:hover {
      opacity: 1;
    }

    .mood-post-meta {
      gap: 8px;
    }

    .mood-post-date {
      font-size: 12px;
      letter-spacing: 0.01em;
    }

    .mood-post-tags {
      gap: 6px;
      margin-top: 0;
    }

    .mood-post-tag {
      font-size: 11px;
      padding: 4px 8px;
      border-radius: 5px;
    }

    .mood-post-forwarded {
      font-size: 11px;
      gap: 6px;
      padding: 4px 0;
    }

    .mood-forwarded-label {
      font-size: 9px;
    }

    .mood-post-content {
      font-size: 18px;
      line-height: 1.75;
      margin-top: 0;
    }

    .mood-post-content :global(p) {
      margin-bottom: 1.25em;
    }

    .mood-post-reactions {
      margin-top: 32px;
      padding-top: 12px;
      gap: 6px;
    }

    .mood-reaction {
      padding: 5px 10px 5px 8px;
      font-size: 11px;
      gap: 3px;
      min-height: 28px;
    }

    .mood-reaction-emoji {
      font-size: 12px;
    }

    .mood-reaction-count {
      font-size: 10px;
    }

    .mood-post-content :global(blockquote) {
      margin: 1.25em 0;
      padding: 10px 12px;
      font-size: 13px;
      line-height: 1.55;
      border-radius: 0 6px 6px 0;
    }

    .mood-post-content :global(pre) {
      margin: 1.25em 0;
      padding: 12px;
      font-size: 12px;
      border-radius: 8px;
    }

    .mood-post-content :global(.image-list-container) {
      margin: 1.25em 0;
      gap: 6px;
    }

    .mood-post-content :global(.image-preview-wrap) {
      border-radius: 10px;
    }

    .mood-post-content :global(.image-preview-wrap--portrait) {
      max-width: 85%;
    }

    .mood-post-content :global(.image-preview-wrap--ultra-tall) {
      max-width: 70%;
    }

    .mood-post-content :global(video) {
      margin: 1.25em 0;
      border-radius: 10px;
    }

    .mood-post-content :global(.bookmark-card) {
      max-width: 100%;
      margin: 1em 0;
      border-radius: 10px;
    }

    .mood-post-content :global(.bookmark-card__content) {
      padding: 10px 12px;
    }

    .mood-post-content :global(.bookmark-card__title) {
      font-size: 13px;
    }

    .mood-post-content :global(.bookmark-card__description) {
      font-size: 12px;
      -webkit-line-clamp: 2;
    }

    .mood-post-content :global(.bookmark-card__meta) {
      font-size: 11px;
    }

    .mood-post-content :global(.tgme_widget_message_document_wrap) {
      margin: 1em 0;
      padding: 10px 12px;
      gap: 10px;
      border-radius: 10px;
    }

    .mood-post-content :global(.tgme_widget_message_document_icon) {
      width: 38px;
      height: 38px;
      border-radius: 8px;
    }

    .mood-post-content :global(.tgme_widget_message_document_title) {
      font-size: 13px;
    }

    .mood-post-content :global(.tgme_widget_message_document_extra) {
      font-size: 12px;
    }

    .mood-post-content :global(.sticker) {
      max-width: 200px;
    }

    .mood-post-content :global(code) {
      font-size: 0.85em;
      padding: 1px 5px;
    }
  }

  /* Extra small screens */
  @media (max-width: 380px) {
    .mood-post {
      padding: 44px 0 28px;
    }

    .mood-post-header {
      margin-bottom: 28px;
      padding-bottom: 12px;
    }

    .back-link {
      margin-bottom: 12px;
      font-size: 11px;
    }

    .mood-post-date {
      font-size: 11px;
    }

    .mood-post-tag {
      font-size: 10px;
      padding: 3px 7px;
    }

    .mood-post-content {
      font-size: 14px;
      line-height: 1.65;
    }

    .mood-reaction {
      padding: 4px 8px 4px 6px;
      font-size: 10px;
      min-height: 26px;
    }

    .mood-post-reactions {
      margin-top: 28px;
    }
  }

  .mood-post-header {
    margin-bottom: 48px;
    padding-bottom: 20px;
    border-bottom: 1px solid hsl(var(--foreground) / 0.06);
  }

  @media (min-width: 640px) {
    .mood-post-header {
      margin-bottom: 56px;
      padding-bottom: 24px;
    }
  }

  @media (min-width: 1024px) {
    .mood-post-header {
      margin-bottom: 64px;
      padding-bottom: 28px;
    }
  }

  .back-link {
    display: inline-block;
    font-size: 13px;
    color: hsl(var(--muted-foreground));
    margin-bottom: 28px;
    transition: color 0.15s ease;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: inherit;
  }

  @media (min-width: 640px) {
    .back-link {
      margin-bottom: 32px;
    }
  }

  .back-link:hover {
    color: hsl(var(--foreground));
  }

  .mood-post-meta {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  @media (min-width: 640px) {
    .mood-post-meta {
      gap: 18px;
    }
  }

  .mood-post-date {
    font-size: 13px;
    color: hsl(var(--muted-foreground));
    font-variant-numeric: tabular-nums;
    line-height: 1.5;
  }

  @media (min-width: 640px) {
    .mood-post-date {
      font-size: 14px;
    }
  }

  .mood-post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 2px;
  }

  .mood-post-tag {
    font-size: 12px;
    color: hsl(var(--muted-foreground) / 0.7);
    padding: 5px 12px;
    background: hsl(var(--foreground) / 0.06);
    border-radius: 6px;
    transition: all 0.15s ease;
    border: 1px solid transparent;
  }

  .mood-post-tag:hover {
    background: hsl(var(--foreground) / 0.1);
    color: hsl(var(--muted-foreground));
    border-color: hsl(var(--foreground) / 0.12);
  }

  .mood-post-forwarded {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: hsl(var(--muted-foreground));
    padding: 6px 0;
  }

  .mood-forwarded-label {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 10px;
    color: hsl(var(--muted-foreground) / 0.7);
  }

  .mood-forwarded-source {
    font-weight: 500;
    color: hsl(var(--foreground) / 0.85);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .mood-forwarded-source:hover,
  .mood-forwarded-source:focus-visible {
    border-bottom-color: hsl(var(--foreground) / 0.35);
  }

  .mood-forwarded-author {
    color: hsl(var(--muted-foreground) / 0.7);
  }

  .mood-post-reactions {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
    padding-top: 0;
    border-top: none;
  }

  @media (min-width: 640px) {
    .mood-post-reactions {
      margin-top: 32px;
      padding-top: 0;
    }
  }

  .mood-reaction {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px 4px 8px;
    font-size: 11px;
    background: hsl(var(--foreground) / 0.06);
    border-radius: 999px;
    color: hsl(var(--muted-foreground));
    transition: all 0.15s ease;
    border: 1px solid transparent;
  }

  .mood-reaction:hover {
    background: hsl(var(--foreground) / 0.1);
    border-color: hsl(var(--foreground) / 0.12);
    transform: translateY(-1px);
  }

  .mood-reaction--paid {
    background: hsl(45 100% 50% / 0.08);
    color: hsl(45 70% 40%);
  }

  .mood-reaction--paid:hover {
    background: hsl(45 100% 50% / 0.12);
    border-color: hsl(45 100% 50% / 0.2);
  }

  .mood-reaction-emoji {
    display: inline-flex;
    align-items: center;
    font-size: 13px;
    line-height: 1;
  }

  .mood-reaction-emoji img {
    width: 1em;
    height: 1em;
    display: block;
  }

  .mood-post-reactions .tg-emoji {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.15em;
    height: 1.15em;
    vertical-align: -0.15em;
  }

  .mood-post-reactions .tg-emoji img {
    width: 100%;
    height: 100%;
    display: block;
  }

  .mood-post-reactions .tg-emoji[data-emoji-animated="true"] img {
    display: none;
  }

  .mood-post-reactions :global(.tg-emoji-anim),
  .mood-post-reactions :global(.tg-emoji-anim svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .mood-reaction-count {
    font-size: 11px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    opacity: 0.8;
  }

  /* Content Styles */
  .mood-post-content {
    font-size: 16px;
    line-height: 1.8;
    color: hsl(var(--foreground));
    margin-top: 8px;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  @media (min-width: 640px) {
    .mood-post-content {
      font-size: 17px;
      line-height: 1.85;
      margin-top: 12px;
    }
  }

  @media (min-width: 1024px) {
    .mood-post-content {
      font-size: 18px;
      line-height: 1.9;
    }
  }

  /* Typography */
  .mood-post-content :global(p) {
    margin-bottom: 1.5em;
  }

  .mood-post-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .mood-post-content :global(a) {
    color: hsl(var(--foreground));
    text-decoration: none;
    border-bottom: 1px solid hsl(var(--foreground) / 0.35);
    padding-bottom: 1px;
    transition: border-color 0.15s ease, color 0.15s ease;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .mood-post-content :global(a:hover),
  .mood-post-content :global(a:focus-visible) {
    border-bottom-color: hsl(var(--foreground) / 0.6);
  }

  .mood-post-content :global(strong) {
    font-weight: 600;
  }

  .mood-post-content :global(em) {
    font-style: italic;
  }

  .mood-post-content :global(.tg-emoji) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.15em;
    height: 1.15em;
    vertical-align: -0.15em;
  }

  .mood-post-content :global(.tg-emoji img) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .mood-post-content :global(.tg-emoji[data-emoji-animated="true"] img) {
    display: none;
  }

  .mood-post-content :global(.tg-emoji-anim),
  .mood-post-content :global(.tg-emoji-anim svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Blockquotes (replies/quotes) */
  .mood-post-content :global(blockquote) {
    margin: 1.5em 0;
    padding: 16px 20px;
    border-left: 3px solid hsl(var(--foreground) / 0.15);
    background: hsl(var(--foreground) / 0.04);
    border-radius: 0 8px 8px 0;
    font-size: 15px;
    line-height: 1.65;
    color: hsl(var(--muted-foreground));
    position: relative;
  }

  @media (min-width: 640px) {
    .mood-post-content :global(blockquote) {
      padding: 18px 24px;
      font-size: 16px;
      line-height: 1.7;
      border-radius: 0 10px 10px 0;
    }
  }

  .mood-post-content :global(blockquote::before) {
    content: '';
    position: absolute;
    left: -3px;
    top: 0;
    width: 3px;
    height: 100%;
    background: linear-gradient(
      to bottom,
      hsl(var(--foreground) / 0.3),
      hsl(var(--foreground) / 0.1)
    );
    border-radius: 3px 0 0 3px;
  }

  .mood-post-content :global(blockquote small) {
    display: block;
    line-height: 1.5;
  }

  .mood-post-content :global(blockquote p) {
    margin: 0;
  }

  /* Images */
  .mood-post-content :global(.image-list-container) {
    margin: 1.5em 0;
    display: grid;
    gap: 8px;
  }

  .mood-post-content :global(.image-list-even) {
    grid-template-columns: repeat(2, 1fr);
  }

  .mood-post-content :global(.image-list-odd) {
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .mood-post-content :global(.image-list-container) {
      gap: 12px;
    }
  }

  .mood-post-content :global(.image-preview-wrap) {
    width: 100%;
    border: none;
    background: none;
    padding: 0;
    cursor: default;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    justify-content: center;
    pointer-events: none;
    transition: none;
    background: hsl(var(--foreground) / 0.02);
    max-width: 100%;
  }

  @media (min-width: 640px) {
    .mood-post-content :global(.image-preview-wrap) {
      border-radius: 16px;
    }
  }

  .mood-post-content :global(.image-preview-wrap:hover) {
    transform: none;
  }

  .mood-post-content :global(.image-preview-wrap img) {
    width: 100%;
    max-width: 100%;
    height: auto;
    display: block;
    margin: 0 auto;
    background: hsl(var(--foreground) / 0.01);
    /* Reserve space using aspect-ratio to prevent layout shift */
    aspect-ratio: var(--image-width, 1) / var(--image-height, 1);
  }

  .mood-post-content :global(.image-preview-wrap img[width][height]) {
    aspect-ratio: attr(width) / attr(height);
  }

  /* Portrait images in detail view - better constraint */
  .mood-post-content :global(.image-preview-wrap--portrait) {
    max-width: 400px;
    margin: 0 auto;
    background: hsl(var(--foreground) / 0.03);
  }

  .mood-post-content :global(.image-preview-wrap--portrait img) {
    max-height: 60vh;
    width: auto;
    object-fit: contain;
  }

  /* Ultra-tall images in detail view */
  .mood-post-content :global(.image-preview-wrap--ultra-tall) {
    max-width: 300px;
    margin: 0 auto;
    background: hsl(var(--foreground) / 0.04);
  }

  .mood-post-content :global(.image-preview-wrap--ultra-tall img) {
    max-height: 70vh;
    width: auto;
    object-fit: contain;
  }

  .mood-post-content :global(.modal) {
    display: none;
    border: none;
    background: hsl(var(--background) / 0.95);
    backdrop-filter: blur(10px);
    padding: 20px;
    max-width: 90vw;
    max-height: 90vh;
    border-radius: 12px;
  }

  .mood-post-content :global(.modal-img) {
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
  }

  @media (min-width: 900px) {
    .mood-post-content :global(.image-preview-wrap img) {
      width: auto;
      max-width: min(var(--image-width, 100%), 100%);
      max-height: 70vh;
    }

    .mood-post-content :global(.image-preview-wrap--portrait) {
      max-width: 450px;
    }

    .mood-post-content :global(.image-preview-wrap--ultra-tall) {
      max-width: 350px;
    }

  }

  /* Videos */
  .mood-post-content :global(video) {
    width: 100%;
    max-width: 100%;
    height: auto;
    margin: 1.5em 0;
    border-radius: 8px;
    background: hsl(var(--foreground) / 0.05);
    overflow: hidden;
    -webkit-mask-image: -webkit-radial-gradient(white, black);
    mask-image: radial-gradient(white, black);
  }

  /* Audio */
  .mood-post-content :global(audio) {
    width: 100%;
    margin: 1.5em 0;
  }

  /* Stickers */
  .mood-post-content :global(.sticker) {
    max-width: 256px;
    height: auto;
    margin: 1em 0;
  }

  /* Code blocks */
  .mood-post-content :global(pre) {
    margin: 1.5em 0;
    padding: 16px;
    background: hsl(var(--foreground) / 0.05);
    border-radius: 8px;
    overflow-x: auto;
    font-size: 13px;
    line-height: 1.6;
  }

  @media (min-width: 640px) {
    .mood-post-content :global(pre) {
      padding: 20px;
      font-size: 14px;
    }
  }

  .mood-post-content :global(pre code) {
    background: none;
    padding: 0;
    font-family: 'JetBrains Mono', monospace;
  }

  .mood-post-content :global(code) {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9em;
    background: hsl(var(--foreground) / 0.08);
    padding: 2px 6px;
    border-radius: 4px;
  }

  /* Bookmark cards */
  .mood-post-content :global(.bookmark-card) {
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 100%;
    max-width: 400px;
    margin: 1.25em 0;
    border: 1px solid hsl(var(--foreground) / 0.1);
    border-radius: 8px;
    background: hsl(var(--background));
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: border-color 0.15s ease;
  }

  @media (min-width: 640px) {
    .mood-post-content :global(.bookmark-card) {
      max-width: 440px;
    }
  }

  .mood-post-content :global(.bookmark-card:hover) {
    border-color: hsl(var(--foreground) / 0.2);
  }

  .mood-post-content :global(.bookmark-card:focus-visible) {
    outline: 2px solid hsl(var(--foreground) / 0.35);
    outline-offset: 2px;
  }

  .mood-post-content :global(.bookmark-card__media) {
    width: 100%;
    background: hsl(var(--foreground) / 0.03);
  }

  .mood-post-content :global(.bookmark-card__media img) {
    width: 100%;
    display: block;
    object-fit: cover;
    aspect-ratio: 1.91 / 1;
  }

  .mood-post-content :global(.bookmark-card__content) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 12px;
  }

  .mood-post-content :global(.bookmark-card__title) {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.35;
    color: hsl(var(--foreground));
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mood-post-content :global(.bookmark-card__description) {
    font-size: 13px;
    color: hsl(var(--muted-foreground));
    line-height: 1.4;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .mood-post-content :global(.bookmark-card__meta) {
    font-size: 12px;
    color: hsl(var(--muted-foreground) / 0.5);
    margin-top: 2px;
  }

  /* Spoilers */
  .mood-post-content :global(.spoiler-button) {
    cursor: pointer;
    user-select: none;
  }

  .mood-post-content :global(.spoiler-button input[type="checkbox"]) {
    display: none;
  }

  .mood-post-content :global(.spoiler-button tg-spoiler) {
    background: hsl(var(--foreground) / 0.8);
    color: transparent;
    border-radius: 4px;
    padding: 0 4px;
    transition: all 0.2s ease;
  }

  .mood-post-content :global(.spoiler-button input[type="checkbox"]:checked + tg-spoiler) {
    background: transparent;
    color: inherit;
  }

  /* Polls */
  .mood-post-content :global(.tgme_widget_message_poll) {
    margin: 1.5em 0;
    padding: 16px;
    border: 1px solid hsl(var(--foreground) / 0.1);
    border-radius: 8px;
  }

  /* Documents */
  .mood-post-content :global(.tgme_widget_message_document_wrap) {
    margin: 1.5em 0;
    padding: 14px 16px;
    border: 1px solid hsl(var(--foreground) / 0.12);
    border-radius: 12px;
    display: flex;
    align-items: center;
    gap: 14px;
    background: hsl(var(--background));
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .mood-post-content :global(.tgme_widget_message_document_wrap:hover) {
    border-color: hsl(var(--foreground) / 0.2);
    box-shadow: 0 12px 30px hsl(var(--foreground) / 0.05);
  }

  .mood-post-content :global(.tgme_widget_message_document_icon) {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: hsl(var(--foreground) / 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    position: relative;
  }

  .mood-post-content :global(.tgme_widget_message_document_icon.audio::before) {
    content: '';
    border-left: 10px solid hsl(var(--foreground) / 0.7);
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
    margin-left: 2px;
  }

  .mood-post-content :global(.tgme_widget_message_document) {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .mood-post-content :global(.tgme_widget_message_document_title) {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
  }

  .mood-post-content :global(.tgme_widget_message_document_extra) {
    font-size: 13px;
    color: hsl(var(--muted-foreground));
    line-height: 1.5;
  }

  /* Animations */
  .mood-post {
    animation: fade-in 0.5s ease-out;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Comments Section */
  .mood-comments {
    margin-top: 48px;
    padding-top: 48px;
    border-top: 1px solid hsl(var(--foreground) / 0.08);
    position: relative;
    --comment-body-padding: 9px 12px;
    --comment-body-radius: 12px;
    --comment-stack-gap: 16px;
  }

  .mood-comments::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      hsl(var(--foreground) / 0.15) 50%,
      transparent 100%
    );
  }

  @media (min-width: 640px) {
    .mood-comments {
      margin-top: 56px;
      padding-top: 56px;
      --comment-stack-gap: 18px;
    }
  }

  @media (min-width: 1024px) {
    .mood-comments {
      margin-top: 64px;
      padding-top: 64px;
    }
  }

  .mood-comments-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
  }

  @media (min-width: 640px) {
    .mood-comments-header {
      margin-bottom: 28px;
    }
  }

  .mood-comments-title {
    font-size: 13px;
    font-weight: 500;
    color: hsl(var(--muted-foreground) / 0.6);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .mood-comments-count {
    font-size: 12px;
    font-weight: 500;
    color: hsl(var(--muted-foreground) / 0.5);
    font-variant-numeric: tabular-nums;
  }

  .mood-comments-count:empty {
    display: none;
  }

  .mood-comments-count::before {
    content: '·';
    margin-right: 8px;
    color: hsl(var(--muted-foreground) / 0.3);
  }

  .mood-comments-list {
    display: flex;
    flex-direction: column;
    gap: var(--comment-stack-gap);
  }

  @media (min-width: 640px) {
    .mood-comments-list {
      gap: var(--comment-stack-gap);
    }
  }

  /* Skeleton Loading */
  .mood-comments-skeleton {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .mood-comment--skeleton {
    animation: none;
  }

  .mood-comment--skeleton .mood-comment-body {
    width: fit-content;
  }

  .mood-comment-avatar--skeleton {
    position: relative;
    overflow: hidden;
  }

  .mood-comment-avatar--skeleton::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      hsl(var(--foreground) / 0.15) 50%,
      transparent 100%
    );
    animation: comment-skeleton-shimmer 2s ease-in-out infinite;
    animation-delay: var(--skeleton-delay, 0s);
  }

  .mood-comment-skeleton-line {
    display: block;
    width: var(--line-width, 120px);
    height: var(--line-height, 12px);
    background: hsl(var(--foreground) / 0.1);
    border-radius: 6px;
    position: relative;
    overflow: hidden;
  }

  .mood-comment-skeleton-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      hsl(var(--foreground) / 0.18) 50%,
      transparent 100%
    );
    animation: comment-skeleton-shimmer 2s ease-in-out infinite;
    animation-delay: var(--skeleton-delay, 0s);
  }

  .mood-comment-skeleton-line--author {
    --line-height: 13px;
  }

  .mood-comment-skeleton-line--date {
    --line-height: 10px;
    background: hsl(var(--foreground) / 0.08);
  }

  .mood-comment-skeleton-line--quote {
    --line-height: 11px;
  }

  .mood-comment-content--skeleton {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .mood-comment-content .mood-comment-skeleton-quote small {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  @keyframes comment-skeleton-shimmer {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mood-comment-avatar--skeleton::after,
    .mood-comment-skeleton-line::after {
      animation: none;
    }
  }

  .mood-comments-empty {
    padding: 24px 0;
    color: hsl(var(--muted-foreground) / 0.5);
  }

  .mood-comments-empty p {
    margin: 0;
    font-size: 14px;
    font-style: italic;
  }

  /* Comment CTA - styled exactly like a real comment */
  a.mood-comment-cta-wrap {
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    animation: none;
    margin-top: var(--comment-stack-gap, 16px);
  }

  a.mood-comment-cta-wrap .mood-comment-body {
    transition: all 0.2s ease;
  }

  a.mood-comment-cta-wrap:hover .mood-comment-body {
    background: linear-gradient(
      145deg,
      hsl(var(--foreground) / 0.035) 0%,
      hsl(200 50% 60% / 0.06) 50%,
      hsl(var(--foreground) / 0.05) 100%
    );
    border-color: hsl(200 40% 50% / 0.15);
    box-shadow:
      0 1px 2px hsl(var(--foreground) / 0.04),
      0 4px 12px hsl(200 60% 50% / 0.08),
      inset 0 1px 0 hsl(var(--background) / 0.8),
      inset 0 -1px 0 hsl(var(--foreground) / 0.03);
  }

  .mood-comment-avatar--telegram {
    background: url('/telegram-logo.svg') no-repeat center !important;
    background-size: 91% !important;
  }

  .mood-comment-cta-content {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .mood-comment-cta-content span {
    color: hsl(var(--foreground) / 0.95);
  }

  .mood-comment-cta-arrow {
    opacity: 0.4;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  a.mood-comment-cta-wrap:hover .mood-comment-cta-arrow {
    opacity: 0.7;
    transform: translate(2px, -2px);
  }

  @media (max-width: 540px) {
    .mood-comment-cta-arrow {
      width: 12px;
      height: 12px;
    }
  }

  .mood-comment {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 0;
    position: relative;
    animation: comment-fade-in 0.3s ease-out backwards;
  }

  @media (min-width: 640px) {
    .mood-comment {
      gap: 12px;
    }
  }

  @keyframes comment-fade-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mood-comment-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: linear-gradient(
      135deg,
      hsl(var(--foreground) / 0.12) 0%,
      hsl(var(--foreground) / 0.06) 100%
    );
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 600;
    color: hsl(var(--foreground) / 0.6);
    overflow: hidden;
    border: 1.5px solid hsl(var(--background));
    box-shadow: 0 1px 4px hsl(var(--foreground) / 0.06);
  }

  @media (min-width: 640px) {
    .mood-comment-avatar {
      width: 36px;
      height: 36px;
      font-size: 13px;
    }
  }

  .mood-comment-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mood-comment-body {
    width: fit-content;
    max-width: 100%;
    min-width: 0;
    background: hsl(var(--foreground) / 0.035);
    border: 1px solid hsl(var(--foreground) / 0.08);
    border-radius: var(--comment-body-radius, 12px);
    padding: var(--comment-body-padding, 9px 12px);
    position: relative;
  }

  .mood-comment-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
    flex-wrap: wrap;
  }

  .mood-comment-author {
    font-size: 13px;
    font-weight: 600;
    color: hsl(var(--foreground));
    letter-spacing: -0.01em;
  }

  @media (min-width: 640px) {
    .mood-comment-author {
      font-size: 14px;
    }
  }

  .mood-comment-date {
    font-size: 11px;
    color: hsl(var(--muted-foreground) / 0.6);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 640px) {
    .mood-comment-date {
      font-size: 12px;
    }
  }

  .mood-comment-date::before {
    content: '•';
    margin-right: 8px;
    color: hsl(var(--muted-foreground) / 0.3);
  }

  .mood-comment-content {
    font-size: 13px;
    line-height: 1.6;
    color: hsl(var(--foreground) / 0.95);
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  @media (min-width: 640px) {
    .mood-comment-content {
      font-size: 14px;
      line-height: 1.65;
    }
  }

  .mood-comment-content :global(p) {
    margin: 0 0 0.8em 0;
  }

  .mood-comment-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .mood-comment-content :global(a) {
    color: hsl(var(--foreground));
    text-decoration: none;
    border-bottom: 1px solid hsl(var(--foreground) / 0.3);
    transition: border-color 0.15s ease;
  }

  .mood-comment-content :global(a:hover) {
    border-bottom-color: hsl(var(--foreground) / 0.6);
  }

  .mood-comment-content :global(.tg-emoji) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.1em;
    height: 1.1em;
    vertical-align: -0.15em;
  }

  .mood-comment-content :global(.tg-emoji img) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .mood-comment-content :global(.tg-emoji[data-emoji-animated="true"] img) {
    display: none;
  }

  .mood-comment-content :global(.tg-emoji-anim),
  .mood-comment-content :global(.tg-emoji-anim svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .mood-comment-content :global(blockquote) {
    --comment-quote-bg: linear-gradient(
      180deg,
      hsl(var(--foreground) / 0.03) 0%,
      hsl(var(--foreground) / 0.06) 100%
    );
    margin: 0.6em 0 0.7em;
    padding: 4px 10px 4px;
    border-left: 2px solid hsl(var(--foreground) / 0.18);
    background: var(--comment-quote-bg);
    border-radius: 0 6px 6px 0;
    font-size: 11.5px;
    line-height: 1.5;
    color: hsl(var(--muted-foreground));
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .mood-comment-content :global(blockquote) {
      padding: 5px 12px 5px;
      font-size: 12.5px;
      line-height: 1.55;
    }
  }

  .mood-comment-content :global(blockquote::before) {
    content: '';
    position: absolute;
    left: -2px;
    top: 0;
    width: 2px;
    height: 100%;
    background: linear-gradient(
      to bottom,
      hsl(var(--foreground) / 0.3),
      hsl(var(--foreground) / 0.08)
    );
    border-radius: 2px 0 0 2px;
  }

  .mood-comment-content :global(blockquote::after) {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 42%;
    background: linear-gradient(
      180deg,
      hsl(var(--foreground) / 0) 0%,
      hsl(var(--foreground) / 0.18) 100%
    );
    opacity: 0.35;
    pointer-events: none;
  }

  .mood-comment-content :global(blockquote small) {
    display: block;
    line-height: 1.5;
    position: relative;
    z-index: 1;
  }

  .mood-comment-content :global(blockquote p) {
    margin: 0;
    position: relative;
    z-index: 1;
  }

  .mood-comment-reactions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }

  .mood-comment-reactions .mood-reaction {
    padding: 4px 9px 4px 8px;
    font-size: 11px;
    background: hsl(var(--foreground) / 0.06);
    border: 1px solid hsl(var(--foreground) / 0.1);
    border-radius: 999px;
  }

  .mood-comments-load-more {
    display: block;
    width: 100%;
    margin-top: 28px;
    padding: 16px 28px;
    font-size: 14px;
    font-weight: 500;
    color: hsl(var(--foreground) / 0.75);
    background: linear-gradient(
      180deg,
      hsl(var(--foreground) / 0.04) 0%,
      hsl(var(--foreground) / 0.06) 100%
    );
    border: 1px solid hsl(var(--foreground) / 0.12);
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    font-family: inherit;
    position: relative;
    overflow: hidden;
    box-shadow:
      0 2px 8px hsl(var(--foreground) / 0.04),
      0 0 0 1px hsl(var(--foreground) / 0.02);
  }

  .mood-comments-load-more::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      hsl(var(--foreground) / 0.08) 0%,
      transparent 100%
    );
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .mood-comments-load-more:hover {
    color: hsl(var(--foreground));
    border-color: hsl(var(--foreground) / 0.18);
    box-shadow:
      0 4px 16px hsl(var(--foreground) / 0.08),
      0 0 0 1px hsl(var(--foreground) / 0.04);
    transform: translateY(-1px);
  }

  .mood-comments-load-more:hover::before {
    opacity: 1;
  }

  .mood-comments-load-more:active {
    transform: translateY(0);
  }

  .mood-comments-load-more:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  .mood-comments-load-more:disabled:hover {
    border-color: hsl(var(--foreground) / 0.12);
