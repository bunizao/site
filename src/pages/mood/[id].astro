---
import Layout from '../../layouts/Layout.astro';
import dayjs from 'dayjs';
import { createE2EPost, isE2ESiteFixtureEnabled } from '../../lib/e2e-fixtures';
import { getChannelInfo, type Post } from '../../lib/telegram';
import '@/styles/mood-gallery.css';
import { renderMoodContentWithGalleries } from '@/features/mood/shared/gallery';
import DetailArticle from '@/features/mood/ui/DetailArticle.astro';

export const prerender = false;

const { id } = Astro.params;

const isEmbed = Astro.url.searchParams.has('embed');
if (isEmbed && id) {
  const rawTheme = Astro.url.searchParams.get('theme') || 'auto';
  const theme = ['light', 'dark', 'auto'].includes(rawTheme) ? rawTheme : 'auto';
  const embedUrl = new URL('/mood/embed', Astro.url);
  embedUrl.searchParams.set('id', id);
  embedUrl.searchParams.set('theme', theme);
  embedUrl.searchParams.set('link', 'false');
  return Astro.redirect(`${embedUrl.pathname}${embedUrl.search}`);
}

let post: Post | null = null;
let error = false;

try {
  if (id) {
    if (isE2ESiteFixtureEnabled(Astro.locals)) {
      post = createE2EPost(id);
    } else {
      post = await getChannelInfo(Astro, { id }) as Post;
    }
  }
} catch (fetchError) {
  console.error('Failed to fetch mood:', fetchError);
  error = true;
}

if (!post) {
  Astro.response.status = 404;
}

const canonicalUrl = new URL(Astro.url.pathname, Astro.url.origin).href;
const oembed = id
  ? { href: `/api/oembed.json?url=${encodeURIComponent(canonicalUrl)}`, title: 'Mood Embed' }
  : undefined;
const title = post ? `${post.title} | Moods` : 'Mood not found | Moods';
const moodSummary = post ? (post.text.trim() || post.title.trim()) : '';
const description = moodSummary ? moodSummary.slice(0, 160) : 'Mood not found.';
const formattedDate = post ? dayjs(post.datetime).format('MMMM D, YYYY · HH:mm') : '';
const channel = import.meta.env.CHANNEL || Astro.locals?.runtime?.env?.CHANNEL || '';
const telegramCommentUrl = channel && id ? `https://t.me/${channel}/${id}?comment=1` : '';
const renderedPostContent = post ? renderMoodContentWithGalleries(post.content) : '';
---

<Layout title={title} description={description} oembed={oembed} hideSiteNav>
  <main class="page-container">
    <DetailArticle
      post={post}
      error={error}
      postId={id}
      renderedPostContent={renderedPostContent}
      formattedDate={formattedDate}
      telegramCommentUrl={telegramCommentUrl}
    />
  </main>
</Layout>

<script>
  import {
    replaceReplyNodesWithCommentQuotes,
  } from '@/lib/comment-content';
  import { createAnimatedEmojiManager } from '@/features/mood/client/animated-emoji';
  import { initMoodDetailComments } from '@/features/mood/client/detail-comments-controller';
  import { initMoodGalleries } from '@/features/mood/client/gallery';

  document.querySelectorAll('.mood-post-content video').forEach((node) => {
    if (!(node instanceof HTMLVideoElement)) return;
    const classify = () => {
      const w = node.videoWidth;
      const h = node.videoHeight;
      if (!w || !h) return;
      const ratio = w / h;
      if (ratio < 0.6) {
        node.classList.add('video--ultra-tall');
      } else if (ratio < 0.8) {
        node.classList.add('video--portrait');
      }
    };
    if (node.readyState >= 1) {
      classify();
    } else {
      node.addEventListener('loadedmetadata', classify, { once: true });
    }
  });

  const backButton = document.querySelector('[data-back-button]');

  if (backButton) {
    backButton.addEventListener('click', () => {
      if (document.referrer && document.referrer.includes('/mood')) {
        window.history.back();
      } else {
        window.location.href = '/mood';
      }
    });
  }

  const moodPostContent = document.querySelector('.mood-post-content');
  if (moodPostContent instanceof HTMLElement) {
    replaceReplyNodesWithCommentQuotes(moodPostContent);
    initMoodGalleries(moodPostContent);
  }

  const animatedEmoji = createAnimatedEmojiManager();
  void animatedEmoji.hydrate(document);

  const ALWAYS_LOADING = import.meta.env.PUBLIC_DEBUG_ALWAYS_LOADING === 'true';
  void initMoodDetailComments({
    alwaysLoading: ALWAYS_LOADING,
    hydrateAnimatedEmoji: animatedEmoji.hydrate,
  });
</script>
