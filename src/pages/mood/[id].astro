---
import Layout from '../../layouts/Layout.astro';
import dayjs from 'dayjs';
import { createE2EPost, isE2ESiteFixtureEnabled } from '../../lib/e2e-fixtures';
import { getChannelInfo, type Post } from '../../lib/telegram';
import '@/styles/mood-gallery.css';
import { renderMoodContentWithGalleries } from '@/features/mood/shared/gallery';
import MoodDetailArticle from '@/components/mood/MoodDetailArticle.astro';

export const prerender = false;

const { id } = Astro.params;

const isEmbed = Astro.url.searchParams.has('embed');
if (isEmbed && id) {
  const rawTheme = Astro.url.searchParams.get('theme') || 'auto';
  const theme = ['light', 'dark', 'auto'].includes(rawTheme) ? rawTheme : 'auto';
  const embedUrl = new URL('/mood/embed', Astro.url);
  embedUrl.searchParams.set('id', id);
  embedUrl.searchParams.set('theme', theme);
  embedUrl.searchParams.set('link', 'false');
  return Astro.redirect(`${embedUrl.pathname}${embedUrl.search}`);
}

let post: Post | null = null;
let error = false;

try {
  if (id) {
    if (isE2ESiteFixtureEnabled(Astro.locals)) {
      post = createE2EPost(id);
    } else {
      post = await getChannelInfo(Astro, { id }) as Post;
    }
  }
} catch (fetchError) {
  console.error('Failed to fetch mood:', fetchError);
  error = true;
}

if (!post) {
  Astro.response.status = 404;
}

const canonicalUrl = new URL(Astro.url.pathname, Astro.url.origin).href;
const oembed = id
  ? { href: `/api/oembed.json?url=${encodeURIComponent(canonicalUrl)}`, title: 'Mood Embed' }
  : undefined;
const title = post ? `${post.title} | Moods` : 'Mood not found | Moods';
const moodSummary = post ? (post.text.trim() || post.title.trim()) : '';
const description = moodSummary ? moodSummary.slice(0, 160) : 'Mood not found.';
const formattedDate = post ? dayjs(post.datetime).format('MMMM D, YYYY · HH:mm') : '';
const channel = import.meta.env.CHANNEL || Astro.locals?.runtime?.env?.CHANNEL || '';
const telegramCommentUrl = channel && id ? `https://t.me/${channel}/${id}?comment=1` : '';
const renderedPostContent = post ? renderMoodContentWithGalleries(post.content) : '';
---

<Layout title={title} description={description} oembed={oembed} hideSiteNav>
  <main class="page-container">
    <MoodDetailArticle
      post={post}
      error={error}
      postId={id}
      renderedPostContent={renderedPostContent}
      formattedDate={formattedDate}
      telegramCommentUrl={telegramCommentUrl}
    />
  </main>
</Layout>

<script>
  import {
    replaceReplyNodesWithCommentQuotes,
  } from '@/lib/comment-content';
  import { initMoodDetailComments } from '@/features/mood/client/detail-comments-controller';
  import { initMoodGalleries } from '@/features/mood/client/gallery';

  document.querySelectorAll('.mood-post-content video').forEach((node) => {
    if (!(node instanceof HTMLVideoElement)) return;
    const classify = () => {
      const w = node.videoWidth;
      const h = node.videoHeight;
      if (!w || !h) return;
      const ratio = w / h;
      if (ratio < 0.6) {
        node.classList.add('video--ultra-tall');
      } else if (ratio < 0.8) {
        node.classList.add('video--portrait');
      }
    };
    if (node.readyState >= 1) {
      classify();
    } else {
      node.addEventListener('loadedmetadata', classify, { once: true });
    }
  });

  const backButton = document.querySelector('[data-back-button]');

  if (backButton) {
    backButton.addEventListener('click', () => {
      if (document.referrer && document.referrer.includes('/mood')) {
        window.history.back();
      } else {
        window.location.href = '/mood';
      }
    });
  }

  const createAnimatedEmojiManager = () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return {
        hydrate: (_root?: ParentNode) => {},
      };
    }

    const scriptCache = new Map<string, Promise<void>>();
    const emojiCache = new Map<string, Promise<any | null>>();
    const lottieSrc = 'https://cdn.jsdelivr.net/npm/lottie-web@5.12.2/build/player/lottie.min.js';
    const pakoSrc = 'https://cdn.jsdelivr.net/npm/pako@2.1.0/dist/pako.min.js';

    const loadScript = (src: string): Promise<void> => {
      if (scriptCache.has(src)) {
        return scriptCache.get(src) as Promise<void>;
      }

      const promise = new Promise<void>((resolve, reject) => {
        const existing = document.querySelector(`script[src="${src}"]`) as HTMLScriptElement | null;
        if (existing) {
          if (existing.dataset.loaded === 'true') {
            resolve();
            return;
          }
          existing.addEventListener('load', () => resolve(), { once: true });
          existing.addEventListener('error', () => reject(new Error(`Failed to load ${src}`)), { once: true });
          return;
        }

        const script = document.createElement('script');
        script.src = src;
        script.async = true;
        script.dataset.loaded = 'false';
        script.onload = () => {
          script.dataset.loaded = 'true';
          resolve();
        };
        script.onerror = () => reject(new Error(`Failed to load ${src}`));
        document.head.appendChild(script);
      });

      scriptCache.set(src, promise);
      return promise;
    };

    const ensureLibs = (): Promise<void> =>
      Promise.all([loadScript(lottieSrc), loadScript(pakoSrc)]).then(() => undefined);

    const getAnimationData = (emojiId: string): Promise<any | null> => {
      if (emojiCache.has(emojiId)) {
        return emojiCache.get(emojiId) as Promise<any | null>;
      }

      const promise = (async () => {
        const metaResponse = await fetch(`/static/https://t.me/i/emoji/${emojiId}.json`, { cache: 'no-store' });
        if (!metaResponse.ok) return null;
        const meta = await metaResponse.json() as { emoji?: string };
        const emojiUrl = meta?.emoji;
        if (!emojiUrl) return null;
        const proxied = emojiUrl.startsWith('http') ? `/static/${emojiUrl}` : emojiUrl;
        const tgsResponse = await fetch(proxied);
        if (!tgsResponse.ok) return null;
        const buffer = await tgsResponse.arrayBuffer();
        const pako = (window as any).pako;
        if (!pako) return null;
        const bytes = new Uint8Array(buffer);
        const jsonText = new TextDecoder('utf-8').decode(pako.ungzip(bytes));
        return JSON.parse(jsonText);
      })().catch(() => null);

      emojiCache.set(emojiId, promise);
      return promise;
    };

    const hydrate = async (root: ParentNode = document): Promise<void> => {
      const nodes = Array.from(root.querySelectorAll('[data-emoji-id]')).filter((node) => {
        return node instanceof HTMLElement && !node.dataset.emojiAnimated;
      }) as HTMLElement[];

      if (!nodes.length) return;

      try {
        await ensureLibs();
      } catch {
        return;
      }
      const lottie = (window as any).lottie;
      if (!lottie) return;

      await Promise.all(
        nodes.map(async (node) => {
          const emojiId = node.dataset.emojiId;
          if (!emojiId) return;
          node.dataset.emojiAnimated = 'pending';
          const animationData = await getAnimationData(emojiId);
          if (!animationData) {
            node.dataset.emojiAnimated = 'false';
            return;
          }
          node.dataset.emojiAnimated = 'true';
          const container = document.createElement('span');
          container.className = 'tg-emoji-anim';
          node.appendChild(container);
          lottie.loadAnimation({
            container,
            renderer: 'svg',
            loop: true,
            autoplay: true,
            animationData,
            rendererSettings: {
              preserveAspectRatio: 'xMidYMid meet',
            },
          });
        })
      );
    };

    return { hydrate };
  };

  const moodPostContent = document.querySelector('.mood-post-content');
  if (moodPostContent instanceof HTMLElement) {
    replaceReplyNodesWithCommentQuotes(moodPostContent);
    initMoodGalleries(moodPostContent);
  }

  const animatedEmoji = createAnimatedEmojiManager();
  animatedEmoji.hydrate(document);

  const ALWAYS_LOADING = import.meta.env.PUBLIC_DEBUG_ALWAYS_LOADING === 'true';
  void initMoodDetailComments({
    alwaysLoading: ALWAYS_LOADING,
    hydrateAnimatedEmoji: animatedEmoji.hydrate,
  });
</script>
