---
import Layout from '../../layouts/Layout.astro';
import dayjs from 'dayjs';
import type { MoodContentDocument } from '@bunizao/contracts';
import {
  loadMoodDocument,
  normalizeMoodApiSource,
  resolveMoodReadSource,
} from '@/features/mood/server/api-client';
import '@/styles/mood-gallery.css';
import { renderMoodContentWithGalleries } from '@/features/mood/shared/gallery';
import { getMoodFeedAnchorHref } from '@/features/mood/shared/feed-anchor';
import DetailArticle from '@/features/mood/ui/DetailArticle.astro';
import BackToTop from '@/features/mood/ui/BackToTop.astro';
import { buildMoodDetailMetadata } from '@/features/mood/server/detail-metadata';
import { readEnv } from '@/lib/runtime/env';

export const prerender = false;

const { id } = Astro.params;

const isEmbed = Astro.url.searchParams.has('embed');
if (isEmbed && id) {
  const rawTheme = Astro.url.searchParams.get('theme') || 'auto';
  const theme = ['light', 'dark', 'auto'].includes(rawTheme) ? rawTheme : 'auto';
  const embedUrl = new URL('/mood/embed', Astro.url);
  embedUrl.searchParams.set('id', id);
  embedUrl.searchParams.set('theme', theme);
  embedUrl.searchParams.set('link', 'false');
  return Astro.redirect(`${embedUrl.pathname}${embedUrl.search}`);
}

let post: MoodContentDocument | null = null;
let error = false;
const moodReadSource = resolveMoodReadSource(
  Astro.locals,
  normalizeMoodApiSource(Astro.url.searchParams.get('source')) ?? undefined,
);

try {
  if (id) {
    post = await loadMoodDocument(
      { request: Astro.request, locals: Astro.locals },
      id,
      { source: moodReadSource },
    );
  }
} catch (fetchError) {
  console.error('Failed to fetch mood:', fetchError);
  error = true;
}

if (!post) {
  Astro.response.status = 404;
}

const canonicalUrl = new URL(Astro.url.pathname, Astro.url.origin).href;
const moodAlternateUrl = new URL(canonicalUrl);
const oembed = id
  ? { href: `/api/oembed.json?url=${encodeURIComponent(moodAlternateUrl.href)}`, title: 'Mood Embed' }
  : undefined;
const metadata = buildMoodDetailMetadata(post, id);
const formattedDate = post ? dayjs(post.datetime).format('MMMM D, YYYY · HH:mm') : '';
const moodFeedBackHref = getMoodFeedAnchorHref(id ?? '');
const channel = readEnv(Astro.locals, 'CHANNEL');
const telegramCommentUrl = channel && id ? `https://t.me/${channel}/${id}?comment=1` : '';
const renderedPostContent = post
  ? renderMoodContentWithGalleries(post.bodyHtml)
  : '';
---

<Layout
  title={metadata.title}
  description={metadata.description}
  image={metadata.image}
  imageAlt={metadata.imageAlt}
  imageWidth={metadata.imageWidth}
  imageHeight={metadata.imageHeight}
  oembed={oembed}
  hideSiteNav
>
  <main class="page-container">
    <DetailArticle
      post={post}
      error={error}
      postId={id}
      renderedPostContent={renderedPostContent}
      formattedDate={formattedDate}
      telegramCommentUrl={telegramCommentUrl}
      backHref={moodFeedBackHref}
      readSource={moodReadSource}
    />
  </main>
  <BackToTop />
</Layout>

<script>
  import {
    replaceReplyNodesWithCommentQuotes,
  } from '@/features/mood/shared/comments';
  import { createAnimatedEmojiManager } from '@/features/mood/client/animated-emoji';
  import { initMoodDetailComments } from '@/features/mood/client/detail-comments-controller';
  import { initMoodGalleries } from '@/features/mood/client/gallery';
  import { createMoodMetaPatcher } from '@/features/mood/client/meta-patcher';
  import { hydrateMoodRichText } from '@/features/mood/client/rich-text';

  document.querySelectorAll('.mood-post-content video').forEach((node) => {
    if (!(node instanceof HTMLVideoElement)) return;
    const classify = () => {
      const w = node.videoWidth;
      const h = node.videoHeight;
      if (!w || !h) return;
      const ratio = w / h;
      if (ratio < 0.6) {
        node.classList.add('video--ultra-tall');
      } else if (ratio < 0.8) {
        node.classList.add('video--portrait');
      }
    };
    if (node.readyState >= 1) {
      classify();
    } else {
      node.addEventListener('loadedmetadata', classify, { once: true });
    }
  });

  const backButton = document.querySelector('[data-back-button]');

  if (backButton instanceof HTMLElement) {
    backButton.addEventListener('click', (event) => {
      let referrerPath = '';
      try {
        const referrerUrl = document.referrer ? new URL(document.referrer) : null;
        if (referrerUrl?.origin === window.location.origin) {
          referrerPath = referrerUrl.pathname;
        }
      } catch {
        referrerPath = '';
      }

      if ((referrerPath === '/mood' || referrerPath === '/mood/') && window.history.length > 1) {
        event.preventDefault();
        window.history.back();
      }
    });
  }

  const moodPostContent = document.querySelector('.mood-post-content');
  if (moodPostContent instanceof HTMLElement) {
    replaceReplyNodesWithCommentQuotes(moodPostContent);
    initMoodGalleries(moodPostContent);
    hydrateMoodRichText(moodPostContent);
  }

  const animatedEmoji = createAnimatedEmojiManager();
  void animatedEmoji.hydrate(document);

  const moodPost = document.querySelector<HTMLElement>('[data-mood-id][data-mood-read-source]');
  if (moodPost) {
    void createMoodMetaPatcher({
      root: document,
      readSource: moodPost.dataset.moodReadSource,
    }).patchVisible();
  }

  const ALWAYS_LOADING = import.meta.env.PUBLIC_DEBUG_ALWAYS_LOADING === 'true';
  void initMoodDetailComments({
    alwaysLoading: ALWAYS_LOADING,
    hydrateAnimatedEmoji: animatedEmoji.hydrate,
  });
</script>
