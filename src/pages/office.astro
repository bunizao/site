---
import OfficeMvp from '@/components/office/OfficeMvp';
import Layout from '../layouts/Layout.astro';

const title = 'Office | Bunizao';
const description =
  'A minimal pixel office MVP inspired by Pixel Agents, adapted for this Astro site with a React and Canvas 2D simulation.';
const sourceUrl = 'https://github.com/pablodelucca/pixel-agents';

const stackItems = ['Astro route', 'React island', 'Canvas 2D', 'Mock telemetry'];

const scopeCards = [
  {
    title: 'What This Keeps',
    items: [
      'A living pixel office instead of a static screenshot',
      'Multiple agents with visible states and beat-driven motion',
      'A dashboard panel that explains who is doing what',
    ],
  },
  {
    title: 'What This Cuts',
    items: [
      'VS Code extension plumbing and transcript watchers',
      'Layout editor, asset pipeline, and imported furniture packs',
      'Any dependency on paid tilesets or external runtime data',
    ],
  },
  {
    title: 'Next Real Slice',
    items: [
      'Replace mock beats with local build, git, or deploy events',
      'Assign desks to directories or projects in this repo',
      'Persist layouts and agent preferences between visits',
    ],
  },
];
---

<Layout title={title} description={description} url="/office" showSiteNav={false}>
  <main class="office-page">
    <section class="office-hero">
      <div class="office-container">
        <div class="office-hero-grid">
          <div class="office-copy-block">
            <a href="/" class="office-back-link">← Back home</a>
            <p class="office-kicker">/office</p>
            <h1 class="office-title">Pixel agents, compressed into a single-page MVP.</h1>
            <p class="office-copy">
              Inspired by
              <a href={sourceUrl} target="_blank" rel="noreferrer" class="office-inline-link">
                Pixel Agents
              </a>
              , this route keeps the office metaphor, React-driven state, and Canvas 2D simulation while
              cutting the extension layer, editor workflow, and asset import pipeline.
            </p>

            <div class="office-stack-list" aria-label="Implementation stack">
              {stackItems.map((item) => (
                <span class="office-stack-pill">{item}</span>
              ))}
            </div>
          </div>

          <aside class="office-summary-card">
            <p class="office-card-kicker">Prototype Notes</p>
            <h2>What this page is proving</h2>
            <p>
              The idea survives outside VS Code. A single route can already convey agent coordination,
              task pressure, and shipping flow with no backend integration.
            </p>

            <div class="office-summary-metrics">
              <div>
                <span>Source</span>
                <strong>Pixel Agents</strong>
              </div>
              <div>
                <span>Mode</span>
                <strong>Mock beats</strong>
              </div>
              <div>
                <span>Target</span>
                <strong>Minimal MVP</strong>
              </div>
            </div>

            <a href={sourceUrl} target="_blank" rel="noreferrer" class="office-source-link">
              Open source reference ↗
            </a>
          </aside>
        </div>
      </div>
    </section>

    <section class="office-stage">
      <div class="office-container">
        <OfficeMvp client:load />
      </div>
    </section>

    <section class="office-scope">
      <div class="office-container">
        <div class="office-scope-grid">
          {scopeCards.map((card) => (
            <article class="office-scope-card">
              <p class="office-card-kicker">{card.title}</p>
              <ul>
                {card.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .office-page {
    position: relative;
    isolation: isolate;
    overflow: clip;
  }

  .office-page::before,
  .office-page::after {
    content: '';
    position: absolute;
    inset: auto;
    pointer-events: none;
    z-index: -1;
    filter: blur(54px);
    opacity: 0.38;
  }

  .office-page::before {
    top: 3rem;
    right: -8rem;
    width: 26rem;
    height: 26rem;
    background:
      radial-gradient(circle, rgb(212 175 55 / 0.42) 0%, rgb(212 175 55 / 0) 68%);
  }

  .office-page::after {
    top: 22rem;
    left: -10rem;
    width: 28rem;
    height: 28rem;
    background:
      radial-gradient(circle, rgb(96 165 250 / 0.22) 0%, rgb(96 165 250 / 0) 70%);
  }

  .office-container {
    width: min(1180px, calc(100vw - 2rem));
    margin: 0 auto;
  }

  .office-hero {
    padding-top: 6.5rem;
    padding-bottom: 2.5rem;
  }

  .office-hero-grid {
    display: grid;
    gap: 1.5rem;
  }

  .office-copy-block {
    max-width: 44rem;
  }

  .office-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 1rem;
    padding: 0.6rem 0.95rem;
    border: 1px solid hsl(var(--foreground) / 0.12);
    border-radius: 999px;
    color: hsl(var(--muted-foreground));
    background: hsl(var(--background) / 0.8);
    transition:
      color 0.18s ease,
      border-color 0.18s ease,
      transform 0.18s ease;
  }

  .office-back-link:hover {
    color: hsl(var(--foreground));
    border-color: hsl(var(--foreground) / 0.22);
    transform: translateX(-2px);
  }

  .office-kicker,
  .office-card-kicker {
    margin: 0;
    font-size: 0.7rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }

  .office-title {
    margin-top: 1rem;
    margin-bottom: 1rem;
    max-width: 12ch;
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    line-height: 0.94;
    letter-spacing: -0.06em;
  }

  .office-copy {
    max-width: 42rem;
    font-size: 0.98rem;
    line-height: 1.9;
    color: hsl(var(--muted-foreground));
  }

  .office-inline-link {
    color: hsl(var(--foreground));
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .office-stack-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.5rem;
  }

  .office-stack-pill {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid hsl(var(--foreground) / 0.12);
    border-radius: 999px;
    background:
      linear-gradient(135deg, hsl(var(--background) / 0.95), hsl(var(--foreground) / 0.04));
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .office-summary-card {
    align-self: start;
    padding: 1.3rem;
    border: 1px solid hsl(var(--foreground) / 0.1);
    border-radius: 1.6rem;
    background:
      linear-gradient(160deg, hsl(var(--background) / 0.96), hsl(var(--foreground) / 0.04));
    box-shadow: 0 34px 90px -58px rgb(0 0 0 / 0.45);
    backdrop-filter: blur(14px);
  }

  .office-summary-card h2 {
    margin-top: 0.8rem;
    margin-bottom: 0.8rem;
    font-size: 1.6rem;
    line-height: 1.1;
  }

  .office-summary-card p {
    margin: 0;
    color: hsl(var(--muted-foreground));
    line-height: 1.8;
  }

  .office-summary-metrics {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.3rem;
    margin-bottom: 1.2rem;
  }

  .office-summary-metrics div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.7rem;
    border-top: 1px solid hsl(var(--foreground) / 0.08);
    font-size: 0.82rem;
    color: hsl(var(--muted-foreground));
  }

  .office-summary-metrics strong {
    color: hsl(var(--foreground));
    font-size: 0.95rem;
  }

  .office-source-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.85rem;
    color: hsl(var(--foreground));
  }

  .office-source-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .office-stage {
    padding-top: 1rem;
  }

  .office-scope {
    padding-top: 1.5rem;
    padding-bottom: 5rem;
  }

  .office-scope-grid {
    display: grid;
    gap: 1rem;
  }

  .office-scope-card {
    padding: 1.2rem;
    border: 1px solid hsl(var(--foreground) / 0.1);
    border-radius: 1.5rem;
    background: hsl(var(--foreground) / 0.03);
  }

  .office-scope-card ul {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .office-scope-card li {
    position: relative;
    padding-left: 1rem;
    color: hsl(var(--muted-foreground));
    line-height: 1.8;
  }

  .office-scope-card li + li {
    margin-top: 0.55rem;
  }

  .office-scope-card li::before {
    content: '';
    position: absolute;
    top: 0.82rem;
    left: 0;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 999px;
    background: hsl(var(--foreground));
  }

  @media (min-width: 900px) {
    .office-hero-grid {
      grid-template-columns: minmax(0, 1.35fr) minmax(320px, 0.65fr);
      align-items: end;
    }

    .office-summary-card {
      padding: 1.5rem;
    }

    .office-scope-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
