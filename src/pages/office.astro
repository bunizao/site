---
import PixelAgentsApp from '@/components/pixel-agents/App';

const title = 'OpenClaw Agents Office';
const description = 'A full-screen Pixel Agents office view tuned for OpenClaw agents.';
const site = Astro.site ?? new URL(Astro.url?.origin ?? 'http://localhost:4321');
const canonicalUrl = new URL('/office', site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070b12" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body>
    <main class="office-page">
      <div class="office-stage">
        <PixelAgentsApp client:only="react" />
      </div>
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
  }

  html,
  body {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: #070b12;
  }

  body {
    font-family: 'FS Pixel Sans', 'JetBrains Mono', monospace;
  }

  .office-page {
    width: 100vw;
    min-height: 100dvh;
    background:
      radial-gradient(circle at top, rgb(33 52 88 / 0.18) 0%, rgb(33 52 88 / 0) 42%),
      linear-gradient(180deg, #0b1020 0%, #070b12 100%);
  }

  .office-stage {
    width: 100vw;
    height: 100dvh;
    overflow: hidden;
  }
</style>
