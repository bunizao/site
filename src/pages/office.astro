---
import PixelAgentsApp from '@/components/pixel-agents/App';
import Layout from '../layouts/Layout.astro';

const title = 'Office | Bunizao';
const description =
  'A local page that ports the Pixel Agents webview office into this Astro site with the original React and Canvas 2D office stack.';
const sourceUrl = 'https://github.com/pablodelucca/pixel-agents/tree/main/webview-ui';
---

<Layout title={title} description={description} url="/office" showSiteNav={false}>
  <main class="office-clone-page">
    <div class="office-clone-shell">
      <div class="office-clone-meta">
        <a href="/" class="office-clone-back">← Home</a>
        <div class="office-clone-copy">
          <p class="office-clone-kicker">/office</p>
          <h1>Pixel Agents office, ported much closer to upstream.</h1>
          <p>
            This route now runs a vendored version of the
            <a href={sourceUrl} target="_blank" rel="noreferrer"> Pixel Agents webview-ui </a>
            office stack, with local mock agents, localStorage persistence, and the original editor,
            zoom controls, overlays, and canvas renderer intact.
          </p>
        </div>
      </div>

      <section class="office-clone-stage">
        <PixelAgentsApp client:only="react" />
      </section>
    </div>
  </main>
</Layout>

<style>
  .office-clone-page {
    padding-top: 5.5rem;
    padding-bottom: 2rem;
  }

  .office-clone-shell {
    width: min(1440px, calc(100vw - 1.5rem));
    margin: 0 auto;
  }

  .office-clone-meta {
    display: grid;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .office-clone-back {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: 0.65rem 0.95rem;
    border: 1px solid hsl(var(--foreground) / 0.12);
    border-radius: 999px;
    color: hsl(var(--muted-foreground));
    background: hsl(var(--background) / 0.84);
  }

  .office-clone-back:hover {
    color: hsl(var(--foreground));
    border-color: hsl(var(--foreground) / 0.24);
  }

  .office-clone-kicker {
    margin: 0 0 0.75rem;
    font-size: 0.7rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }

  .office-clone-copy h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.75rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .office-clone-copy p:last-child {
    max-width: 56rem;
    margin: 0.9rem 0 0;
    line-height: 1.8;
    color: hsl(var(--muted-foreground));
  }

  .office-clone-copy a {
    color: hsl(var(--foreground));
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  .office-clone-stage {
    position: relative;
    height: min(860px, calc(100vh - 11rem));
    min-height: 620px;
    border: 1px solid hsl(var(--foreground) / 0.12);
    border-radius: 1.5rem;
    overflow: hidden;
    background: #131320;
    box-shadow: 0 34px 100px -54px rgb(0 0 0 / 0.65);
  }

  @media (min-width: 900px) {
    .office-clone-meta {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: start;
    }

    .office-clone-back {
      margin-top: 0.25rem;
    }
  }

  @media (max-width: 640px) {
    .office-clone-page {
      padding-top: 5rem;
    }

    .office-clone-shell {
      width: calc(100vw - 1rem);
    }

    .office-clone-stage {
      min-height: 540px;
      height: calc(100vh - 13rem);
      border-radius: 1.1rem;
    }
  }
</style>
