---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import ComponentSpecimen from '@/features/components/ui/ComponentSpecimen.astro';
import ComponentsDial from '@/features/components/ui/ComponentsDial';
import '@/styles/components.css';

export const prerender = true;

const entries = (await getCollection('components', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const dialItems = entries.map((e) => ({
  slug: e.id,
  title: e.data.title,
  kind: e.data.tier,
}));

const title = 'Components';
const description =
  'The UI this site is built from — primitives, showpieces, and bespoke compositions, most installable via a shadcn registry.';
---

<Layout title={title} description={description} url="/components" hideSiteNav>
  <main class="components components--index dark">
    <header class="components-topbar">
      <a class="components-mark" href="/">← buxx.me</a>
      <span class="components-topbar-label">Components</span>
    </header>

    <section class="components-hero" aria-label="Components dial">
      <ComponentsDial items={dialItems} client:load />
    </section>

    <div class="components-page">
      <p class="components-index-label">All {entries.length} components</p>
      <div class="specimen-grid">
        {entries.map((entry, i) => (
          <ComponentSpecimen entry={entry} index={i} />
        ))}
      </div>
    </div>
  </main>
</Layout>

<script>
  // First-paint reveal — first view only, staggered per cell via inline --i.
  (() => {
    const cells = document.querySelectorAll<HTMLElement>('[data-specimen]');
    if (!cells.length) return;

    const reveal = (el: HTMLElement) => el.classList.add('is-revealed');

    if (!('IntersectionObserver' in window)) {
      cells.forEach(reveal);
      return;
    }

    const io = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            reveal(entry.target as HTMLElement);
            obs.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.1, rootMargin: '0px 0px -8% 0px' }
    );
    cells.forEach((el) => io.observe(el));

    // Fail-safe: reveal everything after a beat if the observer never fires.
    setTimeout(() => cells.forEach(reveal), 1500);
  })();
</script>
