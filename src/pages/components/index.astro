---
import Layout from '@/layouts/Layout.astro';
import ProjectStack from '@/components/project-cards/ProjectStack';
import Listening from '@/features/home/ui/Listening.astro';
import { FALLBACK_TRACK } from '@/features/home/server/listening';
import GitHubContributions from '@/features/home/ui/GitHubContributions.astro';
import DecodeTextPreview from '@/features/components/previews/DecodeTextPreview';
import HoverListPreview from '@/features/components/previews/HoverListPreview.astro';
import '@/styles/components.css';

export const prerender = true;

const title = 'Components';
const description =
  "The signature interactive pieces this site is built from — a live bento of the projects deck, decode text, listening vinyl, GitHub activity, the mood wheel, and the list hover-preview. Every tile is a self-contained specimen.";
---

<Layout title={title} description={description} url="/components" hideSiteNav>
  <main class="components components--index dark">
    <header class="components-topbar">
      <a class="components-mark" href="/">← buxx.me</a>
      <span class="components-topbar-label">Components</span>
    </header>

    <h1 class="cgrid-sr">Components — a live bento of this site's signature pieces</h1>

    <div class="cgrid" data-cgrid>
      <!-- Projects deck — the centerpiece hero; clicking a card opens the
           full-screen gallery (its own portal), the "expanded" state. Ships its
           own data, no page context. -->
      <section class="cgrid-tile cgrid-tile--projects" data-cgrid-tile style="--i:0">
        <div class="cgrid-stage cgrid-stage--projects">
          <ProjectStack client:visible />
        </div>
        <span class="cgrid-cap">Projects deck</span>
      </section>

      <!-- Mood wheel — genuinely needs isolation (fixed positioning + it takes
           over window scroll), so it's iframed. The fixture is pure synthetic
           mock: abstract one-liners, mock dates — no real mood content. -->
      <section class="cgrid-tile cgrid-tile--mood cgrid-tile--iframe" data-cgrid-tile style="--i:1">
        <iframe src="/components/preview/mood-wheel" title="Mood wheel" loading="lazy"></iframe>
        <span class="cgrid-cap">Mood wheel</span>
      </section>

      <!-- Listening — spins, samples the artwork colour, plays a preview with a
           scrubbable progress bar on click. Frozen on a demo track. -->
      <section class="cgrid-tile cgrid-tile--listening" data-cgrid-tile style="--i:2">
        <div class="cgrid-stage">
          <Listening track={FALLBACK_TRACK} static />
        </div>
        <span class="cgrid-cap">Listening</span>
      </section>

      <!-- Decode text — click or hover to re-boil the glyphs. -->
      <section class="cgrid-tile cgrid-tile--decode" data-cgrid-tile style="--i:3">
        <div class="cgrid-stage">
          <DecodeTextPreview client:visible />
        </div>
        <span class="cgrid-cap">Decode text</span>
      </section>

      <!-- GitHub contributions — self-renders standalone; hover for tooltips. -->
      <section class="cgrid-tile cgrid-tile--contrib" data-cgrid-tile style="--i:4">
        <div class="cgrid-stage cgrid-stage--contrib">
          <GitHubContributions />
        </div>
        <span class="cgrid-cap">GitHub activity</span>
      </section>

      <!-- List hover-preview — the sliding pill + cursor-aware side preview, as
           a self-contained specimen with invented rows and CSS swatches (no
           real posts / images). -->
      <section class="cgrid-tile cgrid-tile--hover" data-cgrid-tile style="--i:5">
        <div class="cgrid-stage cgrid-stage--hover">
          <HoverListPreview />
        </div>
        <span class="cgrid-cap">List hover</span>
      </section>
    </div>
  </main>
</Layout>

<script>
  // Light per-tile reveal on first view — staggered by inline --i. No install
  // copy here; the grid is a live gallery of self-contained specimens.
  (() => {
    const tiles = document.querySelectorAll<HTMLElement>('[data-cgrid-tile]');
    if (!tiles.length) return;
    const reveal = (el: HTMLElement) => el.classList.add('is-revealed');

    if (!('IntersectionObserver' in window)) {
      tiles.forEach(reveal);
      return;
    }

    const io = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            reveal(entry.target as HTMLElement);
            obs.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.05, rootMargin: '0px 0px -6% 0px' }
    );
    tiles.forEach((el) => io.observe(el));
    setTimeout(() => tiles.forEach(reveal), 1500);
  })();
</script>
