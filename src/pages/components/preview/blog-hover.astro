---
// Standalone fixture for the "blog hover-hero" showcase tile — iframed by the
// /components grid. Reuses the real blog list row (PostRow) + the real
// cursor-following hero-preview behavior (PostHover) + blog.css, so the demo is
// the genuine article, not a re-implementation. Desktop-only effect by design.
import PostRow from '@/features/posts/ui/PostRow.astro';
import PostHover from '@/features/posts/ui/PostHover.astro';
import { getAllPosts } from '@/features/posts/server/content';
import '@/styles/globals.css';
import '@/styles/blog.css';

export const prerender = true;

// Only rows with a feature image demonstrate the hover preview.
const posts = (await getAllPosts()).filter((post) => post.featureImage).slice(0, 5);
---

<!doctype html>
<html lang="en" class="blog-zone">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Blog hover preview</title>
  </head>
  <body>
    <main class="blog-shell">
      <p class="hover-fixture-hint">Hover a title — its hero image tracks the cursor.</p>
      <ul class="blog-list">
        {posts.map((post) => (
          <PostRow post={post} />
        ))}
      </ul>
    </main>

    <PostHover />
  </body>
</html>

<style>
  :global(html) {
    color-scheme: light dark;
    background: hsl(var(--background));
  }

  :global(body) {
    margin: 0;
    color: hsl(var(--foreground));
    background: hsl(var(--background));
    font-family: var(--font-sans);
  }

  .hover-fixture-hint {
    margin: 0 0 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }
</style>
