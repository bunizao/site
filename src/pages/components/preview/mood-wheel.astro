---
import TimelineWheel from '@/features/mood/ui/TimelineWheel.astro';
import '@/styles/globals.css';

export const prerender = true;

const groups = [
  {
    date: '2026-07-11',
    label: 'Today',
    moods: ['The registry finally reads the source instead of trusting a copy.', 'Small APIs age better.'],
  },
  {
    date: '2026-07-10',
    label: 'Yesterday',
    moods: ['A precise wheel is mostly restraint disguised as physics.', 'The last ten percent is always cleanup.'],
  },
  {
    date: '2026-07-08',
    label: 'Jul 8',
    moods: ['Quiet code, loud result.', 'The best fixture is just enough reality.'],
  },
  {
    date: '2026-07-04',
    label: 'Jul 4',
    moods: ['Scroll changes the instrument one notch at a time.', 'A dial you can feel beats a scrollbar you can’t.'],
  },
  {
    date: '2026-06-30',
    label: 'Jun 30',
    moods: ['Ship the boring version first.'],
  },
];
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Mood wheel preview</title>
  </head>
  <body>
    <main class="fixture">
      <TimelineWheel compact />
      <div class="fixture-feed" data-mood-feed>
        <header class="fixture-intro">
          <span class="fixture-eyebrow">Fixture feed</span>
          <h1>Days, wound into a dial.</h1>
          <p>Scroll the cards — the fixed wheel tracks the active date.</p>
        </header>

        <div class="fixture-list" data-mood-list role="region" aria-label="Mood wheel fixture" aria-busy="false">
          {groups.map((group) => (
            <section class="mood-date-group" data-date={group.date}>
              <div class="mood-date-header">
                <span>{group.label}</span>
                <span aria-hidden="true"></span>
              </div>
              {group.moods.map((mood) => (
                <article class="mood-item">
                  <p>{mood}</p>
                  <time datetime={`${group.date}T12:00:00+08:00`}>12:00</time>
                </article>
              ))}
            </section>
          ))}
        </div>
      </div>
    </main>
  </body>
</html>

<style>
  :global(html) {
    color-scheme: light dark;
    background: hsl(var(--background));
  }

  :global(body) {
    margin: 0;
    color: hsl(var(--foreground));
    background:
      linear-gradient(hsl(var(--foreground) / 0.03) 1px, transparent 1px),
      hsl(var(--background));
    background-size: 100% 3rem;
    font-family: var(--font-sans);
  }

  .fixture {
    min-height: 100vh;
  }

  /* The wheel is fixed to the viewport (here, the iframe) — force it visible in
     this compact fixture so the arc reads even in a short tile. */
  :global(.timeline-wheel[data-timeline-wheel-compact]) {
    display: block;
  }

  /* Compact tile geometry: the feed hugs the wheel on the left and stays narrow
     so nothing overflows the cell. */
  .fixture-feed {
    width: min(24rem, calc(100% - 4.5rem));
    margin: 0 0 0 auto;
    padding: 2.5rem 1.25rem 4rem;
  }

  /* A small header, not a 55vh editorial hero — the tile can't afford one. */
  .fixture-intro {
    margin-bottom: 2.5rem;
  }

  .fixture-eyebrow,
  .mood-date-header,
  .mood-item time {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }

  .fixture-intro h1 {
    max-width: 12ch;
    margin: 0.7rem 0 0.5rem;
    font-size: clamp(1.5rem, 4.5vw, 2rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .fixture-intro p {
    max-width: 26ch;
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.45;
    color: hsl(var(--muted-foreground));
  }

  .fixture-list {
    display: grid;
    gap: 2.25rem;
  }

  .mood-date-group {
    display: grid;
    gap: 0.6rem;
  }

  .mood-date-header {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.7rem;
  }

  .mood-date-header span:last-child {
    height: 1px;
    background: hsl(var(--border) / 0.35);
  }

  .mood-item {
    min-height: 4.5rem;
    padding: 0.9rem 1rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.6rem;
    border: 1px solid hsl(var(--border) / 0.35);
    border-radius: var(--radius);
    background: hsl(var(--card));
  }

  .mood-item p {
    max-width: 28ch;
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.45;
  }
</style>
