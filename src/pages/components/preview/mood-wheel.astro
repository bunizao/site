---
import TimelineWheel from '@/features/mood/ui/TimelineWheel.astro';
import '@/styles/globals.css';

export const prerender = true;

const groups = [
  {
    date: '2026-07-11',
    label: 'Today',
    moods: ['The registry finally reads the source instead of trusting a copy.', 'Small APIs age better.'],
  },
  {
    date: '2026-07-10',
    label: 'Yesterday',
    moods: ['A precise wheel is mostly restraint disguised as physics.', 'The last ten percent is always cleanup.'],
  },
  {
    date: '2026-07-08',
    label: 'Jul 8',
    moods: ['Quiet code, loud result.', 'The best fixture is just enough reality.'],
  },
  {
    date: '2026-07-04',
    label: 'Jul 4',
    moods: ['Scroll changes the instrument one notch at a time.', 'A dial you can feel beats a scrollbar you can’t.'],
  },
  {
    date: '2026-06-30',
    label: 'Jun 30',
    moods: ['Ship the boring version first.'],
  },
];
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Mood wheel preview</title>
  </head>
  <body>
    <main class="fixture">
      <TimelineWheel compact />
      <div class="fixture-feed" data-mood-feed>
        <header class="fixture-intro">
          <span class="fixture-eyebrow">Scroll ↓</span>
        </header>

        <div class="fixture-list" data-mood-list role="region" aria-label="Mood wheel fixture" aria-busy="false">
          {groups.map((group) => (
            <section class="mood-date-group" data-date={group.date}>
              <div class="mood-date-header">
                <span>{group.label}</span>
                <span aria-hidden="true"></span>
              </div>
              {group.moods.map((mood) => (
                <article class="mood-item">
                  <p>{mood}</p>
                  <time datetime={`${group.date}T12:00:00+08:00`}>12:00</time>
                </article>
              ))}
            </section>
          ))}
        </div>
      </div>
    </main>
  </body>
</html>

<style>
  :global(html) {
    color-scheme: light dark;
    background: hsl(var(--background));
  }

  :global(body) {
    margin: 0;
    color: hsl(var(--foreground));
    background:
      linear-gradient(hsl(var(--foreground) / 0.03) 1px, transparent 1px),
      hsl(var(--background));
    background-size: 100% 3rem;
    font-family: var(--font-sans);
  }

  .fixture {
    min-height: 100vh;
  }

  /* The wheel is fixed to the viewport (here, the iframe). Force it visible and
     make the DIAL the subject of this tile: a tighter wheel-size gives a more
     obviously circular arc, and a wide visible-width exposes the full graduated
     notch column rather than a sliver at the edge. */
  :global(.timeline-wheel[data-timeline-wheel-compact]) {
    display: block;
    --wheel-size: 460px;
    --visible-width: 150px;
    height: 84vh;
    transform: translateY(-50%) translateX(10px);
  }

  /* The feed hugs the dial on the right — a slim driver strip whose only job is
     to give the wheel something to track. Understated so the dial carries it. */
  .fixture-feed {
    width: min(14rem, calc(100% - 10rem));
    margin: 0 1rem 0 auto;
    padding: 3rem 0 5rem;
  }

  .fixture-intro {
    margin-bottom: 1.5rem;
    text-align: right;
  }

  .fixture-eyebrow,
  .mood-date-header,
  .mood-item time {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }

  .fixture-list {
    display: grid;
    gap: 1.75rem;
  }

  .mood-date-group {
    display: grid;
    gap: 0.5rem;
  }

  .mood-date-header {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.6rem;
  }

  .mood-date-header span:last-child {
    height: 1px;
    background: hsl(var(--border) / 0.35);
  }

  .mood-item {
    min-height: 3.5rem;
    padding: 0.7rem 0.85rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.5rem;
    border: 1px solid hsl(var(--border) / 0.35);
    border-radius: var(--radius);
    background: hsl(var(--card));
  }

  .mood-item p {
    max-width: 20ch;
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.4;
  }
</style>
