---
import TimelineScrubber from '@/features/mood/ui/TimelineScrubber.astro';
import TimelineWheel from '@/features/mood/ui/TimelineWheel.astro';
import '@/styles/globals.css';

export const prerender = true;

// The wheel is the whole show. It winds off the scroll position of a feed of
// dated groups — so instead of real mood cards (content clutters the frame), we
// give it a long run of *invisible* date anchors that still occupy real height,
// so the page genuinely scrolls. A scroll-tracked monochrome sheen washes the
// backdrop so the emptiness stays alive without introducing off-palette colour.
const DAY = 86_400_000;
const BASE = Date.UTC(2026, 6, 12); // 2026-07-12, fixed (no Date.now in build)
// Fixed, uneven post counts per day. Two things ride on them: the notches are
// graduated by how busy a day was, and the sections are as tall as their counts
// — which is the whole point of the jog wheel measuring travel in dates rather
// than pixels. Dragging past a 9-post day must cost the same as a 1-post day.
const COUNTS = [3, 1, 9, 2, 6, 1, 12, 4, 1, 7];
const groups = COUNTS.map((count, i) => {
  const d = new Date(BASE - i * DAY);
  const iso = d.toISOString().slice(0, 10);
  const label = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
  return { date: iso, label, count };
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Mood wheel preview</title>
    <script is:inline>
      (() => {
        const media = window.matchMedia('(prefers-color-scheme: dark)');
        const applyTheme = () => {
          let stored = null;
          try {
            stored = localStorage.getItem('theme');
          } catch {}
          const dark = stored === 'dark' || (stored !== 'light' && media.matches);
          document.documentElement.classList.toggle('dark', dark);
          document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
        };
        applyTheme();
        window.addEventListener('storage', (event) => {
          if (event.key === 'theme') applyTheme();
        });
        media.addEventListener('change', applyTheme);
      })();
    </script>
  </head>
  <body>
    <div class="sheen" data-sheen aria-hidden="true"></div>

    <main class="fixture">
      <TimelineWheel compact />
      <TimelineScrubber />

      <!-- The scroll driver: invisible dated anchors that still take up height,
           nothing to read. The wheel reads their positions to build notches and
           wind the dial. -->
      <div class="fixture-feed" data-mood-feed>
        <div class="fixture-list" data-mood-list role="region" aria-label="Mood wheel fixture" aria-busy="false">
          {groups.map((group) => (
            <section
              class="mood-date-group"
              data-date={group.date}
              style={`--group-count: ${group.count}`}
              aria-hidden="true"
            >
              <div class="mood-date-header"><span>{group.label}</span></div>
              {Array.from({ length: group.count }, () => <article class="mood-item"></article>)}
            </section>
          ))}
        </div>
      </div>

      <span class="fixture-hint" aria-hidden="true">Scroll ↓</span>
    </main>

    <script>
      // Track scroll and paint it onto the backdrop sheen: a soft monochrome
      // glow drifts down the page as you travel, and a faint grid slides with
      // it — so the empty canvas reacts to the wheel's motion. No hue, on-palette.
      const el = document.querySelector<HTMLElement>('[data-sheen]');
      if (el) {
        let raf = 0;
        const paint = () => {
          raf = 0;
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const p = max > 0 ? window.scrollY / max : 0;
          el.style.setProperty('--p', p.toFixed(4));
        };
        paint();
        window.addEventListener(
          'scroll',
          () => { if (!raf) raf = requestAnimationFrame(paint); },
          { passive: true }
        );
      }
    </script>
  </body>
</html>

<style>
  :global(html) {
    background: hsl(var(--background));
    scrollbar-width: none;
  }

  :global(html::-webkit-scrollbar) {
    display: none;
  }

  :global(body) {
    margin: 0;
    color: hsl(var(--foreground));
    background: hsl(var(--background));
    font-family: var(--font-sans);
    overflow-x: hidden;
  }

  /* Scroll-tracked backdrop. A monochrome radial glow slides down as --p (0→1)
     grows — the "sheen" that follows the scroll. Strictly foreground-tinted, so
     it stays on the site's greyscale palette. */
  .sheen {
    --p: 0;
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      44rem 44rem at calc(40% + var(--p) * 6%) calc(-8% + var(--p) * 116%),
      hsl(var(--foreground) / 0.08),
      transparent 62%
    );
    transition: background 0.1s linear;
  }

  /* A faint moving grid so the scroll reads as travel, not a static void. */
  .sheen::after {
    content: '';
    position: absolute;
    inset: -10%;
    background: linear-gradient(hsl(var(--foreground) / 0.035) 1px, transparent 1px);
    background-size: 100% 4.5rem;
    transform: translateY(calc(var(--p) * -6rem));
    opacity: 0.6;
  }

  .fixture {
    position: relative;
    z-index: 1;
    min-height: 100vh;
  }

  /* Make the DIAL the subject: tight wheel-size reads as an obvious arc, wide
     visible-width exposes the full graduated notch column at the edge. */
  :global(.timeline-wheel[data-timeline-wheel-compact]) {
    display: block;
    --wheel-size: 520px;
    --visible-width: 132px;
    height: 88vh;
  }

  /* Invisible, finite scroll driver. The browser scrollbar stays hidden: the
     dial is the progress indicator, and ten anchors give it a deliberate end. */
  .fixture-feed {
    position: relative;
    width: 100%;
    opacity: 0;
    pointer-events: none;
  }

  .fixture-list {
    display: block;
  }

  /* Height tracks the day's post count, the way a real feed's does. */
  .mood-date-group {
    height: calc(12vh + var(--group-count, 1) * 9vh);
  }

  /* Persistent scroll cue, bottom-right, riding above the sheen. */
  .fixture-hint {
    position: fixed;
    right: 1.25rem;
    bottom: 1.1rem;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
    animation: hint-bob 1.8s ease-in-out infinite;
  }

  @keyframes hint-bob {
    0%, 100% { transform: translateY(0); opacity: 0.5; }
    50% { transform: translateY(3px); opacity: 0.9; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fixture-hint { animation: none; }
    .sheen { transition: none; }
  }
</style>
