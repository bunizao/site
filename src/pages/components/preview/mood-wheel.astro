---
import TimelineWheel from '@/features/mood/ui/TimelineWheel.astro';
import '@/styles/globals.css';

export const prerender = true;

// The wheel is the whole show here. It winds off the scroll position of a feed
// of dated groups — so instead of real mood cards (content clutters the frame),
// we give it a long run of *invisible* date anchors. The reader just scrolls;
// the dial and its rolling date readout are the specimen. A scroll-tracked
// shimmer washes the backdrop so the emptiness still feels alive.
const DAY = 86_400_000;
const BASE = Date.UTC(2026, 6, 12); // 2026-07-12, fixed (no Date.now in build)
const groups = Array.from({ length: 24 }, (_, i) => {
  const d = new Date(BASE - i * DAY);
  const iso = d.toISOString().slice(0, 10);
  const label = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
  return { date: iso, label };
});
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Mood wheel preview</title>
  </head>
  <body>
    <div class="shimmer" data-shimmer aria-hidden="true"></div>

    <main class="fixture">
      <TimelineWheel compact />

      <!-- The scroll driver: invisible dated anchors, nothing to read. The wheel
           reads their positions to build notches and wind the dial. -->
      <div class="fixture-feed" data-mood-feed>
        <div class="fixture-list" data-mood-list role="region" aria-label="Mood wheel fixture" aria-busy="false">
          {groups.map((group) => (
            <section class="mood-date-group" data-date={group.date} aria-hidden="true">
              <div class="mood-date-header"><span>{group.label}</span></div>
              <article class="mood-item"></article>
            </section>
          ))}
        </div>
      </div>

      <span class="fixture-hint" aria-hidden="true">Scroll ↓</span>
    </main>

    <script>
      // Track scroll and paint it onto the backdrop shimmer: a soft radial glow
      // drifts down the page and the hue eases as you travel, so the empty
      // canvas reacts to the wheel's motion instead of sitting dead.
      const el = document.querySelector<HTMLElement>('[data-shimmer]');
      if (el) {
        let raf = 0;
        const paint = () => {
          raf = 0;
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const p = max > 0 ? window.scrollY / max : 0;
          el.style.setProperty('--p', p.toFixed(4));
        };
        paint();
        window.addEventListener(
          'scroll',
          () => { if (!raf) raf = requestAnimationFrame(paint); },
          { passive: true }
        );
      }
    </script>
  </body>
</html>

<style>
  :global(html) {
    color-scheme: dark;
    background: hsl(var(--background));
  }

  :global(body) {
    margin: 0;
    color: hsl(var(--foreground));
    background: hsl(var(--background));
    font-family: var(--font-sans);
    overflow-x: hidden;
  }

  /* Scroll-tracked backdrop. A radial glow slides down as --p (0→1) grows, and
     its tint eases from cool to warm — the "shimmer" that follows the scroll. */
  .shimmer {
    --p: 0;
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(
        42rem 42rem at calc(38% + var(--p) * 8%) calc(-10% + var(--p) * 120%),
        hsl(calc(210 + var(--p) * 90) 70% 60% / 0.16),
        transparent 60%
      ),
      radial-gradient(
        30rem 30rem at calc(70% - var(--p) * 12%) calc(120% - var(--p) * 120%),
        hsl(calc(280 - var(--p) * 60) 70% 60% / 0.12),
        transparent 60%
      );
    transition: background 0.1s linear;
  }

  /* A faint moving grid so the scroll reads as travel, not a static void. */
  .shimmer::after {
    content: '';
    position: absolute;
    inset: -10%;
    background: linear-gradient(hsl(var(--foreground) / 0.035) 1px, transparent 1px);
    background-size: 100% 4.5rem;
    transform: translateY(calc(var(--p) * -6rem));
    opacity: 0.6;
  }

  .fixture {
    position: relative;
    z-index: 1;
    min-height: 100vh;
  }

  /* Make the DIAL the subject: tight wheel-size reads as an obvious arc, wide
     visible-width exposes the full graduated notch column at the edge. */
  :global(.timeline-wheel[data-timeline-wheel-compact]) {
    display: block;
    --wheel-size: 520px;
    --visible-width: 132px;
    height: 88vh;
    transform: translateY(-50%) translateX(6px);
  }

  /* Invisible scroll driver. It occupies real height (that's what the wheel
     winds against) but shows nothing — each group is a tall empty span. */
  .fixture-feed {
    position: absolute;
    inset: 0 0 0 auto;
    width: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .fixture-list {
    display: block;
  }

  .mood-date-group {
    /* Tall, so the full run scrolls long enough to feel endless in the tile. */
    height: 34vh;
  }

  /* Persistent scroll cue, bottom-right, riding above the shimmer. */
  .fixture-hint {
    position: fixed;
    right: 1.25rem;
    bottom: 1.1rem;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
    animation: hint-bob 1.8s ease-in-out infinite;
  }

  @keyframes hint-bob {
    0%, 100% { transform: translateY(0); opacity: 0.5; }
    50% { transform: translateY(3px); opacity: 0.9; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fixture-hint { animation: none; }
    .shimmer { transition: none; }
  }
</style>
