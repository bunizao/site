---
import Page from '@/layouts/Page.astro';
import { Content, frontmatter } from '@/content/pages/privacy.md';

const {
  title,
  description,
  updatedAt,
} = frontmatter as {
  title: string;
  description: string;
  updatedAt: string;
};
---

<Page
  title={title}
  description={description}
  url="/privacy"
  updatedAt={updatedAt}
>
  <Content />
</Page>
