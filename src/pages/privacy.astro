---
import Layout from '@/layouts/Layout.astro';
import Footer from '@/features/home/ui/Footer.astro';
import { Content, frontmatter } from '@/content/pages/privacy.md';
import { getContentRevision } from '@/lib/content-revision';
import { formatSiteTitle } from '@/lib/seo';

const CONTENT_PATH = 'src/content/pages/privacy.md';

const {
  title,
  description,
  updatedAt,
} = frontmatter as {
  title: string;
  description: string;
  updatedAt: string;
};

// Resolved at build time. Git is the source of truth for when the policy last
// changed; the frontmatter date is only the fallback for builds without history.
const revision = getContentRevision(CONTENT_PATH);
const updatedLabel = revision?.displayDate ?? updatedAt;
---

<Layout
  preloadFont={['display', 'mono', 'sans']}
  title={formatSiteTitle(title)}
  description={description}
  url="/privacy"
  navVariant="page"
  showSiteNav
  brandVariant="home"
>
  <main class="privacy">
    <article class="privacy-content">
      <p class="privacy-eyebrow">
        Updated <time datetime={revision?.isoDate}>{updatedLabel}</time>
        {revision && (
          <>
            <span class="privacy-eyebrow-sep" aria-hidden="true">·</span>
            <a
              class="privacy-revision"
              href={revision.commitUrl}
              rel="noreferrer"
              title={`Commit ${revision.shortSha} on GitHub`}
            >{revision.shortSha}</a>
          </>
        )}
      </p>
      <Content />
    </article>
  </main>
  <Footer />
</Layout>

<style>
  :global(body:has(.privacy)::before) {
    display: none;
  }

  .privacy {
    /* One ink ramp for the whole page. Hierarchy is carried by weight, size,
       and these four opacities — never by rules between sections. */
    --ink-strong: hsl(var(--foreground) / 0.92);
    --ink-lede: hsl(var(--foreground) / 0.78);
    --ink-body: hsl(var(--foreground) / 0.64);
    /* 0.55 is the floor here, not a taste call: the eyebrow and the section
       numerals are ~11px, and anything fainter drops the eyebrow under the
       4.5:1 AA threshold in light mode. */
    --ink-faint: hsl(var(--foreground) / 0.55);
    /* Gutter the hung section numerals live in. Collapses to 0 below 62rem,
       where the numerals sit inline above the heading instead. */
    --spine: 0rem;

    min-height: 100vh;
    /* Top clearance for the fixed brand-home bar lives on .site-shell
       (globals.css); keep only a small residual so the gap reads intentional. */
    padding: 1rem 0 6rem;
    background: hsl(var(--background));
    color: hsl(var(--foreground));
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  .privacy-content {
    /* 36rem of Inter at 1.0625rem ≈ 68 characters — the long-form measure.
       The spine is added on top so the prose column itself never widens. */
    width: min(calc(36rem + var(--spine)), 100% - 2.5rem);
    margin: 0 auto;
    padding-left: var(--spine);
    font-family: var(--font-sans);
    counter-reset: section;
  }

  @media (min-width: 62rem) {
    .privacy {
      --spine: 3.5rem;
    }
  }

  /* Document metadata, not a kicker. Uppercase tracked-out mono shouts at the
     title it sits above and clashes with the Inter prose underneath; the same
     information set in sentence-case sans recedes to where it belongs. Mono is
     kept for the hash alone, which is a literal data readout. */
  .privacy-eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.9rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    line-height: 1.4;
    letter-spacing: -0.005em;
    color: var(--ink-faint);
  }

  .privacy-eyebrow time {
    /* The date is the one figure here that changes between deploys; tabular
       figures keep the line from reflowing when it does. */
    font-variant-numeric: tabular-nums;
  }

  .privacy-eyebrow-sep {
    color: hsl(var(--foreground) / 0.28);
  }

  /* The hash reads as a chip so the line still parses as metadata rather than
     as a stray opening sentence — the job the uppercase mono used to do, minus
     the shouting. */
  .privacy-eyebrow .privacy-revision {
    position: relative;
    padding: 0.15em 0.45em;
    border-radius: 0.375rem;
    background: hsl(var(--foreground) / 0.06);
    font-family: var(--font-code);
    font-size: 0.9em;
    letter-spacing: 0;
    color: var(--ink-body);
    text-decoration: none;
    transition: background-color 0.18s ease, color 0.18s ease;
  }

  /* The chip is ~22px tall inline; extend the touch target to 40px without
     disturbing the line box. */
  .privacy-eyebrow .privacy-revision::after {
    content: '';
    position: absolute;
    inset: -0.55rem -0.3rem;
  }

  .privacy-eyebrow .privacy-revision:hover,
  .privacy-eyebrow .privacy-revision:focus-visible {
    background: hsl(var(--foreground) / 0.1);
    color: var(--ink-strong);
  }

  .privacy-content :global(h1) {
    max-width: 16ch;
    margin: 0 0 1.75rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3.1rem);
    font-weight: 700;
    line-height: 1.03;
    letter-spacing: -0.035em;
    color: hsl(var(--foreground));
    text-wrap: balance;
  }

  /* Lede — the paragraph directly under the title carries the summary and is
     set one step up from body so the page opens with a clear entry point. */
  .privacy-content :global(h1 + p) {
    font-size: 1.2rem;
    line-height: 1.6;
    letter-spacing: -0.014em;
    color: var(--ink-lede);
  }

  .privacy-content :global(h2) {
    position: relative;
    margin: 4rem 0 1.15rem;
    /* Clears the fixed brand bar when a section is reached by anchor link. */
    scroll-margin-top: 6rem;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.4vw, 1.55rem);
    font-weight: 650;
    line-height: 1.2;
    letter-spacing: -0.028em;
    color: var(--ink-strong);
    text-wrap: balance;
    counter-increment: section;
  }

  /* Numbered spine. Replaces the old full-width rule above every section: it
     anchors the eye down the left edge without cutting the page into fifteen
     visually equal slabs. */
  .privacy-content :global(h2::before) {
    content: counter(section, decimal-leading-zero);
    display: block;
    margin-bottom: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.12em;
    font-variant-numeric: tabular-nums;
    color: var(--ink-faint);
  }

  @media (min-width: 62rem) {
    .privacy-content :global(h2::before) {
      position: absolute;
      left: calc(-1 * var(--spine));
      /* Optical, not geometric: the numeral is nudged down to sit against the
         cap-height of the heading rather than the top of its line box. */
      top: 0.52em;
      margin-bottom: 0;
    }
  }

  /* The eyebrow is a <p> inside .privacy-content, so it loses to a bare
     `.privacy-content p` on specificity (two classes beat one) and silently
     inherits body size and tracking. Exclude it rather than escalating the
     eyebrow's own selector — the intent stays readable at the rule that
     would otherwise clobber it. */
  .privacy-content :global(p:not(.privacy-eyebrow)),
  .privacy-content :global(li) {
    font-size: 1.0625rem;
    line-height: 1.7;
    letter-spacing: -0.009em;
    color: var(--ink-body);
    text-wrap: pretty;
    overflow-wrap: break-word;
  }

  .privacy-content :global(p:not(.privacy-eyebrow)) {
    margin: 0;
  }

  /* Paragraphs reset to margin: 0, so every block that can precede one has to
     re-open the gap explicitly — otherwise the closing line of a section
     ("That is the full list…") collides with the last bullet above it. */
  /* These carry the same :not() as the reset above on purpose: without it they
     score one class lower and lose to `margin: 0`, silently collapsing every
     paragraph gap on the page. */
  .privacy-content :global(p + p:not(.privacy-eyebrow)),
  .privacy-content :global(ul + p:not(.privacy-eyebrow)),
  .privacy-content :global(ol + p:not(.privacy-eyebrow)) {
    margin-top: 1.15rem;
  }

  /* Summary card. The "in short" blockquote is the one thing most visitors
     actually need, so it gets a surface — a tint plus a hairline inset shadow,
     which adapts to either theme in a way a solid border can't. */
  .privacy-content :global(blockquote) {
    margin: 1.75rem 0 0;
    padding: 1.15rem 1.35rem;
    border-radius: 0.875rem;
    background: hsl(var(--foreground) / 0.035);
    box-shadow: inset 0 0 0 1px hsl(var(--foreground) / 0.07);
  }

  .privacy-content :global(blockquote p) {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--ink-lede);
  }

  .privacy-content :global(blockquote strong) {
    color: var(--ink-strong);
  }

  .privacy-content :global(ul),
  .privacy-content :global(ol) {
    margin: 1.15rem 0 0;
    padding-left: 1.1rem;
  }

  .privacy-content :global(ul) {
    list-style: disc;
  }

  .privacy-content :global(ol) {
    list-style: decimal;
  }

  .privacy-content :global(li + li) {
    margin-top: 0.7rem;
  }

  .privacy-content :global(li::marker) {
    color: hsl(var(--foreground) / 0.28);
  }

  .privacy-content :global(strong) {
    font-weight: 600;
    color: var(--ink-strong);
  }

  /* Term lead-ins ("**Cloudflare** — hosting…") read as labels, so they get a
     hair of negative tracking to stop the bold weight from looking loose. */
  .privacy-content :global(li > strong:first-child) {
    letter-spacing: -0.012em;
  }

  .privacy-content :global(a) {
    color: hsl(var(--foreground));
    text-decoration: underline;
    text-decoration-color: hsl(var(--foreground) / 0.28);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition: text-decoration-color 0.18s ease;
  }

  .privacy-content :global(a:hover),
  .privacy-content :global(a:focus-visible) {
    text-decoration-color: hsl(var(--foreground));
  }

  .privacy-content :global(code) {
    font-family: var(--font-code);
    font-size: 0.9em;
    letter-spacing: -0.01em;
    color: var(--ink-strong);
  }

  /* Header enter. Runs once, on a page nobody revisits often — the only place
     here where motion earns its keep. Sections below stay static on purpose: a
     scroll reveal on a policy you are trying to read or Ctrl+F is friction. */
  .privacy-eyebrow,
  .privacy-content :global(h1),
  .privacy-content :global(h1 + p),
  .privacy-content :global(blockquote) {
    animation: privacy-enter 0.42s cubic-bezier(0.23, 1, 0.32, 1) both;
  }

  .privacy-content :global(h1) {
    animation-delay: 0.06s;
  }

  .privacy-content :global(h1 + p) {
    animation-delay: 0.12s;
  }

  .privacy-content :global(blockquote) {
    animation-delay: 0.18s;
  }

  @keyframes privacy-enter {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @media (max-width: 560px) {
    .privacy {
      padding: 0.75rem 0 4.5rem;
    }

    .privacy-content {
      width: calc(100% - 2rem);
    }

    .privacy-content :global(h1) {
      max-width: 14ch;
      margin-bottom: 1.5rem;
    }

    .privacy-content :global(h1 + p) {
      font-size: 1.1rem;
      line-height: 1.58;
    }

    .privacy-content :global(h2) {
      margin-top: 3rem;
    }

    .privacy-content :global(p),
    .privacy-content :global(li) {
      font-size: 1rem;
      line-height: 1.68;
    }

    .privacy-content :global(blockquote) {
      padding: 1rem 1.15rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .privacy-content :global(a),
    .privacy-eyebrow .privacy-revision {
      transition: none;
    }

    .privacy-eyebrow,
    .privacy-content :global(h1),
    .privacy-content :global(h1 + p),
    .privacy-content :global(blockquote) {
      animation: none;
    }
  }
</style>
