---
import Layout from '../layouts/Layout.astro';

const title = '404 - page not found';
const description = "The page you're looking for isn't here.";
---

<Layout title={title} description={description} hideSiteNav>
  <main class="not-found" data-not-found>
    <canvas class="nf-canvas" data-error-canvas aria-hidden="true"></canvas>
    <a class="nf-brand" href="/" aria-label="Bunizao home">Bunizao</a>

    <section class="nf-copy" aria-labelledby="not-found-title">
      <p class="nf-kicker">lost signal / 404</p>
      <h1 id="not-found-title">Page not found</h1>
      <p>this page slipped out of the index.</p>
      <a href="/" class="nf-home">go home</a>
    </section>
  </main>
</Layout>

<style>
  @font-face {
    font-family: 'Geist Pixel Square';
    src: url('/fonts/geist-pixel-square.woff2') format('woff2');
    font-display: swap;
  }

  :global(body:has(.not-found) .global-header-actions) {
    display: none;
  }

  :global(body:has(.not-found) .site-shell) {
    min-height: 100svh;
  }

  .not-found {
    --nf-bg: hsl(var(--background));
    --nf-fg: hsl(var(--foreground));
    --nf-muted: hsl(var(--muted-foreground));
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    color: var(--nf-fg);
    background: var(--nf-bg);
    isolation: isolate;
  }

  .nf-canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    background: var(--nf-bg);
  }

  .nf-brand {
    position: fixed;
    top: clamp(16px, 2.4vw, 28px);
    left: clamp(16px, 2.4vw, 28px);
    z-index: 2;
    color: var(--nf-fg);
    font-size: clamp(16px, 1.7vw, 24px);
    font-weight: 720;
    line-height: 1;
    letter-spacing: -0.045em;
    text-decoration: none;
    mix-blend-mode: normal;
  }

  .nf-brand::after {
    content: "®";
    position: relative;
    top: -0.44em;
    margin-left: 1px;
    font-size: 0.46em;
    font-weight: 500;
    letter-spacing: 0;
  }

  .nf-copy {
    position: fixed;
    right: clamp(18px, 2.8vw, 34px);
    bottom: clamp(18px, 2.8vw, 34px);
    left: clamp(18px, 2.8vw, 34px);
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 10px 24px;
    pointer-events: none;
  }

  .nf-kicker,
  .nf-copy h1,
  .nf-copy p,
  .nf-home {
    margin: 0;
    font-size: 11px;
    line-height: 1.35;
    letter-spacing: 0.02em;
    text-transform: lowercase;
  }

  .nf-kicker {
    position: fixed;
    top: clamp(82px, 8vw, 118px);
    right: clamp(18px, 4vw, 56px);
    color: var(--nf-muted);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.24em;
    writing-mode: vertical-rl;
  }

  .nf-copy h1 {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .nf-copy p {
    max-width: 32ch;
    color: hsl(var(--foreground) / 0.5);
  }

  .nf-home {
    position: relative;
    color: var(--nf-fg);
    pointer-events: auto;
    text-decoration: none;
  }

  .nf-home::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -4px;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 180ms ease;
  }

  .nf-home:hover::after,
  .nf-home:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  @media (max-width: 640px) {
    .nf-copy {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 8px;
    }

    .nf-kicker {
      top: auto;
      right: auto;
      bottom: 104px;
      left: 20px;
      writing-mode: horizontal-tb;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nf-home::after {
      transition: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-not-found]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-error-canvas]');

  if (root && canvas) {
    const ctx = canvas.getContext('2d', { alpha: false });
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (ctx) {
      const mask = document.createElement('canvas');
      const maskCtx = mask.getContext('2d', { alpha: true });
      const pointer = { x: 0.55, y: 0.42, active: false };
      let width = 0;
      let height = 0;
      let dpr = 1;
      let frame = 0;
      let animationFrame = 0;
      let colors = readColors();

      const drawOnce = () => {
        draw(performance.now() * 0.001);
      };

      const resize = () => {
        const rect = root.getBoundingClientRect();
        width = Math.max(1, Math.round(rect.width));
        height = Math.max(1, Math.round(rect.height));
        dpr = Math.min(window.devicePixelRatio || 1, 2);

        canvas.width = Math.round(width * dpr);
        canvas.height = Math.round(height * dpr);
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;

        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.imageSmoothingEnabled = false;
        buildMask();
        drawOnce();
      };

      const animate = (time: number) => {
        draw(time * 0.001);
        if (!reducedMotion.matches) {
          animationFrame = requestAnimationFrame(animate);
        }
      };

      const restart = () => {
        cancelAnimationFrame(animationFrame);
        colors = readColors();
        buildMask();
        if (reducedMotion.matches) {
          drawOnce();
          return;
        }
        animationFrame = requestAnimationFrame(animate);
      };

      const onPointerMove = (event: PointerEvent) => {
        pointer.x = event.clientX / Math.max(window.innerWidth, 1);
        pointer.y = event.clientY / Math.max(window.innerHeight, 1);
        pointer.active = true;
      };

      const observer = new ResizeObserver(resize);
      const themeObserver = new MutationObserver(restart);

      observer.observe(root);
      themeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['class', 'data-theme-setting'],
      });
      window.addEventListener('pointermove', onPointerMove, { passive: true });
      reducedMotion.addEventListener('change', restart);

      document.fonts?.load('120px "Geist Pixel Square"').then(() => {
        buildMask();
        drawOnce();
      });

      resize();
      restart();

      window.addEventListener('pagehide', () => {
        cancelAnimationFrame(animationFrame);
        observer.disconnect();
        themeObserver.disconnect();
        window.removeEventListener('pointermove', onPointerMove);
        reducedMotion.removeEventListener('change', restart);
      });

      function readColors() {
        const styles = getComputedStyle(root);
        return {
          background: styles.backgroundColor,
          foreground: styles.color,
          muted: getComputedStyle(document.documentElement).getPropertyValue('--muted-foreground').trim(),
        };
      }

      function buildMask() {
        if (!maskCtx || width === 0 || height === 0) {
          return;
        }

        const lowWidth = Math.max(1, Math.ceil(width));
        const lowHeight = Math.max(1, Math.ceil(height));
        mask.width = lowWidth;
        mask.height = lowHeight;
        maskCtx.clearRect(0, 0, lowWidth, lowHeight);
        maskCtx.fillStyle = '#000';
        maskCtx.textAlign = 'center';
        maskCtx.textBaseline = 'middle';

        const targetWidth = lowWidth * (width < 640 ? 1.22 : 1.08);
        let fontSize = lowHeight * (width < 640 ? 0.86 : 1.14);
        maskCtx.font = `400 ${fontSize}px "Geist Pixel Square", "JetBrains Mono", ui-monospace, monospace`;

        const measured = maskCtx.measureText('404').width;
        if (measured > targetWidth) {
          fontSize *= targetWidth / measured;
        }

        maskCtx.font = `400 ${fontSize}px "Geist Pixel Square", "JetBrains Mono", ui-monospace, monospace`;
        maskCtx.letterSpacing = `${-fontSize * 0.08}px`;
        maskCtx.fillText('404', lowWidth / 2 - lowWidth * 0.025, lowHeight * (width < 640 ? 0.49 : 0.52));
      }

      function draw(time: number) {
        if (!maskCtx) {
          return;
        }

        frame += 1;
        ctx.save();
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.imageSmoothingEnabled = false;
        ctx.fillStyle = colors.background;
        ctx.fillRect(0, 0, width, height);

        drawScanLines(time);
        drawNumber(time);
        drawCuts(time);
        drawVignette();
        ctx.restore();
      }

      function drawScanLines(time: number) {
        const spacing = width < 640 ? 18 : 22;
        const segment = width < 640 ? 26 : 34;
        const drift = Math.sin(time * 0.7) * 7 + (pointer.active ? (pointer.x - 0.5) * 16 : 0);

        ctx.save();
        ctx.strokeStyle = colorWithAlpha(colors.foreground, document.documentElement.classList.contains('dark') ? 0.13 : 0.09);
        ctx.lineWidth = 1;

        for (let x = -spacing; x < width + spacing; x += spacing) {
          const column = Math.round(x / spacing);
          const columnPhase = time * (1.4 + (column % 4) * 0.11) + column * 1.7;
          const offset = Math.sin(columnPhase) * 2.2 + drift * randomSigned(column, Math.floor(time * 2));
          for (let y = -segment; y < height + segment; y += segment * 1.55) {
            const row = Math.round(y / segment);
            const wobble = randomSigned(column, row + Math.floor(time * 3)) * 8;
            ctx.beginPath();
            ctx.moveTo(Math.round(x + offset) + 0.5, y + wobble);
            ctx.lineTo(Math.round(x + offset) + 0.5, y + wobble + segment);
            ctx.stroke();
          }
        }

        ctx.restore();
      }

      function drawNumber(time: number) {
        const lowWidth = mask.width;
        const lowHeight = mask.height;
        const bandBase = width < 640 ? 2 : 3;
        const pulse = Math.pow(Math.max(0, Math.sin(time * 1.15)), 5);
        let sourceY = 0;

        ctx.save();
        ctx.globalAlpha = 1;

        while (sourceY < lowHeight) {
          const bandHeight = Math.max(1, Math.round(bandBase + random(sourceY, frame % 97) * 5));
          const wave = Math.sin(time * 2.1 + sourceY * 0.21) * 2.2;
          const drag = pointer.active ? (pointer.x - 0.5) * 10 * Math.sin(sourceY * 0.17) : 0;
          const snap = randomSigned(sourceY, Math.floor(time * 9)) * pulse * 16;
          const offset = Math.round(wave + drag + snap);

          ctx.drawImage(
            mask,
            0,
            sourceY,
            lowWidth,
            bandHeight,
            offset,
            sourceY,
            lowWidth,
            bandHeight
          );

          sourceY += bandHeight;
        }

        ctx.restore();
      }

      function drawCuts(time: number) {
        const cutCount = width < 640 ? 11 : 18;
        const top = height * 0.05;
        const bottom = height * 0.94;
        const pulse = Math.pow(Math.max(0, Math.sin(time * 1.3 + 0.8)), 7);

        ctx.save();
        ctx.lineCap = 'butt';

        for (let i = 0; i < cutCount; i += 1) {
          const seed = i * 31;
          const baseX = width * (0.18 + random(seed, 3) * 0.64);
          const jitter = randomSigned(seed, Math.floor(time * 8)) * (3 + pulse * 13);
          const x = Math.round(baseX + jitter);
          const y = top + random(seed, 7) * height * 0.2;
          const length = (bottom - top) * (0.22 + random(seed, 11) * 0.74);
          const widthLine = 1 + Math.floor(random(seed, 17) * 3);

          ctx.strokeStyle = colors.background;
          ctx.lineWidth = widthLine;
          ctx.beginPath();
          ctx.moveTo(x + 0.5, y);
          ctx.lineTo(x + 0.5, y + length);
          ctx.stroke();

          if (pulse > 0.18) {
            ctx.strokeStyle = colors.foreground;
            ctx.globalAlpha = 0.8;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(x + widthLine + 2.5, y + length * 0.08);
            ctx.lineTo(x + widthLine + 2.5, y + length * 0.62);
            ctx.stroke();
            ctx.globalAlpha = 1;
          }
        }

        ctx.restore();
      }

      function drawVignette() {
        const gradient = ctx.createLinearGradient(0, 0, 0, height);
        gradient.addColorStop(0, colors.background);
        gradient.addColorStop(0.12, colorWithAlpha(colors.background, 0));
        gradient.addColorStop(0.78, colorWithAlpha(colors.background, 0));
        gradient.addColorStop(1, colors.background);

        ctx.save();
        ctx.fillStyle = gradient;
        ctx.fillRect(0, 0, width, height);
        ctx.restore();
      }

      function random(a: number, b: number) {
        const value = Math.sin(a * 127.1 + b * 311.7) * 43758.5453123;
        return value - Math.floor(value);
      }

      function randomSigned(a: number, b: number) {
        return random(a, b) * 2 - 1;
      }

      function colorWithAlpha(color: string, alpha: number) {
        if (color.startsWith('rgb(')) {
          return color.replace('rgb(', 'rgba(').replace(')', `, ${alpha})`);
        }

        if (color.startsWith('rgba(')) {
          return color.replace(/,\s*[\d.]+\)$/, `, ${alpha})`);
        }

        return color;
      }
    }
  }
</script>
