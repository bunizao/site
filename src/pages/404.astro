---
import Layout from '../layouts/Layout.astro';
import AnimatedLogo from '@/features/logos/ui/AnimatedLogo.astro';
import {
  PEEK_NOT_FOUND_LOGO,
  getPeekRuntimeSlotKey,
  getPeekRuntimeTrackingPoseKeys,
} from '@/features/logos/data/peek-runtime';

const title = '404 - page not found';
const description = "The page you're looking for isn't here.";
const trackerDefaultAnimation = getPeekRuntimeSlotKey('not-found.tracker.default');
const trackerHoverAnimation = getPeekRuntimeSlotKey('not-found.cta.hover');
const trackerClickAnimation = getPeekRuntimeSlotKey('not-found.cta.click');
const trackerPoseKeys = getPeekRuntimeTrackingPoseKeys('not-found');

// Static fallback path. The client script replaces it with the browser's real
// requested URI because static 404 pages do not receive the missing route.
const rawPath = Astro.url.pathname + Astro.url.search;
const displayPath = rawPath.length > 48 ? rawPath.slice(0, 47) + '…' : rawPath;
---

<Layout title={title} description={description} robots="noindex, follow" hideSiteNav>
  <main
    class="not-found"
    data-peek-hover={trackerHoverAnimation}
    data-peek-click={trackerClickAnimation}
    data-peek-track-poses={JSON.stringify(trackerPoseKeys)}
  >
    <div class="nf-stage">
      <div class="nf-number" data-text="404" aria-hidden="true"
        ><span class="nf-digit" style="--idx: 0">4</span
        ><span class="nf-digit" style="--idx: 1">0</span
        ><span class="nf-digit" style="--idx: 2">4</span
        ><span class="nf-scan" aria-hidden="true"></span
      ></div>

      <div class="nf-path" aria-hidden="true">
        <span class="nf-path-prefix">GET</span>
        <span class="nf-path-url" data-nf-path-url>{displayPath}</span>
        <span class="nf-path-sep">·</span>
        <span class="nf-path-status">page not found</span>
      </div>

      <div class="nf-trace" aria-hidden="true">
        <span class="nf-trace-cell" style="--idx: 0">trace</span>
        <span class="nf-trace-cell nf-trace-dot" style="--idx: 1">·</span>
        <span class="nf-trace-cell nf-trace-mono" style="--idx: 2">0100</span>
        <span class="nf-trace-cell nf-trace-dot" style="--idx: 3">·</span>
        <span class="nf-trace-cell nf-trace-mono" style="--idx: 4">0000</span>
        <span class="nf-trace-cell nf-trace-dot" style="--idx: 5">·</span>
        <span class="nf-trace-cell nf-trace-mono" style="--idx: 6">0100</span>
        <span class="nf-trace-cell nf-trace-dot" style="--idx: 7">·</span>
        <span class="nf-trace-cell" style="--idx: 8">vector ∅</span>
      </div>

      <div class="nf-cta" data-nf-cta>
        <a href="/" class="nf-home" data-nf-home>
          <span class="nf-cta-peek" data-nf-peek aria-hidden="true">
            <AnimatedLogo
              definition={PEEK_NOT_FOUND_LOGO}
              animation={trackerDefaultAnimation}
              size={72}
              title="peek"
              eventChannel="nf"
              eventAnimations={[
                trackerHoverAnimation,
                trackerClickAnimation,
                ...trackerPoseKeys,
              ]}
            />
          </span>
          <span class="nf-home-label">
            <span class="nf-home-arrow" aria-hidden="true">←</span>
            <span class="nf-home-text">go home</span>
          </span>
        </a>
      </div>
    </div>

    <h1 class="nf-sr-title">Page not found</h1>

    <div class="nf-status" aria-hidden="true">
      <span class="nf-status-dot"></span>
      <span class="nf-status-text">404 · not found</span>
    </div>
  </main>

  <script>
    const notFound = document.querySelector('.not-found') as HTMLElement | null;
    const notFoundNumber = document.querySelector('.nf-number') as HTMLElement | null;
    const homeLink = document.querySelector<HTMLAnchorElement>('.nf-home');
    const peekMount = document.querySelector<HTMLElement>('[data-nf-peek]');
    const canAnimate = window.matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');
    let recallTimer = 0;

    const dispatchPeek = (
      kind: 'set' | 'revert',
      detail?: { animation: string; holdMs?: number },
    ): void => {
      window.dispatchEvent(
        new CustomEvent(`peek:nf:${kind}`, detail ? { detail } : undefined),
      );
    };

    if (peekMount) {
      window.requestAnimationFrame(() => peekMount.classList.add('is-peek-ready'));
    }

    const pathLabel = document.querySelector<HTMLElement>('[data-nf-path-url]');
    const formatRequestedUri = (value: string): string => (
      value.length > 48 ? `${value.slice(0, 47)}…` : value
    );

    if (pathLabel) {
      pathLabel.textContent = formatRequestedUri(
        `${window.location.pathname}${window.location.search}${window.location.hash}`,
      );
    }

    if (notFound && notFoundNumber && canAnimate.matches) {
      let numberRect = notFoundNumber.getBoundingClientRect();
      const syncNumberRect = () => {
        numberRect = notFoundNumber.getBoundingClientRect();
      };

      const onMove = (event: PointerEvent) => {
        const cx = numberRect.left + numberRect.width / 2;
        const cy = numberRect.top + numberRect.height / 2;
        const dx = (event.clientX - cx) / (numberRect.width / 2);
        const dy = (event.clientY - cy) / (numberRect.height / 2);
        notFoundNumber.style.setProperty('--mx', Math.max(-1, Math.min(1, dx)).toFixed(3));
        notFoundNumber.style.setProperty('--my', Math.max(-1, Math.min(1, dy)).toFixed(3));
      };

      notFoundNumber.addEventListener('pointerenter', () => {
        syncNumberRect();
        window.clearTimeout(recallTimer);
        notFound.classList.remove('is-number-recalling');
        notFoundNumber.classList.remove('is-number-recalling');
        notFound.classList.add('is-number-hovered');
        notFoundNumber.classList.add('is-number-hovered');
        notFoundNumber.addEventListener('pointermove', onMove);
      });

      notFoundNumber.addEventListener('pointerleave', () => {
        notFound.classList.remove('is-number-hovered');
        notFoundNumber.classList.remove('is-number-hovered');
        notFound.classList.add('is-number-recalling');
        notFoundNumber.classList.add('is-number-recalling');
        notFoundNumber.removeEventListener('pointermove', onMove);
        notFoundNumber.style.setProperty('--mx', '0');
        notFoundNumber.style.setProperty('--my', '0');

        recallTimer = window.setTimeout(() => {
          notFound.classList.remove('is-number-recalling');
          notFoundNumber.classList.remove('is-number-recalling');
        }, 940);
      });

      window.addEventListener('resize', syncNumberRect, { passive: true });
      window.addEventListener('scroll', syncNumberRect, { passive: true });
    }

    // Three-act story: scan (idle) → alert (hover) → dissolve (click).
    // Peek also tracks the cursor across the whole page when idle.
    const TRACK_POSES = JSON.parse(notFound?.dataset.peekTrackPoses ?? '[]') as string[];
    let trackingBucket: number | null = null;
    let revertTimer = 0;
    let isHovering = false;
    let isLeaving = false;

    const applyTrack = (event: PointerEvent): void => {
      if (isHovering || isLeaving) return;
      const w = window.innerWidth || 1;
      const bucket = Math.min(
        TRACK_POSES.length - 1,
        Math.max(0, Math.floor((event.clientX / w) * TRACK_POSES.length)),
      );
      if (bucket === trackingBucket) return;
      trackingBucket = bucket;
      dispatchPeek('set', { animation: TRACK_POSES[bucket] });
    };

    const releaseTrack = (): void => {
      if (isHovering || isLeaving) return;
      if (trackingBucket === null) return;
      trackingBucket = null;
      dispatchPeek('revert');
    };

    if (notFound && canAnimate.matches) {
      notFound.addEventListener('pointermove', applyTrack);
      notFound.addEventListener('pointerleave', releaseTrack);
    }

    if (homeLink) {
      const onHover = () => {
        isHovering = true;
        trackingBucket = null;
        window.clearTimeout(revertTimer);
        dispatchPeek('set', { animation: notFound?.dataset.peekHover ?? 'alert' });
      };
      const onUnhover = () => {
        isHovering = false;
        dispatchPeek('revert');
      };

      homeLink.addEventListener('pointerenter', onHover);
      homeLink.addEventListener('focus', onHover);
      homeLink.addEventListener('pointerleave', onUnhover);
      homeLink.addEventListener('blur', onUnhover);

      homeLink.addEventListener('click', () => {
        isLeaving = true;
        dispatchPeek('set', { animation: notFound?.dataset.peekClick ?? 'dissolve' });
      });
    }
  </script>
</Layout>

<style>
  :global(body:has(.not-found) .global-header-actions) {
    display: none;
  }

  :global(body:has(.not-found) .site-shell) {
    min-height: 100svh;
  }

  .not-found {
    --nf-bg: hsl(var(--background));
    --nf-fg: hsl(var(--foreground));
    --nf-muted: hsl(var(--muted-foreground));
    --nf-grid-y: hsl(var(--foreground) / 0.05);
    --nf-grid-x: hsl(var(--foreground) / 0.045);
    --nf-scan-fg: hsl(var(--foreground) / 0.32);
    --nf-trace: hsl(var(--foreground) / 0.42);
    --nf-trace-strong: hsl(var(--foreground) / 0.7);
    --nf-trace-dim: hsl(var(--foreground) / 0.28);
    --nf-secondary: hsl(var(--foreground) / 0.55);
    --nf-dot: hsl(var(--foreground) / 0.7);
    --nf-ring: hsl(var(--foreground) / 0.3);
    --nf-prefix: hsl(var(--foreground) / 0.3);
    --nf-footer-bottom: clamp(28px, 4svh, 48px);
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    overflow: hidden;
    color: var(--nf-fg);
    background: var(--nf-bg);
    font-family: var(--font-mono);
    cursor: default;
    isolation: isolate;
    user-select: none;
    -webkit-user-select: none;
  }

  :global(.dark) .not-found {
    --nf-bg: hsl(0 0% 7%);
    --nf-fg: hsl(0 0% 76%);
    --nf-muted: hsl(0 0% 56%);
    --nf-grid-y: hsl(0 0% 100% / 0.028);
    --nf-grid-x: hsl(0 0% 100% / 0.024);
    --nf-scan-fg: hsl(0 0% 78% / 0.18);
    --nf-trace: hsl(0 0% 78% / 0.32);
    --nf-trace-strong: hsl(0 0% 80% / 0.52);
    --nf-trace-dim: hsl(0 0% 78% / 0.18);
    --nf-secondary: hsl(0 0% 78% / 0.6);
    --nf-dot: hsl(0 0% 80% / 0.48);
    --nf-ring: hsl(0 0% 80% / 0.18);
    --nf-prefix: hsl(0 0% 78% / 0.32);
  }

  .not-found::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.42;
    background-image:
      linear-gradient(var(--nf-grid-y) 1px, transparent 1px),
      linear-gradient(90deg, var(--nf-grid-x) 1px, transparent 1px);
    background-size: 100% clamp(72px, 11svh, 112px), clamp(72px, 11svh, 112px) 100%;
    transition: opacity 720ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .not-found.is-number-hovered::before {
    opacity: 0.62;
  }

  .nf-stage {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    gap: clamp(28px, 4svh, 48px);
  }

  .nf-number {
    --mx: 0;
    --my: 0;
    position: relative;
    width: min(92vw, 1100px);
    color: var(--nf-fg);
    font-size: min(38svh, 21rem);
    font-weight: 520;
    font-variation-settings: "wght" 520;
    line-height: 0.82;
    letter-spacing: -0.03em;
    text-align: center;
    font-variant-numeric: tabular-nums;
    transform-origin: 50% 52%;
    transform: translateY(-1svh);
    transition:
      transform 680ms cubic-bezier(0.16, 1, 0.3, 1),
      letter-spacing 680ms cubic-bezier(0.16, 1, 0.3, 1),
      font-weight 680ms cubic-bezier(0.16, 1, 0.3, 1),
      font-variation-settings 680ms cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .nf-digit {
    display: inline-block;
    transform-origin: 50% 60%;
    animation: nf-digit-breathe 5.4s cubic-bezier(0.45, 0, 0.2, 1) infinite;
    animation-delay: calc(var(--idx) * 420ms);
    transition: transform 720ms cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .nf-number::before,
  .nf-number::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    z-index: -1;
    color: var(--nf-fg);
    pointer-events: none;
    text-align: center;
    transition:
      opacity 360ms ease,
      transform 680ms cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  .nf-number::before {
    opacity: 0.08;
    transform: translate(-0.02em, -0.007em);
    animation: nf-idle-a 4.8s cubic-bezier(0.45, 0, 0.2, 1) infinite;
  }

  .nf-number::after {
    opacity: 0.045;
    transform: translate(0.026em, 0.009em);
    animation: nf-idle-b 4.8s cubic-bezier(0.45, 0, 0.2, 1) 180ms infinite;
  }

  .nf-scan {
    position: absolute;
    left: 6%;
    right: 6%;
    top: 50%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--nf-scan-fg) 50%,
      transparent 100%
    );
    transform: translateY(-50%);
    pointer-events: none;
    opacity: 0;
    animation: nf-scan-idle 9.2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    will-change: transform, opacity;
  }

  .nf-path {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    max-width: min(68ch, 92vw);
    padding: 6px 14px;
    font-size: clamp(12px, 1.3svh, 14px);
    line-height: 1.2;
    color: var(--nf-secondary);
    white-space: nowrap;
    overflow: hidden;
    pointer-events: none;
    transition: color 360ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nf-path-prefix {
    color: var(--nf-prefix);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
  }

  .nf-path-url {
    flex: 0 1 auto;
    max-width: 48ch;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--nf-trace-strong);
  }

  .nf-path-sep {
    color: var(--nf-trace-dim);
  }

  .nf-path-status {
    color: var(--nf-secondary);
    text-transform: lowercase;
    letter-spacing: 0.02em;
  }

  .nf-trace {
    display: flex;
    flex-wrap: nowrap;
    gap: 8px;
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.04em;
    color: var(--nf-trace);
    text-transform: lowercase;
    font-variant-numeric: tabular-nums;
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 520ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 520ms cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }

  .nf-trace-cell {
    display: inline-block;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 320ms ease,
      transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nf-trace-mono {
    color: var(--nf-trace-strong);
  }

  .nf-trace-dot {
    color: var(--nf-trace-dim);
  }

  .nf-sr-title {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .nf-status {
    position: absolute;
    top: clamp(22px, 3vw, 38px);
    right: clamp(20px, 3vw, 36px);
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin: 0;
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: lowercase;
    color: var(--nf-secondary);
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }

  .nf-status-dot {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--nf-dot);
    animation: nf-status-pulse 2.4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  .nf-status-dot::after {
    content: "";
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 1px solid var(--nf-ring);
    opacity: 0;
    animation: nf-status-ring 2.4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  .nf-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(14px, 2.4svh, 26px);
    margin-top: clamp(8px, 2svh, 20px);
  }

  .nf-cta-peek {
    display: inline-flex;
    color: var(--nf-fg);
    opacity: 0;
    transform: translateY(8px) scale(0.98);
    filter: drop-shadow(0 2px 0 hsl(var(--foreground) / 0.14))
      drop-shadow(0 6px 14px hsl(var(--foreground) / 0.08));
    transition:
      opacity 720ms cubic-bezier(0.16, 1, 0.3, 1) 200ms,
      transform 720ms cubic-bezier(0.16, 1, 0.3, 1) 200ms,
      filter 360ms cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }

  :global(.dark) .nf-cta-peek {
    filter: drop-shadow(0 2px 0 hsl(0 0% 0% / 0.55))
      drop-shadow(0 6px 16px hsl(0 0% 0% / 0.35));
  }

  .nf-cta-peek.is-peek-ready {
    opacity: 0.88;
    transform: translateY(0) scale(1);
    transform: translateY(0);
  }

  .nf-home {
    position: relative;
    z-index: 3;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(12px, 2svh, 18px);
    font-size: 13px;
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: lowercase;
    color: var(--nf-fg);
    text-decoration: none;
    pointer-events: auto;
    transition:
      gap 320ms cubic-bezier(0.16, 1, 0.3, 1),
      color 220ms ease;
  }

  .nf-home-label {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    transition: gap 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nf-home-arrow {
    display: inline-block;
    width: 13px;
    font-size: 14px;
    line-height: 1;
    text-align: center;
    transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nf-home-text {
    position: relative;
    display: inline-block;
  }

  .nf-home-text::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -4px;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nf-home:hover,
  .nf-home:focus-visible {
    outline: none;
  }

  .nf-home:hover .nf-home-label,
  .nf-home:focus-visible .nf-home-label {
    gap: 14px;
  }

  .nf-home:hover .nf-home-arrow,
  .nf-home:focus-visible .nf-home-arrow {
    transform: translateX(-5px);
  }

  .nf-home:hover .nf-cta-peek,
  .nf-home:focus-visible .nf-cta-peek {
    filter: drop-shadow(0 3px 0 hsl(var(--foreground) / 0.16))
      drop-shadow(0 10px 20px hsl(var(--foreground) / 0.1));
  }

  .nf-home:hover .nf-home-text::after,
  .nf-home:focus-visible .nf-home-text::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  @media (hover: hover) and (pointer: fine) {
    .nf-number.is-number-hovered {
      font-weight: 485;
      font-variation-settings: "wght" 485;
      letter-spacing: -0.034em;
      transform: translateY(-1.25svh) scale(1.012);
    }

    .nf-number.is-number-hovered .nf-digit {
      animation-play-state: paused;
    }

    .nf-number.is-number-hovered .nf-digit:nth-child(1) {
      transform:
        translate3d(
          calc(var(--mx) * -0.018em - 0.026em),
          calc(var(--my) * -0.014em - 0.006em),
          0
        )
        rotate(-0.7deg);
    }

    .nf-number.is-number-hovered .nf-digit:nth-child(2) {
      transform:
        translate3d(
          calc(var(--mx) * 0.02em),
          calc(var(--my) * 0.022em - 0.014em),
          0
        )
        scale(1.024);
    }

    .nf-number.is-number-hovered .nf-digit:nth-child(3) {
      transform:
        translate3d(
          calc(var(--mx) * 0.018em + 0.026em),
          calc(var(--my) * 0.014em - 0.006em),
          0
        )
        rotate(0.7deg);
    }

    .nf-number.is-number-hovered::before {
      opacity: 0.16;
      transform: translate(
        calc(var(--mx) * -0.05em - 0.038em),
        calc(var(--my) * -0.034em - 0.012em)
      );
      animation: none;
    }

    .nf-number.is-number-hovered::after {
      opacity: 0.085;
      transform: translate(
        calc(var(--mx) * 0.05em + 0.044em),
        calc(var(--my) * 0.034em + 0.014em)
      );
      animation: none;
    }

    .nf-number.is-number-hovered .nf-scan {
      animation: nf-scan-hover 1.6s cubic-bezier(0.45, 0, 0.2, 1) infinite;
    }

    .not-found.is-number-hovered .nf-trace {
      opacity: 1;
      transform: translateY(0);
    }

    .not-found.is-number-hovered .nf-trace-cell {
      opacity: 1;
      transform: translateY(0);
      transition-delay: calc(var(--idx) * 50ms);
    }

    .nf-number.is-number-recalling::before {
      animation: nf-callback-hover-a 780ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .nf-number.is-number-recalling::after {
      animation: nf-callback-hover-b 860ms cubic-bezier(0.16, 1, 0.3, 1) 40ms both;
    }
  }

  @media (max-width: 640px) {
    .nf-number {
      width: min(96vw, 420px);
      font-size: min(28svh, 10rem);
      transform: translateY(-4svh);
    }

    .nf-trace {
      font-size: 10px;
      gap: 6px;
    }

    .nf-status {
      top: clamp(14px, 4vw, 22px);
      right: clamp(14px, 4vw, 22px);
      font-size: 10px;
      gap: 8px;
    }

    .nf-home {
      font-size: 12px;
    }
