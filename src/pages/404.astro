---
import Layout from '../layouts/Layout.astro';

const title = '404 - page not found';
const description = "The page you're looking for isn't here.";
---

<Layout title={title} description={description} hideSiteNav>
  <main class="not-found">
    <div class="nf-number" data-text="404" aria-hidden="true">404</div>

    <section class="nf-copy" aria-labelledby="not-found-title">
      <p class="nf-kicker">404 / not found</p>
      <h1 id="not-found-title">Page not found</h1>
      <p>this page slipped out of the index.</p>
      <a href="/" class="nf-home">go home</a>
    </section>
  </main>
</Layout>

<style>
  @font-face {
    font-family: 'Geist Mono';
    src:
      url('/fonts/geist-mono-variable.woff2') format('woff2-variations'),
      url('/fonts/geist-mono-variable.woff2') format('woff2');
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  :global(body:has(.not-found) .global-header-actions) {
    display: none;
  }

  :global(body:has(.not-found) .site-shell) {
    min-height: 100svh;
  }

  .not-found {
    --nf-bg: hsl(var(--background));
    --nf-fg: hsl(var(--foreground));
    --nf-muted: hsl(var(--muted-foreground));
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    overflow: hidden;
    color: var(--nf-fg);
    background: var(--nf-bg);
    isolation: isolate;
  }

  .not-found::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .not-found::before {
    opacity: 0.42;
    background-image:
      linear-gradient(hsl(var(--foreground) / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, hsl(var(--foreground) / 0.045) 1px, transparent 1px);
    background-size: 100% clamp(72px, 11svh, 112px), clamp(72px, 11svh, 112px) 100%;
  }

  .nf-number {
    position: relative;
    z-index: 1;
    width: min(92vw, 1100px);
    color: var(--nf-fg);
    font-family: 'Geist Mono', 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: min(38svh, 21rem);
    font-weight: 520;
    line-height: 0.82;
    letter-spacing: -0.03em;
    text-align: center;
    font-variant-numeric: tabular-nums;
    transform: translateY(-1svh);
  }

  .nf-number::before,
  .nf-number::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    z-index: -1;
    color: var(--nf-fg);
    pointer-events: none;
  }

  .nf-number::before {
    opacity: 0.075;
    transform: translate(-0.018em, -0.006em);
    animation: nf-callback-a 5.6s ease-out infinite;
  }

  .nf-number::after {
    opacity: 0.04;
    transform: translate(0.024em, 0.008em);
    animation: nf-callback-b 5.6s ease-out infinite;
  }

  .nf-copy {
    position: fixed;
    right: clamp(18px, 2.8vw, 34px);
    bottom: clamp(30px, 4svh, 52px);
    left: clamp(18px, 2.8vw, 34px);
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 10px 24px;
    pointer-events: none;
  }

  .nf-kicker,
  .nf-copy h1,
  .nf-copy p,
  .nf-home {
    margin: 0;
    font-size: 11px;
    line-height: 1.35;
    letter-spacing: 0;
    text-transform: lowercase;
  }

  .nf-kicker {
    position: fixed;
    top: clamp(82px, 8vw, 118px);
    right: clamp(18px, 4vw, 56px);
    color: var(--nf-muted);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
    writing-mode: vertical-rl;
  }

  .nf-copy h1 {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .nf-copy p {
    max-width: 32ch;
    color: hsl(var(--foreground) / 0.5);
  }

  .nf-home {
    position: relative;
    color: var(--nf-fg);
    pointer-events: auto;
    text-decoration: none;
  }

  .nf-home::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -4px;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 180ms ease;
  }

  .nf-home:hover::after,
  .nf-home:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  @media (max-width: 640px) {
    .nf-number {
      width: min(96vw, 420px);
      font-size: min(28svh, 10rem);
      transform: translateY(-4svh);
    }

    .nf-copy {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 8px;
    }

    .nf-kicker {
      top: auto;
      right: auto;
      bottom: 104px;
      left: 20px;
      writing-mode: horizontal-tb;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nf-number::before,
    .nf-number::after {
      animation: none;
    }

    .nf-home::after {
      transition: none;
    }
  }

  @keyframes nf-callback-a {
    0%,
    100% {
      opacity: 0.075;
      transform: translate(-0.018em, -0.006em);
    }

    72% {
      opacity: 0.075;
      transform: translate(-0.018em, -0.006em);
    }

    76% {
      opacity: 0.22;
      transform: translate(-0.065em, -0.022em);
    }

    81% {
      opacity: 0.035;
      transform: translate(0.012em, 0.004em);
    }

    86% {
      opacity: 0.075;
      transform: translate(-0.018em, -0.006em);
    }
  }

  @keyframes nf-callback-b {
    0%,
    100% {
      opacity: 0.04;
      transform: translate(0.024em, 0.008em);
    }

    74% {
      opacity: 0.04;
      transform: translate(0.024em, 0.008em);
    }

    78% {
      opacity: 0.16;
      transform: translate(0.075em, 0.024em);
    }

    83% {
      opacity: 0.02;
      transform: translate(-0.01em, -0.004em);
    }

    88% {
      opacity: 0.04;
      transform: translate(0.024em, 0.008em);
    }
  }
</style>
