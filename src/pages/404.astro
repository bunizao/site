---
import Layout from '../layouts/Layout.astro';

const title = '404 - page not found';
const description = "The page you're looking for isn't here.";

const pixelDigits: Record<string, string[]> = {
  '0': [
    '111111',
    '110011',
    '110011',
    '110011',
    '110011',
    '110011',
    '111111',
  ],
  '4': [
    '110011',
    '110011',
    '110011',
    '111111',
    '000011',
    '000011',
    '000011',
  ],
};

const digitCells = ['4', '0', '4'].map((digit) => ({
  digit,
  rows: pixelDigits[digit],
}));
---

<Layout title={title} description={description} hideSiteNav>
  <main class="not-found" data-not-found>
    <div class="nf-frame" aria-hidden="true">
      <span class="nf-corner nf-corner-tl"></span>
      <span class="nf-corner nf-corner-tr"></span>
      <span class="nf-corner nf-corner-bl"></span>
      <span class="nf-corner nf-corner-br"></span>
    </div>

    <header class="nf-status" aria-hidden="true">
      <span class="nf-status-dot"></span>
      <span>signal lost</span>
      <span class="nf-muted">/</span>
      <span data-nf-clock>00:00</span>
    </header>

    <aside class="nf-readout" aria-hidden="true">
      <span>idx:<b data-nf-index>0000</b></span>
      <span>x:<b data-nf-x>0.50</b></span>
      <span>y:<b data-nf-y>0.50</b></span>
    </aside>

    <div class="nf-stage">
      <div class="nf-display" aria-hidden="true">
        {digitCells.map(({ digit, rows }, digitIndex) => (
          <div class="nf-digit" data-digit={digit} style={`--digit-delay: ${digitIndex * 90}ms`}>
            {rows.flatMap((row, rowIndex) =>
              [...row].map((cell, cellIndex) => (
                <span
                  class:list={['nf-pixel', { 'is-on': cell === '1' }]}
                  style={`--cell-delay: ${(rowIndex * row.length + cellIndex) * 9 + digitIndex * 80}ms`}
                ></span>
              ))
            )}
          </div>
        ))}
      </div>

      <section class="nf-copy" aria-labelledby="not-found-title">
        <p class="nf-kicker">
          <span class="nf-kicker-line" aria-hidden="true"></span>
          <span>page not found</span>
        </p>
        <h1 id="not-found-title">this route fell off the grid.</h1>
        <p>
          maybe it moved. maybe it never existed.
          either way, the map is clean and the page is gone.
        </p>
        <nav class="nf-actions" aria-label="recovery links">
          <a href="/" class="nf-action nf-action-primary">
            <span>go home</span>
            <span aria-hidden="true">-></span>
          </a>
          <button type="button" class="nf-action nf-action-ghost" data-nf-back>
            <span aria-hidden="true">&lt;-</span>
            <span>drift back</span>
          </button>
        </nav>
      </section>
    </div>
  </main>
</Layout>

<style>
  .not-found {
    position: relative;
    display: grid;
    min-height: 100svh;
    padding: clamp(72px, 8vw, 104px) clamp(20px, 5vw, 72px);
    overflow: hidden;
    color: hsl(var(--foreground));
    background:
      linear-gradient(90deg, hsl(var(--foreground) / 0.035) 1px, transparent 1px),
      linear-gradient(0deg, hsl(var(--foreground) / 0.035) 1px, transparent 1px),
      hsl(var(--background));
    background-size: 24px 24px;
    isolation: isolate;
  }

  .not-found::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      circle at var(--pointer-x, 68%) var(--pointer-y, 28%),
      hsl(var(--foreground) / 0.08),
      transparent 34%
    );
    opacity: 0.9;
    transition: background-position 0.2s ease;
  }

  .nf-frame,
  .nf-corner {
    position: absolute;
    pointer-events: none;
  }

  .nf-frame {
    inset: clamp(18px, 2.3vw, 32px);
  }

  .nf-corner {
    width: 28px;
    height: 28px;
    border: 1px solid hsl(var(--foreground) / 0.44);
    opacity: 0;
    animation: nf-corner-in 0.55s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  .nf-corner-tl {
    top: 0;
    left: 0;
    border-right: 0;
    border-bottom: 0;
  }

  .nf-corner-tr {
    top: 0;
    right: 56px;
    border-bottom: 0;
    border-left: 0;
  }

  .nf-corner-bl {
    bottom: 0;
    left: 0;
    border-top: 0;
    border-right: 0;
  }

  .nf-corner-br {
    right: 0;
    bottom: 0;
    border-top: 0;
    border-left: 0;
  }

  .nf-status,
  .nf-readout {
    position: absolute;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    color: hsl(var(--muted-foreground));
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0;
    animation: nf-fade-in 0.55s ease 0.25s forwards;
  }

  .nf-status {
    top: clamp(40px, 5vw, 64px);
    left: clamp(32px, 6vw, 80px);
    gap: 10px;
  }

  .nf-readout {
    top: clamp(40px, 5vw, 64px);
    right: clamp(88px, 8vw, 128px);
    gap: 16px;
  }

  .nf-readout b {
    margin-left: 5px;
    color: hsl(var(--foreground));
    font-weight: 500;
  }

  .nf-status-dot {
    width: 6px;
    height: 6px;
    background: hsl(var(--foreground));
    box-shadow: 0 0 0 1px hsl(var(--foreground) / 0.2);
    animation: nf-pulse 2.2s ease-in-out infinite;
  }

  .nf-muted {
    color: hsl(var(--muted-foreground) / 0.4);
  }

  .nf-stage {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: end;
    width: min(100%, 1180px);
    margin: auto 0;
  }

  .nf-display {
    display: flex;
    align-items: center;
    gap: clamp(10px, 1.6vw, 22px);
    line-height: 1;
    transform: translateX(clamp(-8px, -0.9vw, 0px));
  }

  .nf-digit {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: clamp(3px, 0.42vw, 6px);
    width: clamp(88px, 17vw, 236px);
    aspect-ratio: 6 / 7;
    opacity: 0;
    transform: translateY(10px);
    animation: nf-digit-in 0.65s cubic-bezier(0.2, 0.8, 0.2, 1) var(--digit-delay) forwards;
  }

  .nf-pixel {
    display: block;
    border-radius: 2px;
    background: transparent;
    transform: scale(0.82);
  }

  .nf-pixel.is-on {
    background:
      linear-gradient(180deg, hsl(var(--background) / 0.16), transparent 52%),
      hsl(var(--foreground));
    box-shadow:
      0 0 0 1px hsl(var(--background) / 0.08) inset,
      0 10px 26px hsl(var(--foreground) / 0.1);
    animation: nf-pixel-on 0.35s steps(2, end) calc(0.22s + var(--cell-delay)) both;
  }

  .nf-copy {
    max-width: 420px;
    padding: 0;
    border: 0;
    opacity: 0;
    animation: nf-copy-in 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) 0.52s forwards;
  }

  .nf-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 18px;
    color: hsl(var(--muted-foreground));
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .nf-kicker-line {
    width: 28px;
    height: 1px;
    background: hsl(var(--foreground) / 0.5);
  }

  .nf-copy h1 {
    max-width: 13ch;
    margin: 0 0 18px;
    color: hsl(var(--foreground));
    font-size: clamp(28px, 4vw, 52px);
    font-weight: 620;
    line-height: 1.02;
    letter-spacing: 0;
  }

  .nf-copy p:not(.nf-kicker) {
    max-width: 38ch;
    margin: 0 0 30px;
    color: hsl(var(--muted-foreground));
    font-size: 14px;
    line-height: 1.7;
  }

  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }

  .nf-action {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 14px;
    color: hsl(var(--foreground));
    font: inherit;
    font-size: 13px;
    white-space: nowrap;
    background: transparent;
    border: 1px solid hsl(var(--foreground) / 0.2);
    border-radius: 8px;
    cursor: pointer;
    transition:
      color 0.18s ease,
      background-color 0.18s ease,
      border-color 0.18s ease,
      transform 0.18s ease;
  }

  .nf-action-primary {
    color: hsl(var(--background));
    background: hsl(var(--foreground));
    border-color: hsl(var(--foreground));
  }

  .nf-action-ghost {
    color: hsl(var(--muted-foreground));
  }

  .nf-action:hover {
    color: hsl(var(--background));
    background: hsl(var(--foreground));
    border-color: hsl(var(--foreground));
    transform: translateY(-1px);
  }

  @keyframes nf-corner-in {
    from {
      opacity: 0;
      transform: scale(0.72);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes nf-fade-in {
    to {
      opacity: 1;
    }
  }

  @keyframes nf-pulse {
    0%,
    100% {
      opacity: 0.45;
      transform: scale(0.9);
    }
    50% {
      opacity: 1;
      transform: scale(1.08);
    }
  }

  @keyframes nf-digit-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes nf-pixel-on {
    0% {
      opacity: 0.12;
      transform: scale(0.72);
    }
    48% {
      opacity: 0.4;
      transform: scale(1);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes nf-copy-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 1280px) {
    .nf-stage {
      grid-template-columns: minmax(0, 1.45fr) minmax(320px, 0.55fr);
    }
  }

  @media (max-width: 900px) {
    .nf-stage {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 34px;
    }

    .nf-display {
      width: min(100%, 720px);
    }

    .nf-digit {
      width: clamp(72px, 25vw, 150px);
    }

    .nf-copy h1 {
      max-width: 18ch;
    }
  }

  @media (max-width: 640px) {
    .not-found {
      min-height: 100dvh;
      padding: 112px 24px 72px;
      align-content: start;
    }

    .nf-status {
      top: 70px;
      left: 34px;
    }

    .nf-readout {
      display: none;
    }

    .nf-stage {
      margin-top: 30px;
      gap: 28px;
    }

    .nf-display {
      gap: 7px;
    }

    .nf-digit {
      width: clamp(64px, 27vw, 104px);
      gap: 3px;
    }

    .nf-copy h1 {
      font-size: clamp(30px, 9vw, 40px);
    }

    .nf-copy p:not(.nf-kicker) {
      font-size: 13px;
    }

    .nf-action {
      min-height: 38px;
      padding: 0 12px;
    }
  }

  @media (max-width: 420px) {
    .nf-display {
      transform: translateX(-4px);
    }

    .nf-digit {
      width: clamp(56px, 26vw, 88px);
    }

    .nf-corner-tr {
      right: 54px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .not-found::before,
    .nf-corner,
    .nf-status,
    .nf-readout,
    .nf-status-dot,
    .nf-digit,
    .nf-pixel.is-on,
    .nf-copy,
    .nf-action {
      animation: none !important;
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-not-found]');
  const backButton = document.querySelector<HTMLButtonElement>('[data-nf-back]');
  const clock = document.querySelector<HTMLElement>('[data-nf-clock]');
  const index = document.querySelector<HTMLElement>('[data-nf-index]');
  const x = document.querySelector<HTMLElement>('[data-nf-x]');
  const y = document.querySelector<HTMLElement>('[data-nf-y]');

  backButton?.addEventListener('click', () => {
    if (window.history.length > 1) {
      window.history.back();
      return;
    }

    window.location.href = '/';
  });

  if (root) {
    let elapsed = 0;
    let frame = 0;
    let rafId = 0;

    const clockId = window.setInterval(() => {
      elapsed += 1;
      const minutes = Math.floor(elapsed / 60);
      const seconds = elapsed % 60;
      if (clock) clock.textContent = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
    }, 1000);

    const onPointerMove = (event: PointerEvent) => {
      const px = event.clientX / window.innerWidth;
      const py = event.clientY / window.innerHeight;
      root.style.setProperty('--pointer-x', `${px * 100}%`);
      root.style.setProperty('--pointer-y', `${py * 100}%`);
      if (x) x.textContent = px.toFixed(2);
      if (y) y.textContent = py.toFixed(2);
    };

    const tick = () => {
      frame += 1;
      if (index && frame % 8 === 0) index.textContent = String(frame % 10000).padStart(4, '0');
      rafId = window.requestAnimationFrame(tick);
    };

    window.addEventListener('pointermove', onPointerMove, { passive: true });
    rafId = window.requestAnimationFrame(tick);

    window.addEventListener('pagehide', () => {
      window.clearInterval(clockId);
      window.cancelAnimationFrame(rafId);
      window.removeEventListener('pointermove', onPointerMove);
    });
  }
</script>
