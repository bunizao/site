---
import Layout from '../layouts/Layout.astro';

const title = '404 - page not found';
const description = "The page you're looking for isn't here.";
---

<Layout title={title} description={description} hideSiteNav>
  <main class="not-found">
    <div class="nf-number" data-text="404" aria-hidden="true">404</div>

    <section class="nf-copy" aria-labelledby="not-found-title">
      <p class="nf-kicker">404 / not found</p>
      <h1 id="not-found-title">Page not found</h1>
      <p class="nf-line">this page slipped out of the index.</p>
      <a href="/" class="nf-home">go home</a>
    </section>
  </main>

  <script>
    const notFound = document.querySelector('.not-found');
    const notFoundNumber = document.querySelector('.nf-number');
    const canAnimate = window.matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');
    let recallTimer = 0;

    if (notFound && notFoundNumber && canAnimate.matches) {
      notFoundNumber.addEventListener('pointerenter', () => {
        window.clearTimeout(recallTimer);
        notFound.classList.remove('is-number-recalling');
        notFoundNumber.classList.remove('is-number-recalling');
        notFoundNumber.classList.add('is-number-hovered');
      });

      notFoundNumber.addEventListener('pointerleave', () => {
        notFoundNumber.classList.remove('is-number-hovered');
        notFound.classList.add('is-number-recalling');
        notFoundNumber.classList.add('is-number-recalling');

        recallTimer = window.setTimeout(() => {
          notFound.classList.remove('is-number-recalling');
          notFoundNumber.classList.remove('is-number-recalling');
        }, 940);
      });
    }
  </script>
</Layout>

<style>
  @font-face {
    font-family: 'Geist Mono';
    src:
      url('/fonts/geist-mono-variable.woff2') format('woff2-variations'),
      url('/fonts/geist-mono-variable.woff2') format('woff2');
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  :global(body:has(.not-found) .global-header-actions) {
    display: none;
  }

  :global(body:has(.not-found) .site-shell) {
    min-height: 100svh;
  }

  .not-found {
    --nf-bg: hsl(var(--background));
    --nf-fg: hsl(var(--foreground));
    --nf-muted: hsl(var(--muted-foreground));
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    overflow: hidden;
    color: var(--nf-fg);
    background: var(--nf-bg);
    cursor: default;
    isolation: isolate;
  }

  .not-found::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .not-found::before {
    opacity: 0.42;
    background-image:
      linear-gradient(hsl(var(--foreground) / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, hsl(var(--foreground) / 0.045) 1px, transparent 1px);
    background-size: 100% clamp(72px, 11svh, 112px), clamp(72px, 11svh, 112px) 100%;
  }

  .nf-number {
    position: relative;
    z-index: 1;
    width: min(92vw, 1100px);
    color: var(--nf-fg);
    font-family: 'Geist Mono', 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: min(38svh, 21rem);
    font-weight: 520;
    font-variation-settings: "wght" 520;
    line-height: 0.82;
    letter-spacing: -0.03em;
    text-align: center;
    font-variant-numeric: tabular-nums;
    transform-origin: 50% 52%;
    transform: translateY(-1svh);
    transition:
      transform 680ms cubic-bezier(0.16, 1, 0.3, 1),
      letter-spacing 680ms cubic-bezier(0.16, 1, 0.3, 1),
      font-weight 680ms cubic-bezier(0.16, 1, 0.3, 1),
      font-variation-settings 680ms cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .nf-number::before,
  .nf-number::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    z-index: -1;
    color: var(--nf-fg);
    pointer-events: none;
    transition:
      opacity 360ms ease,
      transform 680ms cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  .nf-number::before {
    opacity: 0.08;
    transform: translate(-0.02em, -0.007em);
    animation: nf-idle-a 4.8s cubic-bezier(0.45, 0, 0.2, 1) infinite;
  }

  .nf-number::after {
    opacity: 0.045;
    transform: translate(0.026em, 0.009em);
    animation: nf-idle-b 4.8s cubic-bezier(0.45, 0, 0.2, 1) 180ms infinite;
  }

  .nf-number.is-number-hovered::before {
    opacity: 0.09;
    transform: translate(-0.026em, -0.008em);
    animation: none;
  }

  .nf-number.is-number-hovered::after {
    opacity: 0.05;
    transform: translate(0.032em, 0.01em);
    animation: none;
  }

  .nf-copy {
    position: fixed;
    right: clamp(18px, 2.8vw, 34px);
    bottom: clamp(30px, 4svh, 52px);
    left: clamp(18px, 2.8vw, 34px);
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 10px 24px;
    pointer-events: none;
  }

  .nf-kicker,
  .nf-copy h1,
  .nf-copy p,
  .nf-home {
    margin: 0;
    font-size: 11px;
    line-height: 1.35;
    letter-spacing: 0;
    text-transform: lowercase;
  }

  .nf-kicker {
    position: fixed;
    top: clamp(82px, 8vw, 118px);
    right: clamp(18px, 4vw, 56px);
    color: var(--nf-muted);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
    writing-mode: vertical-rl;
  }

  .nf-copy h1 {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .nf-copy p {
    position: relative;
    max-width: 32ch;
    color: hsl(var(--foreground) / 0.5);
    pointer-events: none;
  }

  .nf-home {
    position: relative;
    color: var(--nf-fg);
    pointer-events: auto;
    text-decoration: none;
    transition:
      transform 240ms cubic-bezier(0.16, 1, 0.3, 1),
      color 180ms ease;
  }

  .nf-home::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -4px;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 180ms ease;
  }

  .nf-home:hover::after,
  .nf-home:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  .nf-home:hover,
  .nf-home:focus-visible {
    transform: translateX(-4px);
  }

  @media (hover: hover) and (pointer: fine) {
    .nf-number.is-number-hovered {
      font-weight: 485;
      font-variation-settings: "wght" 485;
      letter-spacing: -0.034em;
      transform: translateY(-1.25svh) scale(1.012);
    }

    .nf-number.is-number-recalling::before {
      animation: nf-callback-hover-a 780ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .nf-number.is-number-recalling::after {
      animation: nf-callback-hover-b 860ms cubic-bezier(0.16, 1, 0.3, 1) 40ms both;
    }
  }

  @media (max-width: 640px) {
    .nf-number {
      width: min(96vw, 420px);
      font-size: min(28svh, 10rem);
      transform: translateY(-4svh);
    }

    .nf-copy {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 8px;
    }

    .nf-kicker {
      top: auto;
      right: auto;
      bottom: 104px;
      left: 20px;
      writing-mode: horizontal-tb;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nf-number::before,
    .nf-number::after {
      animation: none;
    }

    .nf-number,
    .nf-home,
    .nf-home::after {
      transition: none;
    }

    .nf-number:hover {
      font-weight: 520;
      font-variation-settings: "wght" 520;
      letter-spacing: -0.03em;
      transform: translateY(-1svh);
    }

    .nf-home:hover,
    .nf-home:focus-visible {
      transform: none;
    }
  }

  @keyframes nf-idle-a {
    0%,
    100% {
      opacity: 0.065;
      transform: translate(-0.016em, -0.005em);
    }

    34% {
      opacity: 0.12;
      transform: translate(-0.03em, -0.01em);
    }

    58% {
      opacity: 0.055;
      transform: translate(-0.008em, -0.002em);
    }

    76% {
      opacity: 0.09;
      transform: translate(-0.024em, -0.008em);
    }
  }

  @keyframes nf-idle-b {
    0%,
    100% {
      opacity: 0.035;
      transform: translate(0.02em, 0.007em);
    }

    30% {
      opacity: 0.075;
      transform: translate(0.038em, 0.012em);
    }

    55% {
      opacity: 0.025;
      transform: translate(0.006em, 0.002em);
    }

    78% {
      opacity: 0.05;
      transform: translate(0.028em, 0.009em);
    }
  }

  @keyframes nf-callback-hover-a {
    0% {
      opacity: 0.075;
      transform: translate(-0.018em, -0.006em);
    }

    32% {
      opacity: 0.18;
      transform: translate(-0.056em, -0.018em);
    }

    64% {
      opacity: 0.055;
      transform: translate(-0.004em, 0.002em);
    }

    100% {
      opacity: 0.105;
      transform: translate(-0.028em, -0.009em);
    }
  }

  @keyframes nf-callback-hover-b {
    0% {
      opacity: 0.04;
      transform: translate(0.024em, 0.008em);
    }

    32% {
      opacity: 0.12;
      transform: translate(0.062em, 0.02em);
    }

    66% {
      opacity: 0.025;
      transform: translate(-0.006em, -0.002em);
    }

    100% {
      opacity: 0.055;
      transform: translate(0.034em, 0.011em);
    }
  }
</style>
