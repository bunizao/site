---
import Layout from '../layouts/Layout.astro';

const title = '404 - page not found';
const description = "The page you're looking for isn't here.";
---

<Layout title={title} description={description} hideSiteNav>
  <main class="not-found" data-not-found>
    <canvas class="nf-canvas" data-error-canvas aria-hidden="true"></canvas>
    <a class="nf-brand" href="/" aria-label="Bunizao home">Bunizao</a>

    <section class="nf-copy" aria-labelledby="not-found-title">
      <p class="nf-kicker">lost signal / 404</p>
      <h1 id="not-found-title">Page not found</h1>
      <p>this page slipped out of the index.</p>
      <a href="/" class="nf-home">go home</a>
    </section>
  </main>
</Layout>

<style>
  :global(body:has(.not-found) .global-header-actions) {
    display: none;
  }

  :global(body:has(.not-found) .site-shell) {
    min-height: 100svh;
  }

  .not-found {
    --nf-bg: hsl(var(--background));
    --nf-fg: hsl(var(--foreground));
    --nf-muted: hsl(var(--muted-foreground));
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    color: var(--nf-fg);
    background: var(--nf-bg);
    isolation: isolate;
  }

  .nf-canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    background: var(--nf-bg);
  }

  .nf-brand {
    position: fixed;
    top: clamp(16px, 2.4vw, 28px);
    left: clamp(16px, 2.4vw, 28px);
    z-index: 2;
    color: var(--nf-fg);
    font-size: clamp(16px, 1.7vw, 24px);
    font-weight: 720;
    line-height: 1;
    letter-spacing: -0.045em;
    text-decoration: none;
    mix-blend-mode: normal;
  }

  .nf-brand::after {
    content: "®";
    position: relative;
    top: -0.44em;
    margin-left: 1px;
    font-size: 0.46em;
    font-weight: 500;
    letter-spacing: 0;
  }

  .nf-copy {
    position: fixed;
    right: clamp(18px, 2.8vw, 34px);
    bottom: clamp(18px, 2.8vw, 34px);
    left: clamp(18px, 2.8vw, 34px);
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 10px 24px;
    pointer-events: none;
  }

  .nf-kicker,
  .nf-copy h1,
  .nf-copy p,
  .nf-home {
    margin: 0;
    font-size: 11px;
    line-height: 1.35;
    letter-spacing: 0.02em;
    text-transform: lowercase;
  }

  .nf-kicker {
    position: fixed;
    top: clamp(82px, 8vw, 118px);
    right: clamp(18px, 4vw, 56px);
    color: var(--nf-muted);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.24em;
    writing-mode: vertical-rl;
  }

  .nf-copy h1 {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .nf-copy p {
    max-width: 32ch;
    color: hsl(var(--foreground) / 0.5);
  }

  .nf-home {
    position: relative;
    color: var(--nf-fg);
    pointer-events: auto;
    text-decoration: none;
  }

  .nf-home::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -4px;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 180ms ease;
  }

  .nf-home:hover::after,
  .nf-home:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  @media (max-width: 640px) {
    .nf-copy {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 8px;
    }

    .nf-kicker {
      top: auto;
      right: auto;
      bottom: 104px;
      left: 20px;
      writing-mode: horizontal-tb;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nf-home::after {
      transition: none;
    }
  }
</style>

<script>
  queueMicrotask(() => {
    const root = document.querySelector<HTMLElement>('[data-not-found]');
    const canvas = document.querySelector<HTMLCanvasElement>('[data-error-canvas]');

    if (root && canvas) {
      const ctx = canvas.getContext('2d', { alpha: true });
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      if (ctx) {
        const glyph = document.createElement('canvas');
        const glyphCtx = glyph.getContext('2d');
        let width = 0;
        let height = 0;
        let dpr = 1;
        let renderWidth = 0;
        let renderHeight = 0;
        let animationFrame = 0;
        let colors = readColors();

        const drawOnce = () => draw(performance.now() * 0.001);

        const resize = () => {
          const rect = root.getBoundingClientRect();
          width = Math.max(1, Math.round(rect.width));
          height = Math.max(1, Math.round(rect.height));
          dpr = Math.min(window.devicePixelRatio || 1, 2);
          renderWidth = Math.round(width * dpr);
          renderHeight = Math.round(height * dpr);

          canvas.width = renderWidth;
          canvas.height = renderHeight;
          canvas.style.width = `${width}px`;
          canvas.style.height = `${height}px`;

          ctx.imageSmoothingEnabled = false;
          buildGlyph();
          drawOnce();
        };

        const animate = (time: number) => {
          draw(time * 0.001);
          if (!reducedMotion.matches) {
            animationFrame = requestAnimationFrame(animate);
          }
        };

        const restart = () => {
          cancelAnimationFrame(animationFrame);
          colors = readColors();
          buildGlyph();
          if (reducedMotion.matches) {
            drawOnce();
            return;
          }
          animationFrame = requestAnimationFrame(animate);
        };

        const observer = new ResizeObserver(resize);
        const themeObserver = new MutationObserver(restart);

        observer.observe(root);
        themeObserver.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['class', 'data-theme-setting'],
        });
        reducedMotion.addEventListener('change', restart);

        document.fonts?.ready.then(() => {
          buildGlyph();
          drawOnce();
        });

        resize();
        restart();

        window.addEventListener('pagehide', () => {
          cancelAnimationFrame(animationFrame);
          observer.disconnect();
          themeObserver.disconnect();
          reducedMotion.removeEventListener('change', restart);
        });

        function readColors() {
          const styles = getComputedStyle(root);
          const isDark = document.documentElement.classList.contains('dark');
          return {
            background: styles.backgroundColor,
            foreground: styles.color,
            guide: isDark ? 'rgba(255, 255, 255, 0.1)' : 'rgba(0, 0, 0, 0.075)',
          };
        }

        function buildGlyph() {
          if (!glyphCtx || renderWidth === 0 || renderHeight === 0) return;

          glyph.width = renderWidth;
          glyph.height = renderHeight;
          glyphCtx.clearRect(0, 0, renderWidth, renderHeight);
          glyphCtx.fillStyle = colors.foreground;
          glyphCtx.textAlign = 'center';
          glyphCtx.textBaseline = 'middle';

          const targetWidth = renderWidth * (width < 640 ? 1.18 : 0.94);
          let fontSize = renderHeight * (width < 640 ? 0.82 : 0.92);
          glyphCtx.font = `650 ${fontSize}px "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace`;
          const measured = glyphCtx.measureText('404').width;
          if (measured > targetWidth) fontSize *= targetWidth / measured;

          glyphCtx.font = `650 ${fontSize}px "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace`;
          glyphCtx.fillText('404', renderWidth / 2, renderHeight * (width < 640 ? 0.49 : 0.51));
        }

        function draw(time: number) {
          ctx.imageSmoothingEnabled = false;
          ctx.fillStyle = colors.background;
          ctx.fillRect(0, 0, renderWidth, renderHeight);
          drawGuideLines(time);
          drawDisplacedNumber(time);
        }

        function drawGuideLines(time: number) {
          const spacing = Math.max(16, Math.round(renderWidth / 74));
          const segment = Math.max(44, Math.round(renderHeight / 14));
          ctx.save();
          ctx.strokeStyle = colors.guide;
          ctx.lineWidth = Math.max(1, dpr);

          for (let x = -spacing; x < renderWidth + spacing; x += spacing) {
            const column = Math.round(x / spacing);
            const drift = Math.sin(time * 1.1 + column * 0.8) * dpr * 7;
            for (let y = -segment; y < renderHeight + segment; y += segment * 1.45) {
              const phase = seededRandom(column * 19 + Math.round(y));
              ctx.beginPath();
              ctx.moveTo(Math.round(x + drift) + 0.5, y + phase * segment * 0.28);
              ctx.lineTo(Math.round(x + drift) + 0.5, y + segment * 0.74 + phase * segment * 0.28);
              ctx.stroke();
            }
          }

          ctx.restore();
        }

        function drawDisplacedNumber(time: number) {
          const rowHeight = Math.max(3, Math.round(dpr * 5));
          const cycle = (time * 0.42) % 1;
          const sweepCenter = renderHeight * (0.1 + cycle * 0.8);
          const amplitude = renderWidth * (width < 640 ? 0.15 : 0.18);
          const slowDrift = Math.sin(time * 1.25) * renderWidth * 0.018;

          ctx.save();
          ctx.drawImage(glyph, slowDrift, Math.sin(time * 0.9) * dpr * 2);

          for (let y = 0; y < renderHeight; y += rowHeight) {
            const yRatio = y / renderHeight;
            const rowPhase = yRatio * 18;
            const mainDistance = Math.abs(y - sweepCenter) / Math.max(1, renderHeight * 0.16);
            const echoDistance = Math.abs(y - ((sweepCenter + renderHeight * 0.42) % renderHeight)) / Math.max(1, renderHeight * 0.22);
            const mainSweep = Math.max(0, 1 - mainDistance);
            const echoSweep = Math.max(0, 1 - echoDistance) * 0.45;
            const energy = Math.max(Math.pow(mainSweep, 2.1), Math.pow(echoSweep, 2));

            if (energy < 0.015) continue;

            const direction = Math.sin(rowPhase + time * 4.8) > 0 ? 1 : -1;
            const ripple = Math.sin(time * 3.2 + rowPhase * 0.8) * renderWidth * 0.025;
            const offset = slowDrift + direction * energy * amplitude + ripple * energy;
            const stretch = Math.sin(time * 2.4 - rowPhase) * dpr * 2.2 * energy;
            const sliceHeight = Math.min(renderHeight - y, rowHeight + Math.ceil(dpr));

            ctx.globalCompositeOperation = 'destination-out';
            ctx.drawImage(glyph, 0, y, renderWidth, sliceHeight, slowDrift, y, renderWidth, sliceHeight);
            ctx.globalCompositeOperation = 'source-over';
            ctx.drawImage(glyph, 0, y, renderWidth, sliceHeight, offset, y + stretch, renderWidth, sliceHeight);
          }

          ctx.globalAlpha = 0.07;
          ctx.globalCompositeOperation = 'multiply';
          ctx.drawImage(glyph, slowDrift + Math.sin(time * 1.8) * renderWidth * 0.035, Math.cos(time * 1.1) * dpr * 5);

          ctx.restore();
        }

        function seededRandom(seed: number) {
          const value = Math.sin(seed * 127.1) * 43758.5453123;
          return value - Math.floor(value);
        }
      }
    }
  });
</script>
