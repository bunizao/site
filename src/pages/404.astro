---
import Layout from '../layouts/Layout.astro';

const title = '404 — page adrift';
const description = "The page you wanted isn't here right now.";

const seen = [
  { time: '14:02', location: '+38.41 / -122.10', visitor: 'visitor.a3f' },
  { time: '13:47', location: '-12.88 / +144.96', visitor: 'visitor.7c1' },
  { time: '13:12', location: '+51.50 / -000.12', visitor: 'visitor.b09' },
  { time: '12:58', location: '-33.86 / +151.20', visitor: 'visitor.e44' },
];
---

<Layout title={title} description={description} hideSiteNav>
  <main class="not-found-page" data-drift-stage>
    <div class="drift-grid" data-drift-grid aria-hidden="true"></div>

    <span class="drift-bracket drift-bracket-tl" aria-hidden="true"></span>
    <span class="drift-bracket drift-bracket-tr" aria-hidden="true"></span>
    <span class="drift-bracket drift-bracket-bl" aria-hidden="true"></span>
    <span class="drift-bracket drift-bracket-br" aria-hidden="true"></span>

    <div class="drift-trail" data-drift-trail aria-hidden="true"></div>
    <div class="drift-star-wrap" data-drift-star aria-hidden="true">
      <span class="drift-halo"></span>
      <span class="drift-star-glyph">*</span>
    </div>

    <div class="drift-hud drift-hud-tl" aria-hidden="true">
      <div class="drift-hud-row">
        <span class="drift-pulse-dot"></span>
        <span>Adrift</span>
      </div>
      <div class="drift-hud-sub">tracking · t+<span data-drift-elapsed>00:00</span></div>
    </div>

    <div class="drift-hud drift-hud-tr" aria-hidden="true">
      <div class="drift-hud-row drift-hud-row-end">
        <span class="drift-hud-num">404</span>
      </div>
      <div class="drift-hud-sub drift-hud-sub-end">
        <span data-drift-lat>+00.00</span>
        <span class="drift-sep">/</span>
        <span data-drift-lon>+00.00</span>
      </div>
      <div class="drift-hud-sub drift-hud-sub-end drift-dim">v<span data-drift-speed>0.00</span></div>
    </div>

    <section class="drift-copy" aria-labelledby="not-found-title">
      <h1 id="not-found-title" class="drift-title">
        <span class="drift-line drift-line-1">the page you wanted</span>
        <span class="drift-line drift-line-2">isn't here right now.</span>
      </h1>
      <p class="drift-line drift-line-3">
        maybe it's
        <span class="drift-rotor" aria-live="polite">
          <span class="drift-rotor-in" data-drift-word>over there</span>
        </span>,
        maybe it never was.
      </p>

      <div class="drift-actions">
        <a href="/" class="drift-cta" aria-label="Go back home">
          <span class="drift-cta-asterisk" aria-hidden="true">*</span>
          <span>follow the asterisk home</span>
          <span class="drift-cta-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <div class="drift-seen" aria-hidden="true">
      <div class="drift-seen-label">Last seen</div>
      <ul class="drift-seen-list">
        {seen.map((entry, index) => (
          <li class="drift-seen-row" style={`--row-delay: ${1 + index * 0.08}s`}>
            <span class="drift-seen-time">{entry.time}</span>
            <span class="drift-seen-loc">{entry.location}</span>
            <span class="drift-seen-who">{entry.visitor}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="drift-legend" aria-hidden="true">
      <div class="drift-legend-row"><span class="drift-legend-key">*</span> you are here</div>
      <div class="drift-legend-row"><span class="drift-legend-key">·</span> places it has been</div>
      <div class="drift-legend-row drift-dim">grid: 28px · t: 1Hz</div>
    </div>
  </main>
</Layout>

<style>
  .not-found-page {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background: hsl(var(--background));
    color: hsl(var(--foreground));
    isolation: isolate;
  }

  .drift-grid {
    position: absolute;
    inset: -24px;
    background-image: radial-gradient(circle, hsl(var(--foreground) / 0.1) 1px, transparent 1px);
    background-size: 28px 28px;
    pointer-events: none;
    transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
    will-change: transform;
    z-index: -1;
  }

  .drift-bracket {
    position: absolute;
    width: 18px;
    height: 18px;
    border: 1px solid hsl(var(--foreground) / 0.5);
    pointer-events: none;
    opacity: 0;
    animation: drift-bracket-in 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) 0.2s forwards;
  }

  .drift-bracket-tl {
    top: 24px;
    left: 24px;
    border-right: 0;
    border-bottom: 0;
  }

  .drift-bracket-tr {
    top: 24px;
    right: 76px;
    border-left: 0;
    border-bottom: 0;
  }

  .drift-bracket-bl {
    bottom: 24px;
    left: 24px;
    border-right: 0;
    border-top: 0;
  }

  .drift-bracket-br {
    right: 24px;
    bottom: 24px;
    border-left: 0;
    border-top: 0;
  }

  .drift-trail {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  :global(.drift-trail-glyph) {
    position: absolute;
    margin-top: -6px;
    margin-left: -3px;
    color: hsl(var(--foreground));
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    opacity: 0.5;
    transform: rotate(var(--rot, 0deg)) scale(1);
    animation: drift-glyph-fade 3.2s ease-out forwards;
    pointer-events: none;
    white-space: nowrap;
  }

  .drift-star-wrap {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    pointer-events: none;
    transform: translate(62vw, 28vh);
    will-change: transform;
  }

  .drift-star-glyph {
    position: absolute;
    top: 0;
    left: 0;
    color: hsl(var(--foreground));
    font-size: 32px;
    font-weight: 700;
    line-height: 1;
    text-shadow: 0 0 8px hsl(var(--background));
    transform: translate(-50%, -50%);
  }

  .drift-halo {
    position: absolute;
    top: 0;
    left: 0;
    width: 60px;
    height: 60px;
    margin-top: -30px;
    margin-left: -30px;
    border: 1px solid hsl(var(--foreground) / 0.18);
    border-radius: 50%;
    animation: drift-halo-pulse 2.4s ease-in-out infinite;
  }

  .drift-halo::before {
    content: "";
    position: absolute;
    inset: -10px;
    border: 1px dashed hsl(var(--foreground) / 0.1);
    border-radius: 50%;
    animation: drift-halo-spin 12s linear infinite;
  }

  .drift-hud {
    position: absolute;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: hsl(var(--muted-foreground));
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0;
    animation: drift-fade-in 0.6s ease 0.35s forwards;
  }

  .drift-hud-tl {
    top: 40px;
    left: 56px;
  }

  .drift-hud-tr {
    top: 40px;
    right: 88px;
    align-items: flex-end;
  }

  .drift-hud-row {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .drift-hud-row-end {
    justify-content: flex-end;
  }

  .drift-hud-num {
    color: hsl(var(--foreground));
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .drift-hud-sub {
    color: hsl(var(--muted-foreground) / 0.7);
    font-size: 10px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.12em;
  }

  .drift-hud-sub-end {
    text-align: right;
  }

  .drift-dim {
    color: hsl(var(--muted-foreground) / 0.45);
  }

  .drift-sep {
    margin: 0 2px;
    opacity: 0.4;
  }

  .drift-pulse-dot {
    width: 6px;
    height: 6px;
    flex-shrink: 0;
    background: hsl(var(--foreground));
    animation: drift-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  .drift-copy {
    position: absolute;
    top: 50%;
    left: clamp(24px, 7vw, 56px);
    max-width: min(460px, calc(100% - 48px));
    padding-right: 24px;
    transform: translateY(-50%);
  }

  .drift-title {
    margin: 0;
  }

  .drift-line {
    display: block;
    margin: 0;
    color: hsl(var(--foreground));
    font-size: clamp(24px, 5vw, 28px);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.35;
    opacity: 0;
    transform: translateY(10px);
    animation: drift-rise 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  .drift-line-1 {
    animation-delay: 0.25s;
  }

  .drift-line-2 {
    animation-delay: 0.45s;
  }

  .drift-line-3 {
    margin-top: 22px;
    color: hsl(var(--muted-foreground));
    font-size: 14px;
    font-weight: 400;
    line-height: 1.7;
    animation-delay: 0.8s;
  }

  .drift-rotor {
    position: relative;
    display: inline-block;
    min-width: 7ch;
    height: 1.4em;
    padding: 0 2px;
    overflow: hidden;
    color: hsl(var(--foreground));
    vertical-align: bottom;
    border-bottom: 1px dashed hsl(var(--foreground) / 0.35);
  }

  .drift-rotor-in {
    display: inline-block;
    animation: drift-word-in 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .drift-actions {
    margin-top: 30px;
    opacity: 0;
    animation: drift-fade-in 0.6s ease 1.05s forwards;
  }

  .drift-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    color: hsl(var(--foreground));
    font-size: 13px;
    text-decoration: none;
    background: transparent;
    border: 1px solid hsl(var(--foreground) / 0.25);
    border-radius: 8px;
    transition:
      background-color 0.2s cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 0.2s cubic-bezier(0.2, 0.8, 0.2, 1),
      color 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .drift-cta:hover {
    color: hsl(var(--background));
    background: hsl(var(--foreground));
    border-color: hsl(var(--foreground));
  }

  .drift-cta-asterisk {
    display: inline-block;
    font-size: 16px;
    font-weight: 700;
    line-height: 1;
    animation: drift-spin 6s linear infinite;
  }

  .drift-cta:hover .drift-cta-asterisk {
    animation-duration: 1.4s;
  }

  .drift-cta-arrow {
    transition: transform 0.2s;
  }

  .drift-cta:hover .drift-cta-arrow {
    transform: translateX(4px);
  }

  .drift-seen {
    position: absolute;
    bottom: 56px;
    left: 56px;
    color: hsl(var(--muted-foreground));
    font-size: 10px;
    font-variant-numeric: tabular-nums;
    opacity: 0;
    animation: drift-fade-in 0.6s ease 0.9s forwards;
  }

  .drift-seen-label {
    margin-bottom: 8px;
    color: hsl(var(--muted-foreground) / 0.7);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .drift-seen-list {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .drift-seen-row {
    display: grid;
    grid-template-columns: 44px 130px auto;
    gap: 14px;
    align-items: center;
    opacity: 0;
    transform: translateX(-6px);
    animation: drift-row-in 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) var(--row-delay) forwards;
  }

  .drift-seen-time {
    color: hsl(var(--muted-foreground) / 0.55);
    font-weight: 500;
  }

  .drift-seen-loc {
    color: hsl(var(--foreground) / 0.85);
    letter-spacing: 0.04em;
  }

  .drift-seen-who {
    color: hsl(var(--muted-foreground) / 0.45);
  }

  .drift-legend {
    position: absolute;
    right: 56px;
    bottom: 56px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    color: hsl(var(--muted-foreground));
    font-size: 10px;
    text-align: right;
    opacity: 0;
    animation: drift-fade-in 0.6s ease 1.1s forwards;
  }

  .drift-legend-row {
    display: inline-flex;
    justify-content: flex-end;
    gap: 8px;
    align-items: baseline;
  }

  .drift-legend-key {
    display: inline-block;
    width: 10px;
    color: hsl(var(--foreground));
    font-weight: 700;
    text-align: center;
  }

  @keyframes drift-bracket-in {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes drift-glyph-fade {
    0% {
      opacity: 0;
      transform: rotate(var(--rot, 0deg)) scale(0.4);
    }
    15% {
      opacity: 0.75;
      transform: rotate(var(--rot, 0deg)) scale(1);
    }
    100% {
      opacity: 0;
      transform: rotate(var(--rot, 0deg)) scale(0.7);
    }
  }

  @keyframes drift-halo-pulse {
    0%,
    100% {
      opacity: 0.7;
      transform: scale(1);
    }
    50% {
      opacity: 0.25;
      transform: scale(1.3);
    }
  }

  @keyframes drift-halo-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes drift-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  @keyframes drift-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes drift-word-in {
    from {
      opacity: 0;
      transform: translateY(100%);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes drift-fade-in {
    to {
      opacity: 1;
    }
  }

  @keyframes drift-row-in {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes drift-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 720px) {
    .not-found-page {
      min-height: 100dvh;
    }

    .drift-bracket-tl,
    .drift-bracket-bl {
      left: 16px;
    }

    .drift-bracket-tr {
      right: 68px;
    }

    .drift-bracket-br {
      right: 16px;
    }

    .drift-bracket-tl,
    .drift-bracket-tr {
      top: 16px;
    }

    .drift-bracket-bl,
    .drift-bracket-br {
      bottom: 16px;
    }

    .drift-hud-tl {
      top: 32px;
      left: 32px;
    }

    .drift-hud-tr {
      top: 32px;
      right: 72px;
    }

    .drift-copy {
      top: 48%;
    }

    .drift-star-wrap {
      transform: translate(72vw, 16vh);
    }

    .drift-seen {
      bottom: 32px;
      left: 32px;
    }

    .drift-seen-row {
      grid-template-columns: 42px minmax(0, 120px);
    }

    .drift-seen-who {
      display: none;
    }

    .drift-legend {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .drift-hud-tr {
      display: none;
    }

    .drift-copy {
      top: 45%;
    }

    .drift-line {
      font-size: 24px;
    }

    .drift-line-3 {
      max-width: 28ch;
      font-size: 13px;
    }

    .drift-seen {
      right: 32px;
      bottom: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .drift-grid,
    .drift-bracket,
    :global(.drift-trail-glyph),
    .drift-halo,
    .drift-halo::before,
    .drift-hud,
    .drift-line,
    .drift-rotor-in,
    .drift-actions,
    .drift-seen,
    .drift-seen-row,
    .drift-legend,
    .drift-cta-asterisk {
      animation: none;
      transition: none;
    }

    .drift-bracket,
    .drift-hud,
    .drift-line,
    .drift-actions,
    .drift-seen,
    .drift-seen-row,
    .drift-legend {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const stage = document.querySelector('[data-drift-stage]') as HTMLElement | null;

  if (stage) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const star = stage.querySelector('[data-drift-star]') as HTMLElement | null;
    const trail = stage.querySelector('[data-drift-trail]') as HTMLElement | null;
    const grid = stage.querySelector('[data-drift-grid]') as HTMLElement | null;
    const elapsedEl = stage.querySelector('[data-drift-elapsed]');
    const latEl = stage.querySelector('[data-drift-lat]');
    const lonEl = stage.querySelector('[data-drift-lon]');
    const speedEl = stage.querySelector('[data-drift-speed]');
    const wordEl = stage.querySelector('[data-drift-word]');
    const words = ['over there', 'somewhere else', 'anywhere', 'nowhere', 'just past the edge', 'two clicks ago'];

    let elapsed = 0;
    let wordIndex = 0;

    const formatElapsed = (value: number) => {
      const minutes = Math.floor(value / 60);
      const seconds = value % 60;
      return `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
    };

    const elapsedTimer = window.setInterval(() => {
      elapsed += 1;
      if (elapsedEl) elapsedEl.textContent = formatElapsed(elapsed);
    }, 1000);

    const wordTimer = window.setInterval(() => {
      if (!wordEl) return;
      wordIndex = (wordIndex + 1) % words.length;
      wordEl.textContent = words[wordIndex];
      wordEl.classList.remove('drift-rotor-in');
      void (wordEl as HTMLElement).offsetWidth;
      wordEl.classList.add('drift-rotor-in');
    }, 2800);

    if (reducedMotion || !star || !trail) {
      window.addEventListener('pagehide', () => {
        window.clearInterval(elapsedTimer);
        window.clearInterval(wordTimer);
      });
    } else {
      const state = {
        x: 0,
        y: 0,
        vx: 0.55,
        vy: 0.32,
        t: 0,
        mx: -1,
        my: -1,
      };

      const glyphs = ['·', '·', '·', '+', '+', '/', '×', '·'];
      const liveGlyphs: HTMLElement[] = [];
      let frameId = 0;

      const getRect = () => stage.getBoundingClientRect();
      const rect = getRect();
      state.x = rect.width * (rect.width < 720 ? 0.72 : 0.62);
      state.y = rect.height * (rect.width < 720 ? 0.16 : 0.28);

      const onPointerMove = (event: PointerEvent) => {
        const currentRect = getRect();
        state.mx = event.clientX - currentRect.left;
        state.my = event.clientY - currentRect.top;

        const dx = (state.mx - currentRect.width / 2) / currentRect.width;
        const dy = (state.my - currentRect.height / 2) / currentRect.height;
        if (grid) grid.style.transform = `translate(${dx * -10}px, ${dy * -10}px)`;
      };

      const onPointerLeave = () => {
        state.mx = -1;
        state.my = -1;
        if (grid) grid.style.transform = 'translate(0, 0)';
      };

      const updateHud = (speed: number, currentRect: DOMRect) => {
        const lat = ((state.y / currentRect.height) * 180 - 90).toFixed(2);
        const lon = ((state.x / currentRect.width) * 360 - 180).toFixed(2);
        if (latEl) latEl.textContent = `${Number(lat) >= 0 ? '+' : ''}${lat}`;
        if (lonEl) lonEl.textContent = `${Number(lon) >= 0 ? '+' : ''}${lon}`;
        if (speedEl) speedEl.textContent = speed.toFixed(2);
      };

      const addTrailGlyph = () => {
        const glyph = document.createElement('span');
        glyph.className = 'drift-trail-glyph';
        glyph.textContent = glyphs[Math.floor(Math.random() * glyphs.length)];
        glyph.style.left = `${state.x}px`;
        glyph.style.top = `${state.y}px`;
        glyph.style.setProperty('--rot', `${Math.random() * 60 - 30}deg`);
        trail.appendChild(glyph);
        liveGlyphs.push(glyph);

        if (liveGlyphs.length > 60) {
          liveGlyphs.shift()?.remove();
        }
      };

      const tick = () => {
        const currentRect = getRect();
        state.t += 1;
        state.vx += Math.sin(state.t * 0.006) * 0.005;
        state.vy += Math.cos(state.t * 0.004) * 0.004;

        if (state.mx >= 0 && state.my >= 0) {
          const dx = state.mx - state.x;
          const dy = state.my - state.y;
          const distance = Math.hypot(dx, dy);

          if (distance > 1 && distance < 320) {
            const force = ((320 - distance) / 320) * 0.06;
            state.vx += (dx / distance) * force;
            state.vy += (dy / distance) * force;
          }
        }

        if (state.x < 32) state.vx = Math.abs(state.vx);
        if (state.x > currentRect.width - 32) state.vx = -Math.abs(state.vx);
        if (state.y < 32) state.vy = Math.abs(state.vy);
        if (state.y > currentRect.height - 32) state.vy = -Math.abs(state.vy);

        state.vx *= 0.985;
        state.vy *= 0.985;

        const speed = Math.hypot(state.vx, state.vy);
        if (speed < 0.25) {
          state.vx *= 1.04;
          state.vy *= 1.04;
        }

        state.x += state.vx;
        state.y += state.vy;
        star.style.transform = `translate(${state.x}px, ${state.y}px) rotate(${state.t * 0.6}deg)`;

        if (state.t % 5 === 0) addTrailGlyph();
        if (state.t % 8 === 0) updateHud(speed, currentRect);

        frameId = window.requestAnimationFrame(tick);
      };

      stage.addEventListener('pointermove', onPointerMove);
      stage.addEventListener('pointerleave', onPointerLeave);
      frameId = window.requestAnimationFrame(tick);

      window.addEventListener('pagehide', () => {
        window.clearInterval(elapsedTimer);
        window.clearInterval(wordTimer);
        window.cancelAnimationFrame(frameId);
        stage.removeEventListener('pointermove', onPointerMove);
        stage.removeEventListener('pointerleave', onPointerLeave);
      });
    }
  }
</script>
