---
import Layout from '../layouts/Layout.astro';

const title = '404 - page not found';
const description = "The page you're looking for isn't here.";
---

<Layout title={title} description={description} hideSiteNav>
  <main class="not-found">
    <a class="nf-brand" href="/" aria-label="Bunizao home">Bunizao</a>

    <div class="nf-number" aria-hidden="true">404</div>

    <section class="nf-copy" aria-labelledby="not-found-title">
      <p class="nf-kicker">404 / not found</p>
      <h1 id="not-found-title">Page not found</h1>
      <p>this page slipped out of the index.</p>
      <a href="/" class="nf-home">go home</a>
    </section>
  </main>
</Layout>

<style>
  :global(body:has(.not-found) .global-header-actions) {
    display: none;
  }

  :global(body:has(.not-found) .site-shell) {
    min-height: 100svh;
  }

  .not-found {
    --nf-bg: hsl(var(--background));
    --nf-fg: hsl(var(--foreground));
    --nf-muted: hsl(var(--muted-foreground));
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    overflow: hidden;
    color: var(--nf-fg);
    background: var(--nf-bg);
    isolation: isolate;
  }

  .not-found::before,
  .not-found::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .not-found::before {
    opacity: 0.42;
    background-image:
      linear-gradient(hsl(var(--foreground) / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, hsl(var(--foreground) / 0.045) 1px, transparent 1px);
    background-size: 100% clamp(72px, 11svh, 112px), clamp(72px, 11svh, 112px) 100%;
  }

  .not-found::after {
    opacity: 0.55;
    background: linear-gradient(
      180deg,
      transparent 0,
      transparent calc(50% - 1px),
      hsl(var(--foreground) / 0.18) 50%,
      transparent calc(50% + 1px),
      transparent 100%
    );
    animation: nf-scan 7s ease-in-out infinite;
  }

  .nf-brand {
    position: fixed;
    top: clamp(16px, 2.4vw, 28px);
    left: clamp(16px, 2.4vw, 28px);
    z-index: 2;
    color: var(--nf-fg);
    font-size: clamp(16px, 1.7vw, 24px);
    font-weight: 720;
    line-height: 1;
    letter-spacing: 0;
    text-decoration: none;
    mix-blend-mode: normal;
  }

  .nf-brand::after {
    content: "®";
    position: relative;
    top: -0.44em;
    margin-left: 1px;
    font-size: 0.46em;
    font-weight: 500;
    letter-spacing: 0;
  }

  .nf-number {
    position: relative;
    z-index: 1;
    width: min(92vw, 1100px);
    color: var(--nf-fg);
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: min(38svh, 21rem);
    font-weight: 520;
    line-height: 0.82;
    letter-spacing: 0;
    text-align: center;
    font-variant-numeric: tabular-nums;
    transform: translateY(-1svh);
    animation: nf-breathe 9s ease-in-out infinite;
  }

  .nf-copy {
    position: fixed;
    right: clamp(18px, 2.8vw, 34px);
    bottom: clamp(30px, 4svh, 52px);
    left: clamp(18px, 2.8vw, 34px);
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 10px 24px;
    pointer-events: none;
  }

  .nf-kicker,
  .nf-copy h1,
  .nf-copy p,
  .nf-home {
    margin: 0;
    font-size: 11px;
    line-height: 1.35;
    letter-spacing: 0;
    text-transform: lowercase;
  }

  .nf-kicker {
    position: fixed;
    top: clamp(82px, 8vw, 118px);
    right: clamp(18px, 4vw, 56px);
    color: var(--nf-muted);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
    writing-mode: vertical-rl;
  }

  .nf-copy h1 {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .nf-copy p {
    max-width: 32ch;
    color: hsl(var(--foreground) / 0.5);
  }

  .nf-home {
    position: relative;
    color: var(--nf-fg);
    pointer-events: auto;
    text-decoration: none;
  }

  .nf-home::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -4px;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 180ms ease;
  }

  .nf-home:hover::after,
  .nf-home:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  @media (max-width: 640px) {
    .nf-number {
      width: min(96vw, 420px);
      font-size: min(28svh, 10rem);
      transform: translateY(-4svh);
    }

    .nf-copy {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 8px;
    }

    .nf-kicker {
      top: auto;
      right: auto;
      bottom: 104px;
      left: 20px;
      writing-mode: horizontal-tb;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .not-found::after,
    .nf-number {
      animation: none;
    }

    .nf-home::after {
      transition: none;
    }
  }

  @keyframes nf-breathe {
    0%,
    100% {
      opacity: 0.94;
      transform: translateY(-1svh);
    }

    50% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes nf-scan {
    0%,
    100% {
      transform: translateY(-34svh);
    }

    50% {
      transform: translateY(34svh);
    }
  }
</style>
