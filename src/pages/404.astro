---
import Layout from '../layouts/Layout.astro';

const title = '404 - page not found';
const description = "The page you're looking for isn't here.";
---

<Layout title={title} description={description} hideSiteNav>
  <main class="not-found" data-not-found>
    <canvas class="nf-canvas" data-error-canvas aria-hidden="true"></canvas>
    <a class="nf-brand" href="/" aria-label="Bunizao home">Bunizao</a>

    <section class="nf-copy" aria-labelledby="not-found-title">
      <p class="nf-kicker">lost signal / 404</p>
      <h1 id="not-found-title">Page not found</h1>
      <p>this page slipped out of the index.</p>
      <a href="/" class="nf-home">go home</a>
    </section>
  </main>
</Layout>

<style>
  :global(body:has(.not-found) .global-header-actions) {
    display: none;
  }

  :global(body:has(.not-found) .site-shell) {
    min-height: 100svh;
  }

  .not-found {
    --nf-bg: hsl(var(--background));
    --nf-fg: hsl(var(--foreground));
    --nf-muted: hsl(var(--muted-foreground));
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    color: var(--nf-fg);
    background: var(--nf-bg);
    isolation: isolate;
  }

  .nf-canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    background: var(--nf-bg);
  }

  .nf-brand {
    position: fixed;
    top: clamp(16px, 2.4vw, 28px);
    left: clamp(16px, 2.4vw, 28px);
    z-index: 2;
    color: var(--nf-fg);
    font-size: clamp(16px, 1.7vw, 24px);
    font-weight: 720;
    line-height: 1;
    letter-spacing: -0.045em;
    text-decoration: none;
    mix-blend-mode: normal;
  }

  .nf-brand::after {
    content: "®";
    position: relative;
    top: -0.44em;
    margin-left: 1px;
    font-size: 0.46em;
    font-weight: 500;
    letter-spacing: 0;
  }

  .nf-copy {
    position: fixed;
    right: clamp(18px, 2.8vw, 34px);
    bottom: clamp(18px, 2.8vw, 34px);
    left: clamp(18px, 2.8vw, 34px);
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 10px 24px;
    pointer-events: none;
  }

  .nf-kicker,
  .nf-copy h1,
  .nf-copy p,
  .nf-home {
    margin: 0;
    font-size: 11px;
    line-height: 1.35;
    letter-spacing: 0.02em;
    text-transform: lowercase;
  }

  .nf-kicker {
    position: fixed;
    top: clamp(82px, 8vw, 118px);
    right: clamp(18px, 4vw, 56px);
    color: var(--nf-muted);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.24em;
    writing-mode: vertical-rl;
  }

  .nf-copy h1 {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .nf-copy p {
    max-width: 32ch;
    color: hsl(var(--foreground) / 0.5);
  }

  .nf-home {
    position: relative;
    color: var(--nf-fg);
    pointer-events: auto;
    text-decoration: none;
  }

  .nf-home::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -4px;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 180ms ease;
  }

  .nf-home:hover::after,
  .nf-home:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  @media (max-width: 640px) {
    .nf-copy {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 8px;
    }

    .nf-kicker {
      top: auto;
      right: auto;
      bottom: 104px;
      left: 20px;
      writing-mode: horizontal-tb;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nf-home::after {
      transition: none;
    }
  }
</style>

<script>
  queueMicrotask(() => {
    const root = document.querySelector<HTMLElement>('[data-not-found]');
    const canvas = document.querySelector<HTMLCanvasElement>('[data-error-canvas]');

    if (root && canvas) {
      const ctx = canvas.getContext('2d', { alpha: false });
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      if (ctx) {
      const map = document.createElement('canvas');
      const mapCtx = map.getContext('2d', { willReadFrequently: true });
      const rows: EffectRow[] = [];
      let width = 0;
      let height = 0;
      let dpr = 1;
      let renderWidth = 0;
      let renderHeight = 0;
      let mapData: ImageData | null = null;
      let animationFrame = 0;
      let lastTime = 0;
      let colors = readColors();

      const drawOnce = () => {
        draw(1 / 60);
      };

      const resize = () => {
        const rect = root.getBoundingClientRect();
        width = Math.max(1, Math.round(rect.width));
        height = Math.max(1, Math.round(rect.height));
        dpr = Math.min(window.devicePixelRatio || 1, 2) * 1.5;
        renderWidth = Math.round(width * dpr);
        renderHeight = Math.round(height * dpr);

        canvas.width = renderWidth;
        canvas.height = renderHeight;
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;

        ctx.imageSmoothingEnabled = false;
        buildDisplacementMap();
        buildRows();
        drawOnce();
      };

      const animate = (time: number) => {
        const deltaTime = lastTime ? (time - lastTime) / 1000 : 1 / 60;
        lastTime = time;
        draw(Math.min(deltaTime, 1 / 24));
        if (!reducedMotion.matches) {
          animationFrame = requestAnimationFrame(animate);
        }
      };

      const restart = () => {
        cancelAnimationFrame(animationFrame);
        lastTime = 0;
        colors = readColors();
        buildDisplacementMap();
        buildRows();
        if (reducedMotion.matches) {
          drawOnce();
          return;
        }
        animationFrame = requestAnimationFrame(animate);
      };

      const observer = new ResizeObserver(resize);
      const themeObserver = new MutationObserver(restart);

      observer.observe(root);
      themeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['class', 'data-theme-setting'],
      });
      reducedMotion.addEventListener('change', restart);

      document.fonts?.ready.then(() => {
        buildDisplacementMap();
        buildRows();
        drawOnce();
      });

      resize();
      restart();

      window.addEventListener('pagehide', () => {
        cancelAnimationFrame(animationFrame);
        observer.disconnect();
        themeObserver.disconnect();
        reducedMotion.removeEventListener('change', restart);
      });

      function readColors() {
        const styles = getComputedStyle(root);
        return {
          background: styles.backgroundColor,
          foreground: styles.color,
          faint: document.documentElement.classList.contains('dark')
            ? 'rgba(255, 255, 255, 0.18)'
            : 'rgba(0, 0, 0, 0.1)',
        };
      }

      function buildDisplacementMap() {
        if (!mapCtx || renderWidth === 0 || renderHeight === 0) {
          return;
        }

        map.width = 867;
        map.height = 238;
        mapCtx.imageSmoothingEnabled = true;
        mapCtx.fillStyle = '#fff';
        mapCtx.fillRect(0, 0, map.width, map.height);
        mapCtx.fillStyle = '#1c1c1c';
        mapCtx.textAlign = 'center';
        mapCtx.textBaseline = 'middle';

        const fontStack = '650 286px ui-sans-serif, -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif';
        mapCtx.font = fontStack;
        const measured = mapCtx.measureText('404').width;
        const targetWidth = map.width * 0.74;
        const size = Math.min(286, 286 * (targetWidth / measured));
        mapCtx.font = `650 ${size}px ui-sans-serif, -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif`;
        mapCtx.fillText('404', map.width / 2, map.height * 0.54);
        mapData = mapCtx.getImageData(0, 0, map.width, map.height);
      }

      function buildRows() {
        rows.length = 0;
        const count = 18;
        const rowHeight = renderHeight / count;

        for (let index = 0; index < count; index += 1) {
          const seed = seededRandom(index + 31);
          rows.push(new EffectRow({
            index,
            y: rowHeight * index,
            height: rowHeight,
            canvasWidth: renderWidth,
            mapData,
            color: colors.foreground,
            min: 0.01,
            max: 0.78,
            range: 1.6,
            space: 1.55,
            movement: 0.02 * seed - 0.01,
            drag: 4,
            stretch: {
              amount: 1,
              speed: 8,
              wave: 3,
            },
          }));
        }
      }

      function draw(deltaTime: number) {
        ctx.imageSmoothingEnabled = false;
        ctx.fillStyle = colors.background;
        ctx.fillRect(0, 0, renderWidth, renderHeight);

        ctx.fillStyle = colors.foreground;
        for (const row of rows) {
          row.render(deltaTime, ctx);
        }
      }

      function seededRandom(seed: number) {
        const value = Math.sin(seed * 127.1) * 43758.5453123;
        return value - Math.floor(value);
      }
      }
    }
  });

  type EffectRowOptions = {
    index: number;
    y: number;
    height: number;
    canvasWidth: number;
    mapData: ImageData | null;
    color: string;
    min: number;
    max: number;
    range: number;
    space: number;
    movement: number;
    drag: number;
    stretch: {
      amount: number;
      speed: number;
      wave: number;
    };
  };

  class EffectRow {
    private lines: EffectLine[] = [];
    private scrollX = 0;
    private tick = 0;
    private readonly scale: number;

    constructor(private readonly options: EffectRowOptions) {
      this.scale = options.canvasWidth / 100;
      this.syncLines();
    }

    render(deltaTime: number, ctx: CanvasRenderingContext2D) {
      const { height, y, movement, drag, stretch } = this.options;
      const spacing = this.options.space * this.scale;
      const stretchAmount =
        1 + Math.sin(this.tick * stretch.speed * 0.01 + y * stretch.wave * 0.001) * stretch.amount * 0.01;
      const totalWidth = (this.lines.length * spacing) * stretchAmount;
      const offset = totalWidth - this.options.canvasWidth;

      this.scrollX += movement * this.scale;
      this.tick += deltaTime * 10;

      for (let index = 0; index < this.lines.length; index += 1) {
        const line = this.lines[index];
        let x = (index * spacing - offset * 0.5 + this.scrollX) * stretchAmount;
        while (x < -offset * 0.5) x += totalWidth;
        while (x > totalWidth - offset * 0.5) x -= totalWidth;

        const targetWidth = this.getWidthAt(x);
        line.width += (targetWidth - line.width) / drag;

        if (line.width <= 0.05) continue;
        ctx.fillRect(x - line.width * 0.5, Math.floor(y), line.width, Math.ceil(height));
      }
    }

    private syncLines() {
      const spacing = this.options.space * this.scale;
      const count = Math.floor((this.options.canvasWidth + spacing) / spacing) * 4;
      while (this.lines.length < count) this.lines.push({ width: 0 });
      while (this.lines.length > count) this.lines.pop();
    }

    private getContrastAt(x: number) {
      const imageData = this.options.mapData;
      if (!imageData) return 1;

      const scaleX = imageData.width / this.options.canvasWidth;
      const scaleY = imageData.height / (this.options.height * 18);
      const sourceX = Math.floor(x * scaleX);
      const sourceY = Math.floor((this.options.y + this.options.height * 0.5) * scaleY);
      const index = (sourceY * imageData.width + sourceX) * 4;

      if (index < 0 || index + 2 >= imageData.data.length) return 1;

      const red = imageData.data[index];
      const green = imageData.data[index + 1];
      const blue = imageData.data[index + 2];
      return (red * 0.299 + green * 0.587 + blue * 0.114) / 255;
    }

    private getWidthAt(x: number) {
      const max = this.options.max * this.scale;
      const min = this.options.min * this.scale;
      const range = this.options.range * this.scale;
      const from = Math.floor(x - range / 2);
      const to = Math.ceil(x + range / 2);
      let average = 0;

      for (let sample = from; sample < to; sample += 1) {
        average += this.getContrastAt(sample);
      }

      const count = to - from - 1;
      if (count > 1) average /= count;

      return Math.max(min, (1 - average) * max);
    }
  }

  type EffectLine = {
    width: number;
  };
</script>
