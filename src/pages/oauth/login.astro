---
import '@/styles/globals.css';
import { PEEK_DEBUGGING_STICKER } from '@/features/mascot/peek/stickers';

export const prerender = false;

const url = new URL(Astro.request.url);
const next = url.searchParams.get('next') || '/dev/portal';
const error = url.searchParams.get('error');

function getSignInTarget(value: string): string {
  try {
    const pathname = new URL(value, 'https://buxx.me').pathname;
    if (pathname === '/docs' || pathname.startsWith('/docs/')) return 'docs';
    if (pathname === '/dev/portal' || pathname.startsWith('/dev/portal/')) return 'dev portal';
  } catch {
    return 'buxx.me';
  }

  return 'buxx.me';
}

const errorMessages: Record<string, string> = {
  state: 'Sign-in session expired. Please try again.',
  forbidden: 'Your GitHub account is not allowed to access this portal.',
  token: 'GitHub did not return a valid token. Please try again.',
  user: 'Could not load your GitHub profile. Please try again.',
  config: 'Admin auth is not configured on the server.',
};
const errorMessage = error ? errorMessages[error] ?? 'Sign-in failed. Please try again.' : null;
const signInTarget = getSignInTarget(next);

const startUrl = `/api/admin/auth/start?next=${encodeURIComponent(next)}`;
---

<!doctype html>
<html lang="en" class="theme-portal">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href={PEEK_DEBUGGING_STICKER.src} />
    <link rel="preload" href="/fonts/geist-sans-variable.woff2" as="font" type="font/woff2" crossorigin />
    <title>Sign in</title>
    <style is:global>
      html.theme-portal,
      html.theme-portal body {
        background: hsl(var(--background));
        color: hsl(var(--foreground));
        font-family: var(--font-display);
      }
      html.theme-portal body::before { display: none; }
      .login-shell {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background:
          radial-gradient(circle at 30% 20%, hsl(var(--portal-accent) / 0.06), transparent 60%),
          radial-gradient(circle at 70% 80%, hsl(220 14% 96% / 0.04), transparent 50%),
          hsl(var(--background));
      }
      .login-card {
        width: 100%;
        max-width: 380px;
        padding: 36px 32px;
        border-radius: 14px;
        border: 1px solid hsl(var(--border));
        background: hsl(var(--card));
        box-shadow: 0 30px 80px hsl(0 0% 0% / 0.45);
      }
      .login-mark {
        width: 118px;
        height: 108px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
      }
      .login-mark img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        image-rendering: -webkit-optimize-contrast;
      }
      .login-title {
        margin: 20px 0 6px;
        font-size: 20px;
        font-weight: 600;
        letter-spacing: -0.015em;
        text-align: center;
      }
      .login-button {
        margin-top: 24px;
        display: inline-flex;
        width: 100%;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 12px 14px;
        border-radius: 10px;
        background: hsl(var(--primary));
        color: hsl(var(--primary-foreground));
        font-size: 14px;
        font-weight: 500;
        transition: opacity 0.15s ease;
      }
      .login-button:hover { opacity: 0.9; }
      .login-meta {
        margin-top: 20px;
        font-size: 11px;
        color: hsl(var(--muted-foreground));
        line-height: 1.6;
        text-align: center;
      }
      .login-meta a {
        color: hsl(var(--foreground));
        text-decoration: none;
      }
      .login-meta a:hover {
        text-decoration: underline;
      }
      .login-error {
        margin-top: 16px;
        padding: 10px 12px;
        border-radius: 8px;
        background: hsl(var(--destructive) / 0.12);
        border: 1px solid hsl(var(--destructive) / 0.3);
        color: hsl(0 80% 78%);
        font-size: 12px;
        line-height: 1.5;
      }
    </style>
  </head>
  <body>
    <main class="login-shell">
      <section class="login-card">
        <span class="login-mark">
          <img
            src={PEEK_DEBUGGING_STICKER.src}
            alt=""
            width={PEEK_DEBUGGING_STICKER.width}
            height={PEEK_DEBUGGING_STICKER.height}
            decoding="async"
          />
        </span>
        <h1 class="login-title">Sign in to {signInTarget}</h1>

        {errorMessage && <div class="login-error">{errorMessage}</div>}

        <a class="login-button" href={startUrl}>
          Sign in
        </a>

        <p class="login-meta">This is a protected page. Only approved users may view it. See the <a href="/privacy">Privacy Policy</a> for verification details.</p>
      </section>
    </main>
  </body>
</html>
