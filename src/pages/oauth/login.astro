---
import '@/styles/globals.css';
import { PEEK_DEBUGGING_STICKER } from '@/features/mascot/peek/stickers';

export const prerender = false;

const url = new URL(Astro.request.url);
const next = url.searchParams.get('next') || '/dev/portal';
const error = url.searchParams.get('error');

const errorMessages: Record<string, string> = {
  state: 'Sign-in session expired. Please try again.',
  forbidden: 'Your GitHub account is not allowed to access this portal.',
  token: 'GitHub did not return a valid token. Please try again.',
  user: 'Could not load your GitHub profile. Please try again.',
  config: 'Admin auth is not configured on the server.',
};
const errorMessage = error ? errorMessages[error] ?? 'Sign-in failed. Please try again.' : null;

const startUrl = `/api/admin/auth/start?next=${encodeURIComponent(next)}`;
---

<!doctype html>
<html lang="en" class="theme-portal">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href={PEEK_DEBUGGING_STICKER.src} />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="preload" href="/fonts/geist-sans-variable.woff2" as="font" type="font/woff2" crossorigin />
    <title>Sign in</title>
    <style is:global>
      html.theme-portal,
      html.theme-portal body {
        background: hsl(var(--background));
        color: hsl(var(--foreground));
        font-family: 'Geist', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
      }
      html.theme-portal body::before { display: none; }
      .login-shell {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background:
          radial-gradient(circle at 30% 20%, hsl(var(--portal-accent) / 0.06), transparent 60%),
          radial-gradient(circle at 70% 80%, hsl(220 14% 96% / 0.04), transparent 50%),
          hsl(var(--background));
      }
      .login-card {
        width: 100%;
        max-width: 380px;
        padding: 36px 32px;
        border-radius: 14px;
        border: 1px solid hsl(var(--border));
        background: hsl(var(--card));
        box-shadow: 0 30px 80px hsl(0 0% 0% / 0.45);
      }
      .login-mark {
        width: 118px;
        height: 108px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
      }
      .login-mark img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        image-rendering: -webkit-optimize-contrast;
      }
      .login-title {
        margin: 20px 0 6px;
        font-size: 20px;
        font-weight: 600;
        letter-spacing: -0.015em;
        text-align: center;
      }
      .login-sub {
        font-size: 13px;
        color: hsl(var(--muted-foreground));
        line-height: 1.55;
        text-align: center;
      }
      .login-button {
        margin-top: 24px;
        display: inline-flex;
        width: 100%;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 12px 14px;
        border-radius: 10px;
        background: hsl(var(--primary));
        color: hsl(var(--primary-foreground));
        font-size: 14px;
        font-weight: 500;
        transition: opacity 0.15s ease;
      }
      .login-button:hover { opacity: 0.9; }
      .login-meta {
        margin-top: 20px;
        font-size: 11px;
        color: hsl(var(--muted-foreground));
        line-height: 1.6;
      }
      .login-error {
        margin-top: 16px;
        padding: 10px 12px;
        border-radius: 8px;
        background: hsl(var(--destructive) / 0.12);
        border: 1px solid hsl(var(--destructive) / 0.3);
        color: hsl(0 80% 78%);
        font-size: 12px;
        line-height: 1.5;
      }
    </style>
  </head>
  <body>
    <main class="login-shell">
      <section class="login-card">
        <span class="login-mark">
          <img
            src={PEEK_DEBUGGING_STICKER.src}
            alt=""
            width={PEEK_DEBUGGING_STICKER.width}
            height={PEEK_DEBUGGING_STICKER.height}
            decoding="async"
          />
        </span>
        <h1 class="login-title">Sign in with OAuth</h1>
        <p class="login-sub">Restricted access. GitHub authentication is required for private site surfaces.</p>

        {errorMessage && <div class="login-error">{errorMessage}</div>}

        <a class="login-button" href={startUrl}>
          <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
          </svg>
          Sign in with GitHub
        </a>

        <p class="login-meta">By signing in you agree that your GitHub login is recorded for audit. No other personal data is collected.</p>
      </section>
    </main>
  </body>
</html>
