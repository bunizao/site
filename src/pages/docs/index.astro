---
import Layout from '@/layouts/Layout.astro';
import DocsSidebar from '@/features/docs/ui/DocsSidebar.astro';
import DocsSearch from '@/features/docs/ui/DocsSearch.astro';
import DocsCopyPage from '@/features/docs/ui/DocsCopyPage.astro';
import { docPath, getDocsNav } from '@/features/docs/server/nav';
import { markdownAlternatePath } from '@/features/agent-markdown/server/registry';
import { formatSiteTitle } from '@/lib/seo';
import '@/styles/docs.css';

export const prerender = true;

const groups = await getDocsNav();
const pageCount = groups.reduce((total, group) => total + group.entries.length, 0);

// Three doors, one per kind of reader: someone new to the codebase, someone
// about to write a post, someone about to call an endpoint. The icon is the
// card's only ornament — it gives the three an object each to lead with, which
// a title and two lines of text on their own do not.
const START_HERE = [
  {
    href: '/docs/overview',
    label: 'Overview',
    note: 'What buxx.me is and which surface owns what.',
    icon: '<path d="M3 5.5 9 3l6 2.5L21 3v15.5L15 21l-6-2.5L3 21z"/><path d="M9 3v15.5M15 5.5V21"/>',
  },
  {
    href: '/docs/writing/directives',
    label: 'Directives',
    note: 'The [!name] grammar every post is composed with.',
    icon: '<path d="M8 3H7a2 2 0 0 0-2 2v4a2 2 0 0 1-2 2 2 2 0 0 1 2 2v4a2 2 0 0 0 2 2h1"/><path d="M16 3h1a2 2 0 0 1 2 2v4a2 2 0 0 0 2 2 2 2 0 0 0-2 2v4a2 2 0 0 1-2 2h-1"/>',
  },
  {
    href: '/docs/api/oembed',
    label: 'Embed a mood',
    note: 'oEmbed, the iframe widget, and the postMessage contract.',
    icon: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9.5 10.5 7.5 12l2 1.5M14.5 10.5l2 1.5-2 1.5"/>',
  },
];

const ELSEWHERE = [
  { href: '/blog', label: 'Blog', note: 'Essays and notes — 無人之境' },
  { href: '/mood', label: 'Mood', note: 'The running short-form feed' },
  { href: '/components', label: 'Components', note: 'Installable pieces of this site' },
  { href: '/projects', label: 'Projects', note: 'What I ship, and why' },
  {
    href: 'https://github.com/bunizao/site',
    label: 'Source',
    note: 'This site on GitHub',
    external: true,
  },
];
---

<Layout
  preloadFont={['display', 'sans', 'mono']}
  title={formatSiteTitle('Docs')}
  description="Reference for buxx.me — architecture, the post composing syntax, public API endpoints, and how every surface is built."
  url="/docs"
  navVariant="docs"
>
  <main class="docs docs--hub">
    <div class="docs-shell docs-shell--article docs-shell--hub">
      <DocsSidebar groups={groups} />

      <div class="docs-article">
        <header class="docs-hub-head">
          <div class="docs-article-head">
            <p class="docs-eyebrow"><span>Documentation</span></p>
            <DocsCopyPage markdownPath={markdownAlternatePath('/docs')} />
          </div>
          <h1 class="docs-title">Everything this site does, written down.</h1>
          <p class="docs-lede">
            {pageCount} pages covering how buxx.me is built: the runtime and its
            boundaries, the directive syntax posts are composed with, the public
            endpoints anyone can call, and the rules each surface follows.
          </p>
        </header>

        <section class="docs-hub-section" aria-label="Start here">
          <div class="docs-hub-start">
            {START_HERE.map((item) => (
              <a class="docs-card" href={item.href}>
                <span class="docs-card-head">
                  <svg class="docs-card-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={item.icon} />
                  <svg class="docs-card-arrow" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
                </span>
                <span class="docs-card-title">{item.label}</span>
                <span class="docs-card-desc">{item.note}</span>
              </a>
            ))}
          </div>
        </section>

        {groups.map((group) => (
          <section class="docs-hub-section">
            <div class="docs-hub-section-head">
              <h2 class="docs-hub-section-label">{group.label}</h2>
              <p class="docs-hub-section-blurb">{group.blurb}</p>
            </div>
            <ul class="docs-hub-list">
              {group.entries.map((entry) => (
                <li>
                  <a class="docs-hub-row" href={docPath(entry.id)}>
                    <span class="docs-hub-row-title">
                      {entry.data.title}
                      {entry.data.badge && <span class="docs-nav-badge">{entry.data.badge}</span>}
                    </span>
                    <span class="docs-hub-row-desc">{entry.data.description}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}

        {/* A panel, not a rule. The exits are the one block on the page that is
            not part of the reference, and enclosing them says that without
            hanging another hairline in the gap below the last section. */}
        <section class="docs-hub-elsewhere">
          <h2 class="docs-hub-section-label">Elsewhere</h2>
          <ul class="docs-hub-elsewhere-list">
            {ELSEWHERE.map((item) => (
              <li>
                <a class="docs-hub-elsewhere-link" href={item.href}>
                  <span class="docs-hub-elsewhere-label">
                    {item.label}
                    {item.external && (
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
                    )}
                  </span>
                  <span class="docs-hub-elsewhere-note">{item.note}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </div>
  </main>

  <DocsSearch />
</Layout>
