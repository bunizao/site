---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Footer from '@/features/home/ui/Footer.astro';
import DocsSidebar from '@/features/docs/ui/DocsSidebar.astro';
import DocsToc, { type DocsTocItem } from '@/features/docs/ui/DocsToc.astro';
import { docPath, getDocsNav, getDocsSiblings, type DocsGroup } from '@/features/docs/server/nav';
import { formatSiteTitle } from '@/lib/seo';
import '@/styles/docs.css';

export const prerender = true;

export async function getStaticPaths() {
  const groups = await getDocsNav();
  return groups.flatMap((group) =>
    group.entries.map((entry) => ({
      params: { slug: entry.id },
      props: { entry, groups },
    })),
  );
}

interface Props {
  entry: CollectionEntry<'docs'>;
  groups: DocsGroup[];
}
const { entry, groups } = Astro.props;
const { title, description, group } = entry.data;
const { Content, headings } = await render(entry);

// Two depths. H4 is used inside a directive's own subsections and would turn the
// rail into a second copy of the page.
const toc: DocsTocItem[] = headings
  .filter((heading) => heading.depth === 2 || heading.depth === 3)
  .map((heading) => ({
    id: heading.slug,
    label: heading.text,
    depth: heading.depth as 2 | 3,
  }));

const { prev, next } = getDocsSiblings(groups, entry.id);
---

<Layout
  preloadFont={['display', 'sans', 'mono']}
  title={formatSiteTitle(title)}
  description={description}
  url={docPath(entry.id)}
  navVariant="docs"
>
  <main class="docs docs--article">
    <div class="docs-shell docs-shell--article">
      <DocsSidebar groups={groups} current={entry.id} />

      <article class="docs-article">
        <p class="docs-eyebrow">
          <a href="/docs">Docs</a>
          <span aria-hidden="true">/</span>
          <span>{group}</span>
        </p>
        <h1 class="docs-title">{title}</h1>
        <p class="docs-lede">{description}</p>

        <div class="docs-prose">
          <Content />
        </div>

        <nav class="docs-pager" aria-label="Docs pagination">
          {prev ? (
            <a class="docs-pager-link docs-pager-link--prev" href={docPath(prev.id)} rel="prev">
              <span class="docs-pager-dir">Previous</span>
              <span class="docs-pager-title">{prev.data.title}</span>
            </a>
          ) : <span class="docs-pager-gap"></span>}
          {next && (
            <a class="docs-pager-link docs-pager-link--next" href={docPath(next.id)} rel="next">
              <span class="docs-pager-dir">Next</span>
              <span class="docs-pager-title">{next.data.title}</span>
            </a>
          )}
        </nav>
      </article>

      {toc.length > 1 && <DocsToc items={toc} />}
    </div>
  </main>
  <Footer />
</Layout>
