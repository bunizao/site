---
import type { CollectionEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import DocsArticle from '@/features/docs/ui/DocsArticle.astro';
import { docPath, getDocsNav, type DocsGroup } from '@/features/docs/server/nav';
import { markdownAlternatePath } from '@/features/agent-markdown/server/registry';
import { breadcrumbJsonLd } from '@/lib/seo';

export const prerender = true;

export async function getStaticPaths() {
  const groups = await getDocsNav();
  return groups.flatMap((group) =>
    group.entries.map((entry) => ({
      params: { slug: entry.id },
      props: { entry, groups },
    })),
  );
}

interface Props {
  entry: CollectionEntry<'docs'>;
  groups: DocsGroup[];
}
const { entry, groups } = Astro.props as Props;
const { title, description } = entry.data;
const breadcrumbs = breadcrumbJsonLd([
  { name: 'buxx.me', path: '/' },
  { name: 'Docs', path: '/docs' },
  { name: title, path: docPath(entry.id) },
]);
---

<Layout
  title={title}
  description={description}
  url={docPath(entry.id)}
  image="/docs-og.png"
  imageAlt="Docs — buxx.me/docs"
  navVariant="docs"
  containedScroll
  scrollRestorationKey="docs-scroll"
  structuredData={breadcrumbs}
>
  <DocsArticle entry={entry} groups={groups} markdownPath={markdownAlternatePath(docPath(entry.id))} />
</Layout>
