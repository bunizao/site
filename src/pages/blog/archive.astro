---
import BlogLayout from '@/layouts/BlogLayout.astro';
import BlogLedger from '@/features/posts/ui/BlogLedger.astro';
import BlogSeaFooter from '@/features/posts/ui/BlogSeaFooter.astro';
import BlogYearRail from '@/features/posts/ui/BlogYearRail.astro';
import PostRow from '@/features/posts/ui/PostRow.astro';
import PostHover from '@/features/posts/ui/PostHover.astro';
import {
  getAccessiblePosts,
  getListedPosts,
  groupPostsByYear,
} from '@/features/posts/server/content';
import { writingLedger } from '@/features/posts/ledger';
import { mapOtherLanguages } from '@/features/posts/i18n';
import Footer from '@/features/home/ui/Footer.astro';
import { blog } from '@/data/site';

// Every listed post, year by year, under the same ledger that closes /blog.
const [listedPosts, accessiblePosts] = await Promise.all([
  getListedPosts(),
  getAccessiblePosts({ outputTarget: 'web' }),
]);
const groups = groupPostsByYear(listedPosts);
const ledger = writingLedger(listedPosts);
const otherLanguages = mapOtherLanguages(accessiblePosts);
const t = blog.copy[blog.locale.blog];
---

<BlogLayout title={`${t.ledger.archiveTitle} — ${blog.name}`} path="/blog/archive">
  <header class="blog-archive__head">
    <a class="tag-index__back" href="/blog">{t.back.rail}</a>
    <h1 class="tag-archive__title">{t.ledger.archiveTitle}</h1>
  </header>

  {ledger && <BlogLedger ledger={ledger} archive="" />}

  <BlogYearRail years={groups.map((group) => group.year)} />

  {groups.map((group) => (
    <section class="blog-year" id={`y${group.year}`}>
      <h2 class="blog-year__heading">{group.year}</h2>
      <ul class="blog-list">
        {group.posts.map((post) => (
          <PostRow post={post} otherLanguages={otherLanguages.get(post.slug)} />
        ))}
      </ul>
    </section>
  ))}

  <Footer />

  <BlogSeaFooter />

  <PostHover />
</BlogLayout>
