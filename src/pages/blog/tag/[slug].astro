---
import type { GetStaticPaths } from 'astro';
import BlogLayout from '@/layouts/BlogLayout.astro';
import PostRow from '@/features/posts/ui/PostRow.astro';
import PostHover from '@/features/posts/ui/PostHover.astro';
import {
  getAccessiblePosts,
  getPublicTagDirectory,
  getTagArchive,
  groupPostsByYear,
} from '@/features/posts/server/content';
import { mapOtherLanguages } from '@/features/posts/i18n';

export const getStaticPaths = (async () => {
  const tags = await getPublicTagDirectory();

  return tags.map((tag) => ({ params: { slug: tag.slug } }));
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const archive = await getTagArchive(slug!);

// A public tag with zero posts has no static path, so a miss here is a genuine
// 404 rather than an empty-state to render.
if (!archive) {
  return Astro.redirect('/blog/tags', 302);
}

const { tag, archive: { posts } } = archive;
const groups = groupPostsByYear(posts);
// Without a Ghost description, describe the archive by what is actually in
// it: the count and the two titles that bracket it. Titles are the keywords
// a search snippet should carry; a templated sentence carries none.
const byDate = [...posts].sort((a, b) => a.publishedAt.localeCompare(b.publishedAt));
const oldest = byDate[0];
const latest = byDate[byDate.length - 1];
const archiveDescription = posts.length === 1
  ? `「${tag.name}」下目前只有一篇：《${latest.title}》。`
  : `「${tag.name}」下的 ${posts.length} 篇文字，从《${oldest.title}》到《${latest.title}》。`;
const otherLanguages = mapOtherLanguages(await getAccessiblePosts({ outputTarget: 'web' }));
const accent = tag.accentColor ?? 'var(--blog-accent)';
---

<BlogLayout
  title={`#${tag.name}`}
  description={tag.description ?? archiveDescription}
  path={`/blog/tag/${tag.slug}`}
>
  <header class="tag-archive__head" style={`--tag-accent:${accent}`}>
    <a class="tag-index__back" href="/blog/tags">← All tags</a>
    <h1 class="tag-archive__title">
      <span class="tag-archive__hash" aria-hidden="true">#</span>{tag.name}
    </h1>
    {tag.description && <p class="tag-archive__desc">{tag.description}</p>}
    <p class="tag-archive__count">
      {posts.length} {posts.length === 1 ? 'post' : 'posts'}
    </p>
  </header>

  {groups.map((group) => (
    <section class="blog-year">
      <h2 class="blog-year__heading">{group.year}</h2>
      <ul class="blog-list">
        {group.posts.map((post) => (
          <PostRow post={post} otherLanguages={otherLanguages.get(post.slug)} />
        ))}
      </ul>
    </section>
  ))}

  <PostHover />
</BlogLayout>
