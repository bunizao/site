        <ReactionBar client:idle count={24} reacted={reacted} reactors={reactors} locale={locale} postId={interactive ? 'lab-post' : undefined} />
        <div class="blog-article-sub">
          <SubscribePanel variant="blog" locale={locale} anchor="right" feed={blog.feed} />
          <ShareRow title="少一层，而不是多一层" locale={locale} />
        </div>
      </Colophon>

      <section class="comments-lab-catalog" aria-labelledby="comments-lab-catalog-title">
        <div class="comments-lab-catalog__head">
          <p class="comments-lab-catalog__eyebrow">Interaction inventory</p>
          <h2 id="comments-lab-catalog-title">Every action and its feedback</h2>
          <p>Use this table as the acceptance map for the live thread. Copy is shown in both supported blog locales; “next” records the user’s available recovery or follow-up.</p>
        </div>
        <div class="comments-lab-catalog__table-wrap">
          <table>
            <thead>
              <tr><th scope="col">User behavior</th><th scope="col">UI state</th><th scope="col">中文</th><th scope="col">English</th><th scope="col">Next move</th></tr>
            </thead>
            <tbody>
              {behaviorRows.map((row) => (
                <tr>
                  <th scope="row">{row.behavior}</th>
                  <td><code>{row.state}</code></td>
                  <td>{row.zh}</td>
                  <td>{row.en}</td>
                  <td>{row.next}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="comments-lab-mute" aria-labelledby="comments-lab-mute-title">
        <div class="comments-lab-catalog__head">
          <p class="comments-lab-catalog__eyebrow">Reply alerts</p>
          <h2 id="comments-lab-mute-title">Thread mute states</h2>
          <p>Set <code>?mute=muted|unmuted|invalid</code> for each <code>/reader/mute</code> outcome — the card the reply mail's own mute link opens. It writes on a POST only, so a mail scanner's prefetch can never silence a thread.</p>
        </div>
        <div class="reader-confirm__card" data-state={muteState}>
          <span class="reader-confirm__glyph" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={muteGlyphs[muteState]} /></span>
          {muteState === 'muted' && <><h3 class="reader-confirm__title">{muteCopy.mutedTitle}</h3><p class="reader-confirm__body">{muteCopy.mutedBody}</p><div class="reader-confirm__form"><button type="button" class="reader-confirm__go reader-confirm__go--quiet">{muteCopy.undo}</button></div><a class="reader-confirm__back" href="/reader/confirm">{muteCopy.settings}</a></>}
          {muteState === 'unmuted' && <><h3 class="reader-confirm__title">{muteCopy.unmutedTitle}</h3><p class="reader-confirm__body">{muteCopy.unmutedBody}</p><a class="reader-confirm__back" href="/reader/confirm">{muteCopy.settings}</a></>}
          {muteState === 'invalid' && <><h3 class="reader-confirm__title">{muteCopy.invalidTitle}</h3><p class="reader-confirm__body">{muteCopy.invalidBody}</p><a class="reader-confirm__back" href="/reader/confirm">{muteCopy.settings}</a></>}
        </div>
      </section>

      <section class="comments-lab-verify" aria-labelledby="comments-lab-verify-title">
        <div class="comments-lab-catalog__head">
          <p class="comments-lab-catalog__eyebrow">Email verification</p>
          <h2 id="comments-lab-verify-title">Reader confirmation states</h2>
          <p>Set <code>?verify=pending|confirmed|already|invalid|resent</code> to inspect each real <code>/reader/confirm</code> outcome in this one lab. The live page never rests on <code>pending</code>: it confirms the link on arrival and the button below is the no-JS path.</p>
        </div>
        <div
          class="reader-confirm__card"
          data-state={verifyState}
          data-confirmed-title={verifyCopy.confirmedTitle}
          data-confirmed-body={verifyCopy.confirmedBody}
          data-resent-title={verifyCopy.resentTitle}
          data-resent-body={verifyCopy.resentBody}
        >
          <span class="reader-confirm__glyph" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={verifyGlyphs[verifyState]} /></span>
          {verifyState === 'pending' && <><h3 class="reader-confirm__title">{verifyCopy.pendingTitle}</h3><p class="reader-confirm__body">{verifyCopy.pendingBody}</p><button type="button" class="reader-confirm__go" data-verify-confirm>{verifyCopy.confirm}</button></>}
          {(verifyState === 'confirmed' || verifyState === 'settings') && <><h3 class="reader-confirm__title">{verifyState === 'settings' ? verifyCopy.settingsTitle : verifyCopy.confirmedTitle}</h3><p class="reader-confirm__body">{verifyState === 'settings' ? verifyCopy.settingsBody : verifyCopy.confirmedBody}</p><div class="reader-confirm__prefs"><label class="reader-confirm__switch"><span>{verifyCopy.prefsNotifyReplies}</span><input type="checkbox" role="switch" checked /></label><label class="reader-confirm__switch"><span>{verifyCopy.prefsSubscribe}</span><input type="checkbox" role="switch" /></label></div></>}
          {verifyState === 'already' && <><h3 class="reader-confirm__title">{verifyCopy.alreadyTitle}</h3><p class="reader-confirm__body">{verifyCopy.alreadyBody}</p><a class="reader-confirm__back" href="/blog">{verifyCopy.back}</a></>}
          {verifyState === 'invalid' && <><h3 class="reader-confirm__title">{verifyCopy.invalidTitle}</h3><p class="reader-confirm__body">{verifyCopy.invalidBody}</p><div class="reader-confirm__form"><input class="reader-confirm__input" type="email" placeholder={verifyCopy.emailPlaceholder} aria-label={verifyCopy.emailLabel} /><button type="button" class="reader-confirm__go" data-verify-resend>{verifyCopy.resend}</button></div><a class="reader-confirm__back" href="/">{verifyCopy.home}</a></>}
          {verifyState === 'resent' && <><h3 class="reader-confirm__title">{verifyCopy.resentTitle}</h3><p class="reader-confirm__body">{verifyCopy.resentBody}</p></>}
        </div>
      </section>

      <section class="comments-lab-newsletter" aria-labelledby="comments-lab-newsletter-title">
        <div class="comments-lab-catalog__head">
          <p class="comments-lab-catalog__eyebrow">Comment email</p>
          <h2 id="comments-lab-newsletter-title">Reader verification email</h2>
