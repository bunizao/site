---
// Dev-only harness for the reaction bar and comment thread. The point is the
// CONTEXT: the components render inside a real BlogLayout, a real
// .blog-article-wrap, and a real .blog-prose column, so the measure, greys,
// dark mode, and the hairline they share with .blog-end are all honest.
//
// Query params flip the states worth reviewing side by side:
//   ?state=loaded | loading | empty | error | closed   (thread)
//   ?phase=anonymous | claimed | ready         (reader standing, compose box)
//   ?receipt=submitting | posted | held | nudge | error   (compose receipt)
//   ?more=1  ?moreState=loading                (load-more cursor button)
//   ?reacted=1                                 (filled heart, xia accent)
//   ?requireEmail=1                            (#comments-verified: email required)
//   ?credits=0                                 (colophon with no model credit)
//   ?moderation=idle | busy | success | conflict | error | empty
//
// Own/editing/tombstone/edited comment rows are fixture data below, not query
// params — they are thread content, not a state of the box or the list.
//
// Delete once /blog/[slug] carries the real thing.
import BlogLayout from '@/layouts/BlogLayout.astro';
import TableOfContents from '@/features/posts/ui/TableOfContents.astro';
import ReadingTopbar from '@/features/posts/ui/ReadingTopbar.astro';
import BackToTop from '@/features/posts/ui/BackToTop.astro';
import Footer from '@/features/home/ui/Footer.astro';
import ReactionBar from '@/features/comments/ui/ReactionBar';
import CommentsSection from '@/features/comments/ui/CommentsSection.astro';
import { ICONS } from '@/features/comments/icons';
import ReaderVerifyEmailPreview from '@/features/comments/ui/ReaderVerifyEmailPreview.astro';
import CommentReplyEmailPreview from '@/features/comments/ui/CommentReplyEmailPreview.astro';
import SubscribePanel from '@/features/notify/SubscribePanel.astro';
import Colophon from '@/features/posts/ui/Colophon.astro';
import ShareRow from '@/features/posts/ui/ShareRow.astro';
import { blog } from '@/data/site';
import { commentsCopy } from '@/features/comments/copy';
import { resolveAuthorshipModel } from '@/data/authorship';
import type { AuthorshipCredit } from '@/features/posts/server/directives/authors';
import type { BlogComment, ClaimedIdentity, ComposeReceipt, ReaderPhase, Viewer } from '@/features/comments/types';
import type { CommentErrorCode } from '@/features/comments/comment-error';
import { readerConfirmCopy, readerMuteCopy } from '@/features/comments/reader-confirm-copy';
import '@/features/comments/styles/comments.css';

export const prerender = false;
if (!import.meta.env.DEV && import.meta.env.PUBLIC_STAGING_LABS !== '1') {
  return new Response(null, { status: 404 });
}

const params = Astro.url.searchParams;
const locale = params.get('locale') === 'en' ? 'en' : blog.locale.blog;

const interactive = params.get('interactive') === '1';
const verifyRaw = params.get('verify');
const verifyState = verifyRaw === 'confirmed' || verifyRaw === 'settings' || verifyRaw === 'already' || verifyRaw === 'invalid' || verifyRaw === 'resent'
  ? verifyRaw
  : 'pending';
const verifyCopy = readerConfirmCopy[locale];
const muteRaw = params.get('mute');
const muteState = muteRaw === 'unmuted' || muteRaw === 'invalid' ? muteRaw : 'muted';
const muteCopy = readerMuteCopy[locale];
const muteGlyphs = {
  muted: ICONS.bellOff,
  unmuted: ICONS.bell,
  invalid: ICONS.linkOff,
} as const;
const verifyGlyphs = {
  pending: ICONS.mail,
  confirmed: ICONS.check,
  settings: ICONS.settings,
  already: ICONS.check,
  invalid: ICONS.linkOff,
  resent: ICONS.send,
} as const;

const rawState = params.get('state');
const state =
  rawState === 'loading' || rawState === 'empty' || rawState === 'error' || rawState === 'closed'
    ? rawState
    : 'loaded';

const rawPhase = params.get('phase');
const phase: ReaderPhase = rawPhase === 'claimed' || rawPhase === 'ready' ? rawPhase : 'anonymous';

const rawReceipt = params.get('receipt');
const receipt: ComposeReceipt =
  rawReceipt === 'submitting' || rawReceipt === 'posted' || rawReceipt === 'held'
  || rawReceipt === 'nudge' || rawReceipt === 'error'
    ? rawReceipt
    : 'idle';
const errorCodes: CommentErrorCode[] = ['NET', 'RATE', 'BOT', 'GONE', 'THREAD', 'CLOSED', 'LOCKED', 'VERIFY', 'NAME', 'EMAIL', 'LONG', 'STALE', 'INPUT', 'SERVER'];
const requestedError = params.get('error')?.toUpperCase() as CommentErrorCode | undefined;
const errorCode = requestedError && errorCodes.includes(requestedError) ? requestedError : undefined;

const hasMore = params.get('more') === '1';
const loadMoreState = params.get('moreState') === 'loading' ? 'loading' : 'idle';
const reacted = params.get('reacted') === '1';
// The `#comments-verified` half of the post's comment policy. The other two
// halves are not query params here: `readonly` is `?state=closed`, and `off`
// renders no section at all, which is nothing to review.
const requireEmail = params.get('requireEmail') === '1';
const rawModeration = params.get('moderation');
const moderationState = rawModeration === 'busy' || rawModeration === 'success' || rawModeration === 'conflict'
  || rawModeration === 'error' || rawModeration === 'empty'
  ? rawModeration
  : 'idle';

const viewer: Viewer = { name: 'Tutu Xiao' };
const claimed: ClaimedIdentity = { name: 'Murray', email: 'murray@example.com' };
const draftText = "Might be worth mentioning the rollback plan too — did you keep one on standby, or was cutting it part of the point?";

// Real faces on purpose: a stack of five identical initial-circles reads as one
// grey mass, which is a property of the fixture, not of the design. The shipped
// bar serves reader avatars through the signed static proxy.
const reactors = [
  { name: 'Nina Kato', avatar: 'https://avatars.githubusercontent.com/u/1?s=96' },
  { name: 'Wei Zhang', avatar: 'https://avatars.githubusercontent.com/u/810438?s=96' },
  { name: 'Oskar Lind', avatar: 'https://avatars.githubusercontent.com/u/124599?s=96' },
  { name: 'Priya R', avatar: 'https://avatars.githubusercontent.com/u/1024025?s=96' },
  { name: 'Tom Beck' },
];

// Nearly every post credits a model, so the harness renders one: the colophon
// has to be judged with its provenance line present, not in the rare state.
// `?credits=0` shows the creditless post.
const showCredits = params.get('credits') !== '0';
const creditModel = resolveAuthorshipModel('anthropic/claude-opus-4-6');
const authorshipCredits: AuthorshipCredit[] =
  showCredits && creditModel
    ? [{ model: creditModel, note: '读了三版草稿，指出第二节在重复第一节' }]
    : [];

const editWindowSoon = Date.now() + 8 * 60 * 1000 + 24 * 1000; // ~8:24 left, for the countdown

// Fixture timestamps come off the same table the thread does, so the page is
// readable in one language at a time. Hardcoded strings left the rows dated in
// Chinese while every label around them was English, which is exactly the kind
// of drift this page exists to catch.
const t = commentsCopy[locale];

const behaviorRows = [
