        </div>
        <div class="blog-compose comments-lab-preview__compose" data-locale={locale}>
          <div class="blog-compose__box">
            <label class="sr-only" for="lab-markdown-preview">{t.bodyLabel}</label>
            <textarea id="lab-markdown-preview" class="blog-compose__field" rows="5">The **preview** uses the same `comment-markdown.ts` renderer.

> Edit this text to inspect every supported form.</textarea>
          </div>
        </div>
      </section>

      <section class="comments-lab-moderation" aria-labelledby="comments-lab-moderation-title" data-state={moderationState}>
        <div class="comments-lab-catalog__head">
          <p class="comments-lab-catalog__eyebrow">Owner moderation</p>
          <h2 id="comments-lab-moderation-title">Queue action states</h2>
          <p>Set <code>?moderation=idle|busy|success|conflict|error|empty</code> to inspect the owner side of the comment lifecycle.</p>
        </div>
        <div class="comments-lab-moderation__surface">
          {moderationState === 'success' && <p class="comments-lab-moderation__receipt">Nina Kato's comment published.</p>}
          {moderationState === 'conflict' && <p class="comments-lab-moderation__error" role="alert">Already handled somewhere else. Reload to see where it went.</p>}
          {moderationState === 'error' && <p class="comments-lab-moderation__error" role="alert">The moderation request failed. Try again.</p>}
          {moderationState === 'empty' ? (
            <div class="comments-lab-moderation__empty"><strong>Nothing is waiting for review</strong><span>Held comments appear here when the automatic pass is unsure.</span></div>
          ) : (
            <article class="comments-lab-moderation__row">
              <div><strong>Nina Kato</strong><span>held · verified</span></div>
              <p>The rollback paragraph is useful, but the link at the end needs a human look.</p>
              <small>promotional · Akismet marked this for review</small>
              <div class="comments-lab-moderation__actions">
                <button type="button" disabled={moderationState === 'busy'}>{moderationState === 'busy' ? 'Working…' : 'Approve'}</button>
                <button type="button" disabled={moderationState === 'busy'}>Delete</button>
              </div>
            </article>
          )}
        </div>
      </section>

      <CommentsSection
        comments={comments}
        state={interactive ? 'loading' : state}
        locale={locale}
        phase={phase}
        viewer={viewer}
        claimed={claimed}
        receipt={receipt}
        draftText={draftText}
        hasMore={hasMore}
        loadMoreState={loadMoreState}
        postId={interactive ? 'lab-post' : undefined}
        errorCode={errorCode}
        requireEmail={requireEmail}
      />

      {(receipt === 'submitting' || receipt === 'posted' || receipt === 'held' || receipt === 'nudge' || receipt === 'error') && (
        <aside class="comments-lab-receipt" aria-live="polite">
          <strong>Receipt probe: <code>{receipt}</code></strong>
          {receipt === 'submitting' && <span>The send control is busy while the request is in flight; the draft stays in the field.</span>}
          {receipt === 'posted' && <span>The new comment row is the success confirmation; no duplicate banner is shown.</span>}
          {receipt === 'held' && <span>The row remains visible only to its writer until moderation settles.</span>}
          {receipt === 'nudge' && <span>The verification offer is actionable below the compose box.</span>}
          {receipt === 'error' && <span>The alert above the compose box carries the selected failure copy and code.</span>}
        </aside>
      )}
    </article>
  </div>

  <footer class="blog-end">
    <span class="blog-comment__date">Prev / next sits here</span>
  </footer>


  <Footer />
  <BackToTop />
</BlogLayout>

<script>
  import { initCommentsController } from '@/features/comments/client/comments-controller';
  initCommentsController();

  const verifyCard = document.querySelector<HTMLElement>('.comments-lab-verify .reader-confirm__card');
  const showVerifyResult = (title: string, body: string) => {
    if (!verifyCard) return;
    const heading = document.createElement('h3');
    heading.className = 'reader-confirm__title';
    heading.textContent = title;
    const message = document.createElement('p');
    message.className = 'reader-confirm__body';
    message.textContent = body;
    verifyCard.replaceChildren(heading, message);
  };
  verifyCard?.querySelector('[data-verify-confirm]')?.addEventListener('click', () => {
    verifyCard.dataset.state = 'confirmed';
    showVerifyResult(verifyCard.dataset.confirmedTitle ?? '', verifyCard.dataset.confirmedBody ?? '');
  });
  verifyCard?.querySelector('[data-verify-resend]')?.addEventListener('click', () => {
    verifyCard.dataset.state = 'resent';
    showVerifyResult(verifyCard.dataset.resentTitle ?? '', verifyCard.dataset.resentBody ?? '');
  });
</script>

