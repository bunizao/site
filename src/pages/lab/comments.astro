  { behavior: 'Format the active selection', state: 'Markdown shortcut', zh: '⌘/Ctrl+B 粗体 · I 斜体 · E 行内代码 · K 链接', en: '⌘/Ctrl+B bold · I italic · E inline code · K link', next: 'Keep typing; the preview updates immediately' },
  { behavior: 'Remembered identity', state: 'phase=claimed', zh: commentsCopy.zh.claimedAs('Murray'), en: commentsCopy.en.claimedAs('Murray'), next: commentsCopy.zh.signOut },
  { behavior: 'Verified identity', state: 'phase=ready', zh: commentsCopy.zh.postingAs('Tutu Xiao'), en: commentsCopy.en.postingAs('Tutu Xiao'), next: 'Post as the verified reader' },
