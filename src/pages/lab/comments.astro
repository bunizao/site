  { behavior: 'Edit opens', state: 'editing', zh: `${commentsCopy.zh.edit} · ${commentsCopy.zh.timeLeft('8:24')}`, en: `${commentsCopy.en.edit} · ${commentsCopy.en.timeLeft('8:24')}`, next: 'Save or Cancel' },
