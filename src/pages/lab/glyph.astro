---
// Design lab: a faint monospace rain field confined to a band at the top of
// the page, with a pointer glow that lights the glyphs it passes over.
//
// Mechanic ported from aiforui.dev's MatrixRain: per-column falling heads that
// leave decaying trails over a static floor, plus a separate glow channel the
// pointer paints into. Adapted achromatic — the reference shifts hue for the
// glow, this site has no hue to shift, so the glow carries on alpha alone.
//
// Standalone document on purpose — it must not inherit the site's own
// background layers, or the concepts would be judged on top of the thing they
// are meant to replace.
export const prerender = false;

// Dev-only surface. It is a design scratchpad, not a public page.
if (!import.meta.env.DEV) {
  return new Response(null, { status: 404 });
}
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex, nofollow" />
<title>Collapsar Glyph Lab</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" />
</head>
<body>
<style is:inline>
  /* ── Tokens: lifted verbatim from src/styles/globals.css so every concept is
       judged against the real ground, not a flattering approximation. ── */
  :root {
    --ground: #ffffff;
    --fg: #000000;
    --fg-rgb: 0 0 0;
    --muted: #666666;
    --faint: rgba(0, 0, 0, 0.45);
    --grid: rgba(0, 0, 0, 0.12);
    --hair: rgba(0, 0, 0, 0.14);
    --chip: rgba(0, 0, 0, 0.045);
    --chip-on: #000000;
    --chip-on-fg: #ffffff;
    --dock: rgba(255, 255, 255, 0.88);

    --mono: 'Geist Mono', 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    --col: 720px;
    --ease: cubic-bezier(0.2, 0, 0, 1);
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --ground: #0a0a0a;
      --fg: #ffffff;
      --fg-rgb: 255 255 255;
      --muted: #878787;
      --faint: rgba(255, 255, 255, 0.42);
      --grid: rgba(255, 255, 255, 0.10);
      --hair: rgba(255, 255, 255, 0.13);
      --chip: rgba(255, 255, 255, 0.06);
      --chip-on: #ffffff;
      --chip-on-fg: #000000;
      --dock: rgba(10, 10, 10, 0.88);
    }
  }

  :root[data-theme="dark"] {
    --ground: #0a0a0a;
    --fg: #ffffff;
    --fg-rgb: 255 255 255;
    --muted: #878787;
    --faint: rgba(255, 255, 255, 0.42);
    --grid: rgba(255, 255, 255, 0.10);
    --hair: rgba(255, 255, 255, 0.13);
    --chip: rgba(255, 255, 255, 0.06);
    --chip-on: #ffffff;
    --chip-on-fg: #000000;
    --dock: rgba(10, 10, 10, 0.88);
  }

  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

  body {
    margin: 0;
    background: var(--ground);
    color: var(--fg);
    font-family: var(--mono);
    font-size: 14px;
    line-height: 1.625;
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
  }

  /* ── Background layers ───────────────────────────────────────────────── */

  /* The field is a band pinned to the top of the document, not the viewport:
     it belongs to the hero, and scrolling should carry it away. */
  .field {
    position: absolute;
    inset: 0 0 auto 0;
    display: flex;
    justify-content: center;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  .field canvas {
    display: block;
    flex: 0 0 auto;
    /* Two gradients intersected: the field fades out downward before it
       reaches the copy, and inward from both edges so it never ends on a
       visible vertical seam. */
    -webkit-mask-image:
      linear-gradient(to bottom, #000 50%, transparent 96%),
      linear-gradient(to right, transparent, #000 18%, #000 82%, transparent);
    mask-image:
      linear-gradient(to bottom, #000 50%, transparent 96%),
      linear-gradient(to right, transparent, #000 18%, #000 82%, transparent);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }
  body[data-concept="current"] .field { display: none; }

  .dots {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    display: none;
    background-image: radial-gradient(circle, var(--grid) 1px, transparent 1px);
    background-size: 24px 24px;
  }
  body[data-concept="current"] .dots { display: block; }

  /* ── Content mock: real hero copy, real column width, real type ─────── */

  .stage { position: relative; z-index: 1; transition: opacity 200ms var(--ease); }
  body[data-bare="1"] .stage { opacity: 0; }

  .col { max-width: var(--col); margin-inline: auto; padding-inline: 1rem; }

  .hero {
    min-height: calc(100svh - 120px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 5rem;
    padding-bottom: 8rem;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .status i { width: 7px; height: 7px; background: var(--fg); display: block; }

  h1 {
    font-size: 36px;
    font-weight: 700;
    letter-spacing: -0.025em;
    margin: 0 0 0.5rem;
    line-height: 1.2;
  }

  .chips { font-size: 12px; color: var(--faint); letter-spacing: 0.08em; margin: 0 0 0.75rem; }
  .role { font-size: 14px; color: var(--muted); margin: 0 0 1.5rem; }
  .bio { font-size: 15px; line-height: 1.7; color: var(--muted); margin: 0; }
  .bio b { color: var(--fg); font-weight: 400; }

  .socials {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    font-size: 14px;
  }
  .socials span:first-child { color: var(--muted); }
  .socials a { color: var(--fg); text-decoration: none; border-bottom: 1px solid transparent; }
  .socials a:hover, .socials a:focus-visible { border-bottom-color: var(--fg); outline: none; }

  .band { padding: 4rem 0; border-top: 1px solid var(--grid); }
  .band h2 {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 0 0 1.5rem;
    font-weight: 500;
  }
  .rows { display: flex; flex-direction: column; gap: 1px; }
  .row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--grid);
    font-size: 14px;
  }
  .row span:last-child { color: var(--muted); font-variant-numeric: tabular-nums; }

  .tail {
    padding: 5rem 0 8rem;
    color: var(--faint);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* ── Dock ────────────────────────────────────────────────────────────── */

  .dock {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 10;
    background: var(--dock);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    border-top: 1px solid var(--hair);
  }
  .dock-inner {
    max-width: 1180px;
    margin-inline: auto;
    padding: 0.75rem 1rem 1rem;
    display: grid;
    gap: 0.7rem;
  }

  .tabs { display: flex; gap: 0.375rem; overflow-x: auto; scrollbar-width: none; }
  .tabs::-webkit-scrollbar { display: none; }
  .tab {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.4rem 0.7rem;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--muted);
    background: var(--chip);
    border: 1px solid transparent;
    border-radius: 6px;
    cursor: pointer;
    white-space: nowrap;
    transition: color 130ms var(--ease), background 130ms var(--ease);
  }
  .tab:hover { color: var(--fg); }
  .tab:focus-visible { outline: 2px solid var(--fg); outline-offset: 2px; }
  .tab em { font-style: normal; opacity: 0.55; font-variant-numeric: tabular-nums; }
  .tab[aria-selected="true"] { background: var(--chip-on); color: var(--chip-on-fg); }
  .tab[aria-selected="true"] em { opacity: 0.6; }

  .thesis { margin: 0; font-size: 13px; line-height: 1.6; color: var(--muted); max-width: 94ch; }
  .thesis strong { color: var(--fg); font-weight: 600; }

  .rack {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.5rem 1rem;
    border-top: 1px solid var(--hair);
    padding-top: 0.7rem;
  }
  .knob { display: grid; gap: 0.25rem; min-width: 0; }
  .knob > label {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .knob > label b { color: var(--fg); font-weight: 500; font-variant-numeric: tabular-nums; }

  .knob input[type="range"] {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 14px;
    background: transparent;
    cursor: pointer;
    margin: 0;
  }
  .knob input[type="range"]::-webkit-slider-runnable-track { height: 2px; background: var(--hair); }
  .knob input[type="range"]::-moz-range-track { height: 2px; background: var(--hair); }
  .knob input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 10px; height: 10px;
    border-radius: 50%;
    background: var(--fg);
    margin-top: -4px;
  }
  .knob input[type="range"]::-moz-range-thumb {
    width: 10px; height: 10px; border: 0; border-radius: 50%; background: var(--fg);
  }
  .knob input:focus-visible { outline: 2px solid var(--fg); outline-offset: 3px; }

  .seg { display: flex; gap: 2px; flex-wrap: wrap; }
  .seg button {
    flex: 1 1 auto;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.3rem 0.25rem;
    color: var(--muted);
    background: var(--chip);
    border: 1px solid transparent;
    border-radius: 4px;
    cursor: pointer;
    white-space: nowrap;
  }
  .seg button:hover { color: var(--fg); }
  .seg button:focus-visible { outline: 2px solid var(--fg); outline-offset: 2px; }
  .seg button[aria-pressed="true"] { background: var(--chip-on); color: var(--chip-on-fg); }

  .controls {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 10;
    display: flex;
    gap: 0.375rem;
  }
  .ctl {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.4rem 0.6rem;
    color: var(--muted);
    background: var(--dock);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--hair);
    border-radius: 6px;
    cursor: pointer;
  }
  .ctl:hover { color: var(--fg); }
  .ctl:focus-visible { outline: 2px solid var(--fg); outline-offset: 2px; }

  .hint {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 10;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
    pointer-events: none;
  }

  @media (max-width: 860px) {
    .stage { padding-bottom: 32rem; }
    h1 { font-size: 28px; }
    .bio { font-size: 14px; }
    .hint { display: none; }
  }
</style>

<div class="field" aria-hidden="true"><canvas id="glyphs"></canvas></div>
<div class="dots" aria-hidden="true"></div>

<p class="hint">1–5 switch · T theme · H hide content</p>

<div class="controls">
  <button class="ctl" id="theme-btn" type="button">Theme</button>
  <button class="ctl" id="bare-btn" type="button">Hide content</button>
</div>

<div class="stage">
  <div class="col">
    <header class="hero">
      <div class="status"><i></i><span>Learning</span></div>
      <h1>Collapsar_</h1>
      <p class="chips">18 y.o. · INFP · Libra</p>
      <p class="role">Student / Developer / Blogger</p>
      <p class="bio">
        I make interesting things.<br>
        Curious about <b>frontend design</b>, <b>proxy systems</b>, and contributing to <b>open source</b>.<br>
        Obsessed with <b>speed</b> and always asking how things can be <b>smaller</b>.<br>
        Outside of coding, I read for curiosity and write to make sense of things.<br>
        Currently studying Computer Science at <b>Monash University</b>.
      </p>
      <nav class="socials">
        <span>Find me at</span>
        <a href="#projects">Blog</a>
        <a href="#projects">GitHub</a>
        <a href="#projects">Email</a>
        <a href="#projects">Telegram</a>
        <a href="#projects">Instagram</a>
      </nav>
    </header>

    <section class="band" id="projects">
      <h2>Projects</h2>
      <div class="rows">
        <div class="row"><span>BroadcastChannel</span><span>Astro · Telegram</span></div>
        <div class="row"><span>site-api</span><span>Workers · D1</span></div>
        <div class="row"><span>buxx.me</span><span>Astro v7 · React</span></div>
      </div>
    </section>

    <section class="band">
      <h2>Experience</h2>
      <div class="rows">
        <div class="row"><span>Monash University</span><span>2025 —</span></div>
        <div class="row"><span>Open source</span><span>3602 contributions</span></div>
      </div>
    </section>

    <p class="tail">Move the pointer across the band — the glyphs light under it.</p>
  </div>
</div>

<div class="dock">
  <div class="dock-inner">
    <div class="tabs" role="tablist" id="tabs" aria-label="Glyph field concepts"></div>
    <p class="thesis" id="thesis"></p>

    <div class="rack">
      <div class="knob">
        <label for="k-height">Band <b id="v-height">400px</b></label>
        <input id="k-height" type="range" autocomplete="off" min="200" max="900" step="10" value="400" />
      </div>
      <div class="knob">
        <label for="k-width">Width <b id="v-width">1200px</b></label>
        <input id="k-width" type="range" autocomplete="off" min="600" max="1800" step="20" value="1200" />
      </div>
      <div class="knob">
        <label for="k-font">Type <b id="v-font">12px</b></label>
        <input id="k-font" type="range" autocomplete="off" min="8" max="20" step="1" value="12" />
      </div>
      <div class="knob">
        <label for="k-speed">Fall <b id="v-speed">1.00&times;</b></label>
        <input id="k-speed" type="range" autocomplete="off" min="0" max="200" step="5" value="100" />
      </div>
      <div class="knob">
        <label for="k-head">Head <b id="v-head">62%</b></label>
        <input id="k-head" type="range" autocomplete="off" min="10" max="100" step="1" value="62" />
      </div>
      <div class="knob">
        <label for="k-trail">Trail <b id="v-trail">0.940</b></label>
        <input id="k-trail" type="range" autocomplete="off" min="700" max="990" step="2" value="940" />
      </div>
      <div class="knob">
        <label for="k-glowr">Glow r <b id="v-glowr">88px</b></label>
        <input id="k-glowr" type="range" autocomplete="off" min="0" max="220" step="2" value="88" />
      </div>
      <div class="knob">
        <label for="k-glow">Glow ink <b id="v-glow">100%</b></label>
        <input id="k-glow" type="range" autocomplete="off" min="10" max="100" step="1" value="100" />
      </div>
      <div class="knob">
        <label>Glyphs <b id="v-set">code</b></label>
        <div class="seg" id="seg-set"></div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
(() => {
  'use strict';

  const root = document.documentElement;
  const body = document.body;
  const canvas = document.getElementById('glyphs');
  const fieldEl = document.querySelector('.field');
  const ctx = canvas.getContext('2d');
  const tabsEl = document.getElementById('tabs');
  const thesisEl = document.getElementById('thesis');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  const SETS = {
    code:    'CLPSAR01<>=+*-#$',
    symbols: '<>/=+-*#$|~^?!;:._',
    hex:     '0123456789ABCDEF',
    binary:  '01',
    braille: '⠁⠂⠄⠈⠐⠠⡀⢀⠃⠅⠘⠨⠰⣀⠇⠋',
  };
  const SET_NAMES = Object.keys(SETS);

  const CONCEPTS = [
    {
      id: 'current', no: '01', name: 'Current', field: false,
      thesis: 'What ships today: a 24px dot lattice across the whole viewport. Here as the A/B — switch away and back.',
    },
    {
      id: 'rain', no: '02', name: 'Rain', field: true,
      p: { height: 400, width: 1200, font: 12, speed: 100, head: 62, trail: 940, glowr: 88, glow: 100, set: 'code' },
      thesis: 'The reference mechanic, achromatic. Each column drops a bright <strong>head</strong> that leaves a trail decaying toward a per-cell floor, so the field is mostly static haze with movement running through it. The pointer paints a second channel that lights whatever it passes over — <strong>brighter and heavier</strong>, since an achromatic field has no hue to shift.',
    },
    {
      id: 'drift', no: '03', name: 'Drift', field: true,
      p: { height: 720, width: 1280, font: 12, speed: 35, head: 52, trail: 972, glowr: 104, glow: 96, set: 'code' },
      thesis: 'Slower fall, much longer trails, band deep enough to hold the whole hero. The motion stops reading as rain and starts reading as <strong>slow vertical weather</strong> — you notice it only if you look for it.',
    },
    {
      id: 'column', no: '04', name: 'Column', field: true,
      p: { height: 560, width: 760, font: 11, speed: 80, head: 58, trail: 950, glowr: 76, glow: 98, set: 'code' },
      thesis: 'Field narrowed to the <strong>720px text column</strong>. It stops being wallpaper and becomes a property of the column itself — the same move as a margin note.',
    },
    {
      id: 'ember', no: '05', name: 'Ember', field: true,
      p: { height: 460, width: 1200, font: 12, speed: 0, head: 62, trail: 940, glowr: 120, glow: 100, set: 'code' },
      thesis: 'No rain at all. The field rests at its floor and the <strong>pointer is the only light source</strong> — glyphs bloom under the cursor and fade behind it. An untouched page runs zero frames.',
    },
  ];

  const state = {
    concept: CONCEPTS[1],
    height: 400, width: 1200, font: 12, speed: 100,
    head: 62, trail: 940, glowr: 88, glow: 100, set: 'code',
  };

  /* ── Field ────────────────────────────────────────────────────────────── */

  const TICK_MS = 90;        // ~11fps, same as the reference
  const GLOW_DECAY = 0.82;

  let columns = [];
  let colCount = 0, rowCount = 0, colW = 0, rowH = 0;
  let fg = '0 0 0';
  let gain = 0.6;

  const pick = () => {
    const set = SETS[state.set];
    return set[(Math.random() * set.length) | 0];
  };

  function readTheme() {
    fg = getComputedStyle(root).getPropertyValue('--fg-rgb').trim() || '0 0 0';
    // Light ink on a dark ground carries further than dark ink on white, so the
    // same nominal alpha reads hotter. The reference handles this with
    // `opacity-60 dark:opacity-50`; same ratio, applied per glyph.
    gain = fg.startsWith('255') ? 0.5 : 0.6;
  }

  // A column restarts above the band with a fresh speed. Its extent and
  // brightness only re-roll occasionally, so a column keeps a recognisable
  // character across several passes instead of flickering between them.
  function respawn(col, initial) {
    col.head = initial ? Math.random() * rowCount * 2 : -Math.random() * rowCount * 1.5;
    col.speed = 0.25 + 0.75 * Math.random();
    if (initial || Math.random() < 0.2) {
      col.maxRow = Math.floor(rowCount * (0.35 + 0.65 * Math.random()));
      col.brightness = 0.5 + 0.5 * Math.random();
    }
  }

  function build() {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const w = state.width;
    const h = state.height;

    fieldEl.style.height = h + 'px';
    canvas.style.width = w + 'px';
    canvas.style.height = h + 'px';
    canvas.width = Math.round(w * dpr);
    canvas.height = Math.round(h * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    ctx.font = state.font + "px 'Geist Mono', ui-monospace, monospace";
    // Columns sit 70% wider than a glyph, so the rain reads as discrete
    // streaks rather than as solid text.
    colW = 1.7 * ctx.measureText('0').width;
    rowH = Math.round(state.font * 1.333);
    colCount = Math.ceil(w / colW);
    rowCount = Math.ceil(h / rowH);

    columns = Array.from({ length: colCount }, () => {
      const col = {
        chars: Array.from({ length: rowCount }, pick),
        alphas: new Float32Array(rowCount),
        floors: new Float32Array(rowCount),
        glows: new Float32Array(rowCount),
        head: 0, speed: 0, maxRow: 0, brightness: 1,
      };
      for (let r = 0; r < rowCount; r++) {
        col.floors[r] = 0.04 + 0.08 * Math.random();
        col.alphas[r] = col.floors[r];
      }
      respawn(col, true);
      return col;
    });

    // Run the simulation forward before the first paint so the band opens
    // mid-flow instead of visibly filling in.
    for (let i = 0; i < rowCount * 4; i++) step();
    paint();
  }

  function step() {
    const head = state.head / 100;
    const trail = state.trail / 1000;
    const rate = state.speed / 100;
    const falling = rate > 0;

    for (const col of columns) {
      if (falling) col.head += col.speed * rate;
      const at = Math.floor(col.head);

      for (let r = 0; r <= col.maxRow; r++) {
        if (col.alphas[r] > 0) col.alphas[r] = Math.max(col.alphas[r] * trail, col.floors[r]);
      }
      if (falling && at >= 0 && at <= col.maxRow && at < rowCount) col.alphas[at] = head;

      for (let r = 0; r < rowCount; r++) {
        if (col.glows[r] > 0) col.glows[r] = col.glows[r] < 0.03 ? 0 : col.glows[r] * GLOW_DECAY;
      }

      if (Math.random() < 0.4) col.chars[(Math.random() * rowCount) | 0] = pick();
      if (falling && at > col.maxRow + 4) respawn(col, false);
    }
  }

  const GLOW_WEIGHT = 600;
  const lit = [];   // cells the pointer is lighting, drawn in a second pass

  function paint() {
    ctx.clearRect(0, 0, state.width, state.height);
    ctx.textBaseline = 'top';
    ctx.fillStyle = 'rgb(' + fg + ')';
    ctx.font = state.font + "px 'Geist Mono', ui-monospace, monospace";
    lit.length = 0;

    for (let c = 0; c < colCount; c++) {
      const col = columns[c];
      const x = c * colW;
      for (let r = 0; r < rowCount; r++) {
        const rain = col.alphas[r] * col.brightness;
        const glow = col.glows[r];
        // Defer the glow-dominant cells so the weight switch happens once per
        // frame instead of once per glyph.
        if (glow > rain) { lit.push(x, r * rowH, col.chars[r], glow * gain); continue; }
        if (rain * gain < 0.012) continue;
        ctx.globalAlpha = rain * gain;
        ctx.fillText(col.chars[r], x, r * rowH);
      }
    }

    if (lit.length) {
      ctx.font = GLOW_WEIGHT + ' ' + state.font + "px 'Geist Mono', ui-monospace, monospace";
      for (let i = 0; i < lit.length; i += 4) {
        ctx.globalAlpha = lit[i + 3];
        ctx.fillText(lit[i + 2], lit[i], lit[i + 1]);
      }
    }
    ctx.globalAlpha = 1;
  }

  /* ── Pointer glow ─────────────────────────────────────────────────────── */

  let glowQueued = false;

  function onPointerMove(event) {
    const radius = state.glowr;
    if (!radius || !columns.length || !state.concept.field) return;

    const box = canvas.getBoundingClientRect();
    const x = event.clientX - box.left;
    const y = event.clientY - box.top;
    if (x < -radius || x > state.width + radius) return;
    if (y < -radius || y > state.height + radius) return;

    const c0 = Math.max(0, Math.floor((x - radius) / colW));
    const c1 = Math.min(colCount - 1, Math.ceil((x + radius) / colW));
    const r0 = Math.max(0, Math.floor((y - radius) / rowH));
    const r1 = Math.min(rowCount - 1, Math.ceil((y + radius) / rowH));
    const peak = state.glow / 100;

    for (let c = c0; c <= c1; c++) {
      const col = columns[c];
      const dx = c * colW + colW / 2 - x;
      for (let r = r0; r <= r1; r++) {
        const d = Math.hypot(dx, r * rowH + rowH / 2 - y);
        if (d > radius) continue;
        const g = peak * Math.pow(1 - d / radius, 1.5);
        if (g > col.glows[r]) col.glows[r] = g;
      }
    }

    // Repaint on the next frame rather than per event — a fast pointer fires
    // far more often than the display can show it.
    if (glowQueued) return;
    glowQueued = true;
    requestAnimationFrame(() => { glowQueued = false; paint(); });
  }

  // Ember has no rain, so nothing decays its glow back down. Idle it down on
  // its own clock instead of leaving the last smear burnt into the field.
  let emberTimer = 0;
  function emberFade() {
    clearInterval(emberTimer);
    emberTimer = window.setInterval(() => {
      if (state.speed > 0 || !state.concept.field) return;
      let lit = false;
      for (const col of columns) {
        for (let r = 0; r < rowCount; r++) {
          if (col.glows[r] <= 0) continue;
          col.glows[r] = col.glows[r] < 0.03 ? 0 : col.glows[r] * GLOW_DECAY;
          lit = true;
        }
      }
      if (lit) paint();
    }, TICK_MS);
  }

  /* ── Frame loop — visibility gated ────────────────────────────────────── */

  let raf = 0, last = 0, running = false, onScreen = true;

  const shouldRun = () =>
    state.concept.field && state.speed > 0 && onScreen
    && document.visibilityState === 'visible' && !reduced.matches;

  function frame(now) {
    raf = requestAnimationFrame(frame);
    if (now - last < TICK_MS) return;
    last = now;
    step();
    paint();
  }

  function sync() {
    if (shouldRun()) {
      if (running) return;
      running = true;
      last = performance.now();
      raf = requestAnimationFrame(frame);
    } else {
      running = false;
      cancelAnimationFrame(raf);
      raf = 0;
    }
  }

  document.addEventListener('visibilitychange', sync);
  reduced.addEventListener('change', sync);
  window.addEventListener('pointermove', onPointerMove, { passive: true });

  // The field only exists at the top of the document, so stop the moment it
  // scrolls away rather than simulating rows nobody can see.
  new IntersectionObserver((entries) => {
    onScreen = entries[0].isIntersecting;
    sync();
  }, { rootMargin: '64px' }).observe(fieldEl);

  let resizeTimer = 0;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => { build(); sync(); }, 120);
  }, { passive: true });

  /* ── Dock ─────────────────────────────────────────────────────────────── */

  const el = (id) => document.getElementById(id);
  const KNOBS = [
    ['height', 'k-height', 'v-height', (v) => v + 'px'],
    ['width', 'k-width', 'v-width', (v) => v + 'px'],
    ['font', 'k-font', 'v-font', (v) => v + 'px'],
    ['speed', 'k-speed', 'v-speed', (v) => (v / 100).toFixed(2) + '×'],
    ['head', 'k-head', 'v-head', (v) => v + '%'],
    ['trail', 'k-trail', 'v-trail', (v) => (v / 1000).toFixed(3)],
    ['glowr', 'k-glowr', 'v-glowr', (v) => v + 'px'],
    ['glow', 'k-glow', 'v-glow', (v) => v + '%'],
  ];
  // Only geometry needs the field rebuilt; the rest feed the running simulation.
  const GEOMETRY = new Set(['height', 'width', 'font']);

  const segSet = el('seg-set');

  function paintRack() {
    for (const [key, ki, vi, fmt] of KNOBS) {
      el(ki).value = String(state[key]);
      el(vi).textContent = fmt(state[key]);
    }
    el('v-set').textContent = state.set;
    for (const b of segSet.children) b.setAttribute('aria-pressed', String(b.dataset.v === state.set));
  }

  for (const [key, ki] of KNOBS) {
    el(ki).addEventListener('input', () => {
      state[key] = Number(el(ki).value);
      paintRack();
      if (GEOMETRY.has(key)) build(); else paint();
      sync();
    });
  }

  for (const id of SET_NAMES) {
    const b = document.createElement('button');
    b.type = 'button';
    b.dataset.v = id;
    b.textContent = id;
    b.setAttribute('aria-pressed', 'false');
    b.addEventListener('click', () => { state.set = id; paintRack(); build(); sync(); });
    segSet.appendChild(b);
  }

  function applyConcept(c) {
    state.concept = c;
    body.dataset.concept = c.id;
    if (c.p) Object.assign(state, c.p);
    thesisEl.innerHTML = c.thesis;
    for (const t of tabsEl.children) t.setAttribute('aria-selected', String(t.dataset.id === c.id));
    paintRack();
    if (c.field) build();
    sync();
  }

  for (const c of CONCEPTS) {
    const t = document.createElement('button');
    t.type = 'button';
    t.className = 'tab';
    t.role = 'tab';
    t.dataset.id = c.id;
    t.setAttribute('aria-selected', 'false');
    t.innerHTML = '<em>' + c.no + '</em>' + c.name;
    t.addEventListener('click', () => applyConcept(c));
    tabsEl.appendChild(t);
  }

  el('theme-btn').addEventListener('click', () => {
    root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    readTheme();
    paint();
  });
  el('bare-btn').addEventListener('click', () => {
    body.dataset.bare = body.dataset.bare === '1' ? '0' : '1';
  });

  window.addEventListener('keydown', (e) => {
    if (e.target instanceof HTMLInputElement) return;
    const n = Number(e.key);
    if (n >= 1 && n <= CONCEPTS.length) return applyConcept(CONCEPTS[n - 1]);
    if (e.key === 't' || e.key === 'T') return el('theme-btn').click();
    if (e.key === 'h' || e.key === 'H') return el('bare-btn').click();
  });

  // Geist Mono arrives async and the column advance is measured from it — a
  // field built against the fallback face has the wrong pitch.
  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(() => { build(); sync(); });
  }

  readTheme();
  applyConcept(CONCEPTS[1]);
  emberFade();
})();
</script>

</body>
</html>
