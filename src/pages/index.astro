---
import Layout from '../layouts/Layout.astro';
import Hero from '@/features/home/ui/Hero.astro';
import Projects from '@/features/home/ui/Projects.astro';
import Posts from '@/features/home/ui/Posts.astro';
import HomePreview from '@/features/mood/ui/HomePreview.astro';
import Footer from '@/features/home/ui/Footer.astro';
import ParallaxWrapper from '../components/ParallaxWrapper.astro';

const title = "Bunizao's Website";
const description = "I make interesting things. Curious about frontend design, proxy systems, and open-source work. Obsessed with speed, optimization, and building things better.";
---

<Layout title={title} description={description}>
  <ParallaxWrapper>
    <main class="page-container">
      <Hero />
      <Projects />
      <Posts />
      <HomePreview />
      <Footer />
    </main>
  </ParallaxWrapper>
</Layout>
