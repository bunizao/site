---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import Posts from '../components/Posts.astro';
import Moods from '../components/Moods.astro';
import Footer from '../components/Footer.astro';
import ParallaxWrapper from '../components/ParallaxWrapper.astro';

const title = "Bunizao's Website";
const description = "I make interesting things. Curious about frontend design, proxy systems, and open-source work. Obsessed with speed, optimization, and building things better.";
---

<Layout title={title} description={description}>
  <ParallaxWrapper>
    <main class="page-container">
      <Hero />
      <Projects />
      <Posts />
      <Moods />
      <Footer />
    </main>
  </ParallaxWrapper>
</Layout>
