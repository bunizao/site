---
import Layout from '../layouts/Layout.astro';
import Hero from '@/features/home/ui/Hero.astro';
import ParallaxWrapper from '@/features/home/ui/ParallaxWrapper.astro';
import Projects from '@/features/home/ui/Projects.astro';
import Posts from '@/features/home/ui/Posts.astro';
import HomePreview from '@/features/mood/ui/HomePreview.astro';
import Footer from '@/features/home/ui/Footer.astro';
import { getCurrentListeningTrack } from '@/features/home/server/listening';
import { loadMoodChannelSnapshot } from '@/features/mood/server/channel-service';
import { buildMoodFeedResponse } from '@/features/mood/server/feed-service';
import { isE2ESiteFixtureEnabled } from '@/lib/e2e';

export const prerender = false;

const title = "Bunizao's Website";
const description = "I make interesting things. Curious about frontend design, proxy systems, and open-source work. Obsessed with speed, optimization, and building things better.";
const useClientRealtimeFixtures = isE2ESiteFixtureEnabled(Astro.locals);

const loadInitialMoodPreview = async () => {
  try {
    const { channelInfo, posts } = await loadMoodChannelSnapshot({
      request: Astro.request,
      locals: Astro.locals,
    });
    const response = await buildMoodFeedResponse(
      {
        request: Astro.request,
        locals: Astro.locals,
      },
      channelInfo,
      posts.slice(0, 5)
    );
    return response.posts;
  } catch (error) {
    console.warn('Failed to load initial mood preview:', error);
    return [];
  }
};

const [listeningResult, initialMoodPosts] = await Promise.all([
  useClientRealtimeFixtures
    ? Promise.resolve(null)
    : getCurrentListeningTrack(Astro.locals).catch((error) => {
        console.warn('Failed to load initial listening track:', error);
        return null;
      }),
  useClientRealtimeFixtures ? Promise.resolve([]) : loadInitialMoodPreview(),
]);
---

<Layout title={title} description={description}>
  <ParallaxWrapper>
    <main class="page-container">
      <Hero listeningTrack={listeningResult?.track} />
      <Projects />
      <Posts />
      <HomePreview initialPosts={initialMoodPosts} />
      <Footer />
    </main>
  </ParallaxWrapper>
</Layout>
