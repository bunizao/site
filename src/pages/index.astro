---
import Layout from '../layouts/Layout.astro';
import Hero from '@/features/home/ui/Hero.astro';
import GlyphField from '@/features/home/ui/GlyphField.astro';
import ParallaxWrapper from '@/features/home/ui/ParallaxWrapper.astro';
import Experience from '@/features/home/ui/Experience.astro';
import Projects from '@/features/home/ui/Projects.astro';
import Posts from '@/features/home/ui/Posts.astro';
import HomePreview from '@/features/mood/ui/HomePreview.astro';
import Footer from '@/features/home/ui/Footer.astro';
import { profileJsonLd, siteDescription, websiteJsonLd } from '@/lib/seo';
import { meta, sections } from '@/data/site';
import '@/styles/home-type.css';
import '@/styles/home-reveal.css';

const title = meta.homeTitle;
const description = siteDescription;
const isHomeDevSurface = process.env.DEV_SURFACE === 'home';
---

<Layout
  title={title}
  description={description}
  navVariant="home"
  structuredData={[websiteJsonLd, profileJsonLd]}
>
  <ParallaxWrapper>
    <GlyphField />
    <main class="page-container">
      {sections.hero && <Hero />}
      {sections.projects && <Projects />}
      {sections.experience && <Experience />}
      {sections.posts && <Posts />}
      {sections.mood && <HomePreview runtimeDisabled={isHomeDevSurface} />}
      {sections.footer && <Footer />}
    </main>
  </ParallaxWrapper>
</Layout>

<style>
  /* The glyph field is the homepage's texture, so the site-wide dot lattice
     and its pointer spotlight stand down here. Page-scoped on purpose: every
     other page keeps both. */
  :global(body::before),
  :global(.spotlight-overlay) {
    display: none;
  }

  .page-container {
    /* Homepage code labels are below the fold; reuse the already-preloaded mono face here. */
    --font-code: var(--font-mono);
    position: relative;
    z-index: 1;
  }

  /* No `content-visibility` on the sections. They measure 284-629px against a
     720px reservation, so every one of them collapsed the document by hundreds
     of pixels as it materialised — the scroll position got clamped mid-gesture
     and reveal triggers were left pointing at stale offsets. The sections are
     small enough that skipping their layout was never worth that. The footer
     keeps it: it is last, so a late size correction has nothing below it to
     disturb, and its reservation now matches its real height. */
  :global(.page-container > footer) {
    content-visibility: auto;
    contain-intrinsic-size: auto 210px;
  }
</style>

{/* Arms the reveal before first paint, so the hidden state is never painted
    visible and then snapped away. The timer is the failsafe: if the reveal
    module never claims the page, the hide is lifted and the content appears
    anyway. See src/lib/home-reveal.ts. */}
<script is:inline>
  document.documentElement.classList.add('reveal-ready');
  setTimeout(function () {
    if (!document.documentElement.dataset.revealActive) {
      document.documentElement.classList.remove('reveal-ready');
    }
  }, 1500);
</script>

<script>
  import { initHomeReveal } from '@/lib/home-reveal';

  // Runs as soon as the DOM is parsed. The old chain waited on `window.load`,
  // which Safari holds until every lazy image and poster settles — sections sat
  // at opacity 0 for seconds before their reveal could even be scheduled.
  initHomeReveal();

  // View transitions swap the DOM without re-running module scripts.
  document.addEventListener('astro:page-load', initHomeReveal);
</script>
