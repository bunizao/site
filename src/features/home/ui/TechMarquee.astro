---
interface Props {
  row1: string[];
  row2: string[];
}

const { row1, row2 } = Astro.props;
const duplicatedRow1 = [...row1, ...row1, ...row1];
const duplicatedRow2 = [...row2, ...row2, ...row2];
---

<div class="tech-marquee">
  <div class="marquee-row">
    <div class="marquee-track left">
      {duplicatedRow1.map((item) => (
        <span class="tech-item">{item}</span>
      ))}
    </div>
  </div>
  <div class="marquee-row">
    <div class="marquee-track right">
      {duplicatedRow2.map((item) => (
        <span class="tech-item">{item}</span>
      ))}
    </div>
  </div>
</div>

<style>
  .tech-marquee {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
  }

  @media (min-width: 640px) {
    .tech-marquee {
      gap: 8px;
    }
  }

  .marquee-row {
    overflow: hidden;
    mask-image: linear-gradient(
      to right,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
  }

  /* Spacing is a trailing margin on every item, not a flex gap. With a gap
     the track is three copies plus two gaps short of three full periods, so
     the -33.33% keyframe fell a third of a gap short of one copy and the row
     hopped by a few pixels every time the loop wrapped. */
  .marquee-track {
    display: flex;
    width: max-content;
  }

  /* Half the old speed. At 25s the rows drifted fast enough to pull the eye
     off the bio above them; this is ambient, not something to read along. */
  .marquee-track.left {
    animation: scroll-left 50s linear infinite;
  }

  .marquee-track.right {
    animation: scroll-right 50s linear infinite;
  }

  .tech-item {
    margin-right: 1.5rem;
    font-size: var(--home-text-label);
    font-weight: var(--home-weight-label);
    color: var(--home-fg-secondary);
    white-space: nowrap;
    letter-spacing: 0.02em;
  }

  @media (min-width: 640px) {
    .tech-item {
      margin-right: 2rem;
    }
  }

  @keyframes scroll-left {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-33.33%);
    }
  }

  @keyframes scroll-right {
    from {
      transform: translateX(-33.33%);
    }
    to {
      transform: translateX(0);
    }
  }

  /* Pause on hover only where hover is real. On touch a tap fires a synthetic
     hover and freezes the marquee until the user taps elsewhere. */
  @media (hover: hover) and (pointer: fine) {
    .tech-marquee:hover .marquee-track {
      animation-play-state: paused;
    }
  }

  /* Continuous horizontal drift is the one motion pattern that reliably
     triggers vestibular symptoms. Reduced motion parks both tracks; the list
     stays fully readable because the row is tripled, so resting at
     translateX(0) lands on a copy boundary rather than mid-word. */
  @media (prefers-reduced-motion: reduce) {
    .marquee-track.left,
    .marquee-track.right {
      animation: none;
    }
  }
</style>
