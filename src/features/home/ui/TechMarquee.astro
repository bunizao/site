---
interface Props {
  row1: string[];
  row2: string[];
}

const { row1, row2 } = Astro.props;
const duplicatedRow1 = [...row1, ...row1, ...row1];
const duplicatedRow2 = [...row2, ...row2, ...row2];
---

<div class="tech-marquee">
  <div class="marquee-row">
    <div class="marquee-track left">
      {duplicatedRow1.map((item) => (
        <span class="tech-item">{item}</span>
      ))}
    </div>
  </div>
  <div class="marquee-row">
    <div class="marquee-track right">
      {duplicatedRow2.map((item) => (
        <span class="tech-item">{item}</span>
      ))}
    </div>
  </div>
</div>

<style>
  .tech-marquee {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
  }

  @media (min-width: 640px) {
    .tech-marquee {
      gap: 8px;
    }
  }

  .marquee-row {
    overflow: hidden;
    mask-image: linear-gradient(
      to right,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
  }

  .marquee-track {
    display: flex;
    gap: 1.5rem;
    width: max-content;
  }

  @media (min-width: 640px) {
    .marquee-track {
      gap: 2rem;
    }
  }

  .marquee-track.left {
    animation: scroll-left 25s linear infinite;
  }

  .marquee-track.right {
    animation: scroll-right 25s linear infinite;
  }

  .tech-item {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 360;
    font-variation-settings: 'opsz' 14, 'SOFT' 100, 'WONK' 1;
    font-size: 14px;
    color: hsl(var(--muted-foreground) / 0.55);
    white-space: nowrap;
    letter-spacing: 0;
  }

  @media (min-width: 640px) {
    .tech-item {
      font-size: 15px;
    }
  }

  .tech-item::before {
    content: '·';
    margin-right: 1.6rem;
    opacity: 0.35;
    font-style: normal;
    color: hsl(var(--muted-foreground) / 0.4);
  }

  @keyframes scroll-left {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-33.33%);
    }
  }

  @keyframes scroll-right {
    from {
      transform: translateX(-33.33%);
    }
    to {
      transform: translateX(0);
    }
  }

  .tech-marquee:hover .marquee-track {
    animation-play-state: paused;
  }
</style>
