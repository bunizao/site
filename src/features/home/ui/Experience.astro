const CLAUDE_PATH =
  'm4.7144 15.9555 4.7174-2.6471.079-.2307-.079-.1275h-.2307l-.7893-.0486-2.6956-.0729-2.3375-.0971-2.2646-.1214-.5707-.1215-.5343-.7042.0546-.3522.4797-.3218.686.0608 1.5179.1032 2.2767.1578 1.6514.0972 2.4468.255h.3886l.0546-.1579-.1336-.0971-.1032-.0972L6.973 9.8356l-2.55-1.6879-1.3356-.9714-.7225-.4918-.3643-.4614-.1578-1.0078.6557-.7225.8803.0607.2246.0607.8925.686 1.9064 1.4754 2.4893 1.8336.3643.3035.1457-.1032.0182-.0728-.164-.2733-1.3539-2.4467-1.445-2.4893-.6435-1.032-.17-.6194c-.0607-.255-.1032-.4674-.1032-.7285L6.287.1335 6.6997 0l.9957.1336.419.3642.6192 1.4147 1.0018 2.2282 1.5543 3.0296.4553.8985.2429.8318.091.255h.1579v-.1457l.1275-1.706.2368-2.0947.2307-2.6957.0789-.7589.3764-.9107.7468-.4918.5828.2793.4797.686-.0668.4433-.2853 1.8517-.5586 2.9021-.3643 1.9429h.2125l.2429-.2429.9835-1.3053 1.6514-2.0643.7286-.8196.85-.9046.5464-.4311h1.0321l.759 1.1293-.34 1.1657-1.0625 1.3478-.8804 1.1414-1.2628 1.7-.7893 1.36.0729.1093.1882-.0183 2.8535-.607 1.5421-.2794 1.8396-.3157.8318.3886.091.3946-.3278.8075-1.967.4857-2.3072.4614-3.4364.8136-.0425.0304.0486.0607 1.5482.1457.6618.0364h1.621l3.0175.2247.7892.522.4736.6376-.079.4857-1.2142.6193-1.6393-.3886-3.825-.9107-1.3113-.3279h-.1822v.1093l1.0929 1.0686 2.0035 1.8092 2.5075 2.3314.1275.5768-.3218.4554-.34-.0486-2.2039-1.6575-.85-.7468-1.9246-1.621h-.1275v.17l.4432.6496 2.3436 3.5214.1214 1.0807-.17.3521-.6071.2125-.6679-.1214-1.3721-1.9246L14.38 17.959l-1.1414-1.9428-.1397.079-.674 7.2552-.3156.3703-.7286.2793-.6071-.4614-.3218-.7468.3218-1.4753.3886-1.9246.3157-1.53.2853-1.9004.17-.6314-.0121-.0425-.1397.0182-1.4328 1.9672-2.1796 2.9446-1.7243 1.8456-.4128.164-.7164-.3704.0667-.6618.4008-.5889 2.386-3.0357 1.4389-1.882.929-1.0868-.0062-.1579h-.0546l-6.3385 4.1164-1.1293.1457-.4857-.4554.0608-.7467.2307-.2429 1.9064-1.3114Z';
---

<section id="experience-section" class="experience-section" data-parallax="off">
  <span class="section-label scroll-reveal">Experience</span>

  <ol class="thread">
    {experiences.map((item, index) => (
      <li class="thread-row scroll-reveal-item" style={`--item-index: ${index}`}>
        <span class="thread-node" aria-hidden="true">
          {item.glyph === 'monash' ? (
            <GraduationCap className="thread-glyph" strokeWidth={1.8} />
          ) : (
            <svg class="thread-glyph" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
              <path d={item.glyph === 'openai' ? OPENAI_PATH : CLAUDE_PATH} />
            </svg>
          )}
        </span>

        <div class="thread-content">
          <span class="thread-head">
            <a href={item.url} target="_blank" rel="noopener noreferrer" class="thread-org">
              {item.org}
            </a>
            {item.current && (
              <span class="thread-ping" aria-label="Current">
                <span class="thread-ping-wave"></span>
                <span class="thread-ping-dot"></span>
              </span>
            )}
          </span>
          <span class="thread-role">{item.role}</span>
        </div>

        <span class="thread-period">{item.period}</span>
      </li>
    ))}
  </ol>
</section>

<style>
  .thread {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .thread-row {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 16px 0;
  }

  /* The continuous rail: each row contributes a segment; first and last are
     trimmed to the node centre so the line begins and ends on a node. */
  .thread-row::before {
    content: '';
    position: absolute;
    left: 17px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: hsl(var(--foreground) / 0.12);
  }

  .thread-row:first-child::before {
    top: 34px;
  }

  .thread-row:last-child::before {
    bottom: auto;
    height: 34px;
  }

  .thread-node {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 11px;
    background: hsl(var(--card));
    border: 1px solid hsl(var(--foreground) / 0.14);
    color: hsl(var(--foreground) / 0.82);
    /* Background ring punches a clean gap in the rail, so the node reads as
       pinned on the thread rather than crossed by it. */
    box-shadow: 0 0 0 3px hsl(var(--background)), 0 1px 2px hsl(var(--foreground) / 0.06);
  }

  .thread-node :global(.thread-glyph) {
    width: 17px;
    height: 17px;
  }

  .thread-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: 1px;
  }

  .thread-head {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .thread-org {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: hsl(var(--foreground));
    width: fit-content;
    transition: opacity 0.15s ease;
  }

  .thread-org:hover {
    opacity: 0.6;
  }

  .thread-role {
    font-size: 13px;
    line-height: 1.4;
    color: hsl(var(--muted-foreground));
  }

  .thread-period {
    flex-shrink: 0;
    padding-top: 3px;
    font-size: 12px;
    font-weight: 300;
    line-height: 1.4;
    color: hsl(var(--muted-foreground) / 0.6);
    font-variant-numeric: tabular-nums;
  }

  /* Pulsing "currently here" marker — monochrome, no hue accent. */
  .thread-ping {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 7px;
    height: 7px;
  }

  .thread-ping-dot {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: hsl(var(--foreground) / 0.55);
  }

  .thread-ping-wave {
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: hsl(var(--foreground) / 0.4);
    animation: thread-ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes thread-ping {
    0% { transform: scale(1); opacity: 0.5; }
    75%, 100% { transform: scale(2.4); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .thread-ping-wave { animation: none; }
  }

  @media (max-width: 480px) {
    .thread-period {
      /* Drop under the role on narrow screens instead of crowding the node. */
      width: 100%;
      padding-top: 4px;
      padding-left: 50px;
    }

    .thread-row {
      flex-wrap: wrap;
    }
  }
</style>

<script>
  const experienceSection = document.getElementById('experience-section');
  let gsapPromise: Promise<typeof import('gsap')['default']> | null = null;

  const loadGsap = async (): Promise<typeof import('gsap')['default']> => {
    gsapPromise ??= Promise.all([
      import('gsap'),
      import('gsap/ScrollTrigger'),
    ]).then(([{ default: gsap }, { ScrollTrigger }]) => {
      gsap.registerPlugin(ScrollTrigger);
      return gsap;
    });

    return gsapPromise;
  };

  const initExperience = async () => {
    const gsap = await loadGsap();
    if (!experienceSection) return;

    gsap.set(experienceSection, { opacity: 0, y: 40 });
    const label = experienceSection.querySelector('.scroll-reveal');
    const items = Array.from(experienceSection.querySelectorAll('.scroll-reveal-item'));
    if (label) gsap.set(label, { opacity: 0, y: 16 });
    if (items.length) gsap.set(items, { opacity: 0, x: -20 });

    const tl = gsap.timeline({
      scrollTrigger: { trigger: experienceSection, start: 'top 85%', once: true }
    });

    tl.to(experienceSection, { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' });
    if (label) tl.to(label, { opacity: 1, y: 0, duration: 0.4, ease: 'power2.out' }, '-=0.3');
    if (items.length) tl.to(items, { opacity: 1, x: 0, duration: 0.4, ease: 'power2.out', stagger: 0.08 }, '-=0.2');
  };

  if (experienceSection) {
    window.addEventListener('load', () => { void initExperience(); }, { once: true });
  }
</script>
