---
import { GraduationCap } from 'lucide-react';

interface ExperienceItem {
  org: string;
  role: string;
  period: string;
  url: string;
  /** Brand mark drawn inside the timeline node. */
  glyph: 'monash' | 'openai' | 'claude';
  /** Pulsing dot — reserved for the one role that's genuinely current. */
  current?: boolean;
}

const experiences: ExperienceItem[] = [
  {
    org: 'Monash University',
    role: 'Data Science (Honours)',
    period: 'Jul 2025 — Present',
    url: 'https://www.monash.edu',
    glyph: 'monash',
    current: true
  },
  {
    org: 'ChatGPT',
    role: 'Subscriber',
    period: '2023 — Present',
    url: 'https://chatgpt.com',
    glyph: 'openai'
  },
  {
    org: 'Claude',
    role: 'Subscriber',
    period: '2026 — Present',
    url: 'https://claude.ai',
    glyph: 'claude'
  }
];

// Monochrome brand marks (Simple Icons), rendered in currentColor so they
// inherit the node's foreground tone in both themes.
