---
import Typewriter from '@/features/home/ui/Typewriter.astro';
import GitHubContributions from '@/features/home/ui/GitHubContributions.astro';
import Listening from '@/features/home/ui/Listening.astro';
import TechMarquee from '@/features/home/ui/TechMarquee.astro';
import {Instagram, type LucideIcon} from 'lucide-react';
import { FileText, Github, Mail, Send } from 'lucide-react';
import type { ListeningTrack } from '@/features/home/server/listening';

interface Props {
  listeningTrack?: ListeningTrack;
}

const { listeningTrack } = Astro.props;

const socials: Array<{
  name: string;
  url: string;
  icon: LucideIcon;
  description: string;
  handle: string;
}> = [
  {
    name: 'Blog',
    url: 'https://blog.buxx.me',
    icon: FileText,
    description: 'Read my articles',
    handle: 'blog.buxx.me'
  },
  {
    name: 'GitHub',
    url: 'https://tuu.cat/gh',
    icon: Github,
    description: 'Check out my code',
    handle: '@bunizao'
  },
  {
    name: 'Email',
    url: 'mailto:me@buxx.me',
    icon: Mail,
    description: 'Send me a message',
    handle: 'me@buxx.me'
  },
  {
    name: 'Telegram',
    url: 'https://tuu.cat/tg',
    icon: Send,
    description: 'Chat with me',
    handle: 'tuu.cat/tg'
  },
  {
    name: 'Instagram',
    url: 'https://tuu.cat/ig',
    icon: Instagram,
    description: 'See my photos',
    handle: 'tuu.cat/ig'
  }
];

const tech = ['TypeScript', 'JavaScript', 'Python', 'C#', 'C++', 'React', 'TailwindCSS', 'Astro', 'Frontend', 'BGP', 'Proxy', 'Docker', 'Linux', 'Web3', 'Optimization'];
---

<header class="hero-section pb-8 sm:pb-12">
    <!-- Status indicator -->
    <div class="hero-animate" data-hero-status>
      <div class="status mb-5">
        <span class="status-text-wrapper">
          <span class="status-text" id="status-text">currently wondering</span>
        </span>
      </div>
    </div>

    <!-- Name -->
    <h1 class="hero-animate hero-name" data-hero-name>
      <Typewriter texts={["Lucian", "Bunizao", "Tutu", "Collapsar"]} speed={80} />
    </h1>

    <!-- Identity line -->
    <div class="hero-animate hero-identity" data-hero-info>
      <p class="hero-identity-line">
        <span class="hero-identity-roles">Student, Developer, Blogger</span>
        <span class="hero-identity-sep" aria-hidden="true"></span>
        <span class="hero-identity-meta">18 · INFP · Libra</span>
      </p>
    </div>

    <!-- Bio -->
    <div class="hero-animate" data-hero-bio>
      <p class="hero-bio">
        I make interesting things — curious about <em>frontend design</em> and <em>proxy systems</em>, obsessed with making things faster.
      </p>
      <p class="hero-bio hero-bio-aside">
        Outside of coding, I read for curiosity and write to make sense of things. Currently studying Computer Science at Monash University.
      </p>
    </div>

    <!-- Social Links -->
    <div class="mt-7 flex flex-wrap items-center gap-3 hero-animate sm:mt-9" data-hero-motion data-hero-socials>
      {socials.map((social) => (
        <div class="social-link-wrapper">
          <div class="magnetic-button" data-magnetic data-strength="0.4">
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="contact-link"
              title={social.name}
            >
              <social.icon className="h-4 w-4" aria-hidden="true" />
              <span class="hidden sm:inline">{social.name}</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <div class="hero-animate mt-6 sm:mt-7" data-hero-motion data-hero-listening>
      <Listening track={listeningTrack} />
    </div>

    <!-- GitHub Activity -->
    <div class="hero-animate" data-hero-motion data-hero-github>
      <GitHubContributions />
    </div>

    <!-- Tech Stack Marquee -->
    <div class="mt-6 hero-animate" data-hero-motion data-hero-tech>
      <TechMarquee items={tech} />
    </div>
</header>

<style>
  .hero-section {
    min-height: calc(100vh - 120px);
    min-height: calc(100svh - 120px);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    position: relative;
    padding-top: calc(env(safe-area-inset-top, 0px) + 7rem);
  }

  @media (min-width: 640px) {
    .hero-section {
      min-height: auto;
      padding-top: 8rem;
    }
  }

  :global(html.js) .hero-animate {
    opacity: 0;
    transform: translateY(20px);
    will-change: opacity, transform;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .hero-animate {
      opacity: 1;
      transform: none;
    }
  }

  .hero-name {
    margin: 0 0 18px;
    font-family: var(--font-display);
    font-size: clamp(56px, 9vw, 88px);
    font-weight: 360;
    font-variation-settings: 'opsz' 144, 'SOFT' 100, 'WONK' 0;
    letter-spacing: -0.04em;
    line-height: 0.96;
    color: hsl(var(--foreground));
  }

  .hero-identity {
    margin: 0 0 30px;
  }

  .hero-identity-line {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    margin: 0;
    font-size: 13px;
    line-height: 1.4;
  }

  .hero-identity-roles {
    color: hsl(var(--foreground) / 0.85);
    letter-spacing: 0.005em;
  }

  .hero-identity-sep {
    width: 14px;
    height: 1px;
    background: hsl(var(--foreground) / 0.18);
  }

  .hero-identity-meta {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground) / 0.55);
  }

  .hero-bio {
    margin: 0;
    font-size: 15px;
    line-height: 1.7;
    color: hsl(var(--foreground));
    letter-spacing: 0.01em;
    max-width: 52ch;
  }

  .hero-bio + .hero-bio {
    margin-top: 8px;
  }

  @media (min-width: 640px) {
    .hero-bio {
      font-size: 16px;
    }
  }

  .hero-bio em {
    font-family: inherit;
    font-style: normal;
    font-weight: 600;
    color: hsl(var(--foreground));
    background-image: linear-gradient(
      to bottom,
      transparent 62%,
      hsl(var(--foreground) / 0.18) 62%,
      hsl(var(--foreground) / 0.18) 86%,
      transparent 86%
    );
    background-repeat: no-repeat;
    background-size: 100% 100%;
    padding: 0 1px;
    transition: background-size 0.3s ease;
  }

  .hero-bio em:hover {
    background-image: linear-gradient(
      to bottom,
      transparent 62%,
      hsl(var(--foreground) / 0.32) 62%,
      hsl(var(--foreground) / 0.32) 86%,
      transparent 86%
    );
  }

  .hero-bio-aside {
    color: hsl(var(--muted-foreground));
  }

  .hero-socials-label {
    flex: none;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground) / 0.65);
  }

  .status-text-wrapper {
    display: inline-block;
    height: 1.2em;
    line-height: 1.2em;
    overflow: hidden;
    vertical-align: middle;
    position: relative;
  }

  .status-text {
    display: inline-block;
    line-height: 1.2em;
  }

  /* Hidden SVG filter container */
  .liquid-glass-filters {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* Social Links with Dropdown Details */
  .social-link-wrapper {
    position: relative;
    display: inline-block;
  }

  .magnetic-button {
    display: inline-flex;
    align-items: center;
  }

</style>

<script>
  const prefersReducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
  const heroElements = document.querySelectorAll('.hero-animate');
  const statusText = document.getElementById('status-text');

  // Status text rotation
  const statusWords = [
    'currently wondering',
    'currently building',
    'currently learning',
    'currently exploring',
    'currently creating',
    'currently thinking',
    'currently coding',
    'currently designing',
    'currently reading',
    'currently writing',
    'currently debugging',
    'currently shipping',
    'currently dreaming',
    'currently hacking',
    'currently optimizing',
    'currently iterating',
    'currently refactoring',
    'currently brewing',
    'currently crafting',
    'currently tinkering',
    'currently pondering',
    'currently researching',
    'currently prototyping',
    'currently deploying',
    'currently solving'
  ];

  const initHero = async () => {
    if (!heroElements.length) return;
    const { default: gsap } = await import('gsap');

    // Set initial states
    gsap.set(heroElements, { opacity: 0, y: 20 });

    // Create master timeline for hero section
    const heroTl = gsap.timeline({
      defaults: { ease: 'power3.out' }
    });

    // Animate each element with stagger
    heroTl.to(heroElements, {
      opacity: 1,
      y: 0,
      duration: 0.6,
      stagger: 0.1
    });

    const magneticButtons = document.querySelectorAll('[data-magnetic]');
    magneticButtons.forEach((button) => {
      const element = button as HTMLElement;
      const strength = Number.parseFloat(element.getAttribute('data-strength') || '0.3');
      const quickX = gsap.quickTo(element, 'x', {
        duration: 0.3,
        ease: 'power2.out'
      });
      const quickY = gsap.quickTo(element, 'y', {
        duration: 0.3,
        ease: 'power2.out'
      });
      let bounds: DOMRect | null = null;

      const updateBounds = () => {
        bounds = element.getBoundingClientRect();
      };

      const handlePointerEnter = (event: PointerEvent) => {
        if (event.pointerType && event.pointerType !== 'mouse') return;
        updateBounds();
      };

      const handlePointerMove = (event: PointerEvent) => {
        if (event.pointerType && event.pointerType !== 'mouse') return;
        if (!bounds) {
          updateBounds();
        }
        if (!bounds) return;

        const { left, top, width, height } = bounds;
        const centerX = left + width / 2;
        const centerY = top + height / 2;

        const deltaX = (event.clientX - centerX) * strength;
        const deltaY = (event.clientY - centerY) * strength;

        quickX(deltaX);
        quickY(deltaY);
      };

      const handlePointerLeave = (event: PointerEvent) => {
        if (event.pointerType && event.pointerType !== 'mouse') return;
        bounds = null;
        gsap.to(element, {
          x: 0,
          y: 0,
          duration: 0.5,
          ease: 'elastic.out(1, 0.3)'
        });
      };

      element.style.willChange = 'transform';
      element.addEventListener('pointerenter', handlePointerEnter, { passive: true });
      element.addEventListener('pointermove', handlePointerMove, { passive: true });
      element.addEventListener('pointerleave', handlePointerLeave, { passive: true });
    });

    if (statusText) {
      let currentIndex = 0;

      const rotateStatus = () => {
        // Animate out
        gsap.to(statusText, {
          y: '-120%',
          opacity: 0,
          duration: 0.3,
          ease: 'power2.in',
          onComplete: () => {
            currentIndex = (currentIndex + 1) % statusWords.length;
            statusText.textContent = statusWords[currentIndex];

            // Reset position and animate in
            gsap.fromTo(statusText,
              { y: '120%', opacity: 0 },
              { y: '0%', opacity: 1, duration: 0.3, ease: 'power2.out' }
            );
          }
        });
      };

      // Start rotation after hero animation completes
      heroTl.call(() => {
        setInterval(rotateStatus, 3000);
      });
    }
  };

  if (!prefersReducedMotion) {
    void initHero();
  }
</script>
