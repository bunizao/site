---
import Typewriter from '@/features/home/ui/Typewriter.astro';
import DecodeText from '@/features/home/ui/DecodeText.astro';
import GitHubContributions from '@/features/home/ui/GitHubContributions.astro';
import Listening from '@/features/home/ui/Listening.astro';
import TechMarquee from '@/features/home/ui/TechMarquee.astro';
import type { ListeningTrack } from '@/features/home/types';
import { hero, tech, profile } from '@/data/site';

interface Props {
  listeningTrack?: ListeningTrack;
}

const { listeningTrack } = Astro.props;

const { socials, typewriterNames, infoChips, bio } = hero;
const lcpAnchorName = typewriterNames.reduce(
  (longest, name) => (name.length > longest.length ? name : longest),
  typewriterNames[0] ?? '',
);

// Split each bio line on the `**` highlight marker: odd chunks are emphasized.
const bioLines = bio.map((line) => line.split('**'));
---

<header class="hero-section pb-8 sm:pb-12" data-hero>
    <!-- Status indicator -->
    <div class="hero-animate" style="--hero-i: 0" data-hero-status data-status-words={JSON.stringify(hero.statusWords)}>
      <div class="status mb-4">
        <span class="status-dot"></span>
        <span class="status-text-wrapper">
          <span class="status-text" id="status-text">{hero.statusWords[0]}</span>
        </span>
      </div>
    </div>

    <!-- Name -->
    <div class="hero-name-shell mb-2 text-[28px] font-semibold sm:text-[36px]">
      <span class="hero-lcp-anchor" aria-hidden="true">{lcpAnchorName}</span>
      <h1 class="hero-animate m-0" style="--hero-i: 1" data-hero-name>
        <Typewriter texts={typewriterNames} keystrokeMs={90} />
      </h1>
    </div>

    <!-- Personal Info -->
    <div class="hero-animate mb-4" style="--hero-i: 2" data-hero-info>
      <p class="text-xs text-muted-foreground/70 tracking-wider font-mono">
        <span class="inline-flex items-center gap-2">
          {infoChips.map((chip, i) => (
            <>
              {i > 0 && <span class="separator">•</span>}
              <span>{chip}</span>
            </>
          ))}
        </span>
      </p>
    </div>

    <!-- Role -->
    <p class="hero-animate mb-6 text-sm text-muted-foreground" style="--hero-i: 3" data-hero-role>
      {profile.jobTitle}
    </p>

    <!-- Bio -->
    <div class="hero-animate" style="--hero-i: 4" data-hero-bio>
      <DecodeText>
        <p class="text-[14px] leading-[1.7] text-muted-foreground sm:text-[15px]">
          {bioLines.map((segments, line) => (
            <>
              {line > 0 && <br />}
              {segments.map((seg, i) => (
                i % 2 === 1 ? <span class="text-foreground">{seg}</span> : seg
              ))}
            </>
          ))}
        </p>
      </DecodeText>
    </div>

    <!-- Social Links -->
    <div class="mt-6 flex flex-wrap items-center gap-4 hero-animate sm:mt-8" style="--hero-i: 0" data-hero-motion data-hero-socials>
      <span class="flex-none whitespace-nowrap text-[14px] text-muted-foreground sm:text-[15px]">Find me at</span>
      {socials.map((social) => (
        <div class="social-link-wrapper">
          <div class="magnetic-button" data-magnetic data-strength="0.4">
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="contact-link"
              title={social.name}
            >
              <social.icon className="h-4 w-4" aria-hidden="true" />
              <span class="hidden sm:inline">{social.name}</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <div class="hero-animate mt-6" style="--hero-i: 1" data-hero-motion data-hero-listening>
      <Listening track={listeningTrack} />
    </div>

    <!-- GitHub Activity -->
    <div class="hero-animate" style="--hero-i: 2" data-hero-motion data-hero-github>
      <GitHubContributions />
    </div>

    <!-- Tech Stack Marquee -->
    <div class="mt-6 hero-animate" style="--hero-i: 3" data-hero-motion data-hero-tech>
      <TechMarquee row1={tech.row1} row2={tech.row2} />
    </div>
</header>

<style>
  .hero-section {
    min-height: calc(100vh - 120px);
    min-height: calc(100svh - 120px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    /* Phones: the glyph band above is 320px tall and dissolves at its bottom
       edge (GlyphField.astro). The copy starts low enough that only the
       status label and the display name sit in the band's fade; the chips,
       the role and the bio begin below it, so the rain — the same mono face
       at nearly the bio's size — never runs behind body text. 216px is nine
       lattice cells. The nav bar and any notch fit inside that room, so there
       is no safe-area term. */
    padding-top: 216px;
  }

  @media (min-width: 640px) {
    .hero-section {
      min-height: calc(100vh - 140px);
      padding-top: 5rem;
    }
  }

  /* Two rows of 11px text sliding under a phone's thumb is the one hero
     element that reads as noise at 390px, and it animates for as long as the
     page is open. Wide screens keep it. */
  @media (max-width: 639px) {
    [data-hero-tech] {
      display: none;
    }
  }

  /* Entrance. Once a GSAP timeline, now the same choreography as CSS
     transitions: nothing waits on a 70KB chunk before the name can paint, and
     the motion runs on the compositor. The identity lines rise 80ms apart
     from the moment `is-live` lands; the widgets follow from 950ms, 70ms
     apart. The script only flips the class and fires the hand-off events on
     the same clock. `back.out(1.25)`, expressed as a bezier. */
  .hero-section {
    --hero-ease: cubic-bezier(0.34, 1.35, 0.64, 1);
  }

  :global(html.js) .hero-animate {
    opacity: 0;
    transform: translateY(20px);
    will-change: opacity, transform;
  }

  :global(html.js) .hero-section.is-live .hero-animate {
    opacity: 1;
    transform: none;
    transition:
      opacity 600ms var(--hero-ease),
      transform 600ms var(--hero-ease);
    transition-delay: calc(var(--hero-i, 0) * 80ms);
  }

  :global(html.js) .hero-section.is-live .hero-animate[data-hero-motion] {
    transition-delay: calc(950ms + var(--hero-i, 0) * 70ms);
  }

  /* The stagger belongs to the entrance only; left in place it would delay
     every later transition on these elements. Once settled, the layer hints
     go too. */
  :global(html.js) .hero-section.is-settled .hero-animate {
    transition-delay: 0s;
    will-change: auto;
  }

  .hero-name-shell {
    position: relative;
  }

  .hero-lcp-anchor {
    position: absolute;
    inset: 0 auto auto 0;
    z-index: 0;
    color: currentColor;
    line-height: inherit;
    opacity: 0.01;
    pointer-events: none;
    white-space: pre;
  }

  [data-hero-name] {
    position: relative;
    z-index: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .hero-animate {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .status-text-wrapper {
    display: inline-block;
    height: 1.2em;
    line-height: 1.2em;
    overflow: hidden;
    vertical-align: middle;
    position: relative;
  }

  /* Status words leave upward and the next arrives from below: a quick
     ease-in out, a springy ease-out in. The script steps the classes. */
  .status-text {
    display: inline-block;
    line-height: 1.2em;
    transition:
      transform 240ms cubic-bezier(0.4, 0, 1, 1),
      opacity 240ms cubic-bezier(0.4, 0, 1, 1);
  }

  .status-text.is-leaving {
    transform: translateY(-115%);
    opacity: 0;
  }

  .status-text.is-below {
    transition: none;
    transform: translateY(115%);
    opacity: 0;
  }

  .status-text.is-entering {
    transition:
      transform 360ms cubic-bezier(0.34, 1.5, 0.64, 1),
      opacity 360ms ease-out;
  }

  /* The dot breathes once the identity lines have landed. Overrides the
     site-wide opacity-only pulse from site-chrome.css. */
  .status-dot {
    animation: none;
    transform-origin: center;
  }

  .hero-section.is-live .status-dot {
    animation: hero-dot 820ms ease-in-out 1s infinite alternate;
  }

  @keyframes hero-dot {
    from {
      transform: scale(1);
      opacity: 1;
    }
    to {
      transform: scale(1.5);
      opacity: 0.42;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-section.is-live .status-dot {
      animation: none;
    }

    .status-text,
    .status-text.is-entering {
      transition: none;
    }
  }

  /* Personal info styling */
  .separator {
    opacity: 0.5;
  }

  /* Social Links with Dropdown Details */
  .social-link-wrapper {
    position: relative;
    display: inline-block;
  }

  /* Magnetic chips: the chip follows the mouse on a short ease-out and springs
     back on leave. The transform is set by the script; the timing lives here. */
  .magnetic-button {
    display: inline-flex;
    align-items: center;
    transition: transform 500ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .magnetic-button.is-magnetic {
    transition: transform 150ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
  const heroSection = document.querySelector<HTMLElement>('[data-hero]');
  const heroElements = Array.from(document.querySelectorAll<HTMLElement>('.hero-animate'));
  const statusText = document.getElementById('status-text');
  const HOME_HERO_GITHUB_READY_EVENT = 'home:hero-github-ready';
  // The name line lands at this point of the identity stagger; typing starts
  // here, so nothing types on an element that is still moving.
  const NAME_READY_MS = 600;
  // The bio is the slowest element (its decode runs for seconds), so it starts
  // just after the name does, and the widgets below follow a few keystrokes
  // in. Nothing waits for the name to finish: the hero fills top to bottom in
  // one pass instead of leaving a hole where the bio will be.
  const BIO_MS = NAME_READY_MS;
  // Must match the widget delay in the stylesheet above.
  const PHASE_TWO_MS = 950;
  const WIDGET_STAGGER_MS = 70;
  // Longest entrance: phase two plus the last widget's stagger and duration.
  const SETTLE_MS = PHASE_TWO_MS + 3 * WIDGET_STAGGER_MS + 600 + 200;
  const STATUS_HOLD_MS = 2400;
  const STATUS_OUT_MS = 240;
  const STATUS_IN_MS = 360;

  // Status verbs are curated in src/data/site.ts and passed through a data
  // attribute so the client bundle never imports the data module (which would
  // pull in the icon components).
  const statusHost = document.querySelector<HTMLElement>('[data-status-words]');
  const statusWords: string[] = JSON.parse(statusHost?.dataset.statusWords || '[]');

  const announce = (name: string) => window.dispatchEvent(new CustomEvent(name));

  const initEntrance = () => {
    if (!heroSection) return;

    // Commit the hidden state before the class lands, so the change is a
    // transition rather than a first paint in the final state.
    void heroSection.getBoundingClientRect();
    heroSection.classList.add('is-live');

    window.setTimeout(() => announce('home:hero-name-ready'), NAME_READY_MS);
    window.setTimeout(() => announce('home:hero-bio-ready'), BIO_MS);

    const widgets = heroElements.filter((el) => el.hasAttribute('data-hero-motion'));
    const githubIndex = Math.max(0, widgets.findIndex((el) => el.hasAttribute('data-hero-github')));
    window.setTimeout(() => {
      (window as Window & { __homeHeroGithubReady?: boolean }).__homeHeroGithubReady = true;
      announce(HOME_HERO_GITHUB_READY_EVENT);
    }, PHASE_TWO_MS + githubIndex * WIDGET_STAGGER_MS);

    window.setTimeout(() => heroSection.classList.add('is-settled'), SETTLE_MS);
  };

  const initStatusRotation = () => {
    if (!statusText || statusWords.length < 2) return;
    let index = 0;

    const rotate = () => {
      statusText.classList.add('is-leaving');
      window.setTimeout(() => {
        index = (index + 1) % statusWords.length;
        statusText.textContent = statusWords[index];
        statusText.classList.replace('is-leaving', 'is-below');
        // Commit the below position, then transition up from it.
        void statusText.offsetWidth;
        statusText.classList.replace('is-below', 'is-entering');
        window.setTimeout(() => {
          statusText.classList.remove('is-entering');
          window.setTimeout(rotate, STATUS_HOLD_MS);
        }, STATUS_IN_MS);
      }, STATUS_OUT_MS);
    };

    // The first swap waits for the identity lines to land, as the dot does.
    window.setTimeout(rotate, NAME_READY_MS + STATUS_HOLD_MS);
  };

  const initMagnetic = () => {
    document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((element) => {
      const strength = Number.parseFloat(element.dataset.strength || '0.3');
      let bounds: DOMRect | null = null;

      element.addEventListener('pointerenter', (event) => {
        if (event.pointerType !== 'mouse') return;
        bounds = element.getBoundingClientRect();
        element.classList.add('is-magnetic');
      }, { passive: true });

      element.addEventListener('pointermove', (event) => {
        if (event.pointerType !== 'mouse' || !bounds) return;
        const dx = (event.clientX - (bounds.left + bounds.width / 2)) * strength;
        const dy = (event.clientY - (bounds.top + bounds.height / 2)) * strength;
        element.style.transform = `translate(${dx}px, ${dy}px)`;
      }, { passive: true });

      element.addEventListener('pointerleave', (event) => {
        if (event.pointerType !== 'mouse') return;
        bounds = null;
        element.classList.remove('is-magnetic');
        element.style.transform = '';
      }, { passive: true });
    });
  };

  if (!prefersReducedMotion && heroElements.length) {
    initEntrance();
    initStatusRotation();
    initMagnetic();
  }
</script>
