---
import Typewriter from '@/features/home/ui/Typewriter.astro';
import DecodeText from '@/features/home/ui/DecodeText.astro';
import GitHubContributions from '@/features/home/ui/GitHubContributions.astro';
import Listening from '@/features/home/ui/Listening.astro';
import TechMarquee from '@/features/home/ui/TechMarquee.astro';
import HeroCards from '@/features/home/ui/HeroCards.astro';
import type { ListeningTrack } from '@/features/home/types';
import { GitHubIcon, InstagramIcon, TelegramIcon } from '@/components/icons';
import { hero, tech, profile, experience } from '@/data/site';

interface Props {
  listeningTrack?: ListeningTrack;
}

const { listeningTrack } = Astro.props;

const { socials, typewriterNames, infoChips } = hero;
const lcpAnchorName = typewriterNames.reduce(
  (longest, name) => (name.length > longest.length ? name : longest),
  typewriterNames[0] ?? '',
);
const school = experience[0];

// Each link opens its own hover card (HeroCards.astro), named by `data-card`.
const cardAttrs = (id: string) => ({ 'data-card': id });
// Brand marks lead the links that leave the site for a named place.
const brandIcons: Record<string, typeof GitHubIcon> = {
  GitHub: GitHubIcon,
  Telegram: TelegramIcon,
  Instagram: InstagramIcon,
};
const external = { target: '_blank', rel: 'noopener noreferrer' };
const socialJoiner = (i: number): string => (i === 0 ? '' : i === socials.length - 1 ? ' and ' : ', ');
---

<header class="hero-section pb-8 sm:pb-12" data-hero>
    <!-- Status indicator -->
    <div class="hero-animate" style="--hero-i: 0" data-hero-status data-status-words={JSON.stringify(hero.statusWords)}>
      <div class="status mb-4">
        <span class="status-dot"></span>
        <span class="status-text-wrapper">
          <span class="status-text" id="status-text">{hero.statusWords[0]}</span>
        </span>
      </div>
    </div>

    <!-- Name -->
    <div class="hero-name-shell mb-2 text-[28px] font-semibold sm:text-[36px]">
      <span class="hero-lcp-anchor" aria-hidden="true">{lcpAnchorName}</span>
      <h1 class="hero-animate m-0" style="--hero-i: 1" data-hero-name>
        <Typewriter texts={typewriterNames} keystrokeMs={90} />
      </h1>
    </div>

    <!-- Personal Info -->
    <div class="hero-animate mb-4" style="--hero-i: 2" data-hero-info>
      <p class="text-[length:var(--home-text-meta)] text-muted-foreground/70 tracking-wider font-mono">
        <span class="inline-flex items-center gap-2">
          {infoChips.map((chip, i) => (
            <>
              {i > 0 && <span class="separator">•</span>}
              <span>{chip}</span>
            </>
          ))}
        </span>
      </p>
    </div>

    <!-- Role -->
    <p class="hero-animate mb-6 text-[length:var(--home-text-body)] text-muted-foreground" style="--hero-i: 3" data-hero-role>
      {profile.jobTitle}
    </p>

    <!-- Bio. The whole thing decodes. Links are atoms, so they keep their
         boxes through it and come back as real elements. -->
    <div class="hero-animate" style="--hero-i: 4" data-hero-bio>
      <DecodeText class="hero-bio">
        <p>
          I build things, then polish them. Frontends in TypeScript and React,
          networks down to BGP, Linux boxes in Docker, and small tools that
          agents can run. I sweat the details, and the milliseconds.
        </p>
        <p>
          The code ships as
          <a class="hero-link" href="/projects" {...cardAttrs('projects')} style="--draw-i: 0" data-decode-atom>projects</a>.
          Away from it I <a class="hero-link" href="/blog" {...cardAttrs('write')} style="--draw-i: 1" data-decode-atom>write</a>,
          somewhere between literature and silence, and the small stuff lands
          in <a class="hero-link" href="/mood" {...cardAttrs('moods')} style="--draw-i: 2" data-decode-atom>moods</a>.
        </p>
        <p>
          Currently studying Computer Science at
          <a class="hero-link" href={school.url} {...external} {...cardAttrs('monash')} style="--draw-i: 3" data-decode-atom>{school.org}</a>,
          in Melbourne.
          <a class="hero-link" href="/message" {...cardAttrs('message')} style="--draw-i: 4" data-decode-atom>Say hi</a>,
          or find me on
          {socials.map((social, i) => {
            const Icon = brandIcons[social.name] ?? social.icon;
            return (
              <>{socialJoiner(i)}<a class="hero-link hero-link--icon" href={social.url} {...external} {...cardAttrs(social.name.toLowerCase())} data-decode-atom><Icon className="hero-link-icon" />{social.name}</a></>
            );
          })}.
        </p>
      </DecodeText>
    </div>
    <HeroCards />

    <div class="hero-animate mt-10" style="--hero-i: 0" data-hero-motion data-hero-listening>
      <Listening track={listeningTrack} />
    </div>

    <!-- GitHub Activity -->
    <div class="hero-animate" style="--hero-i: 1" data-hero-motion data-hero-github>
      <GitHubContributions />
    </div>

    <!-- Tech Stack Marquee -->
    <div class="mt-6 hero-animate" style="--hero-i: 2" data-hero-motion data-hero-tech>
      <TechMarquee row1={tech.row1} row2={tech.row2} />
    </div>
</header>

<style>
  .hero-section {
    min-height: calc(100vh - 120px);
    min-height: calc(100svh - 120px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    padding-top: calc(env(safe-area-inset-top, 0px) + 4.75rem);
  }

  @media (min-width: 640px) {
    .hero-section {
      min-height: calc(100vh - 140px);
      padding-top: 5rem;
    }
  }

  /* Entrance. Once a GSAP timeline, now the same choreography as CSS
     transitions: nothing waits on a 70KB chunk before the name can paint, and
     the motion runs on the compositor. The identity lines rise 80ms apart
     from the moment `is-live` lands; the widgets follow from 950ms, 70ms
     apart. The script only flips the class and fires the hand-off events on
     the same clock.

     The curve is the site's ease-out, the same family the sections below
     reveal on. It used to be `back.out(1.25)`: an overshoot on text reads as
     the line bouncing off its own baseline, and it made the hero the one part
     of the page that moved with a different hand. */
  .hero-section {
    --hero-ease: var(--ease-out);
  }

  :global(html.js) .hero-animate {
    opacity: 0;
    transform: translateY(20px);
    will-change: opacity, transform;
  }

  :global(html.js) .hero-section.is-live .hero-animate {
    opacity: 1;
    transform: none;
    transition:
      opacity 600ms var(--hero-ease),
      transform 600ms var(--hero-ease);
    transition-delay: calc(var(--hero-i, 0) * 80ms);
  }

  :global(html.js) .hero-section.is-live .hero-animate[data-hero-motion] {
    transition-delay: calc(950ms + var(--hero-i, 0) * 70ms);
  }

  /* The stagger belongs to the entrance only; left in place it would delay
     every later transition on these elements. Once settled, the layer hints
     go too. */
  :global(html.js) .hero-section.is-settled .hero-animate {
    transition-delay: 0s;
    will-change: auto;
  }

  .hero-name-shell {
    position: relative;
  }

  .hero-lcp-anchor {
    position: absolute;
    inset: 0 auto auto 0;
    z-index: 0;
    color: currentColor;
    line-height: inherit;
    opacity: 0.01;
    pointer-events: none;
    white-space: pre;
  }

  [data-hero-name] {
    position: relative;
    z-index: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .hero-animate {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* The status is the hero's eyebrow: label size, secondary ink, the mono
     label tracking. At full black it sat level with the name; now the dot
     carries the life and the words recede. Overrides the 12px caps from
     site-chrome.css. */
  .status {
    font-size: var(--home-text-label);
    letter-spacing: 0.14em;
    color: var(--home-fg-secondary);
  }

  .status-text-wrapper {
    display: inline-block;
    height: 1.2em;
    line-height: 1.2em;
    overflow: hidden;
    vertical-align: middle;
    position: relative;
  }

  /* Status words leave upward and the next arrives from below. Both legs
     ease out: the exit is shorter and softer than the entrance, so the eye
     follows the word that is arriving. The script steps the classes. */
  .status-text {
    display: inline-block;
    line-height: 1.2em;
    transition:
      transform 160ms var(--ease-out),
      opacity 160ms var(--ease-out);
  }

  .status-text.is-leaving {
    transform: translateY(-60%);
    opacity: 0;
  }

  .status-text.is-below {
    transition: none;
    transform: translateY(115%);
    opacity: 0;
  }

  .status-text.is-entering {
    transition:
      transform 300ms var(--ease-out),
      opacity 300ms var(--ease-out);
  }

  /* The dot is the page's one resting pulse, and it carries the session ink:
     the same colour as the rain behind it and every live marker below. It
     used to beat at 820ms to 1.5x, which read as an alert rather than a
     heartbeat. Overrides the site-wide opacity-only pulse from
     site-chrome.css. */
  .status-dot {
    animation: none;
    transform-origin: center;
    background: var(--home-accent);
  }

  .hero-section.is-live .status-dot {
    animation: hero-dot 1600ms ease-in-out 1s infinite alternate;
  }

  @keyframes hero-dot {
    from {
      transform: scale(1);
      opacity: 1;
    }
    to {
      transform: scale(1.25);
      opacity: 0.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-section.is-live .status-dot {
      animation: none;
    }

    .status-text,
    .status-text.is-entering {
      transition: none;
    }
  }

  /* Personal info styling */
  .separator {
    opacity: 0.5;
  }

  /* The bio is three short paragraphs of one voice. Only links are bright;
     everything else stays muted, so the eye lands on the ways out. The gap
     between paragraphs is just under a line, so they read as one block with
     breaths in it. */
  :global(.hero-bio) p {
    margin: 0;
    font-size: var(--home-text-body);
    line-height: 1.7;
    color: hsl(var(--muted-foreground));
    text-wrap: pretty;
  }

  :global(.hero-bio) p + p {
    margin-top: 0.9em;
  }

  /* Every link carries one mark: the words that stay on the site are
     underlined, the channels that leave it lead with their brand. Both
     marks on one word, or an underline under every word, crowded the lines.
     The underline is a background so it draws with one property; the bottom
     padding drops it just under the descenders without touching the line
     box. */
  .hero-link {
    --underline: hsl(var(--foreground) / 0.24);
    position: relative;
    z-index: 0;
    padding-bottom: 0.1em;
    color: var(--home-fg-primary);
    text-decoration: none;
    white-space: nowrap;
    background: linear-gradient(var(--underline), var(--underline)) no-repeat 0 100% / 100% 1px;
  }

  .hero-link--icon {
    background: none;
  }

  .hero-link :global(.hero-link-icon) {
    display: inline-block;
    width: 0.9em;
    height: 0.9em;
    margin-right: 0.28em;
    vertical-align: -0.1em;
    opacity: 0.72;
    transition: opacity 150ms ease;
  }

  .hero-link:hover :global(.hero-link-icon) {
    opacity: 1;
  }

  /* The hover highlight rises out of the underline. */
  .hero-link::before {
    content: '';
    position: absolute;
    inset: 0 -0.12em;
    z-index: -1;
    border-radius: 0.2em 0.2em 0 0;
    background: hsl(var(--foreground) / 0.08);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 200ms var(--ease-out);
  }

  @media (hover: hover) {
    .hero-link:hover,
    .hero-link:focus-visible {
      --underline: hsl(var(--foreground) / 0.6);
    }

    .hero-link:hover::before {
      transform: scaleY(1);
    }

  }

  /* Underlines wait for the decode to settle, then draw in reading order.
     Reduced motion never hides them. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js .decode-text:not(.dt-settled)) .hero-link {
      background-size: 0% 1px;
    }

    :global(.decode-text.dt-settled) .hero-link {
      transition: background-size 450ms cubic-bezier(0.22, 1, 0.36, 1) calc(var(--draw-i, 0) * 110ms);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-link::before {
      transition: none;
    }
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
  const heroSection = document.querySelector<HTMLElement>('[data-hero]');
  const heroElements = Array.from(document.querySelectorAll<HTMLElement>('.hero-animate'));
  const statusText = document.getElementById('status-text');
  const HOME_HERO_GITHUB_READY_EVENT = 'home:hero-github-ready';
  // The name line lands at this point of the identity stagger; typing starts
  // here, so nothing types on an element that is still moving.
  const NAME_READY_MS = 600;
  // The bio is the slowest element (its decode runs for seconds), so it starts
  // just after the name does, and the widgets below follow a few keystrokes
  // in. Nothing waits for the name to finish: the hero fills top to bottom in
  // one pass instead of leaving a hole where the bio will be.
  const BIO_MS = NAME_READY_MS;
  // Must match the widget delay in the stylesheet above.
  const PHASE_TWO_MS = 950;
  const WIDGET_STAGGER_MS = 70;
  // Longest entrance: phase two plus the last widget's stagger and duration.
  const SETTLE_MS = PHASE_TWO_MS + 2 * WIDGET_STAGGER_MS + 600 + 200;
  const STATUS_HOLD_MS = 2400;
  const STATUS_OUT_MS = 160;
  const STATUS_IN_MS = 300;
  // The status runs a short random stretch of the curated verbs while the
  // name types, then settles on its last word. Each visit lands somewhere
  // different; nobody sits through all twenty-five.
  const STATUS_SWAPS = 4;

  // Status verbs are curated in src/data/site.ts and passed through a data
  // attribute so the client bundle never imports the data module (which would
  // pull in the icon components).
  const statusHost = document.querySelector<HTMLElement>('[data-status-words]');
  const statusWords: string[] = JSON.parse(statusHost?.dataset.statusWords || '[]');

  const announce = (name: string) => window.dispatchEvent(new CustomEvent(name));

  const initEntrance = () => {
    if (!heroSection) return;

    // Commit the hidden state before the class lands, so the change is a
    // transition rather than a first paint in the final state.
    void heroSection.getBoundingClientRect();
    heroSection.classList.add('is-live');

    window.setTimeout(() => announce('home:hero-name-ready'), NAME_READY_MS);
    // The anchor only has to be painted once, so the browser can time the
    // name before the canvas takes the line. Left in place it shows through
    // as a ghost of the first name ahead of the caret and behind every other
    // name. Removing it later does not withdraw the paint that was timed.
    window.setTimeout(() => heroSection.querySelector('.hero-lcp-anchor')?.remove(), NAME_READY_MS);
    window.setTimeout(() => announce('home:hero-bio-ready'), BIO_MS);

    const widgets = heroElements.filter((el) => el.hasAttribute('data-hero-motion'));
    const githubIndex = Math.max(0, widgets.findIndex((el) => el.hasAttribute('data-hero-github')));
    window.setTimeout(() => {
      (window as Window & { __homeHeroGithubReady?: boolean }).__homeHeroGithubReady = true;
      announce(HOME_HERO_GITHUB_READY_EVENT);
    }, PHASE_TWO_MS + githubIndex * WIDGET_STAGGER_MS);

    window.setTimeout(() => heroSection.classList.add('is-settled'), SETTLE_MS);
  };

  const initStatusRotation = () => {
    if (!statusText || statusWords.length < 2) return;
    // Word 0 is the server-rendered one; the run draws from the rest, starting
    // anywhere, and never repeats inside one visit.
    const pool = statusWords.length - 1;
    const start = Math.floor(Math.random() * pool);
    let swaps = 0;

    const rotate = () => {
      statusText.classList.add('is-leaving');
      window.setTimeout(() => {
        statusText.textContent = statusWords[1 + ((start + swaps) % pool)];
        swaps += 1;
        statusText.classList.replace('is-leaving', 'is-below');
        // Commit the below position, then transition up from it.
        void statusText.offsetWidth;
        statusText.classList.replace('is-below', 'is-entering');
        window.setTimeout(() => {
          statusText.classList.remove('is-entering');
          if (swaps < Math.min(STATUS_SWAPS, pool)) window.setTimeout(rotate, STATUS_HOLD_MS);
        }, STATUS_IN_MS);
      }, STATUS_OUT_MS);
    };

    // The first swap waits for the identity lines to land, as the dot does.
    window.setTimeout(rotate, NAME_READY_MS + STATUS_HOLD_MS);
  };

  if (!prefersReducedMotion && heroElements.length) {
    initEntrance();
    initStatusRotation();
  }
</script>
