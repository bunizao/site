---
import Typewriter from '@/features/home/ui/Typewriter.astro';
import DecodeText from '@/features/home/ui/DecodeText.astro';
import GitHubContributions from '@/features/home/ui/GitHubContributions.astro';
import Listening from '@/features/home/ui/Listening.astro';
import TechMarquee from '@/features/home/ui/TechMarquee.astro';
import type { ListeningTrack } from '@/features/home/types';
import { hero, tech, profile } from '@/data/site';

interface Props {
  listeningTrack?: ListeningTrack;
}

const { listeningTrack } = Astro.props;

const { socials, typewriterNames, infoChips, bio } = hero;
const lcpAnchorName = typewriterNames.reduce(
  (longest, name) => (name.length > longest.length ? name : longest),
  typewriterNames[0] ?? '',
);

// Split each bio line on the `**` highlight marker: odd chunks are emphasized.
const bioLines = bio.map((line) => line.split('**'));
---

<header class="hero-section pb-8 sm:pb-12">
    <!-- Status indicator -->
    <div class="hero-animate" data-hero-status data-status-words={JSON.stringify(hero.statusWords)}>
      <div class="status mb-4">
        <span class="status-dot"></span>
        <span class="status-text-wrapper">
          <span class="status-text" id="status-text">{hero.statusWords[0]}</span>
        </span>
      </div>
    </div>

    <!-- Name -->
    <div class="hero-name-shell mb-2 text-[28px] font-semibold sm:text-[36px]">
      <span class="hero-lcp-anchor" aria-hidden="true">{lcpAnchorName}</span>
      <h1 class="hero-animate m-0" data-hero-name>
        <Typewriter texts={typewriterNames} keystrokeMs={90} />
      </h1>
    </div>

    <!-- Personal Info -->
    <div class="hero-animate mb-4" data-hero-info>
      <p class="text-xs text-muted-foreground/70 tracking-wider font-mono">
        <span class="inline-flex items-center gap-2">
          {infoChips.map((chip, i) => (
            <>
              {i > 0 && <span class="separator">•</span>}
              <span>{chip}</span>
            </>
          ))}
        </span>
      </p>
    </div>

    <!-- Role -->
    <p class="hero-animate mb-6 text-sm text-muted-foreground" data-hero-role>
      {profile.jobTitle}
    </p>

    <!-- Bio -->
    <div class="hero-animate" data-hero-bio>
      <DecodeText>
        <p class="text-[14px] leading-[1.7] text-muted-foreground sm:text-[15px]">
          {bioLines.map((segments, line) => (
            <>
              {line > 0 && <br />}
              {segments.map((seg, i) => (
                i % 2 === 1 ? <span class="text-foreground">{seg}</span> : seg
              ))}
            </>
          ))}
        </p>
      </DecodeText>
    </div>

    <!-- Social Links -->
    <div class="mt-6 flex flex-wrap items-center gap-4 hero-animate sm:mt-8" data-hero-motion data-hero-socials>
      <span class="flex-none whitespace-nowrap text-[14px] text-muted-foreground sm:text-[15px]">Find me at</span>
      {socials.map((social) => (
        <div class="social-link-wrapper">
          <div class="magnetic-button" data-magnetic data-strength="0.4">
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="contact-link"
              title={social.name}
            >
              <social.icon className="h-4 w-4" aria-hidden="true" />
              <span class="hidden sm:inline">{social.name}</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <div class="hero-animate mt-6" data-hero-motion data-hero-listening>
      <Listening track={listeningTrack} />
    </div>

    <!-- GitHub Activity -->
    <div class="hero-animate" data-hero-motion data-hero-github>
      <GitHubContributions />
    </div>

    <!-- Tech Stack Marquee -->
    <div class="mt-6 hero-animate" data-hero-motion data-hero-tech>
      <TechMarquee row1={tech.row1} row2={tech.row2} />
    </div>
</header>

<style>
  .hero-section {
    min-height: calc(100vh - 120px);
    min-height: calc(100svh - 120px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    /* Phones: the glyph band above is 320px tall and dissolves at its bottom
       edge (GlyphField.astro). The copy starts low enough that only the
       status label and the display name sit in the band's fade; the chips,
       the role and the bio begin below it, so the rain — the same mono face
       at nearly the bio's size — never runs behind body text. 216px is nine
       lattice cells. The nav bar and any notch fit inside that room, so there
       is no safe-area term. */
    padding-top: 216px;
  }

  @media (min-width: 640px) {
    .hero-section {
      min-height: calc(100vh - 140px);
      padding-top: 5rem;
    }
  }

  /* Two rows of 11px text sliding under a phone's thumb is the one hero
     element that reads as noise at 390px, and it animates for as long as the
     page is open. Wide screens keep it. */
  @media (max-width: 639px) {
    [data-hero-tech] {
      display: none;
    }
  }

  :global(html.js) .hero-animate {
    opacity: 0;
    transform: translateY(20px);
    will-change: opacity, transform;
  }

  .hero-name-shell {
    position: relative;
  }

  .hero-lcp-anchor {
    position: absolute;
    inset: 0 auto auto 0;
    z-index: 0;
    color: currentColor;
    line-height: inherit;
    opacity: 0.01;
    pointer-events: none;
    white-space: pre;
  }

  [data-hero-name] {
    position: relative;
    z-index: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .hero-animate {
      opacity: 1;
      transform: none;
    }
  }

  .status-text-wrapper {
    display: inline-block;
    height: 1.2em;
    line-height: 1.2em;
    overflow: hidden;
    vertical-align: middle;
    position: relative;
  }

  .status-text {
    display: inline-block;
    line-height: 1.2em;
    will-change: transform, opacity;
  }

  .status-dot {
    animation: none;
    transform-origin: center;
    will-change: transform, opacity;
  }

  /* Personal info styling */
  .separator {
    opacity: 0.5;
  }

  /* Hidden SVG filter container */
  .liquid-glass-filters {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* Social Links with Dropdown Details */
  .social-link-wrapper {
    position: relative;
    display: inline-block;
  }

  .magnetic-button {
    display: inline-flex;
    align-items: center;
  }

</style>

<script>
  const prefersReducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
  const heroElements = Array.from(document.querySelectorAll<HTMLElement>('.hero-animate'));
  const statusText = document.getElementById('status-text');
  const statusDot = document.querySelector<HTMLElement>('.status-dot');
  const HOME_HERO_GITHUB_READY_EVENT = 'home:hero-github-ready';
  const HOME_HERO_NAME_TYPED_EVENT = 'home:hero-name-typed';
  // The name line lands at this point of the identity stagger; typing starts
  // here, so nothing types on an element that is still moving.
  const NAME_READY_S = 0.6;
  // The bio is the slowest element (its decode runs for seconds), so it starts
  // just after the name does, and the widgets below follow a few keystrokes
  // in. Nothing waits for the name to finish: the hero fills top to bottom in
  // one pass instead of leaving a hole where the bio will be.
  const BIO_S = NAME_READY_S;
  const PHASE_TWO_S = NAME_READY_S + 0.35;
  // Runs the next stage even if the typewriter never reports -- no canvas, a
  // thrown error, an empty name list.
  const PHASE_TWO_FALLBACK_S = 3;

  // Status verbs are curated in src/data/site.ts and passed through a data
  // attribute so the client bundle never imports the data module (which would
  // pull in the icon components).
  const statusHost = document.querySelector<HTMLElement>('[data-status-words]');
  const statusWords: string[] = JSON.parse(statusHost?.dataset.statusWords || '[]');

  const initHero = async () => {
    if (!heroElements.length) return;

    // Lazy-load GSAP so the home page does not eagerly fetch the chunk on load.
    const { default: gsap } = await import('gsap');

    // Split the hero into two phases so the chain reads top-to-bottom:
    // identity text resolves first, then the supporting widgets rise in.
    const identity = heroElements.filter((el) => !el.hasAttribute('data-hero-motion'));
    const widgets = heroElements.filter((el) => el.hasAttribute('data-hero-motion'));

    gsap.set(heroElements, { opacity: 0, y: 20 });

    const heroTl = gsap.timeline({
      defaults: { ease: 'power3.out' }
    });

    // Phase 1: status -> name -> info -> role -> bio.
    heroTl.to(identity, {
      opacity: 1,
      y: 0,
      duration: 0.6,
      stagger: 0.08,
      ease: 'back.out(1.25)'
    }, 0);

    heroTl.call(() => {
      window.dispatchEvent(new CustomEvent('home:hero-name-ready'));
    }, [], NAME_READY_S);
    heroTl.call(() => {
      window.dispatchEvent(new CustomEvent('home:hero-bio-ready'));
    }, [], BIO_S);

    // Phase 2 overlaps the typing; the typed event only matters if the beat
    // ever runs faster than the timeline.
    const githubWidget = widgets.find((el) => el.hasAttribute('data-hero-github'));
    const githubWidgetIndex = githubWidget ? Math.max(0, widgets.indexOf(githubWidget)) : 0;
    let phaseTwoStarted = false;

    const startPhaseTwo = () => {
      if (phaseTwoStarted) return;
      phaseTwoStarted = true;

      gsap.to(widgets, {
        opacity: 1,
        y: 0,
        duration: 0.6,
        stagger: 0.07,
        ease: 'back.out(1.25)'
      });

      gsap.delayedCall(githubWidgetIndex * 0.07, () => {
        (window as Window & { __homeHeroGithubReady?: boolean }).__homeHeroGithubReady = true;
        window.dispatchEvent(new CustomEvent(HOME_HERO_GITHUB_READY_EVENT));
      });
    };

    heroTl.call(startPhaseTwo, [], PHASE_TWO_S);
    window.addEventListener(HOME_HERO_NAME_TYPED_EVENT, startPhaseTwo, { once: true });
    gsap.delayedCall(PHASE_TWO_FALLBACK_S, startPhaseTwo);

    const magneticButtons = document.querySelectorAll('[data-magnetic]');
    magneticButtons.forEach((button) => {
      const element = button as HTMLElement;
      const strength = Number.parseFloat(element.getAttribute('data-strength') || '0.3');
      const quickX = gsap.quickTo(element, 'x', {
        duration: 0.3,
        ease: 'power2.out'
      });
      const quickY = gsap.quickTo(element, 'y', {
        duration: 0.3,
        ease: 'power2.out'
      });
      let bounds: DOMRect | null = null;

      const updateBounds = () => {
        bounds = element.getBoundingClientRect();
      };

      const handlePointerEnter = (event: PointerEvent) => {
        if (event.pointerType && event.pointerType !== 'mouse') return;
        updateBounds();
      };

      const handlePointerMove = (event: PointerEvent) => {
        if (event.pointerType && event.pointerType !== 'mouse') return;
        if (!bounds) {
          updateBounds();
        }
        if (!bounds) return;

        const { left, top, width, height } = bounds;
        const centerX = left + width / 2;
        const centerY = top + height / 2;

        const deltaX = (event.clientX - centerX) * strength;
        const deltaY = (event.clientY - centerY) * strength;

        quickX(deltaX);
        quickY(deltaY);
      };

      const handlePointerLeave = (event: PointerEvent) => {
        if (event.pointerType && event.pointerType !== 'mouse') return;
        bounds = null;
        gsap.to(element, {
          x: 0,
          y: 0,
          duration: 0.5,
          ease: 'elastic.out(1, 0.3)'
        });
      };

      element.style.willChange = 'transform';
      element.addEventListener('pointerenter', handlePointerEnter, { passive: true });
      element.addEventListener('pointermove', handlePointerMove, { passive: true });
      element.addEventListener('pointerleave', handlePointerLeave, { passive: true });
    });

    heroTl.call(() => {
      if (statusDot) {
        gsap.to(statusDot, {
          scale: 1.5,
          opacity: 0.42,
          duration: 0.82,
          ease: 'sine.inOut',
          repeat: -1,
          yoyo: true
        });
      }
    });

    if (statusText) {
      let currentIndex = 0;
      let statusRotationCall: ReturnType<typeof gsap.delayedCall> | null = null;

      const rotateStatus = () => {
        currentIndex = (currentIndex + 1) % statusWords.length;

        gsap.timeline()
          .to(statusText, {
            yPercent: -115,
            autoAlpha: 0,
            duration: 0.24,
            ease: 'power2.in'
          })
          .call(() => {
            statusText.textContent = statusWords[currentIndex];
            gsap.set(statusText, { yPercent: 115 });
          })
          .to(statusText, {
            yPercent: 0,
            autoAlpha: 1,
            duration: 0.36,
            ease: 'back.out(1.5)'
          })
          .call(scheduleStatusRotation);
      };

      function scheduleStatusRotation() {
        statusRotationCall?.kill();
        statusRotationCall = gsap.delayedCall(2.4, rotateStatus);
      }

      heroTl.call(() => {
        scheduleStatusRotation();
      });
    }
  };

  if (!prefersReducedMotion) {
    void initHero();
  }
</script>
