---
import Typewriter from '@/features/home/ui/Typewriter.astro';
import GitHubContributions from '@/features/home/ui/GitHubContributions.astro';
import Listening from '@/features/home/ui/Listening.astro';
import TechMarquee from '@/features/home/ui/TechMarquee.astro';
import {Instagram, type LucideIcon} from 'lucide-react';
import { FileText, Github, Mail, Send } from 'lucide-react';

const socials: Array<{
  name: string;
  url: string;
  icon: LucideIcon;
  description: string;
  handle: string;
}> = [
  {
    name: 'Blog',
    url: 'https://blog.buxx.me',
    icon: FileText,
    description: 'Read my articles',
    handle: 'blog.buxx.me'
  },
  {
    name: 'GitHub',
    url: 'https://tuu.cat/gh',
    icon: Github,
    description: 'Check out my code',
    handle: '@bunizao'
  },
  {
    name: 'Email',
    url: 'mailto:me@buxx.me',
    icon: Mail,
    description: 'Send me a message',
    handle: 'me@buxx.me'
  },
  {
    name: 'Telegram',
    url: 'https://tuu.cat/tg',
    icon: Send,
    description: 'Chat with me',
    handle: 'tuu.cat/tg'
  },
  {
    name: 'Instagram',
    url: 'https://tuu.cat/ig',
    icon: Instagram,
    description: 'See my photos',
    handle: 'tuu.cat/ig'
  }
];

const techRow1 = ['TypeScript', "JavaScript", 'Python', 'C#', 'C++', 'React', 'TailwindCSS', 'Astro'];
const techRow2 = ['Frontend', 'BGP', 'Proxy', 'Docker', 'Linux', 'Web3', 'Optimization'];
---

<header class="hero-section pt-14 pb-8 sm:pt-20 sm:pb-12">
    <!-- Status indicator -->
    <div class="hero-animate" data-hero-status>
      <div class="status mb-4">
        <span class="status-dot"></span>
        <span class="status-text-wrapper">
          <span class="status-text" id="status-text">Wondering</span>
        </span>
      </div>
    </div>

    <!-- Name -->
    <h1 class="hero-animate mb-2 text-[28px] font-semibold sm:text-[36px]" data-hero-name>
      <Typewriter texts={["Lucian", "Bunizao", "Tutu", "Collapsar"]} speed={80} />
    </h1>

    <!-- Personal Info -->
    <div class="hero-animate mb-3" data-hero-info>
      <p class="text-xs text-muted-foreground/70 tracking-wider font-mono">
        <span class="inline-flex items-center gap-2">
          <span>18 y.o.</span>
          <span class="separator">•</span>
          <span>INFP</span>
          <span class="separator">•</span>
          <span>Libra</span>
        </span>
      </p>
    </div>

    <!-- Role -->
    <p class="hero-animate mb-6 text-sm text-muted-foreground" data-hero-role>
      Student / Developer / Blogger
    </p>

    <!-- Bio -->
    <div class="hero-animate" data-hero-bio>
      <p class="text-[14px] leading-[1.7] text-muted-foreground sm:text-[15px]">
        I make interesting things.<br>
        Curious about <span class="text-foreground">frontend design</span>,
        <span class="text-foreground">proxy systems</span>, and
        contributing to <span class="text-foreground"> open source</span>.<br>
        Obsessed with <span class="text-foreground">speed</span> and always asking how things can be <span class="text-foreground">better</span>.<br>
        Outside of coding, I read for curiosity and write to make sense of things.<br>
        Currently studying Computer Science at <span class="text-foreground">Monash University</span>.
      </p>
    </div>

    <!-- Social Links -->
    <div class="mt-6 flex flex-wrap items-center gap-4 hero-animate sm:mt-8" data-hero-motion data-hero-socials>
      <span class="flex-none whitespace-nowrap text-[14px] text-muted-foreground sm:text-[15px]">Find me at</span>
      {socials.map((social) => (
        <div class="social-link-wrapper">
          <div class="magnetic-button" data-magnetic data-strength="0.4">
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="contact-link"
              title={social.name}
            >
              <social.icon className="h-4 w-4" aria-hidden="true" />
              <span class="hidden sm:inline">{social.name}</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <div class="hero-animate mt-6 sm:mt-7" data-hero-motion data-hero-listening>
      <Listening />
    </div>

    <!-- GitHub Activity -->
    <div class="hero-animate" data-hero-motion data-hero-github>
      <GitHubContributions />
    </div>

    <!-- Tech Stack Marquee -->
    <div class="mt-6 hero-animate" data-hero-motion data-hero-tech>
      <TechMarquee row1={techRow1} row2={techRow2} />
    </div>
</header>

<style>
  .hero-section {
    min-height: calc(100vh - 120px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media (min-width: 640px) {
    .hero-section {
      min-height: calc(100vh - 140px);
    }
  }

  :global(html.js) .hero-animate {
    opacity: 0;
    transform: translateY(20px);
    will-change: opacity, transform;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .hero-animate {
      opacity: 1;
      transform: none;
    }
  }

  .status-text-wrapper {
    display: inline-block;
    height: 1.2em;
    line-height: 1.2em;
    overflow: hidden;
    vertical-align: middle;
    position: relative;
  }

  .status-text {
    display: inline-block;
    line-height: 1.2em;
  }

  /* Personal info styling */
  .separator {
    opacity: 0.5;
  }

  /* Hidden SVG filter container */
  .liquid-glass-filters {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* Social Links with Dropdown Details */
  .social-link-wrapper {
    position: relative;
    display: inline-block;
  }

  .magnetic-button {
    display: inline-flex;
    align-items: center;
  }

</style>

<script>
  const prefersReducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
  const heroElements = document.querySelectorAll('.hero-animate');
  const statusText = document.getElementById('status-text');

  // Status text rotation
  const statusWords = [
    'Wondering',
    'Building',
    'Learning',
    'Exploring',
    'Creating',
    'Thinking',
    'Coding',
    'Designing',
    'Reading',
    'Writing',
    'Debugging',
    'Shipping',
    'Dreaming',
    'Hacking',
    'Optimizing',
    'Iterating',
    'Refactoring',
    'Brewing',
    'Crafting',
    'Tinkering',
    'Pondering',
    'Researching',
    'Prototyping',
    'Deploying',
    'Solving'
  ];

  const initHero = async () => {
    if (!heroElements.length) return;
    const { default: gsap } = await import('gsap');

    // Set initial states
    gsap.set(heroElements, { opacity: 0, y: 20 });

    // Create master timeline for hero section
    const heroTl = gsap.timeline({
      defaults: { ease: 'power3.out' }
    });

    // Animate each element with stagger
    heroTl.to(heroElements, {
      opacity: 1,
      y: 0,
      duration: 0.6,
      stagger: 0.1
    });

    const magneticButtons = document.querySelectorAll('[data-magnetic]');
    magneticButtons.forEach((button) => {
      const element = button as HTMLElement;
      const strength = Number.parseFloat(element.getAttribute('data-strength') || '0.3');
      const quickX = gsap.quickTo(element, 'x', {
        duration: 0.3,
        ease: 'power2.out'
      });
      const quickY = gsap.quickTo(element, 'y', {
        duration: 0.3,
        ease: 'power2.out'
      });
      let bounds: DOMRect | null = null;

      const updateBounds = () => {
        bounds = element.getBoundingClientRect();
      };

      const handlePointerEnter = (event: PointerEvent) => {
        if (event.pointerType && event.pointerType !== 'mouse') return;
        updateBounds();
      };

      const handlePointerMove = (event: PointerEvent) => {
        if (event.pointerType && event.pointerType !== 'mouse') return;
        if (!bounds) {
          updateBounds();
        }
        if (!bounds) return;

        const { left, top, width, height } = bounds;
        const centerX = left + width / 2;
        const centerY = top + height / 2;

        const deltaX = (event.clientX - centerX) * strength;
        const deltaY = (event.clientY - centerY) * strength;

        quickX(deltaX);
        quickY(deltaY);
      };

      const handlePointerLeave = (event: PointerEvent) => {
        if (event.pointerType && event.pointerType !== 'mouse') return;
        bounds = null;
        gsap.to(element, {
          x: 0,
          y: 0,
          duration: 0.5,
          ease: 'elastic.out(1, 0.3)'
        });
      };

      element.style.willChange = 'transform';
      element.addEventListener('pointerenter', handlePointerEnter, { passive: true });
      element.addEventListener('pointermove', handlePointerMove, { passive: true });
      element.addEventListener('pointerleave', handlePointerLeave, { passive: true });
    });

    if (statusText) {
      let currentIndex = 0;

      const rotateStatus = () => {
        // Animate out
        gsap.to(statusText, {
          y: '-120%',
          opacity: 0,
          duration: 0.3,
          ease: 'power2.in',
          onComplete: () => {
            currentIndex = (currentIndex + 1) % statusWords.length;
            statusText.textContent = statusWords[currentIndex];

            // Reset position and animate in
            gsap.fromTo(statusText,
              { y: '120%', opacity: 0 },
              { y: '0%', opacity: 1, duration: 0.3, ease: 'power2.out' }
            );
          }
        });
      };

      // Start rotation after hero animation completes
      heroTl.call(() => {
        setInterval(rotateStatus, 3000);
      });
    }
  };

  if (!prefersReducedMotion) {
    void initHero();
  }
</script>
