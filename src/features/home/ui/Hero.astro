---
import Typewriter from '@/features/home/ui/Typewriter.astro';
import GitHubContributions from '@/features/home/ui/GitHubContributions.astro';
import Listening from '@/features/home/ui/Listening.astro';
import TechMarquee from '@/features/home/ui/TechMarquee.astro';
import {Instagram, type LucideIcon} from 'lucide-react';
import { FileText, Github, Mail, Send } from 'lucide-react';
import type { ListeningTrack } from '@/features/home/server/listening';

interface Props {
  listeningTrack?: ListeningTrack;
}

const { listeningTrack } = Astro.props;

const socials: Array<{
  name: string;
  url: string;
  icon: LucideIcon;
  description: string;
  handle: string;
}> = [
  {
    name: 'Blog',
    url: 'https://blog.buxx.me',
    icon: FileText,
    description: 'Read my articles',
    handle: 'blog.buxx.me'
  },
  {
    name: 'GitHub',
    url: 'https://tuu.cat/gh',
    icon: Github,
    description: 'Check out my code',
    handle: '@bunizao'
  },
  {
    name: 'Email',
    url: 'mailto:me@buxx.me',
    icon: Mail,
    description: 'Send me a message',
    handle: 'me@buxx.me'
  },
  {
    name: 'Telegram',
    url: 'https://tuu.cat/tg',
    icon: Send,
    description: 'Chat with me',
    handle: 'tuu.cat/tg'
  },
  {
    name: 'Instagram',
    url: 'https://tuu.cat/ig',
    icon: Instagram,
    description: 'See my photos',
    handle: 'tuu.cat/ig'
  }
];

const techRow1 = ['TypeScript', "JavaScript", 'Python', 'C#', 'C++', 'React', 'TailwindCSS', 'Astro'];
const techRow2 = ['Frontend', 'BGP', 'Proxy', 'Docker', 'Linux', 'Web3', 'Optimization'];
---

<header class="hero-section pb-8 sm:pb-12">
    <!-- Status indicator -->
    <div class="hero-animate" data-hero-status>
      <div class="status mb-4">
        <span class="status-dot"></span>
        <span class="status-text-wrapper">
          <span class="status-text t-text-swap" id="status-text">Wondering</span>
        </span>
      </div>
    </div>

    <!-- Name -->
    <h1 class="hero-animate mb-2 text-[28px] font-semibold sm:text-[36px]" data-hero-name>
      <Typewriter words={["Bunizao", "Lucian", "Tutu", "Collapsar"]} />
    </h1>

    <!-- Personal Info -->
    <div class="hero-animate mb-3" data-hero-info>
      <p class="text-xs text-muted-foreground/70 tracking-wider font-mono">
        <span class="inline-flex items-center gap-2">
          <span>18 y.o.</span>
          <span class="separator">•</span>
          <span>INFP</span>
          <span class="separator">•</span>
          <span>Libra</span>
        </span>
      </p>
    </div>

    <!-- Role -->
    <p class="hero-animate mb-6 text-sm text-muted-foreground" data-hero-role>
      Student / Developer / Blogger
    </p>

    <!-- Bio -->
    <div class="hero-animate" data-hero-bio>
      <p class="text-[14px] leading-[1.7] text-muted-foreground sm:text-[15px]">
        I make interesting things.<br>
        Curious about <span class="text-foreground">frontend design</span>,
        <span class="text-foreground">proxy systems</span>, and
        contributing to <span class="text-foreground"> open source</span>.<br>
        Obsessed with <span class="text-foreground">speed</span> and always asking how things can be <span class="text-foreground">better</span>.<br>
        Outside of coding, I read for curiosity and write to make sense of things.<br>
        Currently studying Computer Science at <span class="text-foreground">Monash University</span>.
      </p>
    </div>

    <!-- Social Links -->
    <div class="mt-6 flex flex-wrap items-center gap-4 hero-animate sm:mt-8" data-hero-motion data-hero-socials>
      <span class="flex-none whitespace-nowrap text-[14px] text-muted-foreground sm:text-[15px]">Find me at</span>
      {socials.map((social) => (
        <div class="social-link-wrapper">
          <div class="magnetic-button" data-magnetic data-strength="0.4">
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="contact-link"
              title={social.name}
            >
              <social.icon className="h-4 w-4" aria-hidden="true" />
              <span class="hidden sm:inline">{social.name}</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <div class="hero-animate mt-6 sm:mt-7" data-hero-motion data-hero-listening>
      <Listening track={listeningTrack} />
    </div>

    <!-- GitHub Activity -->
    <div class="hero-animate" data-hero-motion data-hero-github>
      <GitHubContributions />
    </div>

    <!-- Tech Stack Marquee -->
    <div class="mt-6 hero-animate" data-hero-motion data-hero-tech>
      <TechMarquee row1={techRow1} row2={techRow2} />
    </div>
</header>

<style>
  .hero-section {
    min-height: calc(100vh - 120px);
    min-height: calc(100svh - 120px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    padding-top: calc(env(safe-area-inset-top, 0px) + 4.75rem);
  }

  @media (min-width: 640px) {
    .hero-section {
      min-height: calc(100vh - 140px);
      padding-top: 5rem;
    }
  }

  .status-text-wrapper {
    display: inline-block;
    line-height: 1.2em;
    vertical-align: middle;
    position: relative;
  }

  :global(html.js) .hero-animate:not([data-hero-name]) {
    opacity: 0;
    transform: translateY(20px);
    animation: hero-fade-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    will-change: opacity, transform;
  }

  :global(html.js) [data-hero-name] {
    opacity: 0;
    transform: translateY(20px);
    animation: hero-fade-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: 0.04s;
    will-change: opacity, transform;
  }

  :global(html.js) [data-hero-status] { animation-delay: 0s; }
  :global(html.js) [data-hero-info] { animation-delay: 0.12s; }
  :global(html.js) [data-hero-role] { animation-delay: 0.2s; }
  :global(html.js) [data-hero-bio] { animation-delay: 0.28s; }
  :global(html.js) [data-hero-socials] { animation-delay: 0.36s; }
  :global(html.js) [data-hero-listening] { animation-delay: 0.44s; }
  :global(html.js) [data-hero-github] { animation-delay: 0.52s; }
  :global(html.js) [data-hero-tech] { animation-delay: 0.6s; }

  @keyframes hero-fade-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .hero-animate {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  .t-text-swap {
    --text-swap-dur: 220ms;
    --text-swap-translate-y: 8px;
    --text-swap-blur: 2px;
    --text-swap-ease: cubic-bezier(0.22, 1, 0.36, 1);
    display: inline-block;
    transform: translateY(0);
    filter: blur(0);
    opacity: 1;
    transition:
      transform var(--text-swap-dur) var(--text-swap-ease),
      filter var(--text-swap-dur) var(--text-swap-ease),
      opacity var(--text-swap-dur) var(--text-swap-ease);
    will-change: transform, filter, opacity;
  }

  .t-text-swap.is-exit {
    transform: translateY(calc(var(--text-swap-translate-y) * -1));
    filter: blur(var(--text-swap-blur));
    opacity: 0;
  }

  .t-text-swap.is-enter-start {
    transform: translateY(var(--text-swap-translate-y));
    filter: blur(var(--text-swap-blur));
    opacity: 0;
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .t-text-swap {
      transition: none !important;
    }
  }

  /* Personal info styling */
  .separator {
    opacity: 0.5;
  }

  /* Hidden SVG filter container */
  .liquid-glass-filters {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* Social Links with Dropdown Details */
  .social-link-wrapper {
    position: relative;
    display: inline-block;
  }

  .magnetic-button {
    display: inline-flex;
    align-items: center;
  }

</style>

<script>
  const prefersReducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
  const statusText = document.getElementById('status-text');

  // Status text rotation
  const statusWords = [
    'Wondering',
    'Building',
    'Learning',
    'Exploring',
    'Creating',
    'Thinking',
    'Coding',
    'Designing',
    'Reading',
    'Writing',
    'Debugging',
    'Shipping',
    'Dreaming',
    'Hacking',
    'Optimizing',
    'Iterating',
    'Refactoring',
    'Brewing',
    'Crafting',
    'Tinkering',
    'Pondering',
    'Researching',
    'Prototyping',
    'Deploying',
    'Solving'
  ];

  const bindStatusRotation = () => {
    if (!statusText) return;
    let currentIndex = 0;
    const SWAP_DUR = 220;

    const rotateStatus = () => {
      statusText.classList.add('is-exit');

      setTimeout(() => {
        currentIndex = (currentIndex + 1) % statusWords.length;
        statusText.textContent = statusWords[currentIndex];
        statusText.classList.remove('is-exit');
        statusText.classList.add('is-enter-start');

        void statusText.offsetWidth;
        statusText.classList.remove('is-enter-start');
      }, SWAP_DUR);
    };

    window.addEventListener('tw:cycle', rotateStatus);
  };

  const bindMagneticButtons = async () => {
    const magneticButtons = document.querySelectorAll('[data-magnetic]');
    if (!magneticButtons.length) return;
    const { default: gsap } = await import('gsap');

    magneticButtons.forEach((button) => {
      const element = button as HTMLElement;
      const strength = Number.parseFloat(element.getAttribute('data-strength') || '0.3');
      const quickX = gsap.quickTo(element, 'x', {
        duration: 0.3,
        ease: 'power2.out'
      });
      const quickY = gsap.quickTo(element, 'y', {
        duration: 0.3,
        ease: 'power2.out'
      });
      let bounds: DOMRect | null = null;

      const updateBounds = () => {
        bounds = element.getBoundingClientRect();
      };

      const handlePointerEnter = (event: PointerEvent) => {
        if (event.pointerType && event.pointerType !== 'mouse') return;
        updateBounds();
      };

      const handlePointerMove = (event: PointerEvent) => {
        if (event.pointerType && event.pointerType !== 'mouse') return;
        if (!bounds) {
          updateBounds();
        }
        if (!bounds) return;

        const { left, top, width, height } = bounds;
        const centerX = left + width / 2;
        const centerY = top + height / 2;

        const deltaX = (event.clientX - centerX) * strength;
        const deltaY = (event.clientY - centerY) * strength;

        quickX(deltaX);
        quickY(deltaY);
      };

      const handlePointerLeave = (event: PointerEvent) => {
        if (event.pointerType && event.pointerType !== 'mouse') return;
        bounds = null;
        gsap.to(element, {
          x: 0,
          y: 0,
          duration: 0.5,
          ease: 'elastic.out(1, 0.3)'
        });
      };

      element.style.willChange = 'transform';
      element.addEventListener('pointerenter', handlePointerEnter, { passive: true });
      element.addEventListener('pointermove', handlePointerMove, { passive: true });
      element.addEventListener('pointerleave', handlePointerLeave, { passive: true });
    });
  };

  bindStatusRotation();
  if (!prefersReducedMotion) {
    void bindMagneticButtons();
  }
</script>
