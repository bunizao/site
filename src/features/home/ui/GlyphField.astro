---
// The monospace rain band behind the hero. Decorative: hidden from assistive
// tech, no pointer events, painted entirely by src/lib/glyph-field.ts.
//
// The band is a fixed 1200x560 canvas centred on the page and clipped by the
// host, so the mask edges stay off-screen on narrow viewports instead of
// squeezing the glyphs. The mask is the reference's: the field dissolves
// before the first section label and never reaches the viewport edges.
//
// The band is sticky inside a track the script sizes at runtime: it stays in
// the viewport while the rows collapse into one rule, then unpins with that
// rule one cell above `ruleTarget`, the first section's label, and scrolls
// away as its divider. See the collapse notes in src/lib/glyph-field.ts.
//
// Colour lives in src/features/home/glyph-inks.ts, one pair per hue.

interface Props {
  ruleTarget?: string;
}

const { ruleTarget = '#projects-section .section-label' } = Astro.props;
---

<div class="glyph-field-track" aria-hidden="true">
  <div class="glyph-field" data-glyph-field data-rule-target={ruleTarget}>
    <canvas width="1200" height="560"></canvas>
  </div>
</div>

<style>
  :global(#parallax-container) {
    position: relative;
  }

  .glyph-field-track {
    position: absolute;
    inset: 0 0 auto 0;
    /* Until the script measures the first section; keeps the band pinned
       through roughly one viewport of hero. */
    height: calc(100vh + 200px);
    pointer-events: none;
    z-index: 0;
  }

  .glyph-field {
    position: sticky;
    top: 0;
    height: 560px;
    /* Shared with the inner-page strip (src/components/GlyphStrip.astro), so
       leaving the homepage squashes the band into that row. */
    view-transition-name: glyph-field;
    display: flex;
    justify-content: center;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
    opacity: 0;
    transition: opacity 160ms ease-out;
  }

  .glyph-field.is-ready {
    opacity: 1;
  }

  .glyph-field canvas {
    display: block;
    flex: 0 0 auto;
    width: 1200px;
    height: 560px;
    -webkit-mask-image:
      linear-gradient(to bottom, #000 50%, transparent 96%),
      linear-gradient(to right, transparent, #000 18%, #000 82%, transparent);
    mask-image:
      linear-gradient(to bottom, #000 50%, transparent 96%),
      linear-gradient(to right, transparent, #000 18%, #000 82%, transparent);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }

  @media (prefers-reduced-motion: reduce) {
    .glyph-field {
      transition: none;
    }
  }
</style>

<script>
  import { mountGlyphField, type GlyphFieldHandle } from '@/lib/glyph-field';

  let handle: GlyphFieldHandle | null = null;

  const mount = () => {
    handle?.destroy();
    const host = document.querySelector<HTMLElement>('[data-glyph-field]');
    handle = host ? mountGlyphField(host) : null;
  };

  mount();
  // View transitions swap the DOM without re-running module scripts.
  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', () => {
    handle?.destroy();
    handle = null;
  });
</script>
