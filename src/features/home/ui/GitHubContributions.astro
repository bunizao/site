---
const username = 'bunizao';
const contributionDays = 30;
const placeholderBars = Array.from({ length: contributionDays });
---

<div
  class="activity-section is-loading"
  data-contributions
  data-username={username}
  data-days={contributionDays}
  aria-busy="true"
>
  <div class="activity-wave" aria-hidden="true">
    {placeholderBars.map((_, i) => (
      <div
        class="wave-bar"
        data-bar
        data-index={i}
        style={`--height: 6px; --delay: ${i * 0.03}s; height: 6px`}
      />
    ))}
    <div class="contribution-tooltip" data-tooltip aria-hidden="true">
      <span class="tooltip-count" data-tooltip-count>0</span>
      <span class="tooltip-date" data-tooltip-date></span>
    </div>
  </div>
  <div class="activity-stats">
    <a
      href={`https://github.com/${username}`}
      target="_blank"
      rel="noopener noreferrer"
      class="github-link"
    >
      @{username}
    </a>
    <span class="stat-label" data-total>
      <strong>—</strong> contributions
    </span>
  </div>
</div>

<script is:inline>
  const sections = document.querySelectorAll('[data-contributions]');
  const renderNextFrame = (callback) => {
    if ('requestAnimationFrame' in window) {
      window.requestAnimationFrame(() => callback());
      return;
    }

    setTimeout(callback, 0);
  };

  const schedule = (callback) => {
    const runWhenIdle = () => {
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(callback, { timeout: 3500 });
      } else {
        setTimeout(callback, 1500);
      }
    };

    if (document.readyState === 'complete') {
      runWhenIdle();
    } else {
      window.addEventListener('load', runWhenIdle, { once: true });
    }
  };

  const formatDate = (dateStr) => {
    const date = new Date(dateStr);
    return date.toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric'
    });
  };

  const setupTooltip = (section, contributionData) => {
    const wave = section.querySelector('.activity-wave');
    const tooltip = section.querySelector('[data-tooltip]');
    const countEl = tooltip.querySelector('[data-tooltip-count]');
    const dateEl = tooltip.querySelector('[data-tooltip-date]');

    wave.addEventListener('mousemove', (e) => {
      const bar = e.target.closest('[data-bar]');
      if (!bar) {
        tooltip.classList.remove('is-visible');
        return;
      }

      const index = parseInt(bar.dataset.index, 10);
      const dayData = contributionData[index];
      if (!dayData) return;

      const count = dayData.count;
      countEl.textContent = count === 1 ? '1 contribution' : `${count} contributions`;
      dateEl.textContent = formatDate(dayData.date);

      const barRect = bar.getBoundingClientRect();
      const waveRect = wave.getBoundingClientRect();
      const tooltipX = barRect.left - waveRect.left + barRect.width / 2;

      tooltip.style.setProperty('--tooltip-x', `${tooltipX}px`);
      tooltip.classList.add('is-visible');
    });

    wave.addEventListener('mouseleave', () => {
      tooltip.classList.remove('is-visible');
    });
  };

  // Bars grow from right (newest) to left (oldest), mirroring the bio decode
  // that grows left-to-right above. GROW_STEP is the per-bar stagger; once the
  // last bar has unfurled we hand off to the ambient breathing wave.
  const GROW_STEP = 0.025;
  const GROW_DURATION = 450;

  const updateSection = (section, data) => {
    const bars = Array.from(section.querySelectorAll('[data-bar]'));
    const totalEl = section.querySelector('[data-total]');

    const contributions = Array.isArray(data?.contributions) ? data.contributions : [];
    const visibleDays = contributions.slice(-bars.length);
    const maxCount = Math.max(...visibleDays.map((day) => day.count || 0), 1);

    visibleDays.forEach((day, index) => {
      const bar = bars[index];
      if (!bar) return;
      const baseHeight = 8;
      const dynamicHeight = (day.count / maxCount) * 36;
      const height = baseHeight + dynamicHeight;
      // Reverse the index so the rightmost bar leads and the wave unfurls left.
      const growDelay = (bars.length - 1 - index) * GROW_STEP;
      bar.style.transitionDelay = `${growDelay}s`;
      bar.style.setProperty('--height', `${height}px`);
      bar.style.height = `${height}px`;
    });

    setupTooltip(section, visibleDays);

    const totalContributions = data?.total?.lastYear ?? 0;
    if (totalEl) {
      totalEl.innerHTML = `<strong>${totalContributions}</strong> contributions`;
    }

    section.classList.remove('is-loading');
    section.classList.add('is-ready');
    section.setAttribute('aria-busy', 'false');

    // After the grow-in finishes, drop the stagger and let the bars breathe.
    const totalGrow = (bars.length - 1) * GROW_STEP * 1000 + GROW_DURATION;
    window.setTimeout(() => {
      bars.forEach((bar) => {
        bar.style.transitionDelay = '';
      });
      section.classList.add('is-breathing');
    }, totalGrow);
  };

  const loadContributions = async (section) => {
    const username = section.getAttribute('data-username');
    const days = section.getAttribute('data-days');
    if (!username) return;

    try {
      const params = new URLSearchParams({
        username,
        ...(days ? { days } : {}),
      });
      const response = await fetch(`/api/github/contributions?${params.toString()}`, {
        headers: {
          Accept: 'application/json',
        },
      });
      if (!response.ok) throw new Error('Failed to fetch contributions');
      const data = await response.json();
      renderNextFrame(() => updateSection(section, data));
    } catch (error) {
      console.error('Failed to fetch GitHub contributions:', error);
      renderNextFrame(() => {
        const totalEl = section.querySelector('[data-total]');
        if (totalEl) {
          totalEl.textContent = 'Contributions unavailable';
        }
        section.classList.remove('is-loading');
        section.classList.add('is-error');
        section.setAttribute('aria-busy', 'false');
      });
    }
  };

  sections.forEach((section) => {
    schedule(() => loadContributions(section));
  });
</script>

<style>
  .activity-section {
    margin-top: 1.5rem;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    min-height: 32px;
    width: 100%;
  }

  @media (min-width: 640px) {
    .activity-section {
      margin-top: 2.5rem;
      gap: 1.25rem;
    }
  }

  .activity-wave {
    position: relative;
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 28px;
    flex: 1;
    min-width: 0;
  }

  @media (min-width: 640px) {
    .activity-wave {
      gap: 3px;
      height: 32px;
    }
  }

  .wave-bar {
    flex: 1;
    max-width: 10px;
    height: var(--height);
    background: hsl(var(--foreground) / 0.35);
    transform-origin: bottom;
    transition: height 0.45s cubic-bezier(0.22, 1, 0.36, 1), background 0.2s ease;
    will-change: transform;
  }

  /* Ambient breathing wave — handed off after the right-to-left grow-in. */
  .activity-section.is-breathing .wave-bar {
    animation: wave 2s ease-in-out infinite;
    animation-delay: var(--delay);
  }

  @media (min-width: 640px) {
    .wave-bar {
      max-width: 14px;
    }
  }

  @keyframes wave {
    0%, 100% {
      transform: scaleY(1);
      opacity: 0.35;
    }
    50% {
      transform: scaleY(1.3);
      opacity: 0.7;
    }
  }

  .wave-bar:hover {
    background: hsl(var(--foreground));
    animation-play-state: paused;
  }

  .contribution-tooltip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: var(--tooltip-x, 0);
    transform: translateX(-50%);
    background: hsl(var(--background));
    border: 1px solid hsl(var(--foreground) / 0.15);
    border-radius: 6px;
    padding: 6px 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.15s ease, visibility 0.15s ease;
    white-space: nowrap;
    box-shadow: 0 2px 8px hsl(var(--foreground) / 0.08);
    z-index: 10;
  }

  .contribution-tooltip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-top-color: hsl(var(--foreground) / 0.15);
  }

  .contribution-tooltip::before {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 4px solid transparent;
    border-top-color: hsl(var(--background));
    z-index: 1;
  }

  .contribution-tooltip.is-visible {
    opacity: 1;
    visibility: visible;
  }

  .tooltip-count {
    font-size: 12px;
    font-weight: 600;
    color: hsl(var(--foreground));
  }

  .tooltip-date {
    font-size: 11px;
    color: hsl(var(--muted-foreground));
  }

  .activity-section.is-loading .wave-bar {
    opacity: 0.25;
  }

  @media (prefers-reduced-motion: reduce) {
    .wave-bar {
      transition: none;
    }

    .activity-section.is-breathing .wave-bar {
      animation: none;
    }
  }

  .activity-stats {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex-shrink: 0;
    text-align: right;
  }

  @media (min-width: 640px) {
    .activity-stats {
      text-align: left;
    }
  }

  .github-link {
    font-size: 13px;
    font-weight: 500;
    color: hsl(var(--foreground));
    text-decoration: none;
    transition: opacity 0.15s ease;
  }

  @media (min-width: 640px) {
    .github-link {
      font-size: 14px;
    }
  }

  .github-link:hover {
    opacity: 0.7;
  }

  .stat-label {
    font-size: 11px;
    color: hsl(var(--muted-foreground));
  }

  @media (min-width: 640px) {
    .stat-label {
      font-size: 12px;
    }
  }

  .stat-label strong {
    font-weight: 600;
    color: hsl(var(--foreground));
  }
</style>
