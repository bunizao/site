---
interface Props {
  username?: string;
  contributionDays?: number;
  endpoint?: string;
  /** Render a static synthetic wave and skip the live fetch — used by the
      components showcase, where every tile is a self-contained specimen. */
  demo?: boolean;
}

const {
  username = 'bunizao',
  contributionDays = 30,
  endpoint = '/api/github/contributions',
  demo = false,
} = Astro.props;

// A synthetic, organic-looking contribution wave for the demo specimen. Layered
// sines give it varied peaks and valleys without a live API or 30 magic numbers.
const demoHeights = demo
  ? Array.from({ length: contributionDays }, (_, i) => {
      const wave =
        Math.sin(i * 0.55) * 0.5 +
        Math.sin(i * 1.7 + 1.2) * 0.3 +
        Math.sin(i * 0.31 + 0.5) * 0.2;
      return Math.round(8 + ((wave + 1) / 2) * 30);
    })
  : null;
const demoTotal = 1284;

const placeholderBars = Array.from({ length: contributionDays });
---

<div
  class:list={['activity-section', demo ? ['is-ready', 'is-breathing'] : 'is-loading']}
  data-contribution-section
  data-contributions={demo ? undefined : true}
  data-username={username}
  data-days={contributionDays}
  data-endpoint={endpoint}
  aria-busy={demo ? 'false' : 'true'}
>
  <div class="activity-wave" aria-hidden="true">
    {placeholderBars.map((_, i) => {
      const h = demoHeights ? demoHeights[i] : 6;
      return (
        <div
          class="wave-bar"
          data-bar
          data-index={i}
          style={`--height: ${h}px; --delay: ${i * 0.03}s; height: ${h}px`}
        />
      );
    })}
    <div class="contribution-tooltip" data-tooltip aria-hidden="true">
      <span class="tooltip-count" data-tooltip-count>0</span>
      <span class="tooltip-date" data-tooltip-date></span>
    </div>
  </div>
  <div class="activity-stats">
    <a
      href={`https://github.com/${username}`}
      target="_blank"
      rel="noopener noreferrer"
      class="github-link"
    >
      @{username}
    </a>
    <span class="stat-label" data-total>
      <strong>{demo ? demoTotal : '—'}</strong> contributions
    </span>
  </div>
</div>

<script>
  // Processed, not `is:inline`: the source used to ride inside every HTML
  // response verbatim (~7KB). The build now minifies and type-checks it
  // (about half the bytes), and it still runs before DOMContentLoaded, so
  // the contributions request starts at the same point of the load.
  type ContributionDay = { date: string; count: number };
  type ContributionsPayload = { contributions?: ContributionDay[]; total?: { lastYear?: number } };
  type Callback = () => void;

  const heroWindow = window as Window & { __homeHeroGithubReady?: boolean };
  const sections = document.querySelectorAll<HTMLElement>('[data-contributions]');
  const contributionSections = document.querySelectorAll<HTMLElement>('[data-contribution-section]');
  const prefersReducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)');
  const GITHUB_READY_EVENT = 'home:hero-github-ready';
  const GITHUB_READY_FALLBACK_MS = 2600;
  const pendingGraphUpdates = new Set<Callback>();
  let graphCanRender = Boolean(prefersReducedMotion?.matches) || heroWindow.__homeHeroGithubReady === true;
  let graphFallbackTimer: number | undefined;

  const renderNextFrame = (callback: Callback) => {
    if ('requestAnimationFrame' in window) {
      window.requestAnimationFrame(() => callback());
      return;
    }

    setTimeout(callback, 0);
  };

  const flushGraphUpdates = () => {
    if (graphCanRender) return;

    graphCanRender = true;
    window.clearTimeout(graphFallbackTimer);
    pendingGraphUpdates.forEach((callback) => renderNextFrame(callback));
    pendingGraphUpdates.clear();
  };

  const renderWithHeroChain = (callback: Callback) => {
    if (!graphCanRender && heroWindow.__homeHeroGithubReady === true) {
      flushGraphUpdates();
    }

    if (graphCanRender) {
      renderNextFrame(callback);
      return;
    }

    pendingGraphUpdates.add(callback);
  };

  if (!graphCanRender) {
    window.addEventListener(GITHUB_READY_EVENT, flushGraphUpdates, { once: true });
    graphFallbackTimer = window.setTimeout(flushGraphUpdates, GITHUB_READY_FALLBACK_MS);
  }

  const hideTooltip = (section: HTMLElement) => {
    section.querySelector('[data-tooltip]')?.classList.remove('is-visible');
  };

  const updateBreathingState = (section: HTMLElement) => {
    const active = section.classList.contains('is-breathing')
      && section.dataset.inViewport === 'true'
      && document.visibilityState === 'visible'
      && !prefersReducedMotion?.matches;
    section.classList.toggle('is-breathing-active', active);
    if (!active) hideTooltip(section);
  };

  const updateAllBreathingStates = () => {
    contributionSections.forEach(updateBreathingState);
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      const section = entry.target as HTMLElement;
      section.dataset.inViewport = String(entry.isIntersecting);
      updateBreathingState(section);
    });
  });

  contributionSections.forEach((section) => observer.observe(section));
  document.addEventListener('visibilitychange', updateAllBreathingStates);
  prefersReducedMotion?.addEventListener('change', updateAllBreathingStates);

  const schedule = (callback: Callback) => {
    const runAfterMarkup = () => renderNextFrame(callback);

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', runAfterMarkup, { once: true });
      return;
    }

    runAfterMarkup();
  };

  const formatDate = (dateStr: string) => {
    const date = new Date(dateStr);
    return date.toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric'
    });
  };

  const setupTooltip = (section: HTMLElement, contributionData: ContributionDay[]) => {
    const wave = section.querySelector<HTMLElement>('.activity-wave');
    const tooltip = section.querySelector<HTMLElement>('[data-tooltip]');
    const countEl = tooltip?.querySelector<HTMLElement>('[data-tooltip-count]');
    const dateEl = tooltip?.querySelector<HTMLElement>('[data-tooltip-date]');
    if (!wave || !tooltip || !countEl || !dateEl) return;

    wave.addEventListener('mousemove', (e) => {
      const bar = (e.target as Element | null)?.closest<HTMLElement>('[data-bar]');
      if (!bar) {
        tooltip.classList.remove('is-visible');
        return;
      }

      const index = parseInt(bar.dataset.index || '', 10);
      const dayData = contributionData[index];
      if (!dayData) return;

      const count = dayData.count;
      countEl.textContent = count === 1 ? '1 contribution' : `${count} contributions`;
      dateEl.textContent = formatDate(dayData.date);

      const barRect = bar.getBoundingClientRect();
      const waveRect = wave.getBoundingClientRect();
      const tooltipX = barRect.left - waveRect.left + barRect.width / 2;

      tooltip.style.setProperty('--tooltip-x', `${tooltipX}px`);
      tooltip.classList.add('is-visible');
    });

    wave.addEventListener('mouseleave', () => {
      tooltip.classList.remove('is-visible');
    });
  };

  // Bars grow from right (newest) to left (oldest), mirroring the bio decode
  // that grows left-to-right above. GROW_STEP is the per-bar stagger; once the
  // last bar has unfurled we hand off to the ambient breathing wave.
  const GROW_STEP = 0.025;
  const GROW_DURATION = 450;

  const updateSection = (section: HTMLElement, data: ContributionsPayload) => {
    const bars = Array.from(section.querySelectorAll<HTMLElement>('[data-bar]'));
    const totalEl = section.querySelector<HTMLElement>('[data-total]');

    const contributions = Array.isArray(data?.contributions) ? data.contributions : [];
    const visibleDays = contributions.slice(-bars.length);
    const maxCount = Math.max(...visibleDays.map((day) => day.count || 0), 1);

    visibleDays.forEach((day, index) => {
      const bar = bars[index];
      if (!bar) return;
      const baseHeight = 8;
      const dynamicHeight = (day.count / maxCount) * 36;
      const height = baseHeight + dynamicHeight;
      // Reverse the index so the rightmost bar leads and the wave unfurls left.
      const growDelay = (bars.length - 1 - index) * GROW_STEP;
      bar.style.transitionDelay = `${growDelay}s`;
      bar.style.setProperty('--height', `${height}px`);
      bar.style.height = `${height}px`;
    });

    setupTooltip(section, visibleDays);

    const totalContributions = data?.total?.lastYear ?? 0;
    if (totalEl) {
      totalEl.innerHTML = `<strong>${totalContributions}</strong> contributions`;
    }

    section.classList.remove('is-loading');
    section.classList.add('is-ready');
    section.setAttribute('aria-busy', 'false');

    // After the grow-in finishes, drop the stagger and let the bars breathe.
    const totalGrow = (bars.length - 1) * GROW_STEP * 1000 + GROW_DURATION;
    window.setTimeout(() => {
      bars.forEach((bar) => {
        bar.style.transitionDelay = '';
      });
      section.classList.add('is-breathing');
      updateBreathingState(section);
    }, totalGrow);
  };

  const loadContributions = async (section: HTMLElement) => {
    const username = section.getAttribute('data-username');
    const days = section.getAttribute('data-days');
    if (!username) return;

    try {
      const params = new URLSearchParams({
        username,
        ...(days ? { days } : {}),
      });
      const endpoint = section.getAttribute('data-endpoint') || '/api/github/contributions';
      const response = await fetch(`${endpoint}?${params.toString()}`, {
        headers: {
          Accept: 'application/json',
        },
      });
      if (!response.ok) throw new Error('Failed to fetch contributions');
      const data = (await response.json()) as ContributionsPayload;
      renderWithHeroChain(() => updateSection(section, data));
    } catch (error) {
      console.error('Failed to fetch GitHub contributions:', error);
      renderWithHeroChain(() => {
        const totalEl = section.querySelector('[data-total]');
        if (totalEl) {
          totalEl.textContent = 'Contributions unavailable';
        }
        section.classList.remove('is-loading');
        section.classList.add('is-error');
        section.setAttribute('aria-busy', 'false');
      });
    }
  };

  sections.forEach((section) => {
    schedule(() => loadContributions(section));
  });
</script>

<style>
  .activity-section {
    margin-top: 1.5rem;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    min-height: 32px;
    width: 100%;
  }

  @media (min-width: 640px) {
    .activity-section {
      margin-top: 2.5rem;
      gap: 1.25rem;
    }
  }

  .activity-wave {
    position: relative;
    display: flex;
    align-items: flex-end;
    /* space-between distributes any slack between the bars once they hit their
       max-width, so the wave fills the column at every width instead of
       clustering left and leaving a gap before the stats. */
    justify-content: space-between;
    gap: 2px;
    height: 28px;
    flex: 1;
    min-width: 0;
  }

  @media (min-width: 640px) {
    .activity-wave {
      gap: 3px;
      height: 32px;
    }
  }

  .wave-bar {
    flex: 1;
    max-width: 10px;
    height: var(--height);
    /* The resting tone the breathing loop used to average out at. */
    background: hsl(var(--foreground) / 0.2);
    transform-origin: bottom;
    transition: height 0.45s cubic-bezier(0.22, 1, 0.36, 1), background var(--dur-base) var(--ease);
  }

  /* One ripple after the right-to-left grow-in, then the bars hold still.
     They are data: a wave that kept stretching every bar by 30% on a loop
     turned a year of contributions into a screensaver. The ripple replays
     whenever the chart comes back into view (see updateBreathingState). */
  .activity-section.is-breathing-active .wave-bar {
    will-change: transform;
    animation: wave 1.6s ease-in-out 1;
    animation-delay: var(--delay);
  }

  @media (min-width: 640px) {
    .wave-bar {
      max-width: 14px;
    }
  }

  /* Scale only. The loop used to swing opacity between 0.35 and 0.7 as
     well, which with a single pass would snap every bar from its resting
     alpha to the keyframe's and back. */
  @keyframes wave {
    0%, 100% {
      transform: scaleY(1);
    }
    50% {
      transform: scaleY(1.3);
    }
  }

  .wave-bar:hover {
    background: var(--home-accent);
    animation-play-state: paused;
  }

  .contribution-tooltip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: var(--tooltip-x, 0);
    transform: translateX(-50%);
    background: var(--home-surface);
    border-radius: var(--radius-sm);
    padding: 6px 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--dur-fast) var(--ease), visibility var(--dur-fast) var(--ease);
    white-space: nowrap;
    /* The shared surface edge. The old border-drawn arrow could not follow a
       shadow edge, and the tooltip already sits centred on its bar. */
    box-shadow: var(--home-surface-shadow-hover);
    z-index: 10;
  }

  .contribution-tooltip.is-visible {
    opacity: 1;
    visibility: visible;
  }

  .tooltip-count {
    font-size: var(--home-text-meta);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--home-fg-primary);
  }

  .tooltip-date {
    font-size: var(--home-text-label);
    font-variant-numeric: tabular-nums;
    color: var(--home-fg-secondary);
  }

  .activity-section.is-loading .wave-bar {
    opacity: 0.25;
  }

  @media (prefers-reduced-motion: reduce) {
    .wave-bar {
      transition: none;
    }

    .activity-section.is-breathing-active .wave-bar {
      animation: none;
    }
  }

  .activity-stats {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex-shrink: 0;
    text-align: right;
  }

  @media (min-width: 640px) {
    .activity-stats {
      text-align: left;
    }
  }

  .github-link {
    font-size: var(--home-text-meta);
    font-weight: 500;
    color: var(--home-fg-primary);
    text-decoration: none;
    transition: opacity var(--dur-fast) var(--ease);
  }

  .github-link:hover {
    opacity: 0.7;
  }

  .stat-label {
    font-size: var(--home-text-label);
    font-variant-numeric: tabular-nums;
    color: var(--home-fg-secondary);
  }

  .stat-label strong {
    font-weight: 600;
    color: var(--home-fg-primary);
  }
</style>
