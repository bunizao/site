---
import dayjs from 'dayjs';
import { createE2EWritingPosts } from '@/features/home/server/e2e-fixtures';
import { fetchLatestGhostPosts, readGhostUrl } from '@/features/home/server/ghost-posts';
import { isE2ESiteFixtureEnabled } from '@/lib/e2e';

const ghostUrl = readGhostUrl(Astro.locals);
const useE2EFixture = isE2ESiteFixtureEnabled(Astro.locals);
const posts = useE2EFixture ? createE2EWritingPosts() : await fetchLatestGhostPosts({ locals: Astro.locals });
---

<section id="writing-section" class="writing-section" data-parallax="off">
  <span class="section-label scroll-reveal">Writing</span>

  {posts.length > 0 ? (
    <div class="post-list" data-writing-post-list>
      {posts.map((post, index) => {
        const primaryTag = post.tags?.find(t => t.visibility === 'public');
        return (
          <a href={post.url} target="_blank" rel="noopener noreferrer" class="post-item scroll-reveal-item" style={`--item-index: ${index}`}>
            <span class="post-title">{post.title}</span>
            <span class="post-meta">
              {primaryTag && (
                <span class="post-tag">{primaryTag.name}</span>
              )}
              <span class="post-date">{dayjs(post.published_at).format('YYYY.MM')}</span>
            </span>
          </a>
        );
      })}
    </div>
  ) : (
    <>
      <div class="post-list" data-writing-post-list hidden></div>
      <p class="text-sm text-muted-foreground" data-writing-empty>No posts yet.</p>
    </>
  )}

  <a
    href={ghostUrl}
    target="_blank"
    class="link scroll-reveal-link mt-6 text-sm text-muted-foreground"
  >
    Read all posts
  </a>
</section>

<style>
  .writing-section {
    /* Initial state handled by GSAP */
  }

  .scroll-reveal {
    /* Initial state handled by GSAP */
  }

  .scroll-reveal-item {
    /* Initial state handled by GSAP */
  }

  .scroll-reveal-link {
    /* Initial state handled by GSAP */
  }

  .post-list {
    display: flex;
    flex-direction: column;
  }

  .post-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 0;
    position: relative;
    transition: all 0.15s ease;
  }

  @media (min-width: 640px) {
    .post-item {
      flex-direction: row;
      justify-content: space-between;
      align-items: baseline;
      gap: 16px;
      padding: 14px 0;
    }
  }

  .post-item::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(to right, hsl(var(--foreground) / 0.1), transparent);
  }

  .post-item:last-child::after {
    display: none;
  }

  .post-item:hover {
    padding-left: 8px;
  }

  .post-title {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
  }

  .post-meta {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .post-meta {
      gap: 12px;
    }
  }

  .post-tag {
    font-size: 11px;
    font-weight: 400;
    color: hsl(var(--muted-foreground) / 0.7);
  }

  @media (min-width: 640px) {
    .post-tag {
      font-size: 12px;
    }
  }

  .post-date {
    font-size: 11px;
    font-weight: 300;
    color: hsl(var(--muted-foreground) / 0.5);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 640px) {
    .post-date {
      font-size: 12px;
    }
  }

  .post-item:hover .post-date,
  .post-item:hover .post-tag {
    color: hsl(var(--muted-foreground));
  }
</style>

<script>
  const writingSection = document.getElementById('writing-section');
  const writingPostList = writingSection?.querySelector<HTMLElement>('[data-writing-post-list]');
  const writingEmptyState = writingSection?.querySelector<HTMLElement>('[data-writing-empty]');
  let gsapPromise: Promise<typeof import('gsap')['default']> | null = null;

  interface WritingTag {
    name: string;
    visibility: 'public' | 'internal';
  }

  interface WritingPost {
    title: string;
    url: string;
    published_at: string;
    tags?: WritingTag[];
  }

  const escapeHtml = (value: string): string => value
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#39;');

  const formatPostDate = (value: string): string => {
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return '';

    return `${date.getUTCFullYear()}.${String(date.getUTCMonth() + 1).padStart(2, '0')}`;
  };

  const renderWritingPost = (post: WritingPost, index: number): string => {
    const primaryTag = post.tags?.find(tag => tag.visibility === 'public');
    const tagHtml = primaryTag
      ? `<span class="post-tag">${escapeHtml(primaryTag.name)}</span>`
      : '';
    const dateHtml = formatPostDate(post.published_at);

    return [
      `<a href="${escapeHtml(post.url)}" target="_blank" rel="noopener noreferrer" class="post-item scroll-reveal-item" style="--item-index: ${index}">`,
      `<span class="post-title">${escapeHtml(post.title)}</span>`,
      '<span class="post-meta">',
      tagHtml,
      dateHtml ? `<span class="post-date">${escapeHtml(dateHtml)}</span>` : '',
      '</span>',
      '</a>',
    ].join('');
  };

  const hydrateWritingPosts = async (): Promise<void> => {
    if (!writingPostList || writingPostList.querySelector('.post-item')) return;

    try {
      const response = await fetch('/api/writing', {
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) return;

      const payload = await response.json() as { posts?: WritingPost[] };
      const posts = Array.isArray(payload.posts) ? payload.posts : [];
      if (!posts.length) return;

      writingPostList.innerHTML = posts.map(renderWritingPost).join('');
      writingPostList.hidden = false;
      writingEmptyState?.remove();
    } catch {
      // Keep the build-time empty state when runtime Ghost hydration fails.
    }
  };

  const loadGsap = async (): Promise<typeof import('gsap')['default']> => {
    gsapPromise ??= Promise.all([
      import('gsap'),
      import('gsap/ScrollTrigger'),
    ]).then(([{ default: gsap }, { ScrollTrigger }]) => {
      gsap.registerPlugin(ScrollTrigger);
      return gsap;
    });

    return gsapPromise;
  };

  const initWriting = async () => {
    const gsap = await loadGsap();

    if (writingSection) {
      // Set initial states
      gsap.set(writingSection, { opacity: 0, y: 40 });

      const label = writingSection.querySelector('.scroll-reveal');
      const items = Array.from(writingSection.querySelectorAll('.scroll-reveal-item'));
      const link = writingSection.querySelector('.scroll-reveal-link');

      if (label) gsap.set(label, { opacity: 0, y: 16 });
      if (items.length) gsap.set(items, { opacity: 0, x: -20 });
      if (link) gsap.set(link, { opacity: 0 });

      // Create timeline
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: writingSection,
          start: 'top 85%',
          once: true
        }
      });

      tl.to(writingSection, {
        opacity: 1,
        y: 0,
        duration: 0.6,
        ease: 'power2.out'
      });

      if (label) {
        tl.to(label, {
          opacity: 1,
          y: 0,
          duration: 0.4,
          ease: 'power2.out'
        }, '-=0.3');
      }

      if (items.length) {
        tl.to(items, {
          opacity: 1,
          x: 0,
          duration: 0.4,
          ease: 'power2.out',
          stagger: 0.06
        }, '-=0.2');
      }

      if (link) {
        tl.to(link, {
          opacity: 1,
          duration: 0.4,
          ease: 'power2.out'
        }, '-=0.1');
      }
    }
  };

  if (writingSection) {
    window.addEventListener('load', async () => {
      await hydrateWritingPosts();
      void initWriting();
    }, { once: true });
  }
</script>
