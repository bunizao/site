---
import dayjs from 'dayjs';
import { createE2EWritingPosts } from '@/features/home/server/e2e-fixtures';
import { isE2ESiteFixtureEnabled } from '@/lib/e2e';

interface Tag {
  id: string;
  name: string;
  slug: string;
  visibility: 'public' | 'internal';
}

interface PostMeta {
  id: string;
  title: string;
  slug: string;
  published_at: string;
  tags: Tag[];
}

const ghostOrigin = readEnv(import.meta.env.GHOST_URL);
const writingPublicUrl = normalizeBaseUrl(readEnv(import.meta.env.WRITING_PUBLIC_URL));
const useE2EFixture = isE2ESiteFixtureEnabled(Astro.locals);

function readEnv(value: unknown): string {
  return typeof value === 'string' ? value.trim() : '';
}

function normalizeBaseUrl(value: string): string {
  return value.replace(/\/+$/, '');
}

function isExternalHref(href: string): boolean {
  return /^https?:\/\//i.test(href);
}

function getWritingHref(post: PostMeta): string {
  if (!writingPublicUrl || !post.slug) return '';
  return `${writingPublicUrl}/${encodeURIComponent(post.slug)}/`;
}

async function getLatestPosts(): Promise<PostMeta[]> {
  const apiKey = readEnv(import.meta.env.GHOST_CONTENT_APIKEY);
  if (!ghostOrigin || !apiKey) return [];

  let apiUrl: string;
  try {
    const url = new URL('/ghost/api/v3/content/posts/', ghostOrigin);
    url.searchParams.set('key', apiKey);
    url.searchParams.set('limit', '5');
    url.searchParams.set('fields', 'id,title,slug,published_at');
    url.searchParams.set('include', 'tags');
    url.searchParams.set('filter', 'visibility:public');
    apiUrl = url.href;
  } catch (error) {
    console.error('Invalid Ghost URL:', error);
    return [];
  }

  try {
    const res = await fetch(apiUrl);
    const result = await res.json() as { posts?: PostMeta[] };
    return Array.isArray(result.posts) ? result.posts : [];
  } catch (error) {
    console.error('Failed to fetch posts:', error);
    return [];
  }
}

const posts = useE2EFixture ? createE2EWritingPosts() : await getLatestPosts();
---

<section id="writing-section" class="writing-section" data-parallax="off">
  <span class="section-label scroll-reveal">Writing</span>

  {posts.length > 0 ? (
    <div class="post-list">
      {posts.map((post, index) => {
        const primaryTag = post.tags?.find(t => t.visibility === 'public');
        const href = getWritingHref(post);
        const isExternal = isExternalHref(href);
        const itemClass = `post-item scroll-reveal-item${href ? '' : ' post-item--static'}`;
        const content = (
          <>
            <span class="post-title">{post.title}</span>
            <span class="post-meta">
              {primaryTag && (
                <span class="post-tag">{primaryTag.name}</span>
              )}
              <span class="post-date">{dayjs(post.published_at).format('YYYY.MM')}</span>
            </span>
          </>
        );
        return (
          href ? (
            <a
              href={href}
              target={isExternal ? '_blank' : undefined}
              rel={isExternal ? 'noopener noreferrer' : undefined}
              class={itemClass}
              style={`--item-index: ${index}`}
            >
              {content}
            </a>
          ) : (
            <div class={itemClass} style={`--item-index: ${index}`}>
              {content}
            </div>
          )
        );
      })}
    </div>
  ) : (
    <p class="text-sm text-muted-foreground">No posts yet.</p>
  )}

  {writingPublicUrl ? (
    <a
      href={writingPublicUrl}
      target={isExternalHref(writingPublicUrl) ? '_blank' : undefined}
      rel={isExternalHref(writingPublicUrl) ? 'noopener noreferrer' : undefined}
      class="link scroll-reveal-link mt-6 text-sm text-muted-foreground"
    >
      Read all posts
    </a>
  ) : null}
</section>

<style>
  .writing-section {
    /* Initial state handled by GSAP */
  }

  .scroll-reveal {
    /* Initial state handled by GSAP */
  }

  .scroll-reveal-item {
    /* Initial state handled by GSAP */
  }

  .scroll-reveal-link {
    /* Initial state handled by GSAP */
  }

  .post-list {
    display: flex;
    flex-direction: column;
  }

  .post-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 0;
    position: relative;
    transition: all 0.15s ease;
  }

  @media (min-width: 640px) {
    .post-item {
      flex-direction: row;
      justify-content: space-between;
      align-items: baseline;
      gap: 16px;
      padding: 14px 0;
    }
  }

  .post-item::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(to right, hsl(var(--foreground) / 0.1), transparent);
  }

  .post-item:last-child::after {
    display: none;
  }

  .post-item:not(.post-item--static):hover {
    padding-left: 8px;
  }

  .post-item--static {
    cursor: default;
  }

  .post-title {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
  }

  .post-meta {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .post-meta {
      gap: 12px;
    }
  }

  .post-tag {
    font-size: 11px;
    font-weight: 400;
    color: hsl(var(--muted-foreground) / 0.7);
  }

  @media (min-width: 640px) {
    .post-tag {
      font-size: 12px;
    }
  }

  .post-date {
    font-size: 11px;
    font-weight: 300;
    color: hsl(var(--muted-foreground) / 0.5);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 640px) {
    .post-date {
      font-size: 12px;
    }
  }

  .post-item:not(.post-item--static):hover .post-date,
  .post-item:not(.post-item--static):hover .post-tag {
    color: hsl(var(--muted-foreground));
  }
</style>

<script>
  const writingSection = document.getElementById('writing-section');
  let gsapPromise: Promise<typeof import('gsap')['default']> | null = null;

  const loadGsap = async (): Promise<typeof import('gsap')['default']> => {
    gsapPromise ??= Promise.all([
      import('gsap'),
      import('gsap/ScrollTrigger'),
    ]).then(([{ default: gsap }, { ScrollTrigger }]) => {
      gsap.registerPlugin(ScrollTrigger);
      return gsap;
    });

    return gsapPromise;
  };

  const initWriting = async () => {
    const gsap = await loadGsap();

    if (writingSection) {
      // Set initial states
      gsap.set(writingSection, { opacity: 0, y: 40 });

      const label = writingSection.querySelector('.scroll-reveal');
      const items = writingSection.querySelectorAll('.scroll-reveal-item');
      const link = writingSection.querySelector('.scroll-reveal-link');

      if (label) gsap.set(label, { opacity: 0, y: 16 });
      gsap.set(items, { opacity: 0, x: -20 });
      if (link) gsap.set(link, { opacity: 0 });

      // Create timeline
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: writingSection,
          start: 'top 85%',
          once: true
        }
      });

      tl.to(writingSection, {
        opacity: 1,
        y: 0,
        duration: 0.6,
        ease: 'power2.out'
      })
      .to(label, {
        opacity: 1,
        y: 0,
        duration: 0.4,
        ease: 'power2.out'
      }, '-=0.3')
      .to(items, {
        opacity: 1,
        x: 0,
        duration: 0.4,
        ease: 'power2.out',
        stagger: 0.06
      }, '-=0.2')
      .to(link, {
        opacity: 1,
        duration: 0.4,
        ease: 'power2.out'
      }, '-=0.1');
    }
  };

  if (writingSection) {
    window.addEventListener('load', () => {
      void initWriting();
    }, { once: true });
  }
</script>
