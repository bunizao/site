---
// Home "Writing" section — an English doorway into the Chinese blog, not a feed.
//
// The blog is its own publication (separate mark, voice, tagline). So this
// section's job is to *introduce the place and step back*: lead with the
// publication's sign (mark + wordmark + tagline), show the three latest titles
// as a teaser, then hand off through one deliberate door. Data is the same
// build-time content provider the /blog page reads — no external Ghost feed,
// no runtime hydration. One snapshot, one source of truth.
import { blog } from '@/data/site';
import { getTagLabel } from '@/features/posts/display';
import { postPath, postTitleTransitionName } from '@/features/posts/format';
import { getAllPosts } from '@/features/posts/server/content';
import HoverGloss from '@/components/HoverGloss.astro';

const locale = blog.locale.home;
const posts = (await getAllPosts()).slice(0, 3);
const blogCopy = blog.copy[locale];

// Quiet "YYYY.MM" stamp, UTC-fixed so SSG output stays deterministic.
const stamp = (iso: string): string => {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return '';
  return `${d.getUTCFullYear()}.${String(d.getUTCMonth() + 1).padStart(2, '0')}`;
};
---

<section id="writing-section" class="writing-section" data-reveal>
  <span class="section-label" data-reveal-item style="--reveal-i: 0">Writing</span>

  <HoverGloss
    class="writing-gloss"
    body={blog.sillage.body.en}
    authorName={blog.author.name}
    authorAvatar={blog.author.avatar}
    time={blog.sillage.date}
    image={blog.sillage.image}
    imageAlt={blog.sillage.imageAlt}
    label={`Why ${blogCopy.name}?`}
  >
    <a class="writing-portal" href="/blog/" aria-label={`Enter ${blogCopy.name}`} data-gloss-trigger data-reveal-item style="--reveal-i: 1">
      <span class="writing-portal__mark" style="view-transition-name:blog-mark" aria-hidden="true">
        <img src={blog.mark} alt="" width="48" height="48" loading="lazy" decoding="async" />
      </span>
      <span class="writing-portal__id">
        <span class="writing-portal__wordmark">{blogCopy.name}</span>
        <span class="writing-portal__tagline">{blogCopy.tagline}</span>
      </span>
    </a>
  </HoverGloss>

  {posts.length > 0 && (
    <div class="post-list" data-writing-post-list>
      {posts.map((post, index) => {
        const tag = post.tags?.find((t) => t.visibility === 'public');
        return (
          <a
            href={postPath(post.slug)}
            class="post-item"
            data-reveal-item
            style={`--reveal-i: ${index + 2}`}
          >
            {/* Same per-slug name as the article <h1> → the clicked home title
                morphs into the post headline, matching the /blog list behaviour. */}
            <span
              class="post-title"
              style={`view-transition-name:${postTitleTransitionName(post.slug)};view-transition-class:post-title`}
            >{post.title}</span>
            <span class="post-meta">
              {tag && <span class="post-tag">{getTagLabel(tag, locale)}</span>}
              <span class="post-date">{stamp(post.publishedAt)}</span>
            </span>
          </a>
        );
      })}
    </div>
  )}

  <a href="/blog/" class="link writing-enter" data-reveal-item style={`--reveal-i: ${posts.length + 2}`}>Enter {blogCopy.name}</a>
</section>

<style>
  /* Writing reads in the human voice (Inter), matching the publication it opens
     into. The metadata spine — tags and date stamps — stays on the mono identity
     thread that runs through Hero and Experience. */
  :global(#writing-section) {
    font-family: var(--font-sans);
  }

  /* The publication's sign above the door: mark + wordmark + tagline. Reads as a
     masthead, not a button — the affordance is the whole block being clickable. */
  :global(#writing-section .writing-portal) {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 20px;
    /* Deliberately larger than the gap between list rows, so the three titles
       read as one group sitting under the masthead rather than as a fourth
       sibling in the same stack. */
    margin-bottom: 36px;
    text-decoration: none;
    color: inherit;
    width: fit-content;
  }

  :global(#writing-section .writing-portal__mark) {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.3, 1);
  }

  :global(#writing-section .writing-portal__mark img) {
    width: 48px;
    height: 48px;
    object-fit: contain;
    opacity: 0.9;
    transition: filter 0.3s ease;
  }

  :global(.dark #writing-section .writing-portal__mark img) {
    filter: invert(1);
  }

  :global(#writing-section .writing-portal:hover .writing-portal__mark) {
    transform: translateY(-2px) rotate(-3deg);
  }

  :global(#writing-section .writing-portal__id) {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  /* The shimmer's darkest stop used to fall to 0.26 alpha, which dragged the
     masthead below the post titles beneath it — a wordmark that periodically
     reads as disabled. It now sweeps between full and 0.55, so the highlight is
     visible as movement without ever inverting the hierarchy. */
  :global(#writing-section .writing-portal__wordmark) {
    --shimmer-base: hsl(var(--foreground));
    --shimmer-soft: hsl(var(--foreground) / 0.82);
    --shimmer-highlight: hsl(var(--foreground) / 0.55);
    font-size: var(--home-text-masthead);
    font-weight: var(--home-weight-masthead);
    letter-spacing: -0.02em;
    color: var(--shimmer-base);
    line-height: 1.15;
    background:
      linear-gradient(
        110deg,
        var(--shimmer-base) 0%,
        var(--shimmer-base) 30%,
        var(--shimmer-soft) 42%,
        var(--shimmer-highlight) 50%,
        var(--shimmer-soft) 58%,
        var(--shimmer-base) 70%,
        var(--shimmer-base) 100%
      );
    background-size: 280% 100%;
    background-position: 160% 0;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: writing-wordmark-shimmer 5.8s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(#writing-section .writing-portal__wordmark) {
      animation: none;
      background-position: 0 0;
    }
  }

  @keyframes writing-wordmark-shimmer {
    0%,
    12% {
      background-position: 160% 0;
    }
    78%,
    100% {
      background-position: -120% 0;
    }
  }

  /* The gloss wraps the masthead so its card anchors to the door; keep it a
     block sized to its content so layout matches the bare anchor it replaced.
     The whole masthead is the hover trigger (see data-gloss-trigger). */
  :global(#writing-section .writing-gloss) {
    display: block;
    width: fit-content;
  }

  /* While the gloss is open, lift the whole section above the later-painting Mood
     section so the card is never covered by it. */
  :global(#writing-section) {
    position: relative;
  }

  :global(#writing-section:has(.writing-gloss.is-open)) {
    z-index: 50;
  }

  :global(#writing-section .writing-portal__tagline) {
    font-size: var(--home-text-meta);
    font-weight: var(--home-weight-meta);
    letter-spacing: -0.005em;
    color: var(--home-fg-secondary);
    line-height: 1.45;
    text-wrap: pretty;
  }

  :global(#writing-section .post-list) {
    display: flex;
    flex-direction: column;
    position: relative;
    margin-inline: 0;
    padding-inline: 0;
  }

  /* cai.im sliding pill: a soft rounded rectangle that glides behind the
     hovered row (springy transform), injected + moved by hover-indicator.ts. */
  :global(#writing-section .post-indicator) {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 0;
    border-radius: 12px;
    background: hsl(var(--foreground) / 0.045);
    opacity: 0;
    pointer-events: none;
    /* Pre-promote so Safari composites the springy move on the GPU. */
    will-change: transform;
    transition:
      transform 0.46s cubic-bezier(0.25, 1.18, 0.45, 1.04),
      width 0.4s cubic-bezier(0.25, 1, 0.3, 1),
      height 0.4s cubic-bezier(0.25, 1, 0.3, 1),
      opacity 0.25s ease-out;
  }

  /* Post rows enter from the left, so give them the lateral variant of the
     shared reveal transform instead of the default vertical drift. */
  /* No `transition` shorthand here: the reveal system already owns opacity and
     transform on this element, and a shorthand would silently reset both its
     transform easing and its stagger delay. */
  :global(#writing-section .post-item) {
    --reveal-x: -16px;
    --reveal-y: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 10px;
    position: relative;
    z-index: 1;
    text-decoration: none;
  }

  @media (min-width: 640px) {
    :global(#writing-section .post-item) {
      flex-direction: row;
      justify-content: space-between;
      align-items: baseline;
      gap: 16px;
      padding: 13px 10px;
    }
  }

  /* No per-row hairlines: the sliding pill is the only hover decoration, so
     nothing crosses or competes with it. Rows breathe on their own padding. */

  /* While the cursor is on the list, the un-hovered rows recede. The ID here
     outranks the reveal system's `.is-revealed` rule, so this wins once the
     entrance is done — no inline styles to clear, unlike the GSAP version.
     Its own duration keeps the dim quicker than the 0.55s entrance. */
  :global(#writing-section .post-list.is-hovering .post-item:not(:hover)) {
    opacity: 0.5;
    transition-duration: 0.3s;
  }

  /* Titles are the loudest thing in this section after the masthead: same size
     as body prose but heavier and at full contrast. They used to sit at 14px/85%
     while the mood one-liners below ran 16px/100%, which read as the throwaway
     notes outranking the essays. */
  :global(#writing-section .post-title) {
    font-size: var(--home-text-body);
    font-weight: var(--home-weight-title);
    letter-spacing: -0.011em;
    line-height: 1.45;
    color: var(--home-fg-primary);
    transition:
      color 0.3s ease,
      transform 0.4s cubic-bezier(0.25, 1, 0.3, 1);
  }

  /* The pill holds still while the title leans into it — the cai.im tell that
     turns a static fill into a hover that feels alive. */
  :global(#writing-section .post-item:hover .post-title) {
    transform: translateX(4px);
  }

  :global(#writing-section .post-meta) {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-shrink: 0;
  }

  :global(#writing-section .post-tag),
  :global(#writing-section .post-date) {
    font-family: var(--font-mono);
    font-size: var(--home-text-meta);
    font-weight: var(--home-weight-meta);
    color: var(--home-fg-faint);
    transition: color 0.3s ease;
  }

  :global(#writing-section .post-date) {
    font-variant-numeric: tabular-nums;
  }

  :global(#writing-section .post-item:hover .post-date),
  :global(#writing-section .post-item:hover .post-tag) {
    color: var(--home-fg-secondary);
  }

  :global(#writing-section .writing-enter) {
    margin-top: 28px;
    font-size: var(--home-text-body);
    font-weight: var(--home-weight-body);
    letter-spacing: -0.011em;
    color: var(--home-fg-secondary);
    transition: color 0.3s ease, transform 0.3s ease;
  }

  :global(#writing-section .writing-enter:hover) {
    color: var(--home-fg-primary);
    transform: translateX(2px);
  }
</style>

<script>
  import { attachHoverIndicator } from '@/lib/hover-indicator';

  const writingPostList = document.querySelector<HTMLElement>('[data-writing-post-list]');

  if (writingPostList) {
    attachHoverIndicator(writingPostList, {
      itemSelector: '.post-item',
      indicatorClass: 'post-indicator',
      // Tight bleed so the pill hugs the single-line row instead of ballooning
      // into a table-selection bar. Horizontal padding lives on the row.
      padX: 0,
      padY: 2,
    });
  }
</script>
