---
import { ArrowUpRight } from 'lucide-react';
import { createE2EProjects } from '@/features/home/server/e2e-fixtures';
import { isE2ESiteFixtureEnabled } from '@/lib/e2e';
import {
  fetchGitHubPinnedRepos,
  fetchGitHubRepo,
  type GitHubPinnedRepoData
} from '@/lib/github';

const githubUsername = 'bunizao';

interface FallbackProjectConfig {
  name: string;
  repo: string;
  url: string;
  description: string;
  role: 'Author' | 'Contributor';
  tags: string[];
}

interface Project {
  name: string;
  url: string;
  description: string;
  role: 'Author' | 'Contributor';
  tags: string[];
  stars: number | null;
}

const fallbackProjectConfigs: FallbackProjectConfig[] = [
  {
    name: 'TutuBetterRules',
    repo: 'bunizao/TutuBetterRules',
    url: 'https://github.com/bunizao/TutuBetterRules',
    description: 'Proxy rules for Surge, Clash, and other proxy tools',
    role: 'Author',
    tags: ['Proxy', 'Network']
  },
  {
    name: 'Attegi',
    repo: 'bunizao/Attegi',
    url: 'https://github.com/bunizao/Attegi',
    description: 'A minimal and elegant Ghost theme',
    role: 'Author',
    tags: ['Ghost', 'Theme', 'TailwindCSS']
  },
  {
    name: 'Mirrored',
    repo: 'bunizao/Mirrored',
    url: 'https://github.com/bunizao/Mirrored',
    description: 'Automated mirror sync for container registries',
    role: 'Author',
    tags: ['CI/CD', 'Python', 'Automation']
  },
  {
    name: 'ogis',
    repo: 'bunizao/ogis',
    url: 'https://github.com/bunizao/ogis',
    description: 'Open Graph image generation service',
    role: 'Author',
    tags: ['Next.js', 'React', 'TypeScript']
  },
  {
    name: 'always-attend',
    repo: 'bunizao/always-attend',
    url: 'https://github.com/bunizao/always-attend',
    description: 'Automated attendance check-in tool',
    role: 'Author',
    tags: ['Python', 'CLI', 'Automation']
  },
  {
    name: 'Mole',
    repo: 'tw93/Mole',
    url: 'https://github.com/tw93/Mole',
    description: 'A simple macOS app to manage SSH tunnels',
    role: 'Contributor',
    tags: ['Shell', 'macOS', 'CLI']
  }
];

const runtimeEnv = Astro.locals?.runtime?.env;
const useE2EFixture = isE2ESiteFixtureEnabled(Astro.locals);

function mapPinnedRepoToProject(repo: GitHubPinnedRepoData): Project {
  const tags = Array.from(
    new Set([repo.primaryLanguage, ...repo.topics].filter((tag): tag is string => Boolean(tag)))
  ).slice(0, 3);

  return {
    name: repo.name,
    url: repo.url,
    description: repo.description || 'Pinned repository on GitHub',
    role: repo.owner.toLowerCase() === githubUsername.toLowerCase() ? 'Author' : 'Contributor',
    tags: tags.length > 0 ? tags : ['GitHub'],
    stars: repo.stars
  };
}

async function loadProjects(): Promise<Project[]> {
  if (useE2EFixture) {
    return createE2EProjects();
  }

  const pinnedRepos = await fetchGitHubPinnedRepos(githubUsername, import.meta.env, runtimeEnv);
  if (pinnedRepos !== null) {
    return pinnedRepos.map(mapPinnedRepoToProject);
  }

  return Promise.all(
    fallbackProjectConfigs.map(async (config) => {
      const githubData = await fetchGitHubRepo(config.repo, import.meta.env, runtimeEnv);
      return {
        name: config.name,
        url: config.url,
        description: githubData?.description || config.description,
        role: config.role,
        tags: config.tags,
        stars: githubData?.stars ?? null,
      };
    })
  );
}

const projects = await loadProjects();
---

<section id="projects-section" class="projects-section" data-parallax="off">
  <span class="section-label scroll-reveal">Projects</span>

  <div class="project-list">
    {projects.map((project, index) => (
      <div class="tilt-card scroll-reveal-card" data-tilt style={`--card-index: ${index}`}>
        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          class="project-item"
        >
          <div class="card-glare" data-glare></div>
          <div class="project-content">
            <div class="project-header">
              <span class="project-name">{project.name}</span>
              {project.stars !== null && (
                <span class="project-stars">
                  <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor">
                    <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25z"/>
                  </svg>
                  {project.stars}
                </span>
              )}
            </div>
            <p class="project-desc">{project.description}</p>
          </div>
          <div class="project-footer">
            <span class="project-role">{project.role}</span>
            <div class="project-tags">
              {project.tags.slice(0, 2).map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </div>
          <ArrowUpRight className="project-arrow" aria-hidden="true" />
        </a>
      </div>
    ))}
  </div>

  <a
    href="https://github.com/bunizao"
    target="_blank"
    class="link mt-6 text-sm text-muted-foreground"
  >
    View all on GitHub
  </a>
</section>

<style>
  .projects-section {
    /* Initial hidden state - only opacity to prevent layout shift */
    opacity: 0;
  }

  .scroll-reveal-card {
    /* Initial hidden state - only opacity to prevent layout shift */
    opacity: 0;
  }

  /* For users who prefer reduced motion, show content immediately */
  @media (prefers-reduced-motion: reduce) {
    .projects-section,
    .scroll-reveal-card {
      opacity: 1;
    }
  }

  .project-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    max-width: 100%;
    /* Center the grid and add horizontal padding on mobile */
    padding: 0 16px;
  }

  @media (min-width: 480px) {
    .project-list {
      /* Limit max width on larger phones */
      max-width: 420px;
      margin: 0 auto;
      padding: 0;
    }
  }

  @media (min-width: 640px) {
    .project-list {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
      max-width: 100%;
      margin: 0;
    }
  }

  .tilt-card {
    perspective: 1000px;
    height: 100%;
  }

  .project-item {
    display: flex;
    flex-direction: column;
    position: relative;
    height: 100%;
    padding: 18px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 0;
    transition: border-color 0.25s ease, background 0.25s ease;
    transform-style: preserve-3d;
    will-change: transform;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .project-item {
      padding: 20px;
    }
  }

  .project-item:hover {
    border-color: hsl(var(--foreground) / 0.1);
    background: hsl(var(--foreground) / 0.015);
  }

  .card-glare {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    border-radius: inherit;
    opacity: 0;
    transition: opacity 0.2s ease;
    background: radial-gradient(
      600px circle at var(--glare-x, 50%) var(--glare-y, 50%),
      hsl(var(--foreground) / 0.06),
      transparent 40%
    );
  }

  .tilt-card:hover .card-glare {
    opacity: 1;
  }

  .project-content {
    flex: 1;
    min-height: 0;
  }

  .project-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 8px;
    padding-right: 24px;
  }

  .project-name {
    font-family: var(--font-display);
    font-weight: 460;
    font-variation-settings: 'opsz' 18, 'SOFT' 30, 'WONK' 0;
    font-size: 19px;
    letter-spacing: -0.015em;
    color: hsl(var(--foreground));
  }

  @media (min-width: 640px) {
    .project-name {
      font-size: 21px;
    }
  }

  .project-stars {
    display: flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: hsl(var(--muted-foreground) / 0.7);
    font-variant-numeric: tabular-nums;
  }

  .project-stars svg {
    opacity: 0.6;
  }

  .project-desc {
    font-size: 13px;
    color: hsl(var(--muted-foreground));
    line-height: 1.65;
    letter-spacing: 0.005em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: calc(13px * 1.65 * 2);
  }

  @media (min-width: 640px) {
    .project-desc {
      font-size: 14px;
      min-height: calc(14px * 1.65 * 2);
    }
  }

  .project-footer {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid hsl(var(--foreground) / 0.06);
  }

  .project-role {
    font-family: var(--font-display);
    font-weight: 400;
    font-variation-settings: 'opsz' 14, 'SOFT' 50, 'WONK' 0;
    font-size: 12px;
    text-transform: lowercase;
    letter-spacing: -0.005em;
    color: hsl(var(--muted-foreground));
    padding: 0;
    background: transparent;
    border-radius: 0;
    flex-shrink: 0;
  }

  .project-role::after {
    content: '·';
    margin-left: 8px;
    opacity: 0.4;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    flex: 1;
    min-width: 0;
  }

  .tag {
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: hsl(var(--muted-foreground) / 0.75);
    white-space: nowrap;
  }

  .tag:not(:last-child)::after {
    content: '·';
    margin-left: 8px;
    opacity: 0.4;
  }

  .project-arrow {
    position: absolute;
    right: 14px;
    top: 14px;
    width: 14px;
    height: 14px;
    color: hsl(var(--muted-foreground) / 0.25);
    transition: all 0.2s ease;
  }

  @media (min-width: 640px) {
    .project-arrow {
      right: 16px;
      top: 16px;
    }
  }

  .tilt-card:hover .project-arrow {
    color: hsl(var(--foreground) / 0.6);
    transform: translate(2px, -2px);
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const prefersReducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
  const projectsSection = document.getElementById('projects-section');
  const tiltCards = document.querySelectorAll('[data-tilt]');

  if (projectsSection && !prefersReducedMotion) {
    projectsSection.style.transform = 'translateY(60px)';
    projectsSection.querySelectorAll<HTMLElement>('.scroll-reveal-card').forEach((card) => {
      card.style.transform = 'translateY(40px) scale(0.95)';
    });
  }

  const initProjects = async () => {
    gsap.registerPlugin(ScrollTrigger);

    if (projectsSection) {
      const cards = projectsSection.querySelectorAll('.scroll-reveal-card');

      gsap.to(projectsSection, {
        opacity: 1,
        y: 0,
        duration: 0.6,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: projectsSection,
          start: 'top 85%',
          once: true
        }
      });

      gsap.to(cards, {
        opacity: 1,
        y: 0,
        scale: 1,
        duration: 0.5,
        ease: 'back.out(1.7)',
        stagger: 0.08,
        scrollTrigger: {
          trigger: projectsSection,
          start: 'top 85%',
          once: true
        }
      });
    }

    tiltCards.forEach((card) => {
      const item = card.querySelector('.project-item') as HTMLElement;
      const glare = card.querySelector('[data-glare]') as HTMLElement;

      if (!item) return;

      const maxTilt = 12;

      card.addEventListener('mouseenter', () => {
        if (glare) gsap.to(glare, { opacity: 1, duration: 0.2 });
      });

      card.addEventListener('mousemove', (e: Event) => {
        const event = e as MouseEvent;
        const rect = card.getBoundingClientRect();
        const x = event.clientX - rect.left;
        const y = event.clientY - rect.top;
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;

        const rotateY = ((x - centerX) / centerX) * maxTilt;
        const rotateX = ((centerY - y) / centerY) * maxTilt;

        gsap.to(item, {
          rotationX: rotateX,
          rotationY: rotateY,
          duration: 0.3,
          ease: 'power2.out'
        });

        if (glare) {
          const glareX = (x / rect.width) * 100;
          const glareY = (y / rect.height) * 100;
          gsap.to(glare, {
            '--glare-x': `${glareX}%`,
            '--glare-y': `${glareY}%`,
            duration: 0.2
          });
        }
      });

      card.addEventListener('mouseleave', () => {
        gsap.to(item, {
          rotationX: 0,
          rotationY: 0,
          duration: 0.5,
          ease: 'elastic.out(1, 0.3)'
        });

        if (glare) gsap.to(glare, { opacity: 0, duration: 0.2 });
      });
    });
  };

  if (!prefersReducedMotion && (projectsSection || tiltCards.length > 0)) {
    if (projectsSection && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          void initProjects();
        },
        { rootMargin: '500px 0px' }
      );
      observer.observe(projectsSection);
    } else {
      void initProjects();
    }
  }
</script>
