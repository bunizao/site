---
import ProjectStack from '@/components/project-cards/ProjectStack';
---

<section id="projects-section" class="projects-section" data-reveal aria-labelledby="projects-heading">
  <h2
    class="section-label" id="projects-heading"
    data-reveal-item
    style="--reveal-delay: 300ms; --reveal-duration: 400ms"
  >Projects</h2>

  <div
    class="projects-card"
    data-reveal-item
    style="--reveal-delay: 450ms; --reveal-duration: 450ms"
  >
    <ProjectStack client:visible />
  </div>
</section>
