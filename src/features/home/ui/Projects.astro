---
import ProjectStack from '@/components/project-cards/ProjectStack';
---

<section id="projects-section" class="projects-section" data-reveal aria-labelledby="projects-heading">
  <h2
    class="section-label" id="projects-heading"
    data-reveal-item
    style="--reveal-delay: 300ms; --reveal-duration: 400ms"
  >Projects</h2>

  <div
    class="projects-card"
    data-reveal-item
    style="--reveal-delay: 450ms; --reveal-duration: 450ms"
  >
    <ProjectStack client:visible />
  </div>

  <a
    href="/projects"
    class="link projects-enter"
    data-reveal-item
    style="--reveal-delay: 900ms; --reveal-duration: 400ms"
  >All projects</a>
</section>

<style>
  /* Every section that has a destination ends the same way: one link, one
     arrow, same offset. Writing and Moods already did; Projects had the
     deck and no way out of it. */
  .projects-enter {
    display: inline-block;
    margin-top: 28px;
    font-size: var(--home-text-body);
    font-weight: var(--home-weight-body);
    letter-spacing: var(--home-track-body);
    color: var(--home-fg-secondary);
  }
</style>
