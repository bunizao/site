---
import ProjectList from '@/components/home/ProjectList';
import { createE2EProjects } from '@/features/home/server/e2e-fixtures';
import { isE2ESiteFixtureEnabled } from '@/lib/e2e';
import {
  fetchGitHubPinnedRepos,
  fetchGitHubRepo,
  type GitHubPinnedRepoData
} from '@/lib/github';

const githubUsername = 'bunizao';

interface FallbackProjectConfig {
  name: string;
  repo: string;
  url: string;
  description: string;
  role: 'Author' | 'Contributor';
  tags: string[];
}

interface Project {
  name: string;
  url: string;
  description: string;
  role: 'Author' | 'Contributor';
  tags: string[];
  stars: number | null;
}

const fallbackProjectConfigs: FallbackProjectConfig[] = [
  {
    name: 'TutuBetterRules',
    repo: 'bunizao/TutuBetterRules',
    url: 'https://github.com/bunizao/TutuBetterRules',
    description: 'Proxy rules for Surge, Clash, and other proxy tools',
    role: 'Author',
    tags: ['Proxy', 'Network']
  },
  {
    name: 'Attegi',
    repo: 'bunizao/Attegi',
    url: 'https://github.com/bunizao/Attegi',
    description: 'A minimal and elegant Ghost theme',
    role: 'Author',
    tags: ['Ghost', 'Theme', 'TailwindCSS']
  },
  {
    name: 'Mirrored',
    repo: 'bunizao/Mirrored',
    url: 'https://github.com/bunizao/Mirrored',
    description: 'Automated mirror sync for container registries',
    role: 'Author',
    tags: ['CI/CD', 'Python', 'Automation']
  },
  {
    name: 'ogis',
    repo: 'bunizao/ogis',
    url: 'https://github.com/bunizao/ogis',
    description: 'Open Graph image generation service',
    role: 'Author',
    tags: ['Next.js', 'React', 'TypeScript']
  },
  {
    name: 'always-attend',
    repo: 'bunizao/always-attend',
    url: 'https://github.com/bunizao/always-attend',
    description: 'Automated attendance check-in tool',
    role: 'Author',
    tags: ['Python', 'CLI', 'Automation']
  },
  {
    name: 'Mole',
    repo: 'tw93/Mole',
    url: 'https://github.com/tw93/Mole',
    description: 'A simple macOS app to manage SSH tunnels',
    role: 'Contributor',
    tags: ['Shell', 'macOS', 'CLI']
  }
];

const runtimeEnv = Astro.locals?.runtime?.env;
const useE2EFixture = isE2ESiteFixtureEnabled(Astro.locals);

function mapPinnedRepoToProject(repo: GitHubPinnedRepoData): Project {
  const tags = Array.from(
    new Set([repo.primaryLanguage, ...repo.topics].filter((tag): tag is string => Boolean(tag)))
  ).slice(0, 3);

  return {
    name: repo.name,
    url: repo.url,
    description: repo.description || 'Pinned repository on GitHub',
    role: repo.owner.toLowerCase() === githubUsername.toLowerCase() ? 'Author' : 'Contributor',
    tags: tags.length > 0 ? tags : ['GitHub'],
    stars: repo.stars
  };
}

async function loadProjects(): Promise<Project[]> {
  if (useE2EFixture) {
    return createE2EProjects();
  }

  const pinnedRepos = await fetchGitHubPinnedRepos(githubUsername, import.meta.env, runtimeEnv);
  if (pinnedRepos !== null) {
    return pinnedRepos.map(mapPinnedRepoToProject);
  }

  return Promise.all(
    fallbackProjectConfigs.map(async (config) => {
      const githubData = await fetchGitHubRepo(config.repo, import.meta.env, runtimeEnv);
      return {
        name: config.name,
        url: config.url,
        description: githubData?.description || config.description,
        role: config.role,
        tags: config.tags,
        stars: githubData?.stars ?? null,
      };
    })
  );
}

const projects = await loadProjects();
---

<section id="projects-section" class="projects-section" data-parallax="off">
  <span class="section-label scroll-reveal">Projects</span>

  <div class="scroll-reveal-card">
    <ProjectList client:visible projects={projects} max={4} />
  </div>
</section>

<style>
  .projects-section,
  .scroll-reveal-card {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .projects-section,
    .scroll-reveal-card {
      opacity: 1;
    }
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
  const projectsSection = document.getElementById('projects-section');
  let gsapPromise: Promise<typeof import('gsap')['default']> | null = null;

  const loadGsap = async (): Promise<typeof import('gsap')['default']> => {
    gsapPromise ??= Promise.all([
      import('gsap'),
      import('gsap/ScrollTrigger'),
    ]).then(([{ default: gsap }, { ScrollTrigger }]) => {
      gsap.registerPlugin(ScrollTrigger);
      return gsap;
    });

    return gsapPromise;
  };

  const initProjects = async () => {
    const gsap = await loadGsap();
    if (!projectsSection) return;

    const label = projectsSection.querySelector('.scroll-reveal');
    const card = projectsSection.querySelector('.scroll-reveal-card');
    if (label) gsap.set(label, { opacity: 0, y: 16 });
    if (card) gsap.set(card, { opacity: 0, y: 24 });

    const tl = gsap.timeline({
      scrollTrigger: { trigger: projectsSection, start: 'top 85%', once: true }
    });

    tl.to(projectsSection, { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' });
    if (label) tl.to(label, { opacity: 1, y: 0, duration: 0.4, ease: 'power2.out' }, '-=0.3');
    if (card) tl.to(card, { opacity: 1, y: 0, duration: 0.45, ease: 'power2.out' }, '-=0.25');
  };

  if (projectsSection && !prefersReducedMotion) {
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          void initProjects();
        },
        { rootMargin: '500px 0px' }
      );
      observer.observe(projectsSection);
    } else {
      void initProjects();
    }
  }
</script>
