---
import { getListeningTracks } from '@/features/home/server/listening';

const tracks = await getListeningTracks();
const initialTrack = tracks[0] ?? null;
---

{initialTrack && (
  <section class="listening-section" data-parallax="off">
    <span class="section-label">Listening</span>

    <div class="listening-widget" data-listening>
      <div class="listening-bar">
        <a
          href={initialTrack.appleMusicUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="listening-cover-link"
          data-listening-link
          aria-label={`Open ${initialTrack.title} on Apple Music`}
        >
          <img
            src={initialTrack.artworkUrl}
            alt={`${initialTrack.title} cover art`}
            class="listening-cover"
            data-listening-cover
            loading="eager"
            decoding="async"
            referrerpolicy="no-referrer"
          />
        </a>

        <div class="listening-info">
          <p class="listening-title" data-listening-title>{initialTrack.title}</p>
          <p class="listening-artist" data-listening-artist>{initialTrack.artist}</p>
        </div>

        <button
          type="button"
          class="listening-play"
          data-listening-play
          disabled={!initialTrack.previewUrl}
          aria-pressed="false"
          aria-label={`Play preview of ${initialTrack.title}`}
        >
          <span class="listening-play-icon" aria-hidden="true"></span>
        </button>

        <button
          type="button"
          class="listening-toggle"
          data-listening-toggle
          aria-expanded="false"
          aria-label="Show track list"
        >
          <span class="listening-toggle-icon" aria-hidden="true"></span>
        </button>
      </div>

      <div class="listening-panel" data-listening-panel hidden>
        <ol class="listening-list" aria-label="Track list">
          {tracks.map((track, index) => (
            <li>
              <button
                type="button"
                class:list={['listening-item', { 'is-active': index === 0 }]}
                data-listening-item
                data-title={track.title}
                data-artist={track.artist}
                data-collection={track.collection}
                data-link={track.appleMusicUrl}
                data-artwork={track.artworkUrl}
                data-preview-url={track.previewUrl}
                data-year={track.year}
                data-genre={track.genre}
                data-release-kind={track.releaseKind}
                data-track-number={track.trackNumber}
                data-track-count={track.trackCount}
                aria-pressed={index === 0 ? 'true' : 'false'}
              >
                <img
                  src={track.thumbUrl}
                  alt=""
                  class="listening-thumb"
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                  aria-hidden="true"
                />
                <span class="listening-item-info">
                  <span class="listening-item-title">{track.title}</span>
                  <span class="listening-item-artist">{track.artist}</span>
                </span>
              </button>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>
)}

<style>
  .listening-section {
    padding-top: 8px;
  }

  .listening-widget {
    border-radius: 14px;
    background: hsl(var(--foreground) / 0.02);
    border: 1px solid hsl(var(--foreground) / 0.06);
    overflow: hidden;
  }

  .listening-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px;
  }

  .listening-cover-link {
    flex-shrink: 0;
    display: block;
    width: 48px;
    height: 48px;
    border-radius: 6px;
    overflow: hidden;
    background: hsl(var(--foreground) / 0.05);
    box-shadow: 0 2px 8px hsl(var(--foreground) / 0.1);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .listening-cover-link:hover {
    transform: scale(1.05);
    box-shadow: 0 4px 12px hsl(var(--foreground) / 0.15);
  }

  .listening-cover {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .listening-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .listening-title {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .listening-artist {
    font-size: 12px;
    color: hsl(var(--muted-foreground));
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .listening-play,
  .listening-toggle {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: 1px solid hsl(var(--foreground) / 0.1);
    border-radius: 50%;
    background: transparent;
    color: hsl(var(--foreground));
    transition: background 0.15s ease, color 0.15s ease, transform 0.15s ease, border-color 0.15s ease;
  }

  .listening-play:hover:not(:disabled),
  .listening-toggle:hover {
    background: hsl(var(--foreground));
    color: hsl(var(--background));
    transform: scale(1.08);
  }

  .listening-play:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .listening-play-icon {
    position: relative;
    width: 10px;
    height: 12px;
    display: inline-block;
    margin-left: 2px;
  }

  .listening-play-icon::before {
    content: '';
    position: absolute;
    inset: 0;
    clip-path: polygon(0 0, 100% 50%, 0 100%);
    background: currentColor;
    transition: clip-path 0.15s ease;
  }

  .listening-play.is-playing .listening-play-icon {
    margin-left: 0;
  }

  .listening-play.is-playing .listening-play-icon::before {
    clip-path: none;
    inset: 0;
    width: 10px;
    background:
      linear-gradient(to right, currentColor 0 3px, transparent 3px 7px, currentColor 7px 10px);
  }

  .listening-toggle-icon {
    position: relative;
    width: 10px;
    height: 6px;
    display: inline-block;
  }

  .listening-toggle-icon::before {
    content: '';
    position: absolute;
    inset: 0;
    clip-path: polygon(0 0, 50% 100%, 100% 0);
    background: currentColor;
    transition: transform 0.2s ease;
  }

  .listening-widget.is-expanded .listening-toggle-icon::before {
    transform: rotate(180deg);
  }

  .listening-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.25s ease;
  }

  .listening-widget.is-expanded .listening-panel {
    grid-template-rows: 1fr;
  }

  .listening-list {
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .listening-widget.is-expanded .listening-list {
    padding: 4px 12px 12px;
    border-top: 1px solid hsl(var(--foreground) / 0.06);
  }

  .listening-item {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 8px;
    border: none;
    border-radius: 8px;
    background: transparent;
    text-align: left;
    transition: background 0.15s ease;
  }

  .listening-item:hover {
    background: hsl(var(--foreground) / 0.04);
  }

  .listening-item.is-active {
    background: hsl(var(--foreground) / 0.06);
  }

  .listening-thumb {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: 4px;
    object-fit: cover;
    background: hsl(var(--foreground) / 0.05);
  }

  .listening-item-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .listening-item-title {
    font-size: 13px;
    font-weight: 500;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .listening-item-artist {
    font-size: 11px;
    color: hsl(var(--muted-foreground));
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (min-width: 640px) {
    .listening-bar {
      gap: 16px;
      padding: 14px 16px;
    }

    .listening-cover-link {
      width: 52px;
      height: 52px;
      border-radius: 8px;
    }

    .listening-title {
      font-size: 15px;
    }

    .listening-artist {
      font-size: 13px;
    }

    .listening-play,
    .listening-toggle {
      width: 36px;
      height: 36px;
    }

    .listening-widget.is-expanded .listening-list {
      padding: 8px 16px 16px;
    }

    .listening-item {
      padding: 10px;
    }

    .listening-thumb {
      width: 44px;
      height: 44px;
      border-radius: 6px;
    }

    .listening-item-title {
      font-size: 14px;
    }

    .listening-item-artist {
      font-size: 12px;
    }
  }
</style>

<script>
  import { initListeningSection } from '@/features/home/client/listening-controller';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initListeningSection, { once: true });
  } else {
    initListeningSection();
  }
</script>
