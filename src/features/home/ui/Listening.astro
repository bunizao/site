---
import type { ListeningTrack } from '@/features/home/types';
import appleLogo from '@/assets/apple-logo.svg?raw';
import {
  BLANK_LISTENING_ARTWORK,
  renderListeningCardMarkup,
} from '@/lib/listening/markup';
import '@/styles/listening.css';

interface Props {
  track?: ListeningTrack;
  /**
   * Freeze the widget on the given track: skip the client-side live refresh.
   * Used by the /components specimen so the demo is deterministic.
   */
  static?: boolean;
}

const { track, static: isStatic = false } = Astro.props;
const title = track?.title?.trim() || 'Loading track';
const artist = track?.artist?.trim() || 'Fetching';
const collection = track?.collection?.trim() || 'Last.fm';
const year = track?.year?.trim() || (track?.playedAt ? new Intl.DateTimeFormat(undefined, {
  month: 'short',
  day: 'numeric',
}).format(new Date(track.playedAt)) : 'Live');
const link = track?.appleMusicUrl?.trim() || track?.sourceUrl?.trim() || '';
const isAppleMusic = link.includes('music.apple.com');
const artwork = track?.thumbUrl?.trim() || track?.artworkUrl?.trim() || BLANK_LISTENING_ARTWORK;
const previewUrl = track?.previewUrl?.trim() || '';
const rawCatalogId = (track?.appleCatalogId || track?.catalogId || track?.id || '').trim();
const appleCatalogId = /^\d+$/u.test(rawCatalogId) ? rawCatalogId : '';
const isLive = Boolean(track?.isNowPlaying);
const hasTrack = Boolean(track);

const badgeHtml = isAppleMusic
  ? [
      '<span class="listening-art-label" role="img" aria-label="Apple Music">',
      '<span class="listening-art-label-lockup">',
      appleLogo.replace('<svg ', '<svg class="listening-art-label-logo" aria-hidden="true" '),
      '<span class="listening-art-label-text">Music</span>',
      '</span>',
      '</span>',
    ].join('')
  : '';

const cardHtml = renderListeningCardMarkup({
  title,
  artist,
  collection,
  year,
  artworkUrl: artwork,
  accent: track?.accent ?? null,
  linkUrl: hasTrack ? link : '',
  previewUrl,
  appleCatalogId,
  statusLabel: isLive ? 'Now Playing' : 'Recently Played',
  isLive,
  isLoading: !hasTrack,
  isStatic,
  badgeHtml,
});
---

<Fragment set:html={cardHtml} />

<script>
  import { autoInitListeningCards } from '@/lib/listening/controller';

  autoInitListeningCards();
</script>
