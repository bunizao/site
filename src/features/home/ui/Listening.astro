---
import { getListeningTracks } from '@/features/home/server/listening';

const tracks = await getListeningTracks();
const initialTrack = tracks[0] ?? null;
---

{initialTrack && (
  <aside class="listening-status" data-listening aria-label="Now playing">
    <div class="listening-copy">
      <p class="listening-kicker">
        <span class="listening-kicker-mark" aria-hidden="true"></span>
        <span>Now playing</span>
      </p>

      <a
        href={initialTrack.appleMusicUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="listening-track"
        data-listening-link
        aria-label={`Open ${initialTrack.title} on Apple Music`}
      >
        <span class="listening-title">{initialTrack.title}</span>
        <span class="listening-artist">{initialTrack.artist}</span>
      </a>

      <p class="listening-detail">
        <span>{initialTrack.collection}</span>
        <span aria-hidden="true">/</span>
        <span>{initialTrack.year}</span>
      </p>
    </div>

    <div class="listening-media">
      <a
        href={initialTrack.appleMusicUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="listening-cover-link"
        aria-label={`Open ${initialTrack.title} on Apple Music`}
      >
        <img
          src={initialTrack.artworkUrl}
          alt={`${initialTrack.title} cover art`}
          class="listening-cover"
          loading="eager"
          decoding="async"
          referrerpolicy="no-referrer"
        />
      </a>

      <button
        type="button"
        class="listening-play"
        data-listening-play
        data-preview-url={initialTrack.previewUrl}
        data-track-title={initialTrack.title}
        disabled={!initialTrack.previewUrl}
        aria-pressed="false"
        aria-label={`Play preview of ${initialTrack.title}`}
      >
        <span class="listening-play-ring" aria-hidden="true"></span>
        <span class="listening-play-icon" aria-hidden="true"></span>
      </button>
    </div>
  </aside>
)}

<style>
  .listening-status {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px 18px;
    width: fit-content;
    max-width: min(100%, 560px);
    color: hsl(var(--muted-foreground));
  }

  .listening-copy {
    min-width: 0;
    max-width: 360px;
  }

  .listening-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 8px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground) / 0.84);
  }

  .listening-kicker-mark {
    position: relative;
    width: 18px;
    height: 1px;
    background: currentColor;
    opacity: 0.48;
  }

  .listening-kicker-mark::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: hsl(var(--foreground));
    transform: translateY(-50%);
    animation: listening-pulse 1.8s ease-in-out infinite;
  }

  .listening-track {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 10px;
    min-width: 0;
    width: fit-content;
    max-width: 100%;
  }

  .listening-title,
  .listening-artist,
  .listening-detail span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .listening-title {
    max-width: 100%;
    font-size: 15px;
    line-height: 1.35;
    color: hsl(var(--foreground));
    transition: opacity 0.18s ease;
  }

  .listening-track:hover .listening-title {
    opacity: 0.72;
  }

  .listening-artist {
    font-size: 14px;
    line-height: 1.45;
    color: hsl(var(--muted-foreground));
  }

  .listening-detail {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 6px 0 0;
    min-width: 0;
    font-size: 12px;
    line-height: 1.4;
    color: hsl(var(--muted-foreground) / 0.82);
  }

  .listening-media {
    position: relative;
    width: 70px;
    min-width: 70px;
    padding: 2px 8px 8px 2px;
  }

  .listening-cover-link {
    position: relative;
    display: block;
    width: 56px;
    height: 56px;
    transition: transform 0.18s ease;
  }

  .listening-cover-link::before {
    content: '';
    position: absolute;
    inset: 6px -6px -6px 6px;
    border: 1px solid hsl(var(--foreground) / 0.12);
    border-radius: 8px;
    transition: transform 0.18s ease, border-color 0.18s ease;
  }

  .listening-cover-link:hover {
    transform: translate(-1px, -1px);
  }

  .listening-cover-link:hover::before {
    transform: translate(2px, 2px);
    border-color: hsl(var(--foreground) / 0.18);
  }

  .listening-cover {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 8px;
    object-fit: cover;
    box-shadow: 0 0 0 1px hsl(var(--foreground) / 0.08);
  }

  .listening-play {
    position: absolute;
    right: 0;
    bottom: 0;
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border: 1px solid hsl(var(--foreground) / 0.14);
    border-radius: 999px;
    background: hsl(var(--background) / 0.96);
    color: hsl(var(--foreground));
    transition:
      transform 0.18s ease,
      border-color 0.18s ease,
      background-color 0.18s ease,
      color 0.18s ease;
    backdrop-filter: blur(10px);
  }

  .listening-play:hover:not(:disabled) {
    transform: translateY(-1px);
    border-color: hsl(var(--foreground) / 0.22);
    background: hsl(var(--background));
  }

  .listening-play:disabled {
    opacity: 0.42;
    cursor: not-allowed;
  }

  .listening-play-ring,
  .listening-play-icon {
    position: absolute;
  }

  .listening-play-ring {
    inset: 4px;
    border: 1px solid hsl(var(--foreground) / 0.08);
    border-radius: inherit;
    transition: border-color 0.18s ease, transform 0.18s ease;
  }

  .listening-play-icon {
    width: 10px;
    height: 12px;
  }

  .listening-play-icon::before {
    content: '';
    position: absolute;
    inset: 0;
    clip-path: polygon(0 0, 100% 50%, 0 100%);
    background: currentColor;
  }

  .listening-play.is-playing .listening-play-ring {
    border-color: hsl(var(--foreground) / 0.16);
    transform: scale(1.04);
  }

  .listening-play.is-playing .listening-play-icon::before {
    clip-path: none;
    background: linear-gradient(to right, currentColor 0 3px, transparent 3px 7px, currentColor 7px 10px);
  }

  @media (max-width: 520px) {
    .listening-status {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
      width: 100%;
    }

    .listening-media {
      width: auto;
      min-width: 0;
      padding-right: 0;
    }
  }

  @media (max-width: 430px) {
    .listening-track {
      gap: 4px 8px;
    }

    .listening-title {
      font-size: 14px;
    }

    .listening-artist,
    .listening-detail {
      font-size: 12px;
    }

    .listening-media {
      padding-bottom: 4px;
    }

    .listening-cover-link {
      width: 52px;
      height: 52px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .listening-kicker-mark::before {
      animation: none;
    }

    .listening-cover-link,
    .listening-cover-link::before,
    .listening-play,
    .listening-play-ring,
    .listening-title {
      transition: none;
    }
  }

  @keyframes listening-pulse {
    0%,
    100% {
      transform: translateY(-50%) scale(1);
      opacity: 1;
    }

    50% {
      transform: translateY(-50%) scale(1.4);
      opacity: 0.55;
    }
  }
</style>

<script>
  const initListeningSection = () => {
    const roots = document.querySelectorAll('[data-listening]');

    roots.forEach((root) => {
      if (!(root instanceof HTMLElement) || root.dataset.bound === 'true') {
        return;
      }

      root.dataset.bound = 'true';

      const playButton = root.querySelector('[data-listening-play]');
      if (!(playButton instanceof HTMLButtonElement)) {
        return;
      }

      const previewUrl = playButton.dataset.previewUrl ?? '';
      const trackTitle = playButton.dataset.trackTitle ?? 'Track';
      const audio = previewUrl ? new Audio(previewUrl) : null;

      if (!audio) {
        playButton.disabled = true;
        playButton.setAttribute('aria-label', `${trackTitle} preview unavailable`);
        return;
      }

      audio.preload = 'none';

      const setPlayState = (isPlaying: boolean) => {
        playButton.classList.toggle('is-playing', isPlaying);
        playButton.setAttribute('aria-pressed', isPlaying ? 'true' : 'false');
        playButton.setAttribute('aria-label', `${isPlaying ? 'Pause' : 'Play'} preview of ${trackTitle}`);
      };

      playButton.addEventListener('click', async () => {
        if (audio.paused) {
          try {
            await audio.play();
            setPlayState(true);
          } catch {
            setPlayState(false);
          }

          return;
        }

        audio.pause();
        audio.currentTime = 0;
        setPlayState(false);
      });

      audio.addEventListener('ended', () => {
        setPlayState(false);
      });

      setPlayState(false);
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initListeningSection, { once: true });
  } else {
    initListeningSection();
  }
</script>
