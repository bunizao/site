---
import { getListeningTracks } from '@/features/home/server/listening';
import { Pause, Play } from 'lucide-react';

const tracks = await getListeningTracks();
const initialTrack = tracks[0] ?? null;
---

{initialTrack && (
  <aside class="listening" data-listening aria-label="Now playing">
    <button
      type="button"
      class="listening-art"
      data-listening-play
      data-preview-url={initialTrack.previewUrl}
      data-track-title={initialTrack.title}
      disabled={!initialTrack.previewUrl}
      aria-pressed="false"
      aria-label={`Play preview of ${initialTrack.title}`}
    >
      <span class="listening-art-shadow" aria-hidden="true"></span>
      <span class="listening-art-frame">
        <img
          src={initialTrack.artworkUrl}
          alt=""
          class="listening-art-img"
          data-listening-artwork
          crossorigin="anonymous"
          loading="eager"
          decoding="async"
          referrerpolicy="no-referrer"
        />
        <span class="listening-art-tint" aria-hidden="true"></span>
        <span class="listening-art-spindle" aria-hidden="true"></span>
        <span class="listening-art-icons" aria-hidden="true">
          <Play className="listening-art-icon listening-art-icon--play" aria-hidden="true" />
          <Pause className="listening-art-icon listening-art-icon--pause" aria-hidden="true" />
        </span>
      </span>
      <svg
        class="listening-art-tonearm"
        viewBox="0 0 52 52"
        aria-hidden="true"
      >
        <g class="listening-art-tonearm-arm">
          <line
            x1="6"
            y1="6"
            x2="29"
            y2="30"
            class="listening-art-tonearm-shaft"
          />
          <rect
            x="27"
            y="28"
            width="9"
            height="4"
            rx="1.2"
            class="listening-art-tonearm-cartridge"
            transform="rotate(46 31.5 30)"
          />
          <circle
            cx="6"
            cy="6"
            r="4.2"
            class="listening-art-tonearm-pivot"
          />
          <circle
            cx="6"
            cy="6"
            r="1.7"
            class="listening-art-tonearm-hole"
          />
        </g>
      </svg>
    </button>

    <div class="listening-copy">
      <p class="listening-eyebrow">
        <span class="listening-eyebrow-dot" aria-hidden="true"></span>
        <span class="listening-eyebrow-text" data-listening-status>Now playing</span>
        <span class="listening-eyebrow-wave" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
          <span></span>
        </span>
      </p>

      <a
        href={initialTrack.appleMusicUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="listening-track"
        data-listening-link
        aria-label={`Open ${initialTrack.title}`}
      >
        <span class="listening-title" data-listening-title>{initialTrack.title}</span>
        <span class="listening-sep" aria-hidden="true">—</span>
        <span class="listening-artist" data-listening-artist>{initialTrack.artist}</span>
      </a>

      <p class="listening-meta">
        <span data-listening-collection>{initialTrack.collection}</span>
        <span class="listening-meta-dot" aria-hidden="true"></span>
        <span data-listening-year>{initialTrack.year}</span>
      </p>
    </div>
  </aside>
)}

<style>
  .listening {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 14px;
    width: fit-content;
    max-width: min(100%, 520px);
    color: hsl(var(--muted-foreground));
  }

  .listening-art {
    --listening-tint: hsl(0 0% 30% / 0.85);
    position: relative;
    width: 52px;
    height: 52px;
    flex: none;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .listening-art:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .listening-art:focus-visible {
    outline: none;
  }

  .listening-art:focus-visible .listening-art-frame {
    box-shadow:
      inset 0 0 0 1px hsl(var(--foreground) / 0.18),
      0 0 0 2px hsl(var(--background)),
      0 0 0 4px hsl(var(--foreground) / 0.55);
  }

  /* Bottom layer — transparent base peeks out from the lower-left */
  .listening-art-shadow {
    position: absolute;
    inset: 0;
    border-radius: 8px;
    background: transparent;
    box-shadow:
      inset 0 0 0 1px hsl(var(--foreground) / 0.18),
      0 10px 24px -20px var(--listening-tint);
    opacity: 0;
    transform: translate(0, 0) scale(0.96);
    transform-origin: 0 100%;
    transition:
      opacity 0.28s ease,
      box-shadow 0.28s ease,
      transform 0.32s cubic-bezier(0.2, 0.8, 0.2, 1);
    pointer-events: none;
    z-index: 0;
  }

  .listening-art:hover:not(:disabled):not(.is-playing) .listening-art-shadow,
  .listening-art:focus-visible:not(:disabled):not(.is-playing) .listening-art-shadow {
    opacity: 1;
    transform: translate(-5px, 5px) scale(1);
  }

  /* Top layer — the actual cover (handles morph to disc) */
  .listening-art-frame {
    position: absolute;
    inset: 0;
    border-radius: 8px;
    overflow: hidden;
    isolation: isolate;
    box-shadow: inset 0 0 0 1px hsl(var(--foreground) / 0.08);
    transition:
      border-radius 0.55s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.3s ease;
    z-index: 1;
  }

  .listening-art:hover:not(:disabled) .listening-art-frame {
    box-shadow: inset 0 0 0 1px hsl(var(--foreground) / 0.22);
  }

  .listening-art-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform-origin: 50% 50%;
    will-change: transform;
  }

  /* Color-blend tint over the cover image */
  .listening-art-tint {
    position: absolute;
    inset: 0;
    background: var(--listening-tint);
    mix-blend-mode: color;
    opacity: 0;
    transition: opacity 0.22s ease;
    pointer-events: none;
    z-index: 2;
  }

  .listening-art:hover:not(:disabled) .listening-art-tint,
  .listening-art:focus-visible:not(:disabled) .listening-art-tint {
    opacity: 1;
  }

  .listening-art-spindle {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: radial-gradient(
      circle at 50% 45%,
      #000 0%,
      #161616 55%,
      hsl(0 0% 100% / 0.35) 100%
    );
    box-shadow:
      inset 0 0 0 0.5px hsl(0 0% 100% / 0.3),
      0 0 0 1px hsl(0 0% 0% / 0.55);
    transform: translate(-50%, -50%) scale(0);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 0.3s ease;
    z-index: 3;
  }

  .listening-art-icons {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
    z-index: 4;
  }

  .listening-art:hover:not(:disabled) .listening-art-icons,
  .listening-art:focus-visible:not(:disabled) .listening-art-icons {
    opacity: 1;
  }

  .listening-art-icon {
    width: 22px;
    height: 22px;
    color: #fff;
    fill: #fff;
    stroke-width: 1.5;
    filter:
      drop-shadow(0 1px 6px hsl(0 0% 0% / 0.6))
      drop-shadow(0 0 1px hsl(0 0% 0% / 0.85));
  }

  .listening-art-icon--pause {
    display: none;
  }

  .listening-art.is-playing .listening-art-icon--play {
    display: none;
  }

  .listening-art.is-playing .listening-art-icon--pause {
    display: block;
  }

  /* Playing — disc mode */
  .listening-art.is-playing .listening-art-frame {
    border-radius: 50%;
    box-shadow:
      inset 0 0 0 1px hsl(0 0% 0% / 0.45),
      0 8px 22px -12px hsl(0 0% 0% / 0.55),
      0 0 22px -10px hsl(var(--foreground) / 0.4);
  }

  .listening-art.is-playing .listening-art-img {
    animation: listening-spin 14s linear infinite;
  }

  .listening-art.is-playing .listening-art-spindle {
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
    transition-delay: 0.3s;
  }

  /* Tone arm — SVG, swings in from upper-left when playing */
  .listening-art-tonearm {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    color: hsl(var(--foreground) / 0.86);
    filter:
      drop-shadow(0 1px 2px hsl(0 0% 0% / 0.55))
      drop-shadow(0 0 1px hsl(0 0% 0% / 0.4));
    opacity: 0;
    transition: opacity 0.4s ease 0.15s;
    z-index: 5;
  }

  .listening-art.is-playing .listening-art-tonearm {
    opacity: 1;
  }

  .listening-art-tonearm-arm {
    transform-origin: 6px 6px;
    transform: rotate(24deg);
    transition: transform 0.65s cubic-bezier(0.34, 1.55, 0.64, 1) 0.18s;
  }

  .listening-art.is-playing .listening-art-tonearm-arm {
    transform: rotate(0deg);
  }

  .listening-art-tonearm-shaft {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .listening-art-tonearm-cartridge,
  .listening-art-tonearm-pivot {
    fill: currentColor;
    stroke: none;
  }

  .listening-art-tonearm-hole {
    fill: hsl(var(--background));
    stroke: none;
  }

  /* Copy */
  .listening-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .listening-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 2px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground) / 0.84);
    font-feature-settings: 'tnum';
  }

  .listening-eyebrow-dot {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: hsl(var(--foreground) / 0.45);
    transition:
      background 0.3s ease,
      box-shadow 0.3s ease;
  }

  .listening.is-playing .listening-eyebrow-dot {
    background: hsl(var(--foreground));
    box-shadow: 0 0 0 4px hsl(var(--foreground) / 0.08);
  }

  .listening-eyebrow-wave {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 9px;
    width: 0;
    overflow: hidden;
    transition: width 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .listening-eyebrow-wave span {
    display: block;
    width: 2px;
    height: 100%;
    border-radius: 999px;
    background: hsl(var(--foreground) / 0.7);
    transform-origin: 50% 100%;
    transform: scaleY(0.32);
  }

  .listening.is-playing .listening-eyebrow-wave {
    width: 18px;
  }

  .listening.is-playing .listening-eyebrow-wave span {
    animation: listening-wave 0.92s ease-in-out infinite;
  }

  .listening.is-playing .listening-eyebrow-wave span:nth-child(2) {
    animation-delay: 0.1s;
  }

  .listening.is-playing .listening-eyebrow-wave span:nth-child(3) {
    animation-delay: 0.22s;
  }

  .listening.is-playing .listening-eyebrow-wave span:nth-child(4) {
    animation-delay: 0.16s;
  }

  /* Track line */
  .listening-track {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 8px;
    min-width: 0;
    width: fit-content;
    max-width: 100%;
  }

  .listening-title,
  .listening-artist {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .listening-title {
    font-size: 15px;
    line-height: 1.4;
    color: hsl(var(--foreground));
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    padding-bottom: 1px;
    transition: background-size 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .listening-track:hover .listening-title,
  .listening-track:focus-visible .listening-title {
    background-size: 100% 1px;
  }

  .listening-sep {
    font-size: 13px;
    color: hsl(var(--muted-foreground) / 0.5);
  }

  .listening-artist {
    font-size: 14px;
    line-height: 1.45;
    color: hsl(var(--muted-foreground));
  }

  .listening-meta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 2px 0 0;
    min-width: 0;
    font-size: 12px;
    line-height: 1.4;
    color: hsl(var(--muted-foreground) / 0.78);
    font-feature-settings: 'tnum';
  }

  .listening-meta-dot {
    width: 2px;
    height: 2px;
    border-radius: 999px;
    background: currentColor;
    opacity: 0.65;
  }

  @media (max-width: 520px) {
    .listening {
      width: 100%;
    }
  }

  @media (max-width: 430px) {
    .listening {
      gap: 12px;
    }

    .listening-art {
      width: 48px;
      height: 48px;
    }

    .listening-title {
      font-size: 14px;
    }

    .listening-artist {
      font-size: 12px;
    }

    .listening-sep {
      display: none;
    }

    .listening-track {
      gap: 2px 6px;
    }

    .listening-meta,
    .listening-eyebrow {
      font-size: 11px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .listening-art-shadow,
    .listening-art-frame,
    .listening-art-tint,
    .listening-art-icons,
    .listening-art-spindle,
    .listening-art-tonearm,
    .listening-art-tonearm-arm,
    .listening-title,
    .listening-eyebrow-wave,
    .listening-eyebrow-dot {
      transition: none;
    }

    .listening-art.is-playing .listening-art-img,
    .listening.is-playing .listening-eyebrow-wave span {
      animation: none;
    }

    .listening-art.is-playing .listening-art-frame {
      border-radius: 8px;
    }

    .listening-art.is-playing .listening-art-spindle,
    .listening-art.is-playing .listening-art-tonearm {
      opacity: 0;
    }
  }

  @keyframes listening-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes listening-wave {
    0%,
    100% {
      transform: scaleY(0.32);
      opacity: 0.6;
    }
    50% {
      transform: scaleY(1);
      opacity: 1;
    }
  }
</style>

<script>
  type Rgb = { r: number; g: number; b: number };
  type ListeningTrackPayload = {
    title?: string;
    artist?: string;
    collection?: string;
    appleMusicUrl?: string;
    sourceUrl?: string;
    artworkUrl?: string;
    previewUrl?: string;
    year?: string;
    playedAt?: string;
    isNowPlaying?: boolean;
  };

  const SAMPLE_SIZE = 28;
  const LISTENING_REFRESH_MS = 45_000;

  const extractTintColor = (img: HTMLImageElement): Rgb | null => {
    const canvas = document.createElement('canvas');
    canvas.width = SAMPLE_SIZE;
    canvas.height = SAMPLE_SIZE;
    const ctx = canvas.getContext('2d', { willReadFrequently: true });
    if (!ctx) return null;

    ctx.drawImage(img, 0, 0, SAMPLE_SIZE, SAMPLE_SIZE);

    let data: Uint8ClampedArray;
    try {
      data = ctx.getImageData(0, 0, SAMPLE_SIZE, SAMPLE_SIZE).data;
    } catch {
      return null;
    }

    let bestR = 0;
    let bestG = 0;
    let bestB = 0;
    let bestScore = -1;
    let avgR = 0;
    let avgG = 0;
    let avgB = 0;
    let avgN = 0;

    for (let i = 0; i < data.length; i += 4) {
      const r = data[i];
      const g = data[i + 1];
      const b = data[i + 2];
      const a = data[i + 3];
      if (a < 200) continue;

      avgR += r;
      avgG += g;
      avgB += b;
      avgN += 1;

      const max = Math.max(r, g, b);
      const min = Math.min(r, g, b);
      const lightness = (max + min) / 510;
      if (lightness < 0.18 || lightness > 0.82) continue;

      const sat = max === 0 ? 0 : (max - min) / max;
      const score = sat * 1.6 + (lightness > 0.4 && lightness < 0.65 ? 0.2 : 0);
      if (score > bestScore) {
        bestScore = score;
        bestR = r;
        bestG = g;
        bestB = b;
      }
    }

    if (bestScore > 0.25) {
      return { r: bestR, g: bestG, b: bestB };
    }

    if (avgN > 0) {
      return {
        r: Math.round(avgR / avgN),
        g: Math.round(avgG / avgN),
        b: Math.round(avgB / avgN)
      };
    }

    return null;
  };

  const applyTint = (button: HTMLElement, img: HTMLImageElement) => {
    const color = extractTintColor(img);
    if (!color) return;
    button.style.setProperty(
      '--listening-tint',
      `rgb(${color.r} ${color.g} ${color.b} / 0.92)`
    );
  };

  const initListeningSection = () => {
    const roots = document.querySelectorAll('[data-listening]');

    roots.forEach((root) => {
      if (!(root instanceof HTMLElement) || root.dataset.bound === 'true') {
        return;
      }

      root.dataset.bound = 'true';

      const playButton = root.querySelector('[data-listening-play]');
      if (!(playButton instanceof HTMLButtonElement)) {
        return;
      }

      const artwork = root.querySelector('[data-listening-artwork]');
      const link = root.querySelector('[data-listening-link]');
      const title = root.querySelector('[data-listening-title]');
      const artist = root.querySelector('[data-listening-artist]');
      const collection = root.querySelector('[data-listening-collection]');
      const year = root.querySelector('[data-listening-year]');
      const status = root.querySelector('[data-listening-status]');

      let audio: HTMLAudioElement | null = null;
      let trackTitle = playButton.dataset.trackTitle ?? 'Track';

      const refreshTint = () => {
        if (!(artwork instanceof HTMLImageElement)) return;

        if (artwork.complete && artwork.naturalWidth > 0) {
          applyTint(playButton, artwork);
        } else {
          artwork.addEventListener('load', () => applyTint(playButton, artwork), { once: true });
        }
      };

      const setPlayState = (isPlaying: boolean) => {
        root.classList.toggle('is-playing', isPlaying);
        playButton.classList.toggle('is-playing', isPlaying);
        playButton.setAttribute('aria-pressed', isPlaying ? 'true' : 'false');
        playButton.setAttribute(
          'aria-label',
          `${isPlaying ? 'Pause' : 'Play'} preview of ${trackTitle}`
        );
      };

      const setPreview = (previewUrl: string) => {
        if (audio) {
          audio.pause();
          audio.currentTime = 0;
        }

        setPlayState(false);
        playButton.dataset.previewUrl = previewUrl;
        audio = previewUrl ? new Audio(previewUrl) : null;

        if (!audio) {
          playButton.disabled = true;
          playButton.setAttribute('aria-label', `${trackTitle} preview unavailable`);
          return;
        }

        audio.preload = 'none';
        audio.addEventListener('ended', () => {
          setPlayState(false);
        });
        playButton.disabled = false;
        playButton.setAttribute('aria-label', `Play preview of ${trackTitle}`);
      };

      const formatPlayedAt = (playedAt: string) => {
        const date = new Date(playedAt);
        if (!Number.isFinite(date.getTime())) {
          return '';
        }

        return new Intl.DateTimeFormat(undefined, {
          month: 'short',
          day: 'numeric'
        }).format(date);
      };

      const applyTrack = (track: ListeningTrackPayload) => {
        const nextTitle = track.title?.trim() || trackTitle;
        const nextArtist = track.artist?.trim() || '';
        const nextCollection = track.collection?.trim() || '';
        const nextLink = track.appleMusicUrl?.trim() || track.sourceUrl?.trim() || '';
        const nextArtwork = track.artworkUrl?.trim() || '';
        const nextPreviewUrl = track.previewUrl?.trim() || '';
        const nextYear = track.year?.trim() || formatPlayedAt(track.playedAt ?? '');

        trackTitle = nextTitle;
        playButton.dataset.trackTitle = nextTitle;

        if (title) title.textContent = nextTitle;
        if (artist) artist.textContent = nextArtist;
        if (collection) collection.textContent = nextCollection;
        if (year) year.textContent = nextYear;
        if (status) status.textContent = track.isNowPlaying ? 'Now playing' : 'Recently played';

        if (link instanceof HTMLAnchorElement && nextLink) {
          link.href = nextLink;
          link.setAttribute('aria-label', `Open ${nextTitle}`);
        }

        if (artwork instanceof HTMLImageElement && nextArtwork && artwork.src !== nextArtwork) {
          artwork.src = nextArtwork;
          refreshTint();
        }

        if ((playButton.dataset.previewUrl ?? '') !== nextPreviewUrl) {
          setPreview(nextPreviewUrl);
        } else if (!audio) {
          playButton.setAttribute('aria-label', `${trackTitle} preview unavailable`);
        } else {
          playButton.setAttribute('aria-label', `Play preview of ${trackTitle}`);
        }
      };

      refreshTint();
      setPreview(playButton.dataset.previewUrl ?? '');

      playButton.addEventListener('click', async () => {
        if (!audio) {
          return;
        }

        if (audio.paused) {
          setPlayState(true);

          try {
            await audio.play();
          } catch {
            setPlayState(false);
          }

          return;
        }

        audio.pause();
        audio.currentTime = 0;
        setPlayState(false);
      });

      const refreshListening = async () => {
        try {
          const response = await fetch('/api/listening', {
            headers: {
              Accept: 'application/json'
            }
          });
          if (!response.ok) {
            return;
          }

          const payload = await response.json() as { track?: ListeningTrackPayload };
          if (payload.track) {
            applyTrack(payload.track);
          }
        } catch {
          // Keep the static fallback when live listening data is unavailable.
        }
      };

      window.setTimeout(refreshListening, 800);
      window.setInterval(refreshListening, LISTENING_REFRESH_MS);
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initListeningSection, { once: true });
  } else {
    initListeningSection();
  }
</script>
