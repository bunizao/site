---
import { getListeningTracks } from '@/features/home/server/listening';
import { Play } from 'lucide-react';

const tracks = await getListeningTracks();
const initialTrack = tracks[0] ?? null;
---

{initialTrack && (
  <aside class="listening-status" data-listening aria-label="Now playing">
    <a
      href={initialTrack.appleMusicUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="listening-cover-link"
      aria-label={`Open ${initialTrack.title} on Apple Music`}
    >
      <img
        src={initialTrack.artworkUrl}
        alt={`${initialTrack.title} cover art`}
        class="listening-cover"
        loading="eager"
        decoding="async"
        referrerpolicy="no-referrer"
      />
    </a>

    <div class="listening-copy">
      <p class="listening-kicker">
        <span class="listening-kicker-mark" aria-hidden="true"></span>
        <span>Now playing</span>
      </p>

      <a
        href={initialTrack.appleMusicUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="listening-track"
        data-listening-link
        aria-label={`Open ${initialTrack.title} on Apple Music`}
      >
        <span class="listening-title">{initialTrack.title}</span>
        <span class="listening-artist">{initialTrack.artist}</span>
      </a>

      <p class="listening-detail">
        <span>{initialTrack.collection}</span>
        <span aria-hidden="true">/</span>
        <span>{initialTrack.year}</span>
      </p>
    </div>

    <button
      type="button"
      class="listening-play"
      data-listening-play
      data-preview-url={initialTrack.previewUrl}
      data-track-title={initialTrack.title}
      disabled={!initialTrack.previewUrl}
      aria-pressed="false"
      aria-label={`Play preview of ${initialTrack.title}`}
    >
      <Play className="listening-play-icon listening-play-icon--play" aria-hidden="true" />
      <span class="listening-play-wave" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>
  </aside>
)}

<style>
  .listening-status {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    width: fit-content;
    max-width: min(100%, 520px);
    color: hsl(var(--muted-foreground));
  }

  .listening-copy {
    min-width: 0;
    max-width: 390px;
  }

  .listening-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 8px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground) / 0.84);
  }

  .listening-kicker-mark {
    position: relative;
    width: 18px;
    height: 1px;
    background: currentColor;
    opacity: 0.48;
  }

  .listening-kicker-mark::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: hsl(var(--foreground));
    transform: translateY(-50%);
    animation: listening-pulse 1.8s ease-in-out infinite;
  }

  .listening-track {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 10px;
    min-width: 0;
    width: fit-content;
    max-width: 100%;
  }

  .listening-title,
  .listening-artist,
  .listening-detail span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .listening-title {
    max-width: 100%;
    font-size: 15px;
    line-height: 1.35;
    color: hsl(var(--foreground));
    transition: opacity 0.18s ease;
  }

  .listening-track:hover .listening-title {
    opacity: 0.72;
  }

  .listening-artist {
    font-size: 14px;
    line-height: 1.45;
    color: hsl(var(--muted-foreground));
  }

  .listening-detail {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 6px 0 0;
    min-width: 0;
    font-size: 12px;
    line-height: 1.4;
    color: hsl(var(--muted-foreground) / 0.82);
  }

  .listening-cover-link {
    display: block;
    width: 42px;
    height: 42px;
    flex: none;
    overflow: hidden;
    border-radius: 7px;
    opacity: 0.86;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .listening-cover-link:hover {
    opacity: 1;
    transform: translateY(-1px);
  }

  .listening-status.is-playing .listening-cover-link {
    opacity: 1;
    animation: listening-cover-breath 2.6s ease-in-out infinite;
  }

  .listening-cover {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    box-shadow: 0 0 0 1px hsl(var(--foreground) / 0.08);
  }

  .listening-play {
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    border: 1px solid hsl(var(--foreground) / 0.12);
    border-radius: 999px;
    background: transparent;
    color: hsl(var(--muted-foreground));
    transition:
      transform 0.18s ease,
      border-color 0.18s ease,
      color 0.18s ease;
  }

  .listening-play:hover:not(:disabled) {
    transform: translateY(-1px);
    border-color: hsl(var(--foreground) / 0.28);
    color: hsl(var(--foreground));
  }

  .listening-play:active:not(:disabled) {
    transform: translateY(0) scale(0.96);
  }

  .listening-play:disabled {
    opacity: 0.42;
    cursor: not-allowed;
  }

  .listening-play-icon {
    width: 13px;
    height: 13px;
    stroke-width: 2;
  }

  .listening-play-wave {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 2px;
    width: 14px;
    height: 14px;
  }

  .listening-play-wave span {
    width: 2px;
    height: 5px;
    border-radius: 999px;
    background: currentColor;
    opacity: 0.9;
    transform-origin: center bottom;
    animation: listening-wave 0.86s ease-in-out infinite;
  }

  .listening-play-wave span:nth-child(2) {
    animation-delay: 0.12s;
  }

  .listening-play-wave span:nth-child(3) {
    animation-delay: 0.24s;
  }

  .listening-play.is-playing .listening-play-icon--play {
    display: none;
  }

  .listening-play.is-playing .listening-play-wave {
    display: flex;
  }

  .listening-play.is-playing {
    border-color: hsl(var(--foreground) / 0.24);
    color: hsl(var(--foreground));
  }

  @media (max-width: 520px) {
    .listening-status {
      grid-template-columns: auto minmax(0, 1fr) auto;
      width: 100%;
    }
  }

  @media (max-width: 430px) {
    .listening-track {
      gap: 4px 8px;
    }

    .listening-title {
      font-size: 14px;
    }

    .listening-artist,
    .listening-detail {
      font-size: 12px;
    }

    .listening-cover-link {
      width: 38px;
      height: 38px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .listening-kicker-mark::before {
      animation: none;
    }

    .listening-status.is-playing .listening-cover-link,
    .listening-play-wave span {
      animation: none;
    }

    .listening-cover-link,
    .listening-play,
    .listening-title {
      transition: none;
    }
  }

  @keyframes listening-pulse {
    0%,
    100% {
      transform: translateY(-50%) scale(1);
      opacity: 1;
    }

    50% {
      transform: translateY(-50%) scale(1.4);
      opacity: 0.55;
    }
  }

  @keyframes listening-cover-breath {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }

    50% {
      transform: translateY(-1px) scale(1.025);
    }
  }

  @keyframes listening-wave {
    0%,
    100% {
      transform: scaleY(0.72);
      opacity: 0.58;
    }

    50% {
      transform: scaleY(1.6);
      opacity: 1;
    }
  }
</style>

<script>
  const initListeningSection = () => {
    const roots = document.querySelectorAll('[data-listening]');

    roots.forEach((root) => {
      if (!(root instanceof HTMLElement) || root.dataset.bound === 'true') {
        return;
      }

      root.dataset.bound = 'true';

      const playButton = root.querySelector('[data-listening-play]');
      if (!(playButton instanceof HTMLButtonElement)) {
        return;
      }

      const previewUrl = playButton.dataset.previewUrl ?? '';
      const trackTitle = playButton.dataset.trackTitle ?? 'Track';
      const audio = previewUrl ? new Audio(previewUrl) : null;

      if (!audio) {
        playButton.disabled = true;
        playButton.setAttribute('aria-label', `${trackTitle} preview unavailable`);
        return;
      }

      audio.preload = 'none';

      const setPlayState = (isPlaying: boolean) => {
        root.classList.toggle('is-playing', isPlaying);
        playButton.classList.toggle('is-playing', isPlaying);
        playButton.setAttribute('aria-pressed', isPlaying ? 'true' : 'false');
        playButton.setAttribute('aria-label', `${isPlaying ? 'Pause' : 'Play'} preview of ${trackTitle}`);
      };

      playButton.addEventListener('click', async () => {
        if (audio.paused) {
          setPlayState(true);

          try {
            await audio.play();
          } catch {
            setPlayState(false);
          }

          return;
        }

        audio.pause();
        audio.currentTime = 0;
        setPlayState(false);
      });

      audio.addEventListener('ended', () => {
        setPlayState(false);
      });

      setPlayState(false);
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initListeningSection, { once: true });
  } else {
    initListeningSection();
  }
</script>
