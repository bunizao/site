</style>

<script>
  const layer = document.querySelector<HTMLElement>('[data-hero-cards]');
  const bio = document.querySelector<HTMLElement>('[data-hero-bio]');

  // Hover intent: a pass over a link on the way elsewhere opens nothing, and
  // the card waits long enough for the pointer to cross the gap onto it.
  const OPEN_DELAY_MS = 120;
  const CLOSE_DELAY_MS = 280;
  const GAP = 10;
  const VIEWPORT_MARGIN = 8;

  let current: HTMLElement | null = null;
  let currentLink: HTMLElement | null = null;
  let openTimer = 0;
  let closeTimer = 0;

  const cardById = (id: string | undefined): HTMLElement | null =>
    (id && layer?.querySelector<HTMLElement>(`[data-card-id="${id}"]`)) || null;

  // Above the word, left edges aligned; below it when the viewport has no room.
  const place = (card: HTMLElement, link: HTMLElement): void => {
    if (!layer) return;
    const host = layer.getBoundingClientRect();
    const word = link.getBoundingClientRect();
    const width = card.offsetWidth;
    const height = card.offsetHeight;
    const left = Math.min(Math.max(word.left - host.left - 16, 0), Math.max(host.width - width, 0));
    const above = word.top - height - GAP >= VIEWPORT_MARGIN;
    const top = above ? word.top - host.top - height - GAP : word.bottom - host.top + GAP;
    card.style.left = `${Math.round(left)}px`;
    card.style.top = `${Math.round(top)}px`;
    card.dataset.side = above ? 'top' : 'bottom';
  };

  const reposition = (): void => {
    if (current && currentLink) place(current, currentLink);
  };

  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string) => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  };

  // ---------- Clock and semesters -----------------------------------------

  const melbourne = (options: Intl.DateTimeFormatOptions) =>
    new Intl.DateTimeFormat('en-AU', { timeZone: 'Australia/Melbourne', ...options });
  const timeFormat = melbourne({ hour: 'numeric', minute: '2-digit' });

  const fillClock = (card: HTMLElement): void => {
    const now = timeFormat.format(new Date());
    card.querySelectorAll('[data-melbourne-time]').forEach((node) => {
      node.textContent = now;
    });
  };

  // Monash runs Semester 1 from March to June and Semester 2 from July to
  // November; December to February is the summer break.
  const fillTerms = (card: HTMLElement): void => {
    const box = card.querySelector<HTMLElement>('[data-terms]');
    const track = card.querySelector<HTMLElement>('[data-term-track]');
    const label = card.querySelector<HTMLElement>('[data-term-now]');
    if (!box || !track || !label || track.childElementCount > 0) return;
    const [startYear, startMonth] = (box.dataset.since ?? '').split('-').map(Number);
    if (!startYear || !startMonth) return;
    const parts = melbourne({ year: 'numeric', month: 'numeric' }).formatToParts(new Date());
    const year = Number(parts.find((part) => part.type === 'year')?.value);
    const month = Number(parts.find((part) => part.type === 'month')?.value);
    const inTerm = month >= 3 && month <= 11;
    const endYear = month <= 2 ? year - 1 : year;
    const endTerm = month <= 2 || month >= 7 ? 2 : 1;

    let y = startYear;
    let t = startMonth >= 7 ? 2 : 1;
    while (y < endYear || (y === endYear && t <= endTerm)) {
      const term = el('span', 'mo-term', `S${t} ’${String(y).slice(2)}`);
      if (inTerm && y === endYear && t === endTerm) term.dataset.current = '';
      track.append(term);
      if (t === 2) {
        y += 1;
        t = 1;
      } else {
        t = 2;
      }
    }
    label.textContent = inTerm ? `Now in S${endTerm} ${endYear}` : 'Summer break';
  };

  // ---------- Moods ------------------------------------------------------

  const relativeTime = (iso: string): string => {
    const then = new Date(iso).getTime();
    if (Number.isNaN(then)) return '';
    const minutes = Math.round((Date.now() - then) / 60_000);
    if (minutes < 1) return 'just now';
    if (minutes < 60) return `${minutes}m ago`;
    const hours = Math.round(minutes / 60);
    if (hours < 24) return `${hours}h ago`;
    const days = Math.round(hours / 24);
    if (days < 7) return `${days}d ago`;
    return new Date(iso).toLocaleDateString('en', { month: 'short', day: 'numeric' });
  };

  // A mood that is only a link reads as its host and path, like the feed.
  const shortenUrl = (text: string): string => {
    if (!/^https?:\/\/\S+$/.test(text)) return text;
    const bare = text.replace(/^https?:\/\/(www\.)?/, '').replace(/[?#].*$/, '');
    return bare.length > 30 ? `${bare.slice(0, 29)}…` : bare;
  };

  interface MoodPost {
    id?: string | number;
    previewText?: string;
    datetime?: string;
    image?: string | null;
    reactions?: { emoji?: string; count?: string | number }[];
  }

  let moodRequested = false;
  const loadMoods = async (): Promise<void> => {
    if (moodRequested) return;
    moodRequested = true;
    const card = cardById('moods');
    const stream = card?.querySelector<HTMLElement>('[data-mood-stream]');
    if (!card || !stream) return;
    let latest: MoodPost[] = [];
    try {
      const response = await fetch('/api/moods');
      if (!response.ok) throw new Error(String(response.status));
      const data = (await response.json()) as { posts?: MoodPost[] };
      latest = (data.posts ?? []).slice(0, 3).reverse();
    } catch {
      // Falls through to the line below; the link still works.
    }
    if (latest.length === 0) {
      stream.replaceChildren(el('span', 'md-meta', 'Could not load the channel right now.'));
      return;
    }
    stream.replaceChildren(
      ...latest.map((post, i) => {
        const bubble = el('a', 'md-bubble');
        bubble.href = post.id !== undefined ? `/mood/${post.id}` : '/mood';
        bubble.tabIndex = -1;
        bubble.style.setProperty('--i', String(i));
        const body = el('span');
        body.append(el('span', 'md-text', shortenUrl(post.previewText?.trim() || 'A photo, no words.')));
        const reactions = (post.reactions ?? [])
          .slice(0, 2)
          .map((reaction) => `${reaction.emoji ?? ''} ${reaction.count ?? ''}`.trim());
        body.append(el('span', 'md-meta', [relativeTime(post.datetime ?? ''), ...reactions].filter(Boolean).join(' · ')));
        bubble.append(body);
        if (post.image) {
          const thumb = el('img', 'md-thumb');
          thumb.src = post.image;
          thumb.alt = '';
          thumb.loading = 'lazy';
          thumb.decoding = 'async';
          bubble.append(thumb);
        }
        return bubble;
      }),
    );
    if (current === card) reposition();
  };

  // ---------- GitHub ------------------------------------------------------

  interface Day {
    date: string;
    count: number;
    level: number;
  }

  const dayLabel = (iso: string): string =>
    new Date(`${iso}T00:00:00Z`).toLocaleDateString('en', { month: 'short', day: 'numeric', timeZone: 'UTC' });

  let githubRequested = false;
  const loadGitHub = async (): Promise<void> => {
    if (githubRequested) return;
    githubRequested = true;
    const card = cardById('github');
    const heat = card?.querySelector<HTMLElement>('[data-heat]');
    if (!card || !heat) return;
    let days: Day[] = [];
    let total: number | null = null;
    try {
      const response = await fetch('/api/github/contributions?days=84');
      if (!response.ok) throw new Error(String(response.status));
      const data = (await response.json()) as { total?: { lastYear?: number }; contributions?: Day[] };
      days = data.contributions ?? [];
      total = data.total?.lastYear ?? null;
    } catch {
      // The grid stays empty and the stats keep their dashes.
    }
    if (days.length === 0) return;

    // Rows are weekdays, Sunday first, the way GitHub draws it.
    const offset = new Date(`${days[0].date}T00:00:00Z`).getUTCDay();
    const cells: HTMLElement[] = [];
    for (let i = 0; i < offset; i++) {
      const blank = el('span');
      blank.dataset.blank = '';
      cells.push(blank);
    }
    days.forEach((day, i) => {
      const cell = el('span');
      cell.dataset.l = String(day.level);
      cell.dataset.date = day.date;
      cell.dataset.count = String(day.count);
      cell.style.setProperty('--c', String(Math.floor((i + offset) / 7)));
      cells.push(cell);
    });
    heat.replaceChildren(...cells);

    const best = days.reduce((a, b) => (b.count > a.count ? b : a));
    // Today may not have a commit yet; the streak counts back from yesterday then.
    let streak = 0;
    for (let i = days.length - 1; i >= 0; i--) {
      if (days[i].count > 0) streak++;
      else if (i < days.length - 1) break;
    }
    const set = (selector: string, text: string) => {
      const node = card.querySelector(selector);
      if (node) node.textContent = text;
    };
    if (total !== null) set('[data-gh-total]', total.toLocaleString('en'));
    set('[data-gh-best]', String(best.count));
    set('[data-gh-streak]', `${streak}d`);
    heat.dataset.caption = `Last 12 weeks · busiest was ${dayLabel(best.date)}`;
    set('[data-heat-caption]', heat.dataset.caption);
    if (current === card) reposition();
  };

  // ---------- Open and close ----------------------------------------------

  const open = (link: HTMLElement): void => {
    const card = cardById(link.dataset.card);
    if (!card) return;
    currentLink = link;
    if (card === current) return;
    const switching = current !== null;
    if (current) {
      current.dataset.instant = '';
      delete current.dataset.open;
    }
    fillClock(card);
    if (card.dataset.cardId === 'monash') fillTerms(card);
    if (switching) card.dataset.instant = '';
    else delete card.dataset.instant;
    place(card, link);
    card.dataset.open = '';
    current = card;
  };

  const close = (): void => {
    if (!current) return;
    delete current.dataset.instant;
    delete current.dataset.open;
    current = null;
    currentLink = null;
  };

  const scheduleClose = (): void => {
    window.clearTimeout(openTimer);
    window.clearTimeout(closeTimer);
    closeTimer = window.setTimeout(close, CLOSE_DELAY_MS);
  };

  const linkFrom = (target: EventTarget | null): HTMLElement | null =>
    target instanceof Element ? target.closest<HTMLElement>('a[data-card]') : null;

  const warm = (): void => {
    void loadMoods();
    void loadGitHub();
  };

  if (layer && bio) {
    bio.addEventListener('pointerover', (event) => {
      if (event.pointerType !== 'mouse') return;
      const link = linkFrom(event.target);
      if (!link) return;
      // Any link hover is intent to explore; start the network reads now so
      // the live cards rarely open on a placeholder.
      warm();
      window.clearTimeout(closeTimer);
      window.clearTimeout(openTimer);
      if (current) open(link);
      else openTimer = window.setTimeout(() => open(link), OPEN_DELAY_MS);
    });

    bio.addEventListener('pointerout', (event) => {
      if (event.pointerType !== 'mouse') return;
      const link = linkFrom(event.target);
      if (!link || link.contains(event.relatedTarget as Node | null)) return;
      scheduleClose();
    });

    // The open card holds itself open while the pointer is on it.
    layer.addEventListener('pointerover', (event) => {
      if (event.pointerType === 'mouse' && current?.contains(event.target as Node)) window.clearTimeout(closeTimer);
    });
    layer.addEventListener('pointerout', (event) => {
      if (event.pointerType !== 'mouse' || !current) return;
      if (current.contains(event.relatedTarget as Node | null)) return;
      scheduleClose();
    });

    // Projects: the caption tells the story of the card under the pointer.
    const stage = layer.querySelector<HTMLElement>('[data-pj-stage]');
    const caption = layer.querySelector<HTMLElement>('[data-pj-caption]');
    const captionDefault = caption ? Array.from(caption.childNodes) : [];
    stage?.addEventListener('pointerover', (event) => {
      const mini = (event.target as Element).closest<HTMLElement>('.pj-mini');
      if (!mini || !caption) return;
      caption.replaceChildren(el('strong', undefined, mini.dataset.name ?? ''), ` ${mini.dataset.blurb ?? ''}`);
    });
    stage?.addEventListener('pointerleave', () => {
      caption?.replaceChildren(...captionDefault);
    });

    // GitHub: the caption reads out the day under the pointer.
    const heat = layer.querySelector<HTMLElement>('[data-heat]');
    const heatCaption = layer.querySelector<HTMLElement>('[data-heat-caption]');
    heat?.addEventListener('pointerover', (event) => {
      const cell = (event.target as Element).closest<HTMLElement>('span[data-date]');
      if (!cell || !heatCaption) return;
      const count = Number(cell.dataset.count);
      heatCaption.textContent = `${dayLabel(cell.dataset.date ?? '')} · ${count} contribution${count === 1 ? '' : 's'}`;
    });
    heat?.addEventListener('pointerleave', () => {
      if (heatCaption) heatCaption.textContent = heat.dataset.caption || 'Last 12 weeks';
    });

    bio.addEventListener('focusin', (event) => {
      const link = linkFrom(event.target);
      if (!link?.matches(':focus-visible')) return;
      warm();
      open(link);
    });

    bio.addEventListener('focusout', close);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close();
    });
  }
</script>
