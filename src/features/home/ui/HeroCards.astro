---
// Hover cards for the hero bio links. Each link names one (`data-card`), and
// each card is its own small UI with what is useful to know before clicking:
// the course, the projects and their stars, the latest posts, the latest
// mood, what happens to a message, the GitHub year, where a handle leads.
//
// The cards sit outside the decode root on purpose. The decode flattens
// everything inside it and swaps the markup back when it settles, so the
// script listens on the bio by delegation and positions one card at a time.
import { ArrowRight, ArrowUpRight, GraduationCap, Layers, MessageCircle, Quote } from 'lucide-react';
import { blog, experience, hero, profile, projects } from '@/data/site';
import { messageCopy } from '@/features/messages/copy';
import { getListedPosts } from '@/features/posts/server/content';

const school = experience[0];
const [since] = school.period.split(' — ');
const campus = school.location?.split(', ').slice(0, 2).join(', ');

const blogCopy = blog.copy[blog.locale.home];
const posts = (await getListedPosts()).slice(0, 3);
const stamp = (iso: string): string => {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return '';
  return `${d.getUTCFullYear()}.${String(d.getUTCMonth() + 1).padStart(2, '0')}`;
};

const topRepo = projects
  .filter((project) => project.stars !== null)
  .sort((a, b) => (b.stars ?? 0) - (a.stars ?? 0))[0];

// "github.com/bunizao", "t.me/hututu0": where a link really lands.
const host = (url: string): string => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const handle = (url: string): string => `@${host(url).split('/').pop()}`;
const socials = hero.socials.map((social) => {
  const target = social.canonicalUrl ?? social.url;
  return { ...social, id: social.name.toLowerCase(), short: host(social.url), target: host(target), handle: handle(target) };
});
const github = socials.find((social) => social.id === 'github');
---

<div class="hero-cards" data-hero-cards>
  <div class="hc" id="hero-card-monash" role="tooltip" data-card-id="monash">
    <div class="hc-head">
      <span class="hc-tile"><GraduationCap className="hc-glyph" strokeWidth={1.8} aria-hidden="true" /></span>
      <span class="hc-id">
        <span class="hc-title">{school.org}</span>
        {campus && <span class="hc-sub">{campus}</span>}
      </span>
    </div>
    <dl class="hc-rows">
      <div><dt>Course</dt><dd>Computer Science</dd></div>
      <div><dt>Major</dt><dd>Data Science &amp; AI</dd></div>
      <div><dt>Since</dt><dd class="hc-num">{since}</dd></div>
    </dl>
    <div class="hc-foot"><span>{host(school.url)}</span><ArrowUpRight className="hc-arrow" aria-hidden="true" /></div>
  </div>

  <div class="hc" id="hero-card-projects" role="tooltip" data-card-id="projects">
    <div class="hc-head">
      <span class="hc-tile"><Layers className="hc-glyph" strokeWidth={1.8} aria-hidden="true" /></span>
      <span class="hc-id">
        <span class="hc-title">Projects</span>
        <span class="hc-sub">{projects.length} things I built and still run</span>
      </span>
    </div>
    <ul class="hc-list">
      {projects.map((project) => (
        <li>
          <span class="hc-item">
            <span class="hc-item-name">{project.name}</span>
            <span class="hc-item-meta">{project.type}</span>
          </span>
          {project.stars !== null && <span class="hc-num hc-stars">★ {project.stars}</span>}
        </li>
      ))}
    </ul>
    <div class="hc-foot"><span>/projects</span><ArrowRight className="hc-arrow" aria-hidden="true" /></div>
  </div>

  <div class="hc" id="hero-card-write" role="tooltip" data-card-id="write">
    <div class="hc-head">
      <span class="hc-tile hc-tile--mark"><img src={blog.mark} alt="" width="20" height="20" loading="lazy" decoding="async" /></span>
      <span class="hc-id">
        <span class="hc-title">{blogCopy.name}</span>
        <span class="hc-sub">{blogCopy.tagline}</span>
      </span>
    </div>
    {posts.length > 0 ? (
      <ul class="hc-list">
        {posts.map((post) => (
          <li>
            <span class="hc-item-name hc-clamp-1">{post.title}</span>
            <span class="hc-num hc-item-meta">{stamp(post.publishedAt)}</span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="hc-text">Nothing published yet.</p>
    )}
    <div class="hc-foot"><span>/blog</span><ArrowRight className="hc-arrow" aria-hidden="true" /></div>
  </div>

  <div class="hc" id="hero-card-moods" role="tooltip" data-card-id="moods">
    <div class="hc-head">
      <span class="hc-tile"><Quote className="hc-glyph" strokeWidth={1.8} aria-hidden="true" /></span>
      <span class="hc-id">
        <span class="hc-title">Moods</span>
        <span class="hc-sub">Short notes, as they happen</span>
      </span>
    </div>
    <div class="hc-mood" data-mood-latest aria-busy="true">
      <span class="hc-skeleton"></span>
      <span class="hc-skeleton hc-skeleton--short"></span>
    </div>
    <div class="hc-foot"><span>/mood</span><ArrowRight className="hc-arrow" aria-hidden="true" /></div>
  </div>

  <div class="hc" id="hero-card-message" role="tooltip" data-card-id="message">
    <div class="hc-head">
      <span class="hc-tile"><MessageCircle className="hc-glyph" strokeWidth={1.8} aria-hidden="true" /></span>
      <span class="hc-id">
        <span class="hc-title">Leave a message</span>
        <span class="hc-sub">{messageCopy.privacy}</span>
      </span>
    </div>
    <p class="hc-bubble">{messageCopy.intro}</p>
    <div class="hc-foot"><span>/message</span><ArrowRight className="hc-arrow" aria-hidden="true" /></div>
  </div>

  {github && (
    <div class="hc" id="hero-card-github" role="tooltip" data-card-id="github">
      <div class="hc-head">
        <span class="hc-tile hc-tile--avatar"><img src="/avatar.webp" alt="" width="32" height="32" loading="lazy" decoding="async" /></span>
        <span class="hc-id">
          <span class="hc-title">{github.handle}</span>
          <span class="hc-sub">{profile.name}</span>
        </span>
      </div>
      <dl class="hc-rows">
        <div data-contrib-row hidden><dt>Last year</dt><dd class="hc-num" data-contrib></dd></div>
        {topRepo && <div><dt>Top repo</dt><dd>{topRepo.name} <span class="hc-num hc-stars">★ {topRepo.stars}</span></dd></div>}
        <div><dt>Short link</dt><dd>{github.short}</dd></div>
      </dl>
      <div class="hc-foot"><span>{github.target}</span><ArrowUpRight className="hc-arrow" aria-hidden="true" /></div>
    </div>
  )}

  {socials.filter((social) => social !== github).map((social) => (
    <div class="hc" id={`hero-card-${social.id}`} role="tooltip" data-card-id={social.id}>
      <div class="hc-head">
        <span class="hc-tile"><social.icon className="hc-glyph" aria-hidden="true" /></span>
        <span class="hc-id">
          <span class="hc-title">{social.handle}</span>
          <span class="hc-sub">{social.name} · {social.description}</span>
        </span>
      </div>
      <dl class="hc-rows">
        <div><dt>Short link</dt><dd>{social.short}</dd></div>
      </dl>
      <div class="hc-foot"><span>{social.target}</span><ArrowUpRight className="hc-arrow" aria-hidden="true" /></div>
    </div>
  ))}
</div>

<style>
  /* The layer covers the hero so a card can sit anywhere over it; only the
     open card shows, and none of them take the pointer. */
  .hero-cards {
    position: absolute;
    inset: 0;
    z-index: 30;
    pointer-events: none;
  }

  /* A card is a raised piece of the home surface, the same edge and drop as
     the project deck. It speaks in the sans UI voice; the hero's mono only
     comes back for the destination in the footer. */
  .hc {
    position: absolute;
    top: 0;
    left: 0;
    width: 272px;
    padding: 12px;
    border-radius: 12px;
    background: var(--home-surface);
    box-shadow: var(--home-surface-shadow-raised);
    font-family: var(--font-sans);
    font-size: var(--home-text-meta);
    line-height: 1.4;
    color: var(--home-fg-secondary);
    opacity: 0;
    visibility: hidden;
    scale: 0.96;
    translate: 0 4px;
    transform-origin: var(--hc-origin, left bottom);
    transition:
      opacity 120ms var(--ease-out),
      scale 120ms var(--ease-out),
      translate 120ms var(--ease-out),
      visibility 0s 120ms;
  }

  .hc[data-side='bottom'] {
    --hc-origin: left top;
    translate: 0 -4px;
  }

  .hc[data-open] {
    opacity: 1;
    visibility: visible;
    scale: 1;
    translate: 0 0;
    transition:
      opacity 180ms var(--ease-out),
      scale 180ms var(--ease-out),
      translate 180ms var(--ease-out),
      visibility 0s;
  }

  /* Switching between links swaps the card in place, no second entrance. */
  .hc[data-instant] {
    transition: none;
  }

  .hc-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* The Experience tile, reused: the same small surface with a glyph. */
  .hc-tile {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--home-surface);
    box-shadow: var(--home-surface-shadow);
    color: hsl(var(--foreground) / 0.82);
    overflow: hidden;
  }

  .hc-tile :global(.hc-glyph) {
    width: 16px;
    height: 16px;
  }

  .hc-tile--mark img {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }

  :global(.dark) .hc-tile--mark img {
    filter: invert(1);
  }

  .hc-tile--avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    outline: 1px solid var(--home-image-outline);
    outline-offset: -1px;
    border-radius: inherit;
  }

  .hc-id {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 1px;
  }

  .hc-title {
    font-weight: var(--home-weight-title);
    color: var(--home-fg-primary);
  }

  .hc-sub {
    overflow: hidden;
    font-size: 12px;
    color: var(--home-fg-faint);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hc-num {
    font-variant-numeric: tabular-nums;
  }

  .hc-rows,
  .hc-list,
  .hc-mood,
  .hc-bubble,
  .hc-text {
    margin: 12px 0 0;
  }

  .hc-rows {
    display: grid;
    gap: 6px;
  }

  .hc-rows div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }

  .hc-rows div[hidden] {
    display: none;
  }

  .hc-rows dt {
    color: var(--home-fg-faint);
  }

  .hc-rows dd {
    margin: 0;
    color: var(--home-fg-primary);
    text-align: right;
  }

  .hc-list {
    display: grid;
    gap: 8px;
    padding: 0;
    list-style: none;
  }

  .hc-list li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    min-width: 0;
  }

  .hc-item {
    display: flex;
    min-width: 0;
    align-items: baseline;
    gap: 6px;
  }

  .hc-item-name {
    color: var(--home-fg-primary);
    white-space: nowrap;
  }

  .hc-item-meta {
    flex: none;
    font-size: 12px;
    color: var(--home-fg-faint);
    white-space: nowrap;
  }

  .hc-item .hc-item-meta {
    flex: 1 1 auto;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hc-clamp-1 {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hc-stars {
    flex: none;
    font-size: 12px;
    color: var(--home-fg-secondary);
  }

  .hc-mood {
    display: grid;
    gap: 6px;
    min-height: 44px;
  }

  .hc-mood-text {
    display: -webkit-box;
    overflow: hidden;
    color: var(--home-fg-primary);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow-wrap: anywhere;
  }

  .hc-mood-meta {
    font-size: 12px;
    color: var(--home-fg-faint);
  }

  .hc-skeleton {
    height: 10px;
    margin-top: 4px;
    border-radius: 999px;
    background: hsl(var(--foreground) / 0.07);
  }

  .hc-skeleton--short {
    width: 60%;
  }

  /* The /message page is a conversation, so its promise is a speech bubble
     here too, in the owner's corner. */
  .hc-bubble {
    width: fit-content;
    max-width: 100%;
    padding: 7px 10px;
    border-radius: 12px 12px 12px 4px;
    background: hsl(var(--foreground) / 0.06);
    color: var(--home-fg-primary);
  }

  .hc-text {
    color: var(--home-fg-faint);
  }

  .hc-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid hsl(var(--foreground) / 0.07);
    font-family: var(--font-mono);
    font-size: var(--home-text-label);
    color: var(--home-fg-faint);
  }

  .hc-foot :global(.hc-arrow) {
    width: 12px;
    height: 12px;
  }

  @media (prefers-reduced-motion: reduce) {
    .hc,
    .hc[data-open] {
      scale: 1;
      translate: 0 0;
      transition: none;
    }
  }
</style>

<script>
  const layer = document.querySelector<HTMLElement>('[data-hero-cards]');
  const bio = document.querySelector<HTMLElement>('[data-hero-bio]');

  // Hover intent: a pass over a link on the way elsewhere opens nothing.
  const OPEN_DELAY_MS = 120;
  const CLOSE_DELAY_MS = 80;
  const GAP = 8;
  const VIEWPORT_MARGIN = 8;

  let current: HTMLElement | null = null;
  let openTimer = 0;
  let closeTimer = 0;

  const cardFor = (link: HTMLElement): HTMLElement | null =>
    layer?.querySelector<HTMLElement>(`[data-card-id="${link.dataset.card}"]`) ?? null;

  // Above the word, left edges aligned; below it when the viewport has no room.
  const place = (card: HTMLElement, link: HTMLElement): void => {
    if (!layer) return;
    const host = layer.getBoundingClientRect();
    const word = link.getBoundingClientRect();
    const width = card.offsetWidth;
    const height = card.offsetHeight;
    const left = Math.min(Math.max(word.left - host.left - 12, 0), Math.max(host.width - width, 0));
    const above = word.top - height - GAP >= VIEWPORT_MARGIN;
    const top = above ? word.top - host.top - height - GAP : word.bottom - host.top + GAP;
    card.style.left = `${Math.round(left)}px`;
    card.style.top = `${Math.round(top)}px`;
    card.dataset.side = above ? 'top' : 'bottom';
  };

  const relativeTime = (iso: string): string => {
    const then = new Date(iso).getTime();
    if (Number.isNaN(then)) return '';
    const minutes = Math.round((Date.now() - then) / 60_000);
    if (minutes < 1) return 'just now';
    if (minutes < 60) return `${minutes}m ago`;
    const hours = Math.round(minutes / 60);
    if (hours < 24) return `${hours}h ago`;
    const days = Math.round(hours / 24);
    if (days < 7) return `${days}d ago`;
    return new Date(iso).toLocaleDateString('en', { month: 'short', day: 'numeric' });
  };

  let moodRequested = false;
  const loadMood = async (card: HTMLElement): Promise<void> => {
    if (moodRequested) return;
    moodRequested = true;
    const slot = card.querySelector<HTMLElement>('[data-mood-latest]');
    if (!slot) return;
    let text = 'Could not load the latest one.';
    let meta = '';
    try {
      const response = await fetch('/api/moods');
      if (!response.ok) throw new Error(String(response.status));
      const data = (await response.json()) as { posts?: { previewText?: string; datetime?: string; tag?: string }[] };
      const latest = data.posts?.[0];
      if (latest) {
        text = latest.previewText?.trim() || 'A photo, no words.';
        meta = ['Latest', relativeTime(latest.datetime ?? ''), latest.tag].filter(Boolean).join(' · ');
      }
    } catch {
      // Keep the fallback line; the link still works.
    }
    const body = document.createElement('p');
    body.className = 'hc-mood-text';
    body.textContent = text;
    slot.replaceChildren(body);
    if (meta) {
      const line = document.createElement('span');
      line.className = 'hc-mood-meta';
      line.textContent = meta;
      slot.append(line);
    }
    // Scoped styles need the component's attribute on nodes made here.
    const scope = Array.from(slot.attributes).find((attr) => attr.name.startsWith('data-astro-cid'));
    if (scope) slot.querySelectorAll('*').forEach((node) => node.setAttribute(scope.name, ''));
    slot.removeAttribute('aria-busy');
    if (current === card) {
      const link = bio?.querySelector<HTMLElement>('[data-card="moods"]');
      if (link) place(card, link);
    }
  };

  // The GitHub widget in the hero already fetched the year's total.
  const fillContributions = (card: HTMLElement): void => {
    const total = document.querySelector('[data-total] strong')?.textContent;
    const row = card.querySelector<HTMLElement>('[data-contrib-row]');
    const slot = card.querySelector<HTMLElement>('[data-contrib]');
    if (!total || !row || !slot) return;
    slot.textContent = `${total} contributions`;
    row.hidden = false;
  };

  const open = (link: HTMLElement): void => {
    const card = cardFor(link);
    if (!card || card === current) return;
    const switching = current !== null;
    if (current) {
      current.dataset.instant = '';
      delete current.dataset.open;
    }
    if (card.dataset.cardId === 'moods') void loadMood(card);
    if (card.dataset.cardId === 'github') fillContributions(card);
    if (switching) card.dataset.instant = '';
    else delete card.dataset.instant;
    place(card, link);
    card.dataset.open = '';
    current = card;
  };

  const close = (): void => {
    if (!current) return;
    delete current.dataset.instant;
    delete current.dataset.open;
    current = null;
  };

  const linkFrom = (target: EventTarget | null): HTMLElement | null =>
    target instanceof Element ? target.closest<HTMLElement>('a[data-card]') : null;

  if (layer && bio) {
    bio.addEventListener('pointerover', (event) => {
      if (event.pointerType !== 'mouse') return;
      const link = linkFrom(event.target);
      if (!link) return;
      // Any link hover is intent to explore; start the one network read now
      // so the mood card rarely opens on its skeleton.
      const moods = layer.querySelector<HTMLElement>('[data-card-id="moods"]');
      if (moods) void loadMood(moods);
      window.clearTimeout(closeTimer);
      window.clearTimeout(openTimer);
      if (current) open(link);
      else openTimer = window.setTimeout(() => open(link), OPEN_DELAY_MS);
    });

    bio.addEventListener('pointerout', (event) => {
      if (event.pointerType !== 'mouse') return;
      const link = linkFrom(event.target);
      if (!link || link.contains(event.relatedTarget as Node | null)) return;
      window.clearTimeout(openTimer);
      closeTimer = window.setTimeout(close, CLOSE_DELAY_MS);
    });

    bio.addEventListener('focusin', (event) => {
      const link = linkFrom(event.target);
      if (link?.matches(':focus-visible')) open(link);
    });

    bio.addEventListener('focusout', close);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close();
    });
  }
</script>
