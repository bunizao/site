---
// Hover cards for the hero bio links. Each link names one (`data-card`), and
// each card is its own object, not a template with different rows: a student
// card for Monash, a hand of project cards, a table of contents for the blog,
// the latest moods as a channel, an envelope for /message, a contribution
// heatmap for GitHub, a chat for Telegram and a story ring for Instagram.
//
// The cards sit outside the decode root on purpose. The decode flattens
// everything inside it and swaps the markup back when it settles, so the
// script listens on the bio by delegation and positions one card at a time.
// They are a pointer enhancement: every destination is also the link itself,
// so the cards stay out of the accessibility tree and the tab order.
import { ArrowRight, ArrowUpRight, Clock, Lock, Send } from 'lucide-react';
import { blog, experience, hero, profile, projects } from '@/data/site';
import { messageCopy } from '@/features/messages/copy';
import { postPath } from '@/features/posts/format';
import { getListedPosts } from '@/features/posts/server/content';
import { GitHubIcon, InstagramIcon, TelegramIcon } from '@/components/icons';

const school = experience[0];
const [since] = school.period.split(' — ');
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const [sinceMonth, sinceYear] = since.split(' ');
const sinceKey = `${sinceYear}-${String(MONTHS.indexOf(sinceMonth) + 1).padStart(2, '0')}`;

const blogCopy = blog.copy[blog.locale.home];
const allPosts = await getListedPosts();
const posts = allPosts.slice(0, 3);
const postDate = (iso: string): string => {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return '';
  return `${MONTHS[d.getUTCMonth()]} ${d.getUTCFullYear()}`;
};

// "TutuBetterRules" may break as "TutuBetter / Rules" on a narrow card.
const camelBreaks = (name: string): string => name.replace(/([a-z])([A-Z])/g, '$1<wbr>$2');

const totalStars = projects.reduce((sum, project) => sum + (project.stars ?? 0), 0);
const topRepo = projects
  .filter((project) => project.stars !== null)
  .sort((a, b) => (b.stars ?? 0) - (a.stars ?? 0))[0];
// A hand of cards: fanned out from the middle, the outer ones lower and
// turned further.
const fan = (i: number, n: number) => {
  const t = n === 1 ? 0 : (i / (n - 1)) * 2 - 1;
  return `--i: ${i}; --fx: ${Math.round(t * 92)}px; --fy: ${Math.round(Math.abs(t) * 12)}px; --fr: ${(t * 8).toFixed(1)}deg`;
};

// "github.com/bunizao", "t.me/hututu0": where a link really lands.
const host = (url: string): string => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const channel = (name: string) => {
  const social = hero.socials.find((link) => link.name === name);
  if (!social) return null;
  const target = social.canonicalUrl ?? social.url;
  return { ...social, short: host(social.url), target: host(target), handle: `@${host(target).split('/').pop()}` };
};
const github = channel('GitHub');
const telegram = channel('Telegram');
const instagram = channel('Instagram');
const external = { target: '_blank', rel: 'noopener noreferrer', tabindex: -1 };
---

<div class="hero-cards" data-hero-cards aria-hidden="true">
  <!-- Monash: a student card. -->
  <div class="hc hc--monash" data-card-id="monash">
    <span class="mo-watermark"></span>
    <div class="mo-top">
      <span class="mo-crest"></span>
      <span class="hc-id">
        <span class="hc-eyebrow">Student</span>
        <span class="hc-title">{school.org}</span>
        <span class="hc-sub">Faculty of Information Technology</span>
      </span>
    </div>
    <dl class="mo-fields">
      <div><dt>Course</dt><dd>Computer Science</dd></div>
      <div><dt>Major</dt><dd>Data Science &amp; AI</dd></div>
    </dl>
    <div class="mo-terms" data-terms data-since={sinceKey}>
      <div class="mo-terms-head">
        <span>Since {since}</span>
        <span class="mo-now" data-term-now></span>
      </div>
      <div class="mo-track" data-term-track></div>
    </div>
    <p class="mo-motto"><em>Ancora imparo</em> · I am still learning</p>
    <a class="hc-foot" href={school.url} {...external}>
      <span>{host(school.url)}</span>
      <span class="hc-foot-note">Clayton campus</span>
      <ArrowUpRight className="hc-arrow" aria-hidden="true" />
    </a>
  </div>

  <!-- Projects: a hand of cards. -->
  <div class="hc hc--projects" data-card-id="projects">
    <div class="hc-row">
      <span class="hc-id">
        <span class="hc-title">Projects</span>
        <span class="hc-sub">{projects.length} open-source projects</span>
      </span>
      <span class="hc-stat"><strong class="hc-num">{totalStars}</strong> stars</span>
    </div>
    <div class="pj-stage" data-pj-stage>
      {projects.map((project, i) => (
        <a
          class="pj-mini"
          href={project.url}
          {...external}
          style={fan(i, projects.length)}
          data-name={project.name}
          data-blurb={project.blurb}
        >
          <span class="pj-type">{project.type}</span>
          <span class="pj-name" set:html={camelBreaks(project.name)} />
          <span class="pj-stars hc-num">{project.stars !== null ? `★ ${project.stars}` : 'Suite'}</span>
        </a>
      ))}
    </div>
    <p class="pj-caption" data-pj-caption>
      <strong>Pick a card.</strong> Each one tells you what it is and why it exists.
    </p>
    <a class="hc-foot" href="/projects" tabindex="-1">
      <span>/projects</span>
      <ArrowRight className="hc-arrow" aria-hidden="true" />
    </a>
  </div>

  <!-- Write: the blog's table of contents. -->
  <div class="hc hc--write" data-card-id="write">
    <div class="hc-row hc-row--start">
      <span class="wr-mark"><img src={blog.mark} alt="" width="28" height="28" loading="lazy" decoding="async" /></span>
      <span class="hc-id">
        <span class="hc-title">{blogCopy.name}</span>
        <span class="hc-sub hc-clamp-2">{blogCopy.tagline}</span>
      </span>
    </div>
    <div class="wr-label">
      <span>Latest</span>
      <span class="hc-num">{allPosts.length} posts</span>
    </div>
    {posts.length > 0 ? (
      <ol class="wr-toc">
        {posts.map((post, i) => (
          <li>
            <a href={postPath(post.slug)} tabindex="-1">
              <span class="wr-num hc-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="wr-title">{post.title}</span>
              <span class="wr-leader"></span>
              <span class="wr-date hc-num">{postDate(post.publishedAt)}</span>
            </a>
          </li>
        ))}
      </ol>
    ) : (
      <p class="hc-note">Nothing published yet.</p>
    )}
    <a class="hc-foot" href="/blog" tabindex="-1">
      <span>/blog</span>
      <ArrowRight className="hc-arrow" aria-hidden="true" />
    </a>
  </div>

  <!-- Moods: the channel, newest at the bottom. -->
  <div class="hc hc--moods" data-card-id="moods">
    <div class="hc-row">
      <span class="hc-id">
        <span class="hc-title">Moods</span>
        <span class="hc-sub">Short notes, as they happen</span>
      </span>
      <span class="md-live"><span class="md-dot"></span>Live</span>
    </div>
    <div class="md-stream" data-mood-stream>
      <span class="md-typing"><span></span><span></span><span></span></span>
    </div>
    <a class="hc-foot" href="/mood" tabindex="-1">
      <span>/mood</span>
      <ArrowRight className="hc-arrow" aria-hidden="true" />
    </a>
  </div>

  <!-- Message: an envelope that opens. -->
  <div class="hc hc--message" data-card-id="message">
    <div class="ms-stage">
      <div class="ms-env">
        <span class="ms-back"></span>
        <span class="ms-letter">
          {messageCopy.intro}
          <span class="ms-sign">— {profile.name.split(' ')[0]}</span>
        </span>
        <span class="ms-front"></span>
        <span class="ms-flap"></span>
      </div>
    </div>
    <span class="hc-title">Leave a message</span>
    <ul class="hc-facts">
      <li><Lock className="hc-fact-icon" aria-hidden="true" />{messageCopy.privacy}</li>
      <li><Clock className="hc-fact-icon" aria-hidden="true" /><span>It's <span data-melbourne-time>…</span> in Melbourne</span></li>
    </ul>
    <a class="hc-foot" href="/message" tabindex="-1">
      <span>/message</span>
      <ArrowRight className="hc-arrow" aria-hidden="true" />
    </a>
  </div>

  <!-- GitHub: twelve weeks of contributions. -->
  {github && (
    <div class="hc hc--github" data-card-id="github">
      <div class="hc-row">
        <span class="hc-row hc-row--tight">
          <img class="hc-avatar" src="/avatar.webp" alt="" width="36" height="36" loading="lazy" decoding="async" />
          <span class="hc-id">
            <span class="hc-title">{github.handle}</span>
            <span class="hc-sub">{profile.name}</span>
          </span>
        </span>
        <GitHubIcon className="hc-brand" />
      </div>
      <div class="gh-body">
        <div class="gh-heat" data-heat></div>
        <dl class="gh-stats">
          <div><dt>Last year</dt><dd class="hc-num" data-gh-total>—</dd></div>
          <div><dt>Busiest day</dt><dd class="hc-num" data-gh-best>—</dd></div>
          <div><dt>Streak</dt><dd class="hc-num" data-gh-streak>—</dd></div>
        </dl>
      </div>
      <p class="gh-caption" data-heat-caption>Last 12 weeks</p>
      {topRepo && (
        <a class="gh-repo" href={topRepo.url} {...external}>
          <span class="gh-repo-label">Top repo</span>
          <span class="gh-repo-name">{topRepo.name}</span>
          <span class="hc-num gh-repo-stars">★ {topRepo.stars}</span>
        </a>
      )}
      <a class="hc-foot" href={github.url} {...external}>
        <span>{github.target}</span>
        <span class="hc-foot-note">{github.short}</span>
        <ArrowUpRight className="hc-arrow" aria-hidden="true" />
      </a>
    </div>
  )}

  <!-- Telegram: a chat, already open. -->
  {telegram && (
    <div class="hc hc--telegram" data-card-id="telegram">
      <div class="hc-row">
        <span class="hc-row hc-row--tight">
          <img class="hc-avatar" src="/avatar.webp" alt="" width="36" height="36" loading="lazy" decoding="async" />
          <span class="hc-id">
            <span class="hc-title">{profile.name}</span>
            <span class="hc-sub">{telegram.handle} · <span data-melbourne-time>…</span> for me</span>
          </span>
        </span>
        <TelegramIcon className="hc-brand" />
      </div>
      <div class="tg-chat">
        <span class="tg-bubble">Hey! {telegram.description}, about anything.</span>
      </div>
      <a class="tg-composer" href={telegram.url} {...external}>
        <span>Say hi on Telegram</span>
        <span class="tg-send"><Send className="tg-plane" aria-hidden="true" /></span>
      </a>
      <a class="hc-foot" href={telegram.url} {...external}>
        <span>{telegram.target}</span>
        <span class="hc-foot-note">{telegram.short}</span>
        <ArrowUpRight className="hc-arrow" aria-hidden="true" />
      </a>
    </div>
  )}

  <!-- Instagram: the profile, behind a story ring. -->
  {instagram && (
    <div class="hc hc--instagram" data-card-id="instagram">
      <span class="ig-ring"><img src="/avatar.webp" alt="" width="64" height="64" loading="lazy" decoding="async" /></span>
      <span class="hc-title">{instagram.handle}</span>
      <span class="hc-sub">{profile.name} · {instagram.description}</span>
      <a class="ig-button" href={instagram.url} {...external}>
        <InstagramIcon className="ig-button-icon" />View profile
      </a>
      <a class="hc-foot" href={instagram.url} {...external}>
        <span>{instagram.target}</span>
        <span class="hc-foot-note">{instagram.short}</span>
        <ArrowUpRight className="hc-arrow" aria-hidden="true" />
      </a>
    </div>
  )}
</div>

<style>
  /* The layer covers the hero so a card can sit anywhere over it. Only the
     open card takes the pointer, so it can be read and clicked. */
  .hero-cards {
    position: absolute;
    inset: 0;
    z-index: 30;
    pointer-events: none;
  }

  /* ---------- Shell ------------------------------------------------------ */

  /* A card is a raised piece of the home surface, the same edge and drop as
     the project deck. It speaks in the sans UI voice. */
  .hc {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--hc-w, 296px);
    padding: 16px;
    overflow: hidden;
    border-radius: 16px;
    background: var(--home-surface);
    box-shadow: var(--home-surface-shadow-raised);
    font-family: var(--font-sans);
    font-size: var(--home-text-meta);
    line-height: 1.4;
    color: var(--home-fg-secondary);
    opacity: 0;
    visibility: hidden;
    scale: 0.96;
    translate: 0 6px;
    transform-origin: var(--hc-origin, 24px 100%);
    transition:
      opacity 140ms var(--ease-out),
      scale 140ms var(--ease-out),
      translate 140ms var(--ease-out),
      visibility 0s 140ms;
  }

  .hc[data-side='bottom'] {
    --hc-origin: 24px 0;
    translate: 0 -6px;
  }

  .hc[data-open] {
    opacity: 1;
    visibility: visible;
    scale: 1;
    translate: 0 0;
    pointer-events: auto;
    transition:
      opacity 200ms var(--ease-out),
      scale 260ms var(--ease-out),
      translate 260ms var(--ease-out),
      visibility 0s;
  }

  /* Switching between links swaps the card in place, no second entrance. */
  .hc[data-instant] {
    transition: none;
  }

  /* Zero specificity, so every link class below sets its own colour. */
  :where(.hc a) {
    color: inherit;
    text-decoration: none;
  }

  .hc-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .hc-row--start {
    align-items: flex-start;
    justify-content: flex-start;
  }

  .hc-row--tight {
    justify-content: flex-start;
    gap: 10px;
    min-width: 0;
  }

  .hc-id {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 1px;
  }

  .hc-eyebrow,
  .mo-fields dt,
  .mo-terms-head span:first-child,
  .wr-label,
  .md-live,
  .pj-type {
    font-size: 10px;
    font-weight: var(--home-weight-eyebrow);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--home-fg-faint);
  }

  .hc-eyebrow {
    margin-bottom: 2px;
  }

  .hc-title {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--home-fg-primary);
  }

  .hc-sub {
    overflow: hidden;
    font-size: 12px;
    color: var(--home-fg-faint);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hc-clamp-2 {
    display: -webkit-box;
    white-space: normal;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .hc-num {
    font-variant-numeric: tabular-nums;
  }

  .hc-stat {
    flex: none;
    font-size: 12px;
    color: var(--home-fg-faint);
  }

  .hc-stat strong {
    font-size: 15px;
    font-weight: 600;
    color: var(--home-fg-primary);
  }

  .hc :global(.hc-brand) {
    flex: none;
    width: 18px;
    height: 18px;
    color: var(--home-fg-faint);
  }

  .hc-avatar {
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    outline: 1px solid var(--home-image-outline);
    outline-offset: -1px;
  }

  .hc-note {
    margin: 12px 0 0;
    color: var(--home-fg-faint);
  }

  /* The way out: where the click lands, and the short link when there is one. */
  .hc-foot {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 14px -16px -16px;
    padding: 10px 16px;
    border-top: 1px solid hsl(var(--foreground) / 0.07);
    font-family: var(--font-mono);
    font-size: var(--home-text-label);
    color: var(--home-fg-faint);
    transition:
      color 150ms ease,
      background-color 150ms ease;
  }

  .hc-foot:hover {
    background: hsl(var(--foreground) / 0.03);
    color: var(--home-fg-primary);
  }

  .hc-foot-note {
    margin-left: auto;
    opacity: 0.7;
  }

  .hc-foot :global(.hc-arrow) {
    flex: none;
    width: 12px;
    height: 12px;
    margin-left: auto;
  }

  .hc-foot-note + :global(.hc-arrow) {
    margin-left: 0;
  }

  /* ---------- Monash: student card --------------------------------------- */

  .hc--monash {
    --hc-w: 304px;
  }

  .mo-crest,
  .mo-watermark {
    background: currentColor;
    mask: url('/brands/monash-crest.svg') center / contain no-repeat;
  }

  .mo-top {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .mo-crest {
    flex: none;
    width: 40px;
    height: 44px;
    color: var(--home-fg-primary);
  }

  /* The crest again, huge and faint, bleeding off the corner like the
     security print on a real card. */
  .mo-watermark {
    position: absolute;
    right: -34px;
    bottom: 18px;
    width: 168px;
    height: 182px;
    color: hsl(var(--foreground) / 0.045);
    rotate: -12deg;
    pointer-events: none;
  }

  .mo-fields {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 16px 0 0;
    padding-top: 14px;
    border-top: 1px dashed hsl(var(--foreground) / 0.12);
  }

  .mo-fields dd {
    margin: 3px 0 0;
    font-weight: 500;
    color: var(--home-fg-primary);
  }

  .mo-terms {
    position: relative;
    margin-top: 16px;
  }

  .mo-terms-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .mo-now {
    font-size: 12px;
    font-weight: 500;
    color: var(--home-fg-primary);
  }

  .mo-track {
    display: flex;
    gap: 4px;
    margin-top: 8px;
  }

  .mo-track :global(.mo-term) {
    display: grid;
    flex: 1;
    gap: 5px;
    font-size: 10px;
    color: var(--home-fg-faint);
    font-variant-numeric: tabular-nums;
  }

  .mo-track :global(.mo-term)::before {
    content: '';
    height: 6px;
    border-radius: 3px;
    background: hsl(var(--foreground) / 0.5);
  }

  .mo-track :global(.mo-term[data-current]) {
    color: var(--home-fg-primary);
  }

  .mo-track :global(.mo-term[data-current])::before {
    background: var(--home-accent);
  }

  .mo-motto {
    position: relative;
    margin: 14px 0 0;
    font-size: 12px;
    color: var(--home-fg-faint);
  }

  .mo-motto em {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 13px;
    color: var(--home-fg-secondary);
  }

  /* ---------- Projects: a hand of cards ---------------------------------- */

  .hc--projects {
    --hc-w: 328px;
  }

  .pj-stage {
    position: relative;
    height: 132px;
    margin-top: 10px;
  }

  .pj-mini {
    position: absolute;
    top: 18px;
    left: 50%;
    z-index: var(--i);
    display: flex;
    flex-direction: column;
    width: 108px;
    height: 88px;
    padding: 10px;
    border-radius: 10px;
    background: var(--home-surface);
    box-shadow:
      var(--home-surface-shadow),
      0 8px 16px -10px oklch(0 0 0 / 0.25);
    color: var(--home-fg-primary);
    transform-origin: 50% 120%;
    transform: translate(calc(-50% + var(--fx)), var(--fy)) rotate(var(--fr));
    transition:
      transform 240ms var(--ease-out),
      opacity 200ms ease;
  }

  /* Dealt from a stack on open. `backwards` fill only, so once the deal ends
     the hover transform owns the card again. */
  .hc[data-open] .pj-mini {
    animation: pj-deal 560ms cubic-bezier(0.2, 1.2, 0.4, 1) backwards;
    animation-delay: calc(60ms + var(--i) * 50ms);
  }

  @keyframes pj-deal {
    from {
      transform: translate(-50%, 18px) rotate(0deg) scale(0.9);
    }
  }

  .pj-mini:hover {
    z-index: 10;
    transform: translate(calc(-50% + var(--fx)), calc(var(--fy) - 14px)) rotate(0deg) scale(1.06);
  }

  .pj-stage:hover .pj-mini:not(:hover) {
    opacity: 0.6;
  }

  .pj-type {
    overflow: hidden;
    font-size: 9.5px;
    letter-spacing: 0.1em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pj-name {
    margin-top: auto;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.2;
  }

  .pj-stars {
    margin-top: 3px;
    font-size: 11px;
    color: var(--home-fg-faint);
  }

  .pj-caption {
    min-height: 4.5em;
    margin: 12px 0 0;
    font-size: 12px;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .pj-caption :global(strong) {
    font-weight: 600;
    color: var(--home-fg-primary);
  }

  /* ---------- Write: table of contents ----------------------------------- */

  .hc--write {
    --hc-w: 312px;
  }

  .hc--write .hc-row--start {
    gap: 12px;
  }

  .wr-mark {
    display: grid;
    flex: none;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--home-surface);
    box-shadow: var(--home-surface-shadow);
  }

  .wr-mark img {
    width: 28px;
    height: 28px;
    object-fit: contain;
  }

  :global(.dark) .wr-mark img {
    filter: invert(1);
  }

  .hc--write .hc-title {
    font-family: var(--font-display);
    font-size: 15px;
  }

  .wr-label {
    display: flex;
    justify-content: space-between;
    margin-top: 16px;
  }

  /* One track that may shrink below the titles' nowrap width. */
  .wr-toc {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 6px -8px 0;
    padding: 0;
    list-style: none;
  }

  .wr-toc a {
