---
interface Props {
  texts: string[];
  speed?: number;
  delay?: number;
  pauseDuration?: number;
}

const { texts, speed = 80, delay = 0, pauseDuration = 2000 } = Astro.props;
const initialText = texts[0] ?? '';
const longestText = texts.reduce((a, b) => a.length > b.length ? a : b, '');
const cycleTexts = texts.length ? texts : [''];
const wordWindow = Math.max(1800, pauseDuration + longestText.length * speed);
const cycleDuration = Math.max(1, cycleTexts.length) * wordWindow;
---

<span
  class="typewriter-wrapper"
  style={`--typewriter-count: ${cycleTexts.length}; --typewriter-duration: ${cycleDuration}ms; --typewriter-window: ${wordWindow}ms; --typewriter-delay: ${delay}ms;`}
>
  <!-- Hidden placeholder keeps the animated text width stable. -->
  <span class="typewriter-placeholder" aria-hidden="true">{longestText}</span>
  <span
    class="typewriter"
    aria-label={initialText}
  >
    <span class="typewriter-text">{initialText}</span>
    <span class="typewriter-reel" aria-hidden="true">
      <span class="typewriter-reel-track">
        {cycleTexts.map((text) => <span class="typewriter-word">{text}</span>)}
        <span class="typewriter-word">{cycleTexts[0]}</span>
      </span>
    </span>
  </span>
</span>

<style>
  .typewriter-wrapper {
    display: inline-grid;
  }

  .typewriter-wrapper > * {
    grid-area: 1 / 1;
  }

  .typewriter-placeholder {
    visibility: hidden;
  }

  .typewriter {
    position: relative;
    display: inline-grid;
    white-space: pre;
  }

  .typewriter > * {
    grid-area: 1 / 1;
  }

  .typewriter-text {
    position: relative;
    z-index: 0;
  }

  .typewriter-reel {
    position: relative;
    z-index: 1;
    display: block;
    height: 1.2em;
    overflow: hidden;
    background: hsl(var(--background));
    isolation: isolate;
    line-height: 1.2;
  }

  .typewriter-reel::before,
  .typewriter-reel::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 2;
    pointer-events: none;
  }

  .typewriter-reel::before {
    width: 48%;
    background: linear-gradient(
      90deg,
      transparent,
      hsl(var(--foreground) / 0.08) 32%,
      hsl(var(--foreground) / 0.34) 50%,
      transparent 72%
    );
    filter: blur(0.2px);
    mix-blend-mode: screen;
    animation: stream-scan var(--typewriter-window) steps(18, end) var(--typewriter-delay) infinite;
  }

  .typewriter-reel::after {
    left: 0;
    width: 2px;
    background: hsl(var(--foreground));
    box-shadow: 0 0 12px hsl(var(--foreground) / 0.45);
    animation: stream-caret var(--typewriter-window) steps(18, end) var(--typewriter-delay) infinite;
  }

  .typewriter-reel-track {
    display: flex;
    flex-direction: column;
    animation: word-reel var(--typewriter-duration) steps(var(--typewriter-count)) var(--typewriter-delay) infinite;
    will-change: transform;
  }

  .typewriter-word {
    display: block;
    animation: stream-word var(--typewriter-window) steps(10, end) var(--typewriter-delay) infinite;
    line-height: 1.2;
  }

  @keyframes word-reel {
    to {
      transform: translateY(calc(var(--typewriter-count) * -1.2em));
    }
  }

  @keyframes stream-scan {
    0% {
      opacity: 0;
      transform: translateX(-120%);
    }
    12%,
    72% {
      opacity: 1;
    }
    88%,
    100% {
      opacity: 0;
      transform: translateX(190%);
    }
  }

  @keyframes stream-caret {
    0% {
      left: 0;
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    72% {
      left: calc(100% - 2px);
      opacity: 1;
    }
    88%,
    100% {
      left: calc(100% - 2px);
      opacity: 0;
    }
  }

  @keyframes stream-word {
    0% {
      filter: blur(0.4px);
      opacity: 0.74;
      text-shadow: none;
    }
    20%,
    72% {
      filter: none;
      opacity: 1;
      text-shadow: 0 0 14px hsl(var(--foreground) / 0.16);
    }
    100% {
      filter: none;
      opacity: 0.92;
      text-shadow: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .typewriter-reel::before,
    .typewriter-reel::after,
    .typewriter-reel-track,
    .typewriter-word {
      animation: none;
    }
  }
</style>
