---
interface Props {
  texts: string[];
  speed?: number;
  delay?: number;
  pauseDuration?: number;
}

const { texts, speed = 110, delay = 0, pauseDuration = 2600 } = Astro.props;
const initialText = texts[0] ?? '';
const longestText = texts.reduce((a, b) => a.length > b.length ? a : b, '');
---

<span class="typewriter-wrapper">
  <!-- Hidden placeholder keeps the animated text width stable. -->
  <span class="typewriter-placeholder" aria-hidden="true">{longestText}</span>
  <span
    class="typewriter"
    data-texts={JSON.stringify(texts)}
    data-speed={speed}
    data-delay={delay}
    data-pause={pauseDuration}
  >
    <span class="typewriter-text">{initialText}</span><span class="typewriter-cursor"></span>
  </span>
</span>

<style>
  .typewriter-wrapper {
    display: inline-grid;
  }

  .typewriter-wrapper > * {
    grid-area: 1 / 1;
  }

  .typewriter-placeholder {
    visibility: hidden;
  }

  .typewriter {
    display: inline;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.typewriter').forEach((el) => {
      const texts: string[] = JSON.parse(el.getAttribute('data-texts') || '[]');
      const speed = parseInt(el.getAttribute('data-speed') || '110');
      const delay = parseInt(el.getAttribute('data-delay') || '0');
      const pauseDuration = parseInt(el.getAttribute('data-pause') || '2600');
      const textEl = el.querySelector('.typewriter-text');

      if (!textEl || texts.length === 0) return;

      let textIndex = 0;
      let charIndex = textEl.textContent?.length ?? 0;
      let isDeleting = charIndex > 0;

      const type = () => {
        const currentText = texts[textIndex];

        if (isDeleting) {
          textEl.textContent = currentText.substring(0, charIndex - 1);
          charIndex--;

          if (charIndex === 0) {
            isDeleting = false;
            textIndex = (textIndex + 1) % texts.length;
            setTimeout(type, speed * 1.6);
          } else {
            setTimeout(type, speed * 0.4);
          }
        } else {
          textEl.textContent = currentText.substring(0, charIndex + 1);
          charIndex++;

          if (charIndex === currentText.length) {
            isDeleting = true;
            setTimeout(type, pauseDuration);
          } else {
            const jitter = (Math.random() - 0.5) * 24;
            setTimeout(type, speed + jitter);
          }
        }
      };

      const startDelay = charIndex > 0 ? delay + pauseDuration : delay;
      setTimeout(type, startDelay);
    });
  });
</script>
