---
interface Props {
  texts: string[];
  speed?: number;
  delay?: number;
  pauseDuration?: number;
}

const { texts, speed = 80, delay = 0, pauseDuration = 2000 } = Astro.props;
const initialText = texts[0] ?? '';
const longestText = texts.reduce((a, b) => a.length > b.length ? a : b, '');
const placeholderText = `${longestText}_`;
---

<span
  class="typewriter-wrapper"
  data-typewriter-root
  data-texts={JSON.stringify(texts)}
  data-speed={speed}
  data-delay={delay}
  data-pause={pauseDuration}
>
  <!-- Hidden placeholder keeps the canvas stage stable. -->
  <span class="typewriter-placeholder" aria-hidden="true">{placeholderText}</span>
  <span class="typewriter" data-typewriter-visual aria-label={initialText}><span class="typewriter-text" data-typewriter-text>{initialText}</span><canvas class="typewriter-canvas" data-typewriter-canvas aria-hidden="true"></canvas></span>
</span>

<style>
  .typewriter-wrapper {
    display: inline-grid;
    grid-template-columns: max-content;
    align-items: baseline;
    vertical-align: baseline;
  }

  .typewriter-wrapper > * {
    grid-area: 1 / 1;
  }

  .typewriter-placeholder {
    visibility: hidden;
    white-space: pre;
  }

  .typewriter {
    position: relative;
    display: block;
    width: 100%;
    white-space: pre;
    line-height: inherit;
  }

  .typewriter-canvas {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
  }

  .typewriter-text {
    display: block;
    width: 100%;
    white-space: pre;
  }

  .typewriter.is-enhanced .typewriter-text {
    color: transparent;
  }

  .typewriter.is-enhanced .typewriter-canvas {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .typewriter.is-enhanced .typewriter-text {
      color: currentColor;
    }

    .typewriter.is-enhanced .typewriter-canvas {
      opacity: 0;
    }
  }
</style>

<script>
  type TypewriterRoot = HTMLElement & {
    _typewriterReady?: boolean;
    _typewriterStarted?: boolean;
    _typewriterStartTimer?: number;
    _typewriterLoopTimer?: number;
    _typewriterFrame?: number;
    _typewriterCursorTimer?: number;
    _typewriterAbort?: AbortController;
    _typewriterCurrentText?: string;
    _typewriterResizeObserver?: ResizeObserver;
  };

  interface CanvasState {
    context: CanvasRenderingContext2D;
    width: number;
    height: number;
    font: string;
    color: string;
    baseline: number;
    cursorY: number;
    cursorHeight: number;
  }

  const HERO_NAME_READY_EVENT = 'home:hero-name-ready';
  const FALLBACK_START_MS = 1100;
  const SCRAMBLE_CHARS = '_-—/\\|<>'.split('');

  const prefersReducedMotion = (): boolean =>
    window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false;

  const parseTexts = (root: TypewriterRoot): string[] => {
    try {
      const parsed = JSON.parse(root.dataset.texts || '[]');
      return Array.isArray(parsed) ? parsed.filter((text): text is string => typeof text === 'string') : [];
    } catch {
      return [];
    }
  };

  const stepDelayFor = (speed: number): number =>
    Math.max(36, Math.min(64, Math.round(speed * 0.6)));

  const durationFor = (text: string, speed: number): number =>
    Math.max(260, Math.min(560, text.length * stepDelayFor(speed)));

  const randomScrambleChar = (): string =>
    SCRAMBLE_CHARS[Math.floor(Math.random() * SCRAMBLE_CHARS.length)] ?? '_';

  const setupCanvas = (visual: HTMLElement, canvas: HTMLCanvasElement): CanvasState | null => {
    const context = canvas.getContext('2d');
    if (!context) return null;

    const rect = visual.getBoundingClientRect();
    const styles = window.getComputedStyle(visual);
    const dpr = Math.max(1, window.devicePixelRatio || 1);
    const fontSize = Number.parseFloat(styles.fontSize) || 36;
    const width = Math.max(1, rect.width);
    const height = Math.max(1, rect.height || fontSize * 1.2);
    const bitmapWidth = Math.max(1, Math.round(width * dpr));
    const bitmapHeight = Math.max(1, Math.round(height * dpr));

    if (canvas.width !== bitmapWidth) {
      canvas.width = bitmapWidth;
    }

    if (canvas.height !== bitmapHeight) {
      canvas.height = bitmapHeight;
    }

    canvas.style.width = '100%';
    canvas.style.height = '100%';

    context.setTransform(bitmapWidth / width, 0, 0, bitmapHeight / height, 0, 0);
    const font = styles.font || `${styles.fontWeight} ${styles.fontSize} ${styles.fontFamily}`;
    context.font = font;

    const metrics = context.measureText('Hgj');
    const ascent = metrics.actualBoundingBoxAscent || fontSize * 0.72;
    const descent = metrics.actualBoundingBoxDescent || fontSize * 0.24;
    const baseline = (height - ascent - descent) / 2 + ascent;
    const cursorHeight = Math.max(1, fontSize * 0.9);

    return {
      context,
      width,
      height,
      font,
      color: styles.color,
      baseline,
      cursorY: Math.max(0, (height - cursorHeight) / 2),
      cursorHeight,
    };
  };

  const drawWord = (state: CanvasState, word: string, showCursor = true): void => {
    const { context, width, height, font, color, baseline, cursorY, cursorHeight } = state;
    const cursorWidth = 2;
    const cursorGap = 3;

    context.clearRect(0, 0, width, height);
    context.font = font;
    context.fillStyle = color;
    context.textBaseline = 'alphabetic';
    context.fillText(word, 0, baseline);

    if (!showCursor) return;

    const cursorX = Math.min(width - cursorWidth, context.measureText(word).width + cursorGap);
    context.fillRect(cursorX, cursorY, cursorWidth, cursorHeight);
  };

  const drawDecodeFrame = (state: CanvasState, text: string, progress: number): void => {
    if (progress >= 1) {
      drawWord(state, text, true);
      return;
    }

    const visibleCount = Math.max(1, Math.ceil(progress * text.length));
    const settledCount = Math.floor(Math.max(0, progress - 0.18) / 0.82 * text.length);
    let frameText = '';

    for (let index = 0; index < visibleCount; index += 1) {
      frameText += index < settledCount ? text[index] : randomScrambleChar();
    }

    drawWord(state, frameText, true);
  };

  const cancelFrame = (root: TypewriterRoot): void => {
    if (root._typewriterFrame !== undefined) {
      window.cancelAnimationFrame(root._typewriterFrame);
      root._typewriterFrame = undefined;
    }
  };

  const clearCursorTimer = (root: TypewriterRoot): void => {
    window.clearInterval(root._typewriterCursorTimer);
    root._typewriterCursorTimer = undefined;
  };

  const startCursorBlink = (
    root: TypewriterRoot,
    state: CanvasState,
    word: string
  ): void => {
    let showCursor = true;
    clearCursorTimer(root);
    drawWord(state, word, showCursor);

    root._typewriterCursorTimer = window.setInterval(() => {
      showCursor = !showCursor;
      drawWord(state, word, showCursor);
    }, 575);
  };

  const animateText = (
    root: TypewriterRoot,
    visual: HTMLElement,
    canvas: HTMLCanvasElement,
    text: string,
    speed: number,
    onDone?: () => void
  ): void => {
    const state = setupCanvas(visual, canvas);
    if (!state) return;

    cancelFrame(root);
    clearCursorTimer(root);
    root._typewriterCurrentText = text;
    visual.setAttribute('aria-label', text);
    visual.classList.remove('is-typed');
    visual.classList.add('is-enhanced', 'is-typing');

    const duration = durationFor(text, speed);
    const startedAt = performance.now();
    drawDecodeFrame(state, text, 0.08);

    const drawNext = (now: number): void => {
      const progress = Math.min(1, (now - startedAt) / duration);
      drawDecodeFrame(state, text, progress);

      if (progress < 1) {
        root._typewriterFrame = window.requestAnimationFrame(drawNext);
        return;
      }

      root._typewriterFrame = undefined;
      visual.classList.remove('is-typing');
      visual.classList.add('is-typed');
      startCursorBlink(root, state, text);
      onDone?.();
    };

    root._typewriterFrame = window.requestAnimationFrame(drawNext);
  };

  const initOne = (root: TypewriterRoot): void => {
    if (root._typewriterReady) return;
    root._typewriterReady = true;

    const visual = root.querySelector<HTMLElement>('[data-typewriter-visual]');
    const canvas = root.querySelector<HTMLCanvasElement>('[data-typewriter-canvas]');
    const texts = parseTexts(root);
    const speed = Number.parseInt(root.dataset.speed || '80', 10);
    const delay = Number.parseInt(root.dataset.delay || '0', 10);
    const pauseDuration = Number.parseInt(root.dataset.pause || '2000', 10);

    if (!visual || !canvas || texts.length === 0 || prefersReducedMotion()) {
      return;
    }

    const abort = new AbortController();
    let index = 0;
    root._typewriterAbort = abort;

    const redrawSettledText = (): void => {
      if (!root._typewriterCurrentText || !visual.classList.contains('is-typed')) return;

      const state = setupCanvas(visual, canvas);
      if (state) {
        startCursorBlink(root, state, root._typewriterCurrentText);
      }
    };

    if ('ResizeObserver' in window) {
      root._typewriterResizeObserver = new ResizeObserver(redrawSettledText);
      root._typewriterResizeObserver.observe(visual);
    }

    document.fonts?.ready.then(redrawSettledText).catch(() => {});

    const startFirstRun = (): void => {
      if (root._typewriterStarted) return;
      root._typewriterStarted = true;
      window.clearTimeout(root._typewriterStartTimer);
      animateText(root, visual, canvas, texts[index], speed, () => {
        if (texts.length > 1) {
          root._typewriterLoopTimer = window.setTimeout(runLoop, pauseDuration);
        }
      });
    };

    const runLoop = (): void => {
      index = (index + 1) % texts.length;
      const nextText = texts[index];

      requestAnimationFrame(() => {
        animateText(root, visual, canvas, nextText, speed, () => {
          root._typewriterLoopTimer = window.setTimeout(runLoop, pauseDuration);
        });
      });
    };

    window.addEventListener(HERO_NAME_READY_EVENT, startFirstRun, {
      once: true,
      signal: abort.signal,
    });
    root._typewriterStartTimer = window.setTimeout(startFirstRun, delay + FALLBACK_START_MS);
  };

  const initAll = (): void => {
    document.querySelectorAll<TypewriterRoot>('[data-typewriter-root]').forEach(initOne);
  };

  const cleanupAll = (): void => {
    document.querySelectorAll<TypewriterRoot>('[data-typewriter-root]').forEach((root) => {
      window.clearTimeout(root._typewriterStartTimer);
      window.clearTimeout(root._typewriterLoopTimer);
      cancelFrame(root);
      clearCursorTimer(root);
      root._typewriterAbort?.abort();
      root._typewriterResizeObserver?.disconnect();
      root._typewriterResizeObserver = undefined;
      root._typewriterCurrentText = undefined;
      root._typewriterReady = false;
      root._typewriterStarted = false;
    });
  };

  document.addEventListener('astro:page-load', initAll);
  document.addEventListener('astro:before-swap', cleanupAll);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll, { once: true });
  } else {
    initAll();
  }
</script>
