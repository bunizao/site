---
interface Props {
  texts: string[];
  /** Milliseconds per keystroke. Every character lands on this exact beat. */
  keystrokeMs?: number;
  delay?: number;
  pauseDuration?: number;
}

const { texts, keystrokeMs = 90, delay = 0, pauseDuration = 2000 } = Astro.props;
const initialText = texts[0] ?? '';
const longestText = texts.reduce((a, b) => a.length > b.length ? a : b, '');
const placeholderText = `${longestText}_`;
---

<span
  class="typewriter-wrapper"
  data-typewriter-root
  data-texts={JSON.stringify(texts)}
  data-keystroke={keystrokeMs}
  data-delay={delay}
  data-pause={pauseDuration}
>
  <!-- Hidden placeholder keeps the canvas stage stable. -->
  <span class="typewriter-placeholder" aria-hidden="true">{placeholderText}</span>
  <span class="typewriter" data-typewriter-visual aria-label={initialText}><span class="typewriter-text" data-typewriter-text>{initialText}</span><canvas class="typewriter-canvas" data-typewriter-canvas aria-hidden="true"></canvas><span class="typewriter-caret" data-typewriter-caret aria-hidden="true">_</span></span>
</span>

<style>
  .typewriter-wrapper {
    display: inline-grid;
    grid-template-columns: max-content;
    align-items: baseline;
    vertical-align: baseline;
  }

  .typewriter-wrapper > * {
    grid-area: 1 / 1;
  }

  .typewriter-placeholder {
    visibility: hidden;
    white-space: pre;
  }

  .typewriter {
    position: relative;
    display: block;
    width: 100%;
    white-space: pre;
    line-height: inherit;
  }

  .typewriter-canvas {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
  }

  .typewriter-text {
    display: block;
    width: 100%;
    white-space: pre;
  }

  /* The caret runs on its own CSS clock so it never syncs to the keystrokes,
     and so nothing has to repaint the canvas while the name sits idle. */
  .typewriter-caret {
    position: absolute;
    top: 0;
    left: 0;
    display: none;
    white-space: pre;
    will-change: opacity, transform;
  }

  .typewriter.is-enhanced .typewriter-text {
    color: transparent;
  }

  .typewriter.is-enhanced .typewriter-canvas {
    opacity: 1;
  }

  .typewriter.is-enhanced .typewriter-caret {
    display: block;
    animation: typewriter-caret 1s ease infinite;
  }

  /* A soft pulse rather than a hard on/off — a binary blink reads as a widget,
     this reads as hardware idling. */
  @keyframes typewriter-caret {
    0%, 100% { opacity: 0.1; }
    50% { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .typewriter.is-enhanced .typewriter-text {
      color: currentColor;
    }

    .typewriter.is-enhanced .typewriter-canvas,
    .typewriter.is-enhanced .typewriter-caret {
      display: none;
      opacity: 0;
    }
  }
</style>

<script>
  type TypewriterRoot = HTMLElement & {
    _typewriterReady?: boolean;
    _typewriterStarted?: boolean;
    _typewriterStartTimer?: number;
    _typewriterLoopTimer?: number;
    _typewriterFrame?: number;
    _typewriterAbort?: AbortController;
    _typewriterCurrentText?: string;
    _typewriterResizeObserver?: ResizeObserver;
  };

  interface CanvasState {
    context: CanvasRenderingContext2D;
    width: number;
    height: number;
    font: string;
    color: string;
    baseline: number;
  }

  const HERO_NAME_READY_EVENT = 'home:hero-name-ready';
  const FALLBACK_START_MS = 1100;
  const DEFAULT_KEYSTROKE_MS = 90;
  const MIN_KEYSTROKE_MS = 40;
  const MAX_KEYSTROKE_MS = 400;
  // Backspacing is brisker than typing, the way it is on a real keyboard:
  // one deliberate press per character going in, a held key coming out.
  const BACKSPACE_RATIO = 0.45;
  // A struck slot shows a quiet underscore for one beat before it inks. This is
  // soulwire's cursor band -- the calm stretch his decode runs between the show
  // and mash fronts -- rather than a scramble: one stable glyph that sits on the
  // baseline, carries little ink and can never be misread as a letter.
  const LANDING_CHAR = '_';
  const LANDING_ALPHA = 0.38;
  const LANDING_BEATS = 1;

  const prefersReducedMotion = (): boolean =>
    window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false;

  const parseTexts = (root: TypewriterRoot): string[] => {
    try {
      const parsed = JSON.parse(root.dataset.texts || '[]');
      return Array.isArray(parsed) ? parsed.filter((text): text is string => typeof text === 'string') : [];
    } catch {
      return [];
    }
  };

  const readNumber = (raw: string | undefined, fallback: number): number => {
    const value = Number.parseInt(raw || '', 10);
    return Number.isFinite(value) ? value : fallback;
  };

  const setupCanvas = (visual: HTMLElement, canvas: HTMLCanvasElement): CanvasState | null => {
    const context = canvas.getContext('2d');
    if (!context) return null;

    const rect = visual.getBoundingClientRect();
    const styles = window.getComputedStyle(visual);
    const dpr = Math.max(1, window.devicePixelRatio || 1);
    const fontSize = Number.parseFloat(styles.fontSize) || 36;
    const width = Math.max(1, rect.width);
    const height = Math.max(1, rect.height || fontSize * 1.2);
    const bitmapWidth = Math.max(1, Math.round(width * dpr));
    const bitmapHeight = Math.max(1, Math.round(height * dpr));

    if (canvas.width !== bitmapWidth) {
      canvas.width = bitmapWidth;
    }

    if (canvas.height !== bitmapHeight) {
      canvas.height = bitmapHeight;
    }

    canvas.style.width = '100%';
    canvas.style.height = '100%';

    context.setTransform(bitmapWidth / width, 0, 0, bitmapHeight / height, 0, 0);
    const font = styles.font || `${styles.fontWeight} ${styles.fontSize} ${styles.fontFamily}`;
    context.font = font;

    const metrics = context.measureText('Hgj');
    const ascent = metrics.actualBoundingBoxAscent || fontSize * 0.72;
    const descent = metrics.actualBoundingBoxDescent || fontSize * 0.24;
    const baseline = (height - ascent - descent) / 2 + ascent;

    return {
      context,
      width,
      height,
      font,
      color: styles.color,
      baseline,
    };
  };

  interface Glyph {
    char: string;
    alpha: number;
    /** Layout width always comes from the final character, so nothing reflows. */
    advance: string;
  }

  /** Paints the glyphs and returns where the caret should sit. */
  const drawGlyphs = (state: CanvasState, glyphs: Glyph[]): number => {
    const { context, width, height, font, color, baseline } = state;

    context.clearRect(0, 0, width, height);
    context.font = font;
    context.fillStyle = color;
    context.textBaseline = 'alphabetic';

    let x = 0;
    for (const glyph of glyphs) {
      const advance = context.measureText(glyph.advance).width;
      context.globalAlpha = glyph.alpha;
      context.fillText(glyph.char, x, baseline);
      x += advance;
    }

    context.globalAlpha = 1;
    return x;
  };

  const drawText = (state: CanvasState, text: string): number =>
    drawGlyphs(state, Array.from(text).map((char) => ({ char, alpha: 1, advance: char })));

  const placeCaret = (caret: HTMLElement, x: number): void => {
    caret.style.transform = `translateX(${x}px)`;
  };

  const cancelFrame = (root: TypewriterRoot): void => {
    if (root._typewriterFrame !== undefined) {
      window.cancelAnimationFrame(root._typewriterFrame);
      root._typewriterFrame = undefined;
    }
  };

  const initOne = (root: TypewriterRoot): void => {
    if (root._typewriterReady) return;
    root._typewriterReady = true;

    const visual = root.querySelector<HTMLElement>('[data-typewriter-visual]');
    const canvas = root.querySelector<HTMLCanvasElement>('[data-typewriter-canvas]');
    const caret = root.querySelector<HTMLElement>('[data-typewriter-caret]');
    const texts = parseTexts(root);
    const keystrokeMs = Math.max(
      MIN_KEYSTROKE_MS,
      Math.min(MAX_KEYSTROKE_MS, readNumber(root.dataset.keystroke, DEFAULT_KEYSTROKE_MS))
    );
    const delay = readNumber(root.dataset.delay, 0);
    const pauseDuration = readNumber(root.dataset.pause, 2000);

    if (!visual || !canvas || !caret || texts.length === 0 || prefersReducedMotion()) {
      return;
    }

    const abort = new AbortController();
    let index = 0;
    root._typewriterAbort = abort;

    const redrawSettledText = (): void => {
      const text = root._typewriterCurrentText;
      if (!text || root._typewriterFrame !== undefined) return;

      const state = setupCanvas(visual, canvas);
      if (state) {
        placeCaret(caret, drawText(state, text));
      }
    };

    if ('ResizeObserver' in window) {
      root._typewriterResizeObserver = new ResizeObserver(redrawSettledText);
      root._typewriterResizeObserver.observe(visual);
    }

    document.fonts?.ready.then(redrawSettledText).catch(() => {});

    const backspaceMs = Math.max(24, Math.round(keystrokeMs * BACKSPACE_RATIO));

    /** Walks the visible character count from `from` to `to`, one per beat. */
    const animate = (
      text: string,
      from: number,
      to: number,
      stepMs: number,
      onDone: () => void
    ): void => {
      const state = setupCanvas(visual, canvas);
      if (!state) return;

      cancelFrame(root);

      const chars = Array.from(text);
      const direction = to > from ? 1 : -1;
      const steps = Math.abs(to - from);
      // Only ink on the way in. Erasing a character through a landing glyph
      // would read as a typo being fixed, not as the name being taken back.
      const landingMs = direction > 0 ? stepMs * LANDING_BEATS : 0;
      const startedAt = performance.now();

      const drawNext = (now: number): void => {
        // The beat is absolute rather than a share of the word, so "Tutu"
        // types at exactly the pace of "Collapsar".
        const elapsed = now - startedAt;
        const step = Math.min(steps, Math.floor(elapsed / stepMs));
        const next = from + direction * step;

        placeCaret(caret, drawGlyphs(state, chars.slice(0, next).map((char, index) => {
          const struckAt = (index - from + 1) * stepMs;
          return elapsed - struckAt < landingMs
            ? { char: LANDING_CHAR, alpha: LANDING_ALPHA, advance: char }
            : { char, alpha: 1, advance: char };
        })));

        // The last character still owes its landing beat once the walk is done.
        if (step < steps || elapsed < steps * stepMs + landingMs) {
          root._typewriterFrame = window.requestAnimationFrame(drawNext);
          return;
        }

        root._typewriterFrame = undefined;
        onDone();
      };

      drawNext(startedAt);
    };

    const playName = (): void => {
      const text = texts[index];
      const length = Array.from(text).length;

      root._typewriterCurrentText = text;
      visual.setAttribute('aria-label', text);
      visual.classList.add('is-enhanced');

      animate(text, 0, length, keystrokeMs, () => {
        if (texts.length < 2) return;

        // Let the finished name sit before the carriage takes it back.
        root._typewriterLoopTimer = window.setTimeout(() => {
          animate(text, length, 0, backspaceMs, () => {
            root._typewriterCurrentText = '';
            index = (index + 1) % texts.length;
            // One empty beat, so the next name does not start on the same
            // frame the last one vanished.
            root._typewriterLoopTimer = window.setTimeout(playName, keystrokeMs);
          });
        }, pauseDuration);
      });
    };

    const startFirstRun = (): void => {
      if (root._typewriterStarted) return;
      root._typewriterStarted = true;
      window.clearTimeout(root._typewriterStartTimer);
      playName();
    };

    window.addEventListener(HERO_NAME_READY_EVENT, startFirstRun, {
      once: true,
      signal: abort.signal,
    });
    root._typewriterStartTimer = window.setTimeout(startFirstRun, delay + FALLBACK_START_MS);
  };

  const initAll = (): void => {
    document.querySelectorAll<TypewriterRoot>('[data-typewriter-root]').forEach(initOne);
  };

  const cleanupAll = (): void => {
    document.querySelectorAll<TypewriterRoot>('[data-typewriter-root]').forEach((root) => {
      window.clearTimeout(root._typewriterStartTimer);
      window.clearTimeout(root._typewriterLoopTimer);
      cancelFrame(root);
      root._typewriterAbort?.abort();
      root._typewriterResizeObserver?.disconnect();
      root._typewriterResizeObserver = undefined;
      root._typewriterCurrentText = undefined;
      root._typewriterReady = false;
      root._typewriterStarted = false;
    });
  };

  document.addEventListener('astro:page-load', initAll);
  document.addEventListener('astro:before-swap', cleanupAll);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll, { once: true });
  } else {
    initAll();
  }
</script>
