---
// Soulwire-style decode reveal, faithful to the live site's algorithm.
// Each visual line resolves left-to-right through a three-zone wave
// (resolved | scramble | cursor edge), lines staggered top-to-bottom.
//
// Body is monospace (JetBrains Mono): every glyph is 1ch, so we reserve each
// slot as a space up front and resolve characters in place. No reflow, no line
// measurement, no flash of full text before the animation starts.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['decode-text', className]} data-decode-root>
  <slot />
</div>

<style>
  /* Hide until JS has blanked the slot, so the full text never paints first. */
  :global(html.js) .decode-text:not(.dt-prepared) {
    visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .decode-text {
      visibility: visible;
    }
  }

  .decode-text :global(.dt-c) {
    white-space: pre;
  }

  .decode-text :global(.dt-c[data-state='idle']) {
    color: transparent;
  }

  .decode-text :global(.dt-c[data-state='cursor']) {
    color: color-mix(in oklab, currentColor 32%, transparent);
  }

  .decode-text :global(.dt-c[data-state='scramble']) {
    color: color-mix(in oklab, currentColor 55%, transparent);
  }
</style>

<script>
  type DecodeRoot = HTMLElement & {
    _decodeReady?: boolean;
    _decodeStarted?: boolean;
    _decodeTimer?: number;
    _decodeKill?: () => void;
    _decodeOriginal?: string;
  };

  type Cell = { el: HTMLElement; final: string; temp: string };

  const BIO_READY_EVENT = 'home:hero-bio-ready';
  const FALLBACK_START_MS = 1500;

  // Soulwire's homepage parameters for the long paragraph.
  const SCRAMBLE = '_-/\\|<>'.split('');
  const CURSOR = '-';
  const SHOW_POWER = 0.8;
  const MASH_POWER = 2;
  const DONE_POWER = 6;
  const MUTATION = 0.15;
  const LINE_DURATION_PER_CHAR = 0.0215;
  const LINE_DELAY_FACTOR = 0.172;

  const prefersReducedMotion = (): boolean =>
    window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false;

  const randomFrom = (pool: string[]): string =>
    pool[Math.floor(Math.random() * pool.length)] ?? '_';

  // Walk the slotted markup, wrapping every visible character in a span while
  // preserving spaces, <br> line breaks, and inline color spans. Returns the
  // characters grouped by visual line, in document order (no shuffle).
  const tokenize = (root: HTMLElement): Cell[][] => {
    const lines: Cell[][] = [[]];

    const walk = (parent: Node): void => {
      for (const node of Array.from(parent.childNodes)) {
        if (node.nodeType === Node.TEXT_NODE) {
          const text = node.textContent ?? '';
          const fragment = document.createDocumentFragment();
          for (const ch of text) {
            if (/\s/.test(ch)) {
              fragment.appendChild(document.createTextNode(' '));
              continue;
            }
            const span = document.createElement('span');
            span.className = 'dt-c';
            span.dataset.state = 'idle';
            span.textContent = ' ';
            fragment.appendChild(span);
            lines[lines.length - 1].push({ el: span, final: ch, temp: '' });
          }
          parent.replaceChild(fragment, node);
        } else if (node.nodeType === Node.ELEMENT_NODE) {
          const el = node as HTMLElement;
          if (el.tagName === 'BR') {
            lines.push([]);
          } else {
            walk(el);
          }
        }
      }
    };

    walk(root);
    return lines.filter((line) => line.length > 0);
  };

  const setState = (cell: Cell, state: string, text: string): void => {
    if (cell.el.dataset.state !== state) cell.el.dataset.state = state;
    if (cell.el.textContent !== text) cell.el.textContent = text;
  };

  // One frame of a line: [0..done] real, (done..mash] scramble, (mash..show)
  // cursor, [show..] blank. done <= mash <= show because the powers are ordered.
  const renderLine = (cells: Cell[], progress: number): void => {
    const len = cells.length;
    const show = Math.floor(Math.pow(progress, SHOW_POWER) * len);
    const mash = Math.floor(Math.pow(progress, MASH_POWER) * len);
    const done = Math.floor(Math.pow(progress, DONE_POWER) * len);

    for (let l = 0; l < len; l += 1) {
      const cell = cells[l];
      if (l >= show) {
        setState(cell, 'idle', ' ');
      } else if (l <= done) {
        setState(cell, 'done', cell.final);
      } else if (l <= mash) {
        if (!cell.temp || Math.random() < MUTATION) cell.temp = randomFrom(SCRAMBLE);
        setState(cell, 'scramble', cell.temp);
      } else {
        setState(cell, 'cursor', CURSOR);
      }
    }
  };

  const play = async (root: DecodeRoot, lines: Cell[][]): Promise<void> => {
    if (root._decodeStarted) return;
    root._decodeStarted = true;

    const original = root._decodeOriginal ?? root.innerHTML;
    root.setAttribute('aria-hidden', 'true');

    const { default: gsap } = await import('gsap');

    const restore = (): void => {
      root.innerHTML = original;
      root.removeAttribute('aria-hidden');
    };

    const timeline = gsap.timeline({ onComplete: restore });

    let cumulative = 0;
    for (const cells of lines) {
      const duration = Math.min(1.6, Math.max(0.5, LINE_DURATION_PER_CHAR * cells.length));
      const state = { p: 0 };
      timeline.to(
        state,
        {
          p: 1,
          duration,
          ease: 'power4.inOut',
          onUpdate() {
            renderLine(cells, state.p);
          },
        },
        LINE_DELAY_FACTOR * cumulative
      );
      cumulative += duration;
    }

    root._decodeKill = () => {
      timeline.kill();
      restore();
    };
  };

  const initOne = (root: DecodeRoot): void => {
    if (root._decodeReady) return;
    root._decodeReady = true;
    root._decodeOriginal = root.innerHTML;

    const reveal = () => root.classList.add('dt-prepared');

    if (prefersReducedMotion()) {
      reveal();
      return;
    }

    let lines: Cell[][];
    try {
      lines = tokenize(root);
      if (lines.length === 0) {
        reveal();
        return;
      }
    } catch {
      // On any failure, fall back to the original semantic text.
      root.innerHTML = root._decodeOriginal;
      reveal();
      return;
    }

    reveal(); // visible, but every slot is blank — no full-text flash

    let started = false;
    const start = (): void => {
      if (started) return;
      started = true;
      window.clearTimeout(root._decodeTimer);
      void play(root, lines);
    };

    window.addEventListener(BIO_READY_EVENT, start, { once: true });
    root._decodeTimer = window.setTimeout(start, FALLBACK_START_MS);
  };

  const initAll = (): void => {
    document.querySelectorAll<DecodeRoot>('[data-decode-root]').forEach(initOne);
  };

  const cleanupAll = (): void => {
    document.querySelectorAll<DecodeRoot>('[data-decode-root]').forEach((root) => {
      window.clearTimeout(root._decodeTimer);
      root._decodeKill?.();
      root._decodeReady = false;
      root._decodeStarted = false;
    });
  };

  document.addEventListener('astro:page-load', initAll);
  document.addEventListener('astro:before-swap', cleanupAll);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll, { once: true });
  } else {
    initAll();
  }
</script>
