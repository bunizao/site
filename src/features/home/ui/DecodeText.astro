---
// Thin site wrapper around @bunizao/decode-text (packages/decode-text).
// Owns only site concerns: the no-FOUC visibility gate, the hero handoff
// event, and Astro page lifecycle. The reveal itself lives in the package.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['decode-text', className]} data-decode-root>
  <slot />
</div>

<style>
  /* Hide until JS has measured + blanked the slots, so full text never paints. */
  :global(html.js) .decode-text:not(.dt-prepared) {
    visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .decode-text {
      visibility: visible;
    }
  }
</style>

<script>
  import { prepareDecode, type DecodeController } from '@bunizao/decode-text';

  type DecodeRoot = HTMLElement & {
    _decodeReady?: boolean;
    _decodeTimer?: number;
    _decodeController?: DecodeController;
  };

  const BIO_READY_EVENT = 'home:hero-bio-ready';
  const FALLBACK_START_MS = 1500;

  const initOne = async (root: DecodeRoot): Promise<void> => {
    if (root._decodeReady) return;
    root._decodeReady = true;

    try {
      const controller = await prepareDecode(root);
      root._decodeController = controller;
      // Visible, but every slot is blank — no full-text flash. Under reduced
      // motion the DOM is untouched and start() is a no-op, so this simply
      // shows the text.
      root.classList.add('dt-prepared');

      const start = (): void => {
        window.clearTimeout(root._decodeTimer);
        controller.start();
      };
      window.addEventListener(BIO_READY_EVENT, start, { once: true });
      root._decodeTimer = window.setTimeout(start, FALLBACK_START_MS);
    } catch {
      root.classList.add('dt-prepared');
    }
  };

  const initAll = (): void => {
    document.querySelectorAll<DecodeRoot>('[data-decode-root]').forEach((root) => {
      void initOne(root);
    });
  };

  const cleanupAll = (): void => {
    document.querySelectorAll<DecodeRoot>('[data-decode-root]').forEach((root) => {
      window.clearTimeout(root._decodeTimer);
      root._decodeController?.cancel();
      root._decodeController = undefined;
      root._decodeReady = false;
    });
  };

  document.addEventListener('astro:page-load', initAll);
  document.addEventListener('astro:before-swap', cleanupAll);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll, { once: true });
  } else {
    initAll();
  }
</script>
