---
// Soulwire-style line-by-line decode reveal.
// Wraps slotted prose and resolves it from scramble noise after fonts are ready.
// Relies on the body monospace (JetBrains Mono): every glyph is 1ch, so swapping
// characters per frame never reflows. No width measurement needed.
interface Props {
  delay?: number; // ms after the hero name is ready before decoding starts
  class?: string;
}

const { delay = 350, class: className } = Astro.props;
---

<div class:list={['decode-text', className]} data-decode-root data-delay={delay}>
  <slot />
</div>

<style>
  .decode-text :global(.dt-c) {
    display: inline;
    white-space: pre;
  }

  /* While decoding, dim the trailing scramble characters relative to settled text. */
  .decode-text :global(.dt-c[data-state='scramble']) {
    color: color-mix(in oklab, currentColor 60%, transparent);
  }

  .decode-text :global(.dt-c[data-state='cursor']) {
    color: color-mix(in oklab, currentColor 45%, transparent);
  }
</style>

<script>
  type DecodeRoot = HTMLElement & {
    _decodeReady?: boolean;
    _decodeStarted?: boolean;
    _decodeTimer?: number;
    _decodeKill?: () => void;
    _decodeOriginal?: string;
  };

  type Char = {
    el: HTMLElement;
    final: string;
    startAt: number;
    mashAt: number;
    settleAt: number;
    cur: string;
    lastMut: number;
  };

  const HERO_NAME_READY_EVENT = 'home:hero-name-ready';
  const FALLBACK_START_MS = 1200;
  const SCRAMBLE_POOL = '_-/\\|<>=+*[]{}:.'.split('');
  const MUTATION_MS = 46;

  const prefersReducedMotion = (): boolean =>
    window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false;

  const randomFrom = (pool: string[]): string =>
    pool[Math.floor(Math.random() * pool.length)] ?? '_';

  const shuffle = <T,>(items: T[]): T[] => {
    const copy = items.slice();
    for (let i = copy.length - 1; i > 0; i -= 1) {
      const j = Math.floor(Math.random() * (i + 1));
      [copy[i], copy[j]] = [copy[j], copy[i]];
    }
    return copy;
  };

  // Walk the slotted markup, wrapping every visible character in a span while
  // preserving spaces, <br> line breaks, and inline color spans. Returns the
  // characters grouped by visual line (one group per <br>-separated run).
  const tokenize = (root: HTMLElement): Char[][] => {
    const lines: HTMLElement[][] = [[]];

    const walk = (parent: Node): void => {
      const nodes = Array.from(parent.childNodes);
      for (const node of nodes) {
        if (node.nodeType === Node.TEXT_NODE) {
          const text = node.textContent ?? '';
          const fragment = document.createDocumentFragment();
          for (const ch of text) {
            if (ch === ' ' || ch === '\n' || ch === '\t') {
              fragment.appendChild(document.createTextNode(ch === '\n' ? ' ' : ch));
              continue;
            }
            const span = document.createElement('span');
            span.className = 'dt-c';
            span.dataset.final = ch;
            span.textContent = ' ';
            fragment.appendChild(span);
            lines[lines.length - 1].push(span);
          }
          parent.replaceChild(fragment, node);
        } else if (node.nodeType === Node.ELEMENT_NODE) {
          const el = node as HTMLElement;
          if (el.tagName === 'BR') {
            lines.push([]);
          } else {
            walk(el);
          }
        }
      }
    };

    walk(root);

    return lines
      .filter((line) => line.length > 0)
      .map((line) => {
        const order = shuffle(line.map((_, index) => index));
        const count = line.length;
        return line.map((el, index): Char => {
          const rank = order[index] / Math.max(1, count - 1);
          const startAt = rank * 0.58;
          const mashAt = startAt + 0.04;
          const settleAt = Math.min(0.99, startAt + 0.34);
          return {
            el,
            final: el.dataset.final ?? '',
            startAt,
            mashAt,
            settleAt,
            cur: randomFrom(SCRAMBLE_POOL),
            lastMut: 0,
          };
        });
      });
  };

  const renderLine = (line: Char[], progress: number, now: number): void => {
    for (const ch of line) {
      if (progress < ch.startAt) {
        if (ch.el.dataset.state !== 'blank') {
          ch.el.textContent = ' ';
          ch.el.dataset.state = 'blank';
        }
        continue;
      }

      if (progress >= ch.settleAt) {
        if (ch.el.dataset.state !== 'done') {
          ch.el.textContent = ch.final;
          ch.el.dataset.state = 'done';
        }
        continue;
      }

      if (progress < ch.mashAt) {
        ch.el.textContent = '_';
        ch.el.dataset.state = 'cursor';
        continue;
      }

      if (now - ch.lastMut > MUTATION_MS) {
        ch.cur = randomFrom(SCRAMBLE_POOL);
        ch.lastMut = now;
      }
      ch.el.textContent = ch.cur;
      ch.el.dataset.state = 'scramble';
    }
  };

  const run = async (root: DecodeRoot): Promise<void> => {
    if (root._decodeStarted) return;
    root._decodeStarted = true;

    await document.fonts?.ready.catch(() => {});

    const lines = tokenize(root);
    if (lines.length === 0) return;

    const original = root._decodeOriginal ?? root.innerHTML;
    root.setAttribute('aria-hidden', 'true');

    const { default: gsap } = await import('gsap');

    const states = lines.map(() => ({ p: 0 }));
    const timeline = gsap.timeline({
      onComplete: () => {
        // Restore clean semantic text: tidy DOM, correct copy/paste, accessible.
        root.innerHTML = original;
        root.removeAttribute('aria-hidden');
      },
    });

    let cursor = 0;
    lines.forEach((line, index) => {
      const duration = Math.max(0.45, Math.min(0.95, line.length * 0.02));
      timeline.to(
        states[index],
        {
          p: 1,
          duration,
          ease: 'none',
          onUpdate() {
            renderLine(line, states[index].p, performance.now());
          },
        },
        cursor
      );
      // Overlap the next line so the paragraph resolves as a cascade, not a queue.
      cursor += duration * 0.55;
    });

    root._decodeKill = () => {
      timeline.kill();
      root.innerHTML = original;
      root.removeAttribute('aria-hidden');
    };
  };

  const initOne = (root: DecodeRoot): void => {
    if (root._decodeReady) return;
    root._decodeReady = true;
    root._decodeOriginal = root.innerHTML;

    if (prefersReducedMotion()) return;

    const delay = Number.parseInt(root.dataset.delay || '350', 10);
    let started = false;

    const start = (): void => {
      if (started) return;
      started = true;
      window.clearTimeout(root._decodeTimer);
      window.setTimeout(() => void run(root), delay);
    };

    window.addEventListener(HERO_NAME_READY_EVENT, start, { once: true });
    root._decodeTimer = window.setTimeout(start, FALLBACK_START_MS + delay);
  };

  const initAll = (): void => {
    document.querySelectorAll<DecodeRoot>('[data-decode-root]').forEach(initOne);
  };

  const cleanupAll = (): void => {
    document.querySelectorAll<DecodeRoot>('[data-decode-root]').forEach((root) => {
      window.clearTimeout(root._decodeTimer);
      root._decodeKill?.();
      root._decodeReady = false;
      root._decodeStarted = false;
    });
  };

  document.addEventListener('astro:page-load', initAll);
  document.addEventListener('astro:before-swap', cleanupAll);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll, { once: true });
  } else {
    initAll();
  }
</script>
