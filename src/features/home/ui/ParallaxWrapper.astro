---
// Scroll container for the homepage. It used to drive a GSAP scrub parallax
// over every section; that was removed. The drift was ~12-22px across the whole
// page (scrollY * 0.5 * 0.02) — below the threshold anyone notices — while
// costing a promoted compositor layer per section and a second writer competing
// with each section's reveal for the same `y`. With `content-visibility` also
// resizing the document mid-scroll, the cached ScrollTrigger positions went
// stale and the browser clamped scrollY, which is what made the page feel stuck
// and left sections blank in Safari.
//
// Reveal motion now lives in src/lib/home-reveal.ts + src/styles/home-reveal.css.
---

<div id="parallax-container">
  <slot />
</div>

<style>
  :global(html) {
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
  }

  :global(body) {
    overscroll-behavior: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }
</style>
