---
// Scroll container for the homepage. Reveal motion lives in home-reveal.css;
// the small independent drift below uses the CSS translate longhand so it can
// compose with that reveal transform without competing for the same property.
---

<div id="parallax-container">
  <slot />
</div>

<style>
  :global(html) {
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
  }

  :global(body) {
    overscroll-behavior: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  let cleanupParallax: (() => void) | undefined;

  const initParallax = () => {
    cleanupParallax?.();

    const sections = Array.from(
      document.querySelectorAll<HTMLElement>('#parallax-container section:not(#projects-section)'),
    );
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    let frame = 0;

    const clearTranslations = () => {
      sections.forEach((section) => section.style.removeProperty('translate'));
    };

    const render = () => {
      frame = 0;
      const scrollY = window.scrollY;
      sections.forEach((section, index) => {
        const speed = 0.5 + (index % 3) * 0.2;
        section.style.translate = `0 ${scrollY * speed * 0.02}px`;
      });
    };

    const schedule = () => {
      if (frame !== 0) return;
      frame = window.requestAnimationFrame(render);
    };

    const handleMotionChange = () => initParallax();
    motionQuery.addEventListener('change', handleMotionChange);

    if (!motionQuery.matches && sections.length > 0) {
      window.addEventListener('scroll', schedule, { passive: true });
      render();
    } else {
      clearTranslations();
    }

    cleanupParallax = () => {
      window.removeEventListener('scroll', schedule);
      motionQuery.removeEventListener('change', handleMotionChange);
      if (frame !== 0) window.cancelAnimationFrame(frame);
      clearTranslations();
    };
  };

  const stopParallax = () => cleanupParallax?.();

  initParallax();
  document.addEventListener('astro:page-load', initParallax);
  document.addEventListener('astro:before-swap', stopParallax);
  window.addEventListener('pageshow', initParallax);
</script>
