---
import { footer, copyrightMark } from '@/data/site';

const { links, statusUrl } = footer;
const mark = copyrightMark(new Date().getFullYear());
---

<footer class="footer">
  <nav class="footer-nav" aria-label="Footer">
    {links.map((link, i) => (
      <>
        {i > 0 && <span class="footer-sep" aria-hidden="true">·</span>}
        <a
          href={link.url}
          class="footer-link"
          {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {link.label}
        </a>
      </>
    ))}
  </nav>

  <p class="footer-meta">
    <a
      href={statusUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="footer-status"
      data-footer-status="unknown"
    >
      <span class="footer-status-dot" aria-hidden="true"></span>
      <span data-footer-status-label>Checking</span>
    </a>
    <span class="footer-sep" aria-hidden="true" data-footer-region-sep hidden>·</span>
    <span class="footer-region" data-footer-region data-edge-state="idle" hidden>
      <button
        type="button"
        class="footer-region-trigger"
        data-footer-region-trigger
        aria-expanded="false"
        aria-describedby="footer-edge-pop"
      >
        <span class="footer-region-label">Edge:</span>
        <span class="footer-region-code" data-footer-region-code>—</span>
      </button>
      <span class="footer-edge-pop" id="footer-edge-pop" role="tooltip" data-footer-edge-pop>
        <span class="footer-edge-arrow" aria-hidden="true"></span>
        <span class="footer-edge-rows" data-footer-edge-rows>
          <span class="footer-edge-loading">Tracing route…</span>
        </span>
      </span>
    </span>
  </p>

  <p class="footer-mark" data-footer-mark>{mark}</p>
</footer>

<script>
  const STATUS_LABELS: Record<string, string> = {
    operational: 'Operational',
    degraded: 'Degraded',
    down: 'Downtime',
    maintenance: 'Maintenance',
    unknown: 'Unknown',
  };

  const STATUS_TITLES: Record<string, string> = {
    operational: 'All systems operational',
    degraded: 'Degraded performance',
    down: 'Downtime',
    maintenance: 'Under maintenance',
    unknown: 'Status unknown',
  };

  const REGION_NAMES: Record<string, string> = {
    ARN: 'Stockholm',
    BOM: 'Mumbai',
    CDG: 'Paris',
    CLE: 'Cleveland',
    CPT: 'Cape Town',
    DUB: 'Dublin',
    FRA: 'Frankfurt',
    GRU: 'São Paulo',
    HKG: 'Hong Kong',
    HND: 'Tokyo',
    IAD: 'Washington, D.C.',
    ICN: 'Seoul',
    KIX: 'Osaka',
    KUL: 'Kuala Lumpur',
    LHR: 'London',
    MEL: 'Melbourne',
    PDX: 'Portland',
    SFO: 'San Francisco',
    SIN: 'Singapore',
    SYD: 'Sydney',
    YYZ: 'Toronto',
  };

  function parseRegion(headerValue: string | null): string | null {
    if (!headerValue) return null;
    const head = headerValue.split(':')[0]?.trim();
    if (!head) return null;
    const code = head.replace(/\d+$/, '').toUpperCase();
    return /^[A-Z]{3}$/.test(code) ? code : null;
  }

  async function hydrateFooter() {
    const root = document.querySelector<HTMLAnchorElement>('[data-footer-status]');
    const labelEl = document.querySelector<HTMLElement>('[data-footer-status-label]');
    const regionEl = document.querySelector<HTMLElement>('[data-footer-region]');
    const regionSepEl = document.querySelector<HTMLElement>('[data-footer-region-sep]');
    const regionCodeEl = document.querySelector<HTMLElement>('[data-footer-region-code]');
    if (!root || !labelEl) return;

    try {
      const res = await fetch('/api/footer', { headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);

      const data = (await res.json()) as { status?: string };
      const status = (data?.status ?? 'unknown') as keyof typeof STATUS_LABELS;
      const next = STATUS_LABELS[status] ? status : 'unknown';
      root.setAttribute('data-footer-status', next);
      labelEl.textContent = STATUS_LABELS[next];
      root.title = STATUS_TITLES[next];

      const region = parseRegion(res.headers.get('x-cloudflare-colo'));
      if (region && regionEl && regionCodeEl) {
        regionCodeEl.textContent = region;
        regionEl.title = `Edge region: ${REGION_NAMES[region] ?? region}`;
        regionEl.hidden = false;
        if (regionSepEl) regionSepEl.hidden = false;
      }
    } catch (error) {
      console.warn('Footer status fetch failed:', error);
      root.setAttribute('data-footer-status', 'unknown');
      labelEl.textContent = STATUS_LABELS.unknown;
      root.title = STATUS_TITLES.unknown;
    }
  }

  interface EdgeInfo {
    colo: string | null;
    country: string | null;
    city: string | null;
    region: string | null;
    protocol: string | null;
    tls: string | null;
    rtt: number | null;
    network: string | null;
  }

  function edgeRow(label: string, value: string): string {
    return `<span class="footer-edge-row"><span class="footer-edge-key">${label}</span><span class="footer-edge-val">${value}</span></span>`;
  }

  function rttHue(ms: number): number {
    // 0ms → green (140), 200ms+ → amber (40); linear in between.
    const clamped = Math.min(Math.max(ms, 0), 200);
    return 140 - (clamped / 200) * 100;
  }

  function renderEdge(info: EdgeInfo): string {
    const rows: string[] = [];

    if (info.colo) {
      const place = REGION_NAMES[info.colo];
      rows.push(edgeRow('Datacenter', place ? `${info.colo} · ${place}` : info.colo));
    }
    if (info.protocol || info.tls) {
      const proto = [info.protocol, info.tls?.replace('TLSv', 'TLS ')].filter(Boolean).join(' · ');
      rows.push(edgeRow('Route', proto));
    }
    if (typeof info.rtt === 'number') {
      const hue = rttHue(info.rtt);
      rows.push(
        edgeRow(
          'Round-trip',
          `<span class="footer-edge-rtt" style="--rtt-hue:${hue}">${info.rtt} ms</span>`
        )
      );
    }
    const here = [info.city, info.region, info.country].filter(Boolean).join(', ');
    if (here) rows.push(edgeRow('You', here));
    if (info.network) rows.push(edgeRow('Network', info.network));

    return rows.length ? rows.join('') : '<span class="footer-edge-loading">No edge data</span>';
  }

  function setupEdgePopover() {
    const regionMaybe = document.querySelector<HTMLElement>('[data-footer-region]');
    const trigger = document.querySelector<HTMLButtonElement>('[data-footer-region-trigger]');
    const rowsMaybe = document.querySelector<HTMLElement>('[data-footer-edge-rows]');
    if (!regionMaybe || !trigger || !rowsMaybe) return;
    const region = regionMaybe;
    const rowsEl = rowsMaybe;

    let loaded = false;
    let inflight: Promise<void> | null = null;

    const open = () => trigger.setAttribute('aria-expanded', 'true');
    const close = () => trigger.setAttribute('aria-expanded', 'false');

    async function load() {
      if (loaded || inflight) return inflight ?? undefined;
      region.setAttribute('data-edge-state', 'loading');
      inflight = (async () => {
        try {
          const res = await fetch('/api/edge', { headers: { Accept: 'application/json' } });
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const info = (await res.json()) as EdgeInfo;
          rowsEl.innerHTML = renderEdge(info);
          region.setAttribute('data-edge-state', 'ready');
          loaded = true;
        } catch (error) {
          console.warn('Edge info fetch failed:', error);
          rowsEl.innerHTML = '<span class="footer-edge-loading">Edge data unavailable</span>';
          region.setAttribute('data-edge-state', 'error');
        } finally {
          inflight = null;
        }
      })();
      return inflight;
    }

    region.addEventListener('pointerenter', () => void load());
    trigger.addEventListener('focus', () => void load());
    trigger.addEventListener('pointerenter', open);
    trigger.addEventListener('pointerleave', close);
    trigger.addEventListener('focus', open);
    trigger.addEventListener('blur', close);
    trigger.addEventListener('click', () => {
      void load();
      trigger.getAttribute('aria-expanded') === 'true' ? close() : open();
    });
  }

  // The copyright year is baked at build time; refresh it to the visitor's
  // current year so a quiet year-boundary never leaves it stale. Only the
  // digits are touched — the sealed "bunizao. All rights reserved." text is
  // left exactly as rendered (see copyrightMark in src/data/site.ts).
  function refreshCopyrightYear() {
    const mark = document.querySelector<HTMLElement>('[data-footer-mark]');
    const text = mark?.textContent;
    if (!mark || !text) return;

    const startMatch = text.match(/\d{4}/);
    if (!startMatch) return;

    const startYear = Number(startMatch[0]);
    const now = new Date().getFullYear();
    const range = now > startYear ? `${startYear}–${now}` : `${startYear}`;
    mark.textContent = text.replace(/\d{4}(?:–\d{4})?/, range);
  }

  function initFooter() {
    hydrateFooter();
    setupEdgePopover();
    refreshCopyrightYear();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFooter, { once: true });
  } else {
    initFooter();
  }
</script>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 3rem 0 2rem;
  }

  .footer-nav,
  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin: 0;
  }

  .footer-nav {
    font-size: 13px;
    color: hsl(var(--muted-foreground));
  }

  .footer-meta {
    font-size: 11px;
    color: hsl(var(--muted-foreground));
  }

  .footer-sep {
    color: hsl(var(--muted-foreground) / 0.22);
  }

  .footer-sep[hidden] {
    display: none;
  }

  .footer-link {
    color: hsl(var(--muted-foreground));
    transition: color 0.15s ease;
  }

  .footer-link:hover {
    color: hsl(var(--foreground));
  }

  .footer-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: inherit;
    transition: color 0.15s ease;
  }

  .footer-status:hover {
    color: hsl(var(--muted-foreground));
  }

  .footer-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--footer-status-color, hsl(var(--muted-foreground) / 0.4));
    transition: background 0.2s ease;
  }

  [data-footer-status='operational'] .footer-status-dot {
    --footer-status-color: hsl(142 70% 45%);
    box-shadow: 0 0 0 3px hsl(142 70% 45% / 0.18);
  }

  [data-footer-status='degraded'] .footer-status-dot,
  [data-footer-status='maintenance'] .footer-status-dot {
    --footer-status-color: hsl(38 92% 55%);
    box-shadow: 0 0 0 3px hsl(38 92% 55% / 0.18);
  }

  [data-footer-status='down'] .footer-status-dot {
    --footer-status-color: hsl(0 75% 55%);
    box-shadow: 0 0 0 3px hsl(0 75% 55% / 0.18);
  }

  .footer-region {
    position: relative;
    display: inline-flex;
    align-items: baseline;
  }

  .footer-region[hidden] {
    display: none;
  }

  .footer-region-trigger {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    line-height: inherit;
    color: inherit;
    cursor: help;
  }

  .footer-region-label {
    color: hsl(var(--muted-foreground));
    transition: color 0.15s ease;
  }

  .footer-region-code {
    color: hsl(var(--muted-foreground));
    letter-spacing: 0.04em;
    transition: color 0.15s ease;
  }

  .footer-region-trigger:hover .footer-region-code,
  .footer-region-trigger:focus-visible .footer-region-code {
    color: hsl(var(--foreground));
  }

  .footer-region-trigger:focus-visible {
    outline: none;
  }

  .footer-region-trigger:focus-visible .footer-region-label {
    color: hsl(var(--muted-foreground) / 0.75);
  }

  .footer-edge-pop {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    z-index: 20;
    min-width: 220px;
    padding: 11px 13px;
    border-radius: 12px;
    border: 1px solid hsl(var(--foreground) / 0.08);
    background: hsl(var(--card) / 0.55);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    box-shadow:
      0 16px 40px -16px hsl(var(--foreground) / 0.28),
      inset 0 1px 0 hsl(0 0% 100% / 0.06);
    text-align: left;
    opacity: 0;
    transform: translate(-50%, 4px);
    transform-origin: bottom center;
    pointer-events: none;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .footer-region-trigger[aria-expanded='true'] + .footer-edge-pop {
    opacity: 1;
    transform: translate(-50%, 0);
    pointer-events: auto;
  }

  .footer-edge-arrow {
    position: absolute;
    top: 100%;
    left: 50%;
    width: 10px;
    height: 10px;
    margin-left: -5px;
    margin-top: -5px;
    border-right: 1px solid hsl(var(--foreground) / 0.08);
    border-bottom: 1px solid hsl(var(--foreground) / 0.08);
    background: hsl(var(--card) / 0.55);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    transform: rotate(45deg);
  }

  .footer-edge-rows {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* Rows are injected via innerHTML at runtime, so they don't carry Astro's
     scoped-style attribute — target them with :global under the static popover. */
  .footer-edge-pop :global(.footer-edge-row) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 18px;
    font-size: 11px;
    line-height: 1.3;
    white-space: nowrap;
  }

  .footer-edge-pop :global(.footer-edge-key) {
    color: hsl(var(--muted-foreground) / 0.55);
    letter-spacing: 0.02em;
  }

  .footer-edge-pop :global(.footer-edge-val) {
    color: hsl(var(--foreground) / 0.85);
    font-variant-numeric: tabular-nums;
  }

  .footer-edge-pop :global(.footer-edge-rtt) {
    color: hsl(var(--rtt-hue, 140) 70% 45%);
    font-weight: 500;
  }

  .footer-edge-pop :global(.footer-edge-loading) {
    display: block;
    font-size: 11px;
    color: hsl(var(--muted-foreground) / 0.55);
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-edge-pop {
      transition: opacity 0.18s ease;
      transform: translate(-50%, 0);
    }

    .footer-region-trigger[aria-expanded='true'] + .footer-edge-pop {
      transform: translate(-50%, 0);
    }
  }

  .footer-mark {
    margin: 0;
    text-align: center;
    font-size: 11px;
    color: hsl(var(--muted-foreground));
  }
</style>
