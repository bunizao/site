---
import { footer, copyrightMark, profile } from '@/data/site';

const { links, statusUrl } = footer;
const mark = copyrightMark(new Date().getFullYear());

// Icon-only contact badges; keep it to the channels that take a message.
const socialNames = ['GitHub', 'Email', 'Telegram'];
const socials = socialNames
  .map((name) => profile.links.find((link) => link.name === name))
  .filter((link): link is (typeof profile.links)[number] => Boolean(link));
---

<footer class="footer">
  <nav class="footer-socials" aria-label="Contact">
    {socials.map((social) => (
      <a
        class="footer-social"
        href={social.url}
        title={social.name}
        aria-label={social.name}
        {...(social.url.startsWith('http') ? { target: '_blank', rel: 'me noopener noreferrer' } : { rel: 'me' })}
      >
        <social.icon aria-hidden="true" />
      </a>
    ))}
  </nav>

  <nav class="footer-nav" aria-label="Footer">
    {links.map((link, i) => (
      <>
        {i > 0 && <span class="footer-sep" aria-hidden="true">·</span>}
        <a
          href={link.url}
          class="footer-link"
          {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {link.label}
        </a>
      </>
    ))}
  </nav>

  <p class="footer-meta">
    <a
      href={statusUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="footer-status"
      data-footer-status="unknown"
    >
      <span class="footer-status-dot" aria-hidden="true"></span>
      <span data-footer-status-label>Checking</span>
    </a>
    <span class="footer-sep" aria-hidden="true" data-footer-region-sep hidden>·</span>
    <span class="footer-region" data-footer-region data-edge-state="idle" hidden>
      <button
        type="button"
        class="footer-region-trigger"
        data-footer-region-trigger
        aria-expanded="false"
        aria-describedby="footer-edge-pop"
      >
        <span class="footer-region-label">Edge:</span>
        <span class="footer-region-code" data-footer-region-code>—</span>
      </button>
      <span
        class="footer-edge-pop"
        id="footer-edge-pop"
        role="tooltip"
        popover="manual"
        data-footer-edge-pop
      >
        <span class="footer-edge-arrow" aria-hidden="true"></span>
        <span class="footer-edge-rows" data-footer-edge-rows>
          <span class="footer-edge-loading">Tracing route…</span>
        </span>
      </span>
    </span>
  </p>

  <p class="footer-mark" data-footer-mark>{mark}</p>
</footer>

<script>
  const STATUS_LABELS: Record<string, string> = {
    operational: 'Operational',
    degraded: 'Degraded',
    down: 'Downtime',
    maintenance: 'Maintenance',
    unknown: 'Unknown',
  };

  const STATUS_TITLES: Record<string, string> = {
    operational: 'All systems operational',
    degraded: 'Degraded performance',
    down: 'Downtime',
    maintenance: 'Under maintenance',
    unknown: 'Status unknown',
  };

  const REGION_NAMES: Record<string, string> = {
    ARN: 'Stockholm',
    BOM: 'Mumbai',
    CDG: 'Paris',
    CLE: 'Cleveland',
    CPT: 'Cape Town',
    DUB: 'Dublin',
    FRA: 'Frankfurt',
    GRU: 'São Paulo',
    HKG: 'Hong Kong',
    HND: 'Tokyo',
    IAD: 'Washington, D.C.',
    ICN: 'Seoul',
    KIX: 'Osaka',
    KUL: 'Kuala Lumpur',
    LHR: 'London',
    MEL: 'Melbourne',
    PDX: 'Portland',
    SFO: 'San Francisco',
    SIN: 'Singapore',
    SYD: 'Sydney',
    YYZ: 'Toronto',
  };

  function parseRegion(headerValue: string | null): string | null {
    if (!headerValue) return null;
    const head = headerValue.split(':')[0]?.trim();
    if (!head) return null;
    const code = head.replace(/\d+$/, '').toUpperCase();
    return /^[A-Z]{3}$/.test(code) ? code : null;
  }

  async function hydrateFooter() {
    const root = document.querySelector<HTMLAnchorElement>('[data-footer-status]');
    const labelEl = document.querySelector<HTMLElement>('[data-footer-status-label]');
    const regionEl = document.querySelector<HTMLElement>('[data-footer-region]');
    const regionSepEl = document.querySelector<HTMLElement>('[data-footer-region-sep]');
    const regionCodeEl = document.querySelector<HTMLElement>('[data-footer-region-code]');
    if (!root || !labelEl) return;

    try {
      const res = await fetch('/api/footer', { headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);

      const data = (await res.json()) as { status?: string };
      const status = (data?.status ?? 'unknown') as keyof typeof STATUS_LABELS;
      const next = STATUS_LABELS[status] ? status : 'unknown';
      root.setAttribute('data-footer-status', next);
      labelEl.textContent = STATUS_LABELS[next];
      root.title = STATUS_TITLES[next];

      const region = parseRegion(res.headers.get('x-cloudflare-colo'));
      if (region && regionEl && regionCodeEl) {
        regionCodeEl.textContent = region;
        // No `title` here — the popover already names the datacenter, and the
        // OS tooltip would stack a second box on top of it on hover.
        regionEl.hidden = false;
        if (regionSepEl) regionSepEl.hidden = false;
      }
    } catch (error) {
      console.warn('Footer status fetch failed:', error);
      root.setAttribute('data-footer-status', 'unknown');
      labelEl.textContent = STATUS_LABELS.unknown;
      root.title = STATUS_TITLES.unknown;
    }
  }

  interface EdgeInfo {
    colo: string | null;
    country: string | null;
    city: string | null;
    region: string | null;
    protocol: string | null;
    tls: string | null;
    rtt: number | null;
    network: string | null;
  }

  function edgeRow(label: string, value: string): string {
    return `<span class="footer-edge-row"><span class="footer-edge-key">${label}</span><span class="footer-edge-val">${value}</span></span>`;
  }

  function rttHue(ms: number): number {
    // 0ms → green (140), 200ms+ → amber (40); linear in between.
    const clamped = Math.min(Math.max(ms, 0), 200);
    return 140 - (clamped / 200) * 100;
  }

  function renderEdge(info: EdgeInfo): string {
    const rows: string[] = [];

    if (info.colo) {
      const place = REGION_NAMES[info.colo];
      rows.push(edgeRow('Datacenter', place ? `${info.colo} · ${place}` : info.colo));
    }
    if (info.protocol || info.tls) {
      const proto = [info.protocol, info.tls?.replace('TLSv', 'TLS ')].filter(Boolean).join(' · ');
      rows.push(edgeRow('Route', proto));
    }
    if (typeof info.rtt === 'number') {
      const hue = rttHue(info.rtt);
      rows.push(
        edgeRow(
          'Round-trip',
          `<span class="footer-edge-rtt" style="--rtt-hue:${hue}">${info.rtt} ms</span>`
        )
      );
    }
    const here = [info.city, info.region, info.country].filter(Boolean).join(', ');
    if (here) rows.push(edgeRow('You', here));
    if (info.network) rows.push(edgeRow('Network', info.network));

    return rows.length ? rows.join('') : '<span class="footer-edge-loading">No edge data</span>';
  }

  // Space between the trigger and the popover, and the clearance the popover
  // keeps from the viewport edges.
  const POP_GAP = 10;
  const POP_EDGE = 12;

  function setupEdgePopover() {
    const regionMaybe = document.querySelector<HTMLElement>('[data-footer-region]');
    const triggerMaybe = document.querySelector<HTMLButtonElement>('[data-footer-region-trigger]');
    const rowsMaybe = document.querySelector<HTMLElement>('[data-footer-edge-rows]');
    const popMaybe = document.querySelector<HTMLElement>('[data-footer-edge-pop]');
    if (!regionMaybe || !triggerMaybe || !rowsMaybe || !popMaybe) return;
    const region = regionMaybe;
    const trigger = triggerMaybe;
    const rowsEl = rowsMaybe;
    const pop = popMaybe;

    // Without the Popover API there is no top layer to draw into, and the CSS
    // leaves the popover hidden rather than dropping it into the flow.
    if (typeof pop.showPopover !== 'function') return;

    let loaded = false;
    let inflight: Promise<void> | null = null;
    let pinned = false;
    let hovered = false;

    const isOpen = () => pop.matches(':popover-open');

    // Top-layer boxes are positioned against the viewport, not the footer, so
    // the coordinates are recomputed on open, on scroll, on resize, and every
    // time the rows change the popover's height.
    function place() {
      const anchor = trigger.getBoundingClientRect();
      const { width, height } = pop.getBoundingClientRect();
      const centre = anchor.left + anchor.width / 2;
      const maxX = Math.max(POP_EDGE, window.innerWidth - POP_EDGE - width);
      const x = Math.min(Math.max(centre - width / 2, POP_EDGE), maxX);
      const maxY = Math.max(POP_EDGE, window.innerHeight - POP_EDGE - height);
      const spaceAbove = anchor.top - POP_GAP - POP_EDGE;
      const spaceBelow = window.innerHeight - POP_EDGE - POP_GAP - anchor.bottom;
      const placement = height <= spaceAbove || spaceAbove >= spaceBelow ? 'above' : 'below';
      const preferredY = placement === 'above'
        ? anchor.top - POP_GAP - height
        : anchor.bottom + POP_GAP;
      const y = Math.min(Math.max(preferredY, POP_EDGE), maxY);
      const arrowX = Math.min(Math.max(centre - x, POP_EDGE), width - POP_EDGE);
      pop.style.setProperty('--pop-x', `${Math.round(x)}px`);
      pop.style.setProperty('--pop-y', `${Math.round(y)}px`);
      pop.style.setProperty('--pop-arrow-x', `${Math.round(arrowX)}px`);
      pop.dataset.placement = placement;
    }

    const reposition = () => {
      if (isOpen()) place();
    };

    function dismiss(event: PointerEvent) {
      const target = event.target;
      if (!(target instanceof Node) || trigger.contains(target) || pop.contains(target)) return;
      pinned = false;
      close();
    }

    function handleKeydown(event: KeyboardEvent) {
      if (event.key !== 'Escape') return;
      pinned = false;
      close();
    }

    // The toggle event is the single source of truth for exposed state and
    // global listeners, including programmatic closes and DOM removal.
    pop.addEventListener('toggle', () => {
      const opened = isOpen();
      trigger.setAttribute('aria-expanded', opened ? 'true' : 'false');
      if (opened) {
        place();
        window.addEventListener('scroll', reposition, { passive: true, capture: true });
        window.addEventListener('resize', reposition);
        document.addEventListener('pointerdown', dismiss, { capture: true });
        document.addEventListener('keydown', handleKeydown);
      } else {
        window.removeEventListener('scroll', reposition, { capture: true });
        window.removeEventListener('resize', reposition);
        document.removeEventListener('pointerdown', dismiss, { capture: true });
        document.removeEventListener('keydown', handleKeydown);
      }
    });

    const open = () => {
      if (!isOpen()) pop.showPopover();
    };
    const close = () => {
      if (isOpen()) pop.hidePopover();
    };

    async function load() {
      if (loaded || inflight) return inflight ?? undefined;
      region.setAttribute('data-edge-state', 'loading');
      inflight = (async () => {
        try {
          const res = await fetch('/api/edge', { headers: { Accept: 'application/json' } });
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const info = (await res.json()) as EdgeInfo;
          rowsEl.innerHTML = renderEdge(info);
          region.setAttribute('data-edge-state', 'ready');
          loaded = true;
        } catch (error) {
          console.warn('Edge info fetch failed:', error);
          rowsEl.innerHTML = '<span class="footer-edge-loading">Edge data unavailable</span>';
          region.setAttribute('data-edge-state', 'error');
        } finally {
          inflight = null;
          reposition();
        }
      })();
      return inflight;
    }

    region.addEventListener('pointerenter', () => void load());
    trigger.addEventListener('focus', () => void load());
    trigger.addEventListener('pointerenter', () => {
      hovered = true;
      open();
    });
    trigger.addEventListener('pointerleave', () => {
      hovered = false;
      if (!pinned && document.activeElement !== trigger) close();
    });
    trigger.addEventListener('focus', open);
    trigger.addEventListener('blur', () => {
      if (!pinned && !hovered) close();
    });
    trigger.addEventListener('click', () => {
      void load();
      pinned = !pinned;
      pinned ? open() : close();
    });
  }

  // The copyright year is baked at build time; refresh it to the visitor's
  // current year so a quiet year-boundary never leaves it stale. Only the
  // digits are touched — the sealed "bunizao. All rights reserved." text is
  // left exactly as rendered (see copyrightMark in src/data/site.ts).
  function refreshCopyrightYear() {
    const mark = document.querySelector<HTMLElement>('[data-footer-mark]');
    const text = mark?.textContent;
    if (!mark || !text) return;

    const startMatch = text.match(/\d{4}/);
    if (!startMatch) return;

    const startYear = Number(startMatch[0]);
    const now = new Date().getFullYear();
    const range = now > startYear ? `${startYear}–${now}` : `${startYear}`;
    mark.textContent = text.replace(/\d{4}(?:–\d{4})?/, range);
  }

  function initFooter() {
    hydrateFooter();
    setupEdgePopover();
    refreshCopyrightYear();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFooter, { once: true });
  } else {
    initFooter();
  }
</script>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 3rem 0 2rem;
  }

  .footer-socials {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin: 0;
  }

  .footer-social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    color: hsl(var(--muted-foreground));
    transition: color 0.15s ease;
  }

  .footer-social:hover {
    color: hsl(var(--foreground));
  }

  /* lucide-react renders an unscoped <svg>; size it via :global. */
  .footer-social :global(svg) {
    width: 18px;
    height: 18px;
  }

  .footer-nav,
  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin: 0;
  }

  .footer-nav {
    font-size: 13px;
    color: hsl(var(--muted-foreground));
  }

  .footer-meta {
    font-size: 11px;
    color: hsl(var(--muted-foreground));
  }

  .footer-sep {
    color: hsl(var(--muted-foreground) / 0.22);
  }

  .footer-sep[hidden] {
    display: none;
  }

  .footer-link {
    color: hsl(var(--muted-foreground));
    transition: color 0.15s ease;
  }

  .footer-link:hover {
    color: hsl(var(--foreground));
  }

  .footer-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: inherit;
    transition: color 0.15s ease;
  }

  .footer-status:hover {
    color: hsl(var(--muted-foreground));
  }

  .footer-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--footer-status-color, hsl(var(--muted-foreground) / 0.4));
    transition: background 0.2s ease;
  }

  [data-footer-status='operational'] .footer-status-dot {
    --footer-status-color: hsl(142 70% 45%);
    box-shadow: 0 0 0 3px hsl(142 70% 45% / 0.18);
  }

  [data-footer-status='degraded'] .footer-status-dot,
  [data-footer-status='maintenance'] .footer-status-dot {
    --footer-status-color: hsl(38 92% 55%);
    box-shadow: 0 0 0 3px hsl(38 92% 55% / 0.18);
  }

  [data-footer-status='down'] .footer-status-dot {
    --footer-status-color: hsl(0 75% 55%);
    box-shadow: 0 0 0 3px hsl(0 75% 55% / 0.18);
  }

  .footer-region {
    position: relative;
    display: inline-flex;
    align-items: baseline;
  }

  .footer-region[hidden] {
    display: none;
  }

  .footer-region-trigger {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    line-height: inherit;
    color: inherit;
    cursor: help;
  }

  .footer-region-label {
    color: hsl(var(--muted-foreground));
    transition: color 0.15s ease;
  }

  .footer-region-code {
    color: hsl(var(--muted-foreground));
    letter-spacing: 0.04em;
    transition: color 0.15s ease;
  }

  .footer-region-trigger:hover .footer-region-code,
  .footer-region-trigger:focus-visible .footer-region-code {
    color: hsl(var(--foreground));
  }

  .footer-region-trigger:focus-visible {
    outline: none;
  }

  .footer-region-trigger:focus-visible .footer-region-label {
    color: hsl(var(--muted-foreground) / 0.75);
  }

  /* The popover reaches past the footer's top edge the moment a long value (an
     ISP name, a long city) wraps a row, and the footer sits inside a clipping
     ancestor on more than one surface — a scroll container on blog pages, and
     paint containment wherever `content-visibility` gets applied. So it is not
     positioned inside the footer at all: `popover` puts it in the top layer,
     above every ancestor's clip, and setupEdgePopover() drives --pop-x/--pop-y
     in viewport coordinates. Nothing about the footer's box can crop it now.

     The UA sheet gives [popover] its own inset/margin/border/background/
     overflow — each of those is overridden below, `overflow` included, or the
     arrow gets clipped by the popover itself. Browsers without the Popover
     API never match :popover-open, so the whole thing stays display: none. */
  .footer-edge-pop {
    --pop-lift: 4px;

    display: none;
    position: fixed;
    inset: auto;
    left: var(--pop-x, 0px);
    top: var(--pop-y, 0px);
    z-index: 20;
    width: max-content;
    min-width: min(220px, calc(100vw - 24px));
    max-width: min(300px, calc(100vw - 24px));
    margin: 0;
    padding: 11px 13px;
    overflow: visible;
    border-radius: 12px;
    border: 1px solid hsl(var(--foreground) / 0.1);
    background: hsl(var(--card) / 0.92);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    backdrop-filter: blur(18px) saturate(160%);
    box-shadow:
      0 16px 40px -16px hsl(var(--foreground) / 0.28),
      inset 0 1px 0 hsl(0 0% 100% / 0.06);
    color: hsl(var(--muted-foreground));
    text-align: left;
    opacity: 0;
    transform: translateY(var(--pop-lift));
    transition:
      opacity 0.18s ease,
      transform 0.18s ease,
      overlay 0.18s ease allow-discrete,
      display 0.18s ease allow-discrete;
  }

  .footer-edge-pop:popover-open {
    display: block;
    opacity: 1;
    transform: translateY(0);
  }

  @starting-style {
    .footer-edge-pop:popover-open {
      opacity: 0;
      transform: translateY(var(--pop-lift));
    }
  }

  .footer-edge-arrow {
    position: absolute;
    top: 100%;
    left: var(--pop-arrow-x, 50%);
    width: 10px;
    height: 10px;
    margin-left: -5px;
    margin-top: -5px;
    border-right: 1px solid hsl(var(--foreground) / 0.08);
    border-bottom: 1px solid hsl(var(--foreground) / 0.08);
    background: hsl(var(--card) / 0.92);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    backdrop-filter: blur(18px) saturate(160%);
    transform: rotate(45deg);
  }

  .footer-edge-pop[data-placement='below'] .footer-edge-arrow {
    top: auto;
    bottom: 100%;
    margin-top: 0;
    margin-bottom: -5px;
    border-right: 0;
    border-bottom: 0;
    border-left: 1px solid hsl(var(--foreground) / 0.08);
    border-top: 1px solid hsl(var(--foreground) / 0.08);
  }

  .footer-edge-rows {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-height: calc(100vh - 48px);
    max-height: calc(100dvh - 48px);
    overflow-y: auto;
  }

  /* Rows are injected via innerHTML at runtime, so they don't carry Astro's
     scoped-style attribute — target them with :global under the static popover. */
  .footer-edge-pop :global(.footer-edge-row) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 18px;
    font-size: 11px;
    line-height: 1.3;
  }

  .footer-edge-pop :global(.footer-edge-key) {
    flex-shrink: 0;
    color: hsl(var(--muted-foreground) / 0.55);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .footer-edge-pop :global(.footer-edge-val) {
    min-width: 0;
    color: hsl(var(--foreground) / 0.85);
    font-variant-numeric: tabular-nums;
    text-align: right;
    overflow-wrap: anywhere;
  }

  .footer-edge-pop :global(.footer-edge-rtt) {
    color: hsl(var(--rtt-hue, 140) 70% 45%);
    font-weight: 500;
  }

  .footer-edge-pop :global(.footer-edge-loading) {
    display: block;
    font-size: 11px;
    color: hsl(var(--muted-foreground) / 0.55);
  }

  /* No narrow-screen special case: place() clamps the popover inside the
     viewport at every width and slides the arrow to stay under the trigger. */

  @media (prefers-reduced-motion: reduce) {
    .footer-edge-pop {
      --pop-lift: 0px;
    }
  }

  .footer-mark {
    margin: 0;
    text-align: center;
    font-size: 11px;
    color: hsl(var(--muted-foreground));
  }
</style>
