---
const startYear = 2023;
const currentYear = new Date().getFullYear();
const yearRange = currentYear > startYear ? `${startYear}–${currentYear}` : `${currentYear}`;
---

<footer class="footer">
  <p class="footer-mark">
    <span class="footer-year">{yearRange}</span>
    <span class="footer-by">by</span>
    <span class="footer-name">bunizao</span>
  </p>

  <nav class="footer-nav" aria-label="Footer">
    <a
      href="https://github.com/bunizao/site"
      target="_blank"
      rel="noopener noreferrer"
      class="footer-link"
    >
      Source
    </a>
    <a
      href="https://astro.build"
      target="_blank"
      rel="noopener noreferrer"
      class="footer-link"
    >
      Astro
    </a>
    <a href="/privacy" class="footer-link">Privacy</a>
    <a
      href="https://status.tuuhub.com"
      target="_blank"
      rel="noopener noreferrer"
      class="footer-status"
      data-footer-status="unknown"
    >
      <span class="footer-status-dot" aria-hidden="true"></span>
      <span data-footer-status-label>Checking</span>
    </a>
    <span class="footer-region" data-footer-region hidden>
      <span class="footer-region-label">Edge</span>
      <span class="footer-region-code" data-footer-region-code>—</span>
    </span>
  </nav>
</footer>

<script>
  const STATUS_LABELS: Record<string, string> = {
    operational: 'Operational',
    degraded: 'Degraded',
    down: 'Downtime',
    maintenance: 'Maintenance',
    unknown: 'Unknown',
  };

  const STATUS_TITLES: Record<string, string> = {
    operational: 'All systems operational',
    degraded: 'Degraded performance',
    down: 'Downtime',
    maintenance: 'Under maintenance',
    unknown: 'Status unknown',
  };

  const REGION_NAMES: Record<string, string> = {
    ARN: 'Stockholm',
    BOM: 'Mumbai',
    CDG: 'Paris',
    CLE: 'Cleveland',
    CPT: 'Cape Town',
    DUB: 'Dublin',
    FRA: 'Frankfurt',
    GRU: 'São Paulo',
    HKG: 'Hong Kong',
    HND: 'Tokyo',
    IAD: 'Washington, D.C.',
    ICN: 'Seoul',
    KIX: 'Osaka',
    KUL: 'Kuala Lumpur',
    LHR: 'London',
    MEL: 'Melbourne',
    PDX: 'Portland',
    SFO: 'San Francisco',
    SIN: 'Singapore',
    SYD: 'Sydney',
    YYZ: 'Toronto',
  };

  function parseRegion(headerValue: string | null): string | null {
    if (!headerValue) return null;
    const head = headerValue.split(':')[0]?.trim();
    if (!head) return null;
    const code = head.replace(/\d+$/, '').toUpperCase();
    return /^[A-Z]{3}$/.test(code) ? code : null;
  }

  async function hydrateFooter() {
    const root = document.querySelector<HTMLAnchorElement>('[data-footer-status]');
    const labelEl = document.querySelector<HTMLElement>('[data-footer-status-label]');
    const regionEl = document.querySelector<HTMLElement>('[data-footer-region]');
    const regionCodeEl = document.querySelector<HTMLElement>('[data-footer-region-code]');
    if (!root || !labelEl) return;

    try {
      const res = await fetch('/api/footer', { headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);

      const data = (await res.json()) as { status?: string };
      const status = (data?.status ?? 'unknown') as keyof typeof STATUS_LABELS;
      const next = STATUS_LABELS[status] ? status : 'unknown';
      root.setAttribute('data-footer-status', next);
      labelEl.textContent = STATUS_LABELS[next];
      root.title = STATUS_TITLES[next];

      const region = parseRegion(res.headers.get('x-vercel-id'));
      if (region && regionEl && regionCodeEl) {
        regionCodeEl.textContent = region;
        regionEl.title = `Edge region: ${REGION_NAMES[region] ?? region}`;
        regionEl.hidden = false;
      }
    } catch (error) {
      console.warn('Footer status fetch failed:', error);
      root.setAttribute('data-footer-status', 'unknown');
      labelEl.textContent = STATUS_LABELS.unknown;
      root.title = STATUS_TITLES.unknown;
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', hydrateFooter, { once: true });
  } else {
    hydrateFooter();
  }
</script>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    padding: 4rem 0 2.5rem;
  }

  .footer-mark {
    margin: 0;
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    font-size: 14px;
    line-height: 1.3;
    color: hsl(var(--muted-foreground) / 0.85);
  }

  .footer-year {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: hsl(var(--muted-foreground) / 0.55);
    font-feature-settings: 'tnum';
  }

  .footer-by {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 360;
    font-variation-settings: 'opsz' 14, 'SOFT' 100, 'WONK' 1;
    font-size: 14px;
    color: hsl(var(--muted-foreground) / 0.6);
  }

  .footer-name {
    font-family: var(--font-display);
    font-weight: 460;
    font-variation-settings: 'opsz' 32, 'SOFT' 50, 'WONK' 0;
    font-size: 15px;
    color: hsl(var(--foreground) / 0.85);
    letter-spacing: -0.005em;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin: 0;
    font-size: 12px;
    color: hsl(var(--muted-foreground) / 0.7);
  }

  .footer-link {
    color: hsl(var(--muted-foreground) / 0.7);
    transition: color 0.15s ease;
  }

  .footer-link:hover {
    color: hsl(var(--foreground));
  }

  .footer-status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: inherit;
    transition: color 0.15s ease;
  }

  .footer-status:hover {
    color: hsl(var(--foreground));
  }

  .footer-status-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--footer-status-color, hsl(var(--muted-foreground) / 0.4));
    transition: background 0.2s ease;
  }

  [data-footer-status='operational'] .footer-status-dot {
    --footer-status-color: hsl(142 70% 45%);
    box-shadow: 0 0 0 3px hsl(142 70% 45% / 0.18);
  }

  [data-footer-status='degraded'] .footer-status-dot,
  [data-footer-status='maintenance'] .footer-status-dot {
    --footer-status-color: hsl(38 92% 55%);
    box-shadow: 0 0 0 3px hsl(38 92% 55% / 0.18);
  }

  [data-footer-status='down'] .footer-status-dot {
    --footer-status-color: hsl(0 75% 55%);
    box-shadow: 0 0 0 3px hsl(0 75% 55% / 0.18);
  }

  .footer-region {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }

  .footer-region[hidden] {
    display: none;
  }

  .footer-region-label {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 360;
    font-variation-settings: 'opsz' 14, 'SOFT' 100, 'WONK' 1;
    color: hsl(var(--muted-foreground) / 0.5);
  }

  .footer-region-code {
    font-family: var(--font-mono);
    color: hsl(var(--muted-foreground) / 0.7);
    letter-spacing: 0.04em;
    font-feature-settings: 'tnum';
  }
</style>
