---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-line">
    <a
      href="https://status.tuuhub.com"
      target="_blank"
      rel="noopener noreferrer"
      class="footer-status"
      data-footer-status="unknown"
      aria-label="Service status"
    >
      <span class="footer-status-dot" aria-hidden="true"></span>
    </a>
    <span class="footer-region" data-footer-region hidden aria-label="Edge region">
      <svg
        class="footer-region-icon"
        viewBox="0 0 12 12"
        width="11"
        height="11"
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-width="1.1"
        stroke-linecap="round"
      >
        <circle cx="6" cy="6" r="4.5" />
        <path d="M1.5 6h9" />
        <path d="M6 1.5c1.6 1.4 2.4 3 2.4 4.5S7.6 9.1 6 10.5C4.4 9.1 3.6 7.5 3.6 6S4.4 2.9 6 1.5z" />
      </svg>
      <span class="footer-region-code" data-footer-region-code></span>
    </span>
    <span class="footer-divider">·</span>
    <span class="footer-copyright">© {year} bunizao</span>
    <span class="footer-divider">·</span>
    <a
      href="https://github.com/bunizao/site"
      target="_blank"
      rel="noopener noreferrer"
      class="footer-link"
    >
      Source
    </a>
    <span class="footer-divider">·</span>
    <a
      href="https://astro.build"
      target="_blank"
      rel="noopener noreferrer"
      class="footer-link"
    >
      Astro
    </a>
    <span class="footer-divider">·</span>
    <a href="/privacy" class="footer-link">Privacy</a>
  </div>
</footer>

<script>
  const STATUS_TITLES: Record<string, string> = {
    operational: 'All systems operational',
    degraded: 'Degraded performance',
    down: 'Downtime',
    maintenance: 'Under maintenance',
    unknown: 'Status unknown',
  };

  const REGION_NAMES: Record<string, string> = {
    ARN: 'Stockholm',
    BOM: 'Mumbai',
    CDG: 'Paris',
    CLE: 'Cleveland',
    CPT: 'Cape Town',
    DUB: 'Dublin',
    FRA: 'Frankfurt',
    GRU: 'São Paulo',
    HKG: 'Hong Kong',
    HND: 'Tokyo',
    IAD: 'Washington, D.C.',
    ICN: 'Seoul',
    KIX: 'Osaka',
    KUL: 'Kuala Lumpur',
    LHR: 'London',
    MEL: 'Melbourne',
    PDX: 'Portland',
    SFO: 'San Francisco',
    SIN: 'Singapore',
    SYD: 'Sydney',
    YYZ: 'Toronto',
  };

  function parseRegion(headerValue: string | null): string | null {
    if (!headerValue) return null;
    const head = headerValue.split(':')[0]?.trim();
    if (!head) return null;
    const code = head.replace(/\d+$/, '').toUpperCase();
    return /^[A-Z]{3}$/.test(code) ? code : null;
  }

  async function hydrateFooter() {
    const root = document.querySelector<HTMLAnchorElement>('[data-footer-status]');
    const regionEl = document.querySelector<HTMLElement>('[data-footer-region]');
    const regionCodeEl = document.querySelector<HTMLElement>('[data-footer-region-code]');
    if (!root) return;

    try {
      const res = await fetch('/api/footer', { headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);

      const data = (await res.json()) as { status?: string };
      const status = (data?.status ?? 'unknown') as keyof typeof STATUS_TITLES;
      const next = STATUS_TITLES[status] ? status : 'unknown';
      root.setAttribute('data-footer-status', next);
      root.title = STATUS_TITLES[next];

      const region = parseRegion(res.headers.get('x-vercel-id'));
      if (region && regionEl && regionCodeEl) {
        regionCodeEl.textContent = region;
        regionEl.title = `Served from ${REGION_NAMES[region] ?? region}`;
        regionEl.hidden = false;
      }
    } catch (error) {
      console.warn('Footer status fetch failed:', error);
      root.setAttribute('data-footer-status', 'unknown');
      root.title = STATUS_TITLES.unknown;
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', hydrateFooter, { once: true });
  } else {
    hydrateFooter();
  }
</script>

<style>
  .footer {
    padding: 3rem 0 2rem;
  }

  .footer-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-size: 12px;
    font-weight: 300;
    color: hsl(var(--muted-foreground) / 0.55);
  }

  .footer-divider {
    color: hsl(var(--muted-foreground) / 0.25);
  }

  .footer-copyright {
    color: hsl(var(--muted-foreground) / 0.6);
  }

  .footer-link {
    color: hsl(var(--muted-foreground) / 0.55);
    transition: color 0.15s ease;
  }

  .footer-link:hover {
    color: hsl(var(--muted-foreground));
  }

  .footer-status {
    display: inline-flex;
    align-items: center;
    color: hsl(var(--muted-foreground) / 0.6);
    transition: color 0.15s ease;
  }

  .footer-status:hover {
    color: hsl(var(--muted-foreground));
  }

  .footer-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--footer-status-color, hsl(var(--muted-foreground) / 0.4));
    transition: background 0.2s ease;
  }

  [data-footer-status='operational'] .footer-status-dot {
    --footer-status-color: hsl(142 70% 45%);
  }

  [data-footer-status='degraded'] .footer-status-dot,
  [data-footer-status='maintenance'] .footer-status-dot {
    --footer-status-color: hsl(38 92% 55%);
  }

  [data-footer-status='down'] .footer-status-dot {
    --footer-status-color: hsl(0 75% 55%);
  }

  .footer-region {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: hsl(var(--muted-foreground) / 0.55);
    cursor: help;
    transition: color 0.15s ease;
  }

  .footer-region:hover {
    color: hsl(var(--muted-foreground));
  }

  .footer-region[hidden] {
    display: none;
  }

  .footer-region-icon {
    flex: none;
    opacity: 0.7;
  }

  .footer-region-code {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
  }
</style>
