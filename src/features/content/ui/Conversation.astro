---
// Thin wrapper over renderConversation. The heavy lifting is in the pure
// module so the same output is testable without a renderer; this file only
// pulls in the stylesheet and injects the markup.
import '@/styles/conversation.css';
import { renderConversation } from '@/features/content/conversation';

interface Props {
  source: string;
}

const { source } = Astro.props;
---

<Fragment set:html={renderConversation(source)} />

<script>
  // Progressive enhancement only: see conversation-fit.ts for why a wrapped
  // bubble needs a measuring pass that CSS cannot express.
  import { observeConversations, refitOnFontLoad } from '@/features/content/client/conversation-fit';

  observeConversations(document);
  refitOnFontLoad();
</script>
