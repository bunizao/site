---
// The blog as a softcover notebook: a matte sand cover with the publication's
// name in holographic foil and the author's mark printed across the corner. A
// hover opens the cover on the contents page. Still markup inside a frame that
// is itself the link; client/foil.ts repaints the foil as live film.
import { blog } from '@/data/site';
import type { DeskPost } from '@/features/desk/server/content';

interface Props {
  posts: DeskPost[];
  total: number;
}

const { posts, total } = Astro.props;
const copy = blog.copy[blog.locale.home];
---

<span class="jr">
  <span class="jr-pose">
    <span class="jr-book">
      <span class="jr-back"></span>
      <span class="jr-edge jr-edge--fore"></span>
      <span class="jr-edge jr-edge--head"></span>
      <span class="jr-edge jr-edge--foot"></span>
      <span class="jr-page">
        <span class="jr-heading">Contents</span>
        {posts.map((post) => (
          <span class="jr-entry">
            <span class="jr-entry-title" lang={post.lang}>{post.title}</span>
            <span class="jr-entry-date">{post.date}</span>
          </span>
        ))}
        {total > 0 && <span class="jr-total">{total} posts</span>}
      </span>
      <span class="jr-cover">
        <span class="jr-face">
          <img class="jr-mark" src={blog.logo} alt="" width="256" height="256" loading="lazy" decoding="async" />
          <span class="jr-title" data-foil="text" lang={blog.locale.home}>{copy.name}</span>
          <span class="jr-tagline" lang={blog.locale.home}>{copy.tagline}</span>
          <span class="jr-imprint">buxx.me</span>
        </span>
        <span class="jr-inside"></span>
      </span>
    </span>
  </span>
</span>

<style>
  /* A real notebook in CSS 3D: two covers and the page block between them.
     The pose turns it so the fore-edge shows; client/foil.ts adds the
     pointer's tilt through --tilt-x and --tilt-y on the frame. */
  .jr {
    --w: 232px;
    --h: 312px;
    --t: 14px;
    /* The block's rounded corners; the cut edges stop short of them. */
    --r: 7px;
    --cover: #e7e3da;
    --cover-edge: #d6d1c6;
    --paper: #fbfaf7;
    --edge: #ece9e2;
    --ink: #22201c;

    display: block;
    width: var(--w);
    height: var(--h);
    perspective: 1300px;
    font-family: var(--d-sans);
    text-align: left;
  }

  :global(html.dark) .jr {
    --cover: #d3cfc6;
    --cover-edge: #bdb8ad;
    --paper: #e6e4df;
    --edge: #d5d2cb;
  }

  .jr-pose,
  .jr-book,
  .jr-cover {
    position: absolute;
    inset: 0;
    display: block;
    transform-style: preserve-3d;
  }

  .jr-pose {
    transform: rotateX(4deg) rotateY(-18deg);
    transition: transform 0.7s var(--d-ease);
  }

  /* Eased by the script every frame, so no transition of its own. */
  .jr-book {
    transform: rotateX(calc(var(--tilt-y, 0) * 8deg)) rotateY(calc(var(--tilt-x, 0) * 12deg));
  }

  .jr-back {
    position: absolute;
    inset: 0;
    border-radius: var(--r);
    background: var(--cover-edge);
    box-shadow:
      0 2px 4px rgb(0 0 0 / 0.12),
      0 28px 44px -18px rgb(0 0 0 / 0.38);
    transform: translateZ(calc(var(--t) / -2));
  }

  /* The page block's three cut edges, between the covers' own edges. */
  .jr-edge {
    position: absolute;
    display: block;
    background: repeating-linear-gradient(var(--grain), var(--paper) 0 1px, var(--edge) 1px 2px);
  }

  .jr-edge--fore {
    --grain: 90deg;
    top: var(--r);
    right: 0;
    width: var(--t);
    height: calc(100% - var(--r) * 2);
    border-inline: 1.5px solid var(--cover-edge);
    transform-origin: right center;
    transform: translateZ(calc(var(--t) / -2)) rotateY(90deg);
  }

  .jr-edge--head,
  .jr-edge--foot {
    --grain: 0deg;
    left: var(--r);
    width: calc(100% - var(--r) * 2);
    height: var(--t);
    border-block: 1.5px solid var(--cover-edge);
  }

  .jr-edge--head {
    top: 0;
    transform-origin: center top;
    transform: translateZ(calc(var(--t) / -2)) rotateX(90deg);
  }

  .jr-edge--foot {
    bottom: 0;
    transform-origin: center bottom;
    transform: translateZ(calc(var(--t) / -2)) rotateX(-90deg);
  }

  /* The first leaf, under the cover: what the open notebook shows. */
  .jr-page {
    position: absolute;
    inset: 1px 1px 1px 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 30px 18px 18px 26px;
    border-radius: 0 var(--r) var(--r) 0;
    background: linear-gradient(90deg, rgb(0 0 0 / 0.06), transparent 22px), var(--paper);
    color: var(--ink);
    transform: translateZ(calc(var(--t) / 2 - 1px));
  }

  .jr-heading {
    margin-bottom: 4px;
    font: 500 18px / 1 var(--d-display);
    letter-spacing: -0.02em;
  }

  .jr-entry {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 2px;
  }

  .jr-entry-title {
    overflow: hidden;
    font-size: 12.5px;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .jr-entry-date,
  .jr-total {
    font-size: 10.5px;
    font-variant-numeric: tabular-nums;
    color: #8a877f;
  }

  .jr-total {
    margin-top: auto;
  }

  .jr-cover {
    transform-origin: left center;
    transform: translateZ(calc(var(--t) / 2));
    transition: transform 0.7s var(--d-ease);
  }

  .jr-face,
  .jr-inside {
    position: absolute;
    inset: 0;
    display: block;
    border-radius: var(--r);
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  /* Soft-touch stock: flat colour, the faintest fall of light, a hairline
     where the cover's edge turns. */
  .jr-face {
    overflow: hidden;
    background: radial-gradient(120% 80% at 15% 0%, rgb(255 255 255 / 0.32), transparent 65%), var(--cover);
    box-shadow:
      inset 0 0 0 1px rgb(0 0 0 / 0.05),
      inset 1px 0 0 rgb(255 255 255 / 0.5);
    color: var(--ink);
  }

  /* The mark printed large and run off the corner. */
  .jr-mark {
    position: absolute;
    right: -34px;
    bottom: -18px;
    width: 196px;
    height: 196px;
    opacity: 0.86;
    pointer-events: none;
  }

  .jr-title {
    position: absolute;
    top: 22px;
    left: 20px;
    font: 500 34px / 1.2 var(--d-display);
    letter-spacing: -0.03em;
    color: #8d8f96;
  }

  .jr-tagline {
    position: absolute;
    top: 68px;
    left: 21px;
    max-width: 148px;
    font-size: 9.5px;
    line-height: 1.4;
    color: rgb(34 32 28 / 0.55);
    text-wrap: pretty;
  }

  .jr-imprint {
    position: absolute;
    bottom: 18px;
    left: 21px;
    font-size: 9.5px;
    letter-spacing: 0.01em;
    color: rgb(34 32 28 / 0.55);
  }

  /* The cover's unprinted side. */
  .jr-inside {
    background: linear-gradient(270deg, rgb(0 0 0 / 0.07), transparent 26px), color-mix(in oklab, var(--cover), #fff 35%);
    transform: rotateY(180deg);
  }

  :global(.has-foil) [data-foil] {
    visibility: hidden;
  }

  :global(.jr-foil) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    :global(.tile:hover) .jr-pose {
      transform: translateX(46px) rotateX(2deg) rotateY(-4deg);
    }

    :global(.tile:hover) .jr-cover {
      transform: translateZ(calc(var(--t) / 2)) rotateY(-112deg);
    }
  }
</style>
