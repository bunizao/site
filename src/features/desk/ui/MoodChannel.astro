---
// The newest moods as the channel they come from: the moods hover card from
// home, grouped the way Telegram groups one sender, with the channel's name
// on the first bubble, its picture beside the last, and the reactions and
// time inside each one. `links` makes each bubble a link to its mood (in the
// window); without it the channel is a still object inside a frame that is
// already a button. On the easel each bubble is a slab of paint (`data-slab`,
// painted by the easel script); until then it is a flat bubble.
import type { DeskChannel, DeskMood } from '@/features/desk/server/content';

interface Props {
  moods: DeskMood[];
  channel: DeskChannel;
  links?: boolean;
}

const { moods, channel, links = false } = Astro.props;
const Bubble = links ? 'a' : 'span';

// A mood that is only a link reads as its host and path, like the feed.
const shorten = (text: string): string => {
  if (!/^https?:\/\/\S+$/.test(text)) return text;
  const bare = text.replace(/^https?:\/\/(www\.)?/, '').replace(/[?#].*$/, '');
  return bare.length > 30 ? `${bare.slice(0, 29)}…` : bare;
};
---

<span class="mc">
  {moods.length > 0 ? (
    <span class="mc-thread">
      {channel.avatar ? (
        <img class="mc-avatar" src={channel.avatar} alt="" width="34" height="34" loading="lazy" decoding="async" />
      ) : (
        <span class="mc-avatar" aria-hidden="true">{channel.title.slice(0, 1)}</span>
      )}
      <span class="mc-stream">
        {moods.map((mood, i) => (
          <Bubble class="mc-bubble" href={links ? mood.href : undefined} data-slab>
            <span class="mc-body">
              {i === 0 && <span class="mc-from">{channel.title}</span>}
              <span class="mc-text" lang={mood.lang}>{mood.text ? shorten(mood.text) : 'A photo, no words.'}</span>
              <span class="mc-meta">
                {mood.reactions.map((reaction) => <span class="mc-react">{reaction}</span>)}
                <time class="mc-time" datetime={mood.datetime}>{mood.date}</time>
              </span>
            </span>
            {mood.thumb && (
              <img class="mc-thumb" src={mood.thumb.src} srcset={mood.thumb.srcset} sizes="48px" alt="" width="48" height="48" loading="lazy" decoding="async" />
            )}
          </Bubble>
        ))}
      </span>
    </span>
  ) : (
    <span class="mc-empty">
      The channel didn't load just now.
      {links && <a href="/mood">Read it on the mood page</a>}
    </span>
  )}
</span>

<style>
  .mc {
    display: block;
    width: 100%;
    max-width: 340px;
    font-family: var(--d-sans);
    font-size: 15px;
    line-height: 1.45;
    text-align: left;
    color: var(--d-ink);
  }

  .mc-thread {
    display: flex;
    align-items: flex-end;
    gap: 8px;
  }

  .mc-avatar {
    display: grid;
    flex: none;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--d-bubble);
    color: var(--d-note);
    font-size: 13px;
    font-weight: 600;
    object-fit: cover;
    box-shadow: 0 0 0 1px var(--d-line);
  }

  .mc-stream {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
  }

  /* One sender, grouped the iOS way: the corners facing the avatar close up
     between bubbles, and only the last one is tucked. */
  .mc-bubble {
    display: flex;
    max-width: 100%;
    gap: 10px;
    padding: 8px 11px 7px;
    border-radius: 6px 18px 18px 6px;
    background: var(--d-bubble);
    color: inherit;
    text-decoration: none;
    transition: background-color 150ms ease;
  }

  .mc-bubble:first-child {
    border-top-left-radius: 18px;
  }

  .mc-bubble:last-child {
    border-bottom-left-radius: 4px;
  }

  a.mc-bubble:hover {
    background: var(--d-bubble-hover);
  }

  /* Painted: the slab is the bubble, a little bigger than the text it holds,
     and it shifts under the pointer the way the prose chips do. */
  .mc-bubble.has-swatch {
    position: relative;
    isolation: isolate;
    background: none;
  }

  .mc-bubble.has-swatch::before {
    content: '';
    position: absolute;
    inset: -4px -6px;
    z-index: -1;
    background: var(--swatch) center / 100% 100% no-repeat;
    filter: drop-shadow(0 1px 1.5px oklch(0.3 0.03 50 / 0.12));
    transition:
      rotate 0.3s var(--d-ease),
      scale 0.3s var(--d-ease);
  }

  @media (hover: hover) {
    a.mc-bubble.has-swatch:hover::before {
      rotate: -0.6deg;
      scale: 1.015 1.04;
    }
  }

  a.mc-bubble:focus-visible {
    outline: 2px solid var(--d-focus);
    outline-offset: 2px;
  }

  .mc-body {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .mc-from {
    margin-bottom: 1px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--d-ink);
  }

  .mc-text {
    display: -webkit-box;
    overflow: hidden;
    overflow-wrap: anywhere;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .mc-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
    margin-top: 4px;
    font-size: 12.5px;
    color: var(--d-note);
  }

  .mc-react {
    padding: 0 6px;
    border-radius: 999px;
    background: var(--d-react);
    font-variant-numeric: tabular-nums;
    line-height: 18px;
    color: var(--d-note);
  }

  .mc-time {
    margin-left: 2px;
    font-variant-numeric: tabular-nums;
  }

  .mc-thumb {
    flex: none;
    align-self: center;
    width: 48px;
    height: 48px;
    border-radius: 9px;
    object-fit: cover;
    box-shadow: 0 0 0 1px var(--d-line);
  }

  .mc-empty {
    color: var(--d-note);
  }

  .mc-empty a {
    color: var(--d-ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
