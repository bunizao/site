---
// A loose hand of project cards, fanned from the middle, the outer ones lower
// and turned further: the projects hover card from home, as a still object.
// The live deck opens in the projects window.
import { projects } from '@/data/site';

const fan = (i: number) => {
  const t = projects.length > 1 ? (i / (projects.length - 1)) * 2 - 1 : 0;
  return `--i: ${i}; --fx: ${Math.round(t * 96)}px; --fy: ${Math.round(Math.abs(t) * 14)}px; --fr: ${(t * 9).toFixed(1)}deg`;
};

// "TutuBetterRules" may break as "TutuBetter / Rules" on a narrow card.
const camelBreaks = (name: string): string => name.replace(/([a-z])([A-Z])/g, '$1<wbr>$2');
---

<span class="pj">
  {projects.map((project, i) => (
    <span class="pj-card" style={fan(i)}>
      <span class="pj-name" set:html={camelBreaks(project.name)} />
      <span class="pj-stars">{project.stars !== null ? `★ ${project.stars}` : 'Suite'}</span>
    </span>
  ))}
</span>

<style>
  .pj {
    position: relative;
    display: block;
    width: 340px;
    height: 170px;
    font-family: var(--d-sans);
  }

  .pj-card {
    position: absolute;
    bottom: 18px;
    left: 50%;
    z-index: var(--i);
    display: flex;
    flex-direction: column;
    width: 116px;
    height: 132px;
    padding: 12px;
    border-radius: 12px;
    background: var(--d-paper);
    box-shadow: var(--d-paper-shadow);
    color: var(--d-ink);
    text-align: left;
    transform-origin: 50% 130%;
    transform: translate(calc(-50% + var(--fx)), var(--fy)) rotate(var(--fr));
    transition: transform 320ms var(--d-ease);
  }

  .pj-name {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .pj-stars {
    margin-top: auto;
    font-size: 11.5px;
    font-variant-numeric: tabular-nums;
    color: var(--d-faint);
  }
</style>
