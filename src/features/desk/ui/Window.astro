---
// A floating window on the desk. Rendered hidden; the desk script opens it out
// of whatever was clicked, drags it by its mat, and closes it on Esc.
// Non-modal on desktop (the page stays live behind it), a modal sheet on
// phones. A `bare` window has no inner card: the object in it brings its own
// surface, the way the project deck and the contents page do.
interface Props {
  id: string;
  title: string;
  /** Max width in px; the window never exceeds the viewport minus 32px. */
  width?: number;
  /** The full page this window summarises. */
  href?: string;
  hrefLabel?: string;
  bare?: boolean;
}

const { id, title, width = 480, href, hrefLabel = 'open page', bare = false } = Astro.props;
const titleId = `win-${id}-title`;
---

<section
  class:list={['win', { 'win--bare': bare }]}
  id={`win-${id}`}
  data-win={id}
  role="dialog"
  aria-labelledby={titleId}
  tabindex="-1"
  hidden
  style={`--win-w: ${width}px`}
>
  <div class="win-mat" data-win-drag>
    <header class="win-bar">
      <h2 class="win-title" id={titleId}>{title}</h2>
      {href && (
        <a class="win-link" href={href}>
          {hrefLabel}
          <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 8.5 8.5 3.5M4.5 3.5h4v4" /></svg>
        </a>
      )}
      <button class="win-close" type="button" data-win-close aria-label={`Close ${title}`}>
        <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M2.5 2.5 9.5 9.5M9.5 2.5 2.5 9.5" /></svg>
      </button>
    </header>
    <div class="win-card" data-win-body>
      <slot />
    </div>
  </div>
</section>
