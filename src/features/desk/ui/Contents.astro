---
// The blog as a page of contents, corner turned down: the write hover card
// from home. `links` makes each row a link (in the window); without it the
// page is a still object inside a frame that is already a button.
import { blog } from '@/data/site';
import type { DeskPost } from '@/features/desk/server/content';

interface Props {
  posts: DeskPost[];
  total: number;
  links?: boolean;
}

const { posts, total, links = false } = Astro.props;
const copy = blog.copy[blog.locale.home];
const Row = links ? 'a' : 'span';
---

<span class="wr">
  <span class="wr-page">
    <span class="wr-head">
      <span class="wr-mark"><img src={blog.mark} alt="" width="28" height="28" loading="lazy" decoding="async" /></span>
      <span class="wr-id" lang={blog.locale.home}>
        <span class="wr-name">{copy.name}</span>
        <span class="wr-tagline">{copy.tagline}</span>
      </span>
    </span>
    {posts.length > 0 ? (
      <ol class="wr-toc">
        {posts.map((post, i) => (
          <li>
            <Row class="wr-row" href={links ? post.href : undefined}>
              <span class="wr-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="wr-title" lang={post.lang}>{post.title}</span>
              <span class="wr-leader" aria-hidden="true"></span>
              <span class="wr-date">{post.date}</span>
            </Row>
          </li>
        ))}
      </ol>
    ) : (
      <span class="wr-empty">
        The posts didn't load just now.
        {links && <a href="/blog">Read them on the blog</a>}
      </span>
    )}
    {total > 0 && <span class="wr-count">{total} posts in all</span>}
  </span>
  <span class="wr-fold" aria-hidden="true"></span>
</span>

<style>
  /* The drop shadow follows the turned-down corner, because the corner is
     cut from the page and the filter sits on the whole object. */
  .wr {
    position: relative;
    display: block;
    width: 320px;
    font-family: var(--d-sans);
    font-size: 13px;
    line-height: 1.4;
    color: var(--d-note);
    text-align: left;
    filter: drop-shadow(0 0 0.5px oklch(0 0 0 / 0.28)) drop-shadow(0 12px 20px oklch(0 0 0 / 0.1));
  }

  :global(html.dark) .wr {
    filter: drop-shadow(0 0 0.5px oklch(1 0 0 / 0.35)) drop-shadow(0 16px 26px oklch(0 0 0 / 0.55));
  }

  .wr-page {
    display: block;
    padding: 16px;
    border-radius: 14px;
    background: var(--d-paper);
    mask: linear-gradient(225deg, transparent 15px, #000 15px);
  }

  .wr-fold {
    position: absolute;
    top: 0;
    right: 0;
    width: 21px;
    height: 21px;
    border-bottom-left-radius: 4px;
    background: linear-gradient(45deg, color-mix(in oklab, var(--d-ink) 11%, var(--d-paper)) 50%, transparent 50%);
  }

  .wr-head {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding-right: 12px;
  }

  .wr-mark {
    display: grid;
    flex: none;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--d-paper);
    box-shadow: 0 0 0 1px var(--d-line);
  }

  .wr-mark img {
    width: 28px;
    height: 28px;
    object-fit: contain;
  }

  :global(html.dark) .wr-mark img {
    filter: invert(1);
  }

  .wr-id {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 2px;
  }

  .wr-name {
    font-size: 15px;
    font-weight: 600;
    color: var(--d-ink);
  }

  .wr-tagline {
    font-size: 12px;
    color: var(--d-faint);
  }

  .wr-toc {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 14px -8px 0;
    padding: 0;
    list-style: none;
  }

  .wr-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 6px 8px;
    border-radius: 8px;
    color: inherit;
    text-decoration: none;
    transition: background-color 150ms ease;
  }

  a.wr-row:hover {
    background: var(--d-hover);
  }

  a.wr-row:focus-visible {
    outline: 2px solid var(--d-focus);
    outline-offset: -2px;
  }

  .wr-num {
    flex: none;
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    color: var(--d-faint);
  }

  .wr-title {
    min-width: 0;
    overflow: hidden;
    color: var(--d-ink);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* The dotted leader of a printed contents page. */
  .wr-leader {
    flex: 1 0 12px;
    align-self: center;
    height: 2px;
    margin-top: 0.3em;
    background: radial-gradient(circle, color-mix(in oklab, var(--d-ink) 30%, transparent) 0.7px, transparent 1px) 0 50% / 4px 2px repeat-x;
  }

  .wr-date {
    flex: none;
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    color: var(--d-faint);
  }

  .wr-empty {
    display: block;
    margin-top: 14px;
  }

  .wr-empty a {
    color: var(--d-ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* The folio at the foot of the page. */
  .wr-count {
    display: block;
    margin-top: 8px;
    font-size: 11px;
    text-align: right;
    color: var(--d-faint);
  }
</style>
