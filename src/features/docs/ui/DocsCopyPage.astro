---
// Linear-style split control: the left half copies the page's Markdown, the
// chevron opens the same action plus a link to the raw `/index.md` URL. Both
// read the one path the layout already advertises as `rel="alternate"`, so the
// button never points somewhere the Markdown route does not answer.
interface Props {
  markdownPath: string;
}
const { markdownPath } = Astro.props as Props;
---

<div class="docs-copy-page" data-docs-page-copy>
  <button
    class="docs-copy-page-action"
    type="button"
    data-page-copy-trigger
    data-markdown-url={markdownPath}
  >
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="9" y="9" width="11" height="11" rx="2" />
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
    </svg>
    <span data-page-copy-label>Copy page</span>
  </button>

  <button
    class="docs-copy-page-toggle"
    type="button"
    aria-haspopup="true"
    aria-expanded="false"
    aria-label="More page formats"
    data-page-copy-toggle
  >
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m6 9 6 6 6-6" />
    </svg>
  </button>

  <div class="docs-copy-page-menu" data-page-copy-menu hidden>
    <button
      class="docs-copy-page-item"
      type="button"
      data-page-copy-trigger
      data-markdown-url={markdownPath}
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="9" y="9" width="11" height="11" rx="2" />
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
      </svg>
      <span class="docs-copy-page-item-text">
        <span class="docs-copy-page-item-title" data-page-copy-label>Copy page</span>
        <span class="docs-copy-page-item-note">Copy page as Markdown for LLMs</span>
      </span>
    </button>

    <a class="docs-copy-page-item" href={markdownPath} target="_blank" rel="noopener">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="4" width="18" height="16" rx="2" />
        <path d="M7 15V9l2.5 3L12 9v6M15.5 9v6h2.5" />
      </svg>
      <span class="docs-copy-page-item-text">
        <span class="docs-copy-page-item-title">
          View as Markdown
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
        </span>
        <span class="docs-copy-page-item-note">View this page as plain text</span>
      </span>
    </a>
  </div>
</div>

<script>
  const OPEN_ATTR = 'data-open';

  function closeMenus(except?: Element | null) {
    document.querySelectorAll<HTMLElement>(`[data-docs-page-copy][${OPEN_ATTR}]`).forEach((root) => {
      if (root === except) return;
      root.removeAttribute(OPEN_ATTR);
      root.querySelector('[data-page-copy-toggle]')?.setAttribute('aria-expanded', 'false');
      root.querySelector<HTMLElement>('[data-page-copy-menu]')?.setAttribute('hidden', '');
    });
  }

  async function copyPage(root: HTMLElement, url: string) {
    // The Markdown route is the same content the page renders from, so fetching
    // it beats scraping the DOM back into Markdown.
    const response = await fetch(url, { headers: { accept: 'text/markdown' } });
    if (!response.ok) throw new Error(`Markdown request failed: ${response.status}`);
    await navigator.clipboard.writeText(await response.text());

    if (root.dataset.copied) return;
    root.dataset.copied = 'true';
    const labels = root.querySelectorAll<HTMLElement>('[data-page-copy-label]');
    labels.forEach((label) => { label.textContent = 'Copied'; });
    setTimeout(() => {
      labels.forEach((label) => { label.textContent = 'Copy page'; });
      delete root.dataset.copied;
    }, 1600);
  }

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    const root = target?.closest<HTMLElement>('[data-docs-page-copy]');
    if (!root) {
      closeMenus();
      return;
    }

    const toggle = target?.closest('[data-page-copy-toggle]');
    if (toggle) {
      const open = root.toggleAttribute(OPEN_ATTR);
      toggle.setAttribute('aria-expanded', String(open));
      const menu = root.querySelector<HTMLElement>('[data-page-copy-menu]');
      if (open) menu?.removeAttribute('hidden');
      else menu?.setAttribute('hidden', '');
      closeMenus(root);
      return;
    }

    const trigger = target?.closest<HTMLElement>('[data-page-copy-trigger]');
    if (!trigger) return;
    closeMenus();
    void copyPage(root, trigger.dataset.markdownUrl ?? '').catch(() => {
      const labels = root.querySelectorAll<HTMLElement>('[data-page-copy-label]');
      labels.forEach((label) => { label.textContent = 'Copy failed'; });
      setTimeout(() => {
        labels.forEach((label) => { label.textContent = 'Copy page'; });
      }, 1600);
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenus();
  });
</script>
