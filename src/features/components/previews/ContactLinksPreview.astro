---
// Self-contained specimen of the blog's ContactPanel rows — each platform link
// lights up in its own brand colour on hover (GitHub inverts, Telegram goes
// sky, Instagram blooms its gradient, Email goes Gmail-red), and the open-in-new
// arrow slides in. Invented handles, real brand icons, no live profile data.
import { GitHubIcon, InstagramIcon } from '@/components/icons/brand';
import { Mail, Send } from 'lucide-react';

const rows = [
  { name: 'GitHub', handle: '@bunizao', Icon: GitHubIcon },
  { name: 'Email', handle: 'me@buxx.me', Icon: Mail },
  { name: 'Telegram', handle: 'tuu.cat/tg', Icon: Send },
  { name: 'Instagram', handle: 'tuu.cat/ig', Icon: InstagramIcon },
];
---

<div class="contactspec">
  <p class="contactspec-eyebrow">Also here</p>
  <ul class="contactspec-list">
    {rows.map((row) => (
      <li>
        <a class="contactspec-row" href="#" data-channel={row.name} onclick="return false">
          <span class="contactspec-chip" aria-hidden="true">
            <row.Icon />
          </span>
          <span class="contactspec-body">
            <span class="contactspec-name">{row.name}</span>
            <span class="contactspec-handle">{row.handle}</span>
          </span>
          <svg class="contactspec-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17 17 7M9 7h8v8" />
          </svg>
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .contactspec {
    width: min(20rem, 100%);
    padding: 0.5rem;
  }

  .contactspec-eyebrow {
    margin: 0.25rem 0.5rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground) / 0.72);
  }

  .contactspec-list {
    display: flex;
    flex-direction: column;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contactspec-row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 9px 10px;
    border-radius: 9px;
    color: inherit;
    text-decoration: none;
    transition: background 0.14s ease;
  }

  .contactspec-row:hover {
    background: hsl(var(--foreground) / 0.05);
  }

  /* Concentric: 9px row radius, 34px chip at 10px radius. */
  .contactspec-chip {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: hsl(var(--foreground) / 0.05);
    color: hsl(var(--muted-foreground));
    transition: color 0.15s ease, background 0.15s ease;
  }

  .contactspec-chip :global(svg) {
    width: 17px;
    height: 17px;
  }

  .contactspec-body {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .contactspec-name {
    font-size: 13.5px;
    font-weight: 500;
    line-height: 1.3;
    color: hsl(var(--foreground));
  }

  .contactspec-handle {
    font-family: var(--font-mono);
    font-size: 11.5px;
    line-height: 1.3;
    color: hsl(var(--muted-foreground));
  }

  /* Slides in from -2px on hover, per the real panel. */
  .contactspec-arrow {
    flex: none;
    width: 15px;
    height: 15px;
    margin-left: auto;
    color: hsl(var(--muted-foreground));
    opacity: 0;
    transform: translate(-2px, 2px);
    transition: opacity 0.14s ease, transform 0.14s ease, color 0.14s ease;
  }

  .contactspec-row:hover .contactspec-arrow {
    opacity: 1;
    transform: none;
  }

  /* ── Per-platform brand hover ─────────────────────────────────────────── */

  /* GitHub: invertocat — black chip / white glyph, inverted in dark. */
  .contactspec-row[data-channel='GitHub']:hover .contactspec-chip {
    background: #181717;
    color: #fff;
  }
  :global(.dark) .contactspec-row[data-channel='GitHub']:hover .contactspec-chip {
    background: #fff;
    color: #181717;
  }

  /* Telegram: white plane on the brand blue gradient. */
  .contactspec-row[data-channel='Telegram']:hover .contactspec-chip {
    color: #fff;
    background: linear-gradient(180deg, #2aabee 0%, #229ed9 100%);
  }
  .contactspec-row[data-channel='Telegram']:hover .contactspec-arrow {
    color: #26a5e4;
  }

  /* Instagram: corner-to-corner brand gradient, white glyph. */
  .contactspec-row[data-channel='Instagram']:hover .contactspec-chip {
    color: #fff;
    background-image: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
  }
  .contactspec-row[data-channel='Instagram']:hover .contactspec-arrow {
    color: #dc2743;
  }

  /* Email: solid Gmail red chip. */
  .contactspec-row[data-channel='Email']:hover .contactspec-chip {
    color: #fff;
    background: #ea4335;
  }
  .contactspec-row[data-channel='Email']:hover .contactspec-arrow {
    color: #ea4335;
  }
</style>
