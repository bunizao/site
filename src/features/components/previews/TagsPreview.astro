---
// Self-contained specimen of the blog's tag surfaces. Two idioms in one tile:
//   1) the quiet flex-wrap chips shown on post pages (.blog-tag)
//   2) the accent glass cards from the /blog/tags/ marquee — per-tag accent
//      colour tints the icon tile, name, and hover border/halo.
// Invented tags + counts, no live posts. Accent is per-row inline --tag-accent.
const chips = ['edge', 'motion', 'typography', 'systems', 'astro', 'webgl', 'ideas'];

const cards = [
  { name: 'Craft', count: 12, accent: '#d08a4a', posts: ['Small APIs age better', 'The last ten percent'] },
  { name: 'Motion', count: 8, accent: '#7d5cff', posts: ['A dial you can feel', 'Interruptible by default'] },
];
---

<div class="tagspec">
  <ul class="tagspec-chips" aria-label="Tags">
    {chips.map((tag) => (
      <li><a class="tagspec-chip" href="#" onclick="return false">{tag}</a></li>
    ))}
  </ul>

  <div class="tagspec-cards">
    {cards.map((card) => (
      <article class="tagspec-card" style={`--tag-accent:${card.accent}`}>
        <a class="tagspec-card-head" href="#" onclick="return false">
          <span class="tagspec-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l7 7a2 2 0 0 0 2.828 0l7-7a2 2 0 0 0 0-2.828z" />
              <circle cx="7.5" cy="7.5" r=".5" fill="currentColor" />
            </svg>
          </span>
          <span class="tagspec-card-info">
            <span class="tagspec-card-name">{card.name}</span>
            <span class="tagspec-card-count">{card.count} posts</span>
          </span>
        </a>
        <div class="tagspec-card-posts">
          {card.posts.map((post) => (
            <a class="tagspec-post" href="#" onclick="return false">
              <span class="tagspec-post-title">{post}</span>
            </a>
          ))}
        </div>
      </article>
    ))}
  </div>
</div>

<style>
  .tagspec {
    width: 100%;
    display: grid;
    gap: 1.25rem;
  }

  /* ── Quiet chips ──────────────────────────────────────────────────────── */
  .tagspec-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tagspec-chip {
    display: inline-flex;
    font-size: 12.5px;
    line-height: 1;
    padding: 6px 11px;
    border-radius: 999px;
    color: hsl(var(--muted-foreground));
    background: hsl(var(--foreground) / 0.05);
    text-decoration: none;
    transition: color 0.16s ease, background-color 0.16s ease;
  }

  .tagspec-chip:hover {
    color: hsl(var(--foreground));
    background: hsl(var(--foreground) / 0.09);
  }

  /* ── Accent glass cards ───────────────────────────────────────────────── */
  .tagspec-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 0.85rem;
  }

  .tagspec-card {
    --tag-color: var(--tag-accent);
    border-radius: 16px;
    overflow: hidden;
    background: hsl(var(--foreground) / 0.03);
    border: 1px solid color-mix(in srgb, var(--tag-color) 22%, hsl(var(--foreground) / 0.1));
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .tagspec-card:hover {
    border-color: var(--tag-color);
    box-shadow: 0 12px 34px color-mix(in srgb, var(--tag-color) 16%, transparent);
  }

  .tagspec-card-head {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 15px 15px 12px;
    color: inherit;
    text-decoration: none;
  }

  /* Concentric-ish: 12px tile inside the 15px-padded 16px card. */
  .tagspec-card-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: 12px;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--tag-color) 16%, hsl(var(--background))),
      color-mix(in srgb, var(--tag-color) 7%, hsl(var(--background)))
    );
    border: 1px solid color-mix(in srgb, var(--tag-color) 22%, transparent);
  }

  .tagspec-card-icon svg {
    width: 21px;
    height: 21px;
    color: var(--tag-color);
  }

  .tagspec-card-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .tagspec-card-name {
    font-size: 16px;
    font-weight: 640;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: hsl(var(--foreground));
    transition: color 0.2s ease;
  }

  .tagspec-card:hover .tagspec-card-name {
    color: var(--tag-color);
  }

  .tagspec-card-count {
    font-size: 12.5px;
    font-weight: 500;
    color: hsl(var(--muted-foreground));
    font-variant-numeric: tabular-nums;
  }

  .tagspec-card-posts {
    border-top: 1px solid hsl(var(--foreground) / 0.08);
  }

  .tagspec-post {
    display: flex;
    align-items: center;
    height: 40px;
    padding: 0 15px;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid hsl(var(--foreground) / 0.06);
    transition: background 0.15s ease;
  }

  .tagspec-post:last-child {
    border-bottom: none;
  }

  .tagspec-post:hover {
    background: color-mix(in srgb, var(--tag-color) 6%, transparent);
  }

  .tagspec-post-title {
    font-size: 13.5px;
    font-weight: 500;
    color: hsl(var(--foreground) / 0.78);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.15s ease;
  }

  .tagspec-post:hover .tagspec-post-title {
    color: var(--tag-color);
  }
</style>
