---
// Gallery tile specimen. Short on purpose: the tile has to read at a glance, so
// this shows a run collapsing under one name, the squared notch on a run's last
// bubble, and a custom accent — and nothing else. This same specimen is the
// Preview on /components/conversation, whose playground exercises the full
// syntax.
import Conversation from '@/features/content/ui/Conversation.astro';

const source = [
  '@ada accent=#4E7A5E',
  '',
  'you: how wide should a bubble be?',
  'ada: 30em.',
  'ada: A CJK glyph is 1em and a Latin glyph about half that, so one number',
  '  lands on ~30 Chinese characters and ~60 Latin ones.',
  '--- ',
  'you: ship it',
].join('\n');
---

<div class="convpreview">
  <Conversation source={source} />
</div>

<style>
  .convpreview {
    width: 100%;
    max-width: 42rem;
    margin: 0 auto;
    padding: 1.5rem 2rem;
  }

  /* The tile has no article chrome around it, so the component's own top and
     bottom margin would only push the thread off-centre. */
  .convpreview :global(.conv) {
    margin: 0;
  }
</style>
