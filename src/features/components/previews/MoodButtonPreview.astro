---
const actions = [
  {
    label: '3 new moods',
    title: 'Show three new moods',
    icon: '<path d="M3 12a9 9 0 0 1 15-6.7L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-15 6.7L3 16"></path><path d="M3 21v-5h5"></path>',
  },
  {
    label: 'Refresh',
    title: 'Refresh moods',
    icon: '<path d="M20 6 9 17l-5-5"></path>',
  },
  {
    label: 'Up to date',
    title: 'Moods are up to date',
    icon: '<circle cx="12" cy="12" r="9"></circle><path d="m8.5 12 2.3 2.3 4.7-5"></path>',
  },
];
---

<div class="updbtn">
  {
    actions.map((action) => (
      <button type="button" class="header-action-btn" aria-label={action.title}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <Fragment set:html={action.icon} />
        </svg>
        <span class="header-action-btn-label">{action.label}</span>
      </button>
    ))
  }
</div>

<style>
  .updbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    height: 100%;
    font-family: var(--font-sans);
  }

  .header-action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    height: 34px;
    min-width: 34px;
    padding: 0 9px;
    overflow: hidden;
    border: 1px solid hsl(var(--foreground) / 0.08);
    border-radius: 9px;
    color: hsl(var(--muted-foreground));
    background: hsl(var(--background) / 0.8);
    backdrop-filter: blur(8px);
    cursor: pointer;
    transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease, gap 0.2s ease;
  }

  .header-action-btn:hover,
  .header-action-btn:focus-visible {
    gap: 6px;
    color: hsl(var(--foreground));
    background: hsl(var(--foreground) / 0.05);
    border-color: hsl(var(--foreground) / 0.15);
  }

  .header-action-btn:active {
    transform: scale(0.96);
  }

  .header-action-btn-label {
    display: inline-block;
    max-width: 0;
    overflow: hidden;
    opacity: 0;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: max-width 0.2s ease, opacity 0.2s ease;
  }

  .header-action-btn:hover .header-action-btn-label,
  .header-action-btn:focus-visible .header-action-btn-label {
    max-width: 8rem;
    opacity: 1;
  }

  .header-action-btn svg {
    width: 15px;
    height: 15px;
    flex: none;
  }

</style>
