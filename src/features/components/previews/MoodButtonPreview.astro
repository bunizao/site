---
const actions = [
  {
    label: 'Notify',
    title: 'Subscribe to notifications',
    icon: '<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>',
  },
  {
    label: 'RSS',
    title: 'Subscribe to RSS feed',
    icon: '<path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle>',
  },
  {
    label: 'Telegram',
    title: 'View on Telegram',
    icon: '<path d="m22 2-7 20-4-9-9-4Z"></path><path d="M22 2 11 13"></path>',
  },
];
---

<div class="updbtn" data-updbtn>
  {
    actions.map((action) => (
      <button type="button" class="updbtn-action" data-updbtn-action aria-label={action.title}>
        <span class="updbtn-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <Fragment set:html={action.icon} />
          </svg>
        </span>
        <span class="updbtn-label">{action.label}</span>
      </button>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-updbtn]').forEach((root) => {
    if (root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    root.querySelectorAll<HTMLElement>('[data-updbtn-action]').forEach((button) => {
      const open = () => button.classList.add('is-hovered');
      const close = () => button.classList.remove('is-hovered');

      button.addEventListener('pointerenter', open);
      button.addEventListener('pointerleave', close);
      button.addEventListener('focus', open);
      button.addEventListener('blur', close);
    });
  });
</script>

<style>
  .updbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    height: 100%;
    font-family: var(--font-sans);
  }

  .updbtn-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    width: 32px;
    height: 32px;
    min-width: 32px;
    padding: 0;
    font: inherit;
    font-size: 11px;
    font-weight: 450;
    letter-spacing: 0.01em;
    color: hsl(var(--muted-foreground));
    background: hsl(var(--background) / 0.8);
    border: 1px solid hsl(var(--foreground) / 0.08);
    border-radius: 8px;
    cursor: pointer;
    overflow: hidden;
    backdrop-filter: blur(8px);
    transition:
      width 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      padding 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      gap 0.2s ease,
      color 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .updbtn-action.is-hovered {
    width: var(--expanded-width, 76px);
    gap: 6px;
    padding-inline: 10px;
    color: hsl(var(--foreground));
    background: hsl(var(--foreground) / 0.05);
    border-color: hsl(var(--foreground) / 0.15);
  }

  .updbtn-action:last-child.is-hovered {
    --expanded-width: 104px;
  }

  .updbtn-action:active {
    scale: 0.96;
  }

  .updbtn-action:focus-visible {
    outline: 2px solid hsl(var(--foreground) / 0.35);
    outline-offset: 2px;
  }

  .updbtn-icon {
    display: inline-flex;
    flex: none;
  }

  .updbtn-icon svg {
    width: 14px;
    height: 14px;
  }

  .updbtn-label {
    display: inline-block;
    max-width: 0;
    overflow: hidden;
    opacity: 0;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
    transition: max-width 0.25s ease 0.05s, opacity 0.2s ease 0.08s;
  }

  .updbtn-action.is-hovered .updbtn-label {
    max-width: 5rem;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .updbtn-action,
    .updbtn-label {
      transition: none;
    }
  }
</style>
