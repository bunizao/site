---
import { ChevronDown } from 'lucide-react';
import type { ComponentApiReference } from '@/features/components/data/api-reference';

interface Props {
  groups: ComponentApiReference[];
}

const { groups } = Astro.props;
---

<div class="api-reference">
  {groups.map((group) => (
    <section class="api-group" aria-labelledby={`api-${group.name.replace(/[^a-z0-9]+/gi, '-').toLowerCase()}`}>
      <div class="api-group-head">
        <h3 id={`api-${group.name.replace(/[^a-z0-9]+/gi, '-').toLowerCase()}`}>{group.name}</h3>
        {group.description && <p>{group.description}</p>}
      </div>

      {group.items.length > 0 ? (
        <div class="api-table">
          <div class="api-table-head" aria-hidden="true">
            <span>Name</span>
            <span>Type</span>
          </div>
          {group.items.map((item) => (
            <details class="api-row">
              <summary>
                <code>{item.name}</code>
                <code class="api-type">{item.type}</code>
                <ChevronDown className="api-chevron" aria-hidden="true" />
              </summary>
              <div class="api-row-detail">
                <p>{item.description}</p>
                {item.default && (
                  <p class="api-default">
                    Default: <code>{item.default}</code>
                  </p>
                )}
              </div>
            </details>
          ))}
        </div>
      ) : (
        <p class="api-empty">No component props.</p>
      )}
    </section>
  ))}
</div>
