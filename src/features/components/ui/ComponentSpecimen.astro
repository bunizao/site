---
import type { CollectionEntry } from 'astro:content';
import { Button } from '@/components/ui/button';
import { Badge } from '@/components/ui/badge';
import { Card, CardHeader, CardTitle, CardContent } from '@/components/ui/card';
import { gridToSvg } from '@/features/logos/lib/render';
import { PEEK_BASE } from '@/features/mascot/peek/base';

interface Props {
  entry: CollectionEntry<'components'>;
  index: number;
}
const { entry, index } = Astro.props;
const { title, tagline, install } = entry.data;
const slug = entry.id;

const mascotSvg = gridToSvg(PEEK_BASE.base, PEEK_BASE.width, PEEK_BASE.height, {
  fg: 'currentColor',
  accent: PEEK_BASE.accent,
  className: 'specimen-mascot',
});
---

<a
  class="specimen"
  href={`/components/${slug}`}
  style={`--i:${index}`}
  data-specimen
  aria-label={`${title} — ${tagline}`}
>
  <div class="specimen-stage">
    {slug === 'button' && <Button variant="outline" size="sm">Button</Button>}
    {slug === 'badge' && <Badge variant="secondary">Badge</Badge>}
    {slug === 'card' && (
      <div class="specimen-card">
        <Card>
          <CardHeader>
            <CardTitle>Card</CardTitle>
          </CardHeader>
          <CardContent>A surface.</CardContent>
        </Card>
      </div>
    )}
    {slug === 'decode-text' && (
      <span class="specimen-decode" aria-hidden="true">
        <span>D</span><span>3</span><span>c</span><span>0</span><span>d</span><span>#</span>
      </span>
    )}
    {slug === 'mascot' && <span class="specimen-mascot-wrap" set:html={mascotSvg} />}
    {slug === 'mood-wheel' && (
      <svg class="specimen-wheel" viewBox="0 0 60 90" aria-hidden="true">
        <path d="M4 6 A 44 44 0 0 1 4 84" fill="none" stroke="currentColor" stroke-opacity="0.28" stroke-width="1.5" />
        {[18, 32, 45, 58, 72].map((y, i) => (
          <line x1="4" y1={y} x2={i === 2 ? 20 : 12} y2={y} stroke="currentColor" stroke-opacity={i === 2 ? '1' : '0.4'} stroke-width={i === 2 ? '2' : '1'} />
        ))}
      </svg>
    )}
  </div>

  <div class="specimen-caption">
    <span class="specimen-name">
      {slug}
      <span class="specimen-tagline">{tagline}</span>
    </span>
    <span class:list={['install-marker', `install-marker--${install.type}`]}>
      {install.type === 'npm' ? 'npm' : 'registry'}
    </span>
  </div>
</a>

<style>
  .specimen-card {
    transform: scale(0.82);
    width: 100%;
    max-width: 15rem;
  }

  .specimen-decode {
    display: inline-flex;
    gap: 0.1em;
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: hsl(var(--foreground));
  }

  .specimen-decode span:nth-child(even) {
    color: hsl(var(--muted-foreground) / 0.55);
  }

  .specimen-mascot-wrap :global(svg),
  .specimen-mascot-wrap {
    width: 4.5rem;
    height: auto;
    color: hsl(var(--foreground));
  }

  .specimen-wheel {
    width: 3.5rem;
    height: 5.25rem;
    color: hsl(var(--foreground));
  }
</style>
