---
import { Code } from 'astro:components';
import { Check, Copy } from 'lucide-react';
import { bundledLanguages, bundledLanguagesAlias } from 'shiki/langs';
import { bundledThemes } from 'shiki/themes';
import { codeLanguageLabel, codeLanguageLogo } from '@/lib/code-language';
import '../../../styles/code-box.css';

// Astro's fine-grained Code highlighter only bundles themes it sees by name in
// markdown config, so github-light isn't resolvable as a string here. Load the
// theme objects from shiki's bundle and pass them directly.
const [githubLight, githubDark] = await Promise.all([
  bundledThemes['github-light']().then((m) => m.default),
  bundledThemes['github-dark']().then((m) => m.default),
]);

// Framed, syntax-highlighted code box in the shadcn register. A header bar
// carries a language logo + label and a copy button; the body is Shiki-
// highlighted with dual themes (github-light / github-dark) driven off the
// site's `html.dark` class — one render styles both, no JS for the colors.
interface Props {
  code: string;
  lang?: string;
}
const { code, lang = 'text' } = Astro.props;
const highlightLang = lang in bundledLanguages || lang in bundledLanguagesAlias ? lang : 'text';

const label = codeLanguageLabel(lang);
const logo = codeLanguageLogo(lang);
---

<figure class="code-box">
  <figcaption class="code-box-head">
    <span class="code-box-lang">
      <svg
        class="code-box-logo"
        viewBox={logo.viewBox ?? '0 0 24 24'}
        fill={logo.stroke ? 'none' : 'currentColor'}
        stroke={logo.stroke ? 'currentColor' : undefined}
        stroke-width={logo.stroke ? 1.7 : undefined}
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d={logo.path} />
      </svg>
      {label}
    </span>
    <button type="button" class="copy-btn" data-code-copy aria-label="Copy code">
      <span class="copy-btn-icons" aria-hidden="true">
        <Copy className="copy-btn-icon copy-btn-icon--copy" />
        <Check className="copy-btn-icon copy-btn-icon--check" />
      </span>
      <span class="copy-btn-tip" role="status">Copied</span>
    </button>
  </figcaption>
  <div class="code-box-body">
    <Code
      code={code}
      lang={highlightLang as any}
      themes={{ light: githubLight, dark: githubDark }}
      defaultColor={false}
    />
  </div>
  <textarea class="code-box-source" hidden aria-hidden="true" readonly>{code}</textarea>
</figure>

<script>
  // Copy the raw source (held in a hidden textarea so we ship the exact text,
  // not the tokenized DOM). Icon crossfades via [data-copied] on the button.
  document.querySelectorAll<HTMLButtonElement>('[data-code-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const box = btn.closest('.code-box');
      const src = box?.querySelector<HTMLTextAreaElement>('.code-box-source')?.value ?? '';
      try {
        await navigator.clipboard.writeText(src);
      } catch {
        return;
      }
      btn.dataset.copied = '';
      window.setTimeout(() => delete btn.dataset.copied, 1600);
    });
  });
</script>
