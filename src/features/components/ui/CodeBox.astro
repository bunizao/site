---
import { Code } from 'astro:components';
import { Check, Copy } from 'lucide-react';
import { bundledLanguagesAlias } from 'shiki/langs';
import { bundledThemes } from 'shiki/themes';
import '../../../styles/code-box.css';

// Astro's fine-grained Code highlighter only bundles themes it sees by name in
// markdown config, so github-light isn't resolvable as a string here. Load the
// theme objects from shiki's bundle and pass them directly.
const [githubLight, githubDark] = await Promise.all([
  bundledThemes['github-light']().then((m) => m.default),
  bundledThemes['github-dark']().then((m) => m.default),
]);

// Framed, syntax-highlighted code box in the shadcn register. A header bar
// carries a language logo + label and a copy button; the body is Shiki-
// highlighted with dual themes (github-light / github-dark) driven off the
// site's `html.dark` class — one render styles both, no JS for the colors.
interface Props {
  code: string;
  lang?: string;
}
const { code, lang = 'text' } = Astro.props;
const highlightLang = lang in bundledLanguagesAlias ? lang : 'text';

// Map a fence language to a display label + a monochrome brand mark. Marks stay
// `currentColor` so they read in both themes and respect the monochrome
// register; the shape alone is recognizable.
type Logo = { label: string; path: string; viewBox?: string };
const LOGOS: Record<string, Logo> = {
