---
// Shared live-preview dispatcher for /components/[slug] detail pages. The index
// curates tile-sized specimens directly instead of rendering through this view.
// Viewport-coupled previews use iframes; other entries share the page's tokens.
import ComponentPreviewFrame from './ComponentPreviewFrame.astro';
import DecodeTextPreview from '@/features/components/previews/DecodeTextPreview';
import Listening from '@/features/home/ui/Listening.astro';
import { FALLBACK_TRACK } from '@/features/home/server/listening';
import ProjectStack from '@/components/project-cards/ProjectStack';
import GitHubContributions from '@/features/home/ui/GitHubContributions.astro';
import ContactLinksPreview from '@/features/components/previews/ContactLinksPreview.astro';
import ConversationPreview from '@/features/components/previews/ConversationPreview.astro';
import HoverListPreview from '@/features/components/previews/HoverListPreview.astro';
import MoodButtonPreview from '@/features/components/previews/MoodButtonPreview.astro';
import TagsPreview from '@/features/components/previews/TagsPreview.astro';
import { Button } from '@/components/ui/button';
import { Badge } from '@/components/ui/badge';
import { Card, CardHeader, CardTitle, CardContent, CardFooter } from '@/components/ui/card';

interface Props {
  slug: string;
}
const { slug } = Astro.props;

// The listening specimen starts at rest (Recently Played), not live, so the
// tonearm demonstrates its full arc: parked → lifts on hover → drops onto the
// disc on play. The homepage fallback stays "now playing" untouched.
const listeningDemoTrack = { ...FALLBACK_TRACK, isNowPlaying: false };

---

{slug === 'mood-wheel' || slug === 'mobile-reading-bar' ? (
  <ComponentPreviewFrame
    variant="iframe"
    src={slug === 'mood-wheel' ? '/components/preview/mood-wheel' : '/components/preview/mobile-toc'}
    title={slug === 'mood-wheel' ? 'Mood wheel preview' : 'Mobile reading bar preview'}
  />
) : (
  <ComponentPreviewFrame>
    {slug === 'projects-deck' && (
      <div class="preview-projects">
        <ProjectStack client:visible />
      </div>
    )}
    {slug === 'button' && (
      <div class="preview-row">
        <Button>Primary</Button>
        <Button variant="secondary">Secondary</Button>
        <Button variant="outline">Outline</Button>
        <Button variant="ghost">Ghost</Button>
      </div>
    )}
    {slug === 'badge' && (
      <div class="preview-row">
        <Badge>Default</Badge>
        <Badge variant="secondary">Secondary</Badge>
        <Badge variant="outline">Outline</Badge>
        <Badge variant="success">Success</Badge>
      </div>
    )}
    {slug === 'card' && (
      <Card style={{ maxWidth: '22rem' }}>
        <CardHeader>
          <CardTitle>Signal</CardTitle>
        </CardHeader>
        <CardContent>Content sits on the card surface, above a quiet footer.</CardContent>
        <CardFooter>
          <Button size="sm" variant="outline">Action</Button>
        </CardFooter>
      </Card>
    )}
    {slug === 'decode-text' && <DecodeTextPreview client:visible />}
    {slug === 'contact-links' && <ContactLinksPreview />}
    {slug === 'conversation' && <ConversationPreview />}
    {slug === 'tag-cards' && <TagsPreview />}
    {slug === 'github-activity' && (
      <div class="preview-contributions">
        <GitHubContributions demo />
      </div>
    )}
    {slug === 'update-pills' && <MoodButtonPreview />}
    {slug === 'list-hover' && (
      <div class="preview-hover-list">
        <HoverListPreview />
      </div>
    )}
    {slug === 'listening' && (
      <div class="preview-listening">
        <Listening track={listeningDemoTrack} static />
      </div>
    )}
  </ComponentPreviewFrame>
)}
