---
export interface ReadingSection {
  id: string;
  title: string;
}

export interface Props {
  sections: readonly ReadingSection[];
  id?: string;
  label?: string;
  homeHref?: string;
  homeLabel?: string;
  logoSrc?: string;
  logoAlt?: string;
  activeOffset?: number;
}

const {
  sections,
  id = 'mobile-reading-bar',
  label = 'On this page',
  homeHref = '/',
  homeLabel = 'Home',
  logoSrc,
  logoAlt = '',
  activeOffset = 80,
} = Astro.props;
const menuId = `${id}-sections`;
const initialTitle = sections[0]?.title ?? label;
---

<nav
  id={id}
  class="reading-bar"
  aria-label={label}
  data-mobile-reading-bar
  data-section-ids={JSON.stringify(sections.map(({ id: sectionId }) => sectionId))}
  data-active-offset={activeOffset}
>
  <div class="reading-bar-fade" aria-hidden="true"></div>
  <div class="reading-bar-row">
    <div class="reading-bar-start">
      {logoSrc ? (
        <a class="reading-bar-logo" href={homeHref} aria-label={homeLabel}>
          <img src={logoSrc} alt={logoAlt} width="30" height="30" />
        </a>
      ) : null}
    </div>
    <button
      class="reading-bar-title"
      type="button"
      data-reading-bar-toggle
      aria-expanded="false"
      aria-controls={menuId}
      disabled={sections.length === 0}
    >
      <span class="reading-bar-title-text" data-reading-bar-current>{initialTitle}</span>
      <svg
        class="reading-bar-chevron"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m6 9 6 6 6-6"></path>
      </svg>
    </button>
    <button class="reading-bar-totop" type="button" data-reading-bar-totop aria-label="Back to top">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 19V5M5 12l7-7 7 7"></path>
      </svg>
    </button>
  </div>
  <div
    class="reading-bar-menu"
    id={menuId}
    data-reading-bar-panel
    aria-hidden="true"
    inert
  >
    <div class="reading-bar-pill" data-reading-bar-pill aria-hidden="true"></div>
    <ul class="reading-bar-list" data-reading-bar-list>
      {sections.map((section) => (
        <li>
          <a class="reading-bar-link" href={`#${section.id}`} data-reading-bar-item={section.id}>
            {section.title}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  function initializeReadingBars() {
    const bars = document.querySelectorAll<HTMLElement>('[data-mobile-reading-bar]');

    for (const bar of bars) {
      if (bar.dataset.initialized === 'true') continue;
      bar.dataset.initialized = 'true';

      const toggle = bar.querySelector<HTMLButtonElement>('[data-reading-bar-toggle]');
      const panel = bar.querySelector<HTMLElement>('[data-reading-bar-panel]');
      const pill = bar.querySelector<HTMLElement>('[data-reading-bar-pill]');
      const list = bar.querySelector<HTMLElement>('[data-reading-bar-list]');
      const current = bar.querySelector<HTMLElement>('[data-reading-bar-current]');
      const toTop = bar.querySelector<HTMLButtonElement>('[data-reading-bar-totop]');
      const links = Array.from(bar.querySelectorAll<HTMLAnchorElement>('[data-reading-bar-item]'));

      if (!toggle || !panel || !pill || !list || !current || links.length === 0) continue;

      let sectionIds: string[] = [];
      try {
        sectionIds = JSON.parse(bar.dataset.sectionIds ?? '[]') as string[];
      } catch {
        sectionIds = [];
      }

      const headings = sectionIds
        .map((sectionId) => document.getElementById(sectionId))
        .filter((heading): heading is HTMLElement => heading !== null);
      const activeOffset = Number(bar.dataset.activeOffset) || 80;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let open = false;
      let active = 0;
      let animationFrame = 0;

      const movePill = (link: HTMLElement | null) => {
        if (!link) {
          pill.style.opacity = '0';
          return;
        }

        const linkRect = link.getBoundingClientRect();
        const listRect = list.getBoundingClientRect();
        pill.style.opacity = '1';
        pill.style.transform = `translateY(${linkRect.top - listRect.top}px)`;
        pill.style.height = `${linkRect.height}px`;
      };

      const setOpen = (next: boolean) => {
        open = next;
        bar.classList.toggle('is-open', open);
        toggle.setAttribute('aria-expanded', String(open));
        panel.setAttribute('aria-hidden', String(!open));
        panel.toggleAttribute('inert', !open);
        if (open) movePill(links[active] ?? links[0] ?? null);
      };

      const setActive = (next: number) => {
        active = next;
        links.forEach((link, index) => {
          link.classList.toggle('is-active', index === active);
          if (index === active) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
        current.textContent = links[active]?.textContent?.trim() ?? current.textContent;
        if (open) movePill(links[active] ?? null);
      };

      const updateActiveSection = () => {
        animationFrame = 0;
        let next = 0;
        headings.forEach((heading, index) => {
          if (heading.getBoundingClientRect().top <= activeOffset) next = index;
        });
        if (next !== active) setActive(next);
      };

      toggle.addEventListener('click', () => setOpen(!open));
      toTop?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
        setOpen(false);
      });

      links.forEach((link) => {
        link.addEventListener('mouseenter', () => {
          if (open) movePill(link);
        });
        link.addEventListener('click', (event) => {
          const sectionId = link.dataset.readingBarItem;
          const target = sectionId ? document.getElementById(sectionId) : null;
          if (!sectionId || !target) return;

          event.preventDefault();
          target.scrollIntoView({
            behavior: reducedMotion.matches ? 'auto' : 'smooth',
            block: 'start',
          });
          if (window.location.hash !== `#${sectionId}`) {
            window.history.pushState(null, '', `#${sectionId}`);
          }
          setOpen(false);
        });
      });

      list.addEventListener('mouseleave', () => {
        if (open) movePill(links[active] ?? null);
      });
      bar.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !open) return;
        setOpen(false);
        toggle.focus();
      });
      window.addEventListener('resize', () => {
        if (open) movePill(links[active] ?? null);
      });
      window.addEventListener('scroll', () => {
        if (!animationFrame) animationFrame = window.requestAnimationFrame(updateActiveSection);
      }, { passive: true });

      setActive(0);
      updateActiveSection();
    }
  }

  initializeReadingBars();
  document.addEventListener('astro:page-load', initializeReadingBars);
</script>

<style>
  .reading-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 55;
    padding-bottom: 40px;
    color: hsl(var(--foreground, 0 0% 0%));
    font-family: var(--font-sans, ui-sans-serif, system-ui, sans-serif);
    pointer-events: none;
  }

  .reading-bar-fade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      hsl(var(--background, 0 0% 100%) / 0.6),
      hsl(var(--background, 0 0% 100%) / 0.3)
    );
    backdrop-filter: blur(18px) saturate(1.6);
    -webkit-backdrop-filter: blur(18px) saturate(1.6);
    -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 44px), transparent);
    mask-image: linear-gradient(to bottom, #000 calc(100% - 44px), transparent);
  }

  .reading-bar-row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 10px;
    height: 52px;
    padding: 0 14px;
  }

  .reading-bar-start {
    justify-self: start;
    width: 30px;
    height: 30px;
  }

  .reading-bar-logo {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    pointer-events: auto;
  }

  .reading-bar-logo img {
    width: 30px;
    height: 30px;
    object-fit: contain;
  }

  .reading-bar-title {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    justify-self: center;
    max-width: min(58vw, 220px);
    margin: 0;
    padding: 6px;
    border: 0;
    background: none;
    color: hsl(var(--foreground, 0 0% 0%));
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    pointer-events: auto;
  }

  .reading-bar-title:disabled {
    cursor: default;
  }

  .reading-bar-title-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .reading-bar-chevron {
    width: 15px;
    height: 15px;
    flex: none;
    color: hsl(var(--muted-foreground, 0 0% 45%));
    transition: transform 0.2s ease;
  }

  .reading-bar.is-open .reading-bar-chevron {
    transform: rotate(180deg);
  }

  .reading-bar-totop {
    display: inline-grid;
    place-items: center;
    justify-self: end;
    width: 32px;
    height: 32px;
    border: 0;
    background: none;
    color: hsl(var(--muted-foreground, 0 0% 45%));
    cursor: pointer;
    pointer-events: auto;
  }

  .reading-bar-totop svg {
    width: 17px;
    height: 17px;
  }

  .reading-bar-menu {
    position: relative;
    max-height: 0;
    overflow: hidden;
    visibility: hidden;
    padding: 0 10px;
    opacity: 0;
    pointer-events: auto;
    transition:
      max-height 0.3s cubic-bezier(0.32, 0.72, 0, 1),
      padding 0.3s cubic-bezier(0.32, 0.72, 0, 1),
      opacity 0.2s ease,
      visibility 0s linear 0.3s;
  }

  .reading-bar.is-open .reading-bar-menu {
    max-height: 320px;
    visibility: visible;
    padding: 4px 10px 8px;
    opacity: 1;
    transition-delay: 0s;
  }

  .reading-bar-list {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .reading-bar-pill {
    position: absolute;
    top: 0;
    left: 50%;
    z-index: 0;
    width: min(72%, 15rem);
    height: 0;
    margin-left: calc(min(72%, 15rem) / -2);
    border-radius: 9px;
    background: hsl(var(--foreground, 0 0% 0%) / 0.1);
    opacity: 0;
    pointer-events: none;
    transform: translateY(0);
    transition:
      transform 0.46s cubic-bezier(0.25, 1.22, 0.45, 1.04),
      height 0.46s cubic-bezier(0.25, 1.22, 0.45, 1.04),
      opacity 0.22s ease;
  }

  .reading-bar-link {
    position: relative;
    z-index: 1;
    display: inline-block;
    max-width: 100%;
    padding: 8px 14px;
    border-radius: 9px;
    color: hsl(var(--muted-foreground, 0 0% 45%));
    font-size: 14px;
    line-height: 1.35;
    text-align: center;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .reading-bar-link:hover,
  .reading-bar-link.is-active {
    color: hsl(var(--foreground, 0 0% 0%));
  }

  .reading-bar-link.is-active {
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-bar-pill,
    .reading-bar-chevron,
    .reading-bar-menu,
    .reading-bar-link {
      transition: none;
    }
  }
</style>
