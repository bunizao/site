---
// One subscribe panel for both surfaces — the blog and the mood feed share the
// same dropdown, copy structure, and behaviour. It opens from a trigger button
// and carries: a welcome line, an email field, a Posts/Moods channel choice,
// a Turnstile check, a privacy note, an RSS link, and a submit. The form POSTs
// `{ email, channels, deliveryMode, timezone, turnstileToken }` to the shared
// /api/notify/subscribe pool; `channels` ('blog' | 'mood') is the contract field
// that distinguishes the two streams (see packages/contracts/src/notify.ts).
//
// Styling rides on the global foreground/background tokens, so it reads the same
// in either zone; only the accent differs (blog gets its Verdigris/Glacier).
// The publication name in the welcome line is set apart by colour + weight, not
// a display font — that stays plain on purpose.
import { blog } from '@/data/site';

interface Props {
  variant: 'mood' | 'blog';
  /** Pairs the trigger to its panel; unique per page is enough. */
  id?: string;
  turnstileSiteKey?: string;
  /** RSS href shown as an icon tile in the footer row. */
  feed?: string;
  /** Telegram channel href, shown beside RSS. Omitted where there is no channel. */
  telegram?: string;
  /** Drop edge the panel grows from, relative to its trigger. */
  anchor?: 'left' | 'right';
  /** Blog renders its own in-flow trigger; mood injects one into the header. */
  withTrigger?: boolean;
  triggerLabel?: string;
}

const {
  variant,
  id = variant,
  turnstileSiteKey = '',
  feed,
  telegram,
  anchor = variant === 'blog' ? 'left' : 'right',
  withTrigger = variant === 'blog',
  triggerLabel = '订阅',
} = Astro.props;

// Welcome copy per surface. The stream name is wrapped in <em> and set apart by
// colour + weight only — never a display font.
const intro =
  variant === 'blog'
    ? { lead: '欢迎订阅', name: blog.name, tail: '，感谢您阅读我的文章。' }
    : { lead: '欢迎订阅', name: '闲谈手记', tail: '，第一时间收到更新。' };

---

{withTrigger && (
  <button
    type="button"
    class="sub-trigger"
    data-subscribe-toggle={id}
    aria-haspopup="dialog"
    aria-expanded="false"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 22a2 2 0 0 1-2-2V8h4V4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2Z"></path>
      <path d="M10 7h7M10 11h7M10 15h4"></path>
    </svg>
    <span>{triggerLabel}</span>
    <svg class="sub-trigger__caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </button>
)}

<!-- Mobile opens the panel as a near-full-width sheet over a dense feed, so the
     page behind it gets pushed back. A sibling (not a child) of the panel: the
     panel scales on open, and a scrim inside it would scale with it. -->
<div class="subscribe-scrim" data-subscribe-scrim data-subscribe-id={id} aria-hidden="true"></div>

<div
  class="subscribe-panel"
  data-subscribe-panel
  data-subscribe-id={id}
  data-anchor={anchor}
  data-turnstile-site-key={turnstileSiteKey}
  role="dialog"
  aria-label="订阅"
  aria-hidden="true"
>
  <div class="subscribe-panel__inner">
    <div data-sub-form-view>
      <div class="sub-header">
        <span class="sub-title">订阅</span>
        <button type="button" class="sub-close" data-sub-close aria-label="关闭">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>

      <p class="sub-intro">
        {intro.lead} <em>{intro.name}</em>{intro.tail}
      </p>

      <form data-sub-form autocomplete="off" novalidate>
        <input
          type="email"
          class="sub-input"
          placeholder="请留邮箱"
          required
          autocomplete="email"
          data-sub-email
        />

        <div class="sub-streams" role="group" aria-label="订阅内容">
          <div class="sub-channel">
            <label class="sub-channel__head">
              <input type="checkbox" name="channels" value="blog" checked data-sub-channel />
              <svg class="sub-channel__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 3h9l5 5v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z"></path>
                <path d="M14 3v5h5"></path>
                <path d="M8 13h8M8 17h5"></path>
              </svg>
              <span class="sub-channel__text">
                <span class="sub-channel__title">Posts</span>
                <span class="sub-channel__meta">更新即推送</span>
              </span>
              <span class="sub-switch" aria-hidden="true"></span>
            </label>
          </div>

          <div class="sub-channel">
            <label class="sub-channel__head">
              <input type="checkbox" name="channels" value="mood" checked data-sub-channel />
              <svg class="sub-channel__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 14a2 2 0 0 1-2 2H8l-4 4V6a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2Z"></path>
                <path d="M9 9h6M9 12h4"></path>
              </svg>
              <span class="sub-channel__text">
                <span class="sub-channel__title">Moods</span>
                <span class="sub-channel__meta">按下方频率推送</span>
              </span>
              <span class="sub-switch" aria-hidden="true"></span>
            </label>

            <div class="sub-channel__freq" data-sub-freq>
              <div class="sub-seg" role="radiogroup" aria-label="Moods 推送频率">
                <span class="sub-seg__pill" aria-hidden="true"></span>
                <input type="radio" id={`${id}-mode-instant`} name="deliveryMode" value="instant" class="sub-seg__input" data-sub-mode checked />
                <label for={`${id}-mode-instant`} class="sub-seg__label">即时</label>
                <input type="radio" id={`${id}-mode-5h`} name="deliveryMode" value="every_5h" class="sub-seg__input" data-sub-mode />
                <label for={`${id}-mode-5h`} class="sub-seg__label">每 5 时</label>
                <input type="radio" id={`${id}-mode-daily`} name="deliveryMode" value="daily" class="sub-seg__input" data-sub-mode />
                <label for={`${id}-mode-daily`} class="sub-seg__label">每日</label>
              </div>
            </div>
          </div>
        </div>

        <div data-sub-turnstile class="sub-turnstile"></div>

        <p class="sub-hint" data-sub-hint></p>

        <p class="sub-privacy">
          订阅信息受
          <a href="/privacy" class="sub-privacy__link" target="_blank" rel="noopener noreferrer">隐私政策</a>
          保护。
        </p>

        <div class="sub-actions">
          <div class="sub-elsewhere">
            {feed && (
              <a class="sub-out" href={feed} target="_blank" rel="noopener noreferrer" aria-label="通过 RSS 订阅" title="通过 RSS 订阅">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 11a9 9 0 0 1 9 9"></path>
                  <path d="M4 4a16 16 0 0 1 16 16"></path>
                  <circle cx="5" cy="19" r="1"></circle>
                </svg>
              </a>
            )}
            {telegram && (
              <a class="sub-out" href={telegram} target="_blank" rel="noopener noreferrer" aria-label="订阅 Telegram 频道" title="订阅 Telegram 频道">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21.5 3.5 2.5 10.9a.5.5 0 0 0 .04.94l4.6 1.42"></path>
                  <path d="M21.5 3.5 18.4 20.2a.5.5 0 0 1-.8.29l-4.9-3.86"></path>
                  <path d="m7.14 13.26 1.1 5.06a.5.5 0 0 0 .87.22l3.6-3.9"></path>
                  <path d="M21.5 3.5 7.14 13.26"></path>
                </svg>
              </a>
            )}
          </div>
          <button type="submit" class="sub-submit" data-sub-submit>
            <span class="sub-submit__lock" data-sub-submit-lock aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V8a4 4 0 1 1 8 0v3"></path></svg>
            </span>
            <span data-sub-submit-text>订阅</span>
            <svg class="sub-submit__arrow" data-sub-submit-arrow viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            <span class="sub-spinner is-hidden" data-sub-submit-spinner></span>
          </button>
        </div>

        <div class="sub-error" data-sub-error aria-live="polite"></div>
      </form>
    </div>

    <div data-sub-success-view class="is-hidden">
      <div class="sub-result">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
          <path d="m9 11 3 3L22 4"></path>
        </svg>
        <p class="sub-result__text" data-sub-success-text>确认邮件已发，去收件箱点一下。</p>
        <button type="button" class="sub-submit sub-submit--block" data-sub-done>好</button>
      </div>
    </div>

    <div data-sub-error-view class="is-hidden">
      <div class="sub-result">
        <p class="sub-result__text sub-result__text--error" data-sub-error-text>出错了，稍后重试。</p>
        <button type="button" class="sub-submit sub-submit--block" data-sub-retry>重试</button>
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* Shared subscribe panel. Colours ride the global foreground/background
     tokens so it reads identically in the mood zone and the blog zone; only the
     accent differs, overridden under .blog-zone below. */
  .subscribe-panel {
    --sub-accent: hsl(var(--foreground));
    /* Surface elevation. A light page reads a panel by its shadow; a 4% dark
       page has no shadow to give — black on near-black is still near-black — so
       there the panel has to lift its own surface instead. The shadow stays
       neutral black in both themes: tinting it with --foreground turns it into
       a white halo the moment the theme flips. --sub-raised is the next step up
       again, for controls that must read as sitting ON the panel. */
    --sub-surface: hsl(var(--background));
    --sub-raised: hsl(var(--background));
    --sub-edge: hsl(var(--foreground) / 0.1);
    --sub-elevation: 0 12px 32px hsl(0 0% 0% / 0.12), 0 2px 8px hsl(0 0% 0% / 0.06);
    position: fixed;
    z-index: 60;
    width: 320px;
    font-family: var(--font-sans);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px) scale(0.97);
    transform-origin: top right;
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s ease;
    pointer-events: none;
  }

  .dark .subscribe-panel {
    --sub-surface: hsl(0 0% 11%);
    --sub-raised: hsl(0 0% 17%);
    --sub-edge: hsl(var(--foreground) / 0.18);
    --sub-elevation: 0 18px 44px hsl(0 0% 0% / 0.66), 0 2px 10px hsl(0 0% 0% / 0.5);
  }

  .subscribe-panel[data-anchor='left'] {
    transform-origin: top left;
  }

  .subscribe-panel.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .subscribe-panel__inner {
    background: var(--sub-surface);
    border: 1px solid var(--sub-edge);
    border-radius: 12px;
    box-shadow: var(--sub-elevation);
    padding: 16px;
  }

  .subscribe-scrim {
    position: fixed;
    inset: 0;
    /* One below the panel, above every fixed chrome layer the page can raise. */
    z-index: 59;
    display: none;
    background: hsl(0 0% 0% / 0.32);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  .dark .subscribe-scrim {
    background: hsl(0 0% 0% / 0.55);
  }

  /* Desktop keeps the panel an anchored dropdown, where a scrim would be far
     heavier than the gesture deserves. */
  @media (max-width: 639px) {
    .subscribe-scrim {
      display: block;
    }

    .subscribe-scrim.is-open {
      opacity: 1;
      pointer-events: auto;
    }
  }

  .sub-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .sub-title {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: hsl(var(--foreground));
  }

  .sub-close {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    color: hsl(var(--muted-foreground));
    background: none;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: color 0.12s ease, background 0.12s ease, scale 0.12s ease;
  }

  /* Keep the 24px visual but extend the tap target to 40×40 (24 + 8 + 8). */
  .sub-close::before {
    content: '';
    position: absolute;
    inset: -8px;
  }

  .sub-close:hover {
    color: hsl(var(--foreground));
    background: hsl(var(--foreground) / 0.06);
  }

  .sub-close:active {
    scale: 0.96;
  }

  .sub-intro {
    margin: 0 0 12px;
    font-size: 13px;
    line-height: 1.6;
    color: hsl(var(--foreground) / 0.6);
  }

  .sub-intro em {
    font-style: normal;
    font-weight: 600;
    color: hsl(var(--foreground));
  }

  .sub-input {
    width: 100%;
    height: 38px;
    padding: 0 12px;
    font-family: inherit;
    font-size: 13px;
    color: hsl(var(--foreground));
    background: hsl(var(--foreground) / 0.04);
    border: 1px solid hsl(var(--foreground) / 0.1);
    border-radius: 9px;
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .sub-input::placeholder {
    color: hsl(var(--muted-foreground) / 0.55);
  }

  .sub-input:focus {
    border-color: hsl(var(--foreground) / 0.3);
    box-shadow: 0 0 0 3px hsl(var(--foreground) / 0.05);
  }

  /* Channels stack vertically: one row each. Posts states its cadence inline
     ("更新即推送"); Moods owns the frequency control, revealed beneath its row
     only when it is on — so the cadence reads as belonging to Moods alone. */
  .sub-streams {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 12px;
  }

  .sub-channel {
    border: 1px solid hsl(var(--foreground) / 0.1);
    border-radius: 11px;
    transition: border-color 0.16s ease, background 0.16s ease;
  }

  .sub-channel__head:hover {
    background: hsl(var(--foreground) / 0.02);
    border-radius: 11px;
  }

  /* State hangs off the channel toggle only — scope past the frequency radios
     nested in the Moods row, or their unchecked state leaks into :has(). */
  .sub-channel:has(.sub-channel__head input:checked) {
    border-color: hsl(var(--foreground) / 0.16);
  }

  .sub-channel__head {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .sub-channel__head input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .sub-channel__icon {
    width: 17px;
    height: 17px;
    flex: none;
    color: hsl(var(--foreground) / 0.42);
    transition: color 0.16s ease;
  }

  .sub-channel:has(.sub-channel__head input:checked) .sub-channel__icon {
    color: var(--sub-accent);
  }

  .sub-channel__text {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .sub-channel__title {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: hsl(var(--foreground) / 0.62);
    transition: color 0.16s ease;
  }

  .sub-channel:has(.sub-channel__head input:checked) .sub-channel__title {
    color: hsl(var(--foreground));
  }

  .sub-channel__meta {
    font-size: 11px;
    line-height: 1.3;
    color: hsl(var(--muted-foreground) / 0.7);
  }

  /* Toggle switch — clearer on/off affordance than a tick for a settings row. */
  .sub-switch {
    flex: none;
    margin-left: auto;
    position: relative;
    width: 32px;
    height: 18px;
    border-radius: 999px;
    background: hsl(var(--foreground) / 0.14);
    transition: background 0.18s ease;
  }

  .sub-switch::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--sub-raised);
    box-shadow: 0 1px 2px hsl(0 0% 0% / 0.35);
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .sub-channel:has(.sub-channel__head input:checked) .sub-switch {
    background: var(--sub-accent);
  }

  .sub-channel:has(.sub-channel__head input:checked) .sub-switch::after {
    transform: translateX(14px);
  }

  .sub-channel:has(.sub-channel__head input:focus-visible) .sub-switch {
    outline: 2px solid var(--sub-accent);
    outline-offset: 2px;
  }

  /* Frequency reveal — a max-height collapse when Moods is off. Generous cap so
     the segmented control never clips; flex children make the grid-fr trick
     unreliable here, so max-height stays the robust choice. */
  .sub-channel__freq {
    overflow: hidden;
    max-height: 80px;
    padding: 0 12px 12px;
    opacity: 1;
    transition: max-height 0.24s ease, opacity 0.18s ease, padding 0.24s ease;
  }

  .sub-channel:has(.sub-channel__head input:not(:checked)) .sub-channel__freq {
    max-height: 0;
    padding-top: 0;
    padding-bottom: 0;
    opacity: 0;
    pointer-events: none;
  }

  /* Frequency — a sliding segmented control. The pill is translated by a CSS
     var the controller updates as the selection changes. */
  /* No trough. Filled, this was a box inside the Moods card inside the panel —
     three nested rectangles for one radio group. The sliding pill alone is
     enough to say which option is live. */
  .sub-seg {
    --sub-seg-count: 3;
    --sub-seg-offset: 0%;
    position: relative;
    display: flex;
    isolation: isolate;
  }

  .sub-seg__pill {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: calc(100% / var(--sub-seg-count));
    border-radius: 7px;
    /* The selected pill has to sit ABOVE its trough. Painted with --background
       it went the other way in dark mode — a 4% pill inside a trough already
       lightened by the panel surface, so the selection read as a hole. */
    background: var(--sub-raised);
    box-shadow: 0 1px 3px hsl(0 0% 0% / 0.25), 0 0 0 1px hsl(var(--foreground) / 0.06);
    transform: translate3d(var(--sub-seg-offset), 0, 0);
    -webkit-transform: translate3d(var(--sub-seg-offset), 0, 0);
    transition: transform 0.26s cubic-bezier(0.22, 1, 0.36, 1);
    z-index: 0;
    pointer-events: none;
  }

  .sub-seg__input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .sub-seg__label {
    flex: 1;
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 6px 0;
    font-size: 12px;
    font-weight: 500;
    color: hsl(var(--muted-foreground));
    border-radius: 7px;
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    transition: color 0.16s ease;
  }

  .sub-seg__input:checked + .sub-seg__label {
    color: hsl(var(--foreground));
  }

  .sub-seg__input:focus-visible + .sub-seg__label {
    outline: 2px solid var(--sub-accent);
    outline-offset: 1px;
  }

  .sub-turnstile {
    --sub-turnstile-scale: 0.92;
    margin-top: 12px;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    min-height: 0;
    transition: min-height 0.2s ease;
  }

  .sub-turnstile.has-widget {
    min-height: 62px;
  }

  .sub-turnstile.has-widget > div {
    transform: scale(var(--sub-turnstile-scale));
    transform-origin: center top;
    display: block;
  }

  .sub-hint {
    margin: 8px 0 0;
    font-size: 10.5px;
    line-height: 1.4;
    color: hsl(var(--muted-foreground) / 0.78);
  }

  .sub-hint:empty {
    display: none;
  }

  .sub-privacy {
    margin: 10px 0 0;
    font-size: 10.5px;
    line-height: 1.5;
    color: hsl(var(--muted-foreground) / 0.74);
  }

  .sub-privacy__link {
    color: hsl(var(--foreground));
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.16em;
  }

  .sub-privacy__link:hover {
    text-decoration-thickness: 2px;
  }

  .sub-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 12px;
  }

  /* "Subscribe elsewhere" — RSS and the Telegram channel are the same kind of
     action (leave with the feed, no email needed), so they read as one matched
     pair of icon tiles instead of one labelled link and an afterthought. Sized
     to the submit button's height so the row keeps a single control line. */
  .sub-elsewhere {
    display: inline-flex;
    align-items: center;
    /* The tiles' boxes are 6px wider than their glyphs on every side. Left as
       laid out, the icons alone would start 6px inside the column the input and
       both channel cards share; bleed that padding back out so the row starts
       on the same edge as everything above it. */
    margin-left: -6px;
    /* Wider than it looks: the tiles' hit areas reach 5px past their boxes, so
       this gap is what keeps the two targets from overlapping (30 + 10 = 40,
       exactly one hit area per centre). */
    gap: 10px;
  }

  /* Borderless on purpose. Outlined, these two matched the submit button's box
     exactly and the row became three equal-weight rectangles with no primary
