---
import type { MoodChannelSummary } from '@/features/mood/server/contracts';

interface Props {
  initialChannel?: MoodChannelSummary;
}

const { initialChannel } = Astro.props;
const titleHtml = initialChannel?.titleHTML?.trim() ?? '';
const titleText = initialChannel?.title?.trim() ?? '';
const descriptionHtml = initialChannel?.descriptionHTML?.trim() ?? '';
const descriptionText = initialChannel?.description?.trim() ?? '';
const avatar = initialChannel?.avatar?.trim() ?? '';
const emojiId = initialChannel?.emojiId?.trim() ?? '';
const hasTitle = Boolean(titleHtml || titleText);
const hasDescription = Boolean(descriptionHtml || descriptionText);
const hasChannel = Boolean(initialChannel);
---

<div class={`mood-hero${hasChannel ? ' is-loaded' : ''}`} data-mood-hero>
  <a href="/" class="back-link">← Back</a>

  <div class="mood-hero-content">
    <div class={`mood-hero-avatar${hasChannel ? ' is-loaded' : ''}`} data-hero-avatar>
      <div class="mood-hero-avatar-skeleton"></div>
      {avatar ? (
        <img
          src={avatar}
          alt={titleText || 'Channel avatar'}
          class="mood-hero-avatar-img"
          loading="lazy"
          decoding="async"
        />
      ) : null}
    </div>

    <div class="mood-hero-info">
      <h1 class={`mood-hero-title${hasTitle ? ' is-loaded' : ''}`} data-hero-title>
        {titleHtml ? <Fragment set:html={titleHtml} /> : titleText}
        {emojiId ? (
          <span class="tg-emoji mood-hero-emoji" data-emoji-id={emojiId}>
            <img src={`/static/https:/t.me/i/emoji/${emojiId}.webp`} alt="emoji" loading="lazy" decoding="async" />
          </span>
        ) : null}
        {!hasTitle ? <span class="mood-hero-title-skeleton"></span> : null}
      </h1>
      <div class={`mood-hero-description${hasDescription ? ' is-loaded' : ''}`} data-hero-description>
        {descriptionHtml ? <Fragment set:html={descriptionHtml} /> : descriptionText}
        {!hasDescription ? <span class="mood-hero-desc-skeleton"></span> : null}
      </div>
    </div>
  </div>

  <div class="mood-search" data-mood-search>
    <button
      class="mood-search-toggle"
      type="button"
      data-mood-search-toggle
      aria-expanded="false"
      aria-controls="mood-search-panel"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
      <span class="mood-search-toggle-label">Search</span>
    </button>

    <div class="mood-search-panel" id="mood-search-panel" data-mood-search-panel hidden>
      <div class="mood-search-bar">
        <svg class="mood-search-bar-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <input
          class="mood-search-input"
          type="search"
          data-mood-search-input
          placeholder="Search moods…"
          aria-label="Search moods"
          autocomplete="off"
          spellcheck="false"
          maxlength="64"
          enterkeyhint="search"
        />
        <button class="mood-search-close" type="button" data-mood-search-close aria-label="Close search">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>
      <p class="mood-search-status" data-mood-search-status role="status" aria-live="polite"></p>
      <div class="mood-search-results" data-mood-search-results role="region" aria-label="Search results"></div>
    </div>
  </div>
</div>

<style>
  .mood-hero {
    margin-bottom: 48px;
    padding-bottom: 24px;
  }

  @media (min-width: 640px) {
    .mood-hero {
      margin-bottom: 56px;
      padding-bottom: 28px;
    }
  }

  @media (min-width: 1024px) {
    .mood-hero {
      margin-bottom: 64px;
      padding-bottom: 32px;
    }
  }

  .mood-hero-content {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  @media (min-width: 640px) {
    .mood-hero-content {
      gap: 20px;
    }
  }

  .mood-hero-avatar {
    position: relative;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: hsl(var(--foreground) / 0.05);
  }

  @media (min-width: 640px) {
    .mood-hero-avatar {
      width: 80px;
      height: 80px;
    }
  }

  .mood-hero-avatar-skeleton {
    position: absolute;
    inset: 0;
    background: hsl(var(--foreground) / 0.05);
    border-radius: 50%;
  }

  .mood-hero-avatar-skeleton::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      120deg,
      transparent 35%,
      hsl(var(--foreground) / 0.12) 50%,
      transparent 65%
    );
    animation: mood-hero-shimmer 2.8s ease-in-out infinite;
    opacity: 0.35;
  }

  .mood-hero-avatar.is-loaded .mood-hero-avatar-skeleton {
    display: none;
  }

  .mood-hero-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .mood-hero-avatar.is-loaded .mood-hero-avatar-img {
    opacity: 1;
  }

  .mood-hero-info {
    flex: 1;
    min-width: 0;
    padding-top: 4px;
  }

  @media (min-width: 640px) {
    .mood-hero-info {
      padding-top: 8px;
    }
  }

  .mood-hero-title {
    font-family: var(--font-code);
    font-size: 27px;
    font-weight: 700;
    letter-spacing: -0.025em;
    margin-bottom: 10px;
    line-height: 1.08;
    will-change: transform;
  }

  @media (min-width: 640px) {
    .mood-hero-title {
      font-size: 33px;
      margin-bottom: 12px;
    }
  }

  /* Levitate — the hero's signature idle gesture, only once the name is in. */
  @media (prefers-reduced-motion: no-preference) {
    .mood-hero-title.is-loaded {
      animation: mood-hero-levitate 7s ease-in-out infinite;
    }
  }

  @keyframes mood-hero-levitate {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-3px);
    }
  }

  .mood-hero-emoji {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.1em;
    height: 1.1em;
    margin-left: 0.35em;
    vertical-align: -0.1em;
  }

  .mood-hero-emoji img {
    width: 100%;
    height: 100%;
    display: block;
  }

  .mood-hero-emoji[data-emoji-animated='true'] img {
    display: none;
  }

  .mood-hero-emoji .tg-emoji-anim,
  .mood-hero-emoji .tg-emoji-anim svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .mood-hero-title-skeleton {
    display: inline-block;
    width: 140px;
    height: 24px;
    background: hsl(var(--foreground) / 0.05);
    border-radius: 6px;
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .mood-hero-title-skeleton {
      width: 180px;
      height: 28px;
    }
  }

  .mood-hero-title-skeleton::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      120deg,
      transparent 35%,
      hsl(var(--foreground) / 0.12) 50%,
      transparent 65%
    );
    animation: mood-hero-shimmer 2.8s ease-in-out infinite;
    animation-delay: 0.1s;
    opacity: 0.35;
  }

  .mood-hero-title.is-loaded .mood-hero-title-skeleton {
    display: none;
  }

  .mood-hero-description {
    font-family: var(--font-code);
    font-size: 15px;
    font-weight: 400;
    color: hsl(var(--muted-foreground));
    line-height: 1.6;
    max-width: 54ch;
  }

  @media (min-width: 640px) {
    .mood-hero-description {
      font-size: 16px;
    }
  }

  .mood-hero-desc-skeleton {
    display: inline-block;
    width: 220px;
    height: 14px;
    background: hsl(var(--foreground) / 0.05);
    border-radius: 4px;
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .mood-hero-desc-skeleton {
      width: 280px;
      height: 15px;
    }
  }

  .mood-hero-desc-skeleton::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      120deg,
      transparent 35%,
      hsl(var(--foreground) / 0.12) 50%,
      transparent 65%
    );
    animation: mood-hero-shimmer 2.8s ease-in-out infinite;
    animation-delay: 0.2s;
    opacity: 0.35;
  }

  .mood-hero-description.is-loaded .mood-hero-desc-skeleton {
    display: none;
  }

  .mood-hero-description :global(a) {
    color: hsl(var(--foreground));
    text-decoration: none;
    border-bottom: 1px solid hsl(var(--foreground) / 0.35);
    transition: border-color 0.15s ease;
  }

  .mood-hero-description :global(a:hover) {
    border-bottom-color: hsl(var(--foreground) / 0.6);
  }

  .mood-hero-description :global(.tg-emoji) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.15em;
    height: 1.15em;
    vertical-align: -0.15em;
  }

  .mood-hero-description :global(.tg-emoji img) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
    margin-bottom: 24px;
    transition: color 0.15s ease;
  }

  @media (min-width: 640px) {
    .back-link {
      margin-bottom: 28px;
    }
  }

  @media (max-width: 480px) {
    .back-link {
      margin-bottom: 16px;
    }
  }

  .back-link:hover {
    color: hsl(var(--foreground));
  }

  @keyframes mood-hero-shimmer {
    0% {
      transform: translateX(-100%);
      opacity: 0.2;
    }
    100% {
      transform: translateX(200%);
      opacity: 0.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mood-hero-avatar-skeleton::after,
    .mood-hero-title-skeleton::after,
    .mood-hero-desc-skeleton::after {
      animation: none;
    }
  }

  /* Search affordance — sits below the hero identity, above the feed. */
  .mood-search {
    margin-top: 20px;
  }

  .mood-search-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    padding: 0 14px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
    background: hsl(var(--background) / 0.8);
    border: 1px solid hsl(var(--foreground) / 0.08);
    border-radius: 9px;
    cursor: pointer;
    transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }

  .mood-search-toggle:hover,
  .mood-search-toggle[aria-expanded='true'] {
    color: hsl(var(--foreground));
    background: hsl(var(--foreground) / 0.05);
    border-color: hsl(var(--foreground) / 0.15);
  }

  .mood-search-toggle svg {
    flex-shrink: 0;
  }

  .mood-search-panel[hidden] {
    display: none;
  }

  .mood-search-panel {
    margin-top: 16px;
  }

  .mood-search-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 12px;
    height: 44px;
    border: 1px solid hsl(var(--foreground) / 0.12);
    border-radius: 12px;
    background: hsl(var(--background));
  }

  .mood-search-bar:focus-within {
    border-color: hsl(var(--foreground) / 0.28);
  }

  .mood-search-bar-icon {
    flex-shrink: 0;
    color: hsl(var(--muted-foreground) / 0.7);
  }

  .mood-search-input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    color: hsl(var(--foreground));
    font-family: var(--font-sans);
    font-size: 15px;
    outline: none;
  }

  .mood-search-input::placeholder {
    color: hsl(var(--muted-foreground) / 0.6);
  }

  .mood-search-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: hsl(var(--muted-foreground));
    cursor: pointer;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .mood-search-close:hover,
  .mood-search-close:focus-visible {
    color: hsl(var(--foreground));
    background: hsl(var(--foreground) / 0.06);
  }

  .mood-search-status {
    margin: 12px 0 0;
    font-size: 13px;
    color: hsl(var(--muted-foreground));
  }

  .mood-search-status:empty {
    display: none;
  }

  .mood-search-results {
    display: flex;
    flex-direction: column;
    margin-top: 12px;
  }

  .mood-search-result {
    display: block;
    padding: 12px 0;
    border-bottom: 1px solid hsl(var(--foreground) / 0.06);
    text-decoration: none;
    color: inherit;
  }

  .mood-search-result:last-child {
    border-bottom: none;
  }

  .mood-search-result:hover,
  .mood-search-result:focus-visible {
    outline: none;
  }

  .mood-search-result:hover .mood-search-result-snippet,
  .mood-search-result:focus-visible .mood-search-result-snippet {
    color: hsl(var(--foreground));
  }

  .mood-search-result-time {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground) / 0.7);
    font-variant-numeric: tabular-nums;
  }

  .mood-search-result-snippet {
    margin: 4px 0 0;
    font-size: 14px;
    line-height: 1.55;
    color: hsl(var(--foreground) / 0.85);
    transition: color 0.15s ease;
  }

  .mood-search-result-snippet :global(mark) {
    background: hsl(var(--foreground) / 0.12);
    color: inherit;
    border-radius: 3px;
    padding: 0 2px;
  }

  .mood-search-result-tags {
    margin: 6px 0 0;
    font-size: 11px;
    color: hsl(var(--muted-foreground) / 0.6);
  }
</style>
