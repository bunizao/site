---
import type { MoodChannelSummary } from '@/features/mood/server/contracts';

interface Props {
  initialChannel?: MoodChannelSummary;
}

const { initialChannel } = Astro.props;
const titleHtml = initialChannel?.titleHTML?.trim() ?? '';
const titleText = initialChannel?.title?.trim() ?? '';
const descriptionHtml = initialChannel?.descriptionHTML?.trim() ?? '';
const descriptionText = initialChannel?.description?.trim() ?? '';
const avatar = initialChannel?.avatar?.trim() ?? '';
const emojiId = initialChannel?.emojiId?.trim() ?? '';
const hasTitle = Boolean(titleHtml || titleText);
const hasDescription = Boolean(descriptionHtml || descriptionText);
const hasChannel = Boolean(initialChannel);
---

<div class={`mood-hero${hasChannel ? ' is-loaded' : ''}`} data-mood-hero>
  <a href="/" class="back-link">← Back</a>

  <div class="mood-hero-content">
    <div class={`mood-hero-avatar${hasChannel ? ' is-loaded' : ''}`} data-hero-avatar>
      <div class="mood-hero-avatar-skeleton"></div>
      {avatar ? (
        <img
          src={avatar}
          alt={titleText || 'Channel avatar'}
          class="mood-hero-avatar-img"
          loading="lazy"
          decoding="async"
        />
      ) : null}
    </div>

    <div class="mood-hero-info">
      <h1 class={`mood-hero-title${hasTitle ? ' is-loaded' : ''}`} data-hero-title>
        {titleHtml ? <Fragment set:html={titleHtml} /> : titleText}
        {emojiId ? (
          <span class="tg-emoji mood-hero-emoji" data-emoji-id={emojiId}>
            <img src={`/static/https:/t.me/i/emoji/${emojiId}.webp`} alt="emoji" loading="lazy" decoding="async" />
          </span>
        ) : null}
        {!hasTitle ? <span class="mood-hero-title-skeleton"></span> : null}
      </h1>
      <div class={`mood-hero-description${hasDescription ? ' is-loaded' : ''}`} data-hero-description>
        {descriptionHtml ? <Fragment set:html={descriptionHtml} /> : descriptionText}
        {!hasDescription ? <span class="mood-hero-desc-skeleton"></span> : null}
      </div>
    </div>
  </div>

  <!-- Search doorway: looks like a search field, acts as a trigger for the
       site-wide ⌘K palette (data-command-open). Not a second search — one click
       opens the unified palette, which orders Moods first on this route. Keeps a
       discoverable, touch-friendly entry on the page without duplicating the
       header pill. -->
  <div class="mood-hero-search">
    <button
      class="mood-hero-search-trigger"
      type="button"
      data-command-open
      aria-label="Search moods and commands"
      aria-haspopup="dialog"
      aria-controls="site-command-palette"
      aria-keyshortcuts="Control+K Meta+K"
    >
      <svg class="mood-hero-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
      <span class="mood-hero-search-label">Search moods…</span>
      <span class="mood-hero-search-keys" aria-hidden="true">
        <kbd>⌘</kbd>
        <kbd>K</kbd>
      </span>
    </button>
  </div>
</div>

<style>
  .mood-hero {
    margin-bottom: 48px;
    padding-bottom: 24px;
  }

  @media (min-width: 640px) {
    .mood-hero {
      margin-bottom: 56px;
      padding-bottom: 28px;
    }
  }

  @media (min-width: 1024px) {
    .mood-hero {
      margin-bottom: 64px;
      padding-bottom: 32px;
    }
  }

  .mood-hero-content {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  @media (min-width: 640px) {
    .mood-hero-content {
      gap: 20px;
    }
  }

  .mood-hero-avatar {
    position: relative;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: hsl(var(--foreground) / 0.05);
  }

  @media (min-width: 640px) {
    .mood-hero-avatar {
      width: 80px;
      height: 80px;
    }
  }

  .mood-hero-avatar-skeleton {
    position: absolute;
    inset: 0;
    background: hsl(var(--foreground) / 0.05);
    border-radius: 50%;
  }

  .mood-hero-avatar-skeleton::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      120deg,
      transparent 35%,
      hsl(var(--foreground) / 0.12) 50%,
      transparent 65%
    );
    animation: mood-hero-shimmer 2.8s ease-in-out infinite;
    opacity: 0.35;
  }

  .mood-hero-avatar.is-loaded .mood-hero-avatar-skeleton {
    display: none;
  }

  .mood-hero-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .mood-hero-avatar.is-loaded .mood-hero-avatar-img {
    opacity: 1;
  }

  .mood-hero-info {
    flex: 1;
    min-width: 0;
    padding-top: 4px;
  }

  @media (min-width: 640px) {
    .mood-hero-info {
      padding-top: 8px;
    }
  }

  .mood-hero-title {
    font-family: var(--font-code);
    font-size: 27px;
    font-weight: 700;
    letter-spacing: -0.025em;
    margin-bottom: 10px;
    line-height: 1.08;
    will-change: transform;
  }

  @media (min-width: 640px) {
    .mood-hero-title {
      font-size: 33px;
      margin-bottom: 12px;
    }
  }

  /* Levitate — the hero's signature idle gesture, only once the name is in. */
  @media (prefers-reduced-motion: no-preference) {
    .mood-hero-title.is-loaded {
      animation: mood-hero-levitate 7s ease-in-out infinite;
    }
  }

  @keyframes mood-hero-levitate {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-3px);
    }
  }

  .mood-hero-emoji {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.1em;
    height: 1.1em;
    margin-left: 0.35em;
    vertical-align: -0.1em;
  }

  .mood-hero-emoji img {
    width: 100%;
    height: 100%;
    display: block;
  }

  .mood-hero-emoji[data-emoji-animated='true'] img {
    display: none;
  }

  .mood-hero-emoji .tg-emoji-anim,
  .mood-hero-emoji .tg-emoji-anim svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .mood-hero-title-skeleton {
    display: inline-block;
    width: 140px;
    height: 24px;
    background: hsl(var(--foreground) / 0.05);
    border-radius: 6px;
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .mood-hero-title-skeleton {
      width: 180px;
      height: 28px;
    }
  }

  .mood-hero-title-skeleton::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      120deg,
      transparent 35%,
      hsl(var(--foreground) / 0.12) 50%,
      transparent 65%
    );
    animation: mood-hero-shimmer 2.8s ease-in-out infinite;
    animation-delay: 0.1s;
    opacity: 0.35;
  }

  .mood-hero-title.is-loaded .mood-hero-title-skeleton {
    display: none;
  }

  .mood-hero-description {
    font-family: var(--font-code);
    font-size: 15px;
    font-weight: 400;
    color: hsl(var(--muted-foreground));
    line-height: 1.6;
    max-width: 54ch;
  }

  @media (min-width: 640px) {
    .mood-hero-description {
      font-size: 16px;
    }
  }

  .mood-hero-desc-skeleton {
    display: inline-block;
    width: 220px;
    height: 14px;
    background: hsl(var(--foreground) / 0.05);
    border-radius: 4px;
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .mood-hero-desc-skeleton {
      width: 280px;
      height: 15px;
    }
  }

  .mood-hero-desc-skeleton::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      120deg,
      transparent 35%,
      hsl(var(--foreground) / 0.12) 50%,
      transparent 65%
    );
    animation: mood-hero-shimmer 2.8s ease-in-out infinite;
    animation-delay: 0.2s;
    opacity: 0.35;
  }

  .mood-hero-description.is-loaded .mood-hero-desc-skeleton {
    display: none;
  }

  .mood-hero-description :global(a) {
    color: hsl(var(--foreground));
    text-decoration: none;
    border-bottom: 1px solid hsl(var(--foreground) / 0.35);
    transition: border-color 0.15s ease;
  }

  .mood-hero-description :global(a:hover) {
    border-bottom-color: hsl(var(--foreground) / 0.6);
  }

  .mood-hero-description :global(.tg-emoji) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.15em;
    height: 1.15em;
    vertical-align: -0.15em;
  }

  .mood-hero-description :global(.tg-emoji img) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
    margin-bottom: 24px;
    transition: color 0.15s ease;
  }

  @media (min-width: 640px) {
    .back-link {
      margin-bottom: 28px;
    }
  }

  @media (max-width: 480px) {
    .back-link {
      margin-bottom: 16px;
    }
  }

  .back-link:hover {
    color: hsl(var(--foreground));
  }

  @keyframes mood-hero-shimmer {
    0% {
      transform: translateX(-100%);
      opacity: 0.2;
    }
    100% {
      transform: translateX(200%);
      opacity: 0.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mood-hero-avatar-skeleton::after,
    .mood-hero-title-skeleton::after,
    .mood-hero-desc-skeleton::after {
      animation: none;
    }
  }

  /* Search doorway — a field-shaped button that opens the ⌘K palette. */
  .mood-hero-search {
    margin-top: 22px;
    max-width: 420px;
  }

  @media (max-width: 480px) {
    .mood-hero-search {
      margin-top: 16px;
      max-width: none;
    }
  }

  .mood-hero-search-trigger {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    height: 46px;
    padding: 0 12px 0 14px;
    border: 1px solid hsl(var(--foreground) / 0.1);
    border-radius: 13px;
    background: hsl(var(--foreground) / 0.02);
    cursor: pointer;
    text-align: left;
    transition:
      border-color 0.18s ease,
      background 0.18s ease,
      box-shadow 0.18s ease,
      scale 0.12s ease;
  }

  @media (hover: hover) {
    .mood-hero-search-trigger:hover {
      border-color: hsl(var(--foreground) / 0.2);
      background: hsl(var(--foreground) / 0.045);
      box-shadow: 0 1px 2px rgb(0 0 0 / 0.04);
    }
  }

  .mood-hero-search-trigger:focus-visible {
    outline: none;
    border-color: hsl(var(--foreground) / 0.3);
    box-shadow: 0 0 0 3px hsl(var(--foreground) / 0.08);
  }

  .mood-hero-search-trigger:active {
    scale: 0.995;
  }

  @media (prefers-reduced-motion: reduce) {
    .mood-hero-search-trigger:active {
      scale: 1;
    }
  }

  .mood-hero-search-icon {
    flex-shrink: 0;
    color: hsl(var(--muted-foreground) / 0.75);
  }

  .mood-hero-search-label {
    flex: 1;
    min-width: 0;
    font-family: var(--font-sans);
    font-size: 15px;
    color: hsl(var(--muted-foreground) / 0.85);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mood-hero-search-keys {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    flex-shrink: 0;
  }

  .mood-hero-search-keys kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 4px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    color: hsl(var(--muted-foreground) / 0.8);
    background: hsl(var(--foreground) / 0.05);
    border: 1px solid hsl(var(--foreground) / 0.08);
    border-radius: 5px;
  }

  /* Keycaps are a desktop-keyboard hint; on touch the whole bar is the target. */
  @media (max-width: 640px), (pointer: coarse) {
    .mood-hero-search-keys {
      display: none;
    }
  }
</style>
