---
// Fixed top navbar for the /mood feed. Borderless, full-width, progressive
// (feathered) backdrop blur — the compact docked echo of the in-page hero. As
// the reader scrolls, the hero's circular avatar AND its levitating title
// travel up and shrink into the navbar's left slot (two shared elements,
// scroll-scrubbed in lockstep). The two right controls (search + notify) are
// always present; the search spells out ⌘K on desktop. Styles live in
// ../styles/mood-navbar.css (global, no scope gymnastics with the injected
// title HTML). Channel data is SSR'd here and kept in sync by hydrateHero() in
// ../client/feed-media-hydration.ts.
import type { MoodChannelSummary } from '@/features/mood/server/contracts';
import Kbd from '@/components/Kbd.astro';
import Topbar from '@/components/Topbar.astro';
import '@/styles/scroll-dock.css';
import '@/features/mood/styles/mood-navbar.css';

interface Props {
  initialChannel?: MoodChannelSummary;
}

const { initialChannel } = Astro.props;
const titleHtml = initialChannel?.titleHTML?.trim() ?? '';
const titleText = initialChannel?.title?.trim() ?? '';
const avatar = initialChannel?.avatar?.trim() ?? '';
---

<Topbar class="mood-navbar" progressiveBlur data-mood-navbar>
  <div class="mood-navbar__bar">
    <button type="button" class="mood-nav-identity" data-mood-nav-top aria-label="Back to top">
      <!-- Empty placeholder the flyer avatar lands on; it only reserves layout
           so the title sits where it will after the avatar docks. -->
      <span class="mood-nav-avatar-slot" data-mood-nav-avatar-slot aria-hidden="true"></span>
      <!-- Two elements, one title: the box holds the DOCKED layout (the bar's
           row and this button's hit area are built on it), while the ink is
           laid out at the hero's font size and only ever scales DOWN — so the
           big headline is real vector text, never a stretched 14px raster.
           data-mood-nav-title stays on the ink because hydrateHero() writes
           innerHTML straight into it. -->
      <span class="mood-nav-title" data-mood-nav-title-box>
        <span class="mood-nav-title__ink" data-mood-nav-title>
          {titleHtml ? <Fragment set:html={titleHtml} /> : titleText}
        </span>
      </span>
    </button>

    <div class="mood-navbar__controls">
      <button
        type="button"
        class="topbar-action topbar-action--search"
        data-command-open
        aria-label="Search and commands"
        title="Search (⌘K)"
        aria-keyshortcuts="Control+K Meta+K"
        aria-haspopup="dialog"
        aria-controls="site-command-palette"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <span class="topbar-action__keys" aria-hidden="true">
          <Kbd icon="command" />
          <Kbd>K</Kbd>
        </span>
      </button>
      <button
        type="button"
        class="topbar-action"
        data-subscribe-toggle="mood"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-label="Subscribe to notifications"
        title="Subscribe to notifications"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
          <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- The shared element: one avatar that starts over the hero's big avatar and
       scrolls into the slot above. Positioned entirely by the scroll script. -->
  <span class="mood-nav-avatar-flyer" data-mood-nav-flyer aria-hidden="true">
    <img
      class="mood-nav-avatar-img"
      data-mood-nav-avatar-img
      src={avatar || undefined}
      alt=""
      width="30"
      height="30"
      loading="lazy"
      decoding="async"
      hidden={!avatar}
    />
  </span>
</Topbar>

<script>
  import { getMoodFeedTopHref } from '@/features/mood/shared/feed-anchor';
  import { createScrollDock } from '@/lib/scroll-dock';

  // The translation an element's own transform currently contributes, so a rect
  // taken while it animates can be reduced back to its layout position.
  const readTransform = (el: HTMLElement) => {
    const value = getComputedStyle(el).transform;
    if (!value || value === 'none') return { x: 0, y: 0 };
    try {
      const matrix = new DOMMatrixReadOnly(value);
      return { x: matrix.e, y: matrix.f };
    } catch {
      return { x: 0, y: 0 };
    }
  };

  function initMoodNavbar() {
    const navbar = document.querySelector<HTMLElement>('[data-mood-navbar]');
    if (!navbar || navbar.dataset.moodNavbarReady === 'true') return;
    navbar.dataset.moodNavbarReady = 'true';

    // Avatar/title click → back to top (reuses the anchored-feed href when the
    // reader arrived via a /mood?<id> deep link, else a plain smooth scroll).
    const topButton = navbar.querySelector<HTMLButtonElement>('[data-mood-nav-top]');
    topButton?.addEventListener('click', () => {
      const topHref = getMoodFeedTopHref(new URL(window.location.href));
      if (topHref) {
        window.location.assign(topHref);
        return;
      }
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
    });

    const flyer = navbar.querySelector<HTMLElement>('[data-mood-nav-flyer]');
    const slot = navbar.querySelector<HTMLElement>('[data-mood-nav-avatar-slot]');
    const titleBox = navbar.querySelector<HTMLElement>('[data-mood-nav-title-box]');
    const title = navbar.querySelector<HTMLElement>('[data-mood-nav-title]');
    const heroAvatar = document.querySelector<HTMLElement>('[data-mood-hero] [data-hero-avatar]');
    const heroTitle = document.querySelector<HTMLElement>('[data-mood-hero] [data-hero-title]');
    // No hero avatar to fly from (shouldn't happen on the feed) — leave the bar
    // controls working and skip the shared-element travel.
    if (!flyer || !slot || !heroAvatar) return;

    // The travel is described in mood-navbar.css as calc() over one scroll
    // scalar; this script only measures the two ends and publishes them as
    // numbers. That split is the whole design: re-measuring is then a handful of
    // setProperty calls, not a keyframe rebuild, so it stays safe to do while
    // the reader is mid-scroll. See @/lib/scroll-dock.
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const dock = reduceMotion ? null : createScrollDock(navbar, ['dock']);
    const setVar = (name: string, value: number) =>
      navbar.style.setProperty(name, value.toFixed(3));
    let run = 1;

    navbar.classList.toggle('is-reduced-motion', reduceMotion);

    // Whether the hero has a title to fly from; the ink falls back to a plain
    // fade-in when it does not.
    let titleFly = false;

    const measure = () => {
      const slotRect = slot.getBoundingClientRect();
      const slotSize = slotRect.width || 30;

      // The hero avatar keeps its layout box even while visually hidden, so its
      // rect stays valid as the flight's start position.
      const heroRect = heroAvatar.getBoundingClientRect();
      const heroTopDoc = heroRect.top + window.scrollY;
      const heroSize = heroRect.width || slotSize;

      setVar('--slot-x', slotRect.left);
      setVar('--slot-y', slotRect.top);
      setVar('--hero-x', heroRect.left + window.scrollX);
      setVar('--hero-y', heroTopDoc);
      // The flyer is laid out at the hero's size so the travel only ever scales
      // it DOWN. Sized at the slot, the ride would stretch a 30px raster ~2.7x
      // and will-change would pin it there — a visibly soft avatar over the hero.
      setVar('--hero-size', heroSize);
      setVar('--dock-scale', slotSize / heroSize);

      run = Math.max(1, heroTopDoc - slotRect.top);
      setVar('--run', run);
      dock?.setRun('dock', run);

      // Title geometry. Font ratio (not height) keeps the scale right even if
      // the hero title wraps to two lines.
      titleFly = false;
      if (title && titleBox) {
        const navFont = parseFloat(getComputedStyle(titleBox).fontSize) || 14;
        const heroFont = heroTitle
          ? parseFloat(getComputedStyle(heroTitle).fontSize) || navFont
          : navFont;
        const dockScale = navFont / heroFont;

        titleFly = !!heroTitle;
        if (titleFly) {
          // Lay the ink out at the hero's size before measuring it, so the width
          // below is its natural width in hero units.
          setVar('--ink-hero-font', heroFont);
          setVar('--ink-scale', dockScale);
        }
        navbar.classList.toggle('has-title-flight', titleFly);

        // Size the docked box from the ink's natural width in docked units and
        // let the CSS cap clamp it, then hand the ink that same budget back in
        // hero units so its ellipsis lands where the box's edge will be.
        title.style.maxWidth = 'none';
        titleBox.style.width = 'auto';
        // offsetWidth, not a rect: the ink carries the flight transform at all
        // times now, and the layout box is the only width reading that ignores
        // it. Integer rounding is fine here — both consumers below already
        // tolerate a sub-pixel (the `- 0.5` guard exists for exactly that).
        const inkWidth = title.offsetWidth;
        titleBox.style.width = `${inkWidth * dockScale}px`;

        const boxRect = titleBox.getBoundingClientRect();
        setVar('--ink-dock-x', boxRect.left);
        setVar('--ink-dock-y', boxRect.top);
        // Only a title long enough for the CSS cap to clamp needs a budget. Set
        // unconditionally it would land on the ink's own natural width, where
        // sub-pixel rounding is enough to trip the ellipsis on a title that fits.
        const clamped = boxRect.width < inkWidth * dockScale - 0.5;
        title.style.maxWidth = clamped ? `${boxRect.width / dockScale}px` : 'none';

        if (heroTitle) {
          // The hero title levitates on a looping translateY, and rects include
          // that transform — measuring mid-cycle would offset the flight's whole
          // start by up to the gesture's amplitude, so where the title rests
          // would depend on when measure() happened to run. Subtract the live
          // transform to recover the layout position underneath it.
          const heroRectT = heroTitle.getBoundingClientRect();
          const drift = readTransform(heroTitle);
          setVar('--ink-hero-x', heroRectT.left + window.scrollX - drift.x);
          setVar('--ink-hero-y', heroRectT.top + window.scrollY - drift.y);
        }
      }
    };

    // The identity's hit area is the one thing the scalar cannot express —
    // pointer-events has no numeric form. It costs a scrollY read and a
    // classList call that no-ops while the state holds, and it is the only
    // per-frame work left on this page.
    const update = () => {
      const isDocked = reduceMotion
        ? window.scrollY >= run
        : (dock?.read('dock').fold ?? 0) > 0.99;
      if (reduceMotion) {
        navbar.style.setProperty('--dock-ride', isDocked ? '1' : '0');
        navbar.style.setProperty('--dock-fold', isDocked ? '1' : '0');
      }
      navbar.classList.toggle('is-docked', isDocked);
    };

    const remeasure = () => {
      measure();
      update();
    };

    // Activate: measure and place the flyers first, then hand the hero avatar's
    // and title's visible role over to them — this order avoids any flash.
    measure();
    update();
    if (!reduceMotion) {
      heroAvatar.style.visibility = 'hidden';
      if (titleFly && heroTitle) heroTitle.style.visibility = 'hidden';
    }
    navbar.classList.add('is-flyer-active');

    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', remeasure);
    window.addEventListener('load', remeasure);

    // The hero settles late — hydrateHero() fills the title/avatar and the code
    // font reflows it after first paint, moving the box the flight starts from.
    // Observe the HERO, not the document: this feed's height changes constantly
    // as media loads below the fold, and none of that moves anything measured
    // here. Fonts get an explicit hook too, since a metrics change need not
    // resize any box.
    const heroBlock = document.querySelector<HTMLElement>('[data-mood-hero]');
    if (heroBlock && typeof ResizeObserver !== 'undefined') {
      new ResizeObserver(remeasure).observe(heroBlock);
    }
    document.fonts?.ready?.then(remeasure).catch(() => {});
  }

  initMoodNavbar();
  document.addEventListener('astro:page-load', initMoodNavbar);
</script>
