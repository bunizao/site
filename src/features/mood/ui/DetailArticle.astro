---
import type { MoodContentDocument } from '@bunizao/contracts';
import CommentsSection from '@/features/mood/ui/CommentsSection.astro';
import { getMoodTagHref } from '@/features/mood/shared/tag-filter';
import { getMoodReactionKey } from '@/features/mood/client/meta-patcher';

interface Props {
  post: MoodContentDocument | null;
  error?: boolean;
  postId?: string;
  renderedPostContent?: string;
  formattedDate?: string;
  telegramCommentUrl?: string;
  backHref?: string;
  readSource?: 'live' | 'archive';
}

const {
  post,
  error = false,
  postId = '',
  renderedPostContent = '',
  formattedDate = '',
  telegramCommentUrl = '',
  backHref = '/mood',
  readSource = 'live',
} = Astro.props;

const postTags = post ? post.tags ?? (post.tag ? [post.tag] : []) : [];
const postReactions = post?.reactions ?? [];
const hasLinkPreview = post
  ? post.hero?.type === 'link-preview' || post.media.some((item) => item.type === 'link-preview')
  : false;
const previewPending = readSource === 'archive'
  && Boolean(post && /https?:\/\//i.test(post.bodyHtml) && !hasLinkPreview);
---

{post ? (
  <article
    class="mood-post"
    data-mood-id={postId || post.id}
    data-mood-read-source={readSource}
    data-mood-preview-pending={previewPending ? 'true' : undefined}
  >
    <div class="mood-post-header">
      <a href={backHref} class="back-link" data-back-button>← Back to Moods</a>
      <div class="mood-post-meta">
        <time datetime={post.datetime} class="mood-post-date">
          {formattedDate}
        </time>
        {postTags.length > 0 && (
          <div class="mood-post-tags">
            {postTags.map((tag) => (
              <a class="mood-post-tag" href={getMoodTagHref(tag)}>#{tag}</a>
            ))}
          </div>
        )}
        {post.forwardedFrom && (
          <div class="mood-post-forwarded">
            <span class="mood-forwarded-label">Forwarded from</span>
            {post.forwardedFrom.href ? (
              <a
                class="mood-forwarded-source"
                href={post.forwardedFrom.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {post.forwardedFrom.name}
              </a>
            ) : (
              <span class="mood-forwarded-source">{post.forwardedFrom.name}</span>
            )}
            {post.forwardedFrom.author && post.forwardedFrom.author !== post.forwardedFrom.name && (
              <span class="mood-forwarded-author">({post.forwardedFrom.author})</span>
            )}
          </div>
        )}
      </div>
    </div>
    <div class="mood-post-content reading" set:html={renderedPostContent} />
    <div class={`mood-post-reactions${postReactions.length > 0 ? '' : ' is-hidden'}`} aria-label="Reactions">
        {postReactions.map((reaction) => (
          <span
            class={reaction.isPaid ? 'mood-reaction mood-reaction--paid' : 'mood-reaction'}
            data-mood-reaction-key={getMoodReactionKey(reaction)}
          >
            <span class="mood-reaction-emoji">
              {reaction.isPaid ? (
                '⭐'
              ) : reaction.emojiImage || reaction.emojiId ? (
                <span class="tg-emoji" data-emoji-id={reaction.emojiId}>
                  {reaction.emojiImage ? (
                    <img
                      src={reaction.emojiImage}
                      alt={reaction.emoji || 'emoji'}
                      loading="lazy"
                      decoding="async"
                      width={16}
                      height={16}
                    />
                  ) : (
                    reaction.emoji
                  )}
                </span>
              ) : (
                reaction.emoji
              )}
            </span>
            <span class="mood-reaction-count">{reaction.count}</span>
          </span>
        ))}
    </div>
    {postId && (
      <CommentsSection postId={postId} telegramCommentUrl={telegramCommentUrl} />
    )}
  </article>
) : (
  <article class="mood-post">
    <div class="mood-post-header">
      <a href={backHref} class="back-link">← Back to Moods</a>
      <div class="mood-post-meta">
        <time class="mood-post-date">Unavailable</time>
      </div>
    </div>
    <p class="text-sm text-muted-foreground">
      {error ? 'Unable to load this mood right now.' : 'This mood could not be found.'}
    </p>
  </article>
)}

<style>
  @view-transition {
    navigation: none;
  }

  .mood-post {
    padding: 80px 0 60px;
    max-width: 680px;
    margin: 0 auto;
    font-family: var(--font-sans);
  }

  @media (min-width: 640px) {
    .mood-post {
      padding: 100px 0 80px;
    }
  }

  @media (min-width: 1024px) {
    .mood-post {
      padding: 120px 0 100px;
      max-width: 720px;
    }
  }

  @media (max-width: 540px) {
    .mood-post {
      padding: 48px 0 32px;
    }

    .mood-post-header {
      margin-bottom: 24px;
      padding-bottom: 16px;
    }

    .back-link {
      margin-bottom: 14px;
      font-size: 12px;
      letter-spacing: 0.01em;
      opacity: 0.7;
    }

    .back-link:hover {
      opacity: 1;
    }

    .mood-post-meta {
      gap: 8px;
    }

    .mood-post-date {
      font-size: 12px;
      letter-spacing: 0.01em;
    }

    .mood-post-tags {
      gap: 6px;
      margin-top: 0;
    }

    .mood-post-tag {
      font-size: 11px;
      padding: 4px 8px;
      border-radius: 5px;
    }

    .mood-post-forwarded {
      font-size: 11px;
      gap: 6px;
      padding: 4px 0;
    }

    .mood-forwarded-label {
      font-size: 9px;
    }

    .mood-post-content {
      font-size: 17px;
      line-height: 1.55;
      margin-top: 0;
    }

    .mood-post-content :global(p) {
      margin-bottom: 1.1em;
    }

    .mood-post-reactions {
      margin-top: 32px;
      padding-top: 12px;
      gap: 6px;
    }

    .mood-post-content :global(.image-list-container) {
      margin: 1.25em 0;
      gap: 6px;
    }

    .mood-post-content :global(.image-preview-wrap) {
      border-radius: 12px;
    }

    .mood-post-content :global(.image-preview-wrap--portrait) {
      max-width: 85%;
    }

    .mood-post-content :global(.image-preview-wrap--ultra-tall) {
      max-width: 70%;
    }

    .mood-post-content :global(video) {
      margin: 1.25em 0;
      border-radius: 12px;
      max-height: min(62vh, 420px);
      background: transparent;
      overflow: clip;
      clip-path: inset(0 round 12px);
    }

    .mood-post-content :global(video.video--portrait) {
      width: min(82vw, 340px);
      max-width: 100%;
      max-height: min(68vh, 520px);
      margin-left: 0;
      margin-right: 0;
      display: block;
    }

    .mood-post-content :global(video.video--ultra-tall) {
      width: min(72vw, 300px);
      max-width: 100%;
      max-height: min(72vh, 560px);
      margin-left: 0;
      margin-right: 0;
      display: block;
    }

    .mood-post-content :global(.bookmark-card) {
      max-width: 100%;
      margin: 1em 0;
      border-radius: 10px;
    }

    .mood-post-content :global(.bookmark-card__content) {
      padding: 11px 13px 12px;
    }

    .mood-post-content :global(.bookmark-card__title) {
      font-size: 13px;
    }

    .mood-post-content :global(.bookmark-card__description) {
      font-size: 12px;
      -webkit-line-clamp: 3;
    }

    .mood-post-content :global(.bookmark-card__meta) {
      font-size: 11px;
    }

    .mood-post-content :global(.tgme_widget_message_document_wrap) {
      margin: 1em 0;
      padding: 10px 12px;
      gap: 10px;
      border-radius: 10px;
    }

    .mood-post-content :global(.tgme_widget_message_document_icon) {
      width: 38px;
      height: 38px;
      border-radius: 8px;
    }

    .mood-post-content :global(.tgme_widget_message_document_title) {
      font-size: 13px;
    }

    .mood-post-content :global(.tgme_widget_message_document_extra) {
      font-size: 12px;
    }

    .mood-post-content :global(.sticker) {
      max-width: 200px;
    }

    .mood-post-header {
      margin-bottom: 32px;
    }
  }

  @media (max-width: 380px) {
    .mood-post {
      padding: 44px 0 28px;
    }

    .mood-post-header {
      margin-bottom: 22px;
      padding-bottom: 12px;
    }

    .back-link {
      margin-bottom: 12px;
      font-size: 11px;
    }

    .mood-post-date {
      font-size: 11px;
    }

    .mood-post-tag {
      font-size: 10px;
      padding: 3px 7px;
    }

    .mood-post-content {
      font-size: 16px;
      line-height: 1.55;
    }

    .mood-post-reactions {
      margin-top: 28px;
    }
  }

  .mood-post-header {
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid hsl(var(--foreground) / 0.06);
  }

  @media (min-width: 640px) {
    .mood-post-header {
      margin-bottom: 28px;
      padding-bottom: 24px;
    }
  }

  @media (min-width: 1024px) {
    .mood-post-header {
      margin-bottom: 28px;
      padding-bottom: 28px;
    }
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground) / 0.75);
    margin-bottom: 28px;
    transition: color 0.15s ease;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-decoration: none;
  }

  @media (min-width: 640px) {
    .back-link {
      margin-bottom: 32px;
    }
  }

  .back-link:hover {
    color: hsl(var(--foreground));
  }

  .mood-post-meta {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  @media (min-width: 640px) {
    .mood-post-meta {
      gap: 18px;
    }
  }

  .mood-post-date {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1, 'zero' 1;
    line-height: 1.5;
  }

  @media (min-width: 640px) {
    .mood-post-date {
      font-size: 13px;
    }
  }

  .mood-post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 2px;
  }

  .mood-post-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground) / 0.7);
    padding: 4px 10px;
    background: hsl(var(--foreground) / 0.05);
    border-radius: 6px;
    transition:
      background 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
    border: 1px solid hsl(var(--foreground) / 0.06);
    text-decoration: none;
  }

  .mood-post-tag:hover {
    background: hsl(var(--foreground) / 0.1);
    color: hsl(var(--muted-foreground));
    border-color: hsl(var(--foreground) / 0.12);
  }

  .mood-post-forwarded {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    font-size: 12px;
    color: hsl(var(--muted-foreground));
    padding: 6px 0;
  }

  .mood-forwarded-label {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 10px;
    line-height: 1.2;
    color: hsl(var(--muted-foreground) / 0.7);
  }

  .mood-forwarded-source {
    font-weight: 500;
    line-height: 1.2;
    color: hsl(var(--foreground) / 0.85);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .mood-forwarded-source:hover,
  .mood-forwarded-source:focus-visible {
    border-bottom-color: hsl(var(--foreground) / 0.35);
  }

  .mood-forwarded-author {
    line-height: 1.2;
    color: hsl(var(--muted-foreground) / 0.7);
  }

  .mood-post-reactions {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
    padding-top: 0;
    border-top: none;
  }

  .mood-post-reactions.is-hidden {
    display: none;
  }

  @media (min-width: 640px) {
    .mood-post-reactions {
      margin-top: 32px;
      padding-top: 0;
    }
  }

  .mood-post-content {
    max-width: 34rem;
    font-size: 17px;
    line-height: 1.58;
    color: hsl(var(--foreground));
    margin-top: 8px;
    margin-inline: auto;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  @media (min-width: 640px) {
    .mood-post-content {
      font-size: 18px;
      line-height: 1.6;
      margin-top: 12px;
    }
  }

  @media (min-width: 1024px) {
    .mood-post-content {
      font-size: 18px;
      line-height: 1.6;
    }
  }

  .mood-post-content :global(p) {
    margin-bottom: 1.15em;
  }

  .mood-post-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .mood-post-content :global(a) {
    color: hsl(var(--foreground));
    text-decoration: none;
    border-bottom: 1px solid hsl(var(--foreground) / 0.35);
    padding-bottom: 1px;
    transition: border-color 0.15s ease, color 0.15s ease;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .mood-post-content :global(a:hover),
  .mood-post-content :global(a:focus-visible) {
    border-bottom-color: hsl(var(--foreground) / 0.6);
  }

  .mood-post-content :global(.mood-item-quote) {
    display: flex;
    align-items: center;
    gap: 4px;
    max-width: 88%;
    width: fit-content;
    margin: 0 0 0.9rem;
    padding: 8px 10px;
    border: none;
    border-radius: 10px;
    background: hsl(var(--foreground) / 0.03);
    box-shadow: none;
  }

  .mood-post-content :global(.mood-item-quote-body) {
    display: flex;
    justify-content: center;
    min-width: 0;
  }

  .mood-post-content :global(a.mood-item-quote),
  .mood-post-content :global(a.mood-item-quote:hover),
  .mood-post-content :global(a.mood-item-quote:focus-visible) {
    border-bottom: none;
    color: hsl(var(--muted-foreground));
    padding: 8px 10px;
    text-decoration: none;
  }

  .mood-post-content :global(a.mood-item-quote:hover),
  .mood-post-content :global(a.mood-item-quote:focus-visible) {
    color: hsl(var(--foreground) / 0.7);
  }

  .mood-post-content :global(.mood-item-quote .mood-item-quote-text) {
    display: -webkit-box;
    margin: 0;
    font-size: 12px;
    line-height: 1.55;
    color: hsl(var(--foreground) / 0.6);
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .mood-post-content :global(strong) {
    font-weight: 600;
  }

  .mood-post-content :global(em) {
    font-style: italic;
  }

  .mood-post-content :global(.tg-emoji) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.15em;
    height: 1.15em;
    vertical-align: -0.15em;
  }

  .mood-post-content :global(.tg-emoji img) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .mood-post-content :global(.tg-emoji[data-emoji-animated='true'] img) {
    display: none;
  }

  .mood-post-content :global(.tg-emoji-anim),
  .mood-post-content :global(.tg-emoji-anim svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .mood-post-content :global(blockquote) {
    margin: 4px 0;
    padding: 4px 0 4px 12px;
    background: hsl(var(--foreground) / 0.03);
    border-left: 3px solid hsl(var(--foreground) / 0.25);
    border-radius: 0 6px 6px 0;
    color: hsl(var(--foreground)) !important;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .mood-post-content :global(blockquote *),
  .mood-post-content :global(blockquote a) {
    color: hsl(var(--foreground)) !important;
  }

  .mood-post-content :global(blockquote small) {
    display: block;
    line-height: 1.5;
    white-space: pre-line;
  }

  .mood-post-content :global(blockquote p) {
    margin: 0;
    white-space: pre-line;
  }

  .mood-post-content :global(.image-list-container) {
    margin: 1.5em 0;
    display: grid;
    gap: 8px;
  }

  .mood-post-content :global(.image-list-even) {
    grid-template-columns: repeat(2, 1fr);
  }

  .mood-post-content :global(.image-list-odd) {
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .mood-post-content :global(.image-list-container) {
      gap: 12px;
    }
  }

  .mood-post-content :global(.image-preview-wrap) {
    width: 100%;
    border: none;
    background: none;
    padding: 0;
    cursor: default;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    justify-content: center;
    position: relative;
    aspect-ratio: var(--mood-image-ratio, 4 / 3);
    pointer-events: none;
    transition: none;
    background: hsl(var(--foreground) / 0.02);
    max-width: 100%;
  }

  @media (min-width: 640px) {
    .mood-post-content :global(.image-preview-wrap) {
      border-radius: 16px;
    }
  }

  .mood-post-content :global(.image-preview-wrap:hover) {
    transform: none;
  }

  .mood-post-content :global(.image-preview-wrap > img:not(.mood-image-blur)) {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: none;
    display: block;
    margin: 0 auto;
    background: hsl(var(--foreground) / 0.01);
    object-fit: contain;
  }

  .mood-post-content :global(.image-preview-wrap > img:not(.sticker):not(.mood-image-blur)) {
    box-shadow: inset 0 0 0 1px hsl(var(--foreground) / 0.1);
  }

  .mood-post-content :global(.image-preview-wrap--portrait) {
    max-width: 400px;
    max-height: 60vh;
    margin: 0 auto;
    background: hsl(var(--foreground) / 0.03);
  }

  .mood-post-content :global(.image-preview-wrap--portrait > img:not(.mood-image-blur)) {
    max-height: none;
    width: 100%;
    object-fit: contain;
  }

  .mood-post-content :global(.image-preview-wrap--ultra-tall) {
    max-width: 300px;
    max-height: 70vh;
    margin: 0 auto;
    background: hsl(var(--foreground) / 0.04);
  }

  .mood-post-content :global(.image-preview-wrap--ultra-tall > img:not(.mood-image-blur)) {
    max-height: none;
    width: 100%;
    object-fit: contain;
  }

  .mood-post-content :global(.rich-content-media) {
    width: fit-content;
    max-width: 100%;
    margin: 1.5em 0;
  }

  .mood-post-content :global(.rich-content-media--image.mood-image-frame) {
    display: block;
    width: 100%;
    max-width: 100%;
    aspect-ratio: var(--mood-image-ratio, 4 / 3);
    border-radius: 12px;
  }

  .mood-post-content :global(.rich-content-media--image.mood-image-frame.rich-content-media--portrait) {
    max-width: 400px;
    max-height: 60vh;
    margin-left: auto;
    margin-right: auto;
  }

  .mood-post-content :global(.rich-content-media--image.mood-image-frame.rich-content-media--ultra-tall) {
    max-width: 300px;
    max-height: 70vh;
    margin-left: auto;
    margin-right: auto;
  }

  .mood-post-content :global(.rich-content-media > img:not(.mood-image-blur)) {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
  }

  .mood-post-content :global(.rich-content-media--image.mood-image-frame > [data-mood-image-main]) {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    object-fit: contain;
  }

  .mood-post-content :global(.rich-content-media:not(.rich-content-media--sticker) img) {
    border-radius: 12px;
    box-shadow: inset 0 0 0 1px hsl(var(--foreground) / 0.1);
  }

  .mood-post-content :global(.rich-content-media--sticker) {
    width: min(100%, 256px);
    max-width: 256px;
    aspect-ratio: 1 / 1;
    margin-left: 0;
    margin-right: 0;
  }

  .mood-post-content :global(.rich-content-media--sticker img) {
    width: 100%;
    height: 100%;
    max-width: 256px;
    object-fit: contain;
  }

  .mood-post-content :global(.rich-content-media--portrait) {
    max-width: 400px;
    margin-left: auto;
    margin-right: auto;
  }

  .mood-post-content :global(.rich-content-media--portrait > img:not(.mood-image-blur)) {
    max-height: 60vh;
    object-fit: contain;
  }

  .mood-post-content :global(.rich-content-media--ultra-tall) {
    max-width: 300px;
    margin-left: auto;
    margin-right: auto;
  }

  .mood-post-content :global(.rich-content-media--ultra-tall > img:not(.mood-image-blur)) {
    max-height: 70vh;
    object-fit: contain;
  }

  .mood-post-content :global(.modal) {
    display: none;
    border: none;
    background: hsl(var(--background) / 0.95);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    padding: 20px;
    max-width: 90vw;
    max-height: 90vh;
    border-radius: 12px;
  }

