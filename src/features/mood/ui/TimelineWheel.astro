---
// Timeline wheel - a complete instrument dial, not a sliver of one.
//
// The whole circle sits on screen: graduations around the rim, the date readout
// and the shuffle control inside the hub, an index mark at three o'clock where
// the live date passes. Nothing floats out of it on hover, because there is
// nothing left outside to float.
//
// Only a sector around the index is lit (a conic mask). That is what keeps the
// dial honest: at 24 degrees per date the graduations wrap every fifteen days,
// and a wrapped notch lands in the dark half rather than on top of its twin.
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<nav
  class="timeline-wheel"
  aria-label="Timeline navigation"
  data-timeline-wheel
  data-timeline-wheel-compact={compact ? '' : undefined}
>
  <div class="timeline-wheel-face">
    <!-- Rim -->
    <div class="timeline-wheel-ring"></div>
    <!-- Graduations, lit only in a sector around the index -->
    <div class="timeline-wheel-graduations">
      <div class="timeline-wheel-dial" data-timeline-dial></div>
    </div>
    <!-- Ambient glow behind the live graduation -->
    <div class="timeline-wheel-glow"></div>
    <!-- Fixed index at three o'clock: the date passing here is the live one -->
    <div class="timeline-wheel-index"></div>
    <div class="timeline-wheel-sweep" data-timeline-sweep></div>
    <!-- Hub. The label is a slot-text readout: the active date rolls as you
         scroll, and rolls to "TOP" when you turn back up the feed. -->
    <div class="timeline-wheel-hub">
      <div class="timeline-wheel-label" data-timeline-label></div>
      <button
        type="button"
        class="timeline-wheel-shuffle"
        data-timeline-shuffle
        aria-label="Jump to a random day"
      >
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path
            d="M1.5 4.5h2.2c1 0 1.6.5 2.2 1.4l3.4 4.7c.5.8 1.1 1.3 2.2 1.3h2"
            fill="none"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
          />
          <path
            d="M1.5 11.9h2.2c1 0 1.6-.5 2.2-1.4l3.4-4.7c.5-.8 1.1-1.3 2.2-1.3h2"
            fill="none"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
          />
          <path
            d="M11.9 2.6 13.9 4.5l-2 1.9M11.9 10.1l2 1.8-2 1.9"
            fill="none"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>
    </div>
  </div>
  <!-- The dial is both readout and input. Click winds back to the top of the
       feed; drag turns it to scrub by date; arrow keys step one day. -->
  <button
    type="button"
    class="timeline-wheel-top"
    data-timeline-top
    aria-label="Back to top. Drag or use arrow keys to scrub the timeline"
    aria-keyshortcuts="ArrowUp ArrowDown"
  ></button>
</nav>

<style>
  /* ── Container ── */
  .timeline-wheel {
    position: fixed;
    left: 22px;
    top: 50%;
    /* The dial's full diameter. Every radius below is derived from it, so one
       value resizes the instrument. */
    --wheel-size: 168px;
    /* The band the graduations occupy, measured inward from the rim. Every
       notch length is a fraction of it, so the whole scale rescales with the
       dial. --rim-gap is the hair of clearance between a tip and the rim. */
    --notch-band: 30px;
    --rim-gap: 5px;
    width: var(--wheel-size);
    height: var(--wheel-size);
    transform: translateY(-50%) translateX(-8px);
    z-index: 50;
    display: none;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .timeline-wheel.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(-50%) translateX(0);
  }

  @media (min-width: 1024px) {
    .timeline-wheel {
      display: block;
    }
  }

  @media (min-width: 1280px) {
    .timeline-wheel {
      left: 28px;
      --wheel-size: 188px;
      --notch-band: 34px;
    }
  }

  @media (min-width: 1440px) {
    .timeline-wheel {
      left: 34px;
      --wheel-size: 208px;
      --notch-band: 38px;
    }
  }

  .timeline-wheel-face {
    position: absolute;
    inset: 0;
    border-radius: 50%;
  }

  /* ── Rim ── */
  .timeline-wheel-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid hsl(var(--foreground) / 0.09);
    background: radial-gradient(
      circle at 50% 50%,
      hsl(var(--background) / 0.72) 0%,
      hsl(var(--background) / 0.5) 62%,
      transparent 100%
    );
    -webkit-backdrop-filter: blur(14px) saturate(1.15);
    backdrop-filter: blur(14px) saturate(1.15);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.03),
      0 10px 30px -14px rgba(0, 0, 0, 0.16),
      inset 0 0.5px 0 hsl(var(--foreground) / 0.05);
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  /* Inner gauge ring, the way a real instrument has a bezel and a face. */
  .timeline-wheel-ring::after {
    content: '';
    position: absolute;
    inset: calc(var(--notch-band) + 10px);
    border-radius: 50%;
    border: 1px solid hsl(var(--foreground) / 0.05);
  }

  /* ── Graduations ──
     Lit in a wide sector centred on the index and dissolving into the dark
     behind. The conic gradient starts at 90deg so its 0deg sits on the index.
     Any window narrower than a full turn is enough: twins are exactly 360deg
     apart, so a wrapped graduation can never share the lit arc with its own. */
  .timeline-wheel-graduations {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    -webkit-mask-image: conic-gradient(
      from 90deg at 50% 50%,
      #000 0deg,
      #000 96deg,
      transparent 138deg,
      transparent 222deg,
      #000 264deg,
      #000 360deg
    );
    mask-image: conic-gradient(
      from 90deg at 50% 50%,
      #000 0deg,
      #000 96deg,
      transparent 138deg,
      transparent 222deg,
      #000 264deg,
      #000 360deg
    );
  }

  /* ── Rotating dial ── */
  .timeline-wheel-dial {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    will-change: transform;
  }

  /* ── Ambient glow behind the live graduation ── */
  .timeline-wheel-glow {
    position: absolute;
    right: -4px;
    top: 50%;
    width: 54px;
    height: 54px;
    transform: translateY(-50%);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      hsl(var(--foreground) / 0.05) 0%,
      transparent 70%
    );
    opacity: 0.5;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .timeline-wheel.is-scrolling .timeline-wheel-glow {
    opacity: 1;
  }

  /* ── Index ──
     A wedge outside the rim at three o'clock, pointing in at whichever
     graduation is live. The dial turns; this never does. */
  .timeline-wheel-index {
    position: absolute;
    right: -13px;
    top: 50%;
    width: 0;
    height: 0;
    transform: translateY(-50%);
    border-top: 4.5px solid transparent;
    border-bottom: 4.5px solid transparent;
    border-right: 7px solid hsl(var(--foreground) / 0.55);
    pointer-events: none;
    transition: border-right-color 0.3s ease;
  }

  /* ── Notches ── */

  /* Base minor notch. --notch-weight (0-1, set by the controller) is that day's
     post count: the graduations are longer and heavier over a busy day, so the
     dial reads as the terrain of the archive rather than as even decoration.
     The 0.35 fallback keeps skeleton and unmeasured notches at a plain look.
     Every notch is placed by --notch-len, which also sets its width, so the
     outer tips all land on the rim and the scale reads as one clean circle. */
  :global(.timeline-notch) {
    --notch-len: calc(var(--notch-band) * (0.26 + var(--notch-weight, 0.35) * 0.16));
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--notch-len);
    height: 1.5px;
    margin-top: -0.75px;
    background: hsl(var(--foreground) / calc(0.06 + var(--notch-weight, 0.35) * 0.1));
    border-radius: 0 1px 1px 0;
    transform-origin: left center;
    transition:
      background 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      width 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      height 0.2s ease,
      box-shadow 0.3s ease;
  }

  /* Major notch (date marker) */
  :global(.timeline-notch.is-major) {
    --notch-len: calc(var(--notch-band) * (0.54 + var(--notch-weight, 0.35) * 0.46));
    height: 2px;
    margin-top: -1px;
    background: hsl(var(--muted-foreground) / calc(0.18 + var(--notch-weight, 0.35) * 0.2));
    border-radius: 0 1.5px 1.5px 0;
  }

  /* Near notches (±2 from active) */
  :global(.timeline-notch.is-near) {
    background: hsl(var(--foreground) / 0.2);
  }
  :global(.timeline-notch.is-major.is-near) {
    background: hsl(var(--foreground) / 0.32);
  }

  /* Neighbor notches (±1 from active) */
  :global(.timeline-notch.is-neighbor) {
    background: hsl(var(--foreground) / 0.34);
  }
  :global(.timeline-notch.is-major.is-neighbor) {
    background: hsl(var(--foreground) / 0.5);
  }

  /* Active notch. The major one is the single graduation allowed to break the
     circle: a negative rim gap pushes its tip out past the rim, at the index. */
  :global(.timeline-notch.is-active) {
    background: hsl(var(--foreground) / 0.8);
    --notch-len: calc(var(--notch-band) * 0.6);
  }
  :global(.timeline-notch.is-major.is-active) {
    --rim-gap: -3px;
    --notch-len: calc(var(--notch-band) + 3px);
    height: 2.5px;
    margin-top: -1.25px;
    background: hsl(var(--foreground));
    box-shadow:
      0 0 8px hsl(var(--foreground) / 0.12),
      0 0 20px hsl(var(--foreground) / 0.06);
  }

  /* Pip dot on major notch tip */
  :global(.timeline-notch-pip) {
    position: absolute;
    right: -3px;
    top: 50%;
    width: 5px;
    height: 5px;
    /* 0.6, not 0: at 5px the dot is already tiny, and growing it from nothing
       reads as materialising rather than arriving. Opacity carries the
       appearance. */
    transform: translateY(-50%) scale(0.6);
    border-radius: 50%;
    background: hsl(var(--foreground));
    opacity: 0;
    transition:
      opacity 0.3s ease,
      transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  :global(.timeline-notch.is-major.is-active .timeline-notch-pip) {
    opacity: 1;
    transform: translateY(-50%) scale(1);
    box-shadow: 0 0 6px hsl(var(--foreground) / 0.2);
    animation: pip-pulse 2.5s ease-in-out infinite;
  }

  @keyframes pip-pulse {
    0%, 100% { box-shadow: 0 0 6px hsl(var(--foreground) / 0.2); }
    50% { box-shadow: 0 0 12px hsl(var(--foreground) / 0.35); }
  }

  /* ── Hub ──
     Readout and shuffle live at the centre of the face. Both were floating
     satellites before; inside the dial they need no pill, no connector, and
     nothing has to fly out on hover to be found. */
  .timeline-wheel-hub {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    justify-items: center;
    gap: 5px;
    z-index: 4;
    pointer-events: none;
  }

  /* Date label - a slot-text readout. The active date rolls in as you scroll;
     the controller rolls it to the back-to-top cue when you turn back up. */
  .timeline-wheel-label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: hsl(var(--foreground) / 0.85);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    transition: color 0.3s ease;
  }

  @media (min-width: 1280px) {
    .timeline-wheel-label {
      font-size: 11px;
    }
  }

  /* ── Shuffle: spin to a random loaded day ──
     Always present, just quiet. It brightens under the cursor; it does not
     appear, slide, or spring. */
  .timeline-wheel-shuffle {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    margin: 0;
    padding: 0;
    color: hsl(var(--foreground) / 0.4);
    background: transparent;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    pointer-events: auto;
    /* It shares the dial's drag handlers, so a touch that starts on the glyph
       must not be stolen by the page scroller either. */
    touch-action: none;
    -webkit-appearance: none;
    appearance: none;
    transition: color 0.24s ease, background 0.24s ease;
  }

  .timeline-wheel-shuffle svg {
    width: 13px;
    height: 13px;
  }

  .timeline-wheel:hover .timeline-wheel-shuffle {
    color: hsl(var(--foreground) / 0.62);
  }

  .timeline-wheel-shuffle:hover {
    color: hsl(var(--foreground));
    background: hsl(var(--foreground) / 0.07);
  }

  .timeline-wheel-shuffle:focus-visible {
    outline: 2px solid hsl(var(--foreground) / 0.5);
    outline-offset: 2px;
  }

  /* The shuffle control is an affordance for the dial, not for a loading
     skeleton or an empty feed. */
  .timeline-wheel.is-loading .timeline-wheel-shuffle {
    visibility: hidden;
  }

  /* ── The drag surface ── */
  .timeline-wheel-top {
    position: absolute;
    inset: 0;
    z-index: 3;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    /* The dial reads as a thing you can take hold of; a plain click still
       means back to top. touch-action keeps a touch drag on the dial from
       being stolen by the page scroller. */
    cursor: grab;
    touch-action: none;
    -webkit-appearance: none;
    appearance: none;
  }

  .timeline-wheel.is-engaged .timeline-wheel-top {
    cursor: grabbing;
  }

  .timeline-wheel-top:focus-visible {
    outline: 2px solid hsl(var(--foreground) / 0.5);
    outline-offset: 4px;
  }

  /* ── Hover: the instrument quietly illuminates under the cursor ──
     Brightness only. Nothing moves, nothing emerges, no layout shift. */
  .timeline-wheel:hover .timeline-wheel-ring {
    border-color: hsl(var(--foreground) / 0.16);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.04),
      0 12px 34px -14px rgba(0, 0, 0, 0.2),
      inset 0 0.5px 0 hsl(var(--foreground) / 0.07);
  }

  .timeline-wheel:hover .timeline-wheel-glow {
    opacity: 1;
  }

  .timeline-wheel:hover .timeline-wheel-index {
    border-right-color: hsl(var(--foreground) / 0.8);
  }

  .timeline-wheel:hover .timeline-wheel-label {
    color: hsl(var(--foreground));
  }

  /* ── Engaged: the dial is being driven, not just read ──
     Same restraint as hover. The graduations gain weight so the sector under
     the hand reads as live; the dial does not lift off the page. */
  /* :not(.is-active) matters: these rules and the active ones carry the same
     specificity, and coming later they would otherwise wash the live
     graduation out at the exact moment you are steering by it. */
  .timeline-wheel.is-engaged :global(.timeline-notch:not(.is-active)) {
    background: hsl(var(--foreground) / calc(0.12 + var(--notch-weight, 0.35) * 0.12));
  }

  .timeline-wheel.is-engaged :global(.timeline-notch.is-major:not(.is-active)) {
    background: hsl(var(--foreground) / calc(0.28 + var(--notch-weight, 0.35) * 0.2));
  }

  .timeline-wheel.is-engaged .timeline-wheel-index {
    border-right-color: hsl(var(--foreground));
  }

  .timeline-wheel.is-engaged .timeline-wheel-label {
    color: hsl(var(--foreground));
  }

  /* ── Hint pulse: the rare auto cue gets a single glow bloom for weight ── */
  .timeline-wheel.is-hinting .timeline-wheel-glow {
    animation: wheel-hint-pulse 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes wheel-hint-pulse {
    0% { opacity: 0.5; transform: translateY(-50%) scale(1); }
    35% { opacity: 1; transform: translateY(-50%) scale(1.4); }
    100% { opacity: 0.5; transform: translateY(-50%) scale(1); }
  }

  /* ── Loading skeleton state (GSAP-driven) ── */
  :global(.timeline-notch.is-skeleton) {
    background: hsl(var(--foreground) / 0.08);
    opacity: 0;
  }

  :global(.timeline-notch.is-major.is-skeleton) {
    background: hsl(var(--foreground) / 0.15);
  }

  /* Hide the readout during loading */
  .timeline-wheel.is-loading .timeline-wheel-label {
    opacity: 0 !important;
  }

  /* Glow base during loading (GSAP drives the tick pulse) */
  .timeline-wheel.is-loading .timeline-wheel-glow {
    opacity: 0.1;
  }

  .timeline-wheel.is-loading .timeline-wheel-index {
    border-right-color: hsl(var(--foreground) / 0.2);
  }

  /* ── Centre sweep indicator (loading focal point) ── */
  .timeline-wheel-sweep {
    position: absolute;
    right: calc(var(--notch-band) - 6px);
    top: 50%;
    transform: translateY(-50%);
    width: 26px;
    height: 1.5px;
    background: linear-gradient(
      to right,
      hsl(var(--foreground) / 0.06),
      hsl(var(--foreground) / 0.3)
    );
    border-radius: 1px;
    opacity: 0;
    pointer-events: none;
    z-index: 2;
  }

  .timeline-wheel-sweep::after {
    content: '';
    position: absolute;
    right: -2.5px;
    top: 50%;
    width: 4px;
    height: 4px;
    transform: translateY(-50%);
    border-radius: 50%;
    background: hsl(var(--foreground) / 0.3);
  }

  /* ── Reduced motion: show skeleton notches statically ── */
  @media (prefers-reduced-motion: reduce) {
    .timeline-wheel {
      transition: none;
    }
    .timeline-wheel-dial,
    :global(.timeline-notch),
    :global(.timeline-notch-pip),
    .timeline-wheel-glow,
    .timeline-wheel-sweep,
    .timeline-wheel-shuffle {
      transition: none !important;
      animation: none !important;
    }
    :global(.timeline-notch.is-skeleton) {
      opacity: 0.5;
    }
  }
</style>

<script>
  // The wheel is display:none below 1024px (rule above), so narrow viewports
  // skip its module and scroll wiring entirely. It mounts lazily the first
  // time the viewport crosses the breakpoint.
  const mountAll = async () => {
    const { mountTimelineWheel } = await import('@/features/mood/client/timeline-wheel');
    document.querySelectorAll('[data-timeline-wheel]').forEach((root) => {
      const habitat = root.closest('main');
      const feed = habitat?.querySelector('[data-mood-feed]');
      const list = habitat?.querySelector('[data-mood-list]');

      if (root instanceof HTMLElement && feed instanceof HTMLElement && list instanceof HTMLElement) {
        mountTimelineWheel(root, { feed, list });
      }
    });
  };

  const wide = window.matchMedia('(min-width: 1024px)');
  if (wide.matches) {
    void mountAll();
  } else {
    const onWiden = (event: MediaQueryListEvent) => {
      if (!event.matches) return;
      wide.removeEventListener('change', onWiden);
      void mountAll();
    };
    wide.addEventListener('change', onWiden);
  }
</script>
