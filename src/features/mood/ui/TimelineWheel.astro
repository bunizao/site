---
// Timeline wheel - precision instrument aesthetic
// Only the right arc visible at screen edge with refined visual feedback
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<nav
  class="timeline-wheel"
  aria-label="Timeline navigation"
  data-timeline-wheel
  data-timeline-wheel-compact={compact ? '' : undefined}
>
  <!-- Vertical track rail -->
  <div class="timeline-wheel-track"></div>
  <!-- Masked arc + notches -->
  <div class="timeline-wheel-arc">
    <div class="timeline-wheel-dial" data-timeline-dial></div>
    <div class="timeline-wheel-sweep" data-timeline-sweep></div>
  </div>
  <!-- Ambient glow at active center -->
  <div class="timeline-wheel-glow"></div>
  <!-- Label with connector. The label is a slot-text readout: the active date
       rolls as you scroll, and rolls to "↑ TOP" when you pause deep in the feed. -->
  <div class="timeline-wheel-label-wrap">
    <div class="timeline-wheel-connector"></div>
    <div class="timeline-wheel-label" data-timeline-label></div>
  </div>
  <!-- The wheel is both readout and input. Click winds back to the top of the
       feed; drag scrubs the timeline by date; arrow keys step one date. -->
  <button
    type="button"
    class="timeline-wheel-top"
    data-timeline-top
    aria-label="Back to top. Drag or use arrow keys to scrub the timeline"
    aria-keyshortcuts="ArrowUp ArrowDown"
  ></button>
</nav>

<style>
  /* ── Container ── */
  .timeline-wheel {
    position: fixed;
    left: 0;
    top: 50%;
    transform: translateY(-50%) translateX(-10px);
    --wheel-size: 600px;
    --visible-width: 44px;
    width: var(--visible-width);
    height: 360px;
    z-index: 50;
    display: none;
    opacity: 0;
    pointer-events: none;
    /* An instrument, not text: a long press on it must not select the readout
       or raise the iOS callout. */
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    transition:
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: visible;
  }

  .timeline-wheel.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(-50%) translateX(0);
  }

  @media (min-width: 1024px) {
    .timeline-wheel {
      display: block;
    }
  }

  @media (min-width: 1280px) {
    .timeline-wheel {
      --wheel-size: 700px;
      --visible-width: 52px;
      height: 400px;
    }
  }

  @media (min-width: 1440px) {
    .timeline-wheel {
      --wheel-size: 800px;
      --visible-width: 60px;
      height: 440px;
    }
  }

  /* ── Vertical track rail ── */
  .timeline-wheel-track {
    position: absolute;
    left: 2px;
    top: 5%;
    bottom: 5%;
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      hsl(var(--foreground) / 0.06) 15%,
      hsl(var(--foreground) / 0.1) 50%,
      hsl(var(--foreground) / 0.06) 85%,
      transparent 100%
    );
    border-radius: 1px;
  }

  /* ── Arc mask ── */
  .timeline-wheel-arc {
    position: absolute;
    inset: 0;
    overflow: visible;
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      black 12%,
      black 88%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      black 12%,
      black 88%,
      transparent 100%
    );
  }

  /* ── Rotating dial ── */
  .timeline-wheel-dial {
    position: absolute;
    width: var(--wheel-size);
    height: var(--wheel-size);
    top: 50%;
    right: 0;
    transform: translateY(-50%);
    border-radius: 50%;
    border: 1px solid hsl(var(--foreground) / 0.04);
    /* Its own layer, rasterised once: Safari then rotates a cached texture
       instead of repainting a few hundred notches on every frame. */
    will-change: transform;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  /* ── Ambient glow ── */
  .timeline-wheel-glow {
    position: absolute;
    left: -6px;
    top: 50%;
    width: 48px;
    height: 48px;
    transform: translateY(-50%);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      hsl(var(--foreground) / 0.03) 0%,
      transparent 70%
    );
    opacity: 0.5;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .timeline-wheel.is-scrolling .timeline-wheel-glow {
    opacity: 1;
  }

  /* ── Notches ── */

  /* Base minor notch. --notch-weight (0-1, set by the controller) is that day's
     post count: the graduations are longer and heavier over a busy day, so the
     dial reads as the terrain of the archive rather than as even decoration.
     The 0.35 fallback keeps skeleton and unmeasured notches at the old look. */
  :global(.timeline-notch) {
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(11px + var(--notch-weight, 0.35) * 9px);
    height: 1.5px;
    margin-top: -0.75px;
    background: hsl(var(--foreground) / calc(0.05 + var(--notch-weight, 0.35) * 0.09));
    border-radius: 0 1px 1px 0;
    transform-origin: left center;
    transition:
      background 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      width 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      height 0.2s ease,
      box-shadow 0.3s ease;
  }

  /* Major notch (date marker) */
  :global(.timeline-notch.is-major) {
    width: calc(18px + var(--notch-weight, 0.35) * 13px);
    height: 2px;
    margin-top: -1px;
    background: hsl(var(--muted-foreground) / calc(0.14 + var(--notch-weight, 0.35) * 0.18));
    border-radius: 0 1.5px 1.5px 0;
  }

  /* Near notches (±2 from active) */
  :global(.timeline-notch.is-near) {
    background: hsl(var(--foreground) / 0.18);
  }
  :global(.timeline-notch.is-major.is-near) {
    width: 26px;
    background: hsl(var(--foreground) / 0.28);
  }

  /* Neighbor notches (±1 from active) */
  :global(.timeline-notch.is-neighbor) {
    background: hsl(var(--foreground) / 0.3);
  }
  :global(.timeline-notch.is-major.is-neighbor) {
    width: 30px;
    background: hsl(var(--foreground) / 0.45);
  }

  /* Active notch */
  :global(.timeline-notch.is-active) {
    background: hsl(var(--foreground) / 0.8);
    width: 18px;
    height: 2px;
    margin-top: -1px;
  }
  :global(.timeline-notch.is-major.is-active) {
    width: 36px;
    height: 2.5px;
    margin-top: -1.25px;
    background: hsl(var(--foreground));
    box-shadow:
      0 0 8px hsl(var(--foreground) / 0.1),
      0 0 20px hsl(var(--foreground) / 0.05);
  }

  /* Pip dot on major notch tip */
  :global(.timeline-notch-pip) {
    position: absolute;
    right: -3px;
    top: 50%;
    width: 5px;
    height: 5px;
    /* 0.6, not 0: at 5px the dot is already tiny, and growing it from nothing
       reads as materialising rather than arriving. Opacity carries the
       appearance. */
    transform: translateY(-50%) scale(0.6);
    border-radius: 50%;
    background: hsl(var(--foreground));
    opacity: 0;
    transition:
      opacity 0.3s ease,
      transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  :global(.timeline-notch.is-major.is-active .timeline-notch-pip) {
    opacity: 1;
    transform: translateY(-50%) scale(1);
    box-shadow: 0 0 6px hsl(var(--foreground) / 0.2);
  }

  /* The pulse is a halo on its own layer, animated in opacity and scale only.
     Animating the pip's box-shadow instead repainted the dial texture on every
     frame for as long as a date was active, which is always. */
  :global(.timeline-notch-pip::after) {
    content: '';
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    background: radial-gradient(circle, hsl(var(--foreground) / 0.28), transparent 70%);
    opacity: 0;
    will-change: transform, opacity;
  }

  :global(.timeline-notch.is-major.is-active .timeline-notch-pip::after) {
    animation: pip-pulse 2.5s ease-in-out infinite;
  }

  @keyframes pip-pulse {
    0%, 100% { opacity: 0.35; transform: scale(0.8); }
    50% { opacity: 1; transform: scale(1.25); }
  }

  /* ── Label group ── */
  .timeline-wheel-label-wrap {
    position: absolute;
    left: calc(var(--visible-width) + 4px);
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    z-index: 2;
    pointer-events: none;
    opacity: 0;
    will-change: opacity;
    transition: opacity 0.4s ease;
  }

  .timeline-wheel.is-visible .timeline-wheel-label-wrap {
    opacity: 1;
  }

  /* Connector line from arc to label */
  .timeline-wheel-connector {
    width: 14px;
    height: 1px;
    background: linear-gradient(
      to right,
      hsl(var(--foreground) / 0.18),
      hsl(var(--foreground) / 0.06)
    );
    flex-shrink: 0;
  }

  /* Date label — a slot-text readout. The active date rolls in as you scroll;
     the controller rolls it to "↑ TOP" on hover and on a pause deep in the feed. */
  .timeline-wheel-label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: hsl(var(--foreground) / 0.8);
    white-space: nowrap;

    padding: 5px 10px;
    background: hsl(var(--background) / 0.75);
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
    backdrop-filter: blur(16px) saturate(1.2);
    border: 1px solid hsl(var(--foreground) / 0.06);
    border-radius: 6px;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.03),
      0 4px 12px -2px rgba(0, 0, 0, 0.06),
      inset 0 0.5px 0 hsl(var(--foreground) / 0.04);

    font-variant-numeric: tabular-nums;
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  /* The wheel telegraphs its back-to-top role on hover: the readout brightens
     and the cursor turns actionable. The hit target includes the visible
     readout, not just the narrow arc at the viewport edge. */
  .timeline-wheel-top {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: calc(var(--visible-width) + 120px);
    z-index: 3;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    /* The wheel reads as a thing you can take hold of; a plain click still
       means back to top. touch-action keeps a touch drag on the dial from
       being stolen by the page scroller. */
    cursor: grab;
    touch-action: none;
    -webkit-appearance: none;
    appearance: none;
  }

  .timeline-wheel.is-engaged .timeline-wheel-top {
    cursor: grabbing;
  }

  .timeline-wheel-top:focus-visible {
    outline: 2px solid hsl(var(--foreground) / 0.5);
    outline-offset: 4px;
    border-radius: 10px;
  }

  /* ── Hover: the instrument quietly illuminates under the cursor ── */
  /* The readout brightens, a soft halo blooms at the active centre, and the
     live mark extends a touch — minimal, no layout shift, no extra chrome.
     Driven by a class the controller sets from a mouse pointer, never by the
     hover pseudo-class. iOS Safari treats the first touch on anything whose
     hover rules reveal content as a hover rather than a press, so the wheel
     needed a tap to wake before it would take a drag; and it pins the hover
     state to whatever was last tapped, so it stayed lit after every scrub. */
  .timeline-wheel.is-hovering .timeline-wheel-label {
    color: hsl(var(--foreground));
    border-color: hsl(var(--foreground) / 0.14);
  }

  .timeline-wheel.is-hovering .timeline-wheel-glow {
    opacity: 1;
  }

  .timeline-wheel.is-hovering .timeline-wheel-connector {
    background: linear-gradient(
      to right,
      hsl(var(--foreground) / 0.32),
      hsl(var(--foreground) / 0.1)
    );
  }

  .timeline-wheel.is-hovering :global(.timeline-notch.is-major.is-active) {
    width: 42px;
    background: hsl(var(--foreground));
    box-shadow:
      0 0 10px hsl(var(--foreground) / 0.16),
      0 0 26px hsl(var(--foreground) / 0.08);
  }

  /* ── Engaged: the wheel is being driven, not just read ──────────────────
     The halo comes up and the live graduation takes the weight hover gives it.
     Nothing else changes. Lengthening every graduation on engage looked like
     the instrument coming under the hand, but it also started a transition on
     a few hundred notches at once: a repaint burst at the first frame of every
     drag, which on a tablet is a hitch exactly where the finger lands.

     Nothing here may move the wheel itself either. It used to lean out from
     the edge on a translateX, which peeled the arc off the left of the screen
     and left a blank wedge down the side for as long as the gesture lasted. */
  .timeline-wheel.is-engaged .timeline-wheel-glow {
    opacity: 1;
  }

  /* Driving the dial gives the live graduation the same weight hover does. */
  .timeline-wheel.is-engaged :global(.timeline-notch.is-major.is-active) {
    width: 42px;
    background: hsl(var(--foreground));
    box-shadow:
      0 0 10px hsl(var(--foreground) / 0.16),
      0 0 26px hsl(var(--foreground) / 0.08);
  }

  .timeline-wheel.is-engaged .timeline-wheel-label {
    color: hsl(var(--foreground));
    border-color: hsl(var(--foreground) / 0.2);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.04),
      0 6px 18px -4px rgba(0, 0, 0, 0.1),
      inset 0 0.5px 0 hsl(var(--foreground) / 0.06);
  }

  /* ── Hint pulse: the rare auto cue gets a single glow bloom for weight ── */
  .timeline-wheel.is-hinting .timeline-wheel-glow {
    animation: wheel-hint-pulse 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes wheel-hint-pulse {
    0% { opacity: 0.5; transform: translateY(-50%) scale(1); }
    35% { opacity: 1; transform: translateY(-50%) scale(1.4); }
    100% { opacity: 0.5; transform: translateY(-50%) scale(1); }
  }

  /* ── Loading skeleton state (GSAP-driven) ── */
  :global(.timeline-notch.is-skeleton) {
    background: hsl(var(--foreground) / 0.08);
    opacity: 0;
  }

  :global(.timeline-notch.is-major.is-skeleton) {
    background: hsl(var(--foreground) / 0.15);
    width: 24px;
  }

  /* Hide label during loading */
  .timeline-wheel.is-loading .timeline-wheel-label-wrap {
    opacity: 0 !important;
  }

  /* Glow base during loading (GSAP drives the tick pulse) */
  .timeline-wheel.is-loading .timeline-wheel-glow {
    opacity: 0.1;
  }

  /* Subtle dial border accent during loading */
  .timeline-wheel.is-loading .timeline-wheel-dial {
    border-color: hsl(var(--foreground) / 0.06);
  }

  /* Inner gauge ring during loading */
  .timeline-wheel.is-loading .timeline-wheel-dial::after {
    content: '';
    position: absolute;
    inset: 18px;
    border-radius: 50%;
    border: 1px solid hsl(var(--foreground) / 0.03);
    pointer-events: none;
  }

  /* ── Center sweep indicator (loading focal point) ── */
  .timeline-wheel-sweep {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 30px;
    height: 1.5px;
    background: linear-gradient(
      to right,
      hsl(var(--foreground) / 0.3),
      hsl(var(--foreground) / 0.06)
    );
    border-radius: 1px;
    opacity: 0;
    pointer-events: none;
    z-index: 2;
  }

  .timeline-wheel-sweep::after {
    content: '';
    position: absolute;
    right: -2.5px;
    top: 50%;
    width: 4px;
    height: 4px;
    transform: translateY(-50%);
    border-radius: 50%;
    background: hsl(var(--foreground) / 0.3);
  }

  /* ── Reduced motion: show skeleton notches statically ── */
  @media (prefers-reduced-motion: reduce) {
    .timeline-wheel {
      transition: none;
    }
    .timeline-wheel-dial,
    :global(.timeline-notch),
    :global(.timeline-notch-pip),
    .timeline-wheel-glow,
    .timeline-wheel-sweep {
      transition: none !important;
      animation: none !important;
    }
    :global(.timeline-notch.is-skeleton) {
      opacity: 0.5;
    }
  }
</style>

<script>
  // The wheel is display:none below 1024px (rule above), so narrow viewports
  // skip its module and scroll wiring entirely. It mounts lazily the first
  // time the viewport crosses the breakpoint.
  const mountAll = async () => {
    const { mountTimelineWheel } = await import('@/features/mood/client/timeline-wheel');
    document.querySelectorAll('[data-timeline-wheel]').forEach((root) => {
      const habitat = root.closest('main');
      const feed = habitat?.querySelector('[data-mood-feed]');
      const list = habitat?.querySelector('[data-mood-list]');

      if (root instanceof HTMLElement && feed instanceof HTMLElement && list instanceof HTMLElement) {
        mountTimelineWheel(root, { feed, list });
      }
    });
  };

  const wide = window.matchMedia('(min-width: 1024px)');
  if (wide.matches) {
    void mountAll();
  } else {
    const onWiden = (event: MediaQueryListEvent) => {
      if (!event.matches) return;
      wide.removeEventListener('change', onWiden);
      void mountAll();
    };
    wide.addEventListener('change', onWiden);
  }
</script>
