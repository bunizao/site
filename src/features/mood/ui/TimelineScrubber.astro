---
// The phone's timeline instrument: a date scrubber on the right edge for
// viewports too narrow for the jog wheel. Touch the rail and slide; the thumb
// sits under the finger and a bubble names the date. See timeline-scrubber.ts.
---

<div class="timeline-scrubber" data-timeline-scrubber aria-hidden="true">
  <div class="timeline-scrubber-rail" data-timeline-scrubber-rail>
    <div class="timeline-scrubber-thumb" data-timeline-scrubber-thumb>
      <div class="timeline-scrubber-bubble" data-timeline-scrubber-bubble></div>
    </div>
  </div>
</div>

<style>
  .timeline-scrubber {
    position: fixed;
    inset: 0 0 0 auto;
    width: 28px;
    z-index: 50;
    display: none;
    pointer-events: none;
    /* An instrument, not text: a long press must not select or raise the
       iOS callout. */
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }

  @media (max-width: 1023px) {
    .timeline-scrubber.is-visible {
      display: block;
    }

    /* The scrubber is the scroll indicator here; two side by side would be
       noise. */
    :global(body:has(.timeline-scrubber.is-visible) [data-page-scroller]) {
      scrollbar-width: none;
    }

    :global(body:has(.timeline-scrubber.is-visible) [data-page-scroller]::-webkit-scrollbar) {
      display: none;
    }
  }

  /* The touch zone runs the full edge between the top chrome and the bottom
     safe area, so a finger finds it without looking. */
  .timeline-scrubber-rail {
    position: absolute;
    right: 0;
    width: 28px;
    top: calc(env(safe-area-inset-top, 0px) + 112px);
    bottom: calc(env(safe-area-inset-bottom, 0px) + 88px);
    pointer-events: auto;
    touch-action: none;
  }

  .timeline-scrubber-thumb {
    position: absolute;
    top: 0;
    right: 4px;
    width: 5px;
    height: 44px;
    border-radius: 999px;
    background: hsl(var(--foreground) / 0.32);
    opacity: 0;
    will-change: transform;
    transition:
      opacity 0.35s ease,
      width 0.2s ease,
      background-color 0.2s ease;
  }

  .timeline-scrubber.is-scrolling .timeline-scrubber-thumb,
  .timeline-scrubber.is-engaged .timeline-scrubber-thumb {
    opacity: 1;
  }

  .timeline-scrubber.is-engaged .timeline-scrubber-thumb {
    width: 6px;
    background: hsl(var(--foreground) / 0.72);
  }

  /* The date rides beside the finger, only while it is on the rail. */
  .timeline-scrubber-bubble {
    position: absolute;
    right: calc(100% + 14px);
    top: 50%;
    padding: 7px 12px;
    border-radius: 999px;
    background: hsl(var(--foreground) / 0.92);
    color: hsl(var(--background));
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.02em;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(-50%) translateX(6px);
    transition:
      opacity 0.18s ease,
      transform 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .timeline-scrubber.is-engaged .timeline-scrubber-bubble {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-scrubber-thumb,
    .timeline-scrubber-bubble {
      transition: none;
    }
  }
</style>

<script>
  // Narrow viewports only; the wheel takes over from 1024px. Mounts lazily the
  // first time the viewport is narrow.
  const mountAll = async () => {
    const { mountTimelineScrubber } = await import('@/features/mood/client/timeline-scrubber');
    document.querySelectorAll('[data-timeline-scrubber]').forEach((root) => {
      const habitat = root.closest('main');
      const feed = habitat?.querySelector('[data-mood-feed]');
      const list = habitat?.querySelector('[data-mood-list]');

      if (root instanceof HTMLElement && feed instanceof HTMLElement && list instanceof HTMLElement) {
        mountTimelineScrubber(root, { feed, list });
      }
    });
  };

  const narrow = window.matchMedia('(max-width: 1023px)');
  if (narrow.matches) {
    void mountAll();
  } else {
    const onNarrow = (event: MediaQueryListEvent) => {
      if (!event.matches) return;
      narrow.removeEventListener('change', onNarrow);
      void mountAll();
    };
    narrow.addEventListener('change', onNarrow);
  }
</script>
