---
/* The mood detail page's compose box -- vanilla .astro + client TS, no
   React. Renders in place of the "Leave a comment on Telegram" CTA row once
   the loaded post's `discussionLinked` is true (CommentsSection.astro
   decides which one to render).

   Behavioural markup is borrowed verbatim from the blog's compose box:
   `.blog-compose`, `[data-compose-identity]`, `.blog-compose__input`,
   `.blog-compose__field`, `[data-compose-count]`, `[data-compose-error*]`,
   `[data-compose-recommend]`, `[data-compose-submit]`, the `website`
   honeypot -- so compose-validate.ts, drafts.ts, and the risk-stack modules
   under src/features/comments/client/ work unmodified. `data-locale="en"`
   is what makes their shared copy table (copy.ts) resolve to English here;
   the mood zone has no zh variant to keep in sync with it.

   What is NOT reused from the blog: the three-phase reader identity
   (anonymous/claimed/ready), reader sessions, and the subscribe nudge. Mood
   comments are always anonymous -- `data-phase` never changes off
   "anonymous" -- and email stays optional, matching the blog's own default
   (plans/mood-comments-bridge.md, open decision #2). The submit itself,
   Turnstile wiring, and the reply chip are client/detail-compose.ts, which
   also owns the actual POST -- this component only renders. */

import { ICONS } from '@/features/comments/icons';
import { moodCommentsCopy } from '@/features/comments/copy';

interface Props {
  postId: string;
  /** MoodContentDocument.discussionRepliesEnabled -- gates whether a Reply
      button on a `telegram`-origin comment is allowed to send a parentId.
      Read by detail-comments-controller.ts off this box's data attribute
      rather than threaded through as a second prop everywhere. */
  discussionRepliesEnabled?: boolean;
  /** Same key the blog page passes to CommentsSection -- see
      src/lib/turnstile-site-key.ts. Empty on the e2e fixture path, which
      skips Turnstile entirely (see turnstile-token.ts). */
  turnstileSiteKey?: string;
}

const {
  postId,
  discussionRepliesEnabled = false,
  turnstileSiteKey = '',
} = Astro.props;

const t = moodCommentsCopy;
---

<div
  class="mood-compose blog-compose"
  data-mood-compose
  data-phase="anonymous"
  data-receipt="idle"
  data-locale="en"
  data-post-id={postId}
  data-discussion-replies-enabled={discussionRepliesEnabled ? 'true' : 'false'}
  data-turnstile-site-key={turnstileSiteKey}
>
  <p class="mood-compose__alert" data-compose-error role="alert" hidden>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS.circleAlert} />
    <span data-compose-error-text></span>
    <code class="mood-compose__code" data-compose-error-code hidden></code>
  </p>

  <div class="mood-compose__box">
    {/* Quote of the comment a reply is aimed at, with a way out of it. Empty
        and hidden until detail-compose.ts's Reply-button delegation fills it
        in -- see readCommentReplyTarget / createCommentReplyQuote, the same
        helpers the rendered thread itself uses for reply-to quotes. Inside
        the box, not stacked above it: what you are answering is part of what
        you are writing, and two bordered rectangles said that once each. */}
    <div class="mood-compose__reply" data-reply-chip hidden>
      <div class="mood-compose__reply-quote" data-reply-quote></div>
      <button
        type="button"
        class="mood-compose__reply-dismiss"
        data-reply-dismiss
        aria-label={t.cancelReplyAria}
        title={t.cancelReply}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS.x} />
      </button>
    </div>

    <div class="mood-compose__identity" id="mood-compose-id" data-compose-identity>
      <label class="sr-only" for="mood-compose-name">Name</label>
      <input
        id="mood-compose-name"
        class="blog-compose__input mood-compose__input"
        type="text"
        maxlength="32"
        autocomplete="nickname"
        autocapitalize="words"
        autocorrect="off"
        spellcheck="false"
        enterkeyhint="next"
        placeholder="Name"
        required
      />
      <label class="sr-only" for="mood-compose-email">Email</label>
      <input
        id="mood-compose-email"
        class="blog-compose__input mood-compose__input"
        type="email"
        autocomplete="email"
        autocapitalize="none"
        autocorrect="off"
        spellcheck="false"
        enterkeyhint="next"
        placeholder="Email (optional)"
      />

      {/* Honeypot -- risk stack step 3, same shape as IdentityRow.astro's.
          Off-screen, unreachable by Tab, hidden from assistive tech. Any
          value here silently drops the submission. */}
      <input
        type="text"
        name="website"
        data-honeypot
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
        style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;pointer-events:none;"
      />
    </div>

    <p class="mood-compose__recommend" data-compose-recommend aria-live="polite" hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS.mail} />
      A verified email means cross-device edits; to skip it, just press send again.
    </p>

    <label class="sr-only" for="mood-compose-text">Write a comment</label>
    <textarea
      id="mood-compose-text"
      class="blog-compose__field mood-compose__field"
      name="comment"
      rows="3"
      placeholder="Say something…"
    ></textarea>

    <div class="mood-compose__bar">
      <span class="mood-compose__count" data-compose-count aria-hidden="true" hidden></span>
      <button
        type="button"
        class="mood-compose__submit"
        data-compose-submit
        aria-label={t.postAria}
        title={t.post}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS.arrowUp} />
      </button>
    </div>
  </div>

  {/* Collapsed to nothing until Cloudflare actually asks for an interactive
      challenge -- see turnstile-token.ts. */}
  <div class="mood-compose__turnstile" data-turnstile-host></div>

  {/* Posted, but held for review -- not inserted into the thread. Cleared
      the moment the reader starts a new comment (detail-compose.ts). */}
  <p class="mood-compose__held" data-compose-held role="status" hidden>{t.held}</p>

  <p class="mood-compose__disclosure">{t.disclosure}</p>
</div>

<style is:global>
  .mood-compose {
    margin-top: var(--comment-stack-gap, 16px);
    font-family: var(--font-sans);

    /* Every control in this box reads its size from these two, and nothing
       else does. See the coarse-pointer block at the bottom of this file for
       why they exist at all. */
    --compose-body: var(--comment-body, 15px);
    --compose-meta: var(--comment-meta, 13px);
  }

  .mood-compose__alert {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin: 0 0 10px;
    padding: 9px 12px;
    font-size: 13px;
    line-height: 1.4;
    color: hsl(0 70% 45%);
    background: hsl(0 70% 50% / 0.08);
    border: 1px solid hsl(0 70% 50% / 0.18);
    border-radius: 10px;
  }

  .mood-compose__alert svg {
    flex-shrink: 0;
    width: 15px;
    height: 15px;
    margin-top: 1px;
  }

  .mood-compose__code {
    margin-left: auto;
    font-size: 11px;
    opacity: 0.7;
    white-space: nowrap;
  }

  /* A quoted parent is a citation, not a second bubble -- the same call
     feed-rich-text.css already makes for a quote inside a comment. This was a
     bordered chip wrapping a filled quote card, sitting on the bordered form:
     three nested rounded rectangles to say "you are answering this". */
  .mood-compose__reply {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 10px;
  }

  .mood-compose__reply-quote {
    flex: 1;
    min-width: 0;
    padding-left: 10px;
    border-left: 2px solid hsl(var(--foreground) / 0.22);
  }

  /* createCommentReplyQuote hands back the feed's slab card. In here it gives
     up its fill, padding and corners; the rule on the left says all of it. */
  .mood-compose__reply .mood-item-quote {
    width: 100%;
    max-width: 100%;
    gap: 2px;
    padding: 0;
    background: none;
    border-radius: 0;
  }

  /* One step under the sentence being written, and no smaller -- the size the
     thread's own quote cards take. Two lines of it: this is the context for
     what you are typing, not a copy of it. */
  .mood-compose__reply .mood-item-quote-author {
    font-size: var(--comment-meta);
    font-weight: 600;
    letter-spacing: normal;
    color: hsl(var(--foreground) / 0.8);
  }

  .mood-compose__reply .mood-item-quote-text {
    font-size: var(--comment-meta);
    line-height: 1.45;
    color: hsl(var(--foreground) / 0.62);
    -webkit-line-clamp: 2;
  }

  .mood-compose__reply-dismiss {
    position: relative;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    padding: 0;
    color: hsl(var(--muted-foreground) / 0.7);
    background: transparent;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    touch-action: manipulation;
  }

  /* 22px of circle is the visual; the target around it is what a thumb
     needs. An overlay grows the hit area without moving the row. */
  .mood-compose__reply-dismiss::after {
    content: '';
    position: absolute;
    inset: -8px;
  }

  .mood-compose__reply-dismiss:hover {
    color: hsl(var(--foreground));
    background: hsl(var(--foreground) / 0.08);
  }

  .mood-compose__reply-dismiss svg {
    width: 13px;
    height: 13px;
  }

  /* Opaque, like the bubbles above it. An alpha fill let the page's dot grid
     read straight through the form, which made it look unfinished next to
     rows that sit on a solid surface. */
  .mood-compose__box {
    background: var(--comment-bubble-bg, hsl(var(--background)));
    border: 1px solid var(--comment-bubble-border, hsl(var(--foreground) / 0.08));
    border-radius: var(--comment-body-radius, 12px);
    /* The bubble's own rungs: the form is one more row in the thread. */
    padding: var(--comment-body-padding, 10px 16px);
    transition:
      border-color var(--dur-fast) var(--ease),
      box-shadow var(--dur-fast) var(--ease);
  }

  .mood-compose__box:has(:focus-visible) {
    border-color: hsl(var(--foreground) / 0.25);
    box-shadow: 0 0 0 3px hsl(var(--foreground) / 0.06);
  }

  .mood-compose__identity {
    display: flex;
    gap: 14px;
    margin-bottom: 10px;
  }

  /* Two rules, not two boxes. A rounded, bordered field inside a rounded,
     bordered box is the same nesting the reply quote was guilty of, and the
     box's own outline is already saying "this is the form". .blog-compose
     drops the borders for the same reason; here the underline stays because
     these two fields sit in a row and something has to divide them.

     A handle is short and an address is not: 38.2 / 61.8 of the row, the
     split the blog settled on. */
  .mood-compose__input {
    flex: 0 1 38.2%;
    min-width: 0;
    padding: 8px 0;
    font-size: var(--compose-meta);
    font-family: inherit;
    color: hsl(var(--foreground));
    background: none;
    border: 0;
    border-bottom: 1px solid hsl(var(--foreground) / 0.14);
    border-radius: 0;
  }

  .mood-compose__input[type='email'] {
    flex: 0 1 61.8%;
  }

  .mood-compose__input::placeholder {
    color: hsl(var(--muted-foreground) / 0.6);
  }

  /* Which of the pair you are in has to be readable from more than the
     caret. The rule under the active field is the same channel the invalid
     state uses, one step quieter. */
  .mood-compose__input:focus {
    outline: none;
    border-bottom-color: hsl(var(--foreground) / 0.45);
  }

  .mood-compose__input[aria-invalid='true'] {
    border-bottom-color: hsl(0 70% 50% / 0.6);
  }

  .mood-compose__recommend {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    margin: 0 0 8px;
    font-size: 12px;
    line-height: 1.4;
    color: hsl(140 45% 38%);
  }

  .mood-compose__recommend svg {
    flex-shrink: 0;
    width: 13px;
    height: 13px;
    margin-top: 1px;
  }

  .mood-compose__field {
    display: block;
    width: 100%;
    /* Flush with the two fields above it: one left edge down the box. */
    padding: 8px 0 4px;
    font-size: var(--compose-body);
    line-height: var(--comment-lead, 1.65);
    font-family: inherit;
    color: hsl(var(--foreground));
    background: transparent;
    border: none;
    resize: vertical;
    min-height: 3.6em;
  }

  .mood-compose__field:focus {
    outline: none;
  }

  .mood-compose__field[aria-invalid='true'] {
    outline: none;
  }

  .mood-compose__bar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 4px;
  }

  .mood-compose__count {
    font-size: 11px;
    color: hsl(var(--muted-foreground) / 0.7);
    font-variant-numeric: tabular-nums;
  }

  .mood-compose__count[data-over] {
    color: hsl(0 70% 45%);
  }

  .mood-compose__count[data-nudge] {
    animation: mood-compose-count-nudge 0.3s ease;
  }

  @keyframes mood-compose-count-nudge {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-2px); }
    75% { transform: translateX(2px); }
  }

  .mood-compose__submit {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    padding: 0;
    color: hsl(var(--background));
    background: hsl(var(--foreground));
    border: none;
    border-radius: 50%;
    cursor: pointer;
    touch-action: manipulation;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .mood-compose__submit:hover {
    opacity: 0.85;
  }

  .mood-compose__submit:active {
    transform: scale(0.94);
  }

  .mood-compose__submit:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .mood-compose__submit svg {
    width: 15px;
    height: 15px;
  }

  .mood-compose__turnstile:not(:empty) {
    margin-top: 10px;
  }

  .mood-compose__held {
    margin: 10px 0 0;
    padding: 8px 12px;
    font-size: 12.5px;
    color: hsl(38 80% 40%);
    background: hsl(38 80% 50% / 0.1);
    border: 1px solid hsl(38 80% 50% / 0.2);
    border-radius: 8px;
  }

  .mood-compose__disclosure {
    margin: 8px 0 0;
    font-size: 11px;
    line-height: 1.4;
    color: hsl(var(--muted-foreground) / 0.55);
  }

  /* Sits in .mood-comment-footer beside the reactions, so no top margin of
     its own. Never hover-gated: on a touch screen a hidden reply button is
     no button at all. */
  .mood-comment-reply-btn {
    /* The label is 13px of text; HIG asks for a target near 44pt. Padding
       grows the hit area and the negative margin keeps the footer row
       exactly where it was. */
    margin: -10px -8px;
    padding: 10px 8px;
    font-family: inherit;
    font-size: var(--comment-meta);
    font-weight: 500;
    color: hsl(var(--muted-foreground) / 0.75);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease);
  }

  .mood-comment-reply-btn:hover,
  .mood-comment-reply-btn:focus-visible {
    color: hsl(var(--foreground));
  }

  /* Your own rows, in the surface's own monochrome -- nothing in the mood
     thread carries an accent colour. Carried by the outline rather than the
     fill: a fill step large enough to notice in dark reads as a grey slab in
     light, where the same mix runs the other way. */
  .mood-comment--mine .mood-comment-body {
    border-color: color-mix(in oklab, hsl(var(--foreground)) 30%, transparent);
  }

  @media (max-width: 540px) {
    .mood-compose__identity {
      flex-direction: column;
      gap: 0;
    }

    .mood-compose__input,
    .mood-compose__input[type='email'] {
      flex: 0 0 auto;
    }
  }

  /* --- Touch screens -------------------------------------------------- */

  /* iOS Safari zooms the whole page the moment a focused form control is
     under 16px, and with the keyboard up there is no gesture that zooms back
     out: you finish the comment on a page 30% too big, scrolled somewhere you
     did not choose. So the controls take a 16px floor.

     Gated on the device, not the viewport. An iPad in a wide split view is a
     touch screen at 900px, and the owner reads this surface on one. A
     mouse-only pointer keeps the thread's own sizes -- the same trade
     .blog-compose makes, which gates on width because it only ever had
     phones in mind.

     The same query carries the ~44pt targets HIG asks for: 16px of text in
     7px of padding is a 30px row, and a thumb is not 30px wide. */
  @media (any-pointer: coarse) {
    .mood-compose {
      --compose-body: 16px;
      --compose-meta: 16px;
    }

    .mood-compose__input {
      min-height: 44px;
    }

    /* The send button keeps its 30px circle and grows the target around it,
       the way the reply dismiss does. */
    .mood-compose__submit::after {
      content: '';
      position: absolute;
      inset: -7px;
    }
  }
</style>
