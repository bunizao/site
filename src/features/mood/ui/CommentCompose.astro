---
/* The mood detail page's compose box -- vanilla .astro + client TS, no
   React. Renders in place of the "Leave a comment on Telegram" CTA row once
   the loaded post's `discussionLinked` is true (CommentsSection.astro
   decides which one to render).

   Behavioural markup is borrowed verbatim from the blog's compose box:
   `.blog-compose`, `[data-compose-identity]`, `.blog-compose__input`,
   `.blog-compose__field`, `[data-compose-count]`, `[data-compose-error*]`,
   `[data-compose-recommend]`, `[data-compose-submit]`, the `website`
   honeypot -- so compose-validate.ts, drafts.ts, and the risk-stack modules
   under src/features/comments/client/ work unmodified. `data-locale="en"`
   is what makes their shared copy table (copy.ts) resolve to English here;
   the mood zone has no zh variant to keep in sync with it.

   What is NOT reused from the blog: the three-phase reader identity
   (anonymous/claimed/ready), reader sessions, and the subscribe nudge. Mood
   comments are always anonymous -- `data-phase` never changes off
   "anonymous" -- and email stays optional, matching the blog's own default
   (plans/mood-comments-bridge.md, open decision #2). The submit itself,
   Turnstile wiring, and the reply chip are client/detail-compose.ts, which
   also owns the actual POST -- this component only renders. */

import { ICONS } from '@/features/comments/icons';
import { moodCommentsCopy } from '@/features/comments/copy';

interface Props {
  postId: string;
  /** MoodContentDocument.discussionRepliesEnabled -- gates whether a Reply
      button on a `telegram`-origin comment is allowed to send a parentId.
      Read by detail-comments-controller.ts off this box's data attribute
      rather than threaded through as a second prop everywhere. */
  discussionRepliesEnabled?: boolean;
  /** Same key the blog page passes to CommentsSection -- see
      src/lib/turnstile-site-key.ts. Empty on the e2e fixture path, which
      skips Turnstile entirely (see turnstile-token.ts). */
  turnstileSiteKey?: string;
}

const {
  postId,
  discussionRepliesEnabled = false,
  turnstileSiteKey = '',
} = Astro.props;

const t = moodCommentsCopy;
---

<div
  class="mood-compose blog-compose"
  data-mood-compose
  data-phase="anonymous"
  data-receipt="idle"
  data-locale="en"
  data-post-id={postId}
  data-discussion-replies-enabled={discussionRepliesEnabled ? 'true' : 'false'}
  data-turnstile-site-key={turnstileSiteKey}
>
  {/* Collapsed, the box is a dashed capsule the width of the thread: the
      shape says "nothing here yet, put something in". Opening it turns the
      dashes solid and squares the corners, because it is an input now, not an
      invitation. The seed button and the textarea share one text origin, so
      the placeholder appears to stay put while the frame grows around it. */}
  <div class="mood-compose-shell" data-compose-shell>
    <button type="button" class="mood-compose-seed" data-compose-seed>Say something&hellip;</button>
    <div class="mood-compose-reveal">
      <div class="mood-compose-reveal__in">
  <p class="mood-compose__alert" data-compose-error role="alert" hidden>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS.circleAlert} />
    <span data-compose-error-text></span>
    <code class="mood-compose__code" data-compose-error-code hidden></code>
  </p>

  {/* Quote of the comment a reply is aimed at, with a way out of it. Empty
      and hidden until detail-compose.ts's Reply-button delegation fills it
      in -- see readCommentReplyTarget / createCommentReplyQuote, the same
      helpers the rendered thread itself uses for reply-to quotes. */}
  <div class="mood-compose__reply" data-reply-chip hidden>
    <div class="mood-compose__reply-quote" data-reply-quote></div>
    <button
      type="button"
      class="mood-compose__reply-dismiss"
      data-reply-dismiss
      aria-label={t.cancelReplyAria}
      title={t.cancelReply}
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS.x} />
    </button>
  </div>

  <div class="mood-compose__box">
    <div class="mood-compose__identity" id="mood-compose-id" data-compose-identity>
      <label class="sr-only" for="mood-compose-name">Name</label>
      <input
        id="mood-compose-name"
        class="blog-compose__input mood-compose__input"
        type="text"
        maxlength="32"
        autocomplete="nickname"
        placeholder="Name"
        required
      />
      <label class="sr-only" for="mood-compose-email">Email</label>
      <input
        id="mood-compose-email"
        class="blog-compose__input mood-compose__input"
        type="email"
        autocomplete="email"
        placeholder="Email (optional)"
      />

      {/* Honeypot -- risk stack step 3, same shape as IdentityRow.astro's.
          Off-screen, unreachable by Tab, hidden from assistive tech. Any
          value here silently drops the submission. */}
      <input
        type="text"
        name="website"
        data-honeypot
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
        style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;pointer-events:none;"
      />
    </div>

    <p class="mood-compose__recommend" data-compose-recommend aria-live="polite" hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS.mail} />
      A verified email means cross-device edits; to skip it, just press send again.
    </p>

    <label class="sr-only" for="mood-compose-text">Write a comment</label>
    <textarea
      id="mood-compose-text"
      class="blog-compose__field mood-compose__field"
      name="comment"
      rows="1"
      placeholder="Say something…"
    ></textarea>

    <div class="mood-compose__bar">
      <span class="mood-compose__count" data-compose-count aria-hidden="true" hidden></span>
      <button
        type="button"
        class="mood-compose__submit"
        data-compose-submit
        aria-label={t.postAria}
        title={t.post}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS.arrowUp} />
      </button>
    </div>
  </div>

  {/* Collapsed to nothing until Cloudflare actually asks for an interactive
      challenge -- see turnstile-token.ts. */}
  <div class="mood-compose__turnstile" data-turnstile-host></div>
      </div>
    </div>
  </div>

  {/* Posted, but held for review -- not inserted into the thread. Cleared
      the moment the reader starts a new comment (detail-compose.ts). */}
  <p class="mood-compose__held" data-compose-held role="status" hidden>{t.held}</p>

  <p class="mood-compose__disclosure" data-compose-disclosure>{t.disclosure}</p>
</div>

<style is:global>
  .mood-compose {
    font-family: var(--font-sans);
    --compose-ease: cubic-bezier(0.2, 0, 0, 1);
  }

  /* ---- the capsule ----------------------------------------------------
     Concentric radius: the open frame's 18px outer, minus the 10px the
     inputs sit above the bottom edge, leaves 8px of visual inner radius.
     Enter and exit are not the same gesture -- opening is a reveal, closing
     is a dismissal -- so the close runs at ~0.7x and the seed waits for the
     field to clear before fading back in, or both placeholders read at
     once. */
  .mood-compose-shell {
    position: relative;
    /* The closed height lives here, under the reveal, not in a collapsing row
       above it. A row above pushed the whole capsule down by its own height,
       so the field's placeholder slid 44px up through the open while the
       seed's identical placeholder sat still -- the label appeared to jump.
       As padding it comes off the bottom, the reveal keeps the top edge, and
       the two placeholders occupy the same 25px the whole way. */
    padding-bottom: 44px;
    background: none;
    border: 1px dashed hsl(var(--foreground) / 0.18);
    /* 23px, not 999px, and the seed slot's fixed 44px is what makes that a
       true pill. A 999px radius is clamped to half the box, so through most of
       the open it stays pinned at fully-round and only becomes a real number
       in the last few frames -- the corner sits still, then snaps square. Two
       radii that are both smaller than half the box interpolate the whole way. */
    border-radius: 23px;
    transition:
      padding-bottom 0.22s var(--compose-ease),
      border-radius 0.22s var(--compose-ease),
      border-color 0.18s var(--compose-ease),
      box-shadow 0.18s var(--compose-ease);
  }

  .mood-compose-shell:hover {
    border-color: hsl(var(--foreground) / 0.32);
  }

  /* A dashed line is only half a line: at the same alpha it reads weaker than
     the solid bubbles beside it, and a dark ground eats what is left. The one
     invitation on the page should not be its faintest mark. */
  .dark .mood-compose-shell {
    border-color: hsl(var(--foreground) / 0.26);
  }

  .dark .mood-compose-shell:hover {
    border-color: hsl(var(--foreground) / 0.42);
  }

  .mood-compose-shell[data-open] {
    border-style: solid;
    border-color: hsl(var(--foreground) / 0.14);
    padding-bottom: 0;
    border-radius: 18px;
    transition-duration: 0.28s, 0.28s, 0.18s, 0.18s;
  }

  /* The two cells are one control, so the frame rings, not the cell. */
  .mood-compose-shell[data-open]:focus-within {
    border-color: hsl(var(--foreground) / 0.3);
    box-shadow: 0 0 0 3px hsl(var(--foreground) / 0.06);
  }

  /* Out of flow and pinned to the top edge, so it never moves while the box
     grows underneath it. Its type and its first line sit exactly where the
     field's do -- same size, same 18px inset, same 12px above the line -- so
     the two placeholders cross-fade in place instead of handing off across a
     gap. */
  .mood-compose-seed {
    all: unset;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    box-sizing: border-box;
    display: block;
    height: 44px;
    padding: 12px 18px 0;
    border-radius: inherit;
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 24px;
    color: hsl(var(--muted-foreground) / 0.72);
    cursor: text;
    transition: opacity 0.16s var(--compose-ease) 0.12s;
  }

  .mood-compose-seed:focus-visible {
    outline: 2px solid hsl(var(--foreground) / 0.4);
    outline-offset: 2px;
  }

  .mood-compose-shell[data-open] .mood-compose-seed {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.12s var(--compose-ease);
  }

  /* 0fr -> 1fr, so the height animation stays interruptible. */
  .mood-compose-reveal {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.22s var(--compose-ease);
  }

  .mood-compose-shell[data-open] .mood-compose-reveal {
    grid-template-rows: 1fr;
    transition-duration: 0.28s;
  }

  .mood-compose-reveal__in {
    overflow: hidden;
    min-height: 0;
    visibility: hidden;
    transition: visibility 0s 0.22s;
  }

  .mood-compose-shell[data-open] .mood-compose-reveal__in {
    visibility: visible;
    transition-delay: 0s;
  }

  /* Staged entrance: the field arrives first, the identity row about 80ms
     behind it. The exit runs unstaggered and quicker. */
  .mood-compose__identity,
  .mood-compose__bar {
    opacity: 0;
    translate: 0 -4px;
    transition:
      opacity 0.12s var(--compose-ease),
      translate 0.12s var(--compose-ease);
  }

  /* The seed's label and the field's placeholder are the same words at the
     same inset, so they cross-fade rather than hand off: with the field
     waiting on a delay the capsule went blank in the middle of the open. It
     gets no slide either, unlike the rows below it -- an offset on text that
     is already on screen under the seed reads as the words nudging
     themselves, not as an entrance. */
  .mood-compose__field {
    opacity: 0;
    transition: opacity 0.12s var(--compose-ease);
  }

  .mood-compose-shell[data-open] .mood-compose__field {
    opacity: 1;
    transition-duration: 0.16s;
  }

  .mood-compose-shell[data-open] .mood-compose__identity,
  .mood-compose-shell[data-open] .mood-compose__bar {
    opacity: 1;
    translate: none;
    transition:
      opacity 0.2s var(--compose-ease) 0.14s,
      translate 0.2s var(--compose-ease) 0.14s;
  }

  .mood-compose__alert {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin: 12px 18px 0;
    padding: 9px 12px;
    font-size: 13px;
    line-height: 1.4;
    color: hsl(0 70% 45%);
    background: hsl(0 70% 50% / 0.08);
    border: 1px solid hsl(0 70% 50% / 0.18);
    border-radius: 10px;
  }

  .mood-compose__alert svg {
    flex-shrink: 0;
    width: 15px;
    height: 15px;
    margin-top: 1px;
  }

  .mood-compose__code {
    margin-left: auto;
    font-size: 11px;
    opacity: 0.7;
    white-space: nowrap;
  }

  .mood-compose__reply {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin: 12px 18px 0;
    padding: var(--comment-gap-inner, 6px) 10px;
    background: var(--comment-bubble-bg, hsl(var(--background)));
    border: 1px solid var(--comment-bubble-border, hsl(var(--foreground) / 0.1));
    border-radius: var(--radius-md, 10px);
  }

  .mood-compose__reply-quote {
    flex: 1;
    min-width: 0;
  }

  .mood-compose__reply-dismiss {
    position: relative;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    padding: 0;
    color: hsl(var(--muted-foreground) / 0.7);
    background: transparent;
    border: none;
    border-radius: 50%;
    cursor: pointer;
  }

  /* 22px of circle is the visual; the target around it is what a thumb
     needs. An overlay grows the hit area without moving the row. */
  .mood-compose__reply-dismiss::after {
    content: '';
    position: absolute;
    inset: -8px;
  }

  .mood-compose__reply-dismiss:hover {
    color: hsl(var(--foreground));
    background: hsl(var(--foreground) / 0.08);
  }

  .mood-compose__reply-dismiss svg {
    width: 13px;
    height: 13px;
  }

  /* Opaque, like the bubbles above it. An alpha fill let the page's dot grid
     read straight through the form, which made it look unfinished next to
     rows that sit on a solid surface. */
  /* The shell owns the frame, so the box draws none of its own. Bordered
     inputs inside a bordered box read as a box in a box; one frame with
     internal rules is the same information with one less edge. The grid puts
     the message above the identity row whatever order the markup needs. */
  .mood-compose__box {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'text text'
      'note note'
      'ident bar';
    align-items: stretch;
    column-gap: 0;
    padding: 0;
    overflow: hidden;
    background: none;
    border: 0;
    border-radius: 18px;
    --compose-rule: 1px solid hsl(var(--foreground) / 0.09);
  }

  .mood-compose__field {
    grid-area: text;
  }

  .mood-compose__recommend {
    grid-area: note;
  }

  .mood-compose__identity {
    grid-area: ident;
    display: flex;
    gap: 0;
    margin: 0;
    border-top: var(--compose-rule);
  }

  .mood-compose__input {
    min-width: 0;
    height: 46px;
    padding: 0 14px;
    font-size: 13.5px;
    font-family: inherit;
    color: hsl(var(--foreground));
    background: none;
    border: 0;
    border-radius: 0;
  }

  #mood-compose-name {
    flex: 0 0 38%;
    padding-left: 18px;
  }

  #mood-compose-email {
    flex: 1;
    border-left: 1px solid hsl(var(--foreground) / 0.07);
  }

  .mood-compose__input::placeholder {
    color: hsl(var(--muted-foreground) / 0.6);
  }

  .mood-compose__input:focus {
    outline: none;
  }

  .mood-compose__input[aria-invalid='true'] {
    border-color: hsl(0 70% 50% / 0.5);
  }

  .mood-compose__recommend {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    margin: 0 18px 10px;
    font-size: 12px;
    line-height: 1.4;
    color: hsl(140 45% 38%);
  }

  .mood-compose__recommend svg {
    flex-shrink: 0;
    width: 13px;
    height: 13px;
    margin-top: 1px;
  }

  /* The 18px inset matches the seed's, so the placeholder does not move
     when the capsule opens. */
  .mood-compose__field {
    display: block;
    width: 100%;
    font-family: inherit;
    color: hsl(var(--foreground));
    background: transparent;
    border: none;
    resize: none;
    overflow: hidden;
    /* Writing the comment is the only reason this box exists; the name and
       email are furniture you fill once. Matching their 46px row said the
       three were equal and turned the capsule into a two-cell table, so the
       proportion carries the hierarchy instead: two lines of writing room
       against their one, and 16px type against their 13.5px. Two lines, not
       three -- three reserved space for a comment nobody has written, and
       detail-compose.ts grows the box as one arrives. */
    font-size: 16px;
    line-height: 24px;
    padding: 12px 18px;
    min-height: 72px;
  }

  .mood-compose__field:focus {
    outline: none;
  }

  .mood-compose__field[aria-invalid='true'] {
    outline: none;
  }

  .mood-compose__bar {
    grid-area: bar;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    margin: 0;
    padding: 0 9px 0 12px;
    border-top: var(--compose-rule);
  }

  .mood-compose__count {
    font-size: 11px;
    color: hsl(var(--muted-foreground) / 0.7);
    font-variant-numeric: tabular-nums;
  }

  .mood-compose__count[data-over] {
    color: hsl(0 70% 45%);
  }

  .mood-compose__count[data-nudge] {
    animation: mood-compose-count-nudge 0.3s ease;
  }

  @keyframes mood-compose-count-nudge {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-2px); }
    75% { transform: translateX(2px); }
  }

  .mood-compose__submit {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    color: hsl(var(--background));
    background: hsl(var(--foreground));
    border: none;
    border-radius: 50%;
    cursor: pointer;
    transition: opacity 0.15s ease, scale 0.15s ease;
  }

  .mood-compose__submit:hover {
    opacity: 0.85;
  }

  .mood-compose__submit:active {
    scale: 0.96;
  }

  .mood-compose__submit:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .mood-compose__submit svg {
    width: 15px;
    height: 15px;
  }

  /* The host is never :empty -- turnstile-token.ts drops a wrapper div in on
     load -- so that guard reserved 12px under a zero-height box and the
     capsule opened with a gap along its bottom edge. The challenge only takes
     room once it is interactive, and so does the space under it. */
  .mood-compose__turnstile[data-turnstile-interactive] {
    margin: 0 18px 12px;
  }

  .mood-compose__held:not([hidden]) {
    animation: mood-compose-receipt-in 0.24s var(--compose-ease) both;
  }

  @keyframes mood-compose-receipt-in {
    from {
      opacity: 0;
      translate: 0 -6px;
    }
  }

  .mood-compose__held {
    margin: 8px 2px 0;
    padding: 8px 12px;
    font-size: 12.5px;
    color: hsl(38 80% 40%);
    background: hsl(38 80% 50% / 0.1);
    border: 1px solid hsl(38 80% 50% / 0.2);
    border-radius: 8px;
  }

  /* Content leaving for a third party is not fine print, but it is a caption
     about the send rather than a field, so it waits until the box is open. */
  .mood-compose__disclosure {
    margin: 10px 2px 0;
    font-size: 12px;
    line-height: 1.5;
    color: hsl(var(--muted-foreground) / 0.8);
  }

  .mood-compose-shell:not([data-open]) ~ .mood-compose__disclosure {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .mood-compose-shell,
    .mood-compose-seed,
    .mood-compose-reveal,
    .mood-compose__field,
    .mood-compose__identity,
    .mood-compose__bar {
      transition: none !important;
    }

    .mood-compose__held:not([hidden]) {
      animation: none !important;
    }
  }

  /* Sits in .mood-comment-footer beside the reactions, so no top margin of
     its own. Never hover-gated: on a touch screen a hidden reply button is
     no button at all. */
  .mood-comment-reply-btn {
    /* The label is 13px of text; HIG asks for a target near 44pt. Padding
       grows the hit area and the negative margin keeps the footer row
       exactly where it was. */
    margin: -10px -8px;
    padding: 10px 8px;
    font-family: inherit;
    font-size: var(--comment-meta);
    font-weight: 500;
    color: hsl(var(--muted-foreground) / 0.75);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease);
  }

  .mood-comment-reply-btn:hover,
  .mood-comment-reply-btn:focus-visible {
    color: hsl(var(--foreground));
  }

  /* Your own rows, in the surface's own monochrome -- nothing in the mood
     thread carries an accent colour. Carried by the outline rather than the
     fill: a fill step large enough to notice in dark reads as a grey slab in
     light, where the same mix runs the other way. */
  .mood-comment--mine .mood-comment-body {
    border-color: color-mix(in oklab, hsl(var(--foreground)) 30%, transparent);
  }

  @media (max-width: 540px) {
    .mood-compose__identity {
      flex-direction: column;
    }
  }
</style>
