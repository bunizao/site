---
import type { MoodFeedItem } from '@/features/mood/server/contracts';
import { serializeScriptJson } from '@/lib/serialize-script-json';
import '@/styles/mood-image.css';

interface Props {
  initialPosts?: MoodFeedItem[];
  runtimeDisabled?: boolean;
}

const { initialPosts = [], runtimeDisabled = false } = Astro.props;
const SKELETON_COUNT = 1;
const INITIAL_POST_COUNT = 5;
const skeletonPatterns = [
  { line1: '72%', line2: '0%', lineCount: 1 },
  { line1: '64%', line2: '42%', lineCount: 2 },
  { line1: '76%', line2: '54%', lineCount: 2 },
  { line1: '60%', line2: '0%', lineCount: 1 },
  { line1: '70%', line2: '38%', lineCount: 2 },
];
const placeholders = Array.from({ length: SKELETON_COUNT }, (_, index) => ({
  index,
  pattern: skeletonPatterns[index % skeletonPatterns.length],
}));
const initialPreviewPostsJson = serializeScriptJson(initialPosts.slice(0, INITIAL_POST_COUNT));
---

<section
  id="moods-section"
  class="moods-section"
  data-reveal
  data-mood-runtime-disabled={runtimeDisabled ? 'true' : undefined}
  aria-labelledby="moods-heading"
>
  <div class="section-head">
    <h2
      class="section-label" id="moods-heading"
      data-reveal-item
      style="--reveal-delay: 300ms; --reveal-duration: 400ms"
    >Moods</h2>
    <a
      href="/mood"
      class="link section-enter"
      aria-label="View all moods"
      data-reveal-item
      style="--reveal-delay: 360ms; --reveal-duration: 400ms"
    >All moods</a>
  </div>

  <div class="mood-timeline" data-mood-list role="region" aria-busy={runtimeDisabled ? 'false' : 'true'} aria-label="Recent moods">
    <script
      is:inline
      type="application/json"
      data-mood-preview-initial
      set:html={initialPreviewPostsJson}
    ></script>
    {!runtimeDisabled && placeholders.map(({ index, pattern }) => (
      <div
        class="mood-item mood-item-skeleton"
        style={`--item-index: ${index}; --line-1: ${pattern.line1}; --line-2: ${pattern.line2};`}
      >
        <div class="mood-time-col">
          <span class="mood-skeleton-time"></span>
        </div>
        <div class="mood-line-col">
          <div class="mood-dot"></div>
          <div class="mood-line"></div>
        </div>
        <div class="mood-content-col">
          <div class="mood-card mood-card-skeleton">
            <div class="mood-skeleton-lines" data-skeleton-lines data-line-count={String(pattern.lineCount)}>
              <span class="mood-skeleton-block mood-skeleton-block--primary"></span>
              <span class="mood-skeleton-block mood-skeleton-block--secondary"></span>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>

  <p class="mood-empty-state" data-mood-empty hidden={!runtimeDisabled}>
    {runtimeDisabled ? 'Mood preview paused in home dev.' : 'No moods yet.'}
  </p>
  <p class="mood-error-state" data-mood-error hidden>Unable to load moods.</p>
</section>

<style is:global>
  /* The feed reads in the human voice (Inter); the timeline spine — time
     stamps, tags — stays mono, the same identity thread as Hero and Experience.
     Pretext measures the live computed font, so reservations follow this. */
  #moods-section {
    font-family: var(--font-sans);
  }

  #moods-section .mood-time,
  #moods-section .mood-tag {
    font-family: var(--font-mono);
  }


  /* Feed entrance. The section itself is revealed by src/lib/home-reveal.ts;
     these two classes cover the async swap from skeletons to real cards, which
     lands long after that first reveal. Both are pure CSS transitions, so a
     busy main thread delays them rather than freezing them part-way.

     Timing matches the home reveal vocabulary (the 550ms/60ms pair in
     home-reveal.css) so the feed arrives as part of the page rather than after
     it. No blur: it bought very little at 24px of travel and cost a full repaint
     per card per frame, at the one moment the main thread is busy rendering the
     data that just arrived. */
  #moods-section .mood-item {
    transition:
      opacity 0.55s var(--reveal-ease),
      transform 0.55s var(--reveal-ease);
    transition-delay: calc(var(--item-index, 0) * 60ms);
  }

  /* Rise only, the same move as every other reveal on the page. The scale
     made cards grow into place, which nothing else here does. */
  #moods-section .mood-item--entering {
    opacity: 0;
    transform: translateY(16px);
  }

  /* An exit still has to start on the frame it is triggered. easeInCubic held
     the card almost still for the first 100ms, which read as the refresh
     hanging before anything moved. */
  #moods-section .mood-item--leaving {
    opacity: 0;
    transform: translateY(-12px);
    transition-duration: 0.25s;
    transition-timing-function: var(--ease-out);
    transition-delay: calc(var(--item-index, 0) * 60ms);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    #moods-section .mood-item,
    #moods-section .mood-item--entering,
    #moods-section .mood-item--leaving {
      transition: none;
      opacity: 1;
      transform: none;
    }
  }

  /* Timeline Layout - 3 columns: time | line | content */
  /* The first card's column padding already sits under the label, so the
     list gives it back: every section's first content lands one lattice cell
     below its label. */
  #moods-section .mood-timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: -8px;
  }

  /* The time column matches the desktop width: 56px is what holds a
     "SEP 23" stamp on one line at the meta step. At 52px it broke in two. */
  #moods-section .mood-item {
    display: grid;
    grid-template-columns: 56px 24px 1fr;
    gap: 0;
    text-decoration: none;
    color: inherit;
    position: relative;
  }

  #moods-section .mood-item--clickable {
    cursor: pointer;
  }

  /* The row is the focus target, but the card is the object: ring the card,
     not a box around the time stamp, the rail and the card together. */
  #moods-section .mood-item--clickable:focus-visible {
    outline: none;
  }

  #moods-section .mood-item--clickable:focus-visible .mood-card {
    outline: 2px solid hsl(var(--foreground));
    outline-offset: 2px;
  }

  @media (min-width: 640px) {
    #moods-section .mood-item {
      grid-template-columns: 56px 28px 1fr;
    }
  }

  /* Time column. The stamp, the dot and the card's first line share one
     axis: the stamp sits on the first line's baseline (36px down the row) and
     the dot centres on that line (31px). They used to sit 7px and 14px above
     it, so every row read as a label hung over the card's top edge. */
  #moods-section .mood-time-col {
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    padding-top: 21px;
    padding-right: 8px;
  }

  /* Tracking was -0.01em here, which is the wrong sign for a monospaced face:
     the glyphs already sit on a fixed advance, so tightening them pulls the
     tabular digits off the grid the column exists to hold. */
  #moods-section .mood-time {
    font-size: var(--home-text-meta);
    font-weight: var(--home-weight-meta);
    color: var(--home-fg-faint);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--home-track-meta);
    white-space: nowrap;
    transition: color var(--dur-base) var(--ease);
  }

  #moods-section .mood-item:not(.mood-item-skeleton):hover .mood-time {
    color: var(--home-fg-secondary);
  }


  /* Line column */
  #moods-section .mood-line-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  #moods-section .mood-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: hsl(var(--background));
    border: 2px solid hsl(var(--foreground) / 0.15);
    margin-top: 26px;
    position: relative;
    z-index: 2;
    transition:
      border-color 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
      background 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
      transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* Whole rule gated, not just the transform: the colour changes ride along
     rather than earning their own split. */
  @media (hover: hover) and (pointer: fine) {
    #moods-section .mood-item:not(.mood-item-skeleton):hover .mood-dot {
      border-color: hsl(var(--foreground) / 0.4);
      background: hsl(var(--foreground) / 0.08);
      transform: scale(1.3);
    }
  }

  /* The newest mood is marked in the session ink: a filled dot where the
     older ones are hollow. Its ring pulses twice once the section has been
     revealed, then rests. It used to pulse forever, and from page load, so
     most of its beats played to an empty viewport. */
  #moods-section .mood-item:first-child:not(.mood-item-skeleton) .mood-dot {
    border-color: var(--home-accent);
    background: var(--home-accent);
  }

  #moods-section .mood-item:first-child:not(.mood-item-skeleton) .mood-dot::before {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1px solid var(--home-accent);
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    html:not(.reveal-ready) #moods-section .mood-item:first-child:not(.mood-item-skeleton) .mood-dot::before,
    .reveal-ready #moods-section.is-revealed .mood-item:first-child:not(.mood-item-skeleton) .mood-dot::before {
      animation: mood-pulse 2.4s var(--ease-out) 600ms 2;
    }
  }

  @keyframes mood-pulse {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    100% {
      transform: scale(2);
      opacity: 0;
    }
  }

  #moods-section .mood-line {
    flex: 1;
    width: 1px;
    background: linear-gradient(
      to bottom,
      hsl(var(--foreground) / 0.12),
      hsl(var(--foreground) / 0.06)
    );
    margin-top: 4px;
    /* Runs on into the next row and stops 4px short of its dot, the same gap
       it leaves under its own, so the rail breaks only at the dots. */
    margin-bottom: -22px;
    position: relative;
  }

  #moods-section .mood-item:last-child .mood-line {
    margin-bottom: 0;
    background: linear-gradient(
      to bottom,
      hsl(var(--foreground) / 0.12),
      transparent
    );
  }

  /* Content column. Without card boxes the gaps between rows are the only
     grouping left, so the bottom padding is small: a row's lines stay closer
     to each other than to the next row. */
  #moods-section .mood-content-col {
    padding: 8px 0 4px 0;
  }

  /* No resting surface. Five white cards stacked on the rail read as the
     rungs of a ladder; a mood is a line in a log, so it sits on the page and
     the rail does the grouping. The padding stays, so the hover tint has room
     and the reserved heights (measured with the transparent border) hold.
     10px sides put the text as far right of the rail as the stamp sits left
     of it. */
  #moods-section .mood-card {
    padding: 10px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    min-height: var(--reserved-card-height, auto);
    transition: background var(--dur-fast) var(--ease);
  }

  /* The row is a link, so hover still answers: a faint tint where the card
     used to be. Gated like the dot, since a tap leaves a synthetic hover
     behind on touch. */
  @media (hover: hover) and (pointer: fine) {
    #moods-section .mood-item:not(.mood-item-skeleton):hover .mood-card {
      background: hsl(var(--foreground) / 0.035);
    }
  }

  /* Same step as the blog post titles next door, deliberately: at this size the
     distinction is carried by weight and contrast, not by a fractional size
     difference nobody can see. Titles run 500 at full contrast, these run 400 at
     0.8 — so an essay reads as heavier than a passing note even though both are
     the section's own primary content. */
  #moods-section .mood-text {
    --mood-text-line-height: 1.6;
    display: block;
    font-size: var(--home-text-body);
    font-weight: var(--home-weight-body);
    letter-spacing: var(--home-track-body);
    line-height: var(--mood-text-line-height);
    color: var(--home-fg-primary);
    max-height: calc(var(--mood-text-line-height) * 2em);
    overflow: hidden;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  #moods-section .mood-text a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid hsl(var(--foreground) / 0.35);
    transition: border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease), opacity var(--dur-fast) var(--ease);
  }

  #moods-section .mood-text a:hover,
  #moods-section .mood-text a:focus-visible {
    border-bottom-color: hsl(var(--foreground) / 0.6);
  }

  #moods-section .mood-text .tg-emoji {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.15em;
    height: 1.15em;
    vertical-align: -0.15em;
  }

  #moods-section .mood-text .tg-emoji img {
    width: 100%;
    height: 100%;
    display: block;
  }

  #moods-section .mood-media-fallback {
    display: block;
    font-size: var(--home-text-body);
    font-weight: var(--home-weight-body);
    letter-spacing: var(--home-track-body);
    line-height: 1.6;
    color: var(--home-fg-secondary);
  }

  #moods-section .mood-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
  }

  /* A photo-only card opens on its thumbnail, so there is no text to clear. */
  #moods-section .mood-meta:first-child {
    margin-top: 0;
  }

  /* Mono at the label size, but a lowercase pill rather than a section marker,
     so it takes the mono metadata tracking and not the 0.2em spine value. */
  #moods-section .mood-tag {
    font-size: var(--home-text-label);
    font-weight: var(--home-weight-meta);
    letter-spacing: var(--home-track-meta);
    color: var(--home-fg-faint);
    padding: 2px 6px;
    background: hsl(var(--foreground) / 0.04);
    border-radius: var(--radius-xs);
    transition:
      background var(--dur-base) var(--ease),
      color var(--dur-base) var(--ease);
  }

  #moods-section .mood-item:hover .mood-tag {
    background: hsl(var(--foreground) / 0.08);
    color: var(--home-fg-secondary);
  }

  #moods-section .mood-thumbnail {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-xs);
    overflow: hidden;
    background: hsl(var(--foreground) / 0.04);
    flex-shrink: 0;
    outline: 1px solid var(--home-image-outline);
    outline-offset: -1px;
  }

  #moods-section .mood-thumbnail > img:not(.mood-image-blur) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }



  /* Skeleton Styles - Timeline Pulse */
  #moods-section .mood-item-skeleton {
    pointer-events: none;
    position: relative;
    --skeleton-delay: calc(var(--item-index, 0) * 0.12s);
  }

  #moods-section .mood-item-skeleton .mood-dot {
    border-color: hsl(var(--foreground) / 0.1);
    background: hsl(var(--background));
    box-shadow: 0 0 0 1px hsl(var(--foreground) / 0.03);
  }

  #moods-section .mood-item-skeleton .mood-dot::after {
    content: '';
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    border: 1px solid hsl(var(--foreground) / 0.08);
    opacity: 0;
  }

  #moods-section .mood-item-skeleton .mood-line {
    background: linear-gradient(
      to bottom,
      hsl(var(--foreground) / 0.12),
      hsl(var(--foreground) / 0.03)
    );
    position: relative;
    overflow: hidden;
  }

  #moods-section .mood-item-skeleton .mood-line::after {
    content: '';
    position: absolute;
    inset: -40% 0;
    background: linear-gradient(
      to bottom,
      transparent,
      hsl(var(--foreground) / 0.14),
      transparent
    );
    transform: translateY(-60%);
  }

  #moods-section .mood-card-skeleton {
    position: relative;
    overflow: hidden;
    min-height: var(--reserved-card-height, 74px);
  }

  #moods-section .mood-card-skeleton::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 140%;
    left: -120%;
    background: linear-gradient(
      120deg,
      transparent 20%,
      hsl(var(--foreground) / 0.08) 50%,
      transparent 80%
    );
    /* The placeholder's only motion. Four overlapping 2-3s breaths read as
       ambient rather than as loading; one faster sweep makes the same wait feel
       shorter. */
    animation: mood-skeleton-sheen 1.2s ease-in-out infinite;
    animation-delay: var(--skeleton-delay);
    opacity: 0.3;
  }

  #moods-section .mood-skeleton-lines {
    position: relative;
    z-index: 1;
  }

  /* Blocks centred where the real lines will be (24px line boxes), so the
     swap to the loaded card does not shift the first line. */
  #moods-section .mood-skeleton-lines {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 6px;
  }

  #moods-section .mood-skeleton-block,
  #moods-section .mood-skeleton-time {
    display: block;
    border-radius: 999px;
    background: linear-gradient(
      100deg,
      hsl(var(--foreground) / 0.04),
      hsl(var(--foreground) / 0.08),
      hsl(var(--foreground) / 0.04)
    );
    background-size: 160% 100%;
  }

  #moods-section .mood-skeleton-block {
    height: 12px;
    border-radius: var(--radius-xs);
    width: var(--line-1, 70%);
  }

  #moods-section .mood-skeleton-block--secondary {
    display: none;
    width: var(--line-2, 42%);
  }

  #moods-section .mood-skeleton-lines[data-line-count="2"] .mood-skeleton-block--secondary {
    display: block;
  }

  #moods-section .mood-skeleton-time {
    width: 32px;
    height: 10px;
    margin-top: 5px;
    border-radius: var(--radius-xs);
  }

  /* Empty and error states */
  #moods-section .mood-empty-state,
  #moods-section .mood-error-state {
    font-size: 14px;
    color: hsl(var(--muted-foreground));
    padding: 16px 0;
    margin-left: 80px;
  }

  @media (min-width: 640px) {
    #moods-section .mood-empty-state,
    #moods-section .mood-error-state {
      margin-left: 84px;
    }
  }

  @keyframes mood-skeleton-sheen {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(140%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* The sheen is the skeleton's only animation; hiding the three decorated
       pseudo-elements parks the placeholder entirely. */
    #moods-section .mood-item-skeleton .mood-line::after,
    #moods-section .mood-item-skeleton .mood-dot::after,
    #moods-section .mood-item-skeleton .mood-card-skeleton::before {
      display: none;
    }

    #moods-section .mood-item:first-child:not(.mood-item-skeleton) .mood-dot::before {
      animation: none;
    }
  }
</style>

<script>
  import type { MediaItem } from '@bunizao/contracts/content';
  import { getMoodDetailHref } from '@/features/mood/shared/feed-anchor';
  import { buildMoodPreviewFragment } from '@/features/mood/shared/preview';
  import { getMoodImagePlaceholderSrc } from '@/features/mood/shared/image-srcset';
  import { initMoodImageFrames } from '@/features/mood/client/image-frame';
  import { withWidthParam } from '@/lib/media/responsive-image';

  let pretextPromise: Promise<typeof import('@chenglou/pretext')> | null = null;

  const initMoodsAnimation = async () => {
    const moodsSection = document.getElementById('moods-section');
    if (!moodsSection) return;

    const list = moodsSection.querySelector('[data-mood-list]') as HTMLElement | null;
    const emptyState = moodsSection.querySelector('[data-mood-empty]') as HTMLElement | null;
    const errorState = moodsSection.querySelector('[data-mood-error]') as HTMLElement | null;
    const runtimeDisabled = moodsSection.dataset.moodRuntimeDisabled === 'true';
    let hasLoaded = false;
    let initialPreviewLoadedAt = 0;
    let previewRevalidationTimer = 0;

    const MAX_MOODS = 5;
    const ALWAYS_LOADING = import.meta.env.PUBLIC_DEBUG_ALWAYS_LOADING === 'true';
    const INITIAL_PREVIEW_REVALIDATE_MS = 60_000;

    const formatTime = (value: string): string => {
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return '';

      const now = new Date();
      const isToday =
        date.getFullYear() === now.getFullYear() &&
        date.getMonth() === now.getMonth() &&
        date.getDate() === now.getDate();

      if (isToday) {
        const hours = String(date.getHours()).padStart(2, '0');
        const minutes = String(date.getMinutes()).padStart(2, '0');
        return `${hours}:${minutes}`;
      }

      const months = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
      const monthName = months[date.getMonth()];
      const day = String(date.getDate()).padStart(2, '0');

      return `${monthName} ${day}`;
    };

    const decoratePreviewEmoji = (emoji: HTMLSpanElement): void => {
      emoji.style.display = 'inline-flex';
      emoji.style.alignItems = 'center';
      emoji.style.justifyContent = 'center';
      emoji.style.width = '1.15em';
      emoji.style.height = '1.15em';
      emoji.style.verticalAlign = '-0.15em';
    };

    const buildPreviewFragment = (previewText: string, previewHtml?: string): DocumentFragment => (
      buildMoodPreviewFragment(previewText, previewHtml, {
        decorateEmoji: decoratePreviewEmoji,
      })
    );

    const getPreviewLines = (previewText: string): { lines: string[]; truncated: boolean } => {
      const lines = previewText
        .replace(/\r\n?/g, '\n')
        .split('\n')
        .map((line) => line.trim())
        .filter(Boolean);

      return {
        lines: lines.slice(0, MAX_PREVIEW_LINES),
        truncated: lines.length > MAX_PREVIEW_LINES,
      };
    };

    const appendPreviewLines = (
      target: HTMLElement,
      previewText: string,
      previewHtml: string,
    ): void => {
      const { lines, truncated } = getPreviewLines(previewText);
      if (!lines.length) {
        target.appendChild(buildPreviewFragment(previewText, previewHtml));
        return;
      }

      lines.forEach((line, index) => {
        if (index > 0) {
          target.appendChild(document.createElement('br'));
        }
        target.appendChild(buildPreviewFragment(line));
      });

      if (truncated) {
        target.appendChild(document.createTextNode(' ...'));
      }
    };

    interface MoodData {
      id: string;
      datetime: string;
      tag?: string;
      previewText: string;
      previewHtml?: string;
      media?: MediaItem[];
      image?: string | null;
      imageFallback?: string | null;
      mediaHtml?: string;
      needsDetailPage?: boolean;
    }

    interface MoodReservation {
      lineCount: number;
      lineWidths: string[];
      reservedHeight: number;
    }

    interface TextMeasurementConfig {
      font: string;
      lineHeight: number;
      textWidth: number;
      cardPaddingY: number;
      metaGap: number;
      tagHeight: number;
      thumbnailHeight: number;
    }

    type PretextModule = typeof import('@chenglou/pretext');

    const MAX_PREVIEW_LINES = 2;
    const DEFAULT_VISIBLE_SKELETONS = 1;
    const MOOD_PREVIEW_CACHE_KEY = 'home-moods-preview-cache:v2';
    const MOOD_PREVIEW_CACHE_TTL_MS = 1000 * 60 * 30;
    const PRETEXT_FONT_TIMEOUT_MS = 900;
    const PRETEXT_THUMBNAIL_HEIGHT = 48;
    const PRETEXT_META_GAP = 6;
    const HOME_THUMBNAIL_WIDTH = 480;
    const reservedCards = new Set<HTMLElement>();
    let renderedMoodSignature = '';

    const getMoodFeedUrl = (): string => '/api/moods';

    interface MoodPreviewCacheEntry {
      id: string;
      datetime: string;
      tag?: string;
      previewText: string;
      previewHtml?: string;
      media?: MediaItem[];
      image?: string | null;
      imageFallback?: string | null;
    }

    interface MoodPreviewCache {
      updatedAt: number;
      posts: MoodPreviewCacheEntry[];
    }

    const clearCardReservations = (): void => {
      reservedCards.forEach((card) => {
        card.style.removeProperty('--reserved-card-height');
        card.removeAttribute('data-reserved-lines');
        card.removeAttribute('data-reserved');

        const text = card.querySelector('.mood-text') as HTMLElement | null;
        if (text) {
          text.removeAttribute('data-reserved-lines');
        }
      });
      reservedCards.clear();
    };

    const debugPretextFallback = (reason: string, error?: unknown): void => {
      if (!import.meta.env.DEV) return;
      console.debug('[moods-pretext] Falling back to baseline skeletons:', reason, error);
    };

    const sanitizeCachedMood = (value: unknown): MoodPreviewCacheEntry | null => {
      if (!value || typeof value !== 'object') return null;

      const candidate = value as Partial<MoodPreviewCacheEntry>;
      if (typeof candidate.id !== 'string' || typeof candidate.datetime !== 'string') {
        return null;
      }

      return {
        id: candidate.id,
        datetime: candidate.datetime,
        tag: typeof candidate.tag === 'string' ? candidate.tag : undefined,
        previewText: typeof candidate.previewText === 'string' ? candidate.previewText : '',
        previewHtml: typeof candidate.previewHtml === 'string' ? candidate.previewHtml : '',
        media: sanitizeCachedMedia(candidate.media),
        image: typeof candidate.image === 'string' ? candidate.image : null,
        imageFallback: typeof candidate.imageFallback === 'string' ? candidate.imageFallback : null,
      };
    };

    const readCachedPreviewPosts = (): MoodPreviewCacheEntry[] => {
      try {
        const raw = window.localStorage.getItem(MOOD_PREVIEW_CACHE_KEY);
        if (!raw) return [];

        const parsed = JSON.parse(raw) as Partial<MoodPreviewCache>;
        if (!parsed || typeof parsed.updatedAt !== 'number' || !Array.isArray(parsed.posts)) {
          return [];
        }

        if (Date.now() - parsed.updatedAt > MOOD_PREVIEW_CACHE_TTL_MS) {
          window.localStorage.removeItem(MOOD_PREVIEW_CACHE_KEY);
          return [];
        }

        return parsed.posts
          .map((post) => sanitizeCachedMood(post))
          .filter((post): post is MoodPreviewCacheEntry => post !== null)
          .slice(0, MAX_MOODS);
      } catch (error) {
        debugPretextFallback('cache read failed', error);
        return [];
      }
    };

    const readInitialPreviewPosts = (): MoodData[] => {
      const source = list?.querySelector('[data-mood-preview-initial]');
      if (!(source instanceof HTMLScriptElement) || !source.textContent) return [];

      try {
        const parsed = JSON.parse(source.textContent) as unknown;
        if (!Array.isArray(parsed)) return [];
        return parsed
          .map((post) => sanitizeCachedMood(post))
          .filter((post): post is MoodPreviewCacheEntry => post !== null)
          .slice(0, MAX_MOODS) as MoodData[];
      } catch (error) {
        debugPretextFallback('initial payload read failed', error);
        return [];
      }
    };

    const writeCachedPreviewPosts = (posts: MoodData[]): void => {
      try {
        const payload: MoodPreviewCache = {
          updatedAt: Date.now(),
          posts: posts.slice(0, MAX_MOODS).map((post) => ({
            id: post.id,
            datetime: post.datetime,
            tag: post.tag,
            previewText: typeof post.previewText === 'string' ? post.previewText : '',
            previewHtml: typeof post.previewHtml === 'string' ? post.previewHtml : '',
            media: sanitizeCachedMedia(post.media),
            image: typeof post.image === 'string' ? post.image : null,
            imageFallback: typeof post.imageFallback === 'string' ? post.imageFallback : null,
          })),
        };

        window.localStorage.setItem(MOOD_PREVIEW_CACHE_KEY, JSON.stringify(payload));
      } catch (error) {
        debugPretextFallback('cache write failed', error);
      }
    };

    const createMoodSignature = (
      posts: Array<MoodData | MoodPreviewCacheEntry>,
    ): string => JSON.stringify(
      posts.map((post) => ({
        id: post.id,
        datetime: post.datetime,
        tag: post.tag ?? '',
        previewText: post.previewText ?? '',
        previewHtml: post.previewHtml ?? '',
        media: compactMediaSignature(post.media),
        image: post.image ?? '',
        imageFallback: post.imageFallback ?? '',
      })),
    );

    const sanitizeCachedMedia = (value: unknown): MediaItem[] => {
      if (!Array.isArray(value)) return [];

      return value
        .map((item) => {
          if (!item || typeof item !== 'object') return null;
          const candidate = item as Partial<MediaItem>;
          if (typeof candidate.type !== 'string') return null;

          const safeTypes: MediaItem['type'][] = [
            'image',
            'video',
            'audio',
            'document',
            'embed',
            'sticker',
            'link-preview',
            'location',
            'poll',
          ];
          if (!safeTypes.includes(candidate.type as MediaItem['type'])) return null;

          const media: MediaItem = {
            type: candidate.type as MediaItem['type'],
          };
          if (typeof candidate.src === 'string') media.src = candidate.src;
          if (typeof candidate.href === 'string') media.href = candidate.href;
          if (typeof candidate.posterSrc === 'string') media.posterSrc = candidate.posterSrc;
          if (typeof candidate.thumbnailSrc === 'string') media.thumbnailSrc = candidate.thumbnailSrc;
          if (typeof candidate.title === 'string') media.title = candidate.title;
          if (typeof candidate.description === 'string') media.description = candidate.description;
          if (typeof candidate.siteName === 'string') media.siteName = candidate.siteName;
          if (typeof candidate.fileName === 'string') media.fileName = candidate.fileName;
          if (typeof candidate.mimeType === 'string') media.mimeType = candidate.mimeType;

          return media;
        })
        .filter((item): item is MediaItem => item !== null)
        .slice(0, 4);
    };

    const compactMediaSignature = (media: readonly MediaItem[] | undefined): string => (
      sanitizeCachedMedia(media).map((item) => [
        item.type,
        item.src ?? '',
        item.href ?? '',
        item.posterSrc ?? '',
        item.thumbnailSrc ?? '',
        item.title ?? '',
        item.fileName ?? '',
      ].join(':')).join('|')
    );

    const getStructuredMediaPreview = (
      mood: Pick<MoodData, 'media' | 'image'>,
    ): { label: string; thumbnail: string; speaksForItself: boolean } | null => {
      const media = sanitizeCachedMedia(mood.media);
      if (!media.length) return null;

      const rich = media.find((item) => item.type !== 'image' && item.type !== 'sticker') ?? media[0];
      if (!rich) return null;

      const thumbnail = (
        rich.thumbnailSrc
        || rich.posterSrc
        || (rich.type === 'image' || rich.type === 'sticker' ? rich.src : '')
        || ''
      ).trim();
      const title = (rich.title || rich.fileName || rich.siteName || '').trim();
      const fallbackLabels: Partial<Record<MediaItem['type'], string>> = {
        video: 'Video',
        audio: 'Voice',
        document: 'Document',
        embed: 'Embed',
        sticker: 'Sticker',
        'link-preview': 'Link preview',
        location: 'Location',
        poll: 'Poll',
        image: 'Photo',
      };

      return {
        label: title || fallbackLabels[rich.type] || 'Media post',
        thumbnail,
        // An untitled photo or sticker is its own preview: a type name set
        // over the thumbnail ("Photo") repeats what the image already says.
        speaksForItself: !title
          && Boolean(thumbnail || mood.image)
          && (rich.type === 'image' || rich.type === 'sticker'),
      };
    };

    const appendMediaFallback = (card: HTMLElement): void => {
      if (card.querySelector('.mood-text, .mood-media-fallback, .mood-meta')) return;

      const fallback = document.createElement('span');
      fallback.className = 'mood-media-fallback';
      fallback.textContent = 'Media post';
      card.appendChild(fallback);
    };

    const removeFailedThumbnail = (thumbnail: HTMLElement): void => {
      const meta = thumbnail.parentElement;
      const card = meta?.parentElement instanceof HTMLElement ? meta.parentElement : null;
      thumbnail.remove();
      if (meta && meta.childElementCount === 0) {
        meta.remove();
      }
      if (card) {
        appendMediaFallback(card);
      }
    };

    const loadPretextModule = async (): Promise<PretextModule | null> => {
      try {
        pretextPromise ??= import('@chenglou/pretext');
        return await pretextPromise;
      } catch (error) {
        debugPretextFallback('pretext import failed', error);
        return null;
      }
    };

    const buildCanvasFontShorthand = (styles: CSSStyleDeclaration): string | null => {
      const fontSize = styles.fontSize?.trim();
      const fontFamily = styles.fontFamily?.trim();
      if (!fontSize || !fontFamily) return null;

      const fontStyle = styles.fontStyle && styles.fontStyle !== 'normal' ? `${styles.fontStyle} ` : '';
      const fontWeight = styles.fontWeight && styles.fontWeight !== 'normal' ? `${styles.fontWeight} ` : '';

      return `${fontStyle}${fontWeight}${fontSize} ${fontFamily}`.trim();
    };

    const readTextMeasurementConfig = (): TextMeasurementConfig | null => {
      if (!list) return null;

      const skeletonCard = list.querySelector('.mood-card-skeleton') as HTMLElement | null;
      if (!skeletonCard) return null;

      const host = document.createElement('div');
      host.setAttribute('aria-hidden', 'true');
      host.style.cssText = [
        'position:absolute',
        'left:-9999px',
        'top:0',
        'visibility:hidden',
        'pointer-events:none',
        'contain:layout style',
      ].join(';');

      const textProbe = document.createElement('span');
      textProbe.className = 'mood-text';
      textProbe.textContent = 'Measurement probe';

      const tagProbe = document.createElement('span');
      tagProbe.className = 'mood-tag';
      tagProbe.textContent = '#probe';

      host.appendChild(textProbe);
      host.appendChild(tagProbe);
      document.body.appendChild(host);

      const cardStyles = window.getComputedStyle(skeletonCard);
      const textStyles = window.getComputedStyle(textProbe);
      const textWidth =
        skeletonCard.clientWidth
        - Number.parseFloat(cardStyles.paddingLeft || '0')
        - Number.parseFloat(cardStyles.paddingRight || '0');
      const lineHeight = Number.parseFloat(textStyles.lineHeight || '0');
      const cardPaddingY =
        Number.parseFloat(cardStyles.paddingTop || '0')
        + Number.parseFloat(cardStyles.paddingBottom || '0');
      const tagHeight = Math.ceil(tagProbe.getBoundingClientRect().height);
      const font = buildCanvasFontShorthand(textStyles);

      host.remove();

      if (!font || !Number.isFinite(textWidth) || textWidth <= 0 || !Number.isFinite(lineHeight) || lineHeight <= 0) {
        return null;
      }

      return {
        font,
        lineHeight,
        textWidth,
        cardPaddingY,
        metaGap: PRETEXT_META_GAP,
        tagHeight,
        thumbnailHeight: PRETEXT_THUMBNAIL_HEIGHT,
      };
    };

    const waitForFontReady = async (font: string): Promise<boolean> => {
      if (!('fonts' in document) || typeof document.fonts.load !== 'function') {
        return true;
      }

      const timeout = new Promise<boolean>((resolve) => {
        window.setTimeout(() => resolve(false), PRETEXT_FONT_TIMEOUT_MS);
      });

      const loaded = Promise.all([
        document.fonts.load(font, 'Bunizao'),
        document.fonts.load(font, 'MMMM 88'),
        document.fonts.ready,
      ])
        .then(() => true)
        .catch((error) => {
          debugPretextFallback('font sync failed', error);
          return false;
        });

      return Promise.race([loaded, timeout]);
    };

    const formatReservationWidth = (width: number, maxWidth: number): string => {
      if (!Number.isFinite(width) || width <= 0 || !Number.isFinite(maxWidth) || maxWidth <= 0) {
        return '70%';
      }

      const percentage = Math.max(18, Math.min(100, (width / maxWidth) * 100));
      return `${percentage.toFixed(2)}%`;
    };

    const measureMoodReservation = (
      mood: MoodData,
      config: TextMeasurementConfig,
      pretext: PretextModule,
    ): MoodReservation | null => {
      const previewText = (mood.previewText ?? '').trim();
      if (!previewText) {
        return null;
      }

      const prepared = pretext.prepareWithSegments(previewText, config.font);
      const result = pretext.layoutWithLines(prepared, config.textWidth, config.lineHeight);
      const visibleLines = result.lines.slice(0, MAX_PREVIEW_LINES);
      const lineCount = Math.max(1, Math.min(MAX_PREVIEW_LINES, visibleLines.length || result.lineCount || 1));
      const lineWidths = Array.from({ length: lineCount }, (_, index) => {
        const line = visibleLines[index];
        return formatReservationWidth(line?.width ?? config.textWidth * 0.7, config.textWidth);
      });
      const textHeight = Math.ceil(config.lineHeight * lineCount);
      const structuredMediaPreview = getStructuredMediaPreview(mood);
      const metaHeight = mood.image || structuredMediaPreview?.thumbnail || structuredMediaPreview?.label
        ? config.thumbnailHeight
        : mood.tag
          ? config.tagHeight
          : 0;
      const reservedHeight = Math.ceil(
        config.cardPaddingY
        + textHeight
        + (metaHeight > 0 ? config.metaGap + metaHeight : 0)
      );

      return {
        lineCount,
        lineWidths,
        reservedHeight,
      };
    };

    const measureMoodReservations = async (posts: MoodData[]): Promise<Array<MoodReservation | null>> => {
      if (!posts.length) {
        return [];
      }

      const [pretext, config] = await Promise.all([loadPretextModule(), Promise.resolve(readTextMeasurementConfig())]);
      if (!pretext || !config) {
        return posts.map(() => null);
      }

      const fontReady = await waitForFontReady(config.font);
      if (!fontReady) {
        debugPretextFallback('font load timeout');
        return posts.map(() => null);
      }

      try {
        return posts.map((post) => measureMoodReservation(post, config, pretext));
      } catch (error) {
        debugPretextFallback('layout measurement failed', error);
        return posts.map(() => null);
      }
    };

    const applyReservationToSkeleton = (
      item: Element,
      reservation: MoodReservation | null,
    ): void => {
      const card = item.querySelector('.mood-card-skeleton') as HTMLElement | null;
      const lines = item.querySelector('[data-skeleton-lines]') as HTMLElement | null;
      if (!card || !lines || !reservation) return;

      card.style.setProperty('--reserved-card-height', `${reservation.reservedHeight}px`);
      lines.dataset.lineCount = String(reservation.lineCount);
      lines.style.setProperty('--line-1', reservation.lineWidths[0] ?? '70%');
      lines.style.setProperty('--line-2', reservation.lineWidths[1] ?? '42%');
    };

    const setVisibleSkeletonCount = (count: number | null): void => {
      if (!list) return;

      const skeletons = Array.from(list.querySelectorAll('.mood-item-skeleton'));
      skeletons.forEach((skeleton, index) => {
        (skeleton as HTMLElement).hidden = count !== null && index >= count;
      });
    };

    const applyReservationsToSkeletons = (reservations: Array<MoodReservation | null>): void => {
      if (!list || !reservations.length) return;

      const skeletons = Array.from(list.querySelectorAll('.mood-item-skeleton'));
      reservations.forEach((reservation, index) => {
        const skeleton = skeletons[index];
        if (!skeleton) return;
        applyReservationToSkeleton(skeleton, reservation);
      });
    };

    const primeSkeletonsFromCache = async (): Promise<void> => {
      const cachedPosts = readCachedPreviewPosts();
      if (!cachedPosts.length) {
        setVisibleSkeletonCount(DEFAULT_VISIBLE_SKELETONS);
        return;
      }

      renderedMoodSignature = createMoodSignature(cachedPosts);
      const reservations = await measureMoodReservations(cachedPosts);
      renderMoods(cachedPosts as MoodData[], reservations, {
        animate: false,
        preserveBusy: true,
      });
    };

    const primeSkeletonsFromInitialPosts = async (): Promise<boolean> => {
      const initialPosts = readInitialPreviewPosts();
      if (!initialPosts.length) return false;

      renderedMoodSignature = createMoodSignature(initialPosts);
      initialPreviewLoadedAt = Date.now();
      writeCachedPreviewPosts(initialPosts);
      setVisibleSkeletonCount(initialPosts.length);
      const reservations = await measureMoodReservations(initialPosts);
      applyReservationsToSkeletons(reservations);
      renderMoods(initialPosts, reservations, {
        animate: true,
        preserveBusy: true,
      });
      return true;
    };

    const applyReservationToCard = (
      card: HTMLElement,
      text: HTMLElement | null,
      reservation: MoodReservation | null,
    ): void => {
      if (!reservation) return;

      card.dataset.reserved = 'true';
      card.dataset.reservedLines = String(reservation.lineCount);
      card.style.setProperty('--reserved-card-height', `${reservation.reservedHeight}px`);
      reservedCards.add(card);

      if (text) {
        text.dataset.reservedLines = String(reservation.lineCount);
      }
    };

    const createMoodItem = (
      mood: MoodData,
      index: number,
      reservation: MoodReservation | null,
    ): HTMLElement => {
      const item = document.createElement('div');
      item.className = 'mood-item mood-item--clickable';
      item.dataset.href = getMoodDetailHref(mood.id);
      item.setAttribute('role', 'link');
      item.tabIndex = 0;
      item.style.cssText = `--item-index: ${index}`;

      const timeCol = document.createElement('div');
      timeCol.className = 'mood-time-col';
      const time = document.createElement('time');
      time.className = 'mood-time';
      time.dateTime = mood.datetime;
      time.textContent = formatTime(mood.datetime);
      timeCol.appendChild(time);

      const lineCol = document.createElement('div');
      lineCol.className = 'mood-line-col';
      const dot = document.createElement('div');
      dot.className = 'mood-dot';
      const line = document.createElement('div');
      line.className = 'mood-line';
      lineCol.appendChild(dot);
      lineCol.appendChild(line);

      const contentCol = document.createElement('div');
      contentCol.className = 'mood-content-col';
      const card = document.createElement('div');
      card.className = 'mood-card';

      const text = document.createElement('span');
      text.className = 'mood-text';
      const previewText = mood.previewText || '';
      const previewHtml = mood.previewHtml || '';
      const structuredMediaPreview = getStructuredMediaPreview(mood);
      const hasText = previewText.trim().length > 0 || previewHtml.trim().length > 0;
      const mediaLabel = structuredMediaPreview?.speaksForItself ? '' : structuredMediaPreview?.label ?? '';
      if (hasText || mediaLabel || !(mood.image || structuredMediaPreview?.thumbnail)) {
        if (hasText) {
          appendPreviewLines(text, previewText, previewHtml);
        } else if (mediaLabel) {
          text.textContent = mediaLabel;
        } else {
          text.textContent = '(No text)';
        }
        card.appendChild(text);
      }

      const structuredThumbnail = structuredMediaPreview?.thumbnail ?? '';
      const hasMetaContent = mood.tag || mood.image || structuredThumbnail;
      if (hasMetaContent) {
        const meta = document.createElement('div');
        meta.className = 'mood-meta';

        if (mood.tag) {
          const tag = document.createElement('span');
          tag.className = 'mood-tag';
          tag.textContent = `#${mood.tag}`;
          meta.appendChild(tag);
        }

        const thumbnailSrc = mood.image || structuredThumbnail;
        if (thumbnailSrc) {
          const thumbnail = document.createElement('div');
          thumbnail.className = 'mood-thumbnail';
          const placeholderSrc = getMoodImagePlaceholderSrc(thumbnailSrc);
          if (placeholderSrc) {
            thumbnail.classList.add('mood-image-frame');
            thumbnail.dataset.moodImageFrame = '';
            const placeholder = document.createElement('img');
            placeholder.className = 'mood-image-blur';
            placeholder.src = placeholderSrc;
            placeholder.alt = '';
            placeholder.setAttribute('aria-hidden', 'true');
            placeholder.loading = 'lazy';
            placeholder.decoding = 'async';
            thumbnail.appendChild(placeholder);
          }
          const img = document.createElement('img');
          img.src = withWidthParam(thumbnailSrc, HOME_THUMBNAIL_WIDTH);
          const fallback = mood.image && typeof mood.imageFallback === 'string' ? mood.imageFallback.trim() : '';
          if (fallback) {
            img.dataset.fallbackSrc = withWidthParam(fallback, HOME_THUMBNAIL_WIDTH);
          }
          img.onerror = () => {
            if (img.dataset.fallbackApplied !== '1') {
              const fallbackSrc = img.dataset.fallbackSrc || '';
              if (fallbackSrc) {
                img.dataset.fallbackApplied = '1';
                img.src = fallbackSrc;
                return;
              }
            }

            removeFailedThumbnail(thumbnail);
          };
          // When the card carries no words, the type name moves into the alt
          // so the row still has a name beyond its date.
          img.alt = !hasText && structuredMediaPreview?.speaksForItself ? structuredMediaPreview.label : '';
          img.loading = 'lazy';
          img.decoding = 'async';
          img.width = PRETEXT_THUMBNAIL_HEIGHT;
          img.height = PRETEXT_THUMBNAIL_HEIGHT;
          if (placeholderSrc) {
            img.dataset.moodImageMain = '';
          }
          thumbnail.appendChild(img);
          initMoodImageFrames(thumbnail);
          meta.appendChild(thumbnail);
        }

        card.appendChild(meta);
      }

      applyReservationToCard(card, card.querySelector('.mood-text') as HTMLElement | null, reservation);

      contentCol.appendChild(card);

      item.appendChild(timeCol);
      item.appendChild(lineCol);
      item.appendChild(contentCol);

      return item;
    };

    const renderMoods = (
      posts: MoodData[],
      reservations: Array<MoodReservation | null>,
      options: { animate?: boolean; preserveBusy?: boolean } = {},
    ): void => {
      if (!list) return;

      const { animate = true, preserveBusy = false } = options;
      if (!preserveBusy) {
        list.removeAttribute('aria-busy');
      }

      const showContent = () => {
        if (errorState) errorState.hidden = true;

        if (!posts.length) {
          if (emptyState) emptyState.hidden = false;
          return;
        }

        if (emptyState) emptyState.hidden = true;

        // Create items and animate in
        const items: HTMLElement[] = [];
        posts.forEach((post, index) => {
          const item = createMoodItem(post, index, reservations[index] ?? null);
          list.appendChild(item);
          items.push(item);
        });

        if (!animate) return;

        // Splash-in is CSS: items land with .mood-item--entering, then a single
        // rAF flips them to their resting state and the transition carries them.
        // The stagger is a per-item transition-delay, so no ticker is involved
        // and a busy main thread cannot freeze the cards mid-entrance.
        items.forEach((item, index) => {
          item.style.setProperty('--item-index', String(index));
          item.classList.add('mood-item--entering');
        });

        requestAnimationFrame(() => {
          items.forEach((item) => item.classList.remove('mood-item--entering'));
        });
      };

      const skeletons = list.querySelectorAll<HTMLElement>('.mood-item-skeleton');
      if (animate && skeletons.length > 0) {
        skeletons.forEach((skeleton) => skeleton.classList.add('mood-item--leaving'));

        // Swap once the longest-delayed skeleton has finished dissolving. A
        // timer rather than transitionend: the element is about to be removed,
        // and a dropped event would strand the list on its skeletons forever.
        const SKELETON_EXIT_MS = 500 + (skeletons.length - 1) * 60;
        window.setTimeout(() => {
          list.replaceChildren();
          showContent();
        }, SKELETON_EXIT_MS);
      } else {
        list.replaceChildren();
        showContent();
      }
    };

    const loadMoods = async (): Promise<void> => {
      if (runtimeDisabled || ALWAYS_LOADING || hasLoaded || !list) return;

      if (initialPreviewLoadedAt > 0) {
        const age = Date.now() - initialPreviewLoadedAt;
        if (age < INITIAL_PREVIEW_REVALIDATE_MS) {
          schedulePreviewRevalidation(INITIAL_PREVIEW_REVALIDATE_MS - age);
          return;
        }

        initialPreviewLoadedAt = 0;
      }

      hasLoaded = true;

      try {
        const response = await fetch(getMoodFeedUrl());
        if (!response.ok) {
          throw new Error('Failed to fetch moods.');
        }
        const data = await response.json() as { posts?: unknown[] };
        const posts = Array.isArray(data.posts) ? (data.posts.slice(0, MAX_MOODS) as MoodData[]) : [];
        writeCachedPreviewPosts(posts);
        const nextSignature = createMoodSignature(posts);
        const hasRenderedCards = Boolean(list.querySelector('.mood-card:not(.mood-card-skeleton)'));
        if (renderedMoodSignature && renderedMoodSignature === nextSignature && hasRenderedCards) {
          list.removeAttribute('aria-busy');
          if (emptyState) emptyState.hidden = true;
          if (errorState) errorState.hidden = true;
          return;
        }

        setVisibleSkeletonCount(posts.length);
        const reservations = await measureMoodReservations(posts);
        applyReservationsToSkeletons(reservations);
        renderMoods(posts, reservations, {
          animate: !hasRenderedCards,
        });
        renderedMoodSignature = nextSignature;
      } catch (error) {
        console.error('Failed to fetch moods:', error);
        if (list) {
          list.removeAttribute('aria-busy');
          list.replaceChildren();
        }
        if (emptyState) emptyState.hidden = true;
        if (errorState) errorState.hidden = false;
      }
    };

    const schedulePreviewRevalidation = (delay: number): void => {
      if (previewRevalidationTimer) return;
      previewRevalidationTimer = window.setTimeout(() => {
        previewRevalidationTimer = 0;
        void loadMoods();
      }, Math.max(1000, delay));
    };

    const navigateToMood = (target: HTMLElement | null): void => {
      if (!target || target.closest('a')) return;
      const item = target.closest('.mood-item--clickable') as HTMLElement | null;
      if (!item) return;
      const href = item.dataset.href;
      if (href) {
        window.location.href = href;
      }
    };

    if (list) {
      window.addEventListener('resize', clearCardReservations, { passive: true });

      list.addEventListener('click', (event) => {
        navigateToMood(event.target as HTMLElement | null);
      });

      list.addEventListener('keydown', (event) => {
        const keyEvent = event as KeyboardEvent;
        if (keyEvent.key !== 'Enter' && keyEvent.key !== ' ') return;
        const target = event.target as HTMLElement | null;
        if (!target || target.closest('a')) return;
        event.preventDefault();
        navigateToMood(target);
      });
    }

    const initMoods = () => {
      const loadIfVisible = () => {
        const rect = moodsSection.getBoundingClientRect();
        const viewportHeight = window.innerHeight || document.documentElement.clientHeight || 0;
        if (rect.top <= viewportHeight * 0.85) {
          void loadMoods();
        }
      };

      // The section's entrance is owned by src/lib/home-reveal.ts via the
      // `data-reveal` attribute. All this needs to do is start fetching when
      // the section approaches, which the observer below already handles.
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            if (!entries.some((entry) => entry.isIntersecting)) return;
            observer.disconnect();
            void loadMoods();
          },
          { rootMargin: '0px 0px -15% 0px' },
        );

        observer.observe(moodsSection);
      }

      loadIfVisible();
    };

    if (!runtimeDisabled) {
      await primeSkeletonsFromInitialPosts() || await primeSkeletonsFromCache();
    }
    void initMoods();
  };

  // Initialize when DOM is ready
  void initMoodsAnimation();
</script>
