---
import CommentCompose from '@/features/mood/ui/CommentCompose.astro';
import { resolveMoodCommentsCopy } from '@/features/comments/copy';
import type { BlogLocale } from '@/data/site';

interface Props {
  postId: string;
  telegramCommentUrl?: string;
  /** MoodContentDocument.discussionLinked -- the post's copy in the Telegram
      discussion group is known and mood comments are enabled, so the box
      below can post into the thread. False or absent keeps the existing
      "Leave a comment on Telegram" CTA. */
  discussionLinked?: boolean;
  discussionRepliesEnabled?: boolean;
  turnstileSiteKey?: string;
  /** The page's negotiated language -- see `resolveRequestLocale`. Stamped on
      the section as `data-locale` so the client controller, which builds the
      comment rows, reads the same language this markup was rendered in. */
  locale: BlogLocale;
}

const {
  postId,
  telegramCommentUrl = '',
  discussionLinked = false,
  discussionRepliesEnabled = false,
  turnstileSiteKey = '',
  locale,
} = Astro.props;

const t = resolveMoodCommentsCopy(locale);
---

<section
  class="mood-comments"
  id="comments"
  data-post-id={postId}
  data-locale={locale}
  data-discussion-replies-enabled={discussionRepliesEnabled ? 'true' : 'false'}
>
  {discussionLinked && (
    <CommentCompose
      postId={postId}
      discussionRepliesEnabled={discussionRepliesEnabled}
      turnstileSiteKey={turnstileSiteKey}
      locale={locale}
    />
  )}
  <div class="mood-comments-header">
    <span class="mood-comments-title">{t.title}</span>
    <span class="mood-comments-count" data-comments-count></span>
  </div>
  <div class="mood-comments-list" data-comments-list>
    <div class="mood-comments-skeleton" data-comments-loading>
      <div class="mood-comment mood-comment--skeleton" style="--skeleton-delay: 0s;">
        <div class="mood-comment-avatar mood-comment-avatar--skeleton" aria-hidden="true"></div>
        <div class="mood-comment-body">
          <div class="mood-comment-header">
            <span
              class="mood-comment-skeleton-line mood-comment-skeleton-line--author"
              style="--line-width: 100px;"
            ></span>
            <span
              class="mood-comment-skeleton-line mood-comment-skeleton-line--date"
              style="--line-width: 49px;"
            ></span>
          </div>
          <div class="mood-comment-content mood-comment-content--skeleton">
            <span
              class="mood-comment-skeleton-line mood-comment-skeleton-line--content"
              style="--line-width: 34px;"
            ></span>
          </div>
        </div>
      </div>
      <div class="mood-comment mood-comment--skeleton" style="--skeleton-delay: 0.15s;">
        <div class="mood-comment-avatar mood-comment-avatar--skeleton" aria-hidden="true"></div>
        <div class="mood-comment-body">
          <div class="mood-comment-header">
            <span
              class="mood-comment-skeleton-line mood-comment-skeleton-line--author"
              style="--line-width: 85px;"
            ></span>
            <span
              class="mood-comment-skeleton-line mood-comment-skeleton-line--date"
              style="--line-width: 55px;"
            ></span>
          </div>
          <div class="mood-comment-content mood-comment-content--skeleton">
            <span
              class="mood-comment-skeleton-line mood-comment-skeleton-line--content"
              style="--line-width: 120px;"
            ></span>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="mood-comments-empty" data-comments-empty hidden>
    <p>{t.empty}</p>
  </div>
  <button type="button" class="mood-comments-load-more" data-load-more hidden>
    {t.loadMore}
  </button>
  {/* The route out to the group, last row of the thread. It is the only way
      to comment while the bridge is off, and stays on below the thread once
      it is on -- writing in the group has always been an option and the box
      does not take it away. It keeps the avatar column so it lines up with
      the comments above it, but it carries no author and no timestamp: a
      button wearing those reads as a comment in costume. */}
  {telegramCommentUrl && (
    <a
      href={telegramCommentUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mood-comment mood-comment-cta-wrap"
    >
      <div class="mood-comment-avatar mood-comment-avatar--telegram"></div>
      <div class="mood-comment-body">
        <div class="mood-comment-content mood-comment-cta-content">
          <span>{t.telegramCta}</span>
          <svg
            class="mood-comment-cta-arrow"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </div>
      </div>
    </a>
  )}
</section>

<style is:global>
  .mood-comments {
    /* No rule above the section. It ran parallel to the compose capsule's own
       edge a few pixels away, so the two read as one doubled border; space
       separates the section and the capsule keeps its shape. */
    margin-top: 40px;
    margin-inline: auto;
    max-width: 34rem;
    /* globals.css pads every `section` from the top; here that padding sat
       between the heading and nothing, so the section opened with a hole. */
    padding-top: 0;
    position: relative;
    /* #comments is how the feed and the popover link into this section. */
    scroll-margin-top: 72px;
    /* Two sizes, not five. Every comment UI worth copying -- GitHub, Telegram
       Web, Discourse -- gives the name the body's own size and lets weight and
       colour carry the hierarchy, and none of them drops the timestamp more
       than one step. 13px is the floor .blog-comments already settled on for
       the same reason it applies here: two Chinese characters are the shortest
       label this thread gets, and the glyph is the box. */
    --comment-body: 15px;
    --comment-meta: 13px;
    /* 1.618 exactly. At 15px that is a 24.3px line, which is also where the
       comfortable range for this measure lands -- the ratio and the reading
       agree, so there is no reason to round away from it. */
    --comment-lead: 1.618;
    /* One bubble shape at every width. The tight top-left corner points the
       bubble at its avatar, which sits at the top of the row. */
    /* One golden ladder for every gap inside the bubble: 6 -> 10 -> 16, each
       rung 1.618x the last. 6 separates parts of one thought (name from
       message, message from its footer), 10 is the bubble's vertical breath,
       16 its horizontal. Parts of a thought therefore always sit closer to
       each other than to the bubble's edge, which is the whole job of the
       spacing. It holds at every width -- four different paddings across
       four breakpoints is what made this feel arbitrary. */
    --comment-body-padding: 10px 16px;
    --comment-gap-inner: 6px;
    --comment-body-radius: var(--radius-sm) var(--radius-xl) var(--radius-xl)
      var(--radius-xl);
    --comment-stack-gap: 16px;

    /* The dirt the old values read as was not a missing hue -- it was a flat
       mid-light slab: 6% of black on white is #F0F0F0 across the whole
       bubble, at any tuning. A hairline draws the same shape and leaves the
       page's own ground behind the text, which is what Card and Input do in
       every system worth copying. Dark carries a touch more border, since the
       same alpha reads weaker against a dark ground. */
    --comment-bubble-bg: transparent;
    --comment-bubble-border: hsl(var(--foreground) / 0.11);
  }

  .dark .mood-comments {
    --comment-bubble-border: hsl(var(--foreground) / 0.16);
  }

  @media (min-width: 640px) {
    .mood-comments {
      margin-top: 48px;
      --comment-stack-gap: 18px;
    }
  }

  @media (min-width: 1024px) {
    .mood-comments {
      margin-top: 56px;
    }
  }

  .mood-comments-header {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 28px 0 16px;
  }

  @media (min-width: 640px) {
    .mood-comments-header {
      margin-bottom: 20px;
    }
  }

  /* A heading in the page's own voice. The uppercase micro-label was chrome
     for a section that no longer opens with a rule; at the top of a thread
     the word is content, and it sets the size the count answers to. */
  .mood-comments-title {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.008em;
    line-height: 1.3;
    color: hsl(var(--foreground));
  }

  .mood-comments-count {
    font-size: 15px;
    color: hsl(var(--muted-foreground) / 0.6);
    font-variant-numeric: tabular-nums;
  }

  .mood-comments-count:empty {
    display: none;
  }

  /* The gap already separates them; a middot between a word and its own
     count is punctuation for nothing. */
  .mood-comments-count::before {
    content: none;
  }

  .mood-comments-list {
    display: flex;
    flex-direction: column;
    gap: var(--comment-stack-gap);
  }

  .mood-comments-skeleton {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .mood-comment {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 0;
    position: relative;
    animation: comment-fade-in var(--dur-enter) var(--ease-out) backwards;
  }

  @media (min-width: 640px) {
    .mood-comment {
      gap: 12px;
    }
  }

  @keyframes comment-fade-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mood-comment--skeleton {
    animation: none;
  }

  .mood-comment--skeleton .mood-comment-body {
    width: fit-content;
  }

  .mood-comment-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    /* The ring and the drop shadow existed to lift the avatar off a filled
       bubble. With the bubble outlined there is nothing to lift off, and a
       single flat disc sits in the same register as the hairline beside it. */
    background: hsl(var(--foreground) / 0.06);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 600;
    color: hsl(var(--foreground) / 0.55);
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .mood-comment-avatar {
      width: 36px;
      height: 36px;
      font-size: 13px;
    }
  }

  .mood-comment-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mood-comment-avatar--skeleton {
    position: relative;
    overflow: hidden;
  }

  .mood-comment-avatar--skeleton::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      hsl(var(--foreground) / 0.15) 50%,
      transparent 100%
    );
    animation: comment-skeleton-shimmer 2s ease-in-out infinite;
    animation-delay: var(--skeleton-delay, 0s);
  }

  .mood-comment-body {
    width: fit-content;
    max-width: 100%;
    min-width: 0;
    /* One family for the whole bubble. A comment is a self-contained reading
       unit, so it reads in the prose face throughout rather than switching to
       the page's mono chrome voice halfway down. */
    font-family: var(--font-sans);
    background: var(--comment-bubble-bg);
    border: 1px solid var(--comment-bubble-border);
    border-radius: var(--comment-body-radius);
    padding: var(--comment-body-padding);
    position: relative;
  }

  .mood-comment-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: var(--comment-gap-inner);
    flex-wrap: wrap;
  }

  /* Where the comment was written. Monochrome on purpose -- the mood surface
     has no accent colour, so the glyph carries the distinction, not a brand
     blue. */
  .mood-comment-source {
    display: inline-flex;
    align-items: center;
    color: hsl(var(--muted-foreground) / 0.7);
  }

  .mood-comment-source svg {
    width: 13px;
    height: 13px;
  }

  /* The body's own size, GitHub's rule: weight and colour separate the name
     from the message, not a size step. */
  .mood-comment-author {
    font-size: var(--comment-body);
    font-weight: 600;
    color: hsl(var(--foreground) / 0.92);
  }

  /* One step under the body, which is as far as Telegram Web drops its own
     timestamp. No bullet ahead of it: colour is the separator. */
  .mood-comment-date {
    font-size: var(--comment-meta);
    font-weight: 400;
    color: hsl(var(--muted-foreground) / 0.75);
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1, 'zero' 1;
  }

  .mood-comment-content {
    font-size: var(--comment-body);
    line-height: var(--comment-lead);
    color: hsl(var(--foreground) / 0.95);
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .mood-comment-body:has(.image-list-container) {
    width: min(100%, 270px);
    max-width: min(100%, 270px);
  }

  .mood-comment-content p {
    margin: 0 0 0.8em;
  }

  .mood-comment-content p:last-child {
    margin-bottom: 0;
  }

  .mood-comment-content a {
    color: hsl(var(--foreground));
    text-decoration: none;
    border-bottom: 1px solid hsl(var(--foreground) / 0.3);
    transition: border-color 0.15s ease;
  }

  .mood-comment-content a:hover {
    border-bottom-color: hsl(var(--foreground) / 0.6);
  }

  .mood-comment-content .emoji {
    font-style: normal;
  }

  .mood-comment-content .emoji b {
    font-weight: inherit;
  }

  .mood-comment-content .tg-emoji {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.1em;
    height: 1.1em;
    vertical-align: -0.15em;
  }

  .mood-comment-content .tg-emoji img {
    width: 100%;
    height: 100%;
    display: block;
  }

  .mood-comment-content .tg-emoji[data-emoji-animated='true'] img {
    display: none;
  }

  .mood-comment-content .tg-emoji-anim,
  .mood-comment-content .tg-emoji-anim svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .mood-comment-content .image-list-container {
    display: grid;
    gap: 6px;
    margin: 4px 0 2px;
    width: min(100%, 220px);
    max-width: min(100%, 220px);
  }

  .mood-comment-content .image-list-even {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: min(100%, 240px);
  }

  .mood-comment-content .image-list-container:has(.image-preview-wrap ~ .image-preview-wrap) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: min(100%, 240px);
    max-width: min(100%, 240px);
  }

  .mood-comment-content .image-preview-wrap {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: 10px;
    overflow: hidden;
    background: hsl(var(--foreground) / 0.06);
    cursor: pointer;
    aspect-ratio: 1 / 1;
  }

  .mood-comment-content p:has(> .sticker:only-child) {
    width: 256px;
    max-width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-sm);
    background: color-mix(in oklab, hsl(var(--foreground)) 3.5%, hsl(var(--background)));
    overflow: hidden;
  }

  .mood-comment-content .sticker {
    display: block;
    width: 100%;
    max-width: 256px;
    height: 100%;
    object-fit: contain;
    border-radius: inherit;
    transform: scale(1.2);
    transform-origin: center;
  }

  .mood-comment-content .image-preview-wrap img {
    display: block;
    width: 100%;
    height: 100%;
    max-height: none;
    object-fit: cover;
  }

  .mood-comment-content .image-list-even .image-preview-wrap img {
    aspect-ratio: 1;
    max-height: none;
  }

  .mood-comment-content .image-list-container:has(.image-preview-wrap ~ .image-preview-wrap) .image-preview-wrap img {
    aspect-ratio: 1;
    max-height: none;
  }

  .mood-comment-content .modal {
    display: none;
  }

  .mood-comment-content blockquote {
    --comment-quote-bg: linear-gradient(
      180deg,
      hsl(var(--foreground) / 0.03) 0%,
      hsl(var(--foreground) / 0.06) 100%
    );
    margin: 0.6em 0 0.7em;
    padding: 4px 10px 4px;
    border-left: 2px solid hsl(var(--foreground) / 0.18);
    background: var(--comment-quote-bg);
    border-radius: 0 6px 6px 0;
    font-size: 11.5px;
    line-height: 1.5;
    color: hsl(var(--muted-foreground));
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .mood-comment-content blockquote {
      padding: 5px 12px 5px;
      font-size: 12.5px;
      line-height: 1.55;
    }
  }

  .mood-comment-content blockquote::before {
    content: '';
    position: absolute;
    left: -2px;
    top: 0;
    width: 2px;
    height: 100%;
    background: linear-gradient(
      to bottom,
      hsl(var(--foreground) / 0.3),
      hsl(var(--foreground) / 0.08)
    );
    border-radius: 2px 0 0 2px;
  }

  .mood-comment-content blockquote::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 42%;
    background: linear-gradient(
      180deg,
      hsl(var(--foreground) / 0) 0%,
      hsl(var(--foreground) / 0.18) 100%
    );
    opacity: 0.35;
    pointer-events: none;
  }

  .mood-comment-content blockquote small {
    display: block;
    line-height: 1.5;
    position: relative;
    z-index: 1;
    white-space: pre-line;
  }

  .mood-comment-content blockquote p {
    margin: 0;
    position: relative;
    z-index: 1;
    white-space: pre-line;
  }

  .mood-comment-footer {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin-top: var(--comment-gap-inner);
  }

  .mood-comment-reactions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .mood-comment-skeleton-line {
    display: block;
    width: var(--line-width, 120px);
    height: var(--line-height, 12px);
    background: hsl(var(--foreground) / 0.1);
    border-radius: 6px;
    position: relative;
    overflow: hidden;
  }

  .mood-comment-skeleton-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      hsl(var(--foreground) / 0.18) 50%,
      transparent 100%
    );
    animation: comment-skeleton-shimmer 2s ease-in-out infinite;
    animation-delay: var(--skeleton-delay, 0s);
  }

  .mood-comment-skeleton-line--author {
    --line-height: 13px;
  }

  .mood-comment-skeleton-line--date {
    --line-height: 10px;
    background: hsl(var(--foreground) / 0.08);
  }

  .mood-comment-skeleton-line--quote {
    --line-height: 11px;
  }

  .mood-comment-content--skeleton {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .mood-comment-content .mood-comment-skeleton-quote small {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  @keyframes comment-skeleton-shimmer {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mood-comment-avatar--skeleton::after,
    .mood-comment-skeleton-line::after {
      animation: none;
    }
  }

  /* A heading announcing the section and a line under it saying the section
     is empty say the same thing twice. With no comments the box and the route
     out are the whole message, so both go. The element stays in the DOM
     because its hidden state is what tells the section which layout to use. */
  .mood-comments-empty {
    display: none;
  }

  .mood-comments:has([data-comments-empty]:not([hidden])) .mood-comments-header {
    display: none;
  }

  .mood-comments-empty p {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--comment-meta);
  }

  .mood-comments-load-more {
    display: block;
    width: 100%;
    margin-top: 28px;
    padding: 16px 28px;
    font-size: 14px;
    font-weight: 500;
    color: hsl(var(--foreground) / 0.75);
    background: linear-gradient(
      180deg,
      hsl(var(--foreground) / 0.04) 0%,
      hsl(var(--foreground) / 0.06) 100%
    );
    border: 1px solid hsl(var(--foreground) / 0.12);
    border-radius: 12px;
    cursor: pointer;
    /* opacity is for :disabled, transform for :hover/:active. */
    transition:
      color 0.25s cubic-bezier(0.4, 0, 0.2, 1),
      border-color 0.25s cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 0.25s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    font-family: inherit;
    position: relative;
    overflow: hidden;
    box-shadow:
      0 2px 8px hsl(var(--foreground) / 0.04),
      0 0 0 1px hsl(var(--foreground) / 0.02);
  }

  .mood-comments-load-more[hidden] {
    display: none;
  }

  .mood-comments-load-more::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      hsl(var(--foreground) / 0.08) 0%,
      transparent 100%
    );
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .mood-comments-load-more:hover {
    color: hsl(var(--foreground));
    border-color: hsl(var(--foreground) / 0.18);
    box-shadow:
      0 4px 16px hsl(var(--foreground) / 0.08),
      0 0 0 1px hsl(var(--foreground) / 0.04);
    transform: translateY(-1px);
  }

  .mood-comments-load-more:hover::before {
    opacity: 1;
  }

  .mood-comments-load-more:active {
    transform: translateY(0);
  }

  .mood-comments-load-more:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  .mood-comments-load-more:disabled:hover {
    border-color: hsl(var(--foreground) / 0.12);
    box-shadow:
      0 2px 8px hsl(var(--foreground) / 0.04),
      0 0 0 1px hsl(var(--foreground) / 0.02);
  }

  /* Telegram's own blue. With the comments outlined in neutral hairlines the
     CTA had nothing left to distinguish it, and a row that looks exactly like
     a comment gives no reason to click it. One colour, spent here. */
  .mood-comments {
    --comment-cta: 200 72% 49%;
  }

  a.mood-comment-cta-wrap {
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    animation: none;
    margin-top: var(--comment-stack-gap, 16px);
  }

  /* A button, so it is sized like one: one line, no room for a message. */
