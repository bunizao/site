---
import Hero from '@/features/mood/ui/Hero.astro';
import type { MoodFeedItem, MoodChannelSummary } from '@/features/mood/server/contracts';
import { renderMoodGalleryMarkup } from '@/features/mood/shared/gallery-render';
import { findTooBigVideoMedia, hasStructuredMoodFeedMedia, renderStructuredMoodFeedMediaMarkup } from '@/features/mood/shared/feed-media';
import { getMoodFeedThumbnailStyle } from '@/features/mood/shared/feed-thumbnail';
import {
  getMoodDetailHref,
  getMoodFeedAnchorFragmentId,
  moodFeedPostHasId,
} from '@/features/mood/shared/feed-anchor';
import { getCriticalInitialPosts, hasRenderableMoodFeedMedia } from '@/features/mood/shared/initial-feed';
import { getMoodReactionKey } from '@/features/mood/client/meta-patcher';

interface SkeletonItem {
  index: number;
  lineWidth: string;
}

interface SkeletonGroup {
  index: number;
  dateWidth: string;
  items: SkeletonItem[];
}

interface Props {
  skeletonGroups: SkeletonGroup[];
  initialPosts?: MoodFeedItem[];
  initialChannel?: MoodChannelSummary;
  anchorId?: string;
  readSource?: 'live' | 'archive';
}

const {
  skeletonGroups,
  initialPosts = [],
  initialChannel,
  anchorId = '',
  readSource = 'live',
} = Astro.props;

const criticalInitialPosts = getCriticalInitialPosts(initialPosts, anchorId);
const criticalDateGroups = groupPostsByDate(criticalInitialPosts);
const criticalPriorityPostId = criticalInitialPosts.find(hasRenderableMoodFeedMedia)?.id ?? '';
const hasCriticalInitialPosts = criticalInitialPosts.length > 0;

// The critical posts above are already SSR-rendered into the feed markup, and
// the client renderer dedupes them by `data-mood-id`. Their full payload in the
// inline JSON would be dead weight — the client only needs their id + datetime
// to keep the newest/oldest pagination cursors correct. Ship a stub for those
// and the full object only for the non-SSR remainder.
const criticalInitialPostIds = new Set(criticalInitialPosts.map((post) => post.id));
const inlineInitialPosts = initialPosts.map((post) =>
  criticalInitialPostIds.has(post.id)
    ? { id: post.id, groupIds: post.groupIds, datetime: post.datetime }
    : post
);

const initialFeedPayload = {
  posts: inlineInitialPosts,
  channel: initialChannel,
  anchorId: anchorId || undefined,
};
const hasInitialFeedPayload = initialPosts.length > 0 || Boolean(initialChannel);

function formatTime(value: string): string {
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return '';
  return `${String(date.getHours()).padStart(2, '0')}:${String(date.getMinutes()).padStart(2, '0')}`;
}

function formatDateKey(value: string): string {
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return '';
  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
}

function formatDateHeader(dateKey: string): string {
  const [year, month, day] = dateKey.split('-').map(Number);
  const date = new Date(year, month - 1, day);
  const now = new Date();
  const yesterday = new Date(now);
  yesterday.setDate(yesterday.getDate() - 1);

  const isSameDay = (candidate: Date, target: Date) => (
    candidate.getFullYear() === target.getFullYear()
    && candidate.getMonth() === target.getMonth()
    && candidate.getDate() === target.getDate()
  );

  if (isSameDay(date, now)) return 'Today';
  if (isSameDay(date, yesterday)) return 'Yesterday';

  const months = [
    'January',
    'February',
    'March',
    'April',
    'May',
    'June',
    'July',
    'August',
    'September',
    'October',
    'November',
    'December',
  ];

  if (date.getFullYear() === now.getFullYear()) {
    return `${months[date.getMonth()]} ${date.getDate()}`;
  }

  return `${months[date.getMonth()]} ${date.getDate()}, ${date.getFullYear()}`;
}

function groupPostsByDate(posts: MoodFeedItem[]): Array<{ dateKey: string; posts: MoodFeedItem[] }> {
  const groups = new Map<string, MoodFeedItem[]>();
  posts.forEach((post) => {
    const dateKey = formatDateKey(post.datetime);
    if (!dateKey) return;
    if (!groups.has(dateKey)) {
      groups.set(dateKey, []);
    }
    groups.get(dateKey)?.push(post);
  });

  return Array.from(groups, ([dateKey, groupPosts]) => ({ dateKey, posts: groupPosts }));
}

function getPostNavigationId(post: MoodFeedItem): string {
  return anchorId && moodFeedPostHasId(post, anchorId) ? anchorId : post.id;
}

function getPostHref(post: MoodFeedItem, navigationId: string): string | undefined {
  const tooBigVideoMedia = findTooBigVideoMedia(post.media);
  const structuredMedia = tooBigVideoMedia ? post.media.filter((item) => item !== tooBigVideoMedia) : post.media;
  return post.needsDetailPage && !post.mediaHtml.trim() && !hasStructuredMoodFeedMedia(structuredMedia)
    ? getMoodDetailHref(navigationId)
    : undefined;
}

function getThumbClass(
  post: MoodFeedItem,
  isTooBigVideoPreview = post.previewMediaType === 'too-big-video',
  isPriorityMedia = false,
): string {
  const classes = ['mood-item-thumb'];
  if (isPriorityMedia) {
    classes.push('mood-item-thumb--priority');
  }
  if (isTooBigVideoPreview) {
    classes.push('mood-item-thumb--video');
  }
  if (post.imageKind === 'sticker') {
    classes.push('mood-item-thumb--sticker');
  }
  if (!isTooBigVideoPreview) {
    if (post.imageLayout === 'portrait') {
      classes.push('mood-item-thumb--portrait');
    } else if (post.imageLayout === 'ultra-tall') {
      classes.push('mood-item-thumb--ultra-tall');
    }
  }
  return classes.join(' ');
}

function getCommentsCountInfo(value: MoodFeedItem['commentsCount']): { count: number; label: string } {
  if (typeof value === 'number' && Number.isFinite(value)) {
    return { count: value, label: String(value) };
  }

  if (typeof value !== 'string') {
    return { count: 0, label: '' };
  }

  const trimmed = value.trim();
  if (!trimmed) {
    return { count: 0, label: '' };
  }

  const direct = Number(trimmed.replace(/,/g, ''));
  if (Number.isFinite(direct)) {
    return { count: direct, label: trimmed };
  }

  const match = trimmed.match(/(\d+(?:[.,]\d+)?)(\s*[kKmM])?/);
  if (!match) {
    return { count: 0, label: '' };
  }

  let count = Number(match[1].replace(',', '.'));
  const suffix = match[2]?.trim() ?? '';
  if (/k/i.test(suffix)) {
    count *= 1000;
  } else if (/m/i.test(suffix)) {
    count *= 1_000_000;
  }

  return Number.isFinite(count) ? { count, label: trimmed } : { count: 0, label: '' };
}

function getCommentsPopoverId(postId: string): string {
  return `mood-comments-popover-${postId.replace(/[^\w-]/g, '-')}`;
}

function normalizeAuthorName(value: string): string {
  return value.replace(/\s+/g, ' ').trim().replace(/^@/, '').toLowerCase().replace(/[^\w-]+$/g, '');
}

function shouldHideQuoteAuthor(value?: string): boolean {
  if (!value) return false;
  const normalized = normalizeAuthorName(value);
  const slug = initialChannel?.slug ? normalizeAuthorName(initialChannel.slug) : '';
  const title = initialChannel?.title ? normalizeAuthorName(initialChannel.title) : '';
  return Boolean((slug && normalized === slug) || (title && normalized === title));
}
---

{anchorId && (
  <script is:inline>
    (() => {
      if (window.__moodAnchorIntentCapture) return;

      let touchStartY = null;
      const capture = {
        direction: null,
      };
      const setDirection = (direction) => {
        capture.direction = direction;
      };
      const onWheel = (event) => {
        if (event.deltaY > 0) setDirection('older');
        if (event.deltaY < 0) setDirection('newer');
      };
      const onKeydown = (event) => {
        if (
          event.key === 'ArrowDown'
          || event.key === 'End'
          || event.key === 'PageDown'
          || (event.key === ' ' && !event.shiftKey)
        ) {
          setDirection('older');
        }
        if (
          event.key === 'ArrowUp'
          || event.key === 'Home'
          || event.key === 'PageUp'
          || (event.key === ' ' && event.shiftKey)
        ) {
          setDirection('newer');
        }
      };
      const onTouchStart = (event) => {
        touchStartY = event.touches.item(0)?.clientY ?? null;
      };
      const onTouchMove = (event) => {
        const currentY = event.touches.item(0)?.clientY;
        if (touchStartY === null || currentY === undefined) return;
        if (touchStartY - currentY >= 12) setDirection('older');
        if (currentY - touchStartY >= 12) setDirection('newer');
      };

      window.addEventListener('wheel', onWheel, { passive: true });
      window.addEventListener('keydown', onKeydown);
      window.addEventListener('touchstart', onTouchStart, { passive: true });
      window.addEventListener('touchmove', onTouchMove, { passive: true });
      window.addEventListener('pagehide', () => {
        capture.direction = null;
        touchStartY = null;
      });
      window.__moodAnchorIntentCapture = capture;
    })();
  </script>
)}

<div class="mood-page">
  <Hero initialChannel={initialChannel} />

  <div class={`mood-loading${hasCriticalInitialPosts ? ' is-hidden' : ''}`} data-mood-loading>
    <div class="mood-skeleton-stream" aria-hidden="true">
      {skeletonGroups.map((group) => (
        <div
          class="mood-skeleton-group"
          style={`--group-index: ${group.index}; --date-width: ${group.dateWidth};`}
        >
          <div class="mood-skeleton-header">
            <span class="mood-skeleton-date"></span>
            <div class="mood-skeleton-header-line"></div>
          </div>
          <div class="mood-skeleton-items">
            {group.items.map((item) => (
              <div
                class="mood-skeleton-item"
                style={`--item-index: ${item.index}; --line-width: ${item.lineWidth};`}
              >
                <span class="mood-skeleton-time"></span>
                <div class="mood-skeleton-content">
                  <span class="mood-skeleton-line"></span>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="mood-error is-hidden" data-mood-error>
    <p class="text-sm text-muted-foreground">Unable to load moods. Please try again later.</p>
    <button class="mood-load-retry" type="button" data-mood-initial-retry>Retry</button>
  </div>

  <div
    class={`mood-feed${hasCriticalInitialPosts ? '' : ' is-hidden'}`}
    data-mood-feed
    data-mood-anchor-id={anchorId || undefined}
    data-mood-read-source={readSource}
  >
    {hasInitialFeedPayload && (
      <script is:inline type="application/json" data-mood-initial-feed set:html={JSON.stringify(initialFeedPayload)}></script>
    )}
    {anchorId && <div class="mood-sentinel mood-sentinel--newer" data-mood-newer-sentinel aria-hidden="true"></div>}
    <div class="mood-stream" data-mood-list role="region" aria-label="Mood feed">
      {criticalDateGroups.map((group) => (
        <div class="mood-date-group" data-date={group.dateKey}>
          <div class="mood-date-header">
            <span class="mood-date-text">{formatDateHeader(group.dateKey)}</span>
            <div class="mood-date-line"></div>
          </div>
          <div class="mood-date-items">
            {group.posts.map((post, index) => {
              const navigationId = getPostNavigationId(post);
              const detailHref = getMoodDetailHref(navigationId);
              const href = getPostHref(post, navigationId);
              const tooBigVideoMedia = findTooBigVideoMedia(post.media);
              const mediaHtml = post.mediaHtml.trim();
              const feedMedia = tooBigVideoMedia ? post.media.filter((item) => item !== tooBigVideoMedia) : post.media;
              const structuredMediaHtml = renderStructuredMoodFeedMediaMarkup(feedMedia, { lazyVideo: true });
              const hasStructuredMedia = structuredMediaHtml.length > 0;
              const isLongPreview = post.previewText.length > 280;
              const isPriorityMedia = post.id === criticalPriorityPostId;
              const commentsInfo = getCommentsCountInfo(post.commentsCount);
              const isTooBigVideoPreview = post.previewMediaType === 'too-big-video' || Boolean(tooBigVideoMedia);
              const thumbImage = isTooBigVideoPreview ? (post.image || tooBigVideoMedia?.thumbnailSrc || null) : post.image;
              const thumbWidth = isTooBigVideoPreview ? (post.imageWidth ?? tooBigVideoMedia?.width ?? null) : post.imageWidth;
              const thumbHeight = isTooBigVideoPreview ? (post.imageHeight ?? tooBigVideoMedia?.height ?? null) : post.imageHeight;
              const hasGalleryPreview = !hasStructuredMedia && !mediaHtml && !isTooBigVideoPreview && (post.gallery?.items.length ?? 0) > 1;
              const fragmentId = getMoodFeedAnchorFragmentId(post.id);

              return (
                <div
                  class={`mood-item${href ? ' mood-item--clickable' : ''}`}
                  id={fragmentId || undefined}
                  data-mood-id={post.id}
                  data-mood-group-ids={post.groupIds?.join(',') || undefined}
                  data-href={href}
                  role={href ? 'link' : undefined}
                  tabindex={href ? 0 : undefined}
                  style={`--item-index: ${index};`}
                >
                  <a
                    class="mood-item-expand-float"
                    href={detailHref}
                    title="View full post"
                    aria-label="View full post"
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M15 3h6v6"></path>
                      <path d="M10 14 21 3"></path>
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    </svg>
                  </a>
                  <time class="mood-item-time" datetime={post.datetime}>{formatTime(post.datetime)}</time>
                  <div class={`mood-item-content${isTooBigVideoPreview && !post.previewText.trim() && !hasStructuredMedia && !mediaHtml && !post.forwardedFrom && !post.quote ? ' mood-item-content--media-only' : ''}`}>
                    {post.forwardedFrom?.name ? (
                      <div class="mood-item-forwarded">
                        <span class="mood-forwarded-label">Forwarded from</span>
                        {post.forwardedFrom.href ? (
                          <a class="mood-forwarded-source" href={post.forwardedFrom.href} target="_blank" rel="noopener noreferrer">
                            {post.forwardedFrom.name}
                          </a>
                        ) : (
                          <span class="mood-forwarded-source">{post.forwardedFrom.name}</span>
                        )}
                        {post.forwardedFrom.author && post.forwardedFrom.author !== post.forwardedFrom.name ? (
                          <span class="mood-forwarded-author">({post.forwardedFrom.author})</span>
                        ) : null}
                      </div>
                    ) : null}

                    {post.quote?.text ? (
                      <Fragment>
                        {post.quote.href ? (
                          <a
                            class={`mood-item-quote${post.quote.thumbnailSrc && /^(Media|Video)$/i.test(post.quote.text) ? ' mood-item-quote--media-only' : post.quote.thumbnailSrc ? ' mood-item-quote--with-media' : ''}`}
                            href={post.quote.href}
                            data-quote-id={post.quote.href.match(/\/mood\/(\d+)/)?.[1]}
                            target={/^https?:\/\//i.test(post.quote.href) ? '_blank' : undefined}
                            rel={/^https?:\/\//i.test(post.quote.href) ? 'noopener noreferrer' : undefined}
                          >
                            {post.quote.thumbnailSrc ? (
                              <span class="mood-item-quote-media">
                                <img class="mood-item-quote-image" src={post.quote.thumbnailSrc} alt="" loading="lazy" decoding="async" />
                              </span>
                            ) : null}
                            <span class="mood-item-quote-body">
                              {post.quote.author && !shouldHideQuoteAuthor(post.quote.author) ? (
                                <div class="mood-item-quote-meta">
                                  <span class="mood-item-quote-author">{post.quote.author}</span>
                                </div>
                              ) : null}
                              {/^(Media|Video)$/i.test(post.quote.text) && post.quote.thumbnailSrc ? null : (
                                <p class="mood-item-quote-text">{post.quote.text}</p>
                              )}
                            </span>
                          </a>
                        ) : (
                          <div class={`mood-item-quote${post.quote.thumbnailSrc ? ' mood-item-quote--with-media' : ''}`}>
                            {post.quote.thumbnailSrc ? (
                              <span class="mood-item-quote-media">
                                <img class="mood-item-quote-image" src={post.quote.thumbnailSrc} alt="" loading="lazy" decoding="async" />
                              </span>
                            ) : null}
                            <span class="mood-item-quote-body">
                              {post.quote.author && !shouldHideQuoteAuthor(post.quote.author) ? (
                                <div class="mood-item-quote-meta">
                                  <span class="mood-item-quote-author">{post.quote.author}</span>
                                </div>
                              ) : null}
                              <p class="mood-item-quote-text">{post.quote.text}</p>
                            </span>
                          </div>
                        )}
                      </Fragment>
                    ) : null}

                    {post.previewHtml.trim() ? (
                      <p
                        class={`mood-item-text${isLongPreview ? ' mood-item-text--clamped' : ''}`}
                        set:html={post.previewHtml}
                      />
                    ) : post.previewText.trim() ? (
                      <p class={`mood-item-text${isLongPreview ? ' mood-item-text--clamped' : ''}`}>
                        {post.previewText}
                      </p>
                    ) : null}

                    {hasStructuredMedia || mediaHtml ? (
                      <div class="mood-item-media" set:html={hasStructuredMedia ? structuredMediaHtml : mediaHtml} />
                    ) : hasGalleryPreview && post.gallery ? (
                      <Fragment set:html={renderMoodGalleryMarkup(post.gallery, { variant: 'feed', priority: isPriorityMedia })} />
                    ) : thumbImage || isTooBigVideoPreview ? (
                      <div
                        class={getThumbClass(post, isTooBigVideoPreview, isPriorityMedia)}
                        style={getMoodFeedThumbnailStyle({
                          imageWidth: thumbWidth,
                          imageHeight: thumbHeight,
                          imageLayout: isTooBigVideoPreview ? null : post.imageLayout,
                          priority: isPriorityMedia,
                        })}
                      >
                        {thumbImage ? (
                          <img
                            alt=""
                            width={thumbWidth ?? undefined}
                            height={thumbHeight ?? undefined}
                            data-fallback-src={post.imageFallback ?? undefined}
                            decoding={isPriorityMedia ? 'sync' : 'async'}
                            loading={isPriorityMedia ? 'eager' : 'lazy'}
                            fetchpriority={isPriorityMedia ? 'high' : undefined}
                            src={thumbImage}
                          />
                        ) : null}
                        {isTooBigVideoPreview ? (
                          <div class="mood-item-thumb-video-overlay" aria-hidden="true">
                            <span class="mood-item-thumb-video-label">Media is too big</span>
                            <span class="mood-item-thumb-video-cta">View details</span>
                            <time class="mood-item-thumb-video-time" datetime={post.datetime}>{formatTime(post.datetime)}</time>
                          </div>
                        ) : null}
                      </div>
                    ) : null}

                    {isLongPreview ? <a class="mood-item-details link" href={detailHref}>View details</a> : null}

                    <div class="mood-item-reactions">
                      {post.reactions.map((reaction) => (
                        <span
                          class={reaction.isPaid ? 'mood-reaction mood-reaction--paid' : 'mood-reaction'}
                          data-mood-reaction-key={getMoodReactionKey(reaction)}
                        >
                          <span class="mood-reaction-emoji">
                            {reaction.isPaid ? '⭐' : reaction.emojiImage || reaction.emojiId ? (
                              <span class="tg-emoji" data-emoji-id={reaction.emojiId || undefined}>
                                {reaction.emojiImage ? (
                                  <img src={reaction.emojiImage} alt={reaction.emoji || 'emoji'} loading="lazy" decoding="async" width="16" height="16" />
                                ) : reaction.emoji}
                              </span>
                            ) : reaction.emoji}
                          </span>
                          <span class="mood-reaction-count">{reaction.count}</span>
                        </span>
                      ))}
                      <div
                        class={`mood-comments-wrapper${commentsInfo.count > 0 ? '' : ' is-hidden'}`}
                        data-post-id={post.id}
                        data-comments-count={commentsInfo.count}
                        data-comments-label={commentsInfo.label || String(commentsInfo.count)}
                      >
                          <a
                            class="mood-item-comments"
                            href={getMoodDetailHref(navigationId, '#comments')}
                            title={`${commentsInfo.label} comment${commentsInfo.count === 1 ? '' : 's'}`}
                            aria-haspopup="dialog"
                            aria-expanded="false"
                            aria-controls={getCommentsPopoverId(post.id)}
                          >
                            <span class="mood-comments-icon">
                              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                              </svg>
                            </span>
                            <span class="mood-comments-count">{commentsInfo.label}</span>
                          </a>
                          <div
                            class="mood-comments-popover"
                            id={getCommentsPopoverId(post.id)}
                            role="dialog"
                            aria-label={`${commentsInfo.label} comment${commentsInfo.count === 1 ? '' : 's'} preview`}
                          >
                            <div class="mood-comments-popover-loading">
                              <div class="mood-popover-skeleton">
                                <div class="mood-popover-skeleton-avatar"></div>
                                <div class="mood-popover-skeleton-body">
                                  <div class="mood-popover-skeleton-line mood-popover-skeleton-line--short"></div>
                                  <div class="mood-popover-skeleton-line mood-popover-skeleton-line--long"></div>
                                </div>
                              </div>
                              <div class="mood-popover-skeleton">
                                <div class="mood-popover-skeleton-avatar"></div>
                                <div class="mood-popover-skeleton-body">
                                  <div class="mood-popover-skeleton-line mood-popover-skeleton-line--short"></div>
                                  <div class="mood-popover-skeleton-line mood-popover-skeleton-line--long"></div>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                    </div>

                    {post.tag ? <span class="mood-item-tag">#{post.tag}</span> : null}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      ))}
    </div>
    <div class="mood-load-controls">
      <p class="mood-load-status" data-load-status aria-live="polite"></p>
      <button class="mood-load-retry" type="button" data-mood-load-retry hidden>Retry</button>
    </div>
    <div class="mood-sentinel" data-mood-sentinel aria-hidden="true"></div>
  </div>

  <div
    class="mood-update-notice"
    data-mood-update-notice
    role="status"
    aria-live="polite"
    aria-atomic="true"
    style="display: none;"
  >
    <p class="mood-update-text" data-mood-update-text>New moods are in!</p>
    <div class="mood-update-actions" data-mood-update-actions>
      <button class="mood-update-action" type="button" data-mood-update-refresh aria-label="Refresh">
        <svg
          class="mood-update-action-icon"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <polyline points="23 4 23 10 17 10"></polyline>
          <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
        </svg>
        <span class="mood-update-action-label">Refresh</span>
      </button>
    </div>
    <div class="mood-update-progress" aria-hidden="true"></div>
  </div>
</div>

<style>
  .mood-page {
    padding: 80px 0 60px;
    font-family: var(--font-sans);
  }

  @media (min-width: 640px) {
    .mood-page {
      padding: 100px 0 80px;
    }
  }

  @media (min-width: 1024px) {
    .mood-page {
      padding: 120px 0 100px;
    }
  }

  @media (max-width: 480px) {
    .mood-page {
      padding: 64px 0 48px;
    }
  }

  .mood-error {
    padding: 60px 0;
    text-align: center;
  }

