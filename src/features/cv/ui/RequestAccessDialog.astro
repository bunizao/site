---
import type { CvLang } from '@bunizao/contracts';
import { CV_REQUEST_PATH } from '@bunizao/contracts/routes';
import { CV_STRINGS } from '../copy';

interface Props {
  lang: CvLang;
}

const { lang } = Astro.props;
const t = CV_STRINGS[lang].request;
---

<dialog class="cv-dialog" data-cv-dialog aria-labelledby="cv-request-title">
  <div class="cv-dialog__panel">
    <button type="button" class="cv-dialog__close" data-cv-dialog-close aria-label={t.close}>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12"></path>
      </svg>
    </button>

    <form class="cv-dialog__form" data-cv-request-form data-endpoint={CV_REQUEST_PATH} data-lang={lang} data-submitting={t.submitting}>
      <h2 class="cv-dialog__title" id="cv-request-title">{t.title}</h2>
      <p class="cv-dialog__lead">{t.lead}</p>

      <label class="cv-field">
        <span class="cv-field__label">{t.emailLabel}</span>
        <input
          class="cv-field__input"
          type="email"
          name="email"
          required
          autocomplete="email"
          placeholder={t.emailPlaceholder}
        />
      </label>

      <label class="cv-field">
        <span class="cv-field__label">{t.intentLabel}</span>
        <textarea
          class="cv-field__input cv-field__textarea"
          name="intent"
          rows="3"
          maxlength="500"
          placeholder={t.intentPlaceholder}
        ></textarea>
      </label>

      <p class="cv-dialog__error" data-cv-request-error hidden>{t.error}</p>

      <div class="cv-dialog__actions">
        <span class="cv-dialog__privacy">{t.privacy}</span>
        <button type="submit" class="cv-dialog__submit" data-cv-request-submit>
          <span data-cv-submit-label>{t.submit}</span>
        </button>
      </div>
    </form>

    <div class="cv-dialog__success" data-cv-request-success hidden>
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 6 9 17l-5-5"></path>
      </svg>
      <h2 class="cv-dialog__title">{t.successTitle}</h2>
      <p class="cv-dialog__lead">{t.successBody}</p>
      <button type="button" class="cv-dialog__submit" data-cv-dialog-close>{t.close}</button>
    </div>
  </div>
</dialog>

<script>
  import { initCvRequestDialog } from '../client/request-access';
  initCvRequestDialog();
</script>

<style is:global>
  .cv-dialog {
    border: none;
    padding: 0;
    background: transparent;
    color: hsl(var(--foreground));
    max-width: min(30rem, calc(100vw - 2rem));
    width: 100%;
  }

  .cv-dialog::backdrop {
    background: hsl(var(--background) / 0.55);
    backdrop-filter: blur(3px);
  }

  .cv-dialog__panel {
    position: relative;
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border) / 0.14);
    border-radius: var(--radius-xl);
    padding: clamp(1.5rem, 4vw, 2.25rem);
    box-shadow:
      0 1px 1px hsl(0 0% 0% / 0.04),
      0 8px 24px hsl(0 0% 0% / 0.12),
      0 24px 48px hsl(0 0% 0% / 0.14);
  }

  /* Enter animation on open. */
  @media (prefers-reduced-motion: no-preference) {
    .cv-dialog[open] .cv-dialog__panel {
      animation: cv-dialog-in 0.28s cubic-bezier(0.2, 0, 0, 1);
    }
  }

  @keyframes cv-dialog-in {
    from { opacity: 0; transform: translateY(8px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .cv-dialog__close {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: none;
    background: none;
    color: hsl(var(--muted));
    cursor: pointer;
    border-radius: var(--radius-sm);
    transition: color 0.18s ease, background 0.18s ease;
  }

  .cv-dialog__close:hover {
    color: hsl(var(--foreground));
    background: hsl(var(--secondary));
  }

  .cv-dialog__form,
  .cv-dialog__success {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  /* An explicit `display` beats the UA `[hidden]` rule — restore it so the
     success panel and error line actually hide until toggled. */
  .cv-dialog [hidden] {
    display: none !important;
  }

  .cv-dialog__success {
    align-items: flex-start;
    text-align: left;
  }

  .cv-dialog__title {
    font-family: var(--font-sans);
    font-size: 1.28rem;
    font-weight: 600;
    letter-spacing: -0.018em;
    margin: 0;
  }

  .cv-dialog__lead {
    font-size: 0.94rem;
    line-height: 1.55;
    color: hsl(var(--muted));
    text-wrap: pretty;
    margin: 0;
  }

  .cv-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .cv-field__label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: hsl(var(--muted));
  }

  .cv-field__input {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: hsl(var(--foreground));
    background: hsl(var(--background));
    border: 1px solid hsl(var(--border) / 0.2);
    border-radius: var(--radius-md);
    padding: 0.6rem 0.75rem;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .cv-field__input::placeholder {
    color: hsl(var(--muted) / 0.7);
  }

  .cv-field__input:focus {
    outline: none;
    border-color: hsl(var(--foreground) / 0.5);
    box-shadow: 0 0 0 3px hsl(var(--ring) / 0.12);
  }

  .cv-field__textarea {
    resize: vertical;
    min-height: 3.5rem;
    line-height: 1.5;
  }

  .cv-dialog__error {
    font-size: 0.86rem;
    color: hsl(var(--destructive));
    margin: 0;
  }

  .cv-dialog__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.25rem;
  }

  .cv-dialog__privacy {
    font-size: 0.76rem;
    color: hsl(var(--muted));
    line-height: 1.35;
  }

  .cv-dialog__submit {
    flex-shrink: 0;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 550;
    color: #fff;
    background: var(--cv-accent, hsl(var(--primary)));
    border: none;
    border-radius: 999px;
    padding: 0.55rem 1.15rem;
    cursor: pointer;
    transition: transform 0.12s cubic-bezier(0.2, 0, 0, 1), opacity 0.18s ease;
  }

  .cv-dialog__submit:hover {
    opacity: 0.9;
  }

  .cv-dialog__submit:active {
    transform: scale(0.96);
  }

  .cv-dialog__submit[disabled] {
    opacity: 0.55;
    cursor: default;
  }
</style>
