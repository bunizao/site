---
import { MapPin } from 'lucide-react';
import type { CvLang } from '@bunizao/contracts';
import type { ResolvedCv } from '../server/resolve';
import { CV_STRINGS, pick } from '../copy';

interface Props {
  cv: ResolvedCv;
  lang: CvLang;
  avatar?: string;
  variant?: 'screen' | 'print';
  full?: boolean;
  pdfHref?: string;
  otherLangHref?: string;
  otherLangLabel?: string;
}

const {
  cv,
  lang,
  avatar,
  variant = 'screen',
  full = false,
  pdfHref = '',
  otherLangHref = '',
  otherLangLabel = '',
} = Astro.props;

const t = CV_STRINGS[lang];
const ident = cv.identity;
const isScreen = variant === 'screen';
// Links open in a new tab on screen; in a PDF they are plain clickable hrefs.
const linkTarget = isScreen ? '_blank' : undefined;
---

<header class="cv-header">
  <div class="cv-header__main">
    <h1 class="cv-name cv-reveal cv-reveal--1">{pick(ident.displayName, lang)}</h1>
    <p class="cv-headline cv-reveal cv-reveal--2">{pick(ident.headline, lang)}</p>
    <span class="cv-location cv-reveal cv-reveal--2">
      <MapPin aria-hidden="true" />
      {pick(ident.location, lang)}
    </span>
  </div>

  {avatar && <img class="cv-avatar cv-reveal cv-reveal--1" src={avatar} width="112" height="112" alt="" loading="eager" />}
</header>

{/* One quiet contact line — plain text links, no boxes, no CTA. Real anchors so
    the values stay clickable when the page is printed to PDF. */}
<div class:list={['cv-contact', isScreen && 'cv-reveal cv-reveal--3']}>
  {ident.email !== null ? (
    <a class="cv-contact__item" href={`mailto:${pick(ident.email, lang)}`}>{pick(ident.email, lang)}</a>
  ) : isScreen ? (
    <button type="button" class="cv-contact__item cv-contact__item--request" data-cv-request-open>
      {t.contact.email} · {t.redacted.hint}
    </button>
  ) : null}

  {ident.phone !== null ? (
    <a class="cv-contact__item" href={`tel:${pick(ident.phone, lang).replace(/\s+/g, '')}`}>{pick(ident.phone, lang)}</a>
  ) : isScreen ? (
    <button type="button" class="cv-contact__item cv-contact__item--request" data-cv-request-open>
      {t.contact.phone} · {t.redacted.hint}
    </button>
  ) : null}

  {ident.links.map((link) => (
    <a class="cv-contact__item" href={link.url} target={linkTarget} rel="noopener">{pick(link.label, lang)}</a>
  ))}

  {isScreen && (
    <span class="cv-contact__tools">
      <a class="cv-contact__item" href={otherLangHref} hreflang={lang === 'en' ? 'zh' : 'en'}>{otherLangLabel}</a>
      {full ? (
        <a class="cv-contact__item" href={pdfHref} target="_blank" rel="noopener">{t.pdf}</a>
      ) : (
        <button type="button" class="cv-contact__item" data-cv-request-open>{t.pdf}</button>
      )}
    </span>
  )}
</div>
