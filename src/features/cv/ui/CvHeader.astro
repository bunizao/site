---
import { Mail, Phone, MapPin, Globe, BookOpen, Send, FileDown, Languages } from 'lucide-react';
import { GitHubIcon } from '@/components/icons';
import type { CvLang } from '@bunizao/contracts';
import type { ResolvedCv } from '../server/resolve';
import { CV_STRINGS, pick } from '../copy';
import CvValue from './CvValue.astro';

interface Props {
  cv: ResolvedCv;
  lang: CvLang;
  avatar?: string;
  variant?: 'screen' | 'print';
  full?: boolean;
  pdfHref?: string;
  otherLangHref?: string;
  otherLangLabel?: string;
}

const {
  cv,
  lang,
  avatar,
  variant = 'screen',
  full = false,
  pdfHref = '',
  otherLangHref = '',
  otherLangLabel = '',
} = Astro.props;

const t = CV_STRINGS[lang];
const ident = cv.identity;

// Reuse the site's canonical icon set so the résumé's contacts read the same as
// the homepage "Find me at" row. Brand marks come from @/components/icons; the
// rest are lucide, matching the boxed header-action language.
const LINK_ICONS = { github: GitHubIcon, book: BookOpen, send: Send, globe: Globe } as const;
function iconFor(label: string) {
  const l = label.toLowerCase();
  if (l.includes('github')) return LINK_ICONS.github;
  if (l.includes('無人') || l.includes('blog') || l.includes('sillage')) return LINK_ICONS.book;
  if (l.includes('telegram')) return LINK_ICONS.send;
  return LINK_ICONS.globe;
}
---

<header class="cv-header">
  <div class="cv-header__main">
    <h1 class="cv-name cv-reveal cv-reveal--1">{pick(ident.displayName, lang)}</h1>
    <p class="cv-legal cv-reveal cv-reveal--1">
      <CvValue leaf={ident.legalName} lang={lang} width={7} />
    </p>
    <p class="cv-headline cv-reveal cv-reveal--2">{pick(ident.headline, lang)}</p>
    <span class="cv-location cv-reveal cv-reveal--2">
      <MapPin aria-hidden="true" />
      <CvValue leaf={ident.location} lang={lang} width={9} />
    </span>
  </div>

  {avatar && <img class="cv-avatar cv-reveal cv-reveal--1" src={avatar} width="112" height="112" alt="" loading="eager" />}
</header>

{variant === 'print' ? (
  <div class="cv-contact-print">
    {ident.email !== null && <span>{pick(ident.email, lang)}</span>}
    {ident.phone !== null && <span>{pick(ident.phone, lang)}</span>}
    {ident.links.map((link) => <span>{pick(link.label, lang)}</span>)}
  </div>
) : (
  <nav class="cv-actions cv-reveal cv-reveal--3" aria-label="contact & résumé actions">
    {ident.email !== null ? (
      <a class="cv-action" href={`mailto:${pick(ident.email, lang)}`}>
        <Mail className="cv-action__icon" aria-hidden="true" />
        <span class="cv-action__label">{t.contact.email}</span>
      </a>
    ) : (
      <button type="button" class="cv-action" data-cv-request-open title={`${t.contact.email} — ${t.redacted.hint}`}>
        <Mail className="cv-action__icon" aria-hidden="true" />
        <span class="cv-action__label cv-action__label--redacted">{t.redacted.word}</span>
      </button>
    )}

    {ident.phone !== null ? (
      <a class="cv-action" href={`tel:${pick(ident.phone, lang).replace(/\s+/g, '')}`}>
        <Phone className="cv-action__icon" aria-hidden="true" />
        <span class="cv-action__label">{t.contact.phone}</span>
      </a>
    ) : (
      <button type="button" class="cv-action" data-cv-request-open title={`${t.contact.phone} — ${t.redacted.hint}`}>
        <Phone className="cv-action__icon" aria-hidden="true" />
        <span class="cv-action__label cv-action__label--redacted">{t.redacted.word}</span>
      </button>
    )}

    {ident.links.map((link) => {
      const Icon = iconFor(pick(link.label, lang));
      return (
        <a class="cv-action" href={link.url} target="_blank" rel="noopener">
          <Icon className="cv-action__icon" aria-hidden="true" />
          <span class="cv-action__label">{pick(link.label, lang)}</span>
        </a>
      );
    })}

    <span class="cv-actions__spacer" aria-hidden="true"></span>

    <a class="cv-action" href={otherLangHref} hreflang={lang === 'en' ? 'zh' : 'en'}>
      <Languages className="cv-action__icon" aria-hidden="true" />
      <span class="cv-action__label cv-action__label--static">{otherLangLabel}</span>
    </a>

    {full ? (
      <a class="cv-action cv-action--primary" href={pdfHref} target="_blank" rel="noopener">
        <FileDown className="cv-action__icon" aria-hidden="true" />
        <span class="cv-action__label cv-action__label--static">{t.pdf}</span>
      </a>
    ) : (
      <button type="button" class="cv-action cv-action--primary" data-cv-request-open>
        <FileDown className="cv-action__icon" aria-hidden="true" />
        <span class="cv-action__label cv-action__label--static">{t.pdf}</span>
      </button>
    )}
  </nav>
)}
