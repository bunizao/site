---
import type { CvLang } from '@bunizao/contracts';
import type { ResolvedCv } from '../server/resolve';
import { CV_STRINGS, formatPeriod, pick } from '../copy';
import CvValue from './CvValue.astro';
import RedactedField from './RedactedField.astro';

interface Props {
  cv: ResolvedCv;
  lang: CvLang;
  avatar?: string;
  /** Screen-only: show the "request full résumé" prompt in the footer. */
  showRequest?: boolean;
}

const { cv, lang, avatar, showRequest = false } = Astro.props;
const t = CV_STRINGS[lang];
const updatedLabel = new Date(cv.updatedAt).toLocaleDateString(
  lang === 'zh' ? 'zh-CN' : 'en-US',
  { year: 'numeric', month: 'short', day: 'numeric' },
);

// Pick a contact glyph from a link label. Falls back to a globe.
function iconFor(label: string): string {
  const l = label.toLowerCase();
  if (l.includes('github')) return 'github';
  if (l.includes('無人') || l.includes('blog') || l.includes('sillage')) return 'book';
  if (l.includes('telegram')) return 'send';
  return 'globe';
}
---

<header class="cv-header">
  <div class="cv-header__main">
    <h1 class="cv-name cv-reveal cv-reveal--1">{pick(cv.identity.displayName, lang)}</h1>
    <p class="cv-legal cv-reveal cv-reveal--1">
      <CvValue leaf={cv.identity.legalName} lang={lang} width={7} />
    </p>
    <p class="cv-headline cv-reveal cv-reveal--2">{pick(cv.identity.headline, lang)}</p>

    <span class="cv-location cv-reveal cv-reveal--2">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
        <circle cx="12" cy="10" r="3"></circle>
      </svg>
      <CvValue leaf={cv.identity.location} lang={lang} width={9} />
    </span>

    <div class="cv-contact cv-reveal cv-reveal--3">
      {cv.identity.email !== null ? (
        <a class="cv-contact__btn" href={`mailto:${pick(cv.identity.email, lang)}`} title={t.contact.email}>
          <span class="sr-only">{t.contact.email}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="m3 7 9 6 9-6"></path>
          </svg>
        </a>
      ) : (
        <span class="cv-contact__btn cv-contact__btn--redacted" title={t.contact.email}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="m3 7 9 6 9-6"></path>
          </svg>
          <RedactedField lang={lang} width={5} />
        </span>
      )}

      {cv.identity.phone !== null ? (
        <a class="cv-contact__btn" href={`tel:${pick(cv.identity.phone, lang).replace(/\s+/g, '')}`} title={t.contact.phone}>
          <span class="sr-only">{t.contact.phone}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15.5 3a5.5 5.5 0 0 1 5.5 5.5M14 6a3 3 0 0 1 3 3"></path>
            <path d="M4.5 3h3l1.5 5-2 1.5a11 11 0 0 0 5 5l1.5-2 5 1.5v3a2 2 0 0 1-2 2A16 16 0 0 1 4.5 5a2 2 0 0 1 0-2Z"></path>
          </svg>
        </a>
      ) : (
        <span class="cv-contact__btn cv-contact__btn--redacted" title={t.contact.phone}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15.5 3a5.5 5.5 0 0 1 5.5 5.5M14 6a3 3 0 0 1 3 3"></path>
            <path d="M4.5 3h3l1.5 5-2 1.5a11 11 0 0 0 5 5l1.5-2 5 1.5v3a2 2 0 0 1-2 2A16 16 0 0 1 4.5 5a2 2 0 0 1 0-2Z"></path>
          </svg>
          <RedactedField lang={lang} width={5} />
        </span>
      )}

      {cv.identity.links.map((link) => (
        <a class="cv-contact__btn" href={link.url} target="_blank" rel="noopener" title={pick(link.label, lang)}>
          <span class="sr-only">{pick(link.label, lang)}</span>
          {iconFor(pick(link.label, lang)) === 'github' && (
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.36 1.09 2.94.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"></path></svg>
          )}
          {iconFor(pick(link.label, lang)) === 'book' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v18H6.5A2.5 2.5 0 0 0 4 22.5Z"></path><path d="M4 4.5A2.5 2.5 0 0 0 6.5 7H20"></path></svg>
          )}
          {iconFor(pick(link.label, lang)) === 'send' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2 11 13"></path><path d="M22 2 15 22l-4-9-9-4Z"></path></svg>
          )}
          {iconFor(pick(link.label, lang)) === 'globe' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"></path></svg>
          )}
        </a>
      ))}
    </div>
  </div>

  {avatar && <img class="cv-avatar cv-reveal cv-reveal--1" src={avatar} width="112" height="112" alt="" loading="eager" />}
</header>

<section class="cv-section">
  <h2 class="cv-section__title">{t.sections.summary}</h2>
  <div class="cv-section__body">
    <p class="cv-summary">{pick(cv.summary, lang)}</p>
  </div>
</section>

<section class="cv-section">
  <h2 class="cv-section__title">{t.sections.experience}</h2>
  <div class="cv-section__body">
    {cv.work.map((job) => (
      <article class="cv-entry">
        <div class="cv-entry__head">
          <span class="cv-entry__org">
            <CvValue leaf={job.company} lang={lang} width={9} />
          </span>
          <span class="cv-entry__period">{formatPeriod(job.start, job.end, lang)}</span>
        </div>
        <div class="cv-entry__role">
          {pick(job.role, lang)}
          {job.location !== null && <> · {pick(job.location, lang)}</>}
        </div>
        <p class="cv-entry__summary">{pick(job.summary, lang)}</p>
        {job.highlights.length > 0 && (
          <ul class="cv-highlights">
            {job.highlights.map((h) => <li>{pick(h, lang)}</li>)}
          </ul>
        )}
        {job.tags && job.tags.length > 0 && (
          <div class="cv-tags">
            {job.tags.map((tag) => <span class="cv-tag">{tag}</span>)}
          </div>
        )}
      </article>
    ))}
  </div>
</section>

<section class="cv-section">
  <h2 class="cv-section__title">{t.sections.projects}</h2>
  <div class="cv-projects">
    {cv.projects.map((project) => (
      <article class="cv-project">
        <h3 class="cv-project__name">
          {project.url ? (
            <a href={project.url} target="_blank" rel="noopener">{pick(project.name, lang)}</a>
          ) : (
            pick(project.name, lang)
          )}
        </h3>
        <p class="cv-project__desc">{pick(project.description, lang)}</p>
        {project.tags && project.tags.length > 0 && (
          <div class="cv-tags">
            {project.tags.map((tag) => <span class="cv-tag">{tag}</span>)}
          </div>
        )}
      </article>
    ))}
  </div>
</section>

<section class="cv-section">
  <h2 class="cv-section__title">{t.sections.education}</h2>
  <div class="cv-section__body">
    {cv.education.map((edu) => (
      <article class="cv-entry">
        <div class="cv-entry__head">
          <span class="cv-entry__org">
            <CvValue leaf={edu.school} lang={lang} width={12} />
          </span>
          <span class="cv-entry__period">{formatPeriod(edu.start, edu.end, lang)}</span>
        </div>
        <div class="cv-entry__role">{pick(edu.degree, lang)}</div>
        {edu.note && <p class="cv-entry__summary">{pick(edu.note, lang)}</p>}
      </article>
    ))}
  </div>
</section>

<section class="cv-section">
  <h2 class="cv-section__title">{t.sections.skills}</h2>
  <div class="cv-skills">
    {cv.skills.map((group) => (
      <div class="cv-skill-group">
        <span class="cv-skill-group__label">{pick(group.group, lang)}</span>
        <div class="cv-skill-group__items">
          {group.items.map((item) => <span class="cv-tag">{item}</span>)}
        </div>
      </div>
    ))}
  </div>
</section>

<footer class="cv-footer">
  <span>{t.updated} {updatedLabel}</span>
  {showRequest && (
    <>
      <span aria-hidden="true">·</span>
      <button type="button" class="cv-footer__request" data-cv-request-open>
        {t.request.open} ↗
      </button>
    </>
  )}
</footer>
