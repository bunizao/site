---
import type { CvLang } from '@bunizao/contracts';
import { CV_STRINGS } from '../copy';

interface Props {
  lang: CvLang;
  /** Approximate width of the plausible content, in ch. */
  width?: number;
  class?: string;
}

const { lang, width = 8, class: className } = Astro.props;
const strings = CV_STRINGS[lang];
// Static dummy glyphs sized to `width` — never derived from the real value.
const glyphs = '▚'.repeat(Math.max(3, Math.round(width * 0.7)));
---

<button
  type="button"
  class:list={['cv-redacted', className]}
  style={`--cv-redacted-w:${width}ch`}
  data-cv-request-open
  aria-label={strings.redacted.label}
  title={strings.redacted.hint}
>
  <span class="cv-redacted__glyphs" aria-hidden="true">{glyphs}</span>
  <svg
    class="cv-redacted__lock"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <rect x="4.5" y="10.5" width="15" height="10" rx="2.2"></rect>
    <path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"></path>
  </svg>
</button>
