---
/* Compose box — the top of the thread, and the primary place a reader is
   asked who they are. (The reply box asks the same question the same way;
   see the note below.)

   It sits at the TOP of the thread on purpose: the reader has just finished
   the post, and the thing they might want to do is write, not scroll past
   other people's writing to find the field.

   Order is identity, then words. The earlier design kept the fields hidden
   and grew them out of the first Post press — writable before anyone had
   said who they were — but that made one button mean "expand" on the first
   press and "submit" on the second, and dropped two unlabelled fields under
   the reader's hands at the moment they were trying to finish. The fields
   are on screen from first paint instead, saying what the address is for in
   their own placeholder, and Post checks them (compose-validate.ts). It costs
   the impulse comment; it buys a form that holds still.

   Three grades the wrapper's `data-phase` can hold (Design → "Identity: three
   grades, one table"):
     anonymous — nothing on file; the identity row is asked for
     claimed   — `buxx:reader` in localStorage; the row gives way to
                 "以 {name} 评论" with "换一个" to ask again
     ready     — a verified `reader_session`; "Posting as {name}" with avatar

   ...crossed with what the current submission attempt is doing, on
   `data-receipt`: idle, submitting, posted, held, nudge, error. The nine rows
   in the PRD's compose-state table are these two axes, not nine flags.

   Presentational only. Submission, the risk stack, and the lazy-verification
   round trip land with client/comments-controller.ts — this component never
   fetches. The reply box in CommentsSection.astro asks the same question the
   same way, sharing IdentityRow.astro and compose-validate.ts rather than
   duplicating either. */

import IdentityRow from '@/features/comments/ui/IdentityRow.astro';
import { initials, seedHue } from '@/features/comments/identity';
import type { ClaimedIdentity, ComposeReceipt, ReaderPhase, Viewer } from '@/features/comments/types';

interface Props {
  /** Reader's current standing. Defaults to signed out, nothing claimed. */
  phase?: ReaderPhase;
  /** Required when phase is 'ready' — carries the resolved avatar. */
  viewer?: Viewer;
  /** Required when phase is 'claimed' — the localStorage mirror, never a
      proof, so it never carries an avatar. */
  claimed?: ClaimedIdentity;
  /** Where the current submission attempt stands. */
  receipt?: ComposeReceipt;
  /** The body text to preserve across `submitting` and `error` — the two
      states where the draft is still the reader's, not gone yet. */
  draftText?: string;
}

const {
  phase = 'anonymous',
  viewer,
  claimed,
  receipt = 'idle',
  draftText = '',
} = Astro.props;

const busy = receipt === 'submitting';
const fieldValue = busy || receipt === 'error' ? draftText : '';
const showReceipt = receipt !== 'idle' && !busy;
---

<div class="blog-compose" data-pagefind-ignore data-phase={phase} data-receipt={receipt}>
  {/* Hidden by CSS on claimed/ready — those readers have an identity on file
      and are told so in the footer instead. Always in the DOM so the claimed
      footer's "换一个" has a row to give back without a re-render. */}
  <IdentityRow id="blog-compose-id" />

  <div class="blog-compose__box">
    <label class="sr-only" for="blog-compose-text">Write a comment</label>
    <textarea
      id="blog-compose-text"
      class="blog-compose__field"
      name="comment"
      rows="4"
      readonly={busy}
      placeholder="Add to the conversation…"
      set:text={fieldValue}></textarea>
    {/* Inside the box it describes. As a line under the box it stacked with
        the validation line to put two rows of small grey text between the
        writing and the button. */}
    <span class="blog-compose__hint">Markdown supported.</span>
  </div>

  <div class="blog-compose__foot">
    {/* All three read as one source of truth in script: only data-phase on
        the wrapper decides which is visible (see comments.css), so the
        claimed → anonymous switch below is a one-line attribute flip
        instead of three branches of DOM surgery. */}
    <span class="blog-compose__who">
      {viewer && (
        <>
          {viewer.avatar ? (
            <img class="blog-compose__whoface" src={viewer.avatar} alt="" width="20" height="20" />
          ) : (
            <span
              class="blog-compose__whoface blog-avatar-seed blog-avatar-initials"
              style={`--seed-hue:${seedHue(viewer.name)}`}
              aria-hidden="true">{initials(viewer.name)}</span>
          )}
          Posting as {viewer.name}
        </>
      )}
    </span>

    <span class="blog-compose__claim">
      {claimed && (
        <>
          以 {claimed.name} 评论
          <button type="button" class="blog-compose__claim-switch" data-compose-switch>换一个</button>
        </>
      )}
    </span>

    {/* One line, spoken only when Post has been pressed on an unfinished box,
        in the slot the hint used to occupy. A disabled button would say the
        same thing by going grey and would never say which field it was
        waiting on. */}
    <p class="blog-compose__ask-error" data-compose-error role="alert" hidden></p>

    <button
      type="button"
      class="blog-compose__go"
      data-compose-submit
      aria-label="Post comment"
      title="Post"
      disabled={busy}
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5M5 12l7-7 7 7"></path>
      </svg>
    </button>
  </div>

  {showReceipt && (
    <div class="blog-compose__receipt" data-compose-receipt aria-live="polite">
      {receipt === 'error' ? (
        <p class="blog-compose__error">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 8v5M12 16h.01"></path>
          </svg>
          Couldn't post that — your draft is still here. Try again.
        </p>
      ) : (
        <>
          <p class="blog-compose__receipt-line">
            {receipt === 'held' ? '评论已提交，正在等待审核' : '已发布'}
          </p>

          {receipt === 'nudge' && (
            /* Non-blocking by construction: nothing else on the page reads
               whether this is open, so dismissing it changes nothing but
               itself. plans/blog-comments.md → "Subscribe prompt": at most
               once per session, never again after a dismissal — the real
               controller owns that memory; this only owns the reveal. */
            <div class="blog-compose__nudge" data-compose-nudge>
              <p class="blog-compose__nudge-text">确认邮箱后可管理评论、接收回复通知</p>
              <label class="blog-compose__nudge-sub">
                <input type="checkbox" data-compose-subscribe />
                订阅新文章邮件
              </label>
              <button type="button" class="blog-compose__nudge-dismiss" data-compose-dismiss aria-label="Dismiss">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <path d="M5 5l14 14M19 5L5 19"></path>
                </svg>
              </button>
            </div>
          )}
        </>
      )}
    </div>
  )}
</div>

<script>
  // The press-Post-and-be-told behaviour is shared with the reply box — see
  // compose-validate.ts. Everything left here is specific to this box: the
  // claimed footer's "换一个", and dismissing the subscribe nudge.
  import { wireComposeValidation } from '@/features/comments/compose-validate';

  wireComposeValidation();

  document.querySelectorAll<HTMLElement>('.blog-compose').forEach((compose) => {
    const switchBtn = compose.querySelector<HTMLButtonElement>('[data-compose-switch]');
    const nudge = compose.querySelector<HTMLElement>('[data-compose-nudge]');

    // "换一个": drop the claimed identity and ask again, same as a
    // first-time anonymous reader. Only the phase attribute needs to change —
    // comments.css keys both the footer and the identity row on it.
    switchBtn?.addEventListener('click', () => {
      compose.dataset.phase = 'anonymous';
      compose.querySelector<HTMLInputElement>('[data-compose-identity] input')?.focus();
    });

    nudge?.querySelector('[data-compose-dismiss]')?.addEventListener('click', () => {
      nudge.hidden = true;
    });
  });
</script>
