---
/* Compose box, and the only place a reader is ever asked who they are.

   It sits at the TOP of the thread on purpose: the reader has just finished
   the post, and the thing they might want to do is write, not scroll past
   other people's writing to find the field.

   The field is writable before anyone has signed in, and the primary button
   always says Post. Identity is asked for at submit, not at the door — making
   people authenticate before they can type loses the comment that motivated
   them to sign in, and on a prerendered page a locked field would also have to
   render locked on first paint and unlock once `/v2/blog/me` answers, so every
   returning reader would watch their own box grey out and come back.

   Two phases, because with the email round trip as the only way in there is
   nothing left to be in between:
     anonymous — writable field; Post reveals one row asking name and email
     ready     — has a session, posts straight away

   The name is asked for beside the email rather than in a step of its own.
   OAuth is deferred (see docs/plans/blog-comments.md), so there is no profile
   name to inherit and no reason to split one row into two screens.

   Presentational only. Submission, the hold-then-verify round trip, draft
   persistence, and Turnstile land with client/comments-controller.ts. */

import { initials, seedHue } from '@/features/comments/identity';
import type { Viewer } from '@/features/comments/types';

interface Props {
  /** Reader's current standing. Defaults to signed out. */
  phase?: 'anonymous' | 'ready';
  viewer?: Viewer;
}

const { phase = 'anonymous', viewer } = Astro.props;
---

<div class="blog-compose" data-pagefind-ignore data-phase={phase}>
  <div class="blog-compose__box">
    <label class="sr-only" for="blog-compose-text">Write a comment</label>
    <textarea
      id="blog-compose-text"
      class="blog-compose__field"
      name="comment"
      rows="2"
      placeholder="Add to the conversation…"></textarea>

    {phase === 'anonymous' && (
      /* One row, revealed by Post, holding everything the reader has to give
         up to be here. The name is theirs to choose — never derived from the
         email's local part, which would publish an address fragment beside
         their words. */
      <div class="blog-compose__id" id="blog-compose-id" data-compose-identity hidden>
        <label class="sr-only" for="blog-compose-name">Display name</label>
        <input
          id="blog-compose-name"
          class="blog-compose__input blog-compose__input--name"
          type="text"
          maxlength="32"
          autocomplete="nickname"
          placeholder="Name to show"
        />
        <label class="sr-only" for="blog-compose-email">Email</label>
        <input
          id="blog-compose-email"
          class="blog-compose__input"
          type="email"
          autocomplete="email"
          placeholder="Email"
        />
      </div>
    )}

    <div class="blog-compose__foot">
      {phase === 'ready' && viewer ? (
        <span class="blog-compose__who">
          {viewer.avatar ? (
            <img class="blog-compose__whoface" src={viewer.avatar} alt="" width="20" height="20" />
          ) : (
            <span
              class="blog-compose__whoface blog-avatar-seed blog-avatar-initials"
              style={`--seed-hue:${seedHue(viewer.name)}`}
              aria-hidden="true">{initials(viewer.name)}</span>
          )}
          Posting as {viewer.name}
        </span>
      ) : (
        /* Both hints ship in the markup and swap on the wrapper's state, so
           the row that explains the email has one source of truth and no
           string to keep in sync in script. The open one is the whole pitch
           for the round trip: it is paid once, not once per comment. */
        <span class="blog-compose__hint">
          <span class="blog-compose__hint--shut">Markdown supported.</span>
          <span class="blog-compose__hint--open">Verify once — after that your comments post straight away.</span>
        </span>
      )}

      <button
        type="button"
        class="blog-compose__go"
        data-compose-post
        aria-expanded="false"
        aria-controls="blog-compose-id"
      >Post</button>
    </div>
  </div>
</div>

<script>
  // Progressive disclosure only — the identity row stays folded until there
  // are words to attach it to. Vanilla by house rule: public reading surfaces
  // do not ship an island for one reveal.
  document.querySelectorAll<HTMLElement>('.blog-compose[data-phase="anonymous"]').forEach((compose) => {
    const post = compose.querySelector<HTMLButtonElement>('[data-compose-post]');
    const identity = compose.querySelector<HTMLElement>('[data-compose-identity]');
    const field = compose.querySelector<HTMLTextAreaElement>('.blog-compose__field');
    if (!post || !identity || !field) return;

    post.addEventListener('click', () => {
      // Open, the button belongs to the controller, which submits the comment
      // and mails the link in one action.
      if (post.getAttribute('aria-expanded') === 'true') return;

      // An empty box asks for nothing. Requesting a name and an email before
      // anyone has written a word is the door-charge this design exists to
      // avoid.
      if (!field.value.trim()) {
        field.focus();
        return;
      }

      post.setAttribute('aria-expanded', 'true');
      identity.hidden = false;
      identity.querySelector<HTMLInputElement>('input')?.focus();
    });
  });
</script>
