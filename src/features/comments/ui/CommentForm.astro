---
/* Compose box, and the only permanent home for the sign-in prompt.

   It sits at the TOP of the thread on purpose: the reader has just finished
   the post, and the thing they might want to do is write, not scroll past
   other people's writing to find the field.

   The field is writable before anyone has signed in. That is the plan's
   "hold the draft, then verify" flow, not a shortcut — making people
   authenticate before they can type loses the comment that motivated them to
   sign in. So the primary button says Sign in rather than Post, and identity
   is collected after the words exist.

   Three phases, matching the three the reader can actually be in:
     anonymous — writable field, sign-in choices behind the primary button
     naming    — signed in, but the display name is asked for once on the
                 first write (plan: "Display name: the reader types it")
     ready     — has a name, can post

   Presentational only. Submission, draft persistence across the OAuth
   redirect, and Turnstile land with client/comments-controller.ts. */

import { initials, seedHue } from '@/features/comments/identity';
import type { Viewer } from '@/features/comments/types';

interface Props {
  /** Reader's current standing. Defaults to signed out. */
  phase?: 'anonymous' | 'naming' | 'ready';
  viewer?: Viewer;
  /** Reader OAuth entry points. Land with server/oauth.ts under `/v2/blog/`;
      `/api/comments` is already spent on mood. */
  githubHref?: string;
  googleHref?: string;
}

const {
  phase = 'anonymous',
  viewer,
  githubHref = '/v2/blog/auth/github',
  googleHref = '/v2/blog/auth/google',
} = Astro.props;

const canPost = phase !== 'anonymous';
---

<div class="blog-compose" data-pagefind-ignore data-phase={phase}>
  <div class="blog-compose__box">
    <label class="sr-only" for="blog-compose-text">Write a comment</label>
    <textarea
      id="blog-compose-text"
      class="blog-compose__field"
      name="comment"
      rows="2"
      placeholder="Add to the conversation…"></textarea>

    {phase === 'naming' && (
      /* Asked once, on the first write. Not the OAuth profile name — that
         would publish whatever someone's GitHub says next to their comment on
         a stranger's blog, which they never agreed to. */
      <div class="blog-compose__name">
        <label class="sr-only" for="blog-compose-name">Display name</label>
        <input
          id="blog-compose-name"
          class="blog-compose__input"
          type="text"
          maxlength="32"
          autocomplete="nickname"
          placeholder="Name to show on your comment"
        />
      </div>
    )}

    <div class="blog-compose__foot">
      {phase === 'ready' && viewer ? (
        <span class="blog-compose__who">
          {viewer.avatar ? (
            <img class="blog-compose__whoface" src={viewer.avatar} alt="" width="20" height="20" />
          ) : (
            <span
              class="blog-compose__whoface blog-avatar-seed blog-avatar-initials"
              style={`--seed-hue:${seedHue(viewer.name)}`}
              aria-hidden="true">{initials(viewer.name)}</span>
          )}
          Posting as {viewer.name}
        </span>
      ) : (
        <span class="blog-compose__hint">Markdown supported.</span>
      )}

      {canPost ? (
        <button type="button" class="blog-compose__go">Post</button>
      ) : (
        <button
          type="button"
          class="blog-compose__go"
          data-signin-toggle
          aria-expanded="false"
          aria-controls="blog-compose-ways"
        ><span class="blog-compose__go-open">Sign in</span><span
            class="blog-compose__go-close">Cancel</span></button>
      )}
    </div>

    {phase === 'anonymous' && (
      /* Folded away until asked for. Three ways in is the right number for the
         audience and the wrong number to meet head-on under a field you have
         not typed in yet. All three converge on one account. */
      <div class="blog-compose__ways" id="blog-compose-ways" hidden>
        <div class="blog-compose__oauth">
          <a class="blog-way" href={githubHref} data-astro-prefetch="false">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2A10 10 0 0 0 8.84 21.5c.5.08.66-.23.66-.5v-1.69C6.73 19.91 6.14 18 6.14 18A2.69 2.69 0 0 0 5 16.5c-.91-.62.07-.6.07-.6a2.1 2.1 0 0 1 1.53 1 2.15 2.15 0 0 0 2.91.83 2.16 2.16 0 0 1 .63-1.34c-2.14-.24-4.52-1.07-4.52-4.91a3.86 3.86 0 0 1 1-2.71 3.58 3.58 0 0 1 .1-2.64s.84-.27 2.75 1.02a9.63 9.63 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02a3.58 3.58 0 0 1 .1 2.64 3.86 3.86 0 0 1 1 2.71c0 3.85-2.34 4.67-4.57 4.91a2.39 2.39 0 0 1 .69 1.85V21c0 .27.16.59.67.5A10 10 0 0 0 12 2Z"></path>
            </svg>
            GitHub
          </a>
          <a class="blog-way" href={googleHref} data-astro-prefetch="false">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path fill="#4285F4" d="M23.06 12.25c0-.85-.08-1.67-.22-2.45H12v4.64h6.2a5.3 5.3 0 0 1-2.3 3.48v2.9h3.72c2.18-2 3.44-4.96 3.44-8.57Z"></path>
              <path fill="#34A853" d="M12 23.5c3.11 0 5.72-1.03 7.62-2.79l-3.72-2.89c-1.03.69-2.35 1.1-3.9 1.1-3 0-5.54-2.03-6.45-4.75H1.7v2.98A11.5 11.5 0 0 0 12 23.5Z"></path>
              <path fill="#FBBC05" d="M5.55 14.17a6.9 6.9 0 0 1 0-4.34V6.85H1.7a11.5 11.5 0 0 0 0 10.3l3.85-2.98Z"></path>
              <path fill="#EA4335" d="M12 4.98c1.69 0 3.21.58 4.4 1.72l3.3-3.3C17.71 1.54 15.1.5 12 .5A11.5 11.5 0 0 0 1.7 6.85l3.85 2.98C6.46 7.11 9 4.98 12 4.98Z"></path>
            </svg>
            Google
          </a>
        </div>

        <div class="blog-compose__or"><span>or</span></div>

        {/* The fallback, and the only path that survives both providers being
            blocked. Name and email together, because the name is required
            before a first comment either way. */}
        <div class="blog-compose__magic">
          <label class="sr-only" for="blog-compose-guestname">Display name</label>
          <input
            id="blog-compose-guestname"
            class="blog-compose__input"
            type="text"
            maxlength="32"
            autocomplete="nickname"
            placeholder="Your name"
          />
          <label class="sr-only" for="blog-compose-email">Email</label>
          <input
            id="blog-compose-email"
            class="blog-compose__input"
            type="email"
            autocomplete="email"
            placeholder="you@example.com"
          />
          <button type="button" class="blog-compose__go">Email me a link</button>
        </div>

        <p class="blog-compose__fineprint">
          Your email is never shown and never shared. Your draft is kept while you sign in.
        </p>
      </div>
    )}
  </div>
</div>

<script>
  // Progressive disclosure only — the three ways stay folded until asked for.
  // Vanilla by house rule: public reading surfaces do not ship an island for
  // one toggle.
  document.querySelectorAll<HTMLElement>('[data-signin-toggle]').forEach((button) => {
    const ways = document.getElementById(button.getAttribute('aria-controls') ?? '');
    if (!ways) return;
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!open));
      ways.hidden = open;
      if (!open) ways.querySelector<HTMLElement>('a, input')?.focus();
    });
  });
</script>
