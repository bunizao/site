---
/* Compose box, and the only permanent home for the sign-in prompt.

   It sits at the TOP of the thread on purpose: the reader has just finished the
   post, and the thing they might want to do is write, not scroll past other
   people's writing to find the field. Signed out it keeps the same footprint
   and says plainly what signing in buys, so the invitation is never something
   you have to go looking for.

   Presentational only — submission lands with client/comments-controller.ts. */

import { initials, seedHue } from '@/features/comments/identity';
import type { Viewer } from '@/features/comments/types';

interface Props {
  signedIn?: boolean;
  viewer?: Viewer;
  /** Reader OAuth entry point. Lands with server/oauth.ts; see the plan's
      `/v2/blog/` namespace — `/api/comments` is already spent on mood. */
  signInHref?: string;
}

const { signedIn = false, viewer, signInHref = '/v2/blog/auth/github' } = Astro.props;
---

<div class="blog-compose" data-pagefind-ignore>
  {signedIn && viewer ? (
    <>
      {viewer.avatar ? (
        <img class="blog-compose__avatar" src={viewer.avatar} alt="" width="28" height="28" />
      ) : (
        <span
          class="blog-compose__avatar blog-avatar-seed blog-avatar-initials"
          style={`--seed-hue:${seedHue(viewer.name)}`}
          aria-hidden="true">{initials(viewer.name)}</span>
      )}

      <form class="blog-compose__box">
        <label class="sr-only" for="blog-compose-text">Write a comment</label>
        <textarea
          id="blog-compose-text"
          class="blog-compose__field"
          name="comment"
          rows="2"
          placeholder="Add to the conversation…"></textarea>
        <div class="blog-compose__foot">
          <span class="blog-compose__hint">Markdown supported. Be kind.</span>
          <button type="submit" class="blog-compose__submit">Post</button>
        </div>
      </form>
    </>
  ) : (
    <>
      <span class="blog-compose__avatar blog-compose__avatar--ghost" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="8" r="3.5"></circle>
          <path d="M4.5 20a7.5 7.5 0 0 1 15 0"></path>
        </svg>
      </span>

      <div class="blog-compose__box blog-compose__box--prompt">
        <p class="blog-compose__prompt">
          Sign in with GitHub to comment. Nothing is posted without your say-so, and your
          email stays private.
        </p>
        <a class="blog-compose__signin" href={signInHref} data-astro-prefetch="false">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2A10 10 0 0 0 8.84 21.5c.5.08.66-.23.66-.5v-1.69C6.73 19.91 6.14 18 6.14 18A2.69 2.69 0 0 0 5 16.5c-.91-.62.07-.6.07-.6a2.1 2.1 0 0 1 1.53 1 2.15 2.15 0 0 0 2.91.83 2.16 2.16 0 0 1 .63-1.34c-2.14-.24-4.52-1.07-4.52-4.91a3.86 3.86 0 0 1 1-2.71 3.58 3.58 0 0 1 .1-2.64s.84-.27 2.75 1.02a9.63 9.63 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02a3.58 3.58 0 0 1 .1 2.64 3.86 3.86 0 0 1 1 2.71c0 3.85-2.34 4.67-4.57 4.91a2.39 2.39 0 0 1 .69 1.85V21c0 .27.16.59.67.5A10 10 0 0 0 12 2Z"></path>
          </svg>
          Sign in
        </a>
      </div>
    </>
  )}
</div>
