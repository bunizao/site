---
// Human-authorship pledge at the foot of a post. Shown whenever a post credits
// no model co-author, which is the default.
//
// This used to carry a "why do I insist on not using AI?" trigger opening a
// glassy card with the author's manifesto. The card, its hover controller, its
// touch fallback and its reduced-motion rule all existed to hide one sentence
// that the pledge already implies. The manifesto is still authored in
// `authors[id].manifesto` and wants a page of its own, not a footer popover.
import { blog } from '@/data/site';

const blogCopy = blog.copy[blog.locale.blog];
---

<aside class="not-by-ai">
  <p class="not-by-ai__line">
    {blogCopy.notByAI.prefix}<strong class="not-by-ai__em">{blogCopy.notByAI.emphasis}</strong>{blogCopy.notByAI.suffix}
  </p>
</aside>

<style>
  .not-by-ai {
    min-width: 0;
  }

  /* The 320px is a *width* intent: hold a readable measure beside the action
     pills, wrap below them when the bar can no longer afford it. It has to be
     gated on the breakpoint where .blog-end__bar is still a row (blog.css) —
     flex-basis follows the flex axis, so under `flex-direction: column` the
     same declaration reserved 320px of height and opened ~300px of void under
     this one line. */
  @media (min-width: 640px) {
    .not-by-ai {
      flex: 1 1 320px;
    }
  }

  /* A short hairline dash marks this as metadata about the article rather
     than the article's own voice — the same job the opening byline does with
     its typography, just made visible here since a closing line has no
     heading above it to signal the shift. Echoes the --blog-line hairline
     that follows in .blog-article-foot, at a fifth of its width. */
  .not-by-ai::before {
    content: '';
    display: block;
    width: 28px;
    height: 1px;
    margin-bottom: 8px;
    background: var(--blog-line);
  }

  .not-by-ai__line {
    margin: 0;
    max-width: 56ch;
    /* Matches .blog-article__meta (the opening byline) instead of inventing a
       new metadata voice: 14px / 20px leading / faint / tabular numerals. */
    font-size: 14px;
    line-height: 20px;
    color: var(--blog-faint);
    font-variant-numeric: tabular-nums;
    text-wrap: pretty;
  }

  .not-by-ai__em {
    font-weight: 600;
    /* --blog-dian is the ink reserved for this exact mark (see src/data/site.ts) —
       the pledge gets the publication's own colour instead of plain foreground. */
    color: var(--blog-dian);
  }
</style>
