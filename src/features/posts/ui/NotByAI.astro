---
// Human-authorship pledge at the foot of a post. Shown whenever a post credits
// no model co-author, which is the default.
//
// This used to carry a "why do I insist on not using AI?" trigger opening a
// glassy card with the author's manifesto. The card, its hover controller, its
// touch fallback and its reduced-motion rule all existed to hide one sentence
// that the pledge already implies. The manifesto is still authored in
// `authors[id].manifesto` and wants a page of its own, not a footer popover.
import { blog, type BlogLocale } from '@/data/site';

interface Props {
  /** The article's language — this pledge is part of the article, not the site. */
  locale?: BlogLocale;
}

const { locale = blog.locale.blog } = Astro.props;
const blogCopy = blog.copy[locale];
---

<aside class="not-by-ai">
  <p class="not-by-ai__line">
    {blogCopy.notByAI.prefix}<strong class="not-by-ai__em">{blogCopy.notByAI.emphasis}</strong>{blogCopy.notByAI.suffix}
  </p>
</aside>

<style>
  .not-by-ai {
    min-width: 0;
  }

  /* The 320px is a *width* intent: hold a readable measure beside the action
     pills, wrap below them when the bar can no longer afford it. It has to be
     gated on the breakpoint where .blog-end__bar is still a row (blog.css) —
     flex-basis follows the flex axis, so under `flex-direction: column` the
     same declaration reserved 320px of height and opened ~300px of void under
     this one line. */
  @media (min-width: 640px) {
    .not-by-ai {
      flex: 1 1 320px;
    }
  }

  .not-by-ai__line {
    margin: 0;
    max-width: 56ch;
    font-size: 14px;
    line-height: 1.6;
    color: var(--blog-muted);
    text-wrap: pretty;
  }

  .not-by-ai__em {
    font-weight: 600;
    color: var(--blog-ink);
  }
</style>
