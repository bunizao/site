---
/**
 * The sea at the end of /blog: a crayon sailboat crossing a crayon sea, seen
 * side on, the page itself standing in for the sky.
 *
 * Nothing here is drawn. The art in public/sillage/{light,dark}/ and every
 * number below come from scripts/paint-sillage.ts, which paints both themes in
 * the blog's own inks and writes sillage-motion.json beside this file. Repaint
 * there; this file only moves the pieces.
 *
 * How the motion holds together:
 *
 *   - The boat never moves across the page. The water does: each row of sea
 *     is one seamless tile repeated, translated one tile per period, so the
 *     loop has no seam to find. Nearer rows pass faster.
 *   - The boat rides the painted swell, not a sine wave. Its heave and pitch
 *     are sampled from the same surface the near row was painted from, so a
 *     crest passing under the hull lifts it and tips the bow, and the bow wave
 *     swells as the stem drives into the water.
 *   - The wake is foam left on the water: each streak is born at the stern and
 *     drifts astern at exactly the water's speed, at the height of the surface
 *     it was born on — which never changes, because it moves with that water.
 *   - The sea can be touched. A touch splashes on the painted surface under
 *     the finger; a sideways drag takes hold of the water and moves it with the
 *     finger. Every animation here shares one clock, so however fast the
 *     finger drives the sea, the boat's ride stays true to it.
 *
 * Everything is a transform or opacity animation, so it runs off the main
 * thread. It only runs while the band is on screen, and reduced motion gets
 * the same picture standing still, untouchable.
 */
import motion from './sillage-motion.json';

const { tile, period, near, front, back, clouds, boat, foam, bow, drop, ride } = motion;

// Keyframes generated from the painted surface. Closed with a copy of the first
// frame so the loop joins itself.
const frames = (series: number[], frame: (i: number) => string) =>
  [...series.map((_, i) => `${((i / series.length) * 100).toFixed(3)}%{${frame(i)}}`), `100%{${frame(0)}}`].join('');
const heave = (i: number) => `translate:0 calc(${ride.heave[i]} * var(--u))`;
const round = (v: number) => Math.round(v * 1000) / 1000;
const lifeEnd = `${foam.life * 100}%`;
const motionCss = [
  `@keyframes sillage-ride{${frames(ride.heave, (i) => `${heave(i)};rotate:${ride.pitch[i]}deg`)}}`,
  `@keyframes sillage-heave{${frames(ride.heave, heave)}}`,
  // The bow wave stays on the water at the stem, and grows as the stem drives in.
  `@keyframes sillage-bow{${frames(bow.lift, (i) => {
    const surge = bow.surge[i];
    return (
      `translate:0 calc(${bow.lift[i]} * var(--u));` +
      `scale:${round(0.7 + 0.4 * surge)} ${round(0.45 + 0.75 * surge)};` +
      `opacity:calc(${round(0.3 + 0.7 * surge)} * var(--dim, 1))`
    );
  })}}`,
  // Foam: fades in at the stern, drifts astern with the water for `life` of a
  // period while it stretches and spreads, and is gone before it repeats.
  `@keyframes sillage-foam{` +
    `0%{transform:translate3d(0,0,0) scaleX(.3);opacity:0}` +
    `1.5%{opacity:calc(var(--o) * var(--dim, 1))}` +
    `${foam.life * 45}%{opacity:calc(var(--o) * var(--dim, 1) * .75)}` +
    `${lifeEnd},100%{transform:translate3d(calc(${-foam.life * tile} * var(--u)),calc(var(--sp) * var(--u)),0) scaleX(var(--st));opacity:0}` +
    `}`,
].join('');

const vars = [
  `--tile:${tile}`,
  `--period:${period}s`,
  `--near-h:${near.height}`,
  `--surface:${near.surface}`,
  `--anchor:${near.anchor}`,
  `--front-h:${front.height}`,
  `--front-period:${front.period}s`,
  `--back-h:${back.height}`,
  `--back-floor:${back.floor}`,
  `--back-period:${back.period}s`,
  `--cloud-h:${clouds.height}`,
  `--cloud-floor:${clouds.floor}`,
  `--boat-w:${boat.width}`,
  `--boat-h:${boat.height}`,
  `--boat-ox:${boat.originX}`,
  `--boat-oy:${boat.originY}`,
  `--draft:${boat.draft}`,
  `--lantern-x:${boat.lantern.x}`,
  `--lantern-y:${boat.lantern.y}`,
  `--flag-x:${boat.flag.x}`,
  `--flag-y:${boat.flag.y}`,
  `--flag-w:${boat.flag.width}`,
  `--flag-h:${boat.flag.height}`,
  `--foam-w:${foam.width}`,
  `--foam-h:${foam.height}`,
  `--foam-rows:${foam.variants - 1}`,
  `--stern:${foam.stern}`,
  `--bow:${bow.x}`,
  `--bow-w:${bow.sprite.width}`,
  `--bow-h:${bow.sprite.height}`,
  `--bow-sx:${bow.sprite.x}`,
  `--bow-sy:${bow.sprite.y}`,
  `--drop:${drop.size}`,
  `--drop-rows:${drop.variants - 1}`,
].join(';');
---

<div class="sillage-sea" style={vars} data-sillage-sea aria-hidden="true">
  <div class="sillage-sea__clouds"></div>
  <div class="sillage-sea__back"></div>
  <div class="sillage-sea__boat">
    <span class="sillage-sea__glow"></span>
    <span class="sillage-sea__flag"></span>
  </div>
  <div class="sillage-sea__near"></div>
  <span class="sillage-sea__bow"></span>
  <span class="sillage-sea__churn"></span>
  {
    foam.streaks.map((streak) => (
      <span
        class="sillage-sea__foam"
        style={`--b:${streak.bottom};--d:${streak.delay}s;--v:${streak.variant};--o:${streak.opacity};--sp:${streak.spread};--st:${streak.stretch}`}
      />
    ))
  }
  <span class="sillage-sea__glint"></span>
  <div class="sillage-sea__front"></div>
</div>

<style is:inline set:html={motionCss}></style>

<style>
  .sillage-sea {
    /* One art pixel. Everything is sized in art pixels, so the scene scales as
       one picture and the tiles keep their painted proportions. */
    --s: 1;
    --u: calc(var(--s) * 1px);
    --tile-w: calc(var(--tile) * var(--u));
    /* Where the boat sits across the band. A third in, as in the sketch. */
    --boat-x: 33%;
    /* The waterline, measured up from the floor. */
    --waterline: calc((var(--near-h) - var(--surface)) * var(--u));

    position: relative;
    /* Full-bleed out of .blog-shell, then past its 48px bottom gutter so the
       water meets the page edge. */
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    margin-top: 64px;
    margin-bottom: -48px;
    height: calc(240 * var(--u));
    overflow: hidden;
    contain: layout paint;
    /* Sideways drags belong to the sea; vertical ones still scroll the page. */
    touch-action: pan-y pinch-zoom;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }

  @media (hover: hover) and (pointer: fine) {
    .sillage-sea {
      cursor: grab;
    }

    .sillage-sea[data-held] {
      cursor: grabbing;
    }
  }

  /* The art loads only once the band nears the screen; before that no layer
     has an image. The two sets are the same picture painted twice, day and
     night, in the blog's inks — not one set re-lit by a filter. */
  .sillage-sea[data-seen] {
    --art-front: url('/sillage/light/front.webp');
    --art-near: url('/sillage/light/near.webp');
    --art-back: url('/sillage/light/back.webp');
    --art-clouds: url('/sillage/light/clouds.webp');
    --art-boat: url('/sillage/light/boat.webp');
    --art-flag: url('/sillage/light/flag.webp');
    --art-foam: url('/sillage/light/foam.webp');
    --art-spray: url('/sillage/light/spray.webp');
    --art-drops: url('/sillage/light/drops.webp');
  }

  :global(.dark) .sillage-sea[data-seen] {
    --art-front: url('/sillage/dark/front.webp');
    --art-near: url('/sillage/dark/near.webp');
    --art-back: url('/sillage/dark/back.webp');
    --art-clouds: url('/sillage/dark/clouds.webp');
    --art-boat: url('/sillage/dark/boat.webp');
    --art-flag: url('/sillage/dark/flag.webp');
    --art-foam: url('/sillage/dark/foam.webp');
    --art-spray: url('/sillage/dark/spray.webp');
    --art-drops: url('/sillage/dark/drops.webp');
    --art-glint: url('/sillage/dark/glint.webp');
  }

  /* Defaults for every layer, at zero specificity: Astro scopes selectors with
     attributes, so a plain `.sillage-sea *` would outrank each layer's own rule.
     Global, too, because splashes are made at runtime and carry no scope. */
  :global(:where(.sillage-sea *)) {
    position: absolute;
    display: block;
    background-repeat: no-repeat;
    background-size: 100% 100%;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  /* --- Drifting rows -----------------------------------------------------
     Each is its tile repeated, one tile wider than it needs to be, and
     translated by exactly one tile per loop. The rows away from the boat also
     breathe up and down on their own slow count, so the sea never reads as a
     conveyor. */
  .sillage-sea__front,
  .sillage-sea__near,
  .sillage-sea__back,
  .sillage-sea__clouds {
    background-repeat: repeat-x;
    background-size: var(--tile-w) 100%;
    animation-name: sillage-drift;
  }

  @keyframes sillage-drift {
    to {
      transform: translate3d(calc(-1 * var(--tile-w)), 0, 0);
    }
  }

  @keyframes sillage-breathe {
    to {
      translate: 0 calc(var(--rise) * var(--u));
    }
  }

  .sillage-sea__clouds {
    left: 0;
    bottom: calc(var(--cloud-floor) * var(--u));
    width: calc(100% + var(--tile-w));
    height: calc(var(--cloud-h) * var(--u));
    background-image: var(--art-clouds);
    /* The sky barely moves: furthest away, slowest past. */
    animation-duration: calc(var(--period) * 5);
  }

  .sillage-sea__back {
    --rise: -1.4;
    left: 0;
    bottom: calc(var(--back-floor) * var(--u));
    width: calc(100% + var(--tile-w));
    height: calc(var(--back-h) * var(--u));
    background-image: var(--art-back);
    animation-name: sillage-drift, sillage-breathe;
    animation-duration: var(--back-period), 9.7s;
    animation-timing-function: linear, ease-in-out;
    animation-direction: normal, alternate;
  }

  /* The near row is pinned so that the tile position the ride was sampled at
     sits under the boat at the start of the loop, at any viewport width.
     Otherwise the boat would pitch to a wave that is somewhere else. It does
     not breathe: the boat is riding it. */
  .sillage-sea__near {
    left: calc(var(--boat-x) - (var(--anchor) + 1) * var(--tile-w));
    bottom: 0;
    width: calc(100% + (var(--anchor) + 2) * var(--tile-w));
    height: calc(var(--near-h) * var(--u));
    background-image: var(--art-near);
    animation-duration: var(--period);
  }

  /* The nearest water, in front of everything. It breathes downward only, so
     its foot never lifts off the floor. */
  .sillage-sea__front {
    --rise: 2.2;
    left: 0;
    bottom: 0;
    width: calc(100% + var(--tile-w));
    height: calc(var(--front-h) * var(--u));
    background-image: var(--art-front);
    animation-name: sillage-drift, sillage-breathe;
    animation-duration: var(--front-period), 6.3s;
    animation-timing-function: linear, ease-in-out;
    animation-direction: normal, alternate;
  }

  /* --- The boat ----------------------------------------------------------
     Between the two seas: the back swell behind the hull, the near sea in
     front of it, hiding everything below the waterline. */
  .sillage-sea__boat {
    left: calc(var(--boat-x) - var(--boat-ox) * var(--u));
    bottom: calc(var(--waterline) - (var(--boat-h) - var(--boat-oy) + var(--draft)) * var(--u));
    width: calc(var(--boat-w) * var(--u));
    height: calc(var(--boat-h) * var(--u));
    background-image: var(--art-boat);
    transform-origin: calc(var(--boat-ox) * var(--u)) calc(var(--boat-oy) * var(--u));
    animation-name: sillage-ride;
    animation-duration: var(--period);
  }

  .sillage-sea__flag {
    left: calc(var(--flag-x) * var(--u));
    top: calc(var(--flag-y) * var(--u));
    width: calc(var(--flag-w) * var(--u));
    height: calc(var(--flag-h) * var(--u));
    background-image: var(--art-flag);
    transform-origin: 0 50%;
    animation: sillage-flutter 1.9s ease-in-out infinite alternate;
  }

  @keyframes sillage-flutter {
    from {
      transform: scaleX(1) skewY(0deg);
    }
    to {
      transform: scaleX(0.9) skewY(-5deg);
    }
  }

  /* --- White water ---------------------------------------------------------
     The bow wave: its sprite's stem point sits on the water at the stem. */
  .sillage-sea__bow {
    left: calc(var(--boat-x) + (var(--bow) - var(--bow-sx)) * var(--u));
    bottom: calc(var(--waterline) - (var(--bow-h) - var(--bow-sy)) * var(--u));
    width: calc(var(--bow-w) * var(--u));
    height: calc(var(--bow-h) * var(--u));
    background-image: var(--art-spray);
    transform-origin: calc(var(--bow-sx) * var(--u)) calc(var(--bow-sy) * var(--u));
    animation-name: sillage-bow;
    animation-duration: var(--period);
  }

  /* The wake: right edge on the stern; the sprite's rows are the variants. */
  .sillage-sea__foam {
    left: calc(var(--boat-x) + (var(--stern) - var(--foam-w)) * var(--u));
    bottom: calc(var(--b) * var(--u));
    width: calc(var(--foam-w) * var(--u));
    height: calc(var(--foam-h) * var(--u));
    background-image: var(--art-foam);
    background-size: 100% calc((var(--foam-rows) + 1) * 100%);
    background-position: 0 calc(var(--v) / var(--foam-rows) * 100%);
    transform-origin: 100% 50%;
    opacity: 0;
    animation-name: sillage-foam;
    animation-duration: var(--period);
    animation-delay: var(--d);
  }

  /* Moonlit foam is the brightest thing on a dark sea; at full strength it
     reads as dashes, not water. */
  :global(.dark) .sillage-sea {
    --dim: 0.55;
  }

  /* Water broken by the stern itself. It stays with the boat, so the wake
     never shows daylight between the hull and the newest streak. */
  .sillage-sea__churn {
    left: calc(var(--boat-x) + (var(--stern) - 30) * var(--u));
    bottom: calc(var(--waterline) - var(--foam-h) * 0.62 * var(--u));
    width: calc(34 * var(--u));
    height: calc(var(--foam-h) * var(--u));
    background-image: var(--art-foam);
    background-size: calc(var(--foam-w) * var(--u)) calc((var(--foam-rows) + 1) * 100%);
    background-position: 100% 0;
    transform-origin: 100% 50%;
    animation:
      sillage-heave var(--period) linear infinite,
      sillage-churn 1.3s ease-in-out infinite alternate;
  }

  @keyframes sillage-churn {
    from {
      transform: scaleX(0.8);
      opacity: calc(0.7 * var(--dim, 1));
    }
    to {
      transform: scaleX(1.1);
      opacity: calc(0.95 * var(--dim, 1));
    }
  }

  /* Splashes are made by the script, where a finger touches the water. Each
     is a point on the surface; its droplets and the foam it spreads are
     animated from there. */
  :global(.sillage-sea__splash) {
    width: 0;
    height: 0;
  }

  :global(.sillage-sea__drop) {
    left: calc(var(--drop) * -0.5 * var(--u));
    top: calc(var(--drop) * -0.5 * var(--u));
    width: calc(var(--drop) * var(--u));
    height: calc(var(--drop) * var(--u));
    background-image: var(--art-drops);
    background-size: 100% calc((var(--drop-rows) + 1) * 100%);
    background-position: 0 calc(var(--v) / var(--drop-rows) * 100%);
    opacity: var(--dim, 1);
  }

  /* Foam running away from the splash: the thick end of a wake streak, its
     right edge on the point of impact. The script mirrors one of each pair
     about that edge, so the two run off both ways. */
  :global(.sillage-sea__spread) {
    right: 0;
    top: calc(var(--foam-h) * -0.62 * var(--u));
    width: calc(var(--foam-w) * 0.42 * var(--k, 1) * var(--u));
    height: calc(var(--foam-h) * var(--u));
    background-image: var(--art-foam);
    background-size: calc(var(--foam-w) * var(--k, 1) * var(--u)) calc((var(--foam-rows) + 1) * 100%);
    background-position: 100% calc(var(--v) / var(--foam-rows) * 100%);
    transform-origin: 100% 50%;
    opacity: 0;
  }

  /* --- Night: the lantern -------------------------------------------------
     "是深夜里独自点亮的灯" — the one light out on the water. By day the
     lantern is an unlit object painted on the boat, and these stay hidden —
     hidden, not removed, so their clocks keep time with the boat's and a
     theme switch picks them up mid-stride. */
  .sillage-sea__glow,
  .sillage-sea__glint {
    visibility: hidden;
  }

  :global(.dark) .sillage-sea__glow,
  :global(.dark) .sillage-sea__glint {
    visibility: visible;
  }

  .sillage-sea__glow {
    left: calc((var(--lantern-x) - 20) * var(--u));
    top: calc((var(--lantern-y) - 20) * var(--u));
    width: calc(40 * var(--u));
    height: calc(40 * var(--u));
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--blog-ji) 42%, transparent),
      color-mix(in srgb, var(--blog-ji) 12%, transparent) 55%,
      transparent
    );
    animation: sillage-flicker 5.3s ease-in-out infinite alternate;
  }

  /* The reflection stays on the water: it heaves with the boat but does not
     tip with it, and sits in front of the near sea. */
  .sillage-sea__glint {
    left: calc(var(--boat-x) + (var(--lantern-x) - var(--boat-ox) - 14) * var(--u));
    bottom: calc(var(--waterline) - 46 * var(--u));
    width: calc(28 * var(--u));
    height: calc(44 * var(--u));
    background-image: var(--art-glint);
    transform-origin: 50% 0;
    animation:
      sillage-heave var(--period) linear infinite,
      sillage-shimmer 3.7s ease-in-out infinite alternate;
  }

  @keyframes sillage-flicker {
    from {
      opacity: 0.8;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes sillage-shimmer {
    from {
      transform: scaleX(1) scaleY(1);
      opacity: 0.8;
    }
    to {
      transform: scaleX(0.82) scaleY(1.08);
      opacity: 0.55;
    }
  }

  /* Off screen, or asked to hold still: the same picture, standing still. The
     negative delays mean even the first frame has its wake. */
  .sillage-sea:not([data-awake]) * {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .sillage-sea {
      cursor: auto;
    }

    .sillage-sea * {
      animation-play-state: paused !important;
    }
  }

  @media (max-width: 1023px) {
    .sillage-sea {
      --s: 0.8;
      --boat-x: 30%;
    }
  }

  @media (max-width: 639px) {
    .sillage-sea {
      --s: 0.62;
      --boat-x: 28%;
      margin-top: 48px;
    }
  }
</style>

<script>
  import { stir } from './sillage-touch';

  // Load the art as the band approaches, and run it only while it is in view.
  const sea = document.querySelector<HTMLElement>('[data-sillage-sea]');
  if (sea) {
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) sea.toggleAttribute('data-seen', true);
        sea.toggleAttribute('data-awake', entry.isIntersecting);
      },
      { root: document.querySelector('[data-page-scroller]'), rootMargin: '400px 0px' },
    ).observe(sea);
    stir(sea);
  }
</script>
