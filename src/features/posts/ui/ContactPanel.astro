---
// "联系" widget for the blog masthead — sits to the right of the subscribe
// trigger and mirrors its quiet-until-opened behaviour. The trigger carries a
// contact mark; hovering (or tapping, on touch) expands a popover listing the
// channels from `contactLinks` in src/data/site.ts. The Blog link is filtered
// out at the data layer, so this only ever shows the "elsewhere" channels
// (GitHub, Email, Telegram, Instagram, …). Colours ride the blog-zone tokens so
// it reads identically to the subscribe trigger beside it.
import { contactLinks } from '@/data/site';

const isMail = (url: string) => url.startsWith('mailto:');

// Per-channel brand accent for the hover state (light / dark). Presentation
// detail that belongs with the icons, not the content in site.ts. Real brand
// colours, not guesses: GitHub is monochrome (ink → near-white in dark);
// Telegram is its sky blue. Instagram and Email (Gmail) are gradients, not flat
// colours, so they get bespoke chip fills in CSS instead of a value here.
// Anything unmapped falls back to the house accent.
const BRAND: Record<string, { light: string; dark: string }> = {
  GitHub: { light: '#181717', dark: '#f0f6fc' },
  Telegram: { light: '#26a5e4', dark: '#3eb5f1' },
};

const brandVars = (name: string) => {
  const brand = BRAND[name];
  return brand ? `--bl:${brand.light};--bd:${brand.dark}` : undefined;
};
---

<div class="contact" data-contact>
  <button
    type="button"
    class="contact-trigger"
    data-contact-toggle
    aria-haspopup="true"
    aria-expanded="false"
  >
    <!-- Lucide at-sign at stroke 1.5. Three concentric curves in a 16px box
         need the thinner stroke; at Lucide's default 2 the counters fill in
         and the glyph reads as a blob. Matches the subscribe trigger beside it. -->
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-3.92 7.94"></path>
    </svg>
    <span>联系</span>
    <svg class="contact-trigger__caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </button>

  <div class="contact-panel" data-contact-panel role="menu" aria-label="联系方式">
    <p class="contact-panel__eyebrow">也可以在这里找到我</p>
    <ul class="contact-list">
      {contactLinks.map((link) => (
        <li>
          <a
            class="contact-row"
            role="menuitem"
            href={link.url}
            title={link.description}
            data-channel={link.name}
            style={brandVars(link.name)}
            {...(isMail(link.url) ? {} : { target: '_blank', rel: 'me noopener noreferrer' })}
          >
            <span class="contact-row__chip" aria-hidden="true">
              <link.icon />
            </span>
            <span class="contact-row__body">
              <span class="contact-row__name">{link.name}</span>
              <span class="contact-row__handle">{link.handle}</span>
            </span>
            <svg class="contact-row__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 17 17 7M9 7h8v8"></path>
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .contact {
    position: relative;
    display: inline-flex;
  }

  /* Trigger mirrors the subscribe trigger's weight so the pair reads as a set. */
  .contact-trigger {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 0;
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    color: var(--blog-muted, hsl(var(--muted-foreground)));
    background: none;
    border: none;
    cursor: pointer;
    transition: color 0.15s ease, scale 0.12s ease;
  }

  .contact-trigger:hover,
  .contact-trigger[aria-expanded='true'] {
    color: var(--blog-ink, hsl(var(--foreground)));
  }

  .contact-trigger:active {
    scale: 0.96;
  }

  .contact-trigger > svg:first-child {
    width: 16px;
    height: 16px;
    color: var(--blog-faint, hsl(var(--muted-foreground) / 0.7));
    transition: color 0.15s ease;
  }

  .contact-trigger:hover > svg:first-child,
  .contact-trigger[aria-expanded='true'] > svg:first-child {
    color: var(--blog-accent, hsl(var(--foreground)));
  }

  .contact-trigger__caret {
    width: 12px;
    height: 12px;
    color: var(--blog-faint, hsl(var(--muted-foreground) / 0.7));
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .contact:hover .contact-trigger__caret,
  .contact:focus-within .contact-trigger__caret,
  .contact.is-open .contact-trigger__caret {
    transform: rotate(180deg);
  }

  /* Popover. Anchored under the trigger; opens on hover / focus-within, and on
     .is-open for touch (no hover) via the toggle script below. */
  .contact-panel {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    z-index: 60;
    width: 268px;
    max-width: calc(100vw - 32px);
    padding: 8px;
    background: hsl(var(--background));
    border: 1px solid hsl(var(--foreground) / 0.1);
    border-radius: 13px;
    box-shadow:
      0 12px 32px hsl(var(--foreground) / 0.1),
      0 2px 8px hsl(var(--foreground) / 0.04);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px) scale(0.97);
    transform-origin: top left;
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0.16s ease;
    pointer-events: none;
  }

  /* Invisible hover bridge across the gap so the panel survives the trip from
     trigger to list. */
  .contact-panel::before {
    content: '';
    position: absolute;
    top: -12px;
    left: 0;
    right: 0;
    height: 12px;
  }

  .contact:hover .contact-panel,
  .contact:focus-within .contact-panel,
  .contact.is-open .contact-panel {
    opacity: 1;
    visibility: visible;
    transform: none;
    pointer-events: auto;
  }

  .contact-panel__eyebrow {
    margin: 4px 8px 8px;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: hsl(var(--muted-foreground) / 0.72);
  }

  .contact-list {
    display: flex;
    flex-direction: column;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-row {
    /* Brand accent (set inline per row); resolves to the light value here and
       the dark value under .dark, falling back to the blog accent. */
    --brand: var(--bl, var(--blog-accent, hsl(var(--foreground))));
    position: relative;
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 8px 9px;
    /* Concentric with the 13px panel and its 8px padding (13 − 8 ≈ 7). */
    border-radius: 7px;
    color: inherit;
    text-decoration: none;
    transition: background 0.14s ease;
  }

  :global(.dark) .contact-row {
    --brand: var(--bd, var(--blog-accent, hsl(var(--foreground))));
  }

  .contact-row:hover,
  .contact-row:focus-visible {
    background: hsl(var(--foreground) / 0.05);
    outline: none;
  }

  .contact-row__chip {
    flex: none;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: hsl(var(--foreground) / 0.05);
    color: var(--blog-faint, hsl(var(--muted-foreground)));
    transition: color 0.14s ease, background 0.14s ease;
  }

  .contact-row__chip :global(svg) {
    width: 17px;
    height: 17px;
  }

  .contact-row:hover .contact-row__chip,
  .contact-row:focus-visible .contact-row__chip {
    color: var(--brand);
    background: color-mix(in srgb, var(--brand) 14%, transparent);
  }

  /* GitHub's mark is monochrome — a faint tint reads as nothing, so fill the
     chip the way the invertocat sits: black chip + white glyph in light, the
     inverse in dark so it always pops against the panel. */
  .contact-row[data-channel='GitHub']:hover .contact-row__chip,
  .contact-row[data-channel='GitHub']:focus-visible .contact-row__chip {
    background: #181717;
    color: #fff;
  }

  :global(.dark) .contact-row[data-channel='GitHub']:hover .contact-row__chip,
  :global(.dark) .contact-row[data-channel='GitHub']:focus-visible .contact-row__chip {
    background: #fff;
    color: #181717;
  }

  /* Telegram's icon is a white plane on a blue chip — match it. The gradient is
     a quiet light→dark blue (its real logo sweep), not decoration. */
  .contact-row[data-channel='Telegram']:hover .contact-row__chip,
  .contact-row[data-channel='Telegram']:focus-visible .contact-row__chip {
    color: #fff;
    background: linear-gradient(180deg, #2aabee 0%, #229ed9 100%);
  }

  /* Instagram has no single brand colour — it's the corner-to-corner gradient.
     Fill the chip with it and flip the glyph white, the way the app icon reads. */
  .contact-row[data-channel='Instagram']:hover .contact-row__chip,
  .contact-row[data-channel='Instagram']:focus-visible .contact-row__chip {
    color: #fff;
    background-image: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
  }

  .contact-row[data-channel='Instagram']:hover .contact-row__arrow,
  .contact-row[data-channel='Instagram']:focus-visible .contact-row__arrow {
    color: #dc2743;
  }

  /* Gmail reads as one thing: the red envelope. A rainbow sweep is louder than
     it is recognisable, so fill the chip solid Gmail red with a white glyph. */
  .contact-row[data-channel='Email']:hover .contact-row__chip,
  .contact-row[data-channel='Email']:focus-visible .contact-row__chip {
    color: #fff;
    background: #ea4335;
  }

  .contact-row[data-channel='Email']:hover .contact-row__arrow,
  .contact-row[data-channel='Email']:focus-visible .contact-row__arrow {
    color: #ea4335;
  }

  .contact-row[data-channel='Email']:hover .contact-row__gmail,
  .contact-row[data-channel='Email']:focus-visible .contact-row__gmail {
    display: block;
  }

  .contact-row__body {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .contact-row__name {
    font-size: 13px;
    font-weight: 500;
    line-height: 1.3;
    color: var(--blog-ink, hsl(var(--foreground)));
  }

  .contact-row__handle {
    font-size: 11.5px;
    line-height: 1.3;
    color: var(--blog-faint, hsl(var(--muted-foreground)));
    font-family: var(--font-mono, ui-monospace, monospace);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .contact-row__arrow {
    flex: none;
    width: 15px;
    height: 15px;
    margin-left: auto;
    color: var(--blog-faint, hsl(var(--muted-foreground)));
    opacity: 0;
    transform: translate(-2px, 2px);
    transition: opacity 0.14s ease, transform 0.14s ease, color 0.14s ease;
  }

  .contact-row:hover .contact-row__arrow,
  .contact-row:focus-visible .contact-row__arrow {
    opacity: 1;
    transform: none;
    color: var(--brand);
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-panel {
      transition: opacity 0.12s ease, visibility 0.12s ease;
      transform: none !important;
    }

    .contact-trigger__caret,
    .contact-row__arrow {
      transition: opacity 0.12s ease;
    }

    .contact-trigger:active {
      scale: 1;
    }
  }
</style>

<script>
  // Hover and focus-within are handled in CSS. This only adds the touch path:
  // tap to toggle (no hover on coarse pointers), plus outside-tap / Escape to
  // close. Kept deliberately tiny — the panel is a static list of links.
  document.querySelectorAll<HTMLElement>('[data-contact]').forEach((root) => {
    const trigger = root.querySelector<HTMLButtonElement>('[data-contact-toggle]');
    if (!trigger) return;

    const close = () => {
      root.classList.remove('is-open');
      trigger.setAttribute('aria-expanded', 'false');
    };

    trigger.addEventListener('click', (event) => {
      event.preventDefault();
      const open = root.classList.toggle('is-open');
      trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    });

    document.addEventListener('click', (event) => {
      if (!root.contains(event.target as Node)) close();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close();
    });
  });
</script>
