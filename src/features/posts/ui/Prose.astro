---
// Renders Ghost-provided HTML while promoting code blocks into the shared
// components showcase CodeBox. The remaining .kg-* markup stays verbatim and
// gets a small progressive-enhancement layer for media and poem blocks.
import '../../../styles/blog-prose.css';
import CodeBox from '@/features/components/ui/CodeBox.astro';
import { splitBlogProse } from '@/features/posts/server/code-blocks';

interface Props {
  html: string;
}

const { html } = Astro.props;
const fragments = splitBlogProse(html);
---

<div class="blog-prose">
  {fragments.map((fragment) => fragment.kind === 'code'
    ? <CodeBox code={fragment.code} lang={fragment.lang} />
    : <Fragment set:html={fragment.html} />
  )}
</div>

<script>
  import '@/features/posts/client/prose';
</script>
