---
// Renders Ghost-provided HTML while promoting code blocks into the shared
// components showcase CodeBox, and ```conversation blocks into a chat thread.
// The remaining .kg-* markup stays verbatim and gets a small
// progressive-enhancement layer for media and poem blocks.
import '../../../styles/blog-prose.css';
import CodeBox from '@/features/components/ui/CodeBox.astro';
import Conversation from '@/features/content/ui/Conversation.astro';
import { splitBlogProse } from '@/features/posts/server/code-blocks';

interface Props {
  html: string;
}

const { html } = Astro.props;
const fragments = splitBlogProse(html);
---

<div class="blog-prose">
  {fragments.map((fragment) => {
    if (fragment.kind === 'code') return <CodeBox code={fragment.code} lang={fragment.lang} />;
    if (fragment.kind === 'conversation') return <Conversation source={fragment.source} />;
    return <Fragment set:html={fragment.html} />;
  })}
</div>

<script>
  import '@/features/posts/client/prose';
</script>
