---
/* Everything that closes a post, under one hairline.
   The end of an article used to be three bands: a short dash with the
   human-authorship pledge, then a rule with the reaction/subscribe/share row,
   then another rule with the comments head. Three horizontal lines inside
   150px, for one idea -- "the text stops here".

   One rule now, and inside it two layers in the order they belong to the text:
   who wrote it with what, then the things a reader can do about it.

   Provenance is declared, not pledged: AiCredit names the models a post
   actually credits, in place of a line on every post claiming none were
   involved -- a claim the reader cannot check. In practice nearly every post
   carries an [!authors] directive, so treat the credit as the normal case and
   the creditless post as the exception; the actions row keeps its own top
   margin either way. */
import type { AuthorshipCredit } from '@/features/posts/server/directives/authors';

import AiCredit from './AiCredit.astro';

interface Props {
  /** Model co-authors, from the post's [!authors] directives. */
  credits?: readonly AuthorshipCredit[];
}

const { credits = [] } = Astro.props;
const hasActions = Astro.slots.has('default');
---

<footer class="blog-colophon">
  {credits.length > 0 && <AiCredit credits={credits} />}

  {
    hasActions && (
      <div class="blog-colophon__actions">
        <slot />
      </div>
    )
  }
</footer>

<style>
  .blog-colophon {
    margin-top: 44px;
    padding-top: 28px;
    border-top: 1px solid var(--blog-line);
  }

  /* Everything you can do about this post without writing anything: the hearts
     on the left, subscribe and share on the right. Far enough below the credit
     to read as a different layer, with no rule needed to say so. A post with
     no credit above them loses the margin -- the hairline is then the only
     thing over the row, and 28 + 24 of air under a rule reads as a gap someone
     forgot to fill. */
  .blog-colophon__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px 24px;
  }

  :global(.ai-credit) + .blog-colophon__actions {
    margin-top: 24px;
  }
</style>
