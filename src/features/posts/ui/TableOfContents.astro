---
// Table of contents ported from cai.im/chl.ee: a dotted vertical progress rail
// whose accent dots "fill" as you read, a sliding pill that springs to hug the
// active heading's label, and a quiet text list (full opacity only for the
// active section). Built client-side from the rendered article headings so it
// works for any Ghost HTML; wide screens only, and only with >=2 headings. All
// styling lives in blog.css (global) since these nodes are created at runtime.
import { blog } from '@/data/site';
import '@/styles/scroll-dock.css';

interface Props {
  /** Author opted out of the section map (#no-toc). The desktop rail and the
      mobile dropdown stay off, but the reading topbar still shows the title. */
  noToc?: boolean;
}

const { noToc = false } = Astro.props;
const blogMarkAsset = blog.mark;
---

<nav class="toc-container" aria-label="On this page" hidden>
  <div class="toc-inner">
    <div class="toc-content-wrapper">
      <div class="toc-sliding-pill" aria-hidden="true"></div>
      <div class="toc-progress-timeline" aria-hidden="true">
        <div class="toc-progress-fill"></div>
      </div>
      <ul class="toc-list"></ul>
    </div>
  </div>
</nav>

<!-- Mobile counterpart: a chl.ee-style reading topbar that slides in once the
     reader leaves the article header behind. Logo left, title dead-centre,
     back-to-top right. With a section map the centre title is tappable (drops
     the heading list and tracks the active section; opening swaps it back to
     the article title for context). Without one — a no-toc or thin post — it
     stays a static title marker. The bar's blur fades into the page via a
     masked layer, so the chrome reads as naturally transparent. Shown only
     below the desktop breakpoint, where the gutter rail is hidden. -->
<div class="toc-topbar" data-no-toc={noToc ? 'true' : 'false'} hidden>
  <div class="toc-topbar__fade" aria-hidden="true"></div>
  <div class="toc-topbar__bar">
    <a class="toc-topbar__logo" href="/blog/" aria-label={blog.name}>
      <img src={blogMarkAsset} alt={blog.name} width="30" height="30" />
    </a>
    <button
      class="toc-topbar__title"
      type="button"
      aria-haspopup="true"
      aria-expanded="false"
      aria-controls="toc-menu"
    >
      <span class="toc-topbar__title-text"></span>
      <svg class="toc-topbar__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m6 9 6 6 6-6" />
      </svg>
    </button>
    <button class="toc-topbar__totop" type="button" aria-label="Back to top">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5M5 12l7-7 7 7" />
      </svg>
    </button>
  </div>
  <div class="toc-topbar__menu" id="toc-menu" role="menu" aria-hidden="true">
    <ul class="toc-topbar__list"></ul>
  </div>
</div>

<script>
  import { createScrollDock, type ScrollDock } from '@/lib/scroll-dock';

  const nav = document.querySelector<HTMLElement>('.toc-container');
  const wrapper = nav?.querySelector<HTMLElement>('.toc-content-wrapper');
  const pill = nav?.querySelector<HTMLElement>('.toc-sliding-pill');
  const fill = nav?.querySelector<HTMLElement>('.toc-progress-fill');
  const listEl = nav?.querySelector<HTMLElement>('.toc-list');
  const prose = document.querySelector<HTMLElement>('.blog-prose');

  // Mobile counterpart (reading topbar). Absent markup just disables it.
  const topbar = document.querySelector<HTMLElement>('.toc-topbar');
  const titleBtn = topbar?.querySelector<HTMLButtonElement>('.toc-topbar__title');
  const titleText = topbar?.querySelector<HTMLElement>('.toc-topbar__title-text');
  const menu = topbar?.querySelector<HTMLElement>('.toc-topbar__menu');
  const menuList = topbar?.querySelector<HTMLElement>('.toc-topbar__list');
  const topbarTotop = topbar?.querySelector<HTMLButtonElement>('.toc-topbar__totop');

  // The reading topbar is the through-line: it shows on every post. Its markup
  // is the gate — the desktop rail is an optional extra layered on top.
  if (prose && topbar && titleBtn && titleText && menu && menuList) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const postTitle =
      document.querySelector<HTMLElement>('.blog-article__title')?.textContent?.trim() ||
      'On this page';
    const headings = Array.from(prose.querySelectorAll<HTMLElement>('h2, h3'));
    // A section map needs >=2 headings AND the author keeping it (no #no-toc).
    const hasToc = topbar.dataset.noToc !== 'true' && headings.length >= 2;

    // This component renders inside `.blog-aside`, which is `display:none` below
    // the desktop breakpoint — an ancestor no descendant rule can override. The
    // fixed bar escapes it by portaling to <body>. It shows on every post; the
    // centre is the article title until the active section takes over.
    document.body.appendChild(topbar);
    topbar.hidden = false;

    // Swap the centre title with a vertical "ticker": the old line lifts and
    // blurs away, the new one rises from below into focus — same direction as
    // the scroll that triggered it. dataset.value records the intended text up
    // front so rapid changes dedupe and always land on the latest heading.
    let titleAnim: Animation | null = null;
    const setTitle = (text: string) => {
      if (titleText.dataset.value === text) return;
      titleText.dataset.value = text;
      if (reduceMotion || typeof titleText.animate !== 'function') {
        titleText.textContent = text;
        return;
      }
      titleAnim?.cancel();
      // Hold the faded-out end state (fill:forwards) so swapping textContent
      // doesn't flash the old line back. The catch: a forwards-held animation
      // keeps asserting opacity:0 forever — so once the incoming line is in
      // flight, cancel the outgoing one to release its grip, or the title goes
      // invisible after the first swap.
      const out = titleText.animate(
        [
          { opacity: 1, transform: 'translateY(0)', filter: 'blur(0)' },
          { opacity: 0, transform: 'translateY(-0.5em)', filter: 'blur(2px)' },
        ],
        { duration: 150, easing: 'cubic-bezier(0.4, 0, 1, 1)', fill: 'forwards' },
      );
      titleAnim = out;
      out.onfinish = () => {
        titleText.textContent = titleText.dataset.value || text;
        const incoming = titleText.animate(
          [
            { opacity: 0, transform: 'translateY(0.5em)', filter: 'blur(2px)' },
            { opacity: 1, transform: 'translateY(0)', filter: 'blur(0)' },
          ],
          { duration: 260, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
        );
        out.cancel();
        titleAnim = incoming;
      };
    };

    // First paint: set straight, no animation to fade the bar in over.
    titleText.textContent = postTitle;
    titleText.dataset.value = postTitle;

    const slugify = (text: string) =>
      text
        .toLowerCase()
        .trim()
        .replace(/[^\w一-鿿\s-]/g, '')
        .replace(/\s+/g, '-')
        .slice(0, 60) || 'section';

    const links: HTMLAnchorElement[] = [];
    const mobileLinks: HTMLAnchorElement[] = [];
    const offset = 96;
    let activeIndex = -1;
    let menuOpen = false;
    let ticking = false;
    let closeMenu = () => {};

    if (hasToc && nav && wrapper && pill && fill && listEl) {
      headings.forEach((heading) => {
        if (!heading.id) heading.id = slugify(heading.textContent || 'section');
        heading.style.scrollMarginTop = '88px';
        const text = heading.textContent || '';
        const depth = heading.tagName === 'H3' ? 3 : 2;

        // Desktop dotted rail.
        const item = document.createElement('li');
        item.className = `toc-item depth-${depth}`;
        const link = document.createElement('a');
        link.className = 'toc-link';
        link.href = `#${heading.id}`;
        const label = document.createElement('span');
        label.className = 'toc-text';
        label.textContent = text;
        link.appendChild(label);
        link.addEventListener('click', (event) => {
          event.preventDefault();
          heading.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.replaceState(null, '', `#${heading.id}`);
        });
        // The color block tracks the cursor: hovering a link springs the pill to
        // it while the active section's ink stays put (see list mouseleave).
        link.addEventListener('mouseenter', () => movePill(link));
        item.appendChild(link);
        listEl.appendChild(item);
        links.push(link);

        // Mobile dropdown row — same anchors, so both views track in lockstep.
        const mItem = document.createElement('li');
        mItem.className = `toc-topbar__item depth-${depth}`;
        const mLink = document.createElement('a');
        mLink.className = 'toc-topbar__link';
        mLink.href = `#${heading.id}`;
        mLink.textContent = text;
        mLink.setAttribute('role', 'menuitem');
        mLink.addEventListener('click', (event) => {
          event.preventDefault();
          closeMenu();
          heading.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.replaceState(null, '', `#${heading.id}`);
        });
        mItem.appendChild(mLink);
        menuList.appendChild(mItem);
        mobileLinks.push(mLink);
      });

      // Leaving the list snaps the block back to the section you're reading; if
      // none is active yet, it just fades out rather than stranding on hover.
      listEl.addEventListener('mouseleave', () => {
        if (activeIndex >= 0 && links[activeIndex]) movePill(links[activeIndex]);
        else pill.style.opacity = '0';
      });

      nav.hidden = false;

      // The menu is one glass with the bar, not a separate card: opening grows
      // its max-height so the frosted surface extends downward.
      const openMenu = () => {
        if (menuOpen) return;
        menuOpen = true;
        titleBtn.setAttribute('aria-expanded', 'true');
        menu.setAttribute('aria-hidden', 'false');
        topbar.classList.add('menu-open');
        // Open map → centre shows the article title, so you know the whole.
        setTitle(postTitle);
      };

      closeMenu = () => {
        if (!menuOpen) return;
        menuOpen = false;
        titleBtn.setAttribute('aria-expanded', 'false');
        menu.setAttribute('aria-hidden', 'true');
        topbar.classList.remove('menu-open');
        // Closed → restore the active section heading.
        if (activeIndex >= 0 && headings[activeIndex])
          setTitle(headings[activeIndex].textContent || postTitle);
      };

      titleBtn.addEventListener('click', () => (menuOpen ? closeMenu() : openMenu()));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menuOpen) closeMenu();
      });
      document.addEventListener('click', (event) => {
        if (menuOpen && !topbar.contains(event.target as Node)) closeMenu();
      });
    } else {
      // No section map: the centre title is a marker, not a menu trigger.
      topbar.classList.add('toc-topbar--static');
      titleBtn.setAttribute('aria-haspopup', 'false');
      titleBtn.removeAttribute('aria-controls');
    }

    if (topbarTotop) {
      topbarTotop.addEventListener('click', () => {
        closeMenu();
        window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
      });
    }

    // --- Shared-element logo handoff (mobile reading bar only) ------------
    // The page header's mark (logo1) and the reading bar's mark (logo2) sit a
    // short hop apart, both top-left. As you scroll, a fixed "ghost" mark lifts
    // off logo1's spot, sticks near the top while the article scrolls beneath
    // it, shrinks to logo2's size, and docks into logo2's slot just as the bar
    // assembles around it — a scroll-driven FLIP: one moving node between two
    // measured endpoints. Desktop (no bar) and reduced-motion skip it.
    //
    // The travel itself is CSS: the ghost hosts a scroll dock, JS publishes the
    // two endpoints as numbers, and blog.css lerps between them (see
    // @/lib/scroll-dock). Where the engine can run that off the scroller, the
    // flight never touches this thread at all — which is what the old per-frame
    // transform string could not do. What stays here is only the bookkeeping
    // that has no numeric form: which of the two marks owns the pixels.
    const REVEAL = 120; // scroll px where the bar appears AND the logo docks

    // One dock for the whole bar: its own reveal rides `dock` (the mark's run)
    // and the title's crossfade rides `lift` (the H1's run), both inherited by
    // the controls inside. Every part of the arrival is then derived from the
    // same scroll offset, so no piece of it can land a frame after another.
    const topbarDock = createScrollDock(topbar, ['dock', 'lift']);
    topbarDock.setRun('dock', REVEAL);
    const mark = document.querySelector<HTMLElement>('.blog-mark');
    const barLogo = topbar.querySelector<HTMLElement>('.toc-topbar__logo');
    const barLogoImg = barLogo?.querySelector<HTMLImageElement>('img');
    const handoffMql = window.matchMedia('(max-width: 1279px)');
    const canHandoff = !reduceMotion && !!mark && !!barLogo && !!barLogoImg;

    let ghost: HTMLElement | null = null;
    let logoDock: ScrollDock | null = null;

    const setNum = (el: HTMLElement, name: string, value: number) =>
      el.style.setProperty(name, value.toFixed(3));

    const measureLogos = () => {
      if (!ghost || !handoffMql.matches) return;
      const a = mark!.getBoundingClientRect();
      // logo1 scrolls with the page; anchor to its at-rest viewport position
      // (doc-absolute top), so the ghost holds steady near the top regardless
      // of where the page happens to be when we measure.
      const b = barLogo!.getBoundingClientRect();
      const tb = topbar.getBoundingClientRect();
      // Measured against the bar's own box, so the dock target holds even if the
      // bar is ever given an offset again — it fades in place today.
      setNum(ghost, '--l1-x', a.left);
      setNum(ghost, '--l1-y', a.top + window.scrollY);
      setNum(ghost, '--l1-size', a.width);
      setNum(ghost, '--l2-x', b.left);
      setNum(ghost, '--l2-y', b.top - tb.top);
      setNum(ghost, '--logo-scale', b.width / Math.max(1, a.width));
    };

    const updateGhost = () => {
      if (!ghost) return;
      // Past the breakpoint there is no bar to dock into: stand everything down.
      if (!handoffMql.matches) {
        ghost.style.opacity = '0';
        mark!.style.visibility = '';
        topbar.classList.remove('logo-handoff');
        return;
      }
      topbar.classList.add('logo-handoff');
      if (window.scrollY <= 0) {
        // At the very top the real header mark owns the stage.
        ghost.style.opacity = '0';
        mark!.style.visibility = '';
        return;
      }
      // Ghost takes over; logo1 keeps its layout box (visibility, not display)
      // so the header never reflows.
      mark!.style.visibility = 'hidden';
      ghost.style.opacity = '1';
    };

    if (canHandoff) {
      ghost = document.createElement('div');
      ghost.className = 'toc-logo-ghost';
      ghost.setAttribute('aria-hidden', 'true');
      const img = document.createElement('img');
      img.src = barLogoImg!.src;
      img.alt = '';
      ghost.appendChild(img);
      document.body.appendChild(ghost);
      logoDock = createScrollDock(ghost, ['dock']);
      logoDock.setRun('dock', REVEAL);
      measureLogos();
    }

    // --- Shared-element title handoff (the iOS "large title" collapse) -----
    // The article H1 is the title's home. As you scroll it rises with the page,
    // shrinks toward the bar's centre slot, and crossfades into the real (small,
    // ellipsised) bar title at the dock. Same scroll-driven FLIP as the logo, on
    // a longer run since the H1 starts lower down the page.
    const h1 = document.querySelector<HTMLElement>('.blog-article__title');
    const canTitle = !reduceMotion && !!h1;
    let titleGhost: HTMLElement | null = null;
    let titleDock: ScrollDock | null = null;
    // The H1 docks by the time its top nears the bar; the run is its travel.
    // Cached, not recomputed per frame — `update()` below reads it every tick.
    let titleRun = 168;
    // The ghost is one nowrap line, but the H1 it stands in for wraps to two or
    // three on a phone — 342px of column against a 359px title. Lifting off from
    // a wrapped headline snaps it to a single line wider than the screen, at the
    // first scrolled pixel and at 27px type: a louder break than the collapse is
    // worth. So the flight is earned by the title fitting on one line, and where
    // it doesn't the bar title simply fades in with the bar. Re-checked from
    // measureTitle(), which already runs on every event that can rewrap it.
    let titleFitsOneLine = false;

    const measureTitle = () => {
      if (!titleGhost || !handoffMql.matches) return;
      const h = h1!.getBoundingClientRect();
      const heroFont = parseFloat(getComputedStyle(h1!).fontSize) || 28;
      const heroLine = parseFloat(getComputedStyle(h1!).lineHeight) || heroFont * 1.3;
      titleFitsOneLine = h.height <= heroLine * 1.5;
      const r = titleText.getBoundingClientRect();
      const tb = topbar.getBoundingClientRect();
      // Centre of the real bar title, relative to the bar's own box.
      const cx = r.left + r.width / 2;
      const cy = r.top - tb.top + r.height / 2;
      // offsetWidth/Height, not a rect: the ghost carries the flight transform
      // at all times now, and the layout box is the only reading that ignores it.
      const gw = titleGhost.offsetWidth;
      const gh = titleGhost.offsetHeight;
      // The font-size ratio, which is only honest because the bar title now
      // wears the H1's weight and tracking (blog.css) — em-relative tracking
      // scales with the glyphs, so equal size means equal width. Matching the
      // measured width instead looks like the more direct fix and is a trap: it
      // silently absorbs any type mismatch into the scale, so the ghost lands
      // the right width with visibly larger glyphs.
      const scale = (parseFloat(getComputedStyle(titleText).fontSize) || 14) / heroFont;

      titleRun = Math.max(1, h.top + window.scrollY - 52);
      setNum(titleGhost, '--t1-x', h.left);
      setNum(titleGhost, '--t1-y', h.top + window.scrollY);
      setNum(titleGhost, '--lift-run', titleRun);
      // The docked top-left, folding in the ghost's own box at its end scale —
      // CSS cannot read that back, so it is resolved here.
      setNum(titleGhost, '--title-target-x', cx - (gw * scale) / 2);
      setNum(titleGhost, '--title-target-y', cy - (gh * scale) / 2);
      setNum(titleGhost, '--title-scale', scale);
      titleDock?.setRun('lift', titleRun);
      topbarDock.setRun('lift', titleRun);
    };

    // Extra scroll past the first heading before the centre swaps title→section.
    const SECTION_LEAD = 100;

    // The crossfade itself is CSS now, off the same `--lift-ride` the travel
    // rides (see blog.css). Reading window.scrollY here instead meant the fade
    // was observed a frame after the flight it was supposed to accompany, so on
    // iOS momentum the ghost had already parked while the bar title had not yet
    // started — two titles at once, which is what the doubling was. What stays
    // on this thread is only the bookkeeping with no numeric form: who owns the
    // title's pixels.
    const updateTitleGhost = () => {
      if (!titleGhost) return;
      const flying = handoffMql.matches && titleFitsOneLine && window.scrollY > 0;
      titleGhost.classList.toggle('is-flying', flying);
      topbar.classList.toggle('title-handoff', flying);
      // The H1 keeps its layout box (visibility, not display) so the article
      // never reflows under the reader.
      h1!.style.visibility = flying ? 'hidden' : '';
    };

    if (canTitle) {
      titleGhost = document.createElement('div');
      titleGhost.className = 'toc-title-ghost';
      titleGhost.setAttribute('aria-hidden', 'true');
      titleGhost.textContent = postTitle;
      const cs = getComputedStyle(h1!);
      // Wear the H1's type so lift-off is seamless; the crossfade hides the swap
      // to the bar's Inter at the dock.
      titleGhost.style.font = cs.font;
      titleGhost.style.fontFamily = cs.fontFamily;
      titleGhost.style.fontWeight = cs.fontWeight;
      titleGhost.style.fontSize = cs.fontSize;
      titleGhost.style.lineHeight = cs.lineHeight;
      titleGhost.style.letterSpacing = cs.letterSpacing;
      document.body.appendChild(titleGhost);
      titleDock = createScrollDock(titleGhost, ['lift']);
      measureTitle();
    }

    // Slide the pill to hug the active link's box; depth indent comes for free.
    // Measured against the wrapper (not offsetParent) because each .toc-item is
    // positioned, which would otherwise pin every link's offsetTop near zero.
    // Position rides the transform, size stays in layout: scale() on a 1x1 box
    // is one write instead of three, but it scales border-radius too and the
    // pill loses its corners (see blog.css).
    const movePill = (link: HTMLAnchorElement) => {
      const wrap = wrapper!.getBoundingClientRect();
      const box = link.getBoundingClientRect();
      pill!.style.width = `${box.width}px`;
      pill!.style.height = `${box.height}px`;
      pill!.style.transform = `translate(${box.left - wrap.left}px, ${box.top - wrap.top}px)`;
      pill!.style.opacity = '1';
    };

    // Rail geometry. Reading this per frame meant one forced layout per heading
    // on every scroll tick — by far the most expensive thing this file did, and
    // it scaled with the length of the post. None of it moves while scrolling,
    // so it is measured on the events that can actually change it instead.
    let headingTops: number[] = [];
    let proseEnd = 0;
    let railHeight = 0;

    const measureRail = () => {
      headingTops = headings.map((h) => h.getBoundingClientRect().top + window.scrollY);
      proseEnd = prose.getBoundingClientRect().bottom + window.scrollY;
      railHeight = wrapper?.offsetHeight ?? 0;
    };

    const update = () => {
      ticking = false;

      // Only hit-testing: how far in the bar is, is CSS reading --dock-ride.
      // Armed from the first scrolled pixel so visibility is never the thing
      // holding back an already-opaque bar.
      topbar.classList.toggle('is-visible', window.scrollY > 0);
      updateGhost();
      updateTitleGhost();
      if (!hasToc || !wrapper || !fill || !pill || !headingTops.length) return;

      const line = window.scrollY + offset;
      const tops = headingTops;

      // Reading progress fills the dotted rail across the whole article.
      const start = tops[0] - offset;
      const end = proseEnd - offset;
      const progress = Math.min(1, Math.max(0, (line - tops[0]) / Math.max(1, end - start)));
      fill.style.height = `${progress * railHeight}px`;

      // Active section: the last heading whose top has crossed the reading line.
      let i = 0;
      while (i < tops.length - 1 && tops[i + 1] <= line) i += 1;
      if (line < tops[0]) i = 0;

      // Centre-title sequencing: the post title leads — through the handoff and
      // a stretch past the first heading — before the active section takes the
      // slot. Runs every frame (the swap is a scroll threshold, not an index
      // change) but only once the title has docked, so it never fights the
      // ghost. setTitle() dedupes, so re-calls are cheap. An open map keeps the
      // article title by design.
      if (!menuOpen && window.scrollY >= titleRun) {
        const inSection = line > tops[0] + SECTION_LEAD;
        setTitle(inSection ? headings[i].textContent || postTitle : postTitle);
      }

      if (i === activeIndex) return;
      activeIndex = i;

      links.forEach((link, j) => link.classList.toggle('active', j === i));
      mobileLinks.forEach((link, j) => link.classList.toggle('active', j === i));
      movePill(links[i]);
    };

    const onScroll = () => {
      // A drifting dropdown reads as detached chrome — close it the moment the
      // page moves under it.
      closeMenu();
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    const remeasure = () => {
      measureLogos();
      measureTitle();
      measureRail();
      onScroll();
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    // Logo + title geometry shift with width / breakpoint crossings, and the
    // rail's heading offsets shift with any reflow.
    window.addEventListener('resize', remeasure, { passive: true });

    // The article settles after first paint: the feature image can grow above
    // the prose, embeds size themselves, and web fonts re-flow the content.
    // Observe the whole article so both preceding media and prose changes
    // invalidate the cached heading positions.
    if (typeof ResizeObserver !== 'undefined') {
      new ResizeObserver(remeasure).observe(prose.closest('article') ?? prose);
    }
    document.fonts?.ready?.then(remeasure).catch(() => {});

    measureRail();
    update();
  }
</script>
