---
// Floating back-to-top control. Hidden until the reader scrolls past one
// viewport, then fades in. Bottom-right, out of the reading column's way.
---

<button class="blog-totop" type="button" aria-label="Back to top" hidden>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 19V5M5 12l7-7 7 7" />
  </svg>
</button>

<script>
  import { pageScroll } from '@/lib/page-scroll';

  const button = document.querySelector<HTMLButtonElement>('.blog-totop');
  if (button) {
    // The blog zone scrolls an inner element, not the root. See @/lib/page-scroll.
    const scroll = pageScroll();
    const onScroll = () => {
      const past = scroll.el.scrollTop > scroll.el.clientHeight;
      button.hidden = !past;
      button.classList.toggle('is-visible', past);
    };
    button.addEventListener('click', () =>
      scroll.el.scrollTo({ top: 0, behavior: 'smooth' }),
    );
    scroll.events.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
