---
// The blog's search affordance: a bare icon button matching the theme toggle,
// wired to the site-wide ⌘K command palette (CommandPalette.astro). Blog search
// is now full-text and inline in that palette — Pagefind results render as rows
// as you type, so there is no separate blog dialog and no "search all posts"
// hop anymore. This file is just the blog-styled trigger; the palette owns the
// ⌘K shortcut and all search behavior.
---

<button
  class="blog-search-trigger"
  type="button"
  data-command-open
  aria-label="Search and commands"
  title="Search (⌘K)"
  aria-keyshortcuts="Control+K Meta+K"
  aria-haspopup="dialog"
  aria-controls="site-command-palette"
>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
  </svg>
</button>

<style is:global>
  /* Trigger — a bare icon button, identical in weight to the theme toggle so
     the two sit as an even pair. No pill, no keycap chips; the shortcut lives
     in the title tooltip and the palette's placeholder. */
  .blog-search-trigger {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    color: var(--blog-faint);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: color 0.15s ease, background 0.15s ease, scale 0.12s ease;
  }
  /* Keep the 34px visual but extend the tap target to 40×40 (34 + 3 + 3). */
  .blog-search-trigger::before {
    content: '';
    position: absolute;
    inset: -3px;
  }
  .blog-search-trigger:hover {
    color: var(--blog-ink);
    background: hsl(var(--foreground) / 0.05);
  }
  .blog-search-trigger:active {
    scale: 0.96;
  }
  @media (prefers-reduced-motion: reduce) {
    .blog-search-trigger:active {
      scale: 1;
    }
  }
  .blog-search-trigger svg {
    width: 18px;
    height: 18px;
  }
</style>
